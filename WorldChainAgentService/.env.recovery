# Token Recovery Configuration

# Agent Wallet Private Key (das Wallet mit den 30 WLD + WETH)
AGENT_PRIVATE_KEY=DEIN_AGENT_PRIVATE_KEY_HIER

# Deine World App Wallet Adresse (Ziel für die Tokens)
DESTINATION_ADDRESS=DEINE_WORLD_APP_ADRESSE_HIER

# Beispiel:
# AGENT_PRIVATE_KEY=1234567890abcdef...
# DESTINATION_ADDRESS=0x1234567890123456789012345678901234567890
