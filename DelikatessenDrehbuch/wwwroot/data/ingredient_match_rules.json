{
  "version": "1.2",
  "description": "Deklarative Regeln für das automatische Ingredient-Matching im Create Posting. Nutzt vorhandene is_* Flags und GroupId aus IngredientsAndNutrients. v1.2: Variable-Namen korrigiert (base statt ingredient wo nötig), fehlende Steps ergänzt, spezifischere is_* Flags, Gruppen-Ausschlüsse verfeinert.",
  "group_labels": {
    "1": "Fleisch",
    "2": "Gemüse",
    "3": "Milchprodukte",
    "4": "Obst",
    "5": "Gewürze",
    "6": "Fisch/Meeresfrüchte",
    "7": "Sonstiges",
    "8": "Grundnahrungsmittel",
    "9": "Nüsse, Samen, Hülsenfrüchte"
  },
  "variable_rules": {
    "ingredient": {
      "display_limit": 2,
      "display_prefer_base_sources": true
    },
    "ingredients": {
      "display_limit": 3,
      "display_prefer_base_sources": true
    },
    "liquid": {
      "require_all": ["isLiquid"]
    },
    "fat": {
      "require_all": ["isFat"]
    },
    "hard": {
      "require_all": ["isHard"]
    },
    "soft": {
      "require_all": ["isSoft"]
    },
    "seasonings": {
      "allow_groups": ["5"]
    },
    "seasoning": {
      "any_of": [
        { "allow_groups": ["5"] },
        { "require_all": ["isFat"] }
      ]
    },
    "marinade": {
      "any_of": [
        { "require_all": ["isLiquid"] },
        { "require_all": ["isFat"] },
        { "allow_groups": ["5"] }
      ]
    },
    "thickener": {
      "require_all": ["isPowder"],
      "allow_groups": ["8"],
      "exclude_groups": ["5"]
    },
    "base": {
      "require_any": ["isHard", "isSoft"],
      "exclude_any": ["isLiquid", "isFat", "isPowder"],
      "exclude_groups": ["5", "7"]
    }
  },
  "step_variable_rules": {

    "_comment_prep": "=== PREP PHASE ===",

    "PREP_WASH_01": {
      "ingredient": {
        "exclude_any": ["isLiquid", "isFat", "isPowder"],
        "exclude_groups": ["5", "8"]
      }
    },
    "PREP_PEEL_01": {
      "ingredient": {
        "require_all": ["isPeelable"],
        "exclude_any": ["isLiquid", "isPowder", "isFat"]
      },
      "ingredients": {
        "require_all": ["isPeelable"],
        "exclude_any": ["isLiquid", "isPowder", "isFat"]
      }
    },
    "PREP_CUT_01": {
      "ingredient": {
        "require_all": ["isCuttable"],
        "exclude_any": ["isLiquid", "isFat", "isPowder"],
        "exclude_groups": ["5", "7", "8"]
      },
      "ingredients": {
        "require_all": ["isCuttable"],
        "exclude_any": ["isLiquid", "isFat", "isPowder"],
        "exclude_groups": ["5", "7", "8"]
      }
    },
    "PREP_GRATE_01": {
      "ingredient": {
        "require_all": ["isGrateable"],
        "exclude_any": ["isLiquid", "isFat", "isPowder"],
        "exclude_groups": ["5", "7", "8"]
      },
      "ingredients": {
        "require_all": ["isGrateable"],
        "exclude_any": ["isLiquid", "isFat", "isPowder"],
        "exclude_groups": ["5", "7", "8"]
      }
    },
    "PREP_MINCE_01": {
      "ingredient": {
        "any_of": [
          { "allow_groups": ["5"], "require_all": ["isCuttable"] },
          { "allow_names_exact": ["knoblauch"], "require_all": ["isCuttable"] }
        ]
      },
      "ingredients": {
        "any_of": [
          { "allow_groups": ["5"], "require_all": ["isCuttable"] },
          { "allow_names_exact": ["knoblauch"], "require_all": ["isCuttable"] }
        ]
      }
    },
    "PREP_SCORE_01": {
      "ingredient": {
        "require_any": ["isHard", "isSoft"],
        "exclude_any": ["isLiquid", "isFat", "isPowder"],
        "allow_groups": ["1", "2", "6"]
      }
    },
    "PREP_SMASH_01": {
      "ingredient": {
        "all_of": [
          {
            "any_of": [
              { "allow_name_contains": ["kartoffel", "potato", "batata"] },
              { "allow_groups": ["2"] }
            ]
          }
        ],
        "require_all": ["isHard", "isBoilable"],
        "exclude_any": ["isLiquid", "isFat", "isPowder"],
        "exclude_groups": ["5", "7"],
        "display_limit": 1,
        "display_prefer_groups": ["2", "8"]
      },
      "ingredients": {
        "all_of": [
          {
            "any_of": [
              { "allow_name_contains": ["kartoffel", "potato", "batata"] },
              { "allow_groups": ["2"] }
            ]
          }
        ],
        "require_all": ["isHard", "isBoilable"],
        "exclude_any": ["isLiquid", "isFat", "isPowder"],
        "exclude_groups": ["5", "7"],
        "display_limit": 2,
        "display_prefer_groups": ["2", "8"]
      }
    },
    "PREP_TENDERIZE_01": {
      "ingredient": {
        "require_any": ["isHard", "isSoft"],
        "exclude_any": ["isLiquid", "isFat", "isPowder"],
        "allow_groups": ["1"]
      }
    },
    "PREP_BEAT_01": {
      "ingredient": {
        "require_any": ["isSoft", "isLiquid"],
        "exclude_any": ["isPowder"],
        "exclude_groups": ["1", "5", "8", "9"]
      }
    },
    "PREP_WHISK_01": {
      "ingredient": {
        "require_any": ["isLiquid", "isFat", "isSoft"],
        "exclude_any": ["isPowder"],
        "exclude_groups": ["1", "6", "8"],
        "display_limit": 2
      },
      "ingredients": {
        "require_any": ["isLiquid", "isFat", "isSoft"],
        "exclude_any": ["isPowder"],
        "exclude_groups": ["1", "6", "8"],
        "display_limit": 3
      }
    },
    "PREP_FOLD_IN_01": {
      "ingredient": {
        "require_any": ["isSoft", "isLiquid"],
        "exclude_any": ["isPowder"],
        "exclude_groups": ["1", "6", "8"],
        "quantity_mode": "exclude_largest",
        "display_limit": 1
