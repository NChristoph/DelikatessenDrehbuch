@*
  Create Posting — Variante B (Hybrid Hero / Light Body)
  Razor-View für ASP.NET Core MVC.
  Erwartetes Model: CreatePostingViewModel (siehe unten).

  public class CreatePostingViewModel {
      public string Title { get; set; }
      public string CategoryLabel { get; set; }
      public string CategoryEmoji { get; set; }
      public string PrefLabel { get; set; }
      public string PrefEmoji { get; set; }
      public string Persons { get; set; }
      public string Duration { get; set; }
      public string MediaUrl { get; set; }                  // null = Empty State
      public List<IngredientVm> Ingredients { get; set; }   // Name, Emoji, Amount, Unit
      public List<SuggestionVm> Suggestions { get; set; }   // Name, Emoji
      public List<DetectedTypeVm> DetectedTypes { get; set; } // Pct, Label, Emoji, Best
      public List<DetectedStepVm> DetectedSteps { get; set; } // Action, Objects[], Hint
      public List<StepTemplateVm> StepTemplates { get; set; } // Emoji, Title, Body, Stars
      public List<string> Keywords { get; set; }              // Alle möglichen
      public List<string> SelectedKeywords { get; set; }
      public int DoneCount { get; set; }                       // 0..5
      public int TotalSteps { get; set; } = 5;
      public bool BasisComplete { get; set; }
      public bool MediaComplete { get; set; }
      public bool ZutatenComplete { get; set; }
      public bool StepsComplete { get; set; }
      public bool KeywordsComplete { get; set; }
  }
*@
@model CreatePostingViewModel
@{
    Layout = null;
    var pct = (int)Math.Round((double)Model.DoneCount / Model.TotalSteps * 100);
    var ready = Model.DoneCount == Model.TotalSteps;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Posting erstellen</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        /* ─────────────────────────────────────────────────────────────
           DESIGN TOKENS
           ───────────────────────────────────────────────────────────── */
        :root {
            --bg-cream:     #f5efe1;
            --bg-cream-2:   #ede5d2;
            --card:         #ffffff;
            --card-soft:    #faf6ec;
            --ink-deep:     #14391f;
            --ink-deep-2:   #0e2415;
            --ink-mid:      #2a4a32;
            --ink-text:     #1a2e20;
            --ink-mute:     #6b7868;
            --ink-line:     rgba(20, 57, 31, 0.12);
            --ink-line-soft: rgba(20, 57, 31, 0.08);
            --avocado:      #5fa052;
            --coral:        #ff7849;
            --coral-soft:   #ffb494;
            --orange:       #ff9a3c;
            --gold:         #f5b942;

            --radius-sm:    10px;
            --radius-md:    14px;
            --radius-lg:    18px;
            --radius-xl:    22px;
            --radius-pill:  999px;

            --shadow-sm:    0 2px 8px rgba(20, 57, 31, 0.06);
            --shadow-md:    0 8px 24px rgba(20, 57, 31, 0.10);
            --shadow-card:  0 8px 24px rgba(20, 57, 31, 0.06);
            --shadow-bar:   0 12px 30px rgba(20, 57, 31, 0.16);
            --shadow-coral: 0 6px 20px rgba(255, 120, 73, 0.40);

            --font-sans:    'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
            --font-serif:   'Fraunces', 'Playfair Display', Georgia, serif;
        }

        /* ─────────────────────────────────────────────────────────────
           BASE
           ───────────────────────────────────────────────────────────── */
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }
        body {
            font-family: var(--font-sans);
            color: var(--ink-text);
            background: var(--bg-cream-2);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        button { font-family: inherit; }
        input { font-family: inherit; }

        .cp-screen {
            position: relative;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background: var(--bg-cream);
            max-width: 480px;
            margin: 0 auto;
        }

        /* ─────────────────────────────────────────────────────────────
           HERO (dark)
           ───────────────────────────────────────────────────────────── */
        .cp-hero {
            flex-shrink: 0;
            background: linear-gradient(180deg, var(--ink-deep) 0%, var(--ink-deep-2) 100%);
            padding: 14px 16px 18px;
            color: white;
        }
        .cp-hero__top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
        }
        .cp-hero__back {
            width: 34px; height: 34px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.10);
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: white;
        }
        .cp-hero__eyebrow {
            font-size: 10px;
            opacity: 0.6;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
        .cp-hero__lang {
            background: rgba(255, 255, 255, 0.10);
            color: white;
            border: none;
            border-radius: var(--radius-pill);
            padding: 6px 10px;
            font-size: 11px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 3px;
            cursor: pointer;
        }
        .cp-hero__title {
            font-family: var(--font-serif);
            font-size: 32px;
            font-weight: 600;
            letter-spacing: -0.02em;
            margin: 0;
            line-height: 1.05;
        }
        .cp-hero__meta {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 10px;
            font-size: 12px;
        }
        .cp-hero__chip {
            background: rgba(255, 120, 73, 0.22);
            color: var(--orange);
            padding: 4px 10px;
            border-radius: var(--radius-pill);
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .cp-hero__metaline { opacity: 0.6; }
        .cp-hero__counter {
            margin-left: auto;
            display: inline-flex;
            align-items: baseline;
            gap: 4px;
        }
        .cp-hero__counter-num {
            font-family: var(--font-serif);
            font-size: 22px;
            font-weight: 600;
            color: var(--orange);
        }
        .cp-hero__counter-total {
            font-size: 11px;
            opacity: 0.5;
        }
        .cp-hero__progress {
            margin-top: 12px;
            height: 4px;
            background: rgba(255, 255, 255, 0.10);
            border-radius: 2px;
            overflow: hidden;
        }
        .cp-hero__progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--orange), var(--coral));
            transition: width .3s;
        }

        /* ─────────────────────────────────────────────────────────────
           STICKY TAB BAR
           ───────────────────────────────────────────────────────────── */
        .cp-tabs-wrap {
            position: sticky;
            top: 0;
            z-index: 3;
            margin-top: -10px;
            background: var(--bg-cream);
            padding-top: 4px;
        }
        .cp-tabs {
            display: flex;
            gap: 6px;
            overflow-x: auto;
            padding: 4px 14px 8px;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }
        .cp-tabs::-webkit-scrollbar { display: none; }

        .cp-tab {
            flex-shrink: 0;
            padding: 8px 14px;
            border-radius: var(--radius-pill);
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all .2s;
            background: var(--card);
            color: var(--ink-deep);
            border: 1px solid var(--ink-line);
        }
        .cp-tab.is-active {
            background: var(--ink-deep);
            color: white;
            border-color: var(--ink-deep);
            box-shadow: 0 4px 14px rgba(20, 57, 31, 0.18);
        }
        .cp-tab__emoji { font-size: 13px; }
        .cp-tab__check {
            width: 14px; height: 14px;
            border-radius: 50%;
            background: var(--avocado);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-left: 2px;
        }

        /* ─────────────────────────────────────────────────────────────
           FEED + SECTIONS
           ───────────────────────────────────────────────────────────── */
        .cp-feed {
            padding: 4px 14px 130px;
            flex: 1;
        }
        .cp-section {
            background: var(--card);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-card);
            margin-bottom: 14px;
            overflow: hidden;
            scroll-margin-top: 88px;
        }
        .cp-section__head {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 18px 18px 12px;
            border-bottom: 1px solid rgba(20, 57, 31, 0.06);
        }
        .cp-section__icon {
            width: 38px; height: 38px;
            border-radius: 12px;
            background: var(--card-soft);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
            color: var(--ink-deep);
        }
        .cp-section__icon--accent { background: #fff0e6; }
        .cp-section.is-complete .cp-section__icon {
            background: var(--ink-deep);
            color: white;
        }
        .cp-section__title {
            font-family: var(--font-serif);
            font-size: 20px;
            font-weight: 600;
            letter-spacing: -0.01em;
            color: var(--ink-deep);
            margin: 0;
            line-height: 1.1;
        }
        .cp-section__subtitle {
            font-size: 12px;
            color: var(--ink-mute);
            margin-top: 3px;
        }
        .cp-section__counter {
            background: var(--card-soft);
            color: var(--ink-deep);
            font-size: 11px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: var(--radius-pill);
            flex-shrink: 0;
            font-family: var(--font-serif);
        }
        .cp-section.is-complete .cp-section__counter {
            background: var(--avocado);
            color: white;
        }
        .cp-section__body { padding: 18px; }
        .cp-section__head-text { flex: 1; min-width: 0; }

        /* ─────────────────────────────────────────────────────────────
           FORM PRIMITIVES
           ───────────────────────────────────────────────────────────── */
        .cp-stack { display: flex; flex-direction: column; gap: 14px; }
        .cp-stack--md { gap: 16px; }
        .cp-stack--sm { gap: 8px; }
        .cp-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

        .cp-label {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-family: var(--font-sans);
            font-size: 11px;
            font-weight: 600;
            color: var(--ink-mute);
            letter-spacing: 0.06em;
            text-transform: uppercase;
            margin-bottom: 8px;
        }
        .cp-label__badge { color: var(--coral); }

        .cp-input {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--card);
            border: 1px solid rgba(20, 57, 31, 0.10);
            border-radius: var(--radius-md);
            padding: 12px 14px;
            transition: all .15s;
        }
        .cp-input:focus-within { border-color: var(--ink-deep); }
        .cp-input__icon { font-size: 16px; opacity: 0.6; }
        .cp-input__field {
            flex: 1;
            border: none;
            outline: none;
            background: transparent;
            font-size: 15px;
            font-weight: 500;
            color: var(--ink-deep);
        }
        .cp-input__suffix {
            font-size: 12px;
            color: var(--ink-mute);
            font-weight: 600;
        }

        .cp-select {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--card);
            border: 1px solid rgba(20, 57, 31, 0.10);
            border-radius: var(--radius-md);
            padding: 12px 14px;
            cursor: pointer;
            text-align: left;
        }
        .cp-select__icon { font-size: 16px; }
        .cp-select__value {
            flex: 1;
            font-size: 14px;
            font-weight: 600;
            color: var(--ink-deep);
        }
        .cp-select__value.is-empty { color: #9ba59c; }
        .cp-select__caret { color: var(--ink-mute); }

        /* ─────────────────────────────────────────────────────────────
           MEDIA SECTION
           ───────────────────────────────────────────────────────────── */
        .cp-media-empty {
            width: 100%;
            aspect-ratio: 9 / 14;
            border: 2px dashed rgba(20, 57, 31, 0.20);
            background: linear-gradient(180deg, var(--card-soft) 0%, var(--bg-cream) 100%);
            border-radius: var(--radius-lg);
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }
        .cp-media-empty__icon {
            width: 64px; height: 64px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--orange), var(--coral));
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 24px rgba(255, 120, 73, 0.40);
            color: white;
        }
        .cp-media-empty__heading {
            font-family: var(--font-serif);
            font-size: 22px;
            font-weight: 600;
            color: var(--ink-deep);
            text-align: center;
        }
        .cp-media-empty__sub {
            font-size: 13px;
            color: var(--ink-mute);
            margin-top: 4px;
            text-align: center;
        }
        .cp-media-empty__specs {
            display: flex;
            gap: 6px;
            margin-top: 4px;
        }
        .cp-spec-pill {
            font-size: 10px;
            font-weight: 600;
            color: var(--ink-mute);
            background: var(--card);
            padding: 4px 10px;
            border-radius: var(--radius-pill);
            border: 1px solid var(--ink-line-soft);
        }

        .cp-media-filled {
            position: relative;
            border-radius: var(--radius-lg);
            overflow: hidden;
            aspect-ratio: 9 / 14;
            background-position: center;
            background-size: cover;
            box-shadow: 0 12px 30px rgba(20, 57, 31, 0.18);
        }
        .cp-media-overlay-actions {
            position: absolute;
            right: 10px;
            bottom: 12px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            align-items: center;
        }
        .cp-media-overlay-action {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
        }
        .cp-media-overlay-action__btn {
            width: 36px; height: 36px;
            border-radius: 50%;
            background: rgba(0, 0, 0, 0.35);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }
        .cp-media-overlay-action__count {
            color: white;
            font-size: 9px;
            font-weight: 600;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
        }
        .cp-media-caption {
            position: absolute;
            left: 12px;
            bottom: 12px;
            right: 70px;
            color: white;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
        }
        .cp-media-caption__eyebrow {
            font-size: 11px;
            font-weight: 600;
            opacity: 0.85;
        }
        .cp-media-caption__title {
            font-family: var(--font-serif);
            font-size: 18px;
            font-weight: 600;
            line-height: 1.15;
            margin-top: 2px;
        }
        .cp-media-replace {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(255, 255, 255, 0.95);
            border: none;
            border-radius: var(--radius-pill);
            padding: 6px 12px;
            font-size: 11px;
            font-weight: 700;
            color: var(--ink-deep);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .cp-media-edit-row {
            display: flex;
            gap: 8px;
            margin-top: 12px;
        }
        .cp-secondary-btn {
            flex: 1;
            border: 1px solid var(--ink-line);
            background: var(--card);
            border-radius: 12px;
            padding: 10px;
            font-size: 12px;
            font-weight: 600;
            color: var(--ink-deep);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        /* ─────────────────────────────────────────────────────────────
           ZUTATEN
           ───────────────────────────────────────────────────────────── */
        .cp-ing-row {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--card-soft);
            border: 1px solid var(--ink-line-soft);
            border-radius: var(--radius-md);
            padding: 10px 12px;
        }
        .cp-ing-row__emoji { font-size: 22px; }
        .cp-ing-row__name {
            flex: 1;
            font-size: 14px;
            font-weight: 600;
            color: var(--ink-deep);
        }
        .cp-stepper {
            display: inline-flex;
            align-items: center;
            background: var(--card);
            border-radius: var(--radius-pill);
            padding: 2px;
            border: 1px solid var(--ink-line-soft);
        }
        .cp-stepper__btn {
            width: 22px; height: 22px;
            border: none;
            background: transparent;
            cursor: pointer;
            font-size: 14px;
            color: var(--ink-deep);
            font-weight: 700;
        }
        .cp-stepper__btn--plus {
            background: var(--ink-deep);
            border-radius: 50%;
            color: white;
            font-size: 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .cp-stepper__count {
            font-size: 12px;
            font-weight: 700;
            color: var(--ink-deep);
            padding: 0 6px;
            min-width: 38px;
            text-align: center;
        }

        .cp-pill-wrap {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }
        .cp-suggest-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 12px;
            border-radius: var(--radius-pill);
            background: var(--card);
            color: var(--ink-deep);
            border: 1px solid var(--ink-line);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
        }
        .cp-suggest-pill.is-added {
            background: rgba(95, 160, 82, 0.14);
            color: #3f7536;
            border-color: rgba(95, 160, 82, 0.30);
            cursor: default;
        }
        .cp-suggest-pill__plus { font-size: 14px; font-weight: 700; color: var(--coral); }

        .cp-ai-cta {
            width: 100%;
            background: linear-gradient(180deg, var(--card-soft), var(--bg-cream));
            border: 1px dashed rgba(20, 57, 31, 0.18);
            border-radius: var(--radius-md);
            padding: 12px;
            font-size: 13px;
            font-weight: 600;
            color: var(--ink-deep);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        /* ─────────────────────────────────────────────────────────────
           STEPS
           ───────────────────────────────────────────────────────────── */
        .cp-detect-card {
            background: var(--card-soft);
            border: 1px solid var(--ink-line-soft);
            border-radius: 16px;
            padding: 14px;
        }
        .cp-detect-card__head {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 10px;
        }
        .cp-detect-card__icon { font-size: 18px; }
        .cp-detect-card__title {
            font-size: 13px;
            font-weight: 700;
            color: var(--ink-deep);
        }
        .cp-detect-card__sub {
            font-size: 11px;
            color: var(--ink-mute);
        }
        .cp-detect-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 11px;
            border-radius: var(--radius-pill);
            background: var(--card);
            color: var(--ink-deep);
            border: 1px solid var(--ink-line);
            font-size: 11px;
            font-weight: 600;
        }
        .cp-detect-chip.is-best {
            background: var(--ink-deep);
            color: white;
            border-color: var(--ink-deep);
        }
        .cp-detect-chip__pct { opacity: 0.5; font-weight: 700; }
        .cp-detect-chip.is-best .cp-detect-chip__pct { opacity: 0.7; }

        .cp-step-card {
            background: var(--card);
            border: 1px solid rgba(20, 57, 31, 0.10);
            border-radius: var(--radius-md);
            padding: 14px;
        }
        .cp-step-card__head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 8px;
        }
        .cp-step-card__label {
            font-size: 10px;
            font-weight: 700;
            color: var(--ink-mute);
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }
        .cp-step-card__actions { display: flex; gap: 5px; }
        .cp-btn-ghost {
            background: rgba(20, 57, 31, 0.06);
            border: none;
            border-radius: var(--radius-pill);
            padding: 5px 10px;
            font-size: 11px;
            font-weight: 600;
            color: var(--ink-deep);
            cursor: pointer;
        }
        .cp-btn-accept {
            background: var(--ink-deep);
            color: white;
            border: none;
            border-radius: var(--radius-pill);
            padding: 5px 12px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .cp-step-card__body {
            font-size: 14px;
            color: var(--ink-deep);
            line-height: 1.45;
        }
        .cp-step-card__action { color: var(--coral); font-weight: 700; }
        .cp-step-card__obj {
            color: var(--ink-deep);
            font-weight: 600;
            font-style: normal;
            border-bottom: 2px dotted var(--orange);
            padding-bottom: 1px;
        }
        .cp-step-card__hint { color: var(--ink-mute); }

        /* Smart Step Creator (inline) */
        .cp-smart-panel {
            background: linear-gradient(135deg, var(--ink-deep), var(--ink-deep-2));
            border-radius: 16px;
            padding: 16px;
            color: white;
        }
        .cp-smart-panel__head {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 4px;
        }
        .cp-smart-panel__title {
            font-family: var(--font-serif);
            font-size: 16px;
            font-weight: 600;
        }
        .cp-smart-panel__sub {
            font-size: 12px;
            opacity: 0.7;
            margin-bottom: 12px;
        }
        .cp-smart-cats {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: 12px;
        }
        .cp-smart-cat {
            padding: 6px 11px;
            border-radius: var(--radius-pill);
            background: rgba(255, 255, 255, 0.08);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.20);
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }
        .cp-smart-cat.is-active {
            background: white;
            color: var(--ink-deep);
            border-color: transparent;
        }
        .cp-smart-search {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: 12px;
            padding: 9px 12px;
        }
        .cp-smart-search__field {
            flex: 1;
            border: none;
            outline: none;
            background: transparent;
            font-size: 12px;
            color: white;
        }
        .cp-smart-search__field::placeholder { color: rgba(255, 255, 255, 0.5); }

        .cp-tpl-row {
            background: var(--card);
            border: 1px solid rgba(20, 57, 31, 0.10);
            border-radius: var(--radius-md);
            padding: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            text-align: left;
            width: 100%;
        }
        .cp-tpl-row__icon {
            width: 38px; height: 38px;
            border-radius: var(--radius-sm);
            background: var(--card-soft);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }
        .cp-tpl-row__body { flex: 1; min-width: 0; }
        .cp-tpl-row__title {
            font-size: 13px;
            font-weight: 700;
            color: var(--ink-deep);
        }
        .cp-tpl-row__sub {
            font-size: 11px;
            color: var(--ink-mute);
            margin-top: 2px;
        }
        .cp-tpl-row__meta {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 4px;
        }
        .cp-tpl-row__stars { font-size: 10px; color: var(--gold); }
        .cp-tpl-row__add {
            width: 22px; height: 22px;
            border-radius: 50%;
            background: var(--coral);
            color: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
        }

        /* ─────────────────────────────────────────────────────────────
           KEYWORDS
           ───────────────────────────────────────────────────────────── */
        .cp-keyword-pill {
            padding: 7px 14px;
            border-radius: var(--radius-pill);
            background: var(--card);
            color: var(--ink-deep);
            border: 1px solid var(--ink-line);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
        }
        .cp-keyword-pill.is-active {
            background: var(--ink-deep);
            color: white;
            border-color: var(--ink-deep);
        }
        .cp-keyword-preview {
            margin-top: 14px;
            padding: 12px 14px;
            background: var(--card-soft);
            border: 1px solid var(--ink-line-soft);
            border-radius: var(--radius-md);
            font-size: 12px;
            color: var(--ink-deep);
        }
        .cp-keyword-preview__hash {
            color: var(--coral);
            font-weight: 600;
        }

        /* ─────────────────────────────────────────────────────────────
           PUBLISH BAR
           ───────────────────────────────────────────────────────────── */
        .cp-publish {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 12px 16px 28px;
            background: linear-gradient(180deg, rgba(245, 239, 225, 0) 0%, rgba(245, 239, 225, 0.95) 30%, var(--bg-cream) 100%);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            z-index: 4;
            max-width: 480px;
            margin: 0 auto;
        }
        .cp-publish__card {
            background: var(--card);
            border-radius: var(--radius-lg);
            padding: 8px 8px 8px 16px;
            box-shadow: var(--shadow-bar);
            display: flex;
            align-items: center;
            gap: 10px;
            border: 1px solid var(--ink-line-soft);
        }
        .cp-publish__info { flex: 1; min-width: 0; }
        .cp-publish__label {
            font-family: var(--font-serif);
            font-size: 16px;
            font-weight: 600;
            color: var(--ink-deep);
            line-height: 1.1;
        }
        .cp-publish__progress {
            position: relative;
            height: 4px;
            background: rgba(20, 57, 31, 0.08);
            border-radius: 2px;
            margin-top: 6px;
        }
        .cp-publish__progress-fill {
            position: absolute;
            left: 0; top: 0; bottom: 0;
            background: linear-gradient(90deg, var(--orange), var(--coral));
            border-radius: 2px;
            transition: width .3s;
        }
        .cp-publish__progress-fill.is-ready {
            background: var(--avocado);
        }
        .cp-publish__btn {
            background: linear-gradient(135deg, var(--orange), var(--coral));
            color: white;
            border: none;
            border-radius: var(--radius-md);
            padding: 12px 18px;
            font-size: 14px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            box-shadow: var(--shadow-coral);
            flex-shrink: 0;
        }
        .cp-publish__btn:disabled {
            background: rgba(20, 57, 31, 0.08);
            color: var(--ink-mute);
            box-shadow: none;
            cursor: not-allowed;
        }
    </style>
</head>
<body>
<div class="cp-screen">

    @* ──────────────────  HERO  ────────────────── *@
    <header class="cp-hero">
        <div class="cp-hero__top">
            <button type="button" class="cp-hero__back" aria-label="Zurück">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <div class="cp-hero__eyebrow">Neues Posting</div>
            <button type="button" class="cp-hero__lang">
                DE
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg>
            </button>
        </div>

        <h1 class="cp-hero__title">@(string.IsNullOrEmpty(Model.Title) ? "Neues Posting" : Model.Title)</h1>

        <div class="cp-hero__meta">
            <span class="cp-hero__chip">@Model.CategoryEmoji @Model.CategoryLabel</span>
            <span class="cp-hero__metaline">· @Model.Persons Pers.</span>
            <span class="cp-hero__metaline">· @Model.Duration Min</span>
            <span class="cp-hero__counter">
                <span class="cp-hero__counter-num">@Model.DoneCount</span>
                <span class="cp-hero__counter-total">/ @Model.TotalSteps</span>
            </span>
        </div>

        <div class="cp-hero__progress">
            <div class="cp-hero__progress-fill" style="width: @(pct)%;"></div>
        </div>
    </header>

    @* ──────────────────  STICKY TABS  ────────────────── *@
    <nav class="cp-tabs-wrap" aria-label="Sektionen">
        <div class="cp-tabs" role="tablist">
            @{
                var tabs = new[] {
                    new { Id = "basis",    Label = "Basis",    Emoji = "🧩", Done = Model.BasisComplete },
                    new { Id = "media",    Label = "Media",    Emoji = "🎬", Done = Model.MediaComplete },
                    new { Id = "zutaten",  Label = "Zutaten",  Emoji = "🛒", Done = Model.ZutatenComplete },
                    new { Id = "steps",    Label = "Steps",    Emoji = "📝", Done = Model.StepsComplete },
                    new { Id = "keywords", Label = "Keywords", Emoji = "#",  Done = Model.KeywordsComplete }
                };
            }
            @foreach (var t in tabs)
            {
                <button type="button"
                        class="cp-tab @(t.Id == "basis" ? "is-active" : "")"
                        data-tab-target="cpb-@t.Id"
                        role="tab">
                    <span class="cp-tab__emoji">@t.Emoji</span>
                    @t.Label
                    @if (t.Done)
                    {
                        <span class="cp-tab__check">
                            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="4"><path d="M5 13l4 4L19 7"/></svg>
                        </span>
                    }
                </button>
            }
        </div>
    </nav>

    @* ──────────────────  FEED  ────────────────── *@
    <main class="cp-feed">

        @* ── 1. BASIS ── *@
        <section id="cpb-basis" class="cp-section @(Model.BasisComplete ? "is-complete" : "")">
            <div class="cp-section__head">
                <div class="cp-section__icon">
                    @if (Model.BasisComplete)
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
                    }
                    else
                    {
                        <span>🧩</span>
                    }
                </div>
                <div class="cp-section__head-text">
                    <h3 class="cp-section__title">Basis</h3>
                    <div class="cp-section__subtitle">Titel, Kategorie, Personen, Dauer</div>
                </div>
                <span class="cp-section__counter">1/@Model.TotalSteps</span>
            </div>
            <div class="cp-section__body">
                <div class="cp-stack">
                    <div>
                        <div class="cp-label"><span>Titel</span></div>
                        <label class="cp-input">
                            <span class="cp-input__icon">✏️</span>
                            <input class="cp-input__field" name="Title" type="text"
                                   value="@Model.Title" placeholder="z.B. Cremige Tomatensuppe" />
                        </label>
                    </div>

                    <div class="cp-grid-2">
                        <div>
                            <div class="cp-label"><span>Kategorie</span></div>
                            <button type="button" class="cp-select">
                                <span class="cp-select__icon">@(string.IsNullOrEmpty(Model.CategoryEmoji) ? "🍽️" : Model.CategoryEmoji)</span>
                                <span class="cp-select__value @(string.IsNullOrEmpty(Model.CategoryLabel) ? "is-empty" : "")">
                                    @(string.IsNullOrEmpty(Model.CategoryLabel) ? "Wählen" : Model.CategoryLabel)
                                </span>
                                <svg class="cp-select__caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                            </button>
                        </div>
                        <div>
                            <div class="cp-label"><span>Präferenz</span></div>
                            <button type="button" class="cp-select">
                                <span class="cp-select__icon">@(string.IsNullOrEmpty(Model.PrefEmoji) ? "💚" : Model.PrefEmoji)</span>
                                <span class="cp-select__value @(string.IsNullOrEmpty(Model.PrefLabel) ? "is-empty" : "")">
                                    @(string.IsNullOrEmpty(Model.PrefLabel) ? "Wählen" : Model.PrefLabel)
                                </span>
                                <svg class="cp-select__caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                            </button>
                        </div>
                    </div>

                    <div class="cp-grid-2">
                        <div>
                            <div class="cp-label"><span>Personen</span></div>
                            <label class="cp-input">
                                <span class="cp-input__icon">👥</span>
                                <input class="cp-input__field" name="Persons" type="number" min="1"
                                       value="@Model.Persons" placeholder="2" />
                                <span class="cp-input__suffix">Pers.</span>
                            </label>
                        </div>
                        <div>
                            <div class="cp-label"><span>Dauer</span></div>
                            <label class="cp-input">
                                <span class="cp-input__icon">⏱</span>
                                <input class="cp-input__field" name="Duration" type="number" min="1"
                                       value="@Model.Duration" placeholder="30" />
                                <span class="cp-input__suffix">Min</span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        @* ── 2. MEDIA ── *@
        <section id="cpb-media" class="cp-section @(Model.MediaComplete ? "is-complete" : "")">
            <div class="cp-section__head">
                <div class="cp-section__icon cp-section__icon--accent">
                    @if (Model.MediaComplete)
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
                    }
                    else
                    {
                        <span>🎬</span>
                    }
                </div>
                <div class="cp-section__head-text">
                    <h3 class="cp-section__title">Media</h3>
                    <div class="cp-section__subtitle">Video oder Bild für den Feed</div>
                </div>
                <span class="cp-section__counter">2/@Model.TotalSteps</span>
            </div>
            <div class="cp-section__body">
                @if (!string.IsNullOrEmpty(Model.MediaUrl))
                {
                    <div>
                        <div class="cp-media-filled" style="background-image: url('@Model.MediaUrl');">
                            <div class="cp-media-overlay-actions">
                                <div class="cp-media-overlay-action">
                                    <span class="cp-media-overlay-action__btn">❤️</span>
                                    <span class="cp-media-overlay-action__count">—</span>
                                </div>
                                <div class="cp-media-overlay-action">
                                    <span class="cp-media-overlay-action__btn">💬</span>
                                    <span class="cp-media-overlay-action__count">—</span>
                                </div>
                                <div class="cp-media-overlay-action">
                                    <span class="cp-media-overlay-action__btn">🔖</span>
                                    <span class="cp-media-overlay-action__count">—</span>
                                </div>
                            </div>
                            <div class="cp-media-caption">
                                <div class="cp-media-caption__eyebrow">VORSCHAU · FEED</div>
                                <div class="cp-media-caption__title">So sieht dein Posting im Feed aus</div>
                            </div>
                            <button type="button" class="cp-media-replace">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5-5 5 5M12 5v14"/></svg>
                                Ersetzen
                            </button>
                        </div>
                        <div class="cp-media-edit-row">
                            <button type="button" class="cp-secondary-btn">✂️ Trimmen</button>
                            <button type="button" class="cp-secondary-btn">🎵 Sound</button>
                            <button type="button" class="cp-secondary-btn">📐 Format</button>
                        </div>
                    </div>
                }
                else
                {
                    <div>
                        <button type="button" class="cp-media-empty">
                            <div class="cp-media-empty__icon">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                                    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5-5 5 5M12 5v14"/>
                                </svg>
                            </div>
                            <div>
                                <div class="cp-media-empty__heading">Upload starten</div>
                                <div class="cp-media-empty__sub">Wähle ein Video oder Bild für den Feed</div>
                            </div>
                            <div class="cp-media-empty__specs">
                                <span class="cp-spec-pill">9:16</span>
                                <span class="cp-spec-pill">MP4 · MOV</span>
                                <span class="cp-spec-pill">≤ 60s</span>
                            </div>
                        </button>
                        <div class="cp-media-edit-row">
                            <button type="button" class="cp-secondary-btn">📷 Kamera</button>
                            <button type="button" class="cp-secondary-btn">🖼 Galerie</button>
                            <button type="button" class="cp-secondary-btn">✨ AI-Gen</button>
                        </div>
                    </div>
                }
            </div>
        </section>

        @* ── 3. ZUTATEN ── *@
        <section id="cpb-zutaten" class="cp-section @(Model.ZutatenComplete ? "is-complete" : "")">
            <div class="cp-section__head">
                <div class="cp-section__icon">
                    @if (Model.ZutatenComplete)
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
                    }
                    else
                    {
                        <span>🛒</span>
                    }
                </div>
                <div class="cp-section__head-text">
                    <h3 class="cp-section__title">Zutaten</h3>
                    <div class="cp-section__subtitle">Suche & konfiguriere</div>
                </div>
                <span class="cp-section__counter">3/@Model.TotalSteps</span>
            </div>
            <div class="cp-section__body">
                <div class="cp-stack">
                    <label class="cp-input">
                        <span class="cp-input__icon">🔍</span>
                        <input class="cp-input__field" type="search" placeholder="Zutat suchen..." />
                    </label>

                    @if (Model.Ingredients != null && Model.Ingredients.Count > 0)
                    {
                        <div>
                            <div class="cp-label">
                                <span>Deine Zutaten · @Model.Ingredients.Count</span>
                            </div>
                            <div class="cp-stack cp-stack--sm">
                                @foreach (var ing in Model.Ingredients)
                                {
                                    <div class="cp-ing-row">
                                        <span class="cp-ing-row__emoji">@ing.Emoji</span>
                                        <span class="cp-ing-row__name">@ing.Name</span>
                                        <div class="cp-stepper">
                                            <button type="button" class="cp-stepper__btn">−</button>
                                            <span class="cp-stepper__count">@ing.Amount @ing.Unit</span>
                                            <button type="button" class="cp-stepper__btn cp-stepper__btn--plus">+</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div>
                        <div class="cp-label">
                            <span>Vorschläge zum Antippen</span>
                            <span class="cp-label__badge">✨ AI vorgeschlagen</span>
                        </div>
                        <div class="cp-pill-wrap">
                            @if (Model.Suggestions != null)
                            {
                                @foreach (var s in Model.Suggestions.Take(10))
                                {
                                    var added = Model.Ingredients != null && Model.Ingredients.Any(i => i.Name == s.Name);
                                    <button type="button" class="cp-suggest-pill @(added ? "is-added" : "")">
                                        <span style="font-size:14px;">@s.Emoji</span>
                                        @s.Name
                                        @if (added)
                                        {
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#5fa052" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
                                        }
                                        else
                                        {
                                            <span class="cp-suggest-pill__plus">+</span>
                                        }
                                    </button>
                                }
                            }
                        </div>
                    </div>

                    <button type="button" class="cp-ai-cta">✨ Zutat fehlt? AI bitten</button>
                </div>
            </div>
        </section>

        @* ── 4. STEPS (mit Smart Step Creator inline) ── *@
        <section id="cpb-steps" class="cp-section @(Model.StepsComplete ? "is-complete" : "")">
            <div class="cp-section__head">
                <div class="cp-section__icon">
                    @if (Model.StepsComplete)
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
                    }
                    else
                    {
                        <span>📝</span>
                    }
                </div>
                <div class="cp-section__head-text">
                    <h3 class="cp-section__title">Steps</h3>
                    <div class="cp-section__subtitle">Rezepttyp, erkannte & eigene Steps</div>
                </div>
                <span class="cp-section__counter">4/@Model.TotalSteps</span>
            </div>
            <div class="cp-section__body">
                <div class="cp-stack cp-stack--md">

                    @* Was könnte es sein? *@
                    <div class="cp-detect-card">
                        <div class="cp-detect-card__head">
                            <span class="cp-detect-card__icon">🔮</span>
                            <div>
                                <div class="cp-detect-card__title">Was könnte es sein?</div>
                                <div class="cp-detect-card__sub">Rezepttyp & passende Steps</div>
                            </div>
                        </div>
                        <div class="cp-pill-wrap">
                            @if (Model.DetectedTypes != null)
                            {
                                @foreach (var d in Model.DetectedTypes)
                                {
                                    <span class="cp-detect-chip @(d.Best ? "is-best" : "")">
                                        @if (d.Best)
                                        {
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="#f5b942"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                        }
                                        <span>@d.Emoji</span>
                                        @d.Label
                                        <span class="cp-detect-chip__pct">@d.Pct%</span>
                                    </span>
                                }
                            }
                        </div>
                    </div>

                    @* Erkannte Steps *@
                    <div>
                        <div class="cp-label"><span>Erkannte Steps · zum Antippen</span></div>
                        <div class="cp-stack cp-stack--sm">
                            @if (Model.DetectedSteps != null)
                            {
                                var i = 0;
                                @foreach (var s in Model.DetectedSteps)
                                {
                                    i++;
                                    <div class="cp-step-card">
                                        <div class="cp-step-card__head">
                                            <span class="cp-step-card__label">Erkannter Step #@i</span>
                                            <div class="cp-step-card__actions">
                                                <button type="button" class="cp-btn-ghost" aria-label="Verwerfen">✕</button>
                                                <button type="button" class="cp-btn-accept">
                                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
                                                    Akzeptieren
                                                </button>
                                            </div>
                                        </div>
                                        <div class="cp-step-card__body">
                                            <strong class="cp-step-card__action">@s.Action</strong>
                                            <em class="cp-step-card__obj">@string.Join(" und ", s.Objects)</em>
                                            <span class="cp-step-card__hint">@s.Hint</span>.
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    @* Smart Step Creator (inline, nicht eigene Section) *@
                    <div class="cp-smart-panel">
                        <div class="cp-smart-panel__head">
                            <span style="font-size:16px;">✨</span>
                            <div class="cp-smart-panel__title">Smart Step Creator</div>
                        </div>
                        <div class="cp-smart-panel__sub">Zutat + Template wie im Creator-Flow</div>
                        <div class="cp-smart-cats">
                            <button type="button" class="cp-smart-cat">Alle</button>
                            <button type="button" class="cp-smart-cat is-active">⭐ Beste</button>
                            <button type="button" class="cp-smart-cat">🥕 Vorbereitung</button>
                            <button type="button" class="cp-smart-cat">🔥 Kochen</button>
                            <button type="button" class="cp-smart-cat">✨ Finishing</button>
                            <button type="button" class="cp-smart-cat">🍽️ Servieren</button>
                        </div>
                        <label class="cp-smart-search">
                            <span style="font-size:12px;opacity:.7;">🔍</span>
                            <input class="cp-smart-search__field" type="search" placeholder="Step suchen (z.B. anbraten, schneiden)…" />
                        </label>
                    </div>

                    @* Templates *@
                    <div>
                        <div class="cp-label"><span>Templates · zum Antippen</span></div>
                        <div class="cp-stack cp-stack--sm">
                            @if (Model.StepTemplates != null)
                            {
                                @foreach (var t in Model.StepTemplates.Take(3))
                                {
                                    <button type="button" class="cp-tpl-row">
                                        <div class="cp-tpl-row__icon">@t.Emoji</div>
                                        <div class="cp-tpl-row__body">
                                            <div class="cp-tpl-row__title">@t.Title</div>
                                            <div class="cp-tpl-row__sub">@t.Body</div>
                                        </div>
                                        <div class="cp-tpl-row__meta">
                                            <div class="cp-tpl-row__stars">@(new string('★', t.Stars))</div>
                                            <span class="cp-tpl-row__add">+</span>
                                        </div>
                                    </button>
                                }
                            }
                        </div>
                    </div>

                </div>
            </div>
        </section>

        @* ── 5. KEYWORDS ── *@
        <section id="cpb-keywords" class="cp-section @(Model.KeywordsComplete ? "is-complete" : "")">
            <div class="cp-section__head">
                <div class="cp-section__icon">
                    @if (Model.KeywordsComplete)
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
                    }
                    else
                    {
                        <span>#</span>
                    }
                </div>
                <div class="cp-section__head-text">
                    <h3 class="cp-section__title">Keywords</h3>
                    <div class="cp-section__subtitle">Hilft beim Feed & bei der Suche</div>
                </div>
                <span class="cp-section__counter">5/@Model.TotalSteps</span>
            </div>
            <div class="cp-section__body">
                <div class="cp-label">
                    <span>@(Model.SelectedKeywords?.Count ?? 0) ausgewählt · max 8 sichtbar im Feed</span>
                </div>
                <div class="cp-pill-wrap">
                    @if (Model.Keywords != null)
                    {
                        @foreach (var k in Model.Keywords)
                        {
                            var sel = Model.SelectedKeywords != null && Model.SelectedKeywords.Contains(k);
                            <button type="button" class="cp-keyword-pill @(sel ? "is-active" : "")" data-keyword="@k">
                                @k
                            </button>
                        }
                    }
                </div>
                @if (Model.SelectedKeywords != null && Model.SelectedKeywords.Count > 0)
                {
                    <div class="cp-keyword-preview">
                        <span style="font-weight:700;">Vorschau:</span>
                        @foreach (var k in Model.SelectedKeywords.Take(6))
                        {
                            <span class="cp-keyword-preview__hash">#@(k.Replace(" ", ""))</span> 
                        }
                        @if (Model.SelectedKeywords.Count > 6)
                        {
                            <span style="color:var(--ink-mute);">+@(Model.SelectedKeywords.Count - 6)</span>
                        }
                    </div>
                }
            </div>
        </section>

    </main>

    @* ──────────────────  PUBLISH BAR  ────────────────── *@
    <div class="cp-publish">
        <div class="cp-publish__card">
            <div class="cp-publish__info">
                <div class="cp-publish__label">
                    @(ready ? "Bereit zum Posten ✨" : $"{Model.DoneCount}/{Model.TotalSteps} Schritte fertig")
                </div>
                <div class="cp-publish__progress">
                    <div class="cp-publish__progress-fill @(ready ? "is-ready" : "")" style="width: @(pct)%;"></div>
                </div>
            </div>
            <button type="button" class="cp-publish__btn" @(ready ? "" : "disabled")>
                Veröffentlichen
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
                </svg>
            </button>
        </div>
    </div>

</div>

<script>
(function () {
    // Tab click → smooth scroll
    var tabs = document.querySelectorAll('.cp-tab');
    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            var id = tab.getAttribute('data-tab-target');
            var el = document.getElementById(id);
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    });

    // Scroll spy
    var sectionIds = ['cpb-basis', 'cpb-media', 'cpb-zutaten', 'cpb-steps', 'cpb-keywords'];
    function onScroll() {
        var top = window.scrollY + 100;
        var current = sectionIds[0];
        sectionIds.forEach(function (id) {
            var el = document.getElementById(id);
            if (el && el.offsetTop <= top) current = id;
        });
        tabs.forEach(function (t) {
            t.classList.toggle('is-active', t.getAttribute('data-tab-target') === current);
        });
    }
    window.addEventListener('scroll', onScroll, { passive: true });

    // Stepper +/-
    document.querySelectorAll('.cp-stepper').forEach(function (st) {
        var minus = st.querySelector('.cp-stepper__btn:not(.cp-stepper__btn--plus)');
        var plus = st.querySelector('.cp-stepper__btn--plus');
        var label = st.querySelector('.cp-stepper__count');
        function parse() {
            var m = (label.textContent || '').trim().match(/^(\d+)\s*(.*)$/);
            return m ? { n: parseInt(m[1], 10), unit: m[2] } : { n: 0, unit: 'Stk.' };
        }
        function set(n, unit) { label.textContent = n + ' ' + unit; }
        minus && minus.addEventListener('click', function () {
            var p = parse(); if (p.n > 0) set(p.n - 1, p.unit);
        });
        plus && plus.addEventListener('click', function () {
            var p = parse(); set(p.n + 1, p.unit);
        });
    });

    // Keyword toggle
    document.querySelectorAll('.cp-keyword-pill').forEach(function (p) {
        p.addEventListener('click', function () { p.classList.toggle('is-active'); });
    });

    // Suggestion add
    document.querySelectorAll('.cp-suggest-pill:not(.is-added)').forEach(function (p) {
        p.addEventListener('click', function () { p.classList.add('is-added'); });
    });

    // Smart cat toggle
    document.querySelectorAll('.cp-smart-cat').forEach(function (c) {
        c.addEventListener('click', function () {
            document.querySelectorAll('.cp-smart-cat').forEach(function (x) { x.classList.remove('is-active'); });
            c.classList.add('is-active');
        });
    });
})();
</script>

</body>
</html>
