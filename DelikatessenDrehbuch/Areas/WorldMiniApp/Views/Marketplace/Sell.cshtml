@model List<DelikatessenDrehbuch.Areas.WorldMiniApp.Models.WorldUserMealPlan>
@inject Microsoft.Extensions.Localization.IStringLocalizer<DelikatessenDrehbuch.SharedResources> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Offer.Title"];
    Layout = "_MiniAppLayout";
    var userHash = ViewData["UserHash"]?.ToString() ?? "";
    var walletWLD = ViewData["WalletWLD"]?.ToString() ?? "";
    var walletUSDT = ViewData["WalletUSDT"]?.ToString() ?? "";

    var worldChainId = ViewData["WorldChainId"]?.ToString() ?? "480";
    var worldChainWldToken = ViewData["WorldChainWldToken"]?.ToString() ?? "";
    var worldChainUsdtToken = ViewData["WorldChainUsdtToken"]?.ToString() ?? "";
    var worldChainMarketplace = ViewData["WorldChainMarketplace"]?.ToString() ?? "";
    var testMode = (bool?)ViewData["WorldChainTestMode"] ?? false;
    var myRecipes = ViewData["MyRecipes"] as List<DelikatessenDrehbuch.Areas.WorldMiniApp.Controllers.MarketplaceController.RecipeOption>
        ?? new List<DelikatessenDrehbuch.Areas.WorldMiniApp.Controllers.MarketplaceController.RecipeOption>();
}

<style>
    body { background: #f5efe1 !important; }
    .c2-root { max-width: 720px; margin: 0 auto; }

    /* Top bar */
    .c2-bar { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between;
        padding: 10px 12px 10px 10px; background: #f5efe1; border-bottom: 1px solid rgba(20,57,31,.10); }
    .c2-bar-icon { width: 38px; height: 38px; border-radius: 50%; border: none; background: transparent; color: #14391f;
        display: flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none; }
    .c2-bar-icon:hover { background: rgba(20,57,31,.06); }
    .c2-bar-title { position: absolute; left: 50%; transform: translateX(-50%); font-size: 15.5px; font-weight: 700; color: #14391f; }
    .c2-share { border: none; border-radius: 999px; padding: 9px 18px; font-size: 14px; font-weight: 700; color: #fff;
        background: linear-gradient(135deg,#1a3a23,#0e2415); box-shadow: 0 4px 12px rgba(20,57,31,.22); cursor: pointer; }
    .c2-share.off { background: #c2cdba; box-shadow: none; cursor: not-allowed; }

    .c2-scroll { padding: 14px 16px 32px; display: flex; flex-direction: column; gap: 16px; }

    /* Media upload */
    .c2-drop { width: 100%; aspect-ratio: 4/3; background: #faf6ec; border: 2px dashed rgba(20,57,31,.22); border-radius: 22px;
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; cursor: pointer; }
    .c2-drop:hover { border-color: #5fa052; background: #fff; }
    .c2-drop-ico { width: 60px; height: 60px; border-radius: 50%; background: #14391f; color: #fff; display: flex; align-items: center; justify-content: center; }
    .c2-drop-title { font-size: 15px; font-weight: 700; color: #14391f; }
    .c2-drop-sub { font-size: 12.5px; color: #6b7868; }
    .c2-media-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .c2-thumb { position: relative; aspect-ratio: 1; border-radius: 14px; background-size: cover; background-position: center; }
    .c2-thumb.cover { grid-column: span 2; grid-row: span 2; border-radius: 18px; }
    .c2-cover-badge { position: absolute; left: 8px; bottom: 8px; background: rgba(14,36,21,.7); color: #fff; font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 999px; }
    .c2-thumb-x { position: absolute; top: 6px; right: 6px; width: 22px; height: 22px; border-radius: 50%; border: none;
        background: rgba(14,36,21,.6); color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .c2-add { border: 2px dashed rgba(20,57,31,.25); background: #faf6ec; color: #14391f; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .c2-add:hover { border-color: #5fa052; }
    .c2-uploading { display:flex; align-items:center; justify-content:center; }

    /* Type menu (grid) */
    .c2-typewrap { background: #fff; border-radius: 22px; padding: 16px 16px 18px; box-shadow: 0 2px 10px rgba(20,57,31,.06); }
    .c2-type-head { font-size: 14px; font-weight: 700; color: #14391f; margin-bottom: 13px; }
    .c2-types { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; }
    .c2-type { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px;
        padding: 15px 6px 12px; background: #faf6ec; border: 1.5px solid rgba(20,57,31,.12); border-radius: 16px;
        color: #2a4a32; cursor: pointer; transition: all .15s; }
    .c2-type:hover { border-color: rgba(20,57,31,.28); }
    .c2-type.on { border-color: #14391f; border-width: 2px; background: #fff; box-shadow: 0 2px 10px rgba(20,57,31,.06); }
    .c2-type-ico { width: 44px; height: 44px; border-radius: 13px; display: flex; align-items: center; justify-content: center;
        background: rgba(20,57,31,.06); color: #14391f; }
    .c2-type-ico svg { width: 22px; height: 22px; }
    .c2-type.on .c2-type-ico { background: #14391f; color: #fff; }
    .c2-type-label { font-size: 12.5px; font-weight: 600; color: #14391f; }

    /* Detail / cards */
    .c2-detail, .c2-field, .c2-price { background: #fff; border-radius: 18px; box-shadow: 0 2px 10px rgba(20,57,31,.06); }
    .c2-detail { padding: 16px; }
    .c2-detail-label { font-size: 14px; font-weight: 700; color: #14391f; margin-bottom: 10px; }
    .c2-detail-hint { font-size: 12px; color: #6b7868; margin-top: 8px; }
    .c2-inp, .c2-select { width: 100%; background: #faf6ec; border: 1.5px solid rgba(20,57,31,.12); border-radius: 12px; padding: 11px 12px; font-size: 14px; color: #14391f; outline: none; }
    .c2-inp:focus, .c2-select:focus { border-color: #5fa052; box-shadow: 0 0 0 3px rgba(95,160,82,.15); }
    .c2-inp + .c2-inp { margin-top: 10px; }
    .c2-select-wrap { position: relative; }
    .c2-select { appearance: none; }
    .c2-select-chev { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: #6b7868; pointer-events: none; }
    .c2-plans { display: flex; flex-direction: column; gap: 8px; }
    .c2-plan { position: relative; text-align: left; background: #faf6ec; border: 2px solid transparent; border-radius: 12px; padding: 11px 12px; cursor: pointer; }
    .c2-plan.sel { border-color: #14391f; background: rgba(20,57,31,.05); }
    .c2-plan-name { display: block; font-weight: 700; color: #14391f; font-size: 14px; }
    .c2-plan-meta { display: block; font-size: 12px; color: #6b7868; margin-top: 2px; }
    .c2-plan-check { position: absolute; right: 12px; top: 12px; width: 22px; height: 22px; border-radius: 50%; background: #14391f; color: #fff; display: flex; align-items: center; justify-content: center; }
    .c2-check { display: inline-flex; align-items: center; gap: 8px; background: none; border: none; cursor: pointer; margin-top: 10px; color: #14391f; font-size: 14px; }
    .c2-box { width: 22px; height: 22px; border-radius: 7px; border: 2px solid rgba(20,57,31,.25); display: flex; align-items: center; justify-content: center; color: #fff; }
    .c2-box.on { background: #14391f; border-color: #14391f; }

    /* Title + caption */
    .c2-field { padding: 4px 16px; }
    .c2-title-input { width: 100%; border: none; outline: none; background: transparent; font-family: 'Fraunces','Playfair Display',Georgia,serif;
        font-weight: 600; font-size: 20px; letter-spacing: -.02em; color: #14391f; padding: 15px 0 13px; }
    .c2-title-input::placeholder { color: #b3bbac; }
    .c2-divider { height: 1px; background: rgba(20,57,31,.10); }
    .c2-caption { width: 100%; border: none; outline: none; resize: none; background: transparent; font-size: 14px; line-height: 1.55; color: #22301f; padding: 13px 0; font-family: inherit; }
    .c2-caption::placeholder { color: #b3bbac; }

    /* Price */
    .c2-price { padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; }
    .c2-price-label { font-size: 15px; font-weight: 700; color: #14391f; }
    .c2-price-right { display: flex; align-items: center; gap: 6px; }
    .c2-price-input { width: 96px; border: none; outline: none; background: transparent; text-align: right;
        font-family: 'Fraunces','Playfair Display',Georgia,serif; font-weight: 600; font-size: 26px; color: #14391f; }
    .c2-price-input::placeholder { color: #c4cbbc; }
    .c2-price-cur { font-size: 15px; font-weight: 700; color: #6b7868; }
    .c2-split { font-size: 12.5px; color: #6b7868; margin-top: -8px; }
    .c2-split b { color: #14391f; }

    /* Wallet strip */
    .c2-wallet { width: 100%; display: flex; align-items: center; gap: 12px; text-align: left; border: none; cursor: pointer;
        background: linear-gradient(135deg,#1f4329,#0e2415); border-radius: 18px; padding: 14px 16px; box-shadow: 0 6px 20px rgba(14,36,21,.18); color: #fff; }
    .c2-wallet-ico { width: 36px; height: 36px; border-radius: 11px; background: rgba(255,255,255,.12); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .c2-wallet.on .c2-wallet-ico { background: rgba(95,160,82,.30); }
    .c2-wallet-text { flex: 1; display: flex; flex-direction: column; }
    .c2-wallet-title { font-size: 13.5px; font-weight: 600; }
    .c2-wallet-sub { font-size: 12px; color: rgba(255,255,255,.6); margin-top: 1px; }
    .c2-wallet.on .c2-wallet-sub { color: #8bbf7d; }
    .c2-wallet-state { font-size: 12px; font-weight: 700; padding: 6px 12px; border-radius: 999px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.25); }
    .c2-wallet.on .c2-wallet-state { background: rgba(95,160,82,.30); border-color: rgba(95,160,82,.5); }

    /* Preview */
    .c2-preview-head { display: flex; align-items: baseline; gap: 8px; }
    .c2-preview-head > span:first-child { font-size: 13px; font-weight: 700; color: #14391f; text-transform: uppercase; letter-spacing: .08em; }
    .c2-preview-hint { font-size: 12px; color: #6b7868; }
    .c2-preview { background: #fff; border-radius: 18px; box-shadow: 0 6px 20px rgba(14,36,21,.18); overflow: hidden; }
    .c2-preview-media { aspect-ratio: 16/10; background: #e8e1d0; background-size: cover; background-position: center; position: relative; display: flex; align-items: center; justify-content: center; color: #b3a98f; }
    .c2-preview-type { position: absolute; left: 10px; top: 10px; background: rgba(255,255,255,.92); color: #14391f; font-size: 11px; font-weight: 700; padding: 4px 9px; border-radius: 999px; }
    .c2-preview-body { padding: 13px 15px 15px; }
    .c2-preview-seller { display: flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 600; color: #6b7868; }
    .c2-avatar { width: 20px; height: 20px; border-radius: 50%; background: #14391f; color: #fff; font-size: 11px; display: flex; align-items: center; justify-content: center; }
    .c2-preview-title { font-family: 'Fraunces','Playfair Display',Georgia,serif; font-weight: 600; font-size: 18px; color: #14391f; margin: 8px 0; }
    .c2-preview-foot { display: flex; align-items: center; justify-content: space-between; }
    .c2-preview-price { font-family: 'Fraunces',serif; font-weight: 600; font-size: 18px; color: #14391f; }
    .c2-preview-buy { background: #14391f; color: #fff; font-size: 12.5px; font-weight: 700; padding: 7px 14px; border-radius: 999px; }
</style>

<div class="c2-root">
    <!-- Top bar -->
    <div class="c2-bar">
        <a href="@Url.Action("Index", "Marketplace", new { area = "WorldMiniApp" })" class="c2-bar-icon" aria-label="@SharedLocalizer["Offer.Close"]">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </a>
        <span class="c2-bar-title">@SharedLocalizer["Offer.Title"]</span>
        <button type="button" class="c2-share off" id="shareBtn" disabled onclick="createListing()">@SharedLocalizer["Offer.Share"]</button>
    </div>

    <div class="c2-scroll">
        <!-- Media upload -->
        <input type="file" id="photoInput" accept="image/*" style="display:none;" onchange="onPhotoSelected(event)" />
        <button type="button" class="c2-drop" id="dropZone" onclick="document.getElementById('photoInput').click()">
            <span class="c2-drop-ico"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5A2.5 2.5 0 015.5 6h1.2a2 2 0 001.7-1l.5-.8a2 2 0 011.7-1h2.8a2 2 0 011.7 1l.5.8a2 2 0 001.7 1h1.2A2.5 2.5 0 0121 8.5V17a2.5 2.5 0 01-2.5 2.5h-13A2.5 2.5 0 013 17z"/><circle cx="12" cy="12.5" r="3.2"/></svg></span>
            <span class="c2-drop-title">@SharedLocalizer["Offer.AddPhotos"]</span>
            <span class="c2-drop-sub">@SharedLocalizer["Offer.AddPhotosSub"]</span>
        </button>
        <div class="c2-media-grid" id="mediaGrid" style="display:none;"></div>

        <!-- Type menu (grid) -->
        <div class="c2-typewrap">
            <div class="c2-type-head">@SharedLocalizer["Offer.WhatOffer"]</div>
            <div class="c2-types" id="typePills">
                <button type="button" class="c2-type" data-type="MealPlan" onclick="selectType('MealPlan')"><span class="c2-type-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/></svg></span><span class="c2-type-label">@SharedLocalizer["Offer.TypeMealPlan"]</span></button>
                <button type="button" class="c2-type" data-type="SingleRecipe" onclick="selectType('SingleRecipe')"><span class="c2-type-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2.5"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span><span class="c2-type-label">@SharedLocalizer["Offer.TypeRecipe"]</span></button>
                <button type="button" class="c2-type on" data-type="PhysicalObject" onclick="selectType('PhysicalObject')"><span class="c2-type-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 7.5l-9-5-9 5 9 5 9-5z"/><path d="M3 7.5v9l9 5 9-5v-9M12 12.5v9"/></svg></span><span class="c2-type-label">@SharedLocalizer["Offer.TypeObject"]</span></button>
                <button type="button" class="c2-type" data-type="DigitalProduct" onclick="selectType('DigitalProduct')"><span class="c2-type-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M19 16.5A4 4 0 0017.5 9h-1.3A6 6 0 104 14.5"/><path d="M12 11v8M8.5 15.5L12 19l3.5-3.5"/></svg></span><span class="c2-type-label">@SharedLocalizer["Offer.TypeDigital"]</span></button>
                <button type="button" class="c2-type" data-type="Service" onclick="selectType('Service')"><span class="c2-type-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2.5"/><circle cx="12" cy="10" r="2.4"/><path d="M8 16.5a4 4 0 018 0"/></svg></span><span class="c2-type-label">@SharedLocalizer["Offer.TypeService"]</span></button>
            </div>
        </div>

        <!-- Per-type details -->
        <div class="c2-detail" data-detail="MealPlan" style="display:none;">
            <div class="c2-detail-label">@SharedLocalizer["Offer.WhichPlan"]</div>
            @if (Model.Any())
            {
                <div class="c2-plans">
                    @foreach (var plan in Model)
                    {
                        <button type="button" class="c2-plan" data-plan-id="@plan.Id" onclick="selectPlan(this, @plan.Id)">
                            <span class="c2-plan-name">@(plan.Title ?? SharedLocalizer["Offer.TypeMealPlan"].Value)</span>
                            <span class="c2-plan-meta">@SharedLocalizer["Offer.Created"] @plan.CreationTime.ToString("dd.MM.yyyy")</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="c2-detail-hint">@SharedLocalizer["Offer.NoPlans"]</div>
            }
        </div>

        <div class="c2-detail" data-detail="SingleRecipe" style="display:none;">
            <div class="c2-detail-label">@SharedLocalizer["Offer.WhichRecipe"]</div>
            @if (myRecipes.Any())
            {
                <div class="c2-select-wrap">
                    <select id="recipeSelect" class="c2-select" onchange="onRecipeSelected()">
                        <option value="">@SharedLocalizer["Offer.PickRecipe"]</option>
                        @foreach (var r in myRecipes)
                        {
                            <option value="@r.Id">@r.Title</option>
                        }
                    </select>
                    <span class="c2-select-chev"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
                </div>
            }
            else
            {
                <div class="c2-detail-hint">@SharedLocalizer["Offer.NoRecipes"]</div>
            }
        </div>

        <div class="c2-detail" data-detail="PhysicalObject">
            <div class="c2-detail-label">@SharedLocalizer["Offer.ProductDetails"]</div>
            <input type="number" id="objStock" class="c2-inp" min="0" placeholder="@SharedLocalizer["Offer.StockPlaceholder"]" />
            <button type="button" class="c2-check" id="objShippingBtn" onclick="toggleShipping()">
                <span class="c2-box on" id="objShippingBox"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
                <span>@SharedLocalizer["Offer.ShippingNeeded"]</span>
            </button>
            <div class="c2-detail-hint">@SharedLocalizer["Offer.ShippingHint"]</div>
        </div>

        <div class="c2-detail" data-detail="DigitalProduct" style="display:none;">
            <div class="c2-detail-label">@SharedLocalizer["Offer.DigitalTitle"]</div>
            <input type="url" id="digitalUrl" class="c2-inp" placeholder="@SharedLocalizer["Offer.DigitalUrlPlaceholder"]" maxlength="1000" oninput="updateValidity()" />
            <div class="c2-detail-hint">@SharedLocalizer["Offer.DigitalHint"]</div>
        </div>

        <div class="c2-detail" data-detail="Service" style="display:none;">
            <div class="c2-detail-label">@SharedLocalizer["Offer.ServiceTitle"]</div>
            <input type="text" id="serviceAvail" class="c2-inp" placeholder="@SharedLocalizer["Offer.ServiceAvailPlaceholder"]" maxlength="200" />
            <div class="c2-detail-hint">@SharedLocalizer["Offer.ServiceHint"]</div>
        </div>

        <!-- Title + caption -->
        <div class="c2-field">
            <input type="text" id="listingTitle" class="c2-title-input" placeholder="@SharedLocalizer["Offer.TitlePlaceholder"]" maxlength="100" oninput="updatePreview(); updateValidity();" />
            <div class="c2-divider"></div>
            <textarea id="listingDescription" class="c2-caption" rows="3" maxlength="300" placeholder="@SharedLocalizer["Offer.CaptionPlaceholder"]"></textarea>
        </div>

        <!-- Price -->
        <div class="c2-price">
            <span class="c2-price-label">@SharedLocalizer["Offer.Price"]</span>
            <div class="c2-price-right">
                <input type="text" id="listingPrice" class="c2-price-input" inputmode="decimal" placeholder="0" oninput="onPriceInput()" />
                <span class="c2-price-cur">WLD</span>
            </div>
        </div>
        <div class="c2-split" id="splitLine" style="display:none;"></div>

        <!-- Wallet strip -->
        <button type="button" class="c2-wallet" id="walletStrip" onclick="connectSellerWallet()">
            <span class="c2-wallet-ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 012-2h12a2 2 0 012 2v1"/><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2v-6a2 2 0 00-2-2H5"/><circle cx="16" cy="13" r="1.2" fill="currentColor" stroke="none"/></svg></span>
            <span class="c2-wallet-text">
                <span class="c2-wallet-title">@SharedLocalizer["Offer.WalletTitle"]</span>
                <span class="c2-wallet-sub" id="walletSub">@SharedLocalizer["Offer.WalletConnectHint"]</span>
            </span>
            <span class="c2-wallet-state" id="walletState">@SharedLocalizer["Offer.WalletConnect"]</span>
        </button>

        <!-- Live preview -->
        <div class="c2-preview-head">
            <span>@SharedLocalizer["Offer.PreviewHead"]</span>
            <span class="c2-preview-hint">@SharedLocalizer["Offer.PreviewHint"]</span>
        </div>
        <div class="c2-preview">
            <div class="c2-preview-media" id="previewMedia">
                <svg id="previewGlyph" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2.5"/><circle cx="8.5" cy="9.5" r="1.6"/><path d="M4 17l5-4 4 3 3-2.5 4 3.5"/></svg>
                <span class="c2-preview-type" id="previewType">@SharedLocalizer["Offer.TypeObject"]</span>
            </div>
            <div class="c2-preview-body">
                <div class="c2-preview-seller"><span class="c2-avatar">@(string.IsNullOrEmpty(userHash) ? "?" : userHash.Substring(0, 1).ToUpper())</span> @SharedLocalizer["Offer.You"]</div>
                <div class="c2-preview-title" id="previewTitle">@SharedLocalizer["Offer.PreviewTitleFallback"]</div>
                <div class="c2-preview-foot">
                    <span class="c2-preview-price" id="previewPrice">— WLD</span>
                    <span class="c2-preview-buy">@SharedLocalizer["Offer.Buy"]</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    window.worldChainMarketplaceConfig = {
        chainId: Number('@worldChainId'),
        wldTokenAddress: '@worldChainWldToken',
        usdtTokenAddress: '@worldChainUsdtToken',
        marketplaceAddress: '@worldChainMarketplace',
        testMode: @(testMode ? "true" : "false")
    };
</script>
<script src="https://cdn.jsdelivr.net/npm/ethers@6.13.2/dist/ethers.umd.min.js"></script>
<script src="~/js/worldchain-marketplace.js" asp-append-version="true"></script>
<script type="module" src="~/js/minikitt.js" asp-append-version="true"></script>
<script>
    const USER_HASH = '@userHash';
    const OFFER_I18N = {
        share: "@SharedLocalizer["Offer.Share"]",
        sharing: "@SharedLocalizer["Offer.Sharing"]",
        connected: "@SharedLocalizer["Offer.WalletConnected"]",
        connectedWith: "@SharedLocalizer["Offer.ConnectedWith"]",
        split: "@SharedLocalizer["Offer.SplitInfo"]",
        cover: "@SharedLocalizer["Offer.Cover"]",
        errFill: "@SharedLocalizer["Offer.ErrFillRequired"]",
        errUpload: "@SharedLocalizer["Offer.ErrUpload"]",
        errImages: "@SharedLocalizer["Offer.ErrImagesOnly"]",
        errWallet: "@SharedLocalizer["Offer.ErrWallet"]",
        errGeneric: "@SharedLocalizer["Offer.ErrGeneric"]"
    };
    const TYPE_LABELS = { PhysicalObject: "@SharedLocalizer["Offer.TypeObject"]", MealPlan: "@SharedLocalizer["Offer.TypeMealPlan"]", SingleRecipe: "@SharedLocalizer["Offer.TypeRecipe"]", DigitalProduct: "@SharedLocalizer["Offer.TypeDigital"]", Service: "@SharedLocalizer["Offer.TypeService"]" };

    let photos = [];                 // hochgeladene Bunny-URLs ([0] = Cover)
    let selectedType = 'PhysicalObject';
    let selectedPlanId = null;
    let selectedRecipeId = null;
    let objShipping = true;
    let sellerWalletAddress = '@walletWLD';
    let sellerUsdtWalletAddress = '@walletUSDT';

    function getToken() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; }

    // ── Foto-Upload zu Bunny ──
    async function onPhotoSelected(e) {
        const file = e.target.files && e.target.files[0];
        e.target.value = '';
        if (!file) return;
        if (photos.length >= 4) return;
        if (!file.type.startsWith('image/')) { alert(OFFER_I18N.errImages); return; }

        renderMedia(true); // Lade-Status
        const form = new FormData();
        form.append('file', file);
        form.append('__RequestVerificationToken', getToken());
        try {
            const resp = await fetch('@Url.Action("UploadOfferImage", "Marketplace", new { area = "WorldMiniApp" })', { method: 'POST', body: form });
            const data = await resp.json();
            if (data.success && data.url) { photos.push(data.url); }
            else { alert(data.error || OFFER_I18N.errUpload); }
        } catch { alert(OFFER_I18N.errUpload); }
        renderMedia();
        updatePreview(); updateValidity();
    }

    function removePhoto(i) { photos.splice(i, 1); renderMedia(); updatePreview(); updateValidity(); }

    function renderMedia(uploading) {
        const drop = document.getElementById('dropZone');
        const grid = document.getElementById('mediaGrid');
        if (photos.length === 0 && !uploading) { drop.style.display = ''; grid.style.display = 'none'; grid.innerHTML = ''; return; }
        drop.style.display = 'none';
        grid.style.display = 'grid';
        let html = '';
        photos.forEach((url, i) => {
            html += `<div class="c2-thumb ${i === 0 ? 'cover' : ''}" style="background-image:url('${url}')">
                ${i === 0 ? '<span class="c2-cover-badge">' + OFFER_I18N.cover + '</span>' : ''}
                <button type="button" class="c2-thumb-x" onclick="removePhoto(${i})"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
            </div>`;
        });
        if (uploading) html += `<div class="c2-thumb c2-add c2-uploading"><span class="spinner-border spinner-border-sm"></span></div>`;
        else if (photos.length < 4) html += `<button type="button" class="c2-thumb c2-add" onclick="document.getElementById('photoInput').click()"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button>`;
        grid.innerHTML = html;
    }

    // ── Typ ──
    function selectType(type) {
        selectedType = type;
        document.querySelectorAll('.c2-type').forEach(b => b.classList.toggle('on', b.dataset.type === type));
        document.querySelectorAll('[data-detail]').forEach(d => d.style.display = (d.dataset.detail === type) ? '' : 'none');
        document.getElementById('previewType').textContent = TYPE_LABELS[type] || 'Angebot';
        updateValidity();
    }

    function selectPlan(el, id) {
        selectedPlanId = id;
        document.querySelectorAll('.c2-plan').forEach(p => p.classList.toggle('sel', p === el));
        document.querySelectorAll('.c2-plan').forEach(p => {
            const has = p.querySelector('.c2-plan-check');
            if (p === el && !has) { const s = document.createElement('span'); s.className = 'c2-plan-check'; s.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>'; p.appendChild(s); }
            else if (p !== el && has) { has.remove(); }
        });
        updateValidity();
    }

    function onRecipeSelected() {
        const sel = document.getElementById('recipeSelect');
        selectedRecipeId = sel && sel.value ? parseInt(sel.value, 10) : null;
        const t = document.getElementById('listingTitle');
        if (sel && sel.value && !t.value.trim()) { t.value = sel.options[sel.selectedIndex].text; updatePreview(); }
        updateValidity();
    }

    function toggleShipping() {
        objShipping = !objShipping;
        document.getElementById('objShippingBox').classList.toggle('on', objShipping);
        document.getElementById('objShippingBox').innerHTML = objShipping ? '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>' : '';
    }

    // ── Preis / Vorschau / Validität ──
    function onPriceInput() {
        const el = document.getElementById('listingPrice');
        el.value = el.value.replace(/[^0-9.]/g, '');
        const p = parseFloat(el.value) || 0;
        const split = document.getElementById('splitLine');
        if (p > 0) { split.style.display = ''; split.innerHTML = OFFER_I18N.split.replace('{0}', `<b>${(p * 0.8).toFixed(2)} WLD</b>`); }
        else { split.style.display = 'none'; }
        updatePreview(); updateValidity();
    }

    function updatePreview() {
        const title = document.getElementById('listingTitle').value.trim();
        document.getElementById('previewTitle').textContent = title || 'Dein Angebotstitel';
        const p = parseFloat(document.getElementById('listingPrice').value) || 0;
        document.getElementById('previewPrice').textContent = p > 0 ? `${p} WLD` : '— WLD';
        const media = document.getElementById('previewMedia');
        const glyph = document.getElementById('previewGlyph');
        if (photos.length) { media.style.backgroundImage = `url('${photos[0]}')`; if (glyph) glyph.style.display = 'none'; }
        else { media.style.backgroundImage = ''; if (glyph) glyph.style.display = ''; }
    }

    function typeRequirementMet() {
        if (selectedType === 'MealPlan') return !!selectedPlanId;
        if (selectedType === 'SingleRecipe') return !!selectedRecipeId;
        if (selectedType === 'DigitalProduct') return !!document.getElementById('digitalUrl')?.value.trim();
        return true;
    }

    function isValid() {
        const title = document.getElementById('listingTitle').value.trim();
        const price = parseFloat(document.getElementById('listingPrice').value) || 0;
        const walletOk = !!(sellerWalletAddress || sellerUsdtWalletAddress);
        return walletOk && title && price >= 1 && price <= 1000 && photos.length > 0 && typeRequirementMet();
    }

    function updateValidity() {
        const btn = document.getElementById('shareBtn');
        const ok = isValid();
        btn.disabled = !ok;
        btn.classList.toggle('off', !ok);
    }

    // ── Wallet ──
    function shortWallet(a) { return (!a || a.length < 10) ? (a || '') : `${a.slice(0,6)}…${a.slice(-4)}`; }

    function setWalletConnected(addr) {
        sellerWalletAddress = addr;
        const strip = document.getElementById('walletStrip');
        strip.classList.add('on');
        document.getElementById('walletSub').textContent = OFFER_I18N.connectedWith.replace('{0}', shortWallet(addr));
        document.getElementById('walletState').textContent = OFFER_I18N.connected;
        updateValidity();
    }

    async function connectSellerWallet() {
        if (sellerWalletAddress) return;
        try {
            let address = '';
            const ethereumProvider = window.worldChainMarketplace?.getEthereumProvider?.();
            if (ethereumProvider) { try { address = await window.worldChainMarketplace.connectWallet(); } catch {} }
            if (!address && window.connectWalletOnly) address = await window.connectWalletOnly();
            if (!address) { alert(OFFER_I18N.errWallet); return; }

            const form = new FormData();
            form.append('walletAddress', address); form.append('token', 'WLD'); form.append('__RequestVerificationToken', getToken());
            await fetch('@Url.Action("SaveWalletAddress", "Marketplace", new { area = "WorldMiniApp" })', { method: 'POST', body: form });
            setWalletConnected(address);
        } catch (e) { alert(e?.message || OFFER_I18N.errWallet); }
    }

    // ── Veröffentlichen ──
    async function createListing() {
        if (!isValid()) { alert(OFFER_I18N.errFill); return; }
        const title = document.getElementById('listingTitle').value.trim();
        const description = document.getElementById('listingDescription').value.trim();
        const price = parseFloat(document.getElementById('listingPrice').value) || 0;

        const form = new FormData();
        form.append('ListingType', selectedType);
        form.append('Title', title);
        form.append('Description', description);
        form.append('Price', price);
        form.append('SellerWalletAddress', sellerWalletAddress);
        form.append('SellerUsdtWalletAddress', sellerUsdtWalletAddress);
        form.append('CoverImageUrl', photos[0] || '');
        form.append('ImagesJson', JSON.stringify(photos));

        if (selectedType === 'MealPlan') form.append('MealPlanId', selectedPlanId);
        else if (selectedType === 'SingleRecipe') form.append('RecipeId', selectedRecipeId);
        else if (selectedType === 'DigitalProduct') form.append('DigitalFileUrl', document.getElementById('digitalUrl').value.trim());
        else if (selectedType === 'PhysicalObject') {
            const stock = document.getElementById('objStock').value.trim();
            if (stock !== '') form.append('StockQuantity', stock);
            form.append('RequiresShipping', objShipping ? 'true' : 'false');
        }
        form.append('__RequestVerificationToken', getToken());

        const btn = document.getElementById('shareBtn');
        btn.disabled = true; btn.textContent = OFFER_I18N.sharing;
        try {
            const resp = await fetch('@Url.Action("CreateListing", "Marketplace", new { area = "WorldMiniApp" })', { method: 'POST', body: form });
            const data = await resp.json();
            if (data.success) { window.location.href = '@Url.Action("MyListings", "Marketplace", new { area = "WorldMiniApp" })'; }
            else { alert(data.error || OFFER_I18N.errGeneric); btn.disabled = false; btn.textContent = OFFER_I18N.share; updateValidity(); }
        } catch { alert(OFFER_I18N.errGeneric); btn.disabled = false; btn.textContent = OFFER_I18N.share; updateValidity(); }
    }

    document.addEventListener('DOMContentLoaded', () => {
        selectType('PhysicalObject');
        if (sellerWalletAddress) setWalletConnected(sellerWalletAddress);
        updatePreview(); updateValidity();
    });
</script>
@Html.AntiForgeryToken()
}
