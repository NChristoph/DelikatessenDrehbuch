@model List<DelikatessenDrehbuch.Areas.WorldMiniApp.Models.WorldUserMealPlan>
@{
    ViewData["Title"] = "Plan verkaufen";
    Layout = "_MiniAppLayout";
    var userHash = ViewData["UserHash"]?.ToString() ?? "";
    var walletWLD = ViewData["WalletWLD"]?.ToString() ?? "";
    var walletUSDT = ViewData["WalletUSDT"]?.ToString() ?? "";

    var worldChainId = ViewData["WorldChainId"]?.ToString() ?? "480";
    var worldChainWldToken = ViewData["WorldChainWldToken"]?.ToString() ?? "";
    var worldChainUsdtToken = ViewData["WorldChainUsdtToken"]?.ToString() ?? "";
    var worldChainMarketplace = ViewData["WorldChainMarketplace"]?.ToString() ?? "";
    var testMode = (bool?)ViewData["WorldChainTestMode"] ?? false;
    var blockedMealPlanCount = (int?)ViewData["BlockedMealPlanCount"] ?? 0;
    var myRecipes = ViewData["MyRecipes"] as List<DelikatessenDrehbuch.Areas.WorldMiniApp.Controllers.MarketplaceController.RecipeOption>
        ?? new List<DelikatessenDrehbuch.Areas.WorldMiniApp.Controllers.MarketplaceController.RecipeOption>();
}

<style>
    /* Avocado-/Marktplatz-Design (abgestimmt auf Marketplace/Index) */
    body { background: #f5efe1 !important; }

    .sell-back-link {
        color: #14391f;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .sell-back-link:hover { color: #14391f; opacity: .8; }

    .sell-card {
        background: #fff;
        border: none;
        border-radius: 18px;
        box-shadow: 0 2px 14px rgba(20,57,31,.06);
    }
    .sell-title {
        font-family: 'Fraunces', 'Playfair Display', Georgia, serif;
        font-weight: 600;
        letter-spacing: -.02em;
        color: #14391f;
    }
    .sell-section-label {
        font-size: 13px;
        font-weight: 700;
        color: #14391f;
    }

    .plan-option {
        border: 2px solid rgba(20,57,31,.1);
        border-radius: 12px;
        padding: .75rem;
        cursor: pointer;
        transition: border-color .15s, background .15s;
        background: #fff;
    }
    .plan-option:hover { background: #faf6ec; }
    .plan-option.selected {
        border-color: #14391f;
        background: rgba(20,57,31,.05);
    }

    .sell-btn {
        background: #14391f;
        border: none;
        color: #fff;
        font-weight: 600;
        border-radius: 999px;
        padding: .7rem 1.5rem;
        transition: filter .15s;
    }
    .sell-btn:hover { filter: brightness(1.12); color: #fff; }
    .sell-btn:disabled { opacity: .45; }

    .price-input {
        font-size: 1.5rem;
        font-weight: 700;
        text-align: center;
        border: 2px solid rgba(20,57,31,.12);
        border-radius: 12px;
        max-width: 140px;
        color: #14391f;
    }
    .price-input:focus { border-color: #14391f; box-shadow: 0 0 0 3px rgba(20,57,31,.12); outline: none; }

    .form-control:focus, .form-select:focus {
        border-color: #14391f;
        box-shadow: 0 0 0 3px rgba(20,57,31,.1);
    }
    .form-check-input:checked { background-color: #14391f; border-color: #14391f; }

    /* Wallet-Leiste — dunkelgrün wie auf der Übersicht */
    .wallet-bar-sell {
        background: linear-gradient(135deg, #1a3a23, #0e2415);
        color: #fff;
        border-radius: 16px;
        padding: .85rem 1.25rem;
    }
    .wallet-bar-sell .btn-outline-light { border-radius: 999px; }
    .wallet-connected { color: #5fd0a0; }

    .split-info {
        background: rgba(245,185,66,.12);
        border: 1px solid rgba(245,185,66,.35);
        border-radius: 12px;
        padding: .75rem 1rem;
        font-size: .85rem;
        color: #14391f;
    }
    .split-info strong { color: #14391f; }

    .type-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: .5rem;
    }
    .type-option {
        border: 2px solid rgba(20,57,31,.1);
        border-radius: 14px;
        padding: .8rem .5rem;
        text-align: center;
        cursor: pointer;
        background: #fff;
        transition: border-color .15s, background .15s, transform .1s;
    }
    .type-option:hover { background: #faf6ec; }
    .type-option:active { transform: scale(.97); }
    .type-option.selected { border-color: #14391f; background: rgba(20,57,31,.05); }
    .type-option i { display: block; font-size: 1.4rem; color: #14391f; margin-bottom: .25rem; }
    .type-option span { font-size: .78rem; font-weight: 600; color: #14391f; }
</style>

<div class="container py-4" style="max-width:720px;">
    <a href="@Url.Action("Index", "Marketplace", new { area = "WorldMiniApp" })" class="sell-back-link d-inline-block mb-3">
        <i class="bi bi-arrow-left"></i> Zurück zum Marktplatz
    </a>

    <div class="sell-card p-4 mb-3">
        <h4 class="sell-title mb-1">Angebot erstellen</h4>
        <p class="text-muted small mb-0">Wähle einen Angebotstyp, beschreibe ihn und leg einen Preis in WLD fest. Optional kannst du zusätzlich eine USDT/USDC-Auszahlungsadresse speichern.</p>
    </div>

    <!-- Wallet-Verbindung (Pflicht zum Verkaufen) -->
    <div class="wallet-bar-sell mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="small opacity-75">Deine Auszahlungs-Wallet (WLD)</div>
                <div class="small mt-1" id="sellerWalletStatus">
                    @if (!string.IsNullOrWhiteSpace(walletWLD))
                    {
                        <span class="wallet-connected"><i class="bi bi-check-circle me-1"></i>@walletWLD.Substring(0, Math.Min(6, walletWLD.Length))...@walletWLD.Substring(Math.Max(0, walletWLD.Length - 4))</span>
                    }
                    else
                    {
                        <span class="text-warning">Nicht verbunden - Wallet wird für Auszahlung benötigt</span>
                    }
                </div>
                <div class="small mt-1" id="sellerWalletBalance" style="display:none;">
                    <span class="badge bg-success">💰 <span id="wldBalance">--</span> WLD</span>
                </div>
            </div>
            <button type="button" class="btn btn-outline-light btn-sm rounded-pill" id="connectSellerWalletBtn" onclick="connectSellerWallet()">
                <i class="bi bi-wallet2 me-1"></i>@(string.IsNullOrWhiteSpace(walletWLD) ? "Verbinden" : "Verbunden")
            </button>
        </div>
    </div>


    <div class="wallet-bar-sell mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="small opacity-75">Deine Auszahlungs-Wallet (USDT/USDC)</div>
                <div class="small mt-1" id="sellerUsdtWalletStatus">
                    @if (!string.IsNullOrWhiteSpace(walletUSDT))
                    {
                        <span class="wallet-connected"><i class="bi bi-check-circle me-1"></i>@walletUSDT.Substring(0, Math.Min(6, walletUSDT.Length))...@walletUSDT.Substring(Math.Max(0, walletUSDT.Length - 4))</span>
                    }
                    else
                    {
                        <span class="text-warning">Nicht verbunden - optional für USDT/USDC-Auszahlungen</span>
                    }
                </div>
            </div>
            <button type="button" class="btn btn-outline-light btn-sm rounded-pill" id="connectSellerUsdtWalletBtn" onclick="connectSellerUsdtWallet()">
                <i class="bi bi-wallet2 me-1"></i>@(string.IsNullOrWhiteSpace(walletUSDT) ? "Verbinden" : "Verbunden")
            </button>
        </div>
    </div>

    <!-- Revenue Split Info -->
    <div class="split-info mb-3">
        <i class="bi bi-info-circle me-1"></i>
        <strong>80% für dich</strong> — Bei jedem Verkauf bekommst du automatisch 80% des Preises direkt auf deine Wallet.
        20% gehen als Plattform-Gebühr an uns.
    </div>

    <div class="sell-card p-4">
        <!-- 1. Angebotstyp -->
        <label class="sell-section-label mb-2 d-block">1. Was möchtest du anbieten?</label>
        <div class="type-grid mb-4" id="typeGrid">
            <div class="type-option selected" data-type="MealPlan" onclick="selectType(this,'MealPlan')"><i class="bi bi-calendar-week"></i><span>Essensplan</span></div>
            <div class="type-option" data-type="SingleRecipe" onclick="selectType(this,'SingleRecipe')"><i class="bi bi-card-text"></i><span>Einzelrezept</span></div>
            <div class="type-option" data-type="PhysicalObject" onclick="selectType(this,'PhysicalObject')"><i class="bi bi-box-seam"></i><span>Objekt</span></div>
            <div class="type-option" data-type="DigitalProduct" onclick="selectType(this,'DigitalProduct')"><i class="bi bi-cloud-download"></i><span>Digital</span></div>
            <div class="type-option" data-type="Service" onclick="selectType(this,'Service')"><i class="bi bi-person-workspace"></i><span>Dienstleistung</span></div>
        </div>

        <!-- Essensplan -->
        <div class="type-section" data-section="MealPlan">
            <label class="sell-section-label mb-2 d-block">Plan auswählen</label>
            @if (blockedMealPlanCount > 0)
            {
                <div class="alert alert-warning border-0 rounded-4 mb-3 small" role="alert">
                    Nur Essenspläne mit ausschließlich eigenen Rezepten können verkauft werden. @blockedMealPlanCount Plan/Pläne sind ausgeblendet.
                </div>
            }
            @if (!Model.Any())
            {
                <div class="text-center py-3">
                    <i class="bi bi-journal-x fs-3 text-muted"></i>
                    <p class="text-muted small mt-2 mb-2">Du hast aktuell keine verkaufbaren Essenspläne.</p>
                    <a href="@Url.Action("Index", "Home", new { area = "WorldMiniApp" })" class="btn btn-outline-dark btn-sm rounded-pill">Plan erstellen</a>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2 mb-2" id="planList">
                    @foreach (var plan in Model)
                    {
                        <div class="plan-option" data-plan-id="@plan.Id" onclick="selectPlan(this, @plan.Id, '@(plan.Title?.Replace("'", "\\'") ?? "Essensplan")')">
                            <div class="fw-bold">@(plan.Title ?? "Essensplan")</div>
                            <div class="text-muted small">Erstellt: @plan.CreationTime.ToString("dd.MM.yyyy")</div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Einzelrezept -->
        <div class="type-section d-none" data-section="SingleRecipe">
            <label class="sell-section-label mb-2 d-block">Rezept auswählen</label>
            @if (myRecipes.Any())
            {
                <select id="recipeSelect" class="form-select rounded-3 mb-2" onchange="onRecipeSelected()">
                    <option value="">– Rezept wählen –</option>
                    @foreach (var r in myRecipes)
                    {
                        <option value="@r.Id">@r.Title</option>
                    }
                </select>
            }
            else
            {
                <div class="text-muted small">Du hast noch keine eigenen Rezepte zum Verkaufen.</div>
            }
        </div>

        <!-- Objekt -->
        <div class="type-section d-none" data-section="PhysicalObject">
            <label class="sell-section-label mb-2 d-block">Produktdetails</label>
            <input type="url" id="objImageUrl" class="form-control rounded-3 mb-2" placeholder="Bild-URL (https://...)" maxlength="1000" oninput="updateSellButtonState()" />
            <input type="number" id="objStock" class="form-control rounded-3 mb-2" min="0" placeholder="Bestand (leer = unbegrenzt)" />
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="objShipping" checked />
                <label class="form-check-label small" for="objShipping">Versand nötig (Lieferadresse vom Käufer abfragen)</label>
            </div>
        </div>

        <!-- Digital -->
        <div class="type-section d-none" data-section="DigitalProduct">
            <label class="sell-section-label mb-2 d-block">Digitales Produkt</label>
            <input type="url" id="digitalUrl" class="form-control rounded-3 mb-2" placeholder="Download-/Datei-URL (https://...)" maxlength="1000" oninput="updateSellButtonState()" />
            <input type="url" id="digitalCover" class="form-control rounded-3 mb-2" placeholder="Titelbild-URL (optional)" maxlength="1000" />
            <div class="text-muted small">Der Link wird erst nach dem Kauf freigeschaltet.</div>
        </div>

        <!-- Dienstleistung -->
        <div class="type-section d-none" data-section="Service">
            <label class="sell-section-label mb-2 d-block">Dienstleistung</label>
            <input type="url" id="serviceCover" class="form-control rounded-3 mb-2" placeholder="Titelbild-URL (optional)" maxlength="1000" />
            <div class="text-muted small">Beschreibe deine Dienstleistung unten. Nach dem Kauf wirst du benachrichtigt, um Kontakt aufzunehmen.</div>
        </div>

        <!-- Titel & Beschreibung -->
        <label class="sell-section-label mb-2 mt-4 d-block">2. Angebot beschreiben</label>
        <div class="mb-2">
            <input type="text" id="listingTitle" class="form-control rounded-3" placeholder="Titel für dein Angebot" maxlength="100" />
        </div>
        <div class="mb-4">
            <textarea id="listingDescription" class="form-control rounded-3" rows="2" placeholder="Kurze Beschreibung (optional)" maxlength="300"></textarea>
        </div>

        <!-- Preis -->
        <label class="sell-section-label mb-2 d-block">3. Preis festlegen</label>
        <div class="d-flex align-items-center gap-2 mb-2">
            <input type="number" id="listingPrice" class="form-control price-input" min="1" max="1000" value="10" step="1" oninput="updateSplitPreview()" />
            <span class="fw-bold text-muted">WLD</span>
        </div>
        <div class="small text-muted mb-4" id="splitPreview">
            Du bekommst: <strong>8.00 WLD</strong> (80%) — Plattform: 2.00 WLD (20%)
        </div>

        <!-- Submit -->
        <button class="sell-btn w-100" id="btnSell" onclick="createListing()" disabled>
            <i class="bi bi-tag me-2"></i>Jetzt verkaufen
        </button>
    </div>
</div>

@section Scripts {
<script>
    window.worldChainMarketplaceConfig = {
        chainId: Number('@worldChainId'),
        wldTokenAddress: '@worldChainWldToken',
        usdtTokenAddress: '@worldChainUsdtToken',
        marketplaceAddress: '@worldChainMarketplace',
        testMode: @(testMode ? "true" : "false")
    };
</script>
<script src="https://cdn.jsdelivr.net/npm/ethers@6.13.2/dist/ethers.umd.min.js"></script>
<script src="~/js/worldchain-marketplace.js" asp-append-version="true"></script>
<script type="module" src="~/js/minikitt.js" asp-append-version="true"></script>
<script>
    let selectedPlanId = null;
    let selectedRecipeId = null;
    let selectedType = 'MealPlan';
    let sellerWalletAddress = '@walletWLD';
    let sellerUsdtWalletAddress = '@walletUSDT';

    const USER_HASH = '@userHash';

    function selectType(el, type) {
        selectedType = type;
        document.querySelectorAll('.type-option').forEach(o => o.classList.toggle('selected', o === el));
        document.querySelectorAll('.type-section').forEach(s => {
            s.classList.toggle('d-none', s.dataset.section !== type);
        });
        updateSellButtonState();
    }

    function onRecipeSelected() {
        const sel = document.getElementById('recipeSelect');
        selectedRecipeId = sel && sel.value ? parseInt(sel.value, 10) : null;
        const titleInput = document.getElementById('listingTitle');
        if (sel && sel.value && titleInput && !titleInput.value.trim()) {
            titleInput.value = sel.options[sel.selectedIndex].text;
        }
        updateSellButtonState();
    }

    function typeRequirementMet() {
        switch (selectedType) {
            case 'MealPlan': return !!selectedPlanId;
            case 'SingleRecipe': return !!selectedRecipeId;
            case 'DigitalProduct': return !!(document.getElementById('digitalUrl')?.value.trim());
            case 'PhysicalObject': return !!(document.getElementById('objImageUrl')?.value.trim());
            case 'Service': return true;
            default: return false;
        }
    }

    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    function shortWallet(address) {
        if (!address || address.length < 10) return address || '';
        return `${address.slice(0, 6)}...${address.slice(-4)}`;
    }

    function updateSplitPreview() {
        const price = parseFloat(document.getElementById('listingPrice').value) || 0;
        const creatorAmount = (price * 0.8).toFixed(2);
        const platformAmount = (price * 0.2).toFixed(2);
        const el = document.getElementById('splitPreview');
        if (el) {
            el.innerHTML = `Du bekommst: <strong>${creatorAmount} WLD</strong> (80%) — Plattform: ${platformAmount} WLD (20%)`;
        }
    }

    function selectPlan(el, planId, planTitle) {
        document.querySelectorAll('.plan-option').forEach(p => p.classList.remove('selected'));
        el.classList.add('selected');
        selectedPlanId = planId;

        const titleInput = document.getElementById('listingTitle');
        if (!titleInput.value.trim()) {
            titleInput.value = planTitle;
        }

        updateSellButtonState();
    }

    function updateSellButtonState() {
        const btn = document.getElementById('btnSell');
        btn.disabled = !typeRequirementMet() || (!sellerWalletAddress && !sellerUsdtWalletAddress);
    }

    async function connectSellerWallet() {
        const btn = document.getElementById('connectSellerWalletBtn');
        try {
            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-arrow-repeat me-1 spin"></i>Verbinde...'; }

            let address = '';

            // 1. Versuch: EIP-1193 Provider (Desktop-Browser)
            if (window.worldChainMarketplace?.connectWallet) {
                const ethereumProvider = window.worldChainMarketplace.getEthereumProvider?.();
                if (ethereumProvider) {
                    try {
                        address = await window.worldChainMarketplace.connectWallet();
                    } catch (e) {
                        console.warn('EIP-1193 connectWallet fehlgeschlagen:', e.message);
                    }
                }
            }

            // 2. Fallback: MiniKit walletAuth (World App)
            if (!address && window.connectWalletOnly) {
                address = await window.connectWalletOnly();
            }

            if (!address) {
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-wallet2 me-1"></i>Verbinden'; }
                alert('Wallet-Verbindung fehlgeschlagen.');
                return;
            }

            sellerWalletAddress = address;

            // Wallet in Session speichern
            const form = new FormData();
            form.append('walletAddress', address);
            form.append('token', 'WLD');
            form.append('__RequestVerificationToken', getAntiForgeryToken());
            await fetch('@Url.Action("SaveWalletAddress", "Marketplace", new { area = "WorldMiniApp" })', {
                method: 'POST',
                body: form
            });

            // UI aktualisieren
            const statusEl = document.getElementById('sellerWalletStatus');
            if (statusEl) {
                statusEl.innerHTML = `<span class="wallet-connected"><i class="bi bi-check-circle me-1"></i>${shortWallet(address)}</span>`;
            }
            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Verbunden'; btn.classList.replace('btn-outline-light', 'btn-success'); }

            // Balance abrufen und anzeigen
            if (window.worldChainMarketplace?.getWalletBalances) {
                try {
                    const balances = await window.worldChainMarketplace.getWalletBalances(address);
                    const balanceDiv = document.getElementById('sellerWalletBalance');
                    const wldBalanceSpan = document.getElementById('wldBalance');

                    if (balances.wld !== null && wldBalanceSpan && balanceDiv) {
                        wldBalanceSpan.textContent = balances.wld;
                        balanceDiv.style.display = 'block';
                    }
                } catch (e) {
                    console.error('Balance-Abfrage fehlgeschlagen:', e);
                }
            }

            updateSellButtonState();
        } catch (error) {
            if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-wallet2 me-1"></i>Verbinden'; }
            alert(error?.message || 'Wallet-Verbindung fehlgeschlagen.');
        }
    }


    async function connectSellerUsdtWallet() {
        const btn = document.getElementById('connectSellerUsdtWalletBtn');
        try {
            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-arrow-repeat me-1 spin"></i>Verbinde...'; }

            let address = '';

            if (window.worldChainMarketplace?.connectWallet) {
                const ethereumProvider = window.worldChainMarketplace.getEthereumProvider?.();
                if (ethereumProvider) {
                    try {
                        address = await window.worldChainMarketplace.connectWallet();
                    } catch (e) {
                        console.warn('EIP-1193 connectWallet fehlgeschlagen:', e.message);
                    }
                }
            }

            if (!address && window.connectWalletOnly) {
                address = await window.connectWalletOnly();
            }

            if (!address) {
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-wallet2 me-1"></i>Verbinden'; }
                alert('USDT/USDC-Wallet-Verbindung fehlgeschlagen.');
                return;
            }

            sellerUsdtWalletAddress = address;

            const form = new FormData();
            form.append('walletAddress', address);
            form.append('token', 'USDT');
            form.append('__RequestVerificationToken', getAntiForgeryToken());
            await fetch('@Url.Action("SaveWalletAddress", "Marketplace", new { area = "WorldMiniApp" })', {
                method: 'POST',
                body: form
            });

            const statusEl = document.getElementById('sellerUsdtWalletStatus');
            if (statusEl) {
                statusEl.innerHTML = `<span class="wallet-connected"><i class="bi bi-check-circle me-1"></i>${shortWallet(address)}</span>`;
            }
            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Verbunden'; btn.classList.replace('btn-outline-light', 'btn-success'); }

            updateSellButtonState();
        } catch (error) {
            if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-wallet2 me-1"></i>Verbinden'; }
            alert(error?.message || 'USDT/USDC-Wallet-Verbindung fehlgeschlagen.');
        }
    }

    async function createListing() {
        if (!typeRequirementMet()) {
            alert('Bitte vervollständige die Angaben für den gewählten Angebotstyp.');
            return;
        }

        if (!sellerWalletAddress && !sellerUsdtWalletAddress) {
            alert('Bitte verbinde zuerst mindestens eine Wallet (WLD oder USDT/USDC), damit du Zahlungen empfangen kannst.');
            return;
        }

        const title = document.getElementById('listingTitle').value.trim();
        const description = document.getElementById('listingDescription').value.trim();
        const price = parseFloat(document.getElementById('listingPrice').value) || 0;

        if (!title) { alert('Bitte gib einen Titel ein.'); return; }
        if (price < 1 || price > 1000) { alert('Preis muss zwischen 1 und 1000 WLD liegen.'); return; }

        const form = new FormData();
        form.append('ListingType', selectedType);
        form.append('Title', title);
        form.append('Description', description);
        form.append('Price', price);
        form.append('SellerWalletAddress', sellerWalletAddress);
        form.append('SellerUsdtWalletAddress', sellerUsdtWalletAddress);

        if (selectedType === 'MealPlan') {
            form.append('MealPlanId', selectedPlanId);
        } else if (selectedType === 'SingleRecipe') {
            form.append('RecipeId', selectedRecipeId);
        } else if (selectedType === 'DigitalProduct') {
            form.append('DigitalFileUrl', document.getElementById('digitalUrl').value.trim());
            form.append('CoverImageUrl', document.getElementById('digitalCover').value.trim());
        } else if (selectedType === 'PhysicalObject') {
            form.append('CoverImageUrl', document.getElementById('objImageUrl').value.trim());
            const stock = document.getElementById('objStock').value.trim();
            if (stock !== '') form.append('StockQuantity', stock);
            form.append('RequiresShipping', document.getElementById('objShipping').checked ? 'true' : 'false');
        } else if (selectedType === 'Service') {
            form.append('CoverImageUrl', document.getElementById('serviceCover').value.trim());
        }

        form.append('__RequestVerificationToken', getAntiForgeryToken());

        const btn = document.getElementById('btnSell');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Wird erstellt...';

        try {
            const resp = await fetch('@Url.Action("CreateListing", "Marketplace", new { area = "WorldMiniApp" })', {
                method: 'POST',
                body: form
            });
            const data = await resp.json();
            if (data.success) {
                alert('Angebot erstellt! Bei jedem Kauf bekommst du 80% direkt auf deine Wallet.');
                window.location.href = '@Url.Action("MyListings", "Marketplace", new { area = "WorldMiniApp" })';
            } else {
                alert(data.error || 'Fehler beim Erstellen.');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-tag me-2"></i>Jetzt verkaufen';
            }
        } catch {
            alert('Netzwerkfehler.');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-tag me-2"></i>Jetzt verkaufen';
        }
    }

    // Init
    document.addEventListener('DOMContentLoaded', async () => {
        updateSplitPreview();

        // Falls Wallet schon verbunden, Button-State setzen UND Balance abrufen
        if (sellerWalletAddress) {
            const btn = document.getElementById('connectSellerWalletBtn');
            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Verbunden'; btn.classList.replace('btn-outline-light', 'btn-success'); }

            // Balance abrufen
            if (window.worldChainMarketplace?.getWalletBalances) {
                try {
                    const balances = await window.worldChainMarketplace.getWalletBalances(sellerWalletAddress);
                    const balanceDiv = document.getElementById('sellerWalletBalance');
                    const wldBalanceSpan = document.getElementById('wldBalance');

                    if (balances.wld !== null && wldBalanceSpan && balanceDiv) {
                        wldBalanceSpan.textContent = balances.wld;
                        balanceDiv.style.display = 'block';
                    }
                } catch (e) {
                    console.error('Balance-Abfrage fehlgeschlagen:', e);
                }
            }
        }

        if (sellerUsdtWalletAddress) {
            const btnUsdt = document.getElementById('connectSellerUsdtWalletBtn');
            if (btnUsdt) { btnUsdt.disabled = true; btnUsdt.innerHTML = '<i class="bi bi-check-lg me-1"></i>Verbunden'; btnUsdt.classList.replace('btn-outline-light', 'btn-success'); }
        }

        updateSellButtonState();
    });
</script>
@Html.AntiForgeryToken()
}

