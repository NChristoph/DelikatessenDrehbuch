@using DelikatessenDrehbuch.Areas.WorldMiniApp.Models
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<DelikatessenDrehbuch.SharedResources> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Payout.Title"].Value;
    Layout = "_MiniAppLayout";
    var balance = (decimal?)ViewData["Balance"] ?? 0m;
    var payouts = ViewData["Payouts"] as List<MarketplacePayoutRequest> ?? new List<MarketplacePayoutRequest>();
    var walletWLD = ViewData["WalletWLD"]?.ToString() ?? "";
    var walletUSDT = ViewData["WalletUSDT"]?.ToString() ?? "";
}

@Html.AntiForgeryToken()
<div class="container py-3" style="max-width:560px">
    <a href="@Url.Action("MyListings", "Marketplace", new { area = "WorldMiniApp" })" class="text-decoration-none text-muted small d-inline-block mb-3">
        <i class="bi bi-arrow-left"></i> @SharedLocalizer["Payout.BackToListings"]
    </a>
    <h4 class="mb-3">@SharedLocalizer["Payout.Heading"]</h4>

    <div class="card p-3 mb-3 shadow-sm">
        <div class="text-muted small">@SharedLocalizer["Payout.AvailableBalance"]</div>
        <div style="font-size:1.8rem;font-weight:700">@balance.ToString("0.######") <span class="text-muted" style="font-size:1rem">WLD</span></div>
    </div>

    <form id="payoutForm" class="card p-3 mb-3 shadow-sm">
        <label class="small mb-1">@SharedLocalizer["Payout.Amount"]</label>
        <input id="payoutAmount" type="number" step="0.000001" min="0" max="@balance.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control mb-2" required />
        <label class="small mb-1">Token</label>
        <select id="payoutToken" class="form-control mb-2">
            <option value="WLD">WLD</option>
            <option value="USDCE">USDC.e</option>
        </select>
        <label class="small mb-1">@SharedLocalizer["Payout.PayoutWallet"]</label>
        <input id="payoutWallet" type="text" class="form-control mb-2" value="@walletWLD" placeholder="0x…" required />
        <button type="submit" class="btn btn-primary w-100">@SharedLocalizer["Payout.RequestButton"]</button>
        <div id="payoutMsg" class="small mt-2"></div>
        <div class="text-muted small mt-2">@SharedLocalizer["Payout.Note"]</div>
    </form>

    <h6>@SharedLocalizer["Payout.History"]</h6>
    <table class="table table-sm">
        <thead><tr><th>@SharedLocalizer["Payout.Date"]</th><th>@SharedLocalizer["Payout.Amount"]</th><th>Token</th><th>Status</th></tr></thead>
        <tbody>
            @if (payouts.Count == 0)
            {
                <tr><td colspan="4" class="text-muted">@SharedLocalizer["Payout.NoPayouts"]</td></tr>
            }
            @foreach (var p in payouts)
            {
                <tr>
                    <td>@p.RequestedAt.ToString("dd.MM.yy")</td>
                    <td>@p.Amount.ToString("0.######")</td>
                    <td>@p.Token</td>
                    <td>
                        @p.Status
                        @if (!string.IsNullOrEmpty(p.TxHash)) { <span title="@p.TxHash">✓</span> }
                        @if (p.Status == "rejected" && !string.IsNullOrEmpty(p.Note)) { <span class="text-muted small">(@p.Note)</span> }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    (function () {
        var walletWld = '@walletWLD';
        var walletUsdt = '@walletUSDT';
        var form = document.getElementById('payoutForm');
        document.getElementById('payoutToken').addEventListener('change', function (e) {
            document.getElementById('payoutWallet').value = e.target.value === 'WLD' ? walletWld : walletUsdt;
        });
        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            var msg = document.getElementById('payoutMsg');
            var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
            var body = new URLSearchParams();
            body.append('amount', document.getElementById('payoutAmount').value);
            body.append('token', document.getElementById('payoutToken').value);
            body.append('walletAddress', document.getElementById('payoutWallet').value);
            body.append('__RequestVerificationToken', tokenEl ? tokenEl.value : '');
            try {
                var res = await fetch('/WorldMiniApp/Marketplace/RequestPayout', { method: 'POST', body: body });
                var data = await res.json();
                if (data.success) {
                    msg.style.color = 'green';
                    msg.textContent = '@SharedLocalizer["Payout.RequestSubmitted"]';
                    setTimeout(function () { location.reload(); }, 1200);
                } else {
                    msg.style.color = 'red';
                    msg.textContent = data.error || '@SharedLocalizer["Dashboard.Error"]';
                }
            } catch (_) {
                msg.style.color = 'red';
                msg.textContent = '@SharedLocalizer["Error.NetworkError"]';
            }
        });
    })();
</script>
