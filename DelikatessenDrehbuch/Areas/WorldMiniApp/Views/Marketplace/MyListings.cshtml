@model List<DelikatessenDrehbuch.Areas.WorldMiniApp.Models.MealPlanListing>
@{
    ViewData["Title"] = "Meine Angebote";
    Layout = "_MiniAppLayout";
    var userHash = ViewData["UserHash"]?.ToString() ?? "";
}

<style>
    .listing-card {
        background: #fff;
        border: none;
        border-radius: 1rem;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        padding: 1rem;
    }
    .coin-badge {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff;
        font-weight: 700;
        border-radius: .6rem;
        padding: .2rem .5rem;
        font-size: .8rem;
    }
    .status-active { color: #15803d; }
    .status-inactive { color: #9ca3af; }
    .stat-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: .75rem;
        background: rgba(0,0,0,.04);
        border-radius: 1rem;
        padding: 2px 8px;
        color: #6b7280;
    }
</style>

<div class="container py-4" style="max-width:720px;">
    <a href="@Url.Action("Index", "Marketplace", new { area = "WorldMiniApp" })" class="text-decoration-none text-muted small d-inline-block mb-3">
        <i class="bi bi-arrow-left"></i> Zurück zum Marketplace
    </a>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-0">Meine Angebote</h4>
        </div>
        <a href="@Url.Action("Sell", "Marketplace", new { area = "WorldMiniApp" })"
           class="btn btn-dark btn-sm rounded-pill">
            <i class="bi bi-plus-lg me-1"></i>Neues Angebot
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-tag fs-1 text-muted"></i>
            <p class="text-muted mt-2">Du hast noch keine Angebote erstellt.</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var listing in Model)
            {
                <div class="listing-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-bold">@listing.Title</div>
                            @if (!string.IsNullOrWhiteSpace(listing.Description))
                            {
                                <p class="small text-muted mb-1">@listing.Description</p>
                            }
                            <div class="mt-1">
                                <span class="stat-pill"><i class="bi bi-calendar3"></i> @listing.DayCount Tage</span>
                                <span class="stat-pill"><i class="bi bi-journal-text"></i> @listing.RecipeCount Rezepte</span>
                                <span class="stat-pill"><i class="bi bi-bag-check"></i> @listing.SoldCount verkauft</span>
                            </div>
                            <div class="small text-muted mt-2">
                                <div><strong>WLD:</strong> @(string.IsNullOrWhiteSpace(listing.SellerWalletAddress) ? "-" : listing.SellerWalletAddress)</div>
                                <div><strong>USDT/USDC:</strong> @(string.IsNullOrWhiteSpace(listing.SellerUsdtWalletAddress) ? "-" : listing.SellerUsdtWalletAddress)</div>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="coin-badge mb-1">@listing.Price.ToString("0.##") WLD</div>
                            @if (listing.IsActive)
                            {
                                <div class="small status-active fw-semibold"><i class="bi bi-check-circle"></i> Aktiv</div>
                                <button class="btn btn-outline-danger btn-sm rounded-pill mt-1"
                                        onclick="deactivate(@listing.Id)">
                                    <i class="bi bi-x-circle me-1"></i>Deaktivieren
                                </button>
                            }
                            else
                            {
                                <div class="small status-inactive"><i class="bi bi-pause-circle"></i> Inaktiv</div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
    async function deactivate(listingId) {
        if (!confirm('Angebot wirklich deaktivieren?')) return;

        const form = new FormData();
        form.append('listingId', listingId);
        form.append('__RequestVerificationToken',
            document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');

        try {
            const resp = await fetch('@Url.Action("DeactivateListing", "Marketplace", new { area = "WorldMiniApp" })', {
                method: 'POST',
                body: form
            });
            const data = await resp.json();
            if (data.success) {
                location.reload();
            } else {
                alert('Fehler beim Deaktivieren.');
            }
        } catch {
            alert('Netzwerkfehler.');
        }
    }
</script>
@Html.AntiForgeryToken()
}
