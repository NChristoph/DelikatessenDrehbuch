@model List<DelikatessenDrehbuch.Areas.WorldMiniApp.Models.MealPlanListing>
@using DelikatessenDrehbuch.Areas.WorldMiniApp.Models
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<DelikatessenDrehbuch.SharedResources> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["MyListings.Title"].Value;
    Layout = "_MiniAppLayout";
    var userHash = ViewData["UserHash"]?.ToString() ?? "";
    var cards = ViewData["MyListingCards"] as List<PlanCardViewModel> ?? new List<PlanCardViewModel>();
    var listingMap = Model.ToDictionary(l => l.Id);
}

@section Styles {
    <link rel="stylesheet" href="~/css/creator-shop-cards.css" asp-append-version="true" />
}

<div class="container py-4" style="max-width:720px;">
    <a href="@Url.Action("Index", "Marketplace", new { area = "WorldMiniApp" })" class="ml-back-link d-inline-block mb-3">
        <i class="bi bi-arrow-left"></i> @SharedLocalizer["MyListings.BackToMarketplace"]
    </a>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="ml-page-title mb-0">@SharedLocalizer["MyListings.Title"]</h4>
            <small class="ml-page-subtitle">@Model.Count @(Model.Count == 1 ? SharedLocalizer["MyListings.ListingSg"].Value : SharedLocalizer["MyListings.ListingPl"].Value)</small>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Payout", "Marketplace", new { area = "WorldMiniApp" })"
               class="ml-pill ml-pill-outline">
                <i class="bi bi-cash-coin me-1"></i>@SharedLocalizer["MyListings.Balance"]
            </a>
            <a href="@Url.Action("Sell", "Marketplace", new { area = "WorldMiniApp" })"
               class="ml-pill ml-pill-solid">
                <span class="ml-pill-plus">+</span> @SharedLocalizer["MyListings.NewListing"]
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="ml-empty text-center py-5">
            <div class="ml-empty-icon mb-3">
                <svg width="58" height="58" viewBox="0 0 24 24" fill="none" stroke="#6b7868" stroke-width="1.4" opacity=".55">
                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                    <line x1="7" y1="7" x2="7.01" y2="7"/>
                </svg>
            </div>
            <p class="ml-empty-title mb-1">@SharedLocalizer["MyListings.NoListings"]</p>
            <p class="text-muted small mb-3">@SharedLocalizer["MyListings.EmptyHint"]</p>
            <a href="@Url.Action("Sell", "Marketplace", new { area = "WorldMiniApp" })" class="ml-pill ml-pill-solid">
                <span class="ml-pill-plus">+</span> @SharedLocalizer["Marketplace.CreateListing"]
            </a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var card in cards)
            {
                var listing = listingMap.ContainsKey(card.ListingId) ? listingMap[card.ListingId] : null;
                var isActive = listing?.IsActive ?? false;
                var carouselId = $"ml-carousel-{card.ListingId}";
                var heroSlides = (card.HeroSlides ?? new List<PlanCardHeroSlideViewModel>()).Where(x => !string.IsNullOrWhiteSpace(x.ImageUrl)).ToList();
                var hasMacroData = card.CaloriesKcal.HasValue || card.ProteinGrams.HasValue || card.FatGrams.HasValue || card.CarbsGrams.HasValue;
                var totalSlides = heroSlides.Count + (hasMacroData ? 1 : 0);

                <article class="cs-card @(isActive ? "" : "ml-card-inactive")" data-listing-id="@card.ListingId">
                    <div class="cs-hero">
                        @if (heroSlides.Any())
                        {
                            <div id="@carouselId" class="carousel slide cs-carousel" data-bs-ride="carousel">
                                <div class="carousel-indicators cs-indicators">
                                    @for (var i = 0; i < totalSlides; i++)
                                    {
                                        <button type="button"
                                                data-bs-target="#@carouselId"
                                                data-bs-slide-to="@i"
                                                class="@(i == 0 ? "active" : "")"
                                                aria-current="@(i == 0 ? "true" : "false")"
                                                aria-label="Slide @(i + 1)"></button>
                                    }
                                </div>

                                <div class="carousel-inner">
                                    @for (var i = 0; i < heroSlides.Count; i++)
                                    {
                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                            <img src="@heroSlides[i].ImageUrl" alt="@SharedLocalizer["MyListings.RecipeImageAlt", i + 1, card.Title]" class="cs-hero-img" loading="lazy" />
                                            <div class="cs-recipe-caption">@heroSlides[i].RecipeTitle</div>
                                        </div>
                                    }

                                    @if (hasMacroData)
                                    {
                                        <div class="carousel-item @(heroSlides.Count == 0 ? "active" : "")">
                                            <div class="cs-hero-macro-slide" aria-label="@SharedLocalizer["MyListings.TotalMacrosAria"]">
                                                <div class="cs-macro-title">@SharedLocalizer["MyListings.TotalMacros"]</div>
                                                <div class="cs-macro-grid">
                                                    <span>kcal: @(card.CaloriesKcal.HasValue ? Math.Round(card.CaloriesKcal.Value).ToString() : "-")</span>
                                                    <span>@SharedLocalizer["Recipe.Protein"]: @(card.ProteinGrams.HasValue ? $"{Math.Round(card.ProteinGrams.Value, 1)}g" : "-")</span>
                                                    <span>@SharedLocalizer["Recipe.Fat"]: @(card.FatGrams.HasValue ? $"{Math.Round(card.FatGrams.Value, 1)}g" : "-")</span>
                                                    <span>@SharedLocalizer["Feed.Carbs"]: @(card.CarbsGrams.HasValue ? $"{Math.Round(card.CarbsGrams.Value, 1)}g" : "-")</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(card.CoverImageUrl))
                        {
                            <img src="@card.CoverImageUrl" alt="@card.Title" class="cs-hero-img" loading="lazy" />
                        }
                        else
                        {
                            <div class="cs-hero-fallback" aria-hidden="true"></div>
                        }

                        <div class="cs-overlay"></div>

                        @if (isActive)
                        {
                            <span class="cs-premium-pill" style="background: linear-gradient(135deg, #15803d, #22c55e);">
                                <i class="bi bi-check-circle-fill me-1"></i>@SharedLocalizer["MyListings.Active"]
                            </span>
                        }
                        else
                        {
                            <span class="cs-premium-pill" style="background: linear-gradient(135deg, #6b7280, #9ca3af);">
                                <i class="bi bi-pause-circle-fill me-1"></i>@SharedLocalizer["MyListings.Inactive"]
                            </span>
                        }

                        <div class="cs-hero-text">
                            <h3 class="cs-title">@card.Title</h3>
                            @if (card.IsMealPlan)
                            {
                                <p class="cs-subline mb-0">@SharedLocalizer["Card.Days", card.DayCount] · @SharedLocalizer["Card.RecipesCount", card.RecipeCount] · @card.CreatedDateLabel</p>
                            }
                            else
                            {
                                <p class="cs-subline mb-0">@card.TypeLabel@(card.ListingType == MarketplaceListingType.PhysicalObject && card.StockQuantity.HasValue ? (" · " + SharedLocalizer["Card.OnStockCount", card.StockQuantity.Value].Value) : "") · @card.CreatedDateLabel</p>
                            }
                        </div>
                    </div>

                    <div class="cs-body">
                        <div class="cs-creator-label">@card.PriceWld.ToString("0.##") WLD</div>

                        <div class="cs-macro-row" role="list" aria-label="@SharedLocalizer["MyListings.MacrosTagsAria"]">
                            @if (card.CaloriesKcal.HasValue)
                            {
                                <span class="cs-chip" role="listitem">@Math.Round(card.CaloriesKcal.Value) kcal</span>
                            }
                            @if (card.ProteinGrams.HasValue)
                            {
                                <span class="cs-chip" role="listitem">@Math.Round(card.ProteinGrams.Value, 1)g @SharedLocalizer["Recipe.Protein"]</span>
                            }
                            @if (card.IsLowCarb)
                            {
                                <span class="cs-chip cs-chip-tag" role="listitem">Low Carb</span>
                            }
                            @if (card.IsDietFriendly)
                            {
                                <span class="cs-chip cs-chip-tag" role="listitem">@SharedLocalizer["MyListings.Diet"]</span>
                            }
                        </div>

                        <div class="cs-social-row" aria-label="@SharedLocalizer["MyListings.StatsAria"]">
                            <span><i class="bi bi-star-fill text-warning me-1"></i>@card.Rating.ToString("0.0")</span>
                            <span><i class="bi bi-bag-check-fill me-1"></i>@SharedLocalizer["MyListings.Sold", card.SoldCount]</span>
                            <span><i class="bi bi-people-fill me-1"></i>@SharedLocalizer["MyListings.PlanningNow", card.ActivePlannerCount]</span>
                        </div>

                        <div class="cs-cta-row">
                            <button type="button"
                                    class="cs-btn cs-btn-secondary"
                                    aria-label="@SharedLocalizer["Card.PreviewFor", card.Title]"
                                    onclick="showFeedPreview(@card.ListingId)">
                                @SharedLocalizer["Card.Preview"]
                            </button>

                            <div class="cs-buy-wrap">
                                <div class="ml-sold-badge">
                                    <i class="bi bi-bag-check-fill"></i> @card.SoldCount
                                </div>
                                @if (isActive)
                                {
                                    <button type="button"
                                            class="cs-btn ml-btn-deactivate"
                                            onclick="toggleListing(@card.ListingId, false)">
                                        <i class="bi bi-pause-circle me-1"></i>@SharedLocalizer["MyListings.Deactivate"]
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="cs-btn ml-btn-activate"
                                            onclick="toggleListing(@card.ListingId, true)">
                                        <i class="bi bi-play-circle me-1"></i>@SharedLocalizer["MyListings.Activate"]
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

<style>
    /* Avocado-/Marktplatz-Design (abgestimmt auf Marketplace/Index) */
    body { background: #f5efe1 !important; }

    .ml-back-link {
        color: #14391f;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .ml-back-link:hover { color: #14391f; opacity: .8; }

    .ml-page-title {
        font-family: 'Fraunces', 'Playfair Display', Georgia, serif;
        font-weight: 600;
        letter-spacing: -.02em;
        color: #14391f;
    }
    .ml-page-subtitle { font-size: 12px; color: #6b7868; }

    .ml-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border-radius: 999px;
        padding: 8px 14px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: filter .15s, background .15s;
        white-space: nowrap;
    }
    .ml-pill-solid { background: #14391f; color: #fff; border: 1px solid #14391f; }
    .ml-pill-solid:hover { filter: brightness(1.12); color: #fff; }
    .ml-pill-solid .ml-pill-plus { color: #f5b942; font-size: 14px; margin-right: 2px; }
    .ml-pill-outline { background: #fff; color: #14391f; border: 1px solid rgba(20,57,31,.18); }
    .ml-pill-outline:hover { background: #faf6ec; color: #14391f; }

    .ml-empty-title {
        font-family: 'Fraunces', 'Playfair Display', Georgia, serif;
        font-weight: 600;
        font-size: 18px;
        color: #14391f;
    }

    .ml-card-inactive {
        opacity: 0.65;
        filter: grayscale(0.3);
    }

    .ml-sold-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff;
        font-weight: 700;
        border-radius: 12px;
        padding: 6px 14px;
        font-size: 0.85rem;
    }

    .ml-btn-deactivate {
        background: linear-gradient(135deg, #ef4444, #dc2626) !important;
        color: #fff !important;
        font-weight: 700;
        border: none;
        border-radius: 14px;
        padding: 10px 18px;
        transition: transform 0.2s;
    }

    .ml-btn-deactivate:hover {
        transform: scale(1.03);
    }

    .ml-btn-activate {
        background: linear-gradient(135deg, #15803d, #22c55e) !important;
        color: #fff !important;
        font-weight: 700;
        border: none;
        border-radius: 14px;
        padding: 10px 18px;
        transition: transform 0.2s;
    }

    .ml-btn-activate:hover {
        transform: scale(1.03);
    }
</style>

@section Scripts {
<script>
    async function toggleListing(listingId, activate) {
        if (!confirm(activate ? '@SharedLocalizer["MyListings.ConfirmActivate"]' : '@SharedLocalizer["MyListings.ConfirmDeactivate"]')) return;

        var url = activate
            ? '@Url.Action("ActivateListing", "Marketplace", new { area = "WorldMiniApp" })'
            : '@Url.Action("DeactivateListing", "Marketplace", new { area = "WorldMiniApp" })';

        var form = new FormData();
        form.append('listingId', listingId);
        form.append('__RequestVerificationToken',
            document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');

        try {
            var resp = await fetch(url, {
                method: 'POST',
                body: form
            });
            var data = await resp.json();
            if (data.success) {
                location.reload();
            } else {
                alert('@SharedLocalizer["Dashboard.Error"]: ' + (data.error || '@SharedLocalizer["Error.Generic"]'));
            }
        } catch {
            alert('@SharedLocalizer["Error.NetworkError"].');
        }
    }
</script>
@Html.AntiForgeryToken()
}
