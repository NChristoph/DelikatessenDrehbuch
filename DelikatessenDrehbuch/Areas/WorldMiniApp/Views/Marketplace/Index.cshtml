@model List<DelikatessenDrehbuch.Areas.WorldMiniApp.Models.MealPlanListing>
@{
    ViewData["Title"] = "Marketplace";
    Layout = "_MiniAppLayout";
    var userHash = ViewData["UserHash"]?.ToString() ?? "";
    var walletWLD = ViewData["WalletWLD"]?.ToString() ?? "";
    var walletUSDT = ViewData["WalletUSDT"]?.ToString() ?? "";

    var worldChainId = ViewData["WorldChainId"]?.ToString() ?? "480";
    var worldChainWldToken = ViewData["WorldChainWldToken"]?.ToString() ?? "";
    var worldChainUsdtToken = ViewData["WorldChainUsdtToken"]?.ToString() ?? "";
    var worldChainMarketplace = ViewData["WorldChainMarketplace"]?.ToString() ?? "";
    var allowSelfPurchaseForTesting = (bool?)ViewData["WorldChainAllowSelfPurchaseForTesting"] ?? false;
    var testMode = (bool?)ViewData["WorldChainTestMode"] ?? false;
}

<style>
    .mp-card {
        background: #fff;
        border: none;
        border-radius: 1rem;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        transition: transform .15s, box-shadow .15s;
    }
    .mp-card:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(0,0,0,.1); }

    .coin-badge {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff;
        font-weight: 700;
        border-radius: .6rem;
        padding: .25rem .6rem;
        font-size: .85rem;
    }
    .wallet-bar {
        background: linear-gradient(135deg, #1e293b, #334155);
        color: #fff;
        border-radius: 1rem;
        padding: .75rem 1.25rem;
    }
    .seller-badge { font-size: .75rem; color: #6b7280; }
    .stat-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: .75rem;
        background: rgba(0,0,0,.04);
        border-radius: 1rem;
        padding: 2px 8px;
        color: #6b7280;
    }
    .buy-btn {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        border: none;
        color: #fff;
        font-weight: 600;
        border-radius: .6rem;
        padding: .4rem 1rem;
        font-size: .85rem;
    }
    .buy-btn:hover { filter: brightness(1.1); color: #fff; }
    .buy-btn:disabled { opacity: .5; }

    .token-select {
        display: inline-flex;
        border-radius: .5rem;
        overflow: hidden;
        border: 1px solid #e5e7eb;
        font-size: .75rem;
    }
    .token-select label {
        padding: .25rem .6rem;
        cursor: pointer;
        background: #f9fafb;
        color: #374151;
        font-weight: 600;
        transition: background .15s, color .15s;
        margin: 0;
    }
    .token-select input:checked + label {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff;
    }
    .token-select input { display: none; }

    .test-banner {
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        color: #78350f;
        border-radius: .75rem;
        padding: .5rem 1rem;
        font-size: .8rem;
        font-weight: 600;
    }
    .wallet-status {
        font-size: .8rem;
        color: #94a3b8;
    }
    .balance-row {
        border-top: 1px solid rgba(255,255,255,.1);
        padding-top: .6rem;
        margin-top: .6rem;
    }
    .balance-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,.1);
        border-radius: .5rem;
        padding: .3rem .75rem;
    }
    .balance-label {
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        opacity: .7;
    }
    .balance-value {
        font-size: .9rem;
        font-weight: 600;
    }
    .converted-price {
        font-size: .7rem;
        color: #9ca3af;
        font-weight: 500;
    }
</style>

<div class="container py-4" style="max-width:720px;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-0">Marketplace</h4>
            <p class="text-muted small mb-0">Essenspläne kaufen & verkaufen</p>
            @if (testMode)
            {
                <p class="small mb-0 text-warning-emphasis">Netzwerk: World Testnet (Chain @worldChainId)</p>
            }
        </div>
        <a href="@Url.Action("Sell", "Marketplace", new { area = "WorldMiniApp" })"
           class="btn btn-dark btn-sm rounded-pill">
            <i class="bi bi-plus-lg me-1"></i>Verkaufen
        </a>
    </div>

    <!-- Wallet Bar -->
    <div class="wallet-bar mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="small opacity-75">World Wallet</div>
                <div class="wallet-status mt-1" id="walletStatus">nicht verbunden</div>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-light btn-sm rounded-pill" id="connectWalletBtn" onclick="connectWorldWallet()">
                    <i class="bi bi-wallet2 me-1"></i>Verbinden
                </button>
                <a href="@Url.Action("MyListings", "Marketplace", new { area = "WorldMiniApp" })"
                   class="btn btn-outline-light btn-sm rounded-pill">Meine Angebote</a>
            </div>
        </div>
        <!-- Balance Row (nur sichtbar nach Wallet-Verbindung) -->
        <div id="walletBalances" class="balance-row d-none">
            <div class="d-flex gap-3">
                <div class="balance-badge">
                    <span class="balance-label">WLD</span>
                    <span class="balance-value" id="balanceWLD">&ndash;</span>
                </div>
                <div class="balance-badge">
                    <span class="balance-label">USDCE</span>
                    <span class="balance-value" id="balanceUSDCE">&ndash;</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Listings -->
    @if (allowSelfPurchaseForTesting)
    {
        <div class="test-banner d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-flask"></i>
            <span>Testmodus — eigene Listings kaufbar</span>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-shop fs-1 text-muted"></i>
            <p class="text-muted mt-2">Noch keine Angebote vorhanden.</p>
            <a href="@Url.Action("Sell", "Marketplace", new { area = "WorldMiniApp" })"
               class="btn btn-outline-dark btn-sm rounded-pill">Ersten Plan verkaufen</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var listing in Model)
            {
                var isOwn = listing.SellerHash == userHash;
                <div class="mp-card p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <div class="fw-bold">@listing.Title</div>
                            <div class="seller-badge">
                                <i class="bi bi-person-circle me-1"></i>@listing.SellerName
                                @if (listing.SoldCount > 0)
                                {
                                    <span class="ms-2"><i class="bi bi-bag-check"></i> @listing.SoldCount</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(listing.Description))
                            {
                                <p class="small text-muted mt-1 mb-1">@listing.Description</p>
                            }
                            <div class="mt-1">
                                <span class="stat-pill"><i class="bi bi-calendar3"></i> @listing.DayCount Tage</span>
                                <span class="stat-pill"><i class="bi bi-journal-text"></i> @listing.RecipeCount Rezepte</span>
                            </div>
                        </div>
                        <div class="text-end ms-3">
                            <div class="coin-badge mb-2" id="priceDisplay-@listing.Id" data-price-wld="@listing.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">@listing.Price.ToString("0.##") WLD</div>
                            <div class="converted-price mb-1" id="convertedPrice-@listing.Id"></div>
                            @if (isOwn && !allowSelfPurchaseForTesting)
                            {
                                <div class="small text-muted">Dein Angebot</div>
                            }
                            else
                            {
                                <div class="token-select mb-2" id="tokenSelect-@listing.Id">
                                    <input type="radio" name="token-@listing.Id" id="tok-wld-@listing.Id" value="WLD" checked>
                                    <label for="tok-wld-@listing.Id">WLD</label>
                                    <input type="radio" name="token-@listing.Id" id="tok-usdce-@listing.Id" value="USDCE">
                                    <label for="tok-usdce-@listing.Id">USDCE</label>
                                </div>
                                <button class="buy-btn" id="buyBtn-@listing.Id"
                                        data-seller-wallet="@(listing.SellerWalletAddress ?? "")"
                                        onclick="buyListing(@listing.Id, '@listing.Title', @listing.Price.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                    <i class="bi bi-wallet2 me-1"></i>Kaufen
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
    // NullifierHash kommt nur vom Server (Login-Session)
    const USER_HASH = '@userHash';

    // Wallet-Adressen vom Server (Session)
    let walletAddresses = {
        WLD: '@walletWLD',
        USDCE: '@walletUSDT'
    };

    // WLD/USD Kurs (wird beim Laden geholt)
    let wldPriceUsd = null;

    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    function getSelectedToken(listingId) {
        const el = document.querySelector(`input[name="token-${listingId}"]:checked`);
        return el ? el.value : 'WLD';
    }

    function shortWallet(address) {
        if (!address || address.length < 10) return address || '';
        return `${address.slice(0, 6)}...${address.slice(-4)}`;
    }

    // Wallet-Status im UI aktualisieren
    function updateWalletStatusUI() {
        const el = document.getElementById('walletStatus');
        if (!el) return;

        const addr = walletAddresses.WLD || walletAddresses.USDCE;
        if (addr) {
            el.textContent = shortWallet(addr);
        } else {
            el.textContent = 'nicht verbunden';
        }
    }

    // Wallet-Adresse auf Server in Session speichern
    async function saveWalletToSession(address, token) {
        const form = new FormData();
        form.append('walletAddress', address);
        form.append('token', token);
        form.append('__RequestVerificationToken', getAntiForgeryToken());

        await fetch('@Url.Action("SaveWalletAddress", "Marketplace", new { area = "WorldMiniApp" })', {
            method: 'POST',
            body: form
        });

        walletAddresses[token] = address;
        updateWalletStatusUI();
    }

    // Balances im UI anzeigen
    async function loadWalletBalances(walletAddress) {
        if (!walletAddress || !window.worldChainMarketplace?.getWalletBalances) return;

        const balancesEl = document.getElementById('walletBalances');
        const wldEl = document.getElementById('balanceWLD');
        const usdceEl = document.getElementById('balanceUSDCE');

        // Zeile sichtbar machen, Ladezustand
        if (balancesEl) balancesEl.classList.remove('d-none');
        if (wldEl) wldEl.textContent = '...';
        if (usdceEl) usdceEl.textContent = '...';

        try {
            const balances = await window.worldChainMarketplace.getWalletBalances(walletAddress);
            if (wldEl) wldEl.textContent = balances.wld ?? '\u2013';
            if (usdceEl) usdceEl.textContent = balances.usdt ?? balances.usdce ?? '\u2013';
        } catch (e) {
            console.warn('[Marketplace] Balance-Fehler:', e);
            if (wldEl) wldEl.textContent = '\u2013';
            if (usdceEl) usdceEl.textContent = '\u2013';
        }
    }

    // Preis-Anzeige für ein Listing aktualisieren
    function updateListingPrice(listingId) {
        const token = getSelectedToken(listingId);
        const priceEl = document.getElementById(`priceDisplay-${listingId}`);
        const convertedEl = document.getElementById(`convertedPrice-${listingId}`);
        if (!priceEl) return;

        const wldPrice = parseFloat(priceEl.dataset.priceWld);
        if (isNaN(wldPrice)) return;

        if (token === 'USDCE' && wldPriceUsd) {
            const usdcePrice = (wldPrice * wldPriceUsd).toFixed(2);
            priceEl.textContent = `${usdcePrice} USDCE`;
            if (convertedEl) convertedEl.textContent = `= ${wldPrice} WLD`;
        } else if (token === 'WLD') {
            priceEl.textContent = `${wldPrice} WLD`;
            if (convertedEl && wldPriceUsd) {
                convertedEl.textContent = `\u2248 ${(wldPrice * wldPriceUsd).toFixed(2)} USD`;
            } else if (convertedEl) {
                convertedEl.textContent = '';
            }
        } else {
            priceEl.textContent = `${wldPrice} WLD`;
            if (convertedEl) convertedEl.textContent = '';
        }
    }

    // Alle Listing-Preise aktualisieren
    function updateAllListingPrices() {
        document.querySelectorAll('[id^="priceDisplay-"]').forEach(el => {
            const id = el.id.replace('priceDisplay-', '');
            updateListingPrice(id);
        });
    }

    // WLD/USD Kurs laden und Preise aktualisieren
    async function loadWldPrice() {
        if (!window.worldChainMarketplace?.fetchWldPrice) return;
        wldPriceUsd = await window.worldChainMarketplace.fetchWldPrice();
        if (wldPriceUsd) updateAllListingPrices();
    }

    // Berechne den tatsächlichen Preis je nach Token
    function getActualPrice(wldPrice, token) {
        if (token === 'USDCE' && wldPriceUsd) {
            return parseFloat((wldPrice * wldPriceUsd).toFixed(2));
        }
        return wldPrice; // WLD: Originalpreis
    }

    // Wallet verbinden (nur für Kauf, Login-Session bleibt intakt)
    async function connectWorldWallet() {
        // Bereits verbundene Adresse aus Session verwenden
        const storedAddr = walletAddresses.WLD || walletAddresses.USDCE;
        if (storedAddr) {
            updateWalletStatusUI();
            return storedAddr;
        }

        const btn = document.getElementById('connectWalletBtn');
        if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-arrow-repeat me-1 spin"></i>Verbinde...'; }

        try {
            let address = '';

            // 1. Versuch: EIP-1193 Provider (wenn vorhanden)
            const ethereumProvider = window.worldChainMarketplace?.getEthereumProvider?.();
            if (ethereumProvider) {
                address = await window.worldChainMarketplace.connectWallet();
            }

            // 2. Fallback: walletAuth über MiniKit (überschreibt Login NICHT)
            if (!address && window.connectWalletOnly) {
                address = await window.connectWalletOnly();
            }

            if (!address) {
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-wallet2 me-1"></i>Verbinden'; }
                alert('Wallet-Verbindung fehlgeschlagen.');
                return '';
            }

            // Adresse für alle Tokens in Session speichern (gleiche Wallet)
            await saveWalletToSession(address, 'WLD');
            await saveWalletToSession(address, 'USDT'); // Backend-Key bleibt USDT für USDCE
            walletAddresses.USDCE = address;

            // Button auf "Verbunden" setzen
            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Verbunden'; btn.classList.replace('btn-outline-light', 'btn-success'); }

            // Balances laden und anzeigen
            await loadWalletBalances(address);

            return address;
        } catch (error) {
            if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-wallet2 me-1"></i>Verbinden'; }
            alert(error?.message || 'Wallet-Verbindung fehlgeschlagen.');
            return '';
        }
    }

    // On-Chain TX auf Backend finalisieren
    async function finalizeOnBackend(listingId, txHash, walletAddress, paymentToken) {
        const form = new FormData();
        form.append('ListingId', listingId);
        form.append('TxHash', txHash);
        form.append('WalletAddress', walletAddress || '');
        form.append('PaymentToken', paymentToken || 'WLD');
        form.append('__RequestVerificationToken', getAntiForgeryToken());

        const resp = await fetch('@Url.Action("FinalizeWorldChainPurchase", "Marketplace", new { area = "WorldMiniApp" })', {
            method: 'POST',
            body: form
        });

        return resp.json();
    }

    function setBuyButtonLoading(listingId, loading) {
        const btn = document.getElementById(`buyBtn-${listingId}`);
        if (!btn) return;
        if (loading) {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Kaufe...';
        } else {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-wallet2 me-1"></i>Kaufen';
        }
    }

    // Kauf-Flow: MiniKit pay() → Backend finalisieren
    async function buyListing(listingId, title, priceWld) {
        const token = getSelectedToken(listingId);

        if (!USER_HASH) {
            alert('Bitte zuerst mit World ID einloggen.');
            return;
        }

        // Seller-Wallet vom Button-Attribut lesen
        const buyBtn = document.getElementById(`buyBtn-${listingId}`);
        const sellerWallet = buyBtn?.dataset?.sellerWallet || '';
        if (!sellerWallet) {
            alert('Verkäufer hat keine Wallet hinterlegt. Kauf nicht möglich.');
            return;
        }

        // Preis umrechnen je nach Token
        const actualPrice = getActualPrice(priceWld, token);
        if (token === 'USDCE' && !wldPriceUsd) {
            alert('WLD/USD Kurs nicht verfügbar. Bitte Seite neu laden.');
            return;
        }

        setBuyButtonLoading(listingId, true);

        try {
            // ── Primär: MiniKit pay() (World App native Payment Modal) ──
            if (window.startMiniKitPayment) {
                const reference = `listing-${listingId}-${Date.now()}`;
                const payResult = await window.startMiniKitPayment({
                    to: sellerWallet,
                    tokenSymbol: token,
                    amount: actualPrice,
                    reference,
                    description: `Essensplan: ${title}`
                });

                console.log('[Marketplace] MiniKit payResult:', JSON.stringify(payResult));

                const txRef = payResult?.transaction_id || payResult?.txHash || payResult?.reference || '';
                console.log('[Marketplace] TX Reference:', txRef);

                if (payResult?.status === 'success' && txRef) {
                    const data = await finalizeOnBackend(
                        listingId,
                        txRef,
                        sellerWallet,
                        token
                    );
                    console.log('[Marketplace] Finalize response:', JSON.stringify(data));
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.error || 'Kauf konnte nicht abgeschlossen werden.');
                        setBuyButtonLoading(listingId, false);
                    }
                    return;
                } else if (payResult?.status === 'success') {
                    // Zahlung erfolgreich aber keine TX-Referenz - trotzdem versuchen
                    console.warn('[Marketplace] Keine TX-Referenz, verwende Timestamp als Fallback');
                    const fallbackRef = `minikit-${listingId}-${Date.now()}`;
                    const data = await finalizeOnBackend(listingId, fallbackRef, sellerWallet, token);
                    console.log('[Marketplace] Finalize fallback response:', JSON.stringify(data));
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.error || 'Kauf konnte nicht abgeschlossen werden.');
                        setBuyButtonLoading(listingId, false);
                    }
                    return;
                }
            }

            // ── Fallback: ethers.js + EIP-1193 Provider (Desktop-Browser) ──
            if (window.worldChainMarketplace?.buyListingWithWorldChain) {
                const ethereumProvider = window.worldChainMarketplace.getEthereumProvider?.() || window.ethereum;
                if (ethereumProvider) {
                    const onChainResult = await window.worldChainMarketplace.buyListingWithWorldChain({
                        listingId, price: actualPrice, buyerHash: USER_HASH, paymentToken: token
                    });
                    const data = await finalizeOnBackend(listingId, onChainResult.txHash, onChainResult.walletAddress, onChainResult.paymentToken);
                    if (data.success) {
                        alert('Gekauft! On-Chain Zahlung bestätigt und Plan wurde hinzugefügt.');
                        location.reload();
                    } else {
                        alert(data.error || 'Kauf-Validierung fehlgeschlagen.');
                        setBuyButtonLoading(listingId, false);
                    }
                    return;
                }
            }

            alert('Kein Zahlungsweg verfügbar. Bitte öffne die App in der World App.');
            setBuyButtonLoading(listingId, false);
        } catch (error) {
            alert(error?.message || 'Kauf fehlgeschlagen.');
            setBuyButtonLoading(listingId, false);
        }
    }
</script>
<script>
    window.worldChainMarketplaceConfig = {
        chainId: Number('@worldChainId'),
        wldTokenAddress: '@worldChainWldToken',
        usdtTokenAddress: '@worldChainUsdtToken',
        marketplaceAddress: '@worldChainMarketplace',
        testMode: @(testMode ? "true" : "false")
    };
</script>
<script src="https://cdn.jsdelivr.net/npm/ethers@6.13.2/dist/ethers.umd.min.js"></script>
<script src="~/js/worldchain-marketplace.js"></script>
<script type="module" src="~/js/minikitt.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        updateWalletStatusUI();

        // WLD/USD Kurs laden
        loadWldPrice();

        // Token-Wechsel Listener: Preis aktualisieren bei Radio-Button Änderung
        document.querySelectorAll('.token-select input[type="radio"]').forEach(radio => {
            radio.addEventListener('change', () => {
                const listingId = radio.name.replace('token-', '');
                updateListingPrice(listingId);
            });
        });

        // Wenn Wallet bereits verbunden war (Session), Balances laden
        const existingAddress = walletAddresses.WLD || walletAddresses.USDCE;
        if (existingAddress) {
            const btn = document.getElementById('connectWalletBtn');
            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Verbunden'; btn.classList.replace('btn-outline-light', 'btn-success'); }
            loadWalletBalances(existingAddress);
        }

        if (window.ethereum?.on) {
            window.ethereum.on('accountsChanged', () => {
                walletAddresses.WLD = '';
                walletAddresses.USDCE = '';
                updateWalletStatusUI();
                // Balances ausblenden
                const balancesEl = document.getElementById('walletBalances');
                if (balancesEl) balancesEl.classList.add('d-none');
                const btn = document.getElementById('connectWalletBtn');
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-wallet2 me-1"></i>Verbinden'; btn.classList.replace('btn-success', 'btn-outline-light'); }
            });
        }
    });
</script>
@Html.AntiForgeryToken()
}
