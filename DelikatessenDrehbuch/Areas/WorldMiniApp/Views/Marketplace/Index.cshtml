@model List<DelikatessenDrehbuch.Areas.WorldMiniApp.Models.MealPlanListing>
@{
    ViewData["Title"] = "Marketplace";
    Layout = "_MiniAppLayout";
    var userHash = ViewData["UserHash"]?.ToString() ?? "";
    var balance = (decimal)(ViewData["Balance"] ?? 0m);

    var worldChainId = ViewData["WorldChainId"]?.ToString() ?? "480";
    var worldChainWldToken = ViewData["WorldChainWldToken"]?.ToString() ?? "";
    var worldChainUsdtToken = ViewData["WorldChainUsdtToken"]?.ToString() ?? "";
    var worldChainMarketplace = ViewData["WorldChainMarketplace"]?.ToString() ?? "";
    var allowSelfPurchaseForTesting = (bool?)ViewData["WorldChainAllowSelfPurchaseForTesting"] ?? false;
    var testMode = (bool?)ViewData["WorldChainTestMode"] ?? false;
}

<style>
    .mp-card {
        background: #fff;
        border: none;
        border-radius: 1rem;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        transition: transform .15s, box-shadow .15s;
    }
    .mp-card:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(0,0,0,.1); }

    .coin-badge {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff;
        font-weight: 700;
        border-radius: .6rem;
        padding: .25rem .6rem;
        font-size: .85rem;
    }
    .coin-balance-bar {
        background: linear-gradient(135deg, #1e293b, #334155);
        color: #fff;
        border-radius: 1rem;
        padding: .75rem 1.25rem;
    }
    .seller-badge { font-size: .75rem; color: #6b7280; }
    .stat-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: .75rem;
        background: rgba(0,0,0,.04);
        border-radius: 1rem;
        padding: 2px 8px;
        color: #6b7280;
    }
    .buy-btn {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        border: none;
        color: #fff;
        font-weight: 600;
        border-radius: .6rem;
        padding: .4rem 1rem;
        font-size: .85rem;
    }
    .buy-btn:hover { filter: brightness(1.1); color: #fff; }
    .buy-btn:disabled { opacity: .5; }

    .token-select {
        display: inline-flex;
        border-radius: .5rem;
        overflow: hidden;
        border: 1px solid #e5e7eb;
        font-size: .75rem;
    }
    .token-select label {
        padding: .25rem .6rem;
        cursor: pointer;
        background: #f9fafb;
        color: #374151;
        font-weight: 600;
        transition: background .15s, color .15s;
        margin: 0;
    }
    .token-select input:checked + label {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff;
    }
    .token-select input { display: none; }

    .test-banner {
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        color: #78350f;
        border-radius: .75rem;
        padding: .5rem 1rem;
        font-size: .8rem;
        font-weight: 600;
    }
    .wallet-status {
        font-size: .8rem;
        color: #475569;
    }
</style>

<div class="container py-4" style="max-width:720px;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-0">Marketplace</h4>
            <p class="text-muted small mb-0">Essenspläne kaufen & verkaufen</p>
            @if (testMode)
            {
                <p class="small mb-0 text-warning-emphasis">Netzwerk: World Testnet (Chain @worldChainId)</p>
            }
        </div>
        <a href="@Url.Action("Sell", "Marketplace", new { area = "WorldMiniApp" })"
           class="btn btn-dark btn-sm rounded-pill">
            <i class="bi bi-plus-lg me-1"></i>Verkaufen
        </a>
    </div>

    <!-- Balance Bar -->
    <div class="coin-balance-bar d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="small opacity-75">Dein Guthaben</div>
            <div class="fs-5 fw-bold" id="userBalance">@balance.ToString("0.##") WC</div>
            <div class="wallet-status mt-1" id="walletStatus">Wallet: nicht verbunden</div>
            <div class="small text-light-emphasis mt-2" id="marketplaceDebugData">
                <div><strong>User Hash:</strong> <span id="debugUserHash">@(string.IsNullOrWhiteSpace(userHash) ? "-" : userHash)</span></div>
                <div><strong>Wallet ID:</strong> <span id="debugWalletAddress">-</span></div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-light btn-sm rounded-pill" id="connectWalletBtn" onclick="connectWorldWallet()">Wallet verbinden</button>
            <a href="@Url.Action("MyListings", "Marketplace", new { area = "WorldMiniApp" })"
               class="btn btn-outline-light btn-sm rounded-pill">Meine Angebote</a>
        </div>
    </div>

    <!-- Listings -->
    @if (allowSelfPurchaseForTesting)
    {
        <div class="test-banner d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-flask"></i>
            <span>Testmodus — eigene Listings kaufbar</span>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-shop fs-1 text-muted"></i>
            <p class="text-muted mt-2">Noch keine Angebote vorhanden.</p>
            <a href="@Url.Action("Sell", "Marketplace", new { area = "WorldMiniApp" })"
               class="btn btn-outline-dark btn-sm rounded-pill">Ersten Plan verkaufen</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var listing in Model)
            {
                var isOwn = listing.SellerHash == userHash;
                <div class="mp-card p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <div class="fw-bold">@listing.Title</div>
                            <div class="seller-badge">
                                <i class="bi bi-person-circle me-1"></i>@listing.SellerName
                                @if (listing.SoldCount > 0)
                                {
                                    <span class="ms-2"><i class="bi bi-bag-check"></i> @listing.SoldCount</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(listing.Description))
                            {
                                <p class="small text-muted mt-1 mb-1">@listing.Description</p>
                            }
                            <div class="mt-1">
                                <span class="stat-pill"><i class="bi bi-calendar3"></i> @listing.DayCount Tage</span>
                                <span class="stat-pill"><i class="bi bi-journal-text"></i> @listing.RecipeCount Rezepte</span>
                            </div>
                        </div>
                        <div class="text-end ms-3">
                            <div class="coin-badge mb-2">@listing.Price.ToString("0.##") WC</div>
                            @if (isOwn && !allowSelfPurchaseForTesting)
                            {
                                <div class="small text-muted">Dein Angebot</div>
                            }
                            else
                            {
                                <div class="token-select mb-2" id="tokenSelect-@listing.Id">
                                    <input type="radio" name="token-@listing.Id" id="tok-wld-@listing.Id" value="WLD" checked>
                                    <label for="tok-wld-@listing.Id">WLD</label>
                                    <input type="radio" name="token-@listing.Id" id="tok-usdt-@listing.Id" value="USDT">
                                    <label for="tok-usdt-@listing.Id">USDT</label>
                                </div>
                                <button class="buy-btn"
                                        data-listing-id="@listing.Id"
                                        onclick="buyListing(@listing.Id, '@listing.Title', @listing.Price.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                    <i class="bi bi-wallet2 me-1"></i>Kaufen
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
    function getUserHash() {
        return sessionStorage.getItem('UserToken') || localStorage.getItem('UserToken') || '@userHash';
    }

    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    async function finalizeOnBackend(hash, listingId, txHash, walletAddress, paymentToken) {
        const form = new FormData();
        form.append('UserHash', hash);
        form.append('ListingId', listingId);
        form.append('TxHash', txHash);
        form.append('WalletAddress', walletAddress || '');
        form.append('PaymentToken', paymentToken || 'WLD');
        form.append('__RequestVerificationToken', getAntiForgeryToken());

        const finalizeResp = await fetch('@Url.Action("FinalizeWorldChainPurchase", "Marketplace", new { area = "WorldMiniApp" })', {
            method: 'POST',
            body: form
        });

        return finalizeResp.json();
    }

    function getSelectedToken(listingId) {
        const el = document.querySelector(`input[name="token-${listingId}"]:checked`);
        return el ? el.value : 'WLD';
    }

    function shortWallet(address) {
        if (!address || address.length < 10) return address || '';
        return `${address.slice(0, 6)}...${address.slice(-4)}`;
    }

    function updateDebugData(walletAddress) {
        const hashEl = document.getElementById('debugUserHash');
        const walletEl = document.getElementById('debugWalletAddress');

        if (hashEl && !hashEl.textContent?.trim()) {
            hashEl.textContent = '-';
        }

        if (walletEl) {
            walletEl.textContent = walletAddress || '-';
        }
    }

    function getStoredWalletAddress() {
        return sessionStorage.getItem('UserToken') || localStorage.getItem('UserToken') || '';
    }

    async function refreshWalletStatus() {
        const el = document.getElementById('walletStatus');
        if (!el) return '';

        // 1. Gespeicherte Wallet-Adresse (aus Login) verwenden
        const storedAddr = getStoredWalletAddress();
        if (storedAddr) {
            el.textContent = `Wallet: verbunden (${shortWallet(storedAddr)})`;
            updateDebugData(storedAddr);
            return storedAddr;
        }

        // 2. EIP-1193 Provider prüfen (normaler Browser mit Wallet-Extension)
        try {
            const address = await window.worldChainMarketplace?.getConnectedWalletAddress?.();
            if (address) {
                el.textContent = `Wallet: verbunden (${shortWallet(address)})`;
                updateDebugData(address);
                return address;
            }
        } catch (_) { }

        el.textContent = 'Wallet: nicht verbunden — bitte zuerst einloggen';
        updateDebugData('');
        return '';
    }

    async function connectWorldWallet() {
        // Gespeicherte Adresse aus Login verwenden
        const storedAddr = getStoredWalletAddress();
        if (storedAddr) {
            updateDebugData(storedAddr);
            await refreshWalletStatus();
            return storedAddr;
        }

        // Fallback: EIP-1193 Provider (Browser Wallet)
        try {
            if (window.worldChainMarketplace?.connectWallet) {
                const address = await window.worldChainMarketplace.connectWallet();
                if (address) {
                    updateDebugData(address);
                    await refreshWalletStatus();
                    return address;
                }
            }
        } catch (e) {
            console.warn('connectWallet fehlgeschlagen:', e?.message);
        }

        // Kein Wallet — User muss sich einloggen
        alert('Bitte zuerst einloggen. Gehe zur Startseite und verbinde dein World ID.');
        return '';
    }

    function setBuyButtonLoading(listingId, loading) {
        const btn = document.querySelector(`[data-listing-id="${listingId}"]`);
        if (!btn) return;
        if (loading) {
            btn.disabled = true;
            btn._originalHtml = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Kaufe...';
        } else {
            btn.disabled = false;
            if (btn._originalHtml) btn.innerHTML = btn._originalHtml;
        }
    }

    async function buyListing(listingId, title, price) {
        const hash = getUserHash();
        if (!hash) {
            alert('Bitte zuerst mit World ID einloggen.');
            return;
        }

        const walletAddress = await connectWorldWallet();
        if (!walletAddress) return;

        const token = getSelectedToken(listingId);
        if (!confirm(`"${title}" für ${price} ${token} kaufen?`)) return;

        setBuyButtonLoading(listingId, true);

        try {
            // Versuche On-Chain Kauf über EIP-1193 Provider (ethers.js)
            if (window.worldChainMarketplace?.buyListingWithWorldChain) {
                const ethereumProvider = window.worldChainMarketplace.getEthereumProvider?.() || window.ethereum;
                if (ethereumProvider) {
                    const onChainResult = await window.worldChainMarketplace.buyListingWithWorldChain({
                        listingId, price, buyerHash: hash, paymentToken: token
                    });
                    const data = await finalizeOnBackend(hash, listingId, onChainResult.txHash, onChainResult.walletAddress, onChainResult.paymentToken);
                    if (data.success) {
                        alert('Gekauft! On-Chain Zahlung bestätigt und Plan wurde hinzugefügt.');
                        location.reload();
                    } else {
                        alert(data.error || 'Kauf-Validierung fehlgeschlagen.');
                        setBuyButtonLoading(listingId, false);
                    }
                    return;
                }
            }

            // Fallback: MiniKit sendTransaction (innerhalb World App)
            if (typeof MiniKit !== 'undefined' && MiniKit.commandsAsync?.sendTransaction) {
                const cfg = window.worldChainMarketplaceConfig || {};
                if (!cfg.marketplaceAddress) {
                    alert('Marketplace-Adresse nicht konfiguriert.');
                    setBuyButtonLoading(listingId, false);
                    return;
                }
                const tokenAddress = token === 'USDT' ? cfg.usdtTokenAddress : cfg.wldTokenAddress;
                const decimals = token === 'USDT' ? 6 : 18;
                const amountRaw = BigInt(Math.round(price * (10 ** decimals))).toString();

                const result = await MiniKit.commandsAsync.sendTransaction({
                    transaction: [
                        {
                            address: tokenAddress,
                            abi: [{ name: 'approve', type: 'function', stateMutability: 'nonpayable', inputs: [{ name: 'spender', type: 'address' }, { name: 'amount', type: 'uint256' }], outputs: [{ name: '', type: 'bool' }] }],
                            functionName: 'approve',
                            args: [cfg.marketplaceAddress, amountRaw]
                        },
                        {
                            address: cfg.marketplaceAddress,
                            abi: [{ name: 'buyListing', type: 'function', stateMutability: 'nonpayable', inputs: [{ name: 'listingId', type: 'uint256' }, { name: 'amount', type: 'uint256' }, { name: 'buyerHash', type: 'string' }], outputs: [] }],
                            functionName: 'buyListing',
                            args: [listingId.toString(), amountRaw, hash]
                        }
                    ]
                });

                if (result?.status === 'success' || result?.finalPayload?.status === 'success') {
                    const txHash = result?.transaction_id || result?.finalPayload?.transaction_id || 'minikit-tx';
                    const data = await finalizeOnBackend(hash, listingId, txHash, walletAddress, token);
                    if (data.success) {
                        alert('Gekauft! Plan wurde hinzugefügt.');
                        location.reload();
                    } else {
                        alert(data.error || 'Kauf-Validierung fehlgeschlagen.');
                        setBuyButtonLoading(listingId, false);
                    }
                } else {
                    alert('Transaktion abgebrochen oder fehlgeschlagen.');
                    setBuyButtonLoading(listingId, false);
                }
                return;
            }

            alert('Kein Wallet-Provider verfügbar. Bitte öffne den Marktplatz in der World App.');
            setBuyButtonLoading(listingId, false);
        } catch (error) {
            alert(error?.message || 'Kauf fehlgeschlagen.');
            setBuyButtonLoading(listingId, false);
        }
    }
</script>
<script>
    window.worldChainMarketplaceConfig = {
        chainId: Number('@worldChainId'),
        wldTokenAddress: '@worldChainWldToken',
        usdtTokenAddress: '@worldChainUsdtToken',
        marketplaceAddress: '@worldChainMarketplace',
        testMode: @(testMode ? "true" : "false")
    };
</script>
<script src="https://cdn.jsdelivr.net/npm/ethers@6.13.2/dist/ethers.umd.min.js"></script>
<script src="~/js/worldchain-marketplace.js"></script>
<script type="module">
    import { MiniKit } from "https://cdn.jsdelivr.net/npm/@@worldcoin/minikit-js/+esm";
    try {
        MiniKit.install({ appId: "app_a8d8e00858f1e44ac3dcb9b2f6dfa1aa" });
    } catch (e) {
        console.warn("MiniKit install:", e);
    }
    // Nach MiniKit-Init EIP-6963 Provider erneut anfragen
    window.dispatchEvent(new Event("eip6963:requestProvider"));
</script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        refreshWalletStatus();
    });
</script>
@Html.AntiForgeryToken()
}
