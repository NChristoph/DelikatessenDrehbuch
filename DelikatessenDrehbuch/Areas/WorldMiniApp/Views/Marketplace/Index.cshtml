<script>
    document.addEventListener('DOMContentLoaded', () => {
        updateWalletStatusUI();
        loadWldPrice();
        setGlobalToken('WLD');

        // Filter chips
        document.querySelectorAll('.mp-chip[data-filter]').forEach(chip => {
            chip.addEventListener('click', () => {
                document.querySelectorAll('.mp-chip[data-filter]').forEach(c => c.classList.remove('active'));
                chip.classList.add('active');
                // Future: implement actual filtering
            });
        });

        const previewParam = new URLSearchParams(window.location.search).get('previewId');
        if (previewParam) {
            const id = parseInt(previewParam, 10);
            if (!isNaN(id)) showPreview(id);
        }

        const existingAddress = walletAddresses.WLD || walletAddresses.USDCE;
        if (existingAddress) {
            const btn = document.getElementById('connectWalletBtn');
            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>@SharedLocalizer["Marketplace.Connected"]'; }
            loadWalletBalances(existingAddress);
        }

        if (window.ethereum?.on) {
            window.ethereum.on('accountsChanged', () => {
                walletAddresses.WLD = ''; walletAddresses.USDT = ''; walletAddresses.USDCE = '';
                updateWalletStatusUI();
                const balancesEl = document.getElementById('walletBalances');
                if (balancesEl) balancesEl.classList.add('d-none');
                const btn = document.getElementById('connectWalletBtn');
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-wallet2 me-1"></i>@SharedLocalizer["Marketplace.Connect"]'; }
            });
        }
    });
</script>
