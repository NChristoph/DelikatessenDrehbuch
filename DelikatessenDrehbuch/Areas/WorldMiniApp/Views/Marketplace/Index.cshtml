@model List<DelikatessenDrehbuch.Areas.WorldMiniApp.Models.MealPlanListing>
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<DelikatessenDrehbuch.SharedResources> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Marketplace.Title"].Value;
    Layout = "_MiniAppLayout";
    var userHash = ViewData["UserHash"]?.ToString() ?? "";
    var walletWLD = ViewData["WalletWLD"]?.ToString() ?? "";
    var walletUSDT = ViewData["WalletUSDT"]?.ToString() ?? "";

    var worldChainId = ViewData["WorldChainId"]?.ToString() ?? "480";
    var worldChainWldToken = ViewData["WorldChainWldToken"]?.ToString() ?? "";
    var worldChainUsdtToken = ViewData["WorldChainUsdtToken"]?.ToString() ?? "";
    var worldChainMarketplace = ViewData["WorldChainMarketplace"]?.ToString() ?? "";
    var allowSelfPurchaseForTesting = (bool?)ViewData["WorldChainAllowSelfPurchaseForTesting"] ?? false;
    var testMode = (bool?)ViewData["WorldChainTestMode"] ?? false;
    var creatorShopCards = ViewData["CreatorShopCards"] as List<DelikatessenDrehbuch.Areas.WorldMiniApp.Models.PlanCardViewModel> ?? new List<DelikatessenDrehbuch.Areas.WorldMiniApp.Models.PlanCardViewModel>();
}

<link rel="stylesheet" href="~/css/creator-shop-cards.css" />

<style>
    /* ─── Page Shell — Handheld Marketplace ─── */
    body { background: #f5efe1 !important; }

    .mp-page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 0;
        margin-bottom: 14px;
    }
    .mp-page-header h5 {
        font-family: 'Fraunces', 'Playfair Display', Georgia, serif;
        font-weight: 600;
        font-size: 24px;
        letter-spacing: -0.02em;
        margin: 0;
        color: #14391f;
    }
    .mp-page-subtitle {
        font-size: 12px;
        color: #6b7868;
        margin-top: 2px;
    }

    .mp-sell-btn {
        background: #14391f;
        color: white;
        border: none;
        border-radius: 999px;
        padding: 8px 14px;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        text-decoration: none;
        transition: filter .15s;
    }
    .mp-sell-btn:hover { filter: brightness(1.1); color: white; text-decoration: none; }
    .mp-sell-btn .plus { color: #f5b942; font-size: 14px; margin-right: 2px; }

    .mp-back-link {
        color: #14391f;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    /* Wallet bar — dark green */
    .wallet-bar {
        background: linear-gradient(135deg, #1a3a23, #0e2415);
        color: #fff;
        border-radius: 16px;
        padding: 14px 16px;
    }
    .wallet-status { font-size: .75rem; opacity: .65; margin-top: 2px; }
    .wallet-label { font-size: 13px; font-weight: 600; }
    .balance-row {
        border-top: 1px solid rgba(255,255,255,.1);
        padding-top: .6rem;
        margin-top: .6rem;
    }
    .balance-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,.08);
        border-radius: .5rem;
        padding: .3rem .75rem;
    }
    .balance-label { font-size: .7rem; font-weight: 700; text-transform: uppercase; opacity: .7; }
    .balance-value { font-size: .9rem; font-weight: 600; }

    .mp-wallet-btn {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.18);
        color: white;
        border-radius: 999px;
        padding: 6px 12px;
        font-size: 11px;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        transition: background .15s;
    }
    .mp-wallet-btn:hover { background: rgba(255,255,255,.12); color: white; text-decoration: none; }
    .mp-wallet-btn.primary { background: rgba(255,255,255,.12); }

    /* Filter chips */
    .mp-filters {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        padding-bottom: 4px;
        margin-bottom: 14px;
        scrollbar-width: none;
    }
    .mp-filters::-webkit-scrollbar { display: none; }
    .mp-chip {
        flex-shrink: 0;
        padding: 7px 14px;
        border-radius: 999px;
        background: white;
        border: 1px solid rgba(20, 57, 31, 0.12);
        font-size: 12px;
        font-weight: 500;
        color: #1a2e20;
        cursor: pointer;
        white-space: nowrap;
        transition: all .15s;
    }
    .mp-chip.active {
        background: #14391f;
        color: white;
        border-color: #14391f;
    }

    /* Test banner CSS entfernt für Production */

    /* Preview Offcanvas */
    .preview-offcanvas {
        border-radius: 1.5rem 1.5rem 0 0 !important;
        max-height: 85vh;
    }
    .preview-day-header {
        font-weight: 700;
        font-size: .85rem;
        color: #14391f;
        padding: .5rem 0 .25rem;
        border-bottom: 2px solid #f5b942;
        margin-bottom: .5rem;
    }
    .preview-recipe {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .5rem 0;
    }
    .preview-recipe-img {
        width: 50px;
        height: 50px;
        border-radius: .6rem;
        object-fit: cover;
        background: #faf6ec;
        flex-shrink: 0;
    }
    .preview-recipe-title {
        font-weight: 600;
        font-size: .85rem;
        color: #14391f;
    }
    .preview-recipe-meta {
        font-size: .72rem;
        color: #6b7868;
    }
    .nutrition-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: .5rem;
    }
    .nutrition-item {
        text-align: center;
        background: #faf6ec;
        border-radius: .6rem;
        padding: .5rem .25rem;
    }
    .nutrition-value {
        font-family: 'Fraunces', serif;
        font-weight: 700;
        font-size: 1rem;
        color: #14391f;
    }
    .nutrition-label {
        font-size: .65rem;
        color: #6b7868;
        text-transform: uppercase;
        font-weight: 600;
    }

    .own-listing-label {
        font-size: 11px;
        color: #6b7868;
        font-weight: 600;
        margin-bottom: 4px;
    }

    @@keyframes mp-fadeIn {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="container py-3" style="max-width:720px;">

    <!-- Header -->
    <div class="mp-page-header">
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("Index", "Home", new { area = "WorldMiniApp" })" class="mp-back-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M15 18l-6-6 6-6"/>
                </svg>
            </a>
            <div>
                <h5>@SharedLocalizer["Marketplace.Title"]</h5>
                <div class="mp-page-subtitle">@SharedLocalizer["Marketplace.BuyAndSell"]</div>
            </div>
        </div>
    </div>


    <!-- Wallet Bar -->
    <div class="wallet-bar mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="wallet-label">World Wallet</div>
                <div class="wallet-status" id="walletStatus">@SharedLocalizer["Marketplace.NotConnected"]</div>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="mp-wallet-btn primary" id="connectWalletBtn" onclick="connectWorldWallet()">
                    <i class="bi bi-wallet2 me-1"></i>@SharedLocalizer["Marketplace.Connect"]
                </button>
                <a href="@Url.Action("MyListings", "Marketplace", new { area = "WorldMiniApp" })"
                   class="mp-wallet-btn">@SharedLocalizer["Marketplace.Mine"]</a>
            </div>
        </div>
        <div id="walletBalances" class="balance-row d-none">
            <div class="d-flex gap-3">
                <div class="balance-badge">
                    <span class="balance-label">WLD</span>
                    <span class="balance-value" id="balanceWLD">&ndash;</span>
                </div>
                <div class="balance-badge">
                    <span class="balance-label">USDCE</span>
                    <span class="balance-value" id="balanceUSDCE">&ndash;</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Verkaufen CTA -->
    <div class="text-center mb-3">
        <a href="@Url.Action("Sell", "Marketplace", new { area = "WorldMiniApp" })" class="mp-sell-btn" style="display: inline-block;">
            <span class="plus">+</span> @SharedLocalizer["Marketplace.CreateListing"]
        </a>
    </div>

    @* Test-Banner entfernt für Production *@

    <!-- Filter Chips -->
    <div class="mp-filters">
        <button class="mp-chip active" data-filter="all">@SharedLocalizer["Marketplace.FilterAll", creatorShopCards.Count]</button>
        <button class="mp-chip" data-filter="premium">Premium</button>
        <button class="mp-chip" data-filter="low-carb">Low Carb</button>
        <button class="mp-chip" data-filter="high-protein">High-Protein</button>
    </div>

    <!-- Listings -->
    @if (!creatorShopCards.Any())
    {
        <div class="text-center py-5">
            <div class="mb-3">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#6b7868" stroke-width="1.5" opacity=".5">
                    <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
            </div>
            <p style="color:#6b7868" class="mb-1">@SharedLocalizer["Marketplace.NoListings"]</p>
            <p style="color:#6b7868" class="small mb-3">@SharedLocalizer["Marketplace.BeFirst"]</p>
            <a href="@Url.Action("Sell", "Marketplace", new { area = "WorldMiniApp" })" class="mp-sell-btn">
                <span class="plus">+</span> @SharedLocalizer["Marketplace.SellFirst"]
            </a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3 mb-4" id="listingsContainer">
            @foreach (var card in creatorShopCards)
            {
                var isOwn = card.CreatorHash == userHash;

                <div class="mb-2">
                    @if (isOwn && !allowSelfPurchaseForTesting)
                    {
                        <div class="own-listing-label">@SharedLocalizer["Marketplace.YourListing"]</div>
                    }
                    @await Html.PartialAsync("_CreatorShopPlanCard", card)
                </div>
            }
        </div>
    }
</div>

<!-- Preview Offcanvas -->
<div class="offcanvas offcanvas-bottom preview-offcanvas" tabindex="-1" id="previewOffcanvas">
    <div class="offcanvas-header pb-2">
        <h6 class="offcanvas-title fw-bold" id="previewTitle">@SharedLocalizer["Marketplace.PlanPreview"]</h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body pt-0" id="previewBody">
        <div class="text-center py-4">
            <div class="spinner-border spinner-border-sm text-secondary"></div>
            <p class="small text-muted mt-2">@SharedLocalizer["Marketplace.LoadingPreview"]</p>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const USER_HASH = '@userHash';
    let walletAddresses = { WLD: '@walletWLD', USDT: '@walletUSDT', USDCE: '@walletUSDT' };
    let wldPriceUsd = null;
    let selectedPaymentToken = 'WLD';

    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    function setGlobalToken(token) {
        selectedPaymentToken = token === 'USDCE' ? 'USDCE' : 'WLD';
        // Sync all card currency pills
        document.querySelectorAll('.cs-currency-pill').forEach(pill => {
            pill.querySelectorAll('.cs-currency-opt').forEach(opt => {
                opt.classList.toggle('active', opt.dataset.token === selectedPaymentToken);
            });
        });
        updateAllListingPrices();
    }

    function setFeedToken(token, listingId = null) {
        const selected = token === 'USDCE' ? 'USDCE' : 'WLD';
        if (!listingId) {
            setGlobalToken(selected);
            return;
        }
        toggleCardCurrency(listingId, selected);
    }

    function getSelectedToken() {
        return selectedPaymentToken;
    }

    function shortWallet(address) {
        if (!address || address.length < 10) return address || '';
        return `${address.slice(0, 6)}...${address.slice(-4)}`;
    }

    function updateWalletStatusUI() {
        const el = document.getElementById('walletStatus');
        if (!el) return;
        const addr = walletAddresses.WLD || walletAddresses.USDCE;
        el.textContent = addr ? shortWallet(addr) : '@SharedLocalizer["Marketplace.NotConnected"]';
    }

    async function saveWalletToSession(address, token) {
        const form = new FormData();
        form.append('walletAddress', address);
        form.append('token', token);
        form.append('__RequestVerificationToken', getAntiForgeryToken());
        await fetch('@Url.Action("SaveWalletAddress", "Marketplace", new { area = "WorldMiniApp" })', { method: 'POST', body: form });
        walletAddresses[token] = address;
        updateWalletStatusUI();
    }

    async function loadWalletBalances(walletAddress) {
        if (!walletAddress || !window.worldChainMarketplace?.getWalletBalances) return;

        const balancesEl = document.getElementById('walletBalances');
        const wldEl = document.getElementById('balanceWLD');
        const usdceEl = document.getElementById('balanceUSDCE');

        if (balancesEl) balancesEl.classList.remove('d-none');
        if (wldEl) wldEl.textContent = '...';
        if (usdceEl) usdceEl.textContent = '...';

        try {
            const balances = await window.worldChainMarketplace.getWalletBalances(walletAddress);
            if (wldEl) wldEl.textContent = balances.wld ?? '\u2013';
            if (usdceEl) usdceEl.textContent = balances.usdt ?? balances.usdce ?? '\u2013';
        } catch (e) {
            console.warn('[Marketplace] Balance-Fehler:', e);
            if (wldEl) wldEl.textContent = '\u2013';
            if (usdceEl) usdceEl.textContent = '\u2013';
        }
    }

    function updateListingPrice(listingId, tokenOverride = null) {
        const token = tokenOverride || getSelectedToken();
        const priceEl = document.getElementById(`priceDisplay-${listingId}`) || document.getElementById(`feedPrice-${listingId}`);
        const convertedEl = document.getElementById(`convertedPrice-${listingId}`);
        if (!priceEl) return;
        const wldPrice = parseFloat(priceEl.dataset.priceWld);
        if (isNaN(wldPrice)) return;

        if (token === 'USDCE' && wldPriceUsd) {
            priceEl.textContent = `${(wldPrice * wldPriceUsd).toFixed(2)} USDCE`;
            if (convertedEl) convertedEl.textContent = `= ${wldPrice} WLD`;
        } else {
            priceEl.textContent = `${wldPrice} WLD`;
            if (convertedEl) convertedEl.textContent = wldPriceUsd ? `\u2248 ${(wldPrice * wldPriceUsd).toFixed(2)} USD` : '';
        }
    }

    function updateAllListingPrices() {
        document.querySelectorAll('[id^="priceDisplay-"], [id^="feedPrice-"]').forEach(el => {
            const id = el.id.startsWith('feedPrice-')
                ? el.id.replace('feedPrice-', '')
                : el.id.replace('priceDisplay-', '');
            updateListingPrice(id);
        });
    }

    async function loadWldPrice() {
        if (!window.worldChainMarketplace?.fetchWldPrice) return;
        wldPriceUsd = await window.worldChainMarketplace.fetchWldPrice();
        if (wldPriceUsd) updateAllListingPrices();
    }

    function getActualPrice(wldPrice, token) {
        if (token === 'USDCE' && wldPriceUsd) return parseFloat((wldPrice * wldPriceUsd).toFixed(2));
        return wldPrice;
    }

    // ── Preview ──
    async function showPreview(listingId) {
        const titleEl = document.getElementById('previewTitle');
        const bodyEl = document.getElementById('previewBody');
        if (titleEl) titleEl.textContent = '@SharedLocalizer["Marketplace.PlanPreview"]';
        if (bodyEl) bodyEl.innerHTML = '<div class="text-center py-4"><div class="spinner-border spinner-border-sm text-secondary"></div><p class="small text-muted mt-2">@SharedLocalizer["Marketplace.LoadingPreview"]</p></div>';

        const offcanvas = new bootstrap.Offcanvas(document.getElementById('previewOffcanvas'));
        offcanvas.show();

        try {
            const resp = await fetch(`@Url.Action("GetListingPreview", "Marketplace", new { area = "WorldMiniApp" })?listingId=${listingId}`);
            const data = await resp.json();
            if (!data.success) {
                bodyEl.innerHTML = `<p class="text-danger small">${data.error || '@SharedLocalizer["Marketplace.PreviewUnavailable"]'}</p>`;
                return;
            }

            if (titleEl) titleEl.textContent = data.title || '@SharedLocalizer["Marketplace.PlanPreview"]';

            let html = '';

            if (data.description) {
                html += `<p class="small text-muted mb-3">${data.description}</p>`;
            }

            // Nutrition summary
            if (data.nutrition) {
                const n = data.nutrition;
                html += `<div class="nutrition-grid mb-3">
                    <div class="nutrition-item">
                        <div class="nutrition-value">${Math.round(n.calories)}</div>
                        <div class="nutrition-label">kcal</div>
                    </div>
                    <div class="nutrition-item">
                        <div class="nutrition-value">${n.protein}g</div>
                        <div class="nutrition-label">@SharedLocalizer["Recipe.Protein"]</div>
                    </div>
                    <div class="nutrition-item">
                        <div class="nutrition-value">${n.fat}g</div>
                        <div class="nutrition-label">@SharedLocalizer["Recipe.Fat"]</div>
                    </div>
                    <div class="nutrition-item">
                        <div class="nutrition-value">${n.carbs}g</div>
                        <div class="nutrition-label">@SharedLocalizer["Recipe.Carbs"]</div>
                    </div>
                    <div class="nutrition-item">
                        <div class="nutrition-value">${n.fiber}g</div>
                        <div class="nutrition-label">@SharedLocalizer["Marketplace.Fiber"]</div>
                    </div>
                    <div class="nutrition-item">
                        <div class="nutrition-value">${data.recipeCount}</div>
                        <div class="nutrition-label">@SharedLocalizer["Card.Recipes"]</div>
                    </div>
                </div>`;
                html += `<p class="text-muted small mb-3"><i class="bi bi-info-circle me-1"></i>@SharedLocalizer["Marketplace.NutritionWholePlan"]</p>`;
            }

            // Days + recipes
            if (data.days && data.days.length) {
                for (const day of data.days) {
                    html += `<div class="preview-day-header"><i class="bi bi-calendar-event me-1"></i>@SharedLocalizer["Marketplace.DayPrefix"] ${day.day}</div>`;
                    if (!day.recipes || !day.recipes.length) {
                        html += `<p class="text-muted small py-2">@SharedLocalizer["Marketplace.NoRecipesDay"]</p>`;
                        continue;
                    }
                    for (const r of day.recipes) {
                        const imgTag = r.image
                            ? `<img src="${r.image}" class="preview-recipe-img" loading="lazy" onerror="this.style.display='none'">`
                            : `<div class="preview-recipe-img d-flex align-items-center justify-content-center"><i class="bi bi-egg-fried text-muted"></i></div>`;
                        const timeStr = r.time ? `${r.time} Min` : '';
                        const catStr = r.category || '';
                        const meta = [catStr, timeStr].filter(Boolean).join(' &middot; ');
                        html += `<div class="preview-recipe">
                            ${imgTag}
                            <div>
                                <div class="preview-recipe-title">${r.title}</div>
                                <div class="preview-recipe-meta">${meta}</div>
                            </div>
                        </div>`;
                    }
                }
            }

            bodyEl.innerHTML = html || '<p class="text-muted">@SharedLocalizer["Marketplace.NoPreview"]</p>';
        } catch (e) {
            console.error('[Marketplace] Preview error:', e);
            bodyEl.innerHTML = '<p class="text-danger small">@SharedLocalizer["Marketplace.PreviewLoadError"]</p>';
        }
    }

    // ── Wallet Connect ──
    async function connectWorldWallet() {
        const storedAddr = walletAddresses.WLD || walletAddresses.USDCE;
        if (storedAddr) { updateWalletStatusUI(); await loadWalletBalances(storedAddr); return storedAddr; }

        const btn = document.getElementById('connectWalletBtn');
        if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-arrow-repeat me-1 spin"></i>@SharedLocalizer["Marketplace.Connecting"]'; }

        try {
            let address = '';
            const ethereumProvider = window.worldChainMarketplace?.getEthereumProvider?.();
            if (ethereumProvider) address = await window.worldChainMarketplace.connectWallet();
            if (!address && window.connectWalletOnly) address = await window.connectWalletOnly();

            if (!address) {
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-wallet2 me-1"></i>@SharedLocalizer["Marketplace.Connect"]'; }
                alert('@SharedLocalizer["Marketplace.WalletConnectFailed"]');
                return '';
            }

            await saveWalletToSession(address, 'WLD');
            await saveWalletToSession(address, 'USDT');
            walletAddresses.USDT = address;
            walletAddresses.USDCE = address;

            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>@SharedLocalizer["Marketplace.Connected"]'; btn.classList.replace('btn-outline-light', 'btn-success'); }
            await loadWalletBalances(address);
            return address;
        } catch (error) {
            if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-wallet2 me-1"></i>@SharedLocalizer["Marketplace.Connect"]'; }
            alert(error?.message || '@SharedLocalizer["Marketplace.WalletConnectFailed"]');
            return '';
        }
    }


    async function ensureBuyerWalletForToken(token) {
        const normalized = (token || 'WLD').toUpperCase();
        const mappedToken = normalized === 'USDCE' ? 'USDT' : normalized;

        let buyerWallet = mappedToken === 'USDT' ? (walletAddresses.USDT || walletAddresses.USDCE) : walletAddresses.WLD;
        if (buyerWallet) return buyerWallet;

        // Wallet ggf. erst nach MiniKit-Payment holen und in Session speichern
        buyerWallet = await connectWorldWallet();
        if (!buyerWallet) return '';

        if (mappedToken === 'USDT') {
            walletAddresses.USDT = buyerWallet;
            walletAddresses.USDCE = buyerWallet;
        } else {
            walletAddresses.WLD = buyerWallet;
        }

        return buyerWallet;
    }

    // ── Finalize on Backend ──
    async function finalizeOnBackend(listingId, txHash, walletAddress, paymentToken) {
        const form = new FormData();
        form.append('ListingId', listingId);
        form.append('TxHash', txHash);
        form.append('WalletAddress', walletAddress || '');
        form.append('PaymentToken', paymentToken || 'WLD');
        form.append('ShippingAddress', window._pendingShippingAddress || '');
        form.append('__RequestVerificationToken', getAntiForgeryToken());

        const resp = await fetch('@Url.Action("FinalizeWorldChainPurchase", "Marketplace", new { area = "WorldMiniApp" })', {
            method: 'POST',
            body: form,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });

        const contentType = resp.headers.get('content-type') || '';
        const rawText = await resp.text();

        if (!contentType.includes('application/json')) {
            const compact = (rawText || '').replace(/\s+/g, ' ').trim().slice(0, 200);
            throw new Error(`Finalize lieferte kein JSON (HTTP ${resp.status}). Antwort: ${compact || 'leer'}`);
        }

        let data = null;
        try {
            data = JSON.parse(rawText);
        } catch {
            const compact = (rawText || '').replace(/\s+/g, ' ').trim().slice(0, 200);
            throw new Error(`Ungültige JSON-Antwort vom Server (HTTP ${resp.status}): ${compact || 'leer'}`);
        }

        if (!resp.ok) {
            throw new Error(data?.error || `Finalize fehlgeschlagen (HTTP ${resp.status}).`);
        }

        return data;
    }

    // Nach erfolgreichem Kauf: digitales Produkt -> Download öffnen, sonst Seite neu laden.
    function handlePurchaseSuccess(data) {
        window._pendingShippingAddress = '';
        if (data && data.downloadUrl) {
            alert('@SharedLocalizer["Marketplace.PurchaseDownloadOpening"]');
            window.location.href = data.downloadUrl;
            return;
        }
        if (data && data.listingType && data.listingType !== 'MealPlan' && data.listingType !== 'SingleRecipe') {
            alert('@SharedLocalizer["Marketplace.PurchaseSellerNotified"]');
        }
        location.reload();
    }

    function setBuyButtonLoading(listingId, loading) {
        const btn = document.getElementById(`buyBtn-${listingId}`);
        if (!btn) return;
        if (loading) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>@SharedLocalizer["Marketplace.Buying"]'; }
        else { btn.disabled = false; btn.innerHTML = '<i class="bi bi-wallet2 me-1"></i>@SharedLocalizer["Offer.Buy"]'; }
    }


    function showFeedPreview(listingId) {
        return showPreview(listingId);
    }

    function buyFeedListing(listingId, title, priceWld, sellerWallet, listingType, requiresShipping) {
        return buyListing(listingId, title, priceWld, sellerWallet, listingType, requiresShipping);
    }

    // ── Buy Flow ──
    async function buyListing(listingId, title, priceWld, sellerWalletOverride, listingType, requiresShipping) {
        const token = getSelectedToken();
        listingType = listingType || 'MealPlan';

        if (!USER_HASH) { alert('@SharedLocalizer["Marketplace.LoginFirst"]'); return; }

        const buyBtn = document.getElementById(`buyBtn-${listingId}`);
        const sellerWallet = sellerWalletOverride || buyBtn?.dataset?.sellerWallet || '';
        if (!sellerWallet) { alert('@SharedLocalizer["Marketplace.SellerNoWallet"]'); return; }

        // Bei physischem Objekt mit Versand vor der Zahlung die Lieferadresse erfragen.
        let shippingAddress = '';
        if (listingType === 'PhysicalObject' && requiresShipping) {
            shippingAddress = (prompt('@SharedLocalizer["Marketplace.ShippingPrompt"]') || '').trim();
            if (!shippingAddress) { alert('@SharedLocalizer["Marketplace.ShippingRequired"]'); return; }
        }

        const actualPrice = getActualPrice(priceWld, token);
        if (token === 'USDCE' && !wldPriceUsd) { alert('@SharedLocalizer["Marketplace.RateUnavailable"]'); return; }

        setBuyButtonLoading(listingId, true);
        window._pendingShippingAddress = shippingAddress;

        try {
            // MiniKit pay()
            if (window.startMiniKitPayment) {
                // Modell B: Zahlung geht an die PLATTFORM-Wallet (nicht direkt an den Verkäufer).
                // Der Verkäufer-Anteil (80%) wird serverseitig als Guthaben verbucht.
                const platformWallet = (token === 'USDCE' || token === 'USDT')
                    ? (window.MARKETPLACE_PLATFORM_WALLET_USDT || window.MARKETPLACE_PLATFORM_WALLET_WLD)
                    : window.MARKETPLACE_PLATFORM_WALLET_WLD;
                if (!platformWallet) {
                    alert('@SharedLocalizer["Marketplace.PlatformWalletMissing"]');
                    setBuyButtonLoading(listingId, false);
                    return;
                }

                const reference = `listing-${listingId}-${Date.now()}`;
                const payResult = await window.startMiniKitPayment({
                    to: platformWallet, tokenSymbol: token, amount: actualPrice,
                    reference, description: `@SharedLocalizer["Marketplace.Title"]: ${title}`
                });

                console.log('[Marketplace] MiniKit payResult:', JSON.stringify(payResult));
                const txRef = payResult?.transaction_id || payResult?.txHash || payResult?.reference || '';
                console.log('[Marketplace] TX Reference:', txRef);

                if (payResult?.status === 'success' && txRef) {
                    const buyerWallet = await ensureBuyerWalletForToken(token);
                    const data = await finalizeOnBackend(listingId, txRef, buyerWallet, token);
                    console.log('[Marketplace] Finalize response:', JSON.stringify(data));
                    if (data.success) { handlePurchaseSuccess(data); }
                    else { alert(data.error || '@SharedLocalizer["Marketplace.PurchaseIncomplete"]'); setBuyButtonLoading(listingId, false); }
                    return;
                } else if (payResult?.status === 'success') {
                    console.warn('[Marketplace] Keine TX-Referenz, verwende Timestamp als Fallback');
                    const fallbackRef = `minikit-${listingId}-${Date.now()}`;
                    const buyerWallet = await ensureBuyerWalletForToken(token);
                    const data = await finalizeOnBackend(listingId, fallbackRef, buyerWallet, token);
                    if (data.success) { handlePurchaseSuccess(data); }
                    else { alert(data.error || '@SharedLocalizer["Marketplace.PurchaseIncomplete"]'); setBuyButtonLoading(listingId, false); }
                    return;
                }
            }

            // Fallback: ethers.js
            if (window.worldChainMarketplace?.buyListingWithWorldChain) {
                const ethereumProvider = window.worldChainMarketplace.getEthereumProvider?.() || window.ethereum;
                if (ethereumProvider) {
                    const onChainResult = await window.worldChainMarketplace.buyListingWithWorldChain({
                        listingId, price: actualPrice, buyerHash: USER_HASH, paymentToken: token
                    });
                    const data = await finalizeOnBackend(listingId, onChainResult.txHash, onChainResult.walletAddress, onChainResult.paymentToken);
                    if (data.success) { handlePurchaseSuccess(data); }
                    else { alert(data.error || '@SharedLocalizer["Marketplace.PurchaseValidationFailed"]'); setBuyButtonLoading(listingId, false); }
                    return;
                }
            }

            alert('@SharedLocalizer["Marketplace.NoPaymentMethod"]');
            setBuyButtonLoading(listingId, false);
        } catch (error) {
            alert(error?.message || '@SharedLocalizer["Marketplace.PurchaseFailed"]');
            setBuyButtonLoading(listingId, false);
        }
    }
</script>
<script>
    window.worldChainMarketplaceConfig = {
        chainId: Number('@worldChainId'),
        wldTokenAddress: '@worldChainWldToken',
        usdtTokenAddress: '@worldChainUsdtToken',
        marketplaceAddress: '@worldChainMarketplace',
        testMode: @(testMode ? "true" : "false")
    };
    // Modell B: Käufe gehen an die Plattform-Wallet (nicht direkt an den Verkäufer).
    window.MARKETPLACE_PLATFORM_WALLET_WLD = '@(ViewData["MarketplacePlatformWalletWld"])';
    window.MARKETPLACE_PLATFORM_WALLET_USDT = '@(ViewData["MarketplacePlatformWalletUsdt"])';
</script>
