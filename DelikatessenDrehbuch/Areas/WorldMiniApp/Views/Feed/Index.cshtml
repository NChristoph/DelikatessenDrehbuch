@using DelikatessenDrehbuch.Areas.WorldMiniApp.Models
@model List<WorldUserPosting>
@{
    ViewData["Title"] = "Feed";
    Layout = null;
    var language = (Context.Request.Cookies["deli-lang"] ?? "de").ToLowerInvariant();
    string T(string de, string en, string es, string pt) => language switch
    {
        "en" => en,
        "es" => es,
        "pt" => pt,
        _ => de
    };

    var selectedCategoryRaw = (ViewData["Category"]?.ToString() ?? string.Empty).Trim().ToLowerInvariant();
    var selectedCategory = selectedCategoryRaw switch
    {
        "appetizer" or "aperetizer" or "vorspeise" or "entrada" => "appetizer",
        "main" or "maincourse" or "hauptspeise" or "plato principal" or "platoprincipal" or "prato principal" or "pratoprincipal" => "main",
        "dessert" or "postre" or "sobremesa" or "nachspeise" => "dessert",
        _ => selectedCategoryRaw
    };
}
<!DOCTYPE html>
<html lang="@language">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Delikatessen Feed</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        body, html {
            margin: 0;
            padding: 0;
            background-color: #000;
            height: 100%;
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        .feed-container {
            height: 100vh;
            width: 100vw;
            overflow-y: scroll;
            scroll-snap-type: y mandatory;
            scroll-behavior: smooth;
        }

        .feed-item {
            position: relative;
            height: 100vh;
            width: 100vw;
            scroll-snap-align: start;
            scroll-snap-stop: always;
            background-color: #000;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .feed-media {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
            background-color: #000;
        }

        .overlay-gradient {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 60%;
            background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 50%, transparent 100%);
            z-index: 2;
            pointer-events: none;
        }

        .play-icon-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 4rem;
            color: rgba(255,255,255,0.8);
            z-index: 4;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.2s;
        }

        .feed-item.paused .play-icon-overlay {
            opacity: 1;
        }

        .sound-toggle {
            position: absolute;
            top: 60px;
            right: 20px;
            z-index: 5;
            background: rgba(0,0,0,0.4);
            backdrop-filter: blur(5px);
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border: 1px solid rgba(255,255,255,0.2);
            font-size: 1.2rem;
        }

        .unmute-hint {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(5px);
            color: white;
            padding: 10px 20px;
            border-radius: 30px;
            font-weight: 600;
            z-index: 50;
            pointer-events: none;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0% { transform: translate(-50%, -50%) scale(1); }
            50% { transform: translate(-50%, -50%) scale(1.05); }
            100% { transform: translate(-50%, -50%) scale(1); }
        }

        .info-container {
            position: absolute;
            bottom: 100px;
            left: 20px;
            right: 80px;
            z-index: 3;
            color: white;
            text-align: left;
            pointer-events: none;
        }

        .info-container * { pointer-events: auto; }

        .chef-badge {
            display: inline-flex;
            align-items: center;
            background: rgba(20, 20, 20, 0.65);
            backdrop-filter: blur(10px);
            padding: 4px 4px 4px 12px;
            border-radius: 50px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: white;
            margin-bottom: 12px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            max-width: fit-content;
        }

        .chef-badge img {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            margin-right: 8px;
            object-fit: cover;
        }

        .chef-name {
            font-weight: 600;
            font-size: 0.9rem;
            margin-right: 10px;
            white-space: nowrap;
        }

        .separator {
            width: 1px;
            height: 16px;
            background: rgba(255, 255, 255, 0.3);
            margin-right: 4px;
        }

        .follow-btn {
            background: transparent;
            border: none;
            color: white;
            font-size: 1.2rem;
            padding: 4px 8px;
            display: flex;
            align-items: center;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .follow-btn:active { transform: scale(0.9); }

        .recipe-title {
            font-size: 1.8rem;
            font-weight: 800;
            margin-bottom: 6px;
            line-height: 1.1;
            text-shadow: 0 2px 10px rgba(0,0,0,0.5);
            color: #fff;
        }

        .recipe-meta {
            font-size: 0.95rem;
            opacity: 0.95;
            margin-bottom: 10px;
            font-weight: 600;
        }

        .action-bar {
            position: absolute;
            bottom: 120px;
            right: 15px;
            z-index: 3;
            display: flex;
            flex-direction: column;
            gap: 20px;
            align-items: center;
        }

        .action-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: white;
            cursor: pointer;
            transition: transform 0.1s;
        }

        .action-btn:active { transform: scale(0.9); }

        .icon-circle {
            width: 52px;
            height: 52px;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            margin-bottom: 4px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        .action-btn.liked .icon-circle {
            background: linear-gradient(135deg, #FF9966 0%, #FF5E62 100%);
            border: none;
            box-shadow: 0 4px 20px rgba(255, 94, 98, 0.5);
        }

        .action-label {
            font-size: 0.75rem;
            font-weight: 700;
            text-shadow: 0 1px 3px rgba(0,0,0,0.8);
        }

        .bottom-nav {
            position: fixed;
            bottom: 0;
            width: 100%;
            height: 80px;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(20px);
            border-top-left-radius: 30px;
            border-top-right-radius: 30px;
            border-top: 1px solid rgba(255,255,255,0.8);
            z-index: 10;
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding-bottom: 15px;
        }

        .nav-item {
            color: #bdc3c7;
            font-size: 1.8rem;
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .add-btn-wrapper {
            position: relative;
            top: -25px;
        }

        .add-btn {
            background: linear-gradient(135deg, #FF9966 0%, #FF5E62 100%);
            width: 65px;
            height: 65px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2.2rem;
            box-shadow: 0 8px 25px rgba(255, 94, 98, 0.5);
            border: 5px solid white;
        }

        .double-tap-heart {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0);
            font-size: 6rem;
            color: white;
            text-shadow: 0 4px 20px rgba(0,0,0,0.3);
            z-index: 100;
            opacity: 0;
            pointer-events: none;
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.3s;
        }

        .double-tap-heart.animate {
            transform: translate(-50%, -50%) scale(1.2);
            opacity: 1;
        }

        :root {
            --plan-accent: #FF9966;
            --plan-accent-soft: rgba(255, 153, 102, 0.6);
            --plan-accent-border: rgba(255, 153, 102, 0.35);
            --plan-accent-contrast: #1e1e1e;
            --plan-bg: #121212;
            --plan-surface: #1e1e1e;
            --plan-tile: #2d2d2d;
            --plan-text: #ffffff;
        }

        .modal-content {
            background-color: var(--plan-surface);
            color: var(--plan-text);
            border-radius: 20px;
            border: 1px solid var(--plan-accent-border);
        }

        .modal-header {
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .modal-title {
            color: var(--plan-accent);
        }

        .btn-close { filter: invert(1); }

        .plan-btn-primary {
            background: var(--plan-accent);
            border: 1px solid var(--plan-accent);
            color: var(--plan-accent-contrast);
            font-weight: 700;
        }

            .plan-btn-primary:hover {
                opacity: 0.92;
                color: var(--plan-accent-contrast);
            }

        .plan-btn-outline {
            border: 1px solid var(--plan-accent);
            color: var(--plan-accent);
            background: transparent;
            font-weight: 600;
        }

            .plan-btn-outline:hover {
                background: var(--plan-accent);
                color: var(--plan-accent-contrast);
            }

        .plan-btn-secondary {
            border: 1px solid var(--plan-accent-border);
            color: var(--plan-text);
            background: var(--plan-surface);
        }

        .plan-text-muted {
            color: var(--plan-text);
            opacity: 0.7;
        }

        .plan-day-row {
            margin-bottom: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            padding-bottom: 20px;
            background: var(--plan-bg);
            border-radius: 14px;
            padding: 14px;
        }

        .day-label {
            font-weight: 800;
            color: var(--plan-accent);
            margin-bottom: 12px;
            display: block;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .slot-container {
            display: grid;
            grid-template-columns: 1fr;
            gap: 10px;
        }

        @@media(min-width: 350px) {
            .slot-container {
                grid-template-columns: 1fr 1fr 1fr;
            }
        }

        /* --- UPDATED: GRÖSSERE SLOTS (85px) --- */
        .meal-slot-btn {
            background: var(--plan-surface);
            border: 1px dashed var(--plan-accent-border);
            color: var(--plan-text);
            height: 85px; /* HIER GEÄNDERT */
            border-radius: 12px;
            font-size: 0.9rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 500;
        }

        .meal-slot-btn:hover {
            background: var(--plan-surface);
            color: var(--plan-text);
            border-style: solid;
            border-color: var(--plan-accent);
        }

        .filled-slot {
            background: var(--plan-tile);
            border-left: 4px solid var(--plan-accent);
            border-radius: 8px;
            padding: 0;
            display: flex;
            align-items: center;
            height: 85px; /* HIER GEÄNDERT */
            overflow: hidden;
            position: relative;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            transition: transform 0.1s;
        }

        .filled-slot:active { transform: scale(0.98); }

        .replace-slot {
            outline: 2px dashed var(--plan-accent-soft);
            cursor: pointer;
        }

        .slot-actions {
            display: flex;
            gap: 6px;
            padding-right: 8px;
        }

        .slot-btn {
            border: none;
            background: rgba(0,0,0,0.15);
            color: var(--plan-text);
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .slot-btn.edit-slot-btn {
            color: var(--plan-accent);
            border: 1px solid var(--plan-accent);
            background: rgba(0,0,0,0.25);
        }

        .replace-hint {
            position: absolute;
            right: 10px;
            bottom: 6px;
            font-size: 0.7rem;
            color: rgba(255,255,255,0.6);
        }

        .plan-tools .form-control,
        .shopping-share .form-control {
            background: var(--plan-surface);
            border: 1px solid var(--plan-accent-border);
            color: var(--plan-text);
        }

        .plan-tools .form-label,
        .shopping-share .form-label {
            color: var(--plan-text);
        }

        #searchModal .modal-content {
            background: var(--plan-surface);
            color: var(--plan-text);
            border: 1px solid var(--plan-accent-border);
        }

        #searchModal .btn-close {
            filter: none;
        }

        .mini-img {
            width: 85px; /* HIER GEÄNDERT */
            height: 100%;
            object-fit: cover;
            flex-shrink: 0;
        }

        .mini-content {
            padding: 0 8px;
            flex-grow: 1;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .mini-title {
            font-size: 1rem; /* Lesbarer */
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: var(--plan-text);
            line-height: 1.2;
            margin-bottom: 2px;
        }

        .mini-type {
            font-size: 0.65rem;
            color: var(--plan-text);
            opacity: 0.6;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .delete-slot-btn {
            background: transparent;
            color: #ff5e62;
            border: none;
            width: 30px;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            cursor: pointer;
            flex-shrink: 0;
            border-left: 1px solid rgba(255,255,255,0.1);
        }

        .delete-slot-btn:hover {
            background: rgba(255, 94, 98, 0.2);
        }

        .adding-mode-info {
            background: linear-gradient(135deg, rgba(255, 153, 102, 0.2) 0%, rgba(255, 94, 98, 0.2) 100%);
            border: 1px solid #FF9966;
            padding: 12px;
            border-radius: 12px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .adding-thumb-container {
            width: 60px;
            height: 60px;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.2);
            background: #000;
        }

        .adding-thumb {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    </style>
</head>
<body>
    @Html.AntiForgeryToken()

    <div class="feed-container" id="feedContainer">

     

        @foreach (var item in Model)
        {
          
            bool isVideo = item.Source != null && item.Source.EndsWith(".mp4");
          
            string thumbOrSource = !string.IsNullOrEmpty(item.ThumbnailUrl) ? item.ThumbnailUrl : item.Source;

            <div class="feed-item" data-id="@item.Recipe.Id">
                
                @if (isVideo)
                {
                   
                    <video class="feed-media" playsinline loop muted preload="metadata" poster="@thumbOrSource">
                        <source src="@item.Source" type="video/mp4">
                    </video>
                    
                    <i class="bi bi-play-fill play-icon-overlay"></i>
                    <div class="sound-toggle" onclick="toggleGlobalSound(this)">
                        <i class="bi bi-volume-mute-fill"></i>
                    </div>
                }
                else
                {
                    
                    <img class="feed-media" src="@item.Source" alt="@item.Recipe.Title" loading="lazy">
                }

                <div class="overlay-gradient"></div>
                <i class="bi bi-heart-fill double-tap-heart"></i>

                <div class="info-container">
                    <div class="chef-badge">
                        <span class="chef-icon">🥑</span>
                        <span class="chef-name">@(item?.CreatorName ?? "Delikatessen")</span>
                        <div class="separator"></div>

                        <button class="follow-btn" onclick="toggleFollow(this, '@item?.CreatorId')">
                            <i class="bi bi-person-plus-fill"></i>
                        </button>
                    </div>
                    <h2 class="recipe-title">@item.Recipe.Title</h2>
                    <div class="recipe-meta">⏱️ @item.Recipe.PreperationTime Min</div>
                </div>

                <div class="action-bar">
                    <div class="action-btn heart-btn">
                        <div class="icon-circle"><i class="bi bi-heart-fill"></i></div>
                        <span class="action-label">124</span>
                    </div>
                    
                    <div class="action-btn" onclick="openPlanModal('@item.Recipe.Title', '@thumbOrSource', '@item.Recipe.Id')">
                        <div class="icon-circle"><i class="bi bi-file-earmark-plus"></i></div>
                        <span class="action-label">Planen</span>
                    </div>
                    
                    <div class="action-btn">
                        <a href="@Url.Action("ShowRecipe", "Home", new { area = "WorldMiniApp", id = item.Recipe.Id })" class="add-btn text-decoration-none">
                            <div class="icon-circle"><i class="bi bi-journal-text"></i></div>
                        </a>
                    </div>
                </div>
            </div>
        }

        <div class="feed-item" data-id="99">
            <video class="feed-media" playsinline loop muted preload="metadata" poster="https://images.pexels.com/photos/1256875/pexels-photo-1256875.jpeg">
                <source src="https://videos.pexels.com/video-files/3196238/3196238-uhd_2560_1440_25fps.mp4" type="video/mp4">
            </video>
            <div class="overlay-gradient"></div>
            <i class="bi bi-play-fill play-icon-overlay"></i>
            <div class="sound-toggle" onclick="toggleGlobalSound(this)"><i class="bi bi-volume-mute-fill"></i></div>
            <i class="bi bi-heart-fill double-tap-heart"></i>

            <div class="info-container">
                <div class="chef-badge">
                    <img src="https://ui-avatars.com/api/?name=Chef+Mario&background=random">
                    <span class="chef-name">ChefMario</span>
                    <div class="separator"></div>
                    <button class="follow-btn" onclick="toggleFollow(this, '998')"><i class="bi bi-person-plus-fill"></i></button>
                </div>
                <h2 class="recipe-title">Echte Carbonara 🍝</h2>
                <div class="recipe-meta">Mittel • ⏱️ 20 Min</div>
            </div>

            <div class="action-bar">
                <div class="action-btn heart-btn">
                    <div class="icon-circle"><i class="bi bi-heart-fill"></i></div>
                    <span class="action-label">12k</span>
                </div>
                <div class="action-btn" onclick="openPlanModal('Echte Carbonara 🍝', 'https://images.pexels.com/photos/1256875/pexels-photo-1256875.jpeg', '0')">
                    <div class="icon-circle"><i class="bi bi-file-earmark-plus"></i></div>
                    <span class="action-label">Planen</span>
                </div>
                <div class="action-btn">
                    <div class="icon-circle"><i class="bi bi-journal-text"></i></div>
                    <span class="action-label">Rezept</span>
                </div>
            </div>
        </div>

        <div id="feedContent"></div>
    </div>

    <div class="bottom-nav">
        <a href="@Url.Action("Index", "Home", new { area = "WorldMiniApp" })" class="nav-item text-decoration-none">
            <i class="bi bi-house-door-fill"></i>
        </a>
        <div class="nav-item" onclick="openPlanModal(null, null, null)">
            <i class="bi bi-calendar-week"></i>
        </div>
        <div class="add-btn-wrapper">
            <a href="@Url.Action("Upload", "Home", new { area = "WorldMiniApp" })" class="add-btn text-decoration-none">
                <i class="bi bi-plus"></i>
            </a>
        </div>
        <div class="nav-item" data-bs-toggle="modal" data-bs-target="#searchModal">
            <i class="bi bi-search"></i>
        </div>
        <div class="nav-item" onclick="goToProfile()" style="cursor: pointer;">
            <i class="bi bi-person-fill"></i>
        </div>
    </div>

    <div class="modal fade" id="planModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Wochenplaner</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="plan-tools mb-3">
                        <div class="row g-2">
                            <div class="col-7">
                                <label class="form-label small mb-1">Plan-Name</label>
                                <input id="planTitleInput" type="text" class="form-control form-control-sm" placeholder="Mein Wochenplan" />
                            </div>
                            <div class="col-5">
                                <label class="form-label small mb-1">Personen</label>
                                <input id="planPersonCount" type="number" class="form-control form-control-sm" value="2" min="1" />
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <button type="button" class="btn plan-btn-primary btn-sm flex-grow-1" onclick="saveWeeklyPlan()">Plan speichern</button>
                            <button type="button" class="btn plan-btn-outline btn-sm flex-grow-1" onclick="shareWeeklyPlan()">Plan teilen</button>
                        </div>
                        <button type="button" class="btn plan-btn-secondary btn-sm w-100 mt-2" onclick="clearWeeklyPlanState(true)">Plan leeren</button>
                        <button type="button" class="btn plan-btn-outline btn-sm w-100 mt-2" data-bs-dismiss="modal">Modal schließen</button>
                        <input id="planShareLink" class="form-control form-control-sm mt-2" type="text" readonly placeholder="Plan-Link erscheint hier..." />
                    </div>
                    <div id="addingModeHeader" style="display:none;">
                        <div class="adding-mode-info">
                            <div class="adding-thumb-container">
                                <img id="addingPreviewImg" class="adding-thumb" src="" style="display:none;">
                                <video id="addingPreviewVideo" class="adding-thumb" src="" muted playsinline style="display:none; object-fit:cover;"></video>
                            </div>
                            <div>
                                <small class="plan-text-muted d-block" style="font-size:0.7rem;">Hinzufügen:</small>
                                <span id="addingPreviewTitle" class="fw-bold" style="font-size:0.9rem;"></span>
                            </div>
                        </div>
                        <p class="plan-text-muted small mb-4 text-center">Tippe auf einen freien Slot 👇</p>
                    </div>
                    <div id="viewModeHeader" class="plan-text-muted small mb-4 text-center">
                        Dein aktueller Plan für die Woche
                    </div>
                    <div id="planContainer"></div>
                    <div class="shopping-share mt-3">
                        <label class="form-label small">Einkaufsliste bearbeiten & teilen</label>
                        <button type="button" class="btn plan-btn-secondary btn-sm w-100 mb-2" onclick="prepareShoppingList()">Einkaufsliste laden</button>
                        <textarea id="shoppingListEditor" class="form-control form-control-sm" rows="6" placeholder="Liste laden und bearbeiten..."></textarea>
                        <div class="d-flex gap-2 mt-2">
                            <button type="button" class="btn plan-btn-outline btn-sm flex-grow-1" onclick="generateShareLink()">Link erstellen</button>
                            <button type="button" class="btn plan-btn-primary btn-sm flex-grow-1" onclick="copyShareLink()">Link kopieren</button>
                        </div>
                        <input id="shoppingShareLink" class="form-control form-control-sm mt-2" type="text" readonly placeholder="Hier erscheint der Link..." />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="searchModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title">@T("Suche im Feed", "Search in feed", "Buscar en el feed", "Buscar no feed")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="get" action="@Url.Action("Index", "Feed", new { area = "WorldMiniApp" })">
                    <div class="modal-body">
                        <input type="hidden" name="filter" value="@ViewData["CurrentFilter"]" />
                        <input type="hidden" name="userHash" value="@ViewData["UserHash"]" />
                        <div class="mb-3">
                            <label class="form-label">@T("Suchbegriff", "Search term", "Término de búsqueda", "Termo de pesquisa")</label>
                            <input type="text" name="searchTerm" class="form-control" placeholder="@T("Name oder Keyword", "Name or keyword", "Nombre o palabra clave", "Nome ou palavra-chave")"
                                   value="@ViewData["SearchTerm"]" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@T("Kategorie", "Category", "Categoría", "Categoria")</label>
                            <select name="category" class="form-select">
                                <option value="">@T("Alle Kategorien", "All categories", "Todas las categorías", "Todas as categorias")</option>
                                <option value="appetizer" selected="@(selectedCategory == "appetizer")">@T("Vorspeise", "Appetizer", "Entrada", "Entrada")</option>
                                <option value="main" selected="@(selectedCategory == "main")">@T("Hauptspeise", "Main course", "Plato principal", "Prato principal")</option>
                                <option value="dessert" selected="@(selectedCategory == "dessert")">@T("Dessert", "Dessert", "Postre", "Sobremesa")</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="submit" class="btn plan-btn-primary w-100">@T("Suchen", "Search", "Buscar", "Buscar")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        
        document.addEventListener("DOMContentLoaded", function() {
            // Die ID aus dem Controller holen (wird von Razor hier reingeschrieben)
            const scrollToId = '@ViewData["ScrollToId"]';

            if (scrollToId && scrollToId !== "0" && scrollToId !== "") {
                // Das Video-Element suchen
                const targetElement = document.querySelector(`.feed-item[data-id="${scrollToId}"]`);

                if (targetElement) {
                    // Sofort hinspringen (behavior: 'auto' ist wichtig, damit es nicht langsam hinscrollt)
                    targetElement.scrollIntoView({ behavior: 'auto', block: 'start' });
                }
            }
        });


        function getUserHash() {
            const stored = sessionStorage.getItem("UserToken") || localStorage.getItem("UserToken");
            const fallback = '@ViewData["UserHash"]';
            return stored || fallback;
        }

        function resolvePlanThemeColors(theme) {
            const key = (theme || '').toLowerCase();
            const themeMap = {
                color: {
                    accent: '#2D4F1E',
                    contrast: '#ffffff',
                    bg: '#F8FAF7',
                    surface: '#FFFFFF',
                    tile: '#F0F4EF',
                    text: '#1A1A1A'
                },
                black: {
                    accent: '#ffffff',
                    contrast: '#1e1e1e',
                    bg: '#000000',
                    surface: '#111111',
                    tile: '#1b1b1b',
                    text: '#ffffff'
                },
                white: {
                    accent: '#1A1A1A',
                    contrast: '#ffffff',
                    bg: '#ffffff',
                    surface: '#f7f7f7',
                    tile: '#f0f0f0',
                    text: '#1A1A1A'
                },
                rose: {
                    accent: '#FFB6C1',
                    contrast: '#852D3E',
                    bg: '#FFF5F7',
                    surface: '#FFFFFF',
                    tile: '#FEE2E7',
                    text: '#852D3E'
                },
                lavender: {
                    accent: '#A78BFA',
                    contrast: '#4B3D8A',
                    bg: '#F3F0FF',
                    surface: '#FFFFFF',
                    tile: '#EBE4FF',
                    text: '#4B3D8A'
                }
            };

            return themeMap[key] || {
                accent: '#FF9966',
                contrast: '#1e1e1e',
                bg: '#121212',
                surface: '#1e1e1e',
                tile: '#2d2d2d',
                text: '#ffffff'
            };
        }

        function applyPlanThemeFromProfile() {
            const theme = localStorage.getItem('profile_theme');
            const colors = resolvePlanThemeColors(theme);
            const root = document.documentElement;
            root.style.setProperty('--plan-accent', colors.accent);
            root.style.setProperty('--plan-accent-soft', `${colors.accent}99`);
            root.style.setProperty('--plan-accent-border', `${colors.accent}59`);
            root.style.setProperty('--plan-accent-contrast', colors.contrast);
            root.style.setProperty('--plan-bg', colors.bg);
            root.style.setProperty('--plan-surface', colors.surface);
            root.style.setProperty('--plan-tile', colors.tile);
            root.style.setProperty('--plan-text', colors.text);
        }

        function resolvePlanThemeColors(theme) {
            const key = (theme || '').toLowerCase();
            const themeMap = {
                color: { accent: '#2D4F1E', contrast: '#ffffff' },
                black: { accent: '#ffffff', contrast: '#1e1e1e' },
                white: { accent: '#1A1A1A', contrast: '#ffffff' },
                rose: { accent: '#FFB6C1', contrast: '#1e1e1e' },
                lavender: { accent: '#A78BFA', contrast: '#1e1e1e' }
            };

            return themeMap[key] || { accent: '#FF9966', contrast: '#1e1e1e' };
        }

        function applyPlanThemeFromProfile() {
            const theme = localStorage.getItem('profile_theme');
            const colors = resolvePlanThemeColors(theme);
            const root = document.documentElement;
            root.style.setProperty('--plan-accent', colors.accent);
            root.style.setProperty('--plan-accent-soft', `${colors.accent}99`);
            root.style.setProperty('--plan-accent-border', `${colors.accent}59`);
            root.style.setProperty('--plan-accent-contrast', colors.contrast);
        }

        function goToProfile() {
            const userHash = getUserHash();
            if (userHash) {
                window.location.href = '/WorldMiniApp/Feed/MyProfile?userHash=' + userHash;
            } else {
                alert("Bitte erst einloggen!");
            }
        }

        /* === JS LOGIK === */
        let isGlobalMuted = true;
        let hasUserInteracted = false;
        let weeklyPlanData = {};
        let pendingRecipe = null;
        let editingSlotKey = null;
        let saveTimer = null;

        // --- TOGGLE FOLLOW FUNCTION ---
        async function toggleFollow(btn, creatorId) {
            if(event) event.stopPropagation();
            const userHash = getUserHash();
            if(!userHash) { console.warn("Nicht eingeloggt!"); return; }

            const icon = btn.querySelector('i');
            const isFollowing = icon.classList.contains('bi-check-lg');

            if (isFollowing) {
                icon.classList.remove('bi-check-lg');
                icon.classList.add('bi-person-plus-fill');
                btn.style.color = "white";
            } else {
                icon.classList.remove('bi-person-plus-fill');
                icon.classList.add('bi-check-lg');
                btn.style.color = "#4cd137";
            }

            const formData = new FormData();
            formData.append('userHash', userHash);
            formData.append('creatorId', creatorId);
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (tokenInput) formData.append('__RequestVerificationToken', tokenInput.value);

            try {
                const response = await fetch('/WorldMiniApp/Feed/ToggleFollow', { method: 'POST', body: formData });
            } catch (error) { console.error("Netzwerkfehler:", error); }
        }

        // --- LIKE FUNCTION ---
        async function sendLikeToBackend(recipeId) {
            const userHash = getUserHash();
            if(!userHash) return;
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : null;
            const formData = new FormData();
            formData.append('userHash', userHash);
            formData.append('recipeId', recipeId);
            if (token) formData.append('__RequestVerificationToken', token);
            try { await fetch('/WorldMiniApp/Feed/ToggleLike', { method: 'POST', body: formData }); } catch (error) { console.error(error); }
        }

        // --- WOCHENPLAN LOGIK ---
        const days = ["Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag", "Samstag", "Sonntag"];
        const slots = ["Vorspeise", "Hauptspeise", "Dessert"];

        function updatePlanModeHeader() {
            if (pendingRecipe) {
                document.getElementById('addingModeHeader').style.display = 'block';
                document.getElementById('viewModeHeader').style.display = 'none';
            } else {
                document.getElementById('addingModeHeader').style.display = 'none';
                document.getElementById('viewModeHeader').style.display = 'block';
            }
        }

        function openPlanModal(title, url, recipeId) {
            const modalEl = document.getElementById('planModal');
            const modal = new bootstrap.Modal(modalEl);
            const imgEl = document.getElementById('addingPreviewImg');
            const vidEl = document.getElementById('addingPreviewVideo');
            const titleEl = document.getElementById('addingPreviewTitle');

            if (title && url) {
                pendingRecipe = { title: title, img: url, recipeId: recipeId };
                if (editingSlotKey) {
                    weeklyPlanData[editingSlotKey] = pendingRecipe;
                    editingSlotKey = null;
                    pendingRecipe = null;
                    scheduleDraftSave();
                }
                updatePlanModeHeader();
                titleEl.innerText = title;

                // CHECK: Fallback für Videos, falls noch kein Thumbnail existiert
                if (url.endsWith('.mp4')) {
                    imgEl.style.display = 'none';
                    vidEl.style.display = 'block';
                    vidEl.src = url + "#t=0.1";
                } else {
                    vidEl.style.display = 'none';
                    imgEl.style.display = 'block';
                    imgEl.src = url;
                }
            } else {
                pendingRecipe = null;
                updatePlanModeHeader();
            }
            renderPlan();
            modal.show();
        }

        function renderPlan() {
            const container = document.getElementById('planContainer');
            container.innerHTML = '';

            days.forEach((day, dayIndex) => {
                let dayHtml = `<div class="plan-day-row"><span class="day-label">${day}</span><div class="slot-container">`;

                slots.forEach((slotName, slotIndex) => {
                    const key = `${dayIndex}-${slotIndex}`;
                    const item = weeklyPlanData[key];

                    if (item) {
                        let mediaHtml = '';
                        // Fallback: Wenn es immer noch ein Video ist (kein Thumbnail), zeige Video
                        if (item.img.endsWith('.mp4')) {
                            mediaHtml = `<video src="${item.img}#t=0.1" class="mini-img" muted playsinline preload="metadata"></video>`;
                        } else {
                            // Normalfall: Thumbnail anzeigen
                            mediaHtml = `<img src="${item.img}" class="mini-img">`;
                        }

                        const replaceMode = pendingRecipe ? 'replace-slot' : '';
                        const replaceAction = pendingRecipe ? `onclick="addToSlot('${key}')"` : '';
                        const replaceHint = pendingRecipe ? '<div class="replace-hint">Antippen zum Ersetzen</div>' : '';
                        dayHtml += `
                            <div class="filled-slot ${replaceMode}" ${replaceAction}>
                                ${mediaHtml}
                                <div class="mini-content">
                                    <div class="mini-title">${item.title}</div>
                                    <div class="mini-type">${slotName}</div>
                                </div>
                                ${replaceHint}
                                <div class="slot-actions">
                                    <button class="slot-btn edit-slot-btn" onclick="startEditSlot('${key}')"><i class="bi bi-pencil"></i></button>
                                    <button class="slot-btn delete-slot-btn" onclick="removeFromSlot('${key}')"><i class="bi bi-x-lg"></i></button>
                                </div>
                            </div>`;
                    } else {
                        const action = pendingRecipe ? `onclick="addToSlot('${key}')"` : '';
                        const opacity = pendingRecipe ? '1' : '0.4';
                        dayHtml += `<div class="meal-slot-btn" style="opacity:${opacity}" ${action}>${slotName}</div>`;
                    }
                });
                dayHtml += `</div></div>`;
                container.innerHTML += dayHtml;
            });
        }

        function addToSlot(key) {
            if (!pendingRecipe) return;
            weeklyPlanData[key] = pendingRecipe;
            renderPlan();
            scheduleDraftSave();
        }
        function removeFromSlot(key) {
            delete weeklyPlanData[key];
            renderPlan();
            scheduleDraftSave();
        }

        function startEditSlot(key) {
            editingSlotKey = key;
            const modalEl = document.getElementById('planModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) {
                modalInstance.hide();
            }
            alert('Wähle jetzt im Feed ein Rezept zum Ersetzen.');
        }

        function getPlanRecipeIds(payload) {
            return payload
                .map(item => item.RecipeId)
                .filter(id => Number.isFinite(id));
        }

        function buildMealPlanPayload() {
            const payload = [];
            Object.keys(weeklyPlanData).forEach(key => {
                const item = weeklyPlanData[key];
                if (!item || !item.recipeId || item.recipeId === '0') return;
                const [dayIndex, slotIndex] = key.split('-').map(Number);
                payload.push({
                    DayIndex: dayIndex + 1,
                    SlotIndex: slotIndex,
                    RecipeId: parseInt(item.recipeId, 10),
                    Title: item.title || '',
                    ImagePath: item.img || ''
                });
            });
            return payload;
        }

        function clearWeeklyPlanState(keepPendingRecipe = false) {
            weeklyPlanData = {};
            if (!keepPendingRecipe) {
                pendingRecipe = null;
                editingSlotKey = null;
            }
            localStorage.removeItem(getDraftStorageKey());
            const linkInput = document.getElementById('planShareLink');
            if (linkInput) {
                linkInput.value = '';
            }
            updatePlanModeHeader();
            renderPlan();
        }

        function saveWeeklyPlan() {
            const userHash = getUserHash();
            if (!userHash) {
                alert("Bitte erst einloggen!");
                return;
            }
            const payload = buildMealPlanPayload();
            if (payload.length === 0) {
                alert("Bitte mindestens ein Rezept auswählen.");
                return;
            }
            const titleInput = document.getElementById('planTitleInput');
            const personCountInput = document.getElementById('planPersonCount');
            const title = titleInput.value.trim() || "Mein Wochenplan";
            const personCount = parseInt(personCountInput.value, 10) || 1;
            const encodedData = encodeURIComponent(JSON.stringify(payload));
            clearWeeklyPlanState();
            window.location.href = `/WorldMiniApp/Home/SaveMealPlan?mealPlanJson=${encodedData}&personCount=${personCount}&userHash=${userHash}&title=${encodeURIComponent(title)}`;
        }

        async function shareWeeklyPlan() {
            const payload = buildMealPlanPayload();
            if (payload.length === 0) {
                alert("Bitte mindestens ein Rezept auswählen.");
                return;
            }
            const titleInput = document.getElementById('planTitleInput');
            const personCountInput = document.getElementById('planPersonCount');
            const title = titleInput.value.trim() || "Mein Wochenplan";
            const personCount = parseInt(personCountInput.value, 10) || 1;

            try {
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : null;
                const response = await fetch('/WorldMiniApp/Home/SaveSharedMealPlan', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        ...(token ? { 'RequestVerificationToken': token } : {})
                    },
                    body: JSON.stringify({
                        mealPlanJson: JSON.stringify(payload),
                        personCount: personCount,
                        title: title,
                        userHash: getUserHash()
                    })
                });

                if (!response.ok) {
                    const errorText = await response.text();
                    alert(`Plan konnte nicht geteilt werden. ${errorText}`);
                    return;
                }

                const data = await response.json();
                const linkInput = document.getElementById('planShareLink');
                linkInput.value = data.shareUrl || '';

                if (!data.shareUrl) {
                    alert("Teilen fehlgeschlagen: Kein Link erhalten.");
                    return;
                }

                try {
                    if (navigator.share) {
                        await navigator.share({ title: title, url: data.shareUrl });
                    } else if (navigator.clipboard) {
                        await navigator.clipboard.writeText(data.shareUrl);
                        alert("Link kopiert!");
                    }
                } catch (shareError) {
                    console.warn("Teilen nicht verfügbar:", shareError);
                }
            } catch (error) {
                console.error("Teilen fehlgeschlagen:", error);
                alert("Plan konnte nicht geteilt werden.");
            }
        }

        function getDraftStorageKey() {
            const userHash = getUserHash();
            return `worldminiapp_feed_plan_${userHash || 'guest'}`;
        }

        function scheduleDraftSave() {
            if (saveTimer) {
                clearTimeout(saveTimer);
            }
            saveTimer = setTimeout(() => {
                saveDraft();
            }, 600);
        }

        async function saveDraft() {
            const payload = buildMealPlanPayload();
            const personCount = parseInt(document.getElementById('planPersonCount').value, 10) || 1;
            const titleInput = document.getElementById('planTitleInput');
            const title = titleInput.value.trim() || "Feed-Plan";

            localStorage.setItem(getDraftStorageKey(), JSON.stringify({
                mealPlanJson: JSON.stringify(payload),
                personCount: personCount,
                title: title
            }));

            const userHash = getUserHash();
            if (!userHash) return;

            await fetch('/WorldMiniApp/Home/SaveFeedMealPlanDraft', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    mealPlanJson: JSON.stringify(payload),
                    personCount: personCount,
                    title: title,
                    userHash: userHash
                })
            });
        }

        function applyDraftPayload(payload, personCount, title) {
            if (title) {
                document.getElementById('planTitleInput').value = title;
            }
            if (personCount) {
                document.getElementById('planPersonCount').value = personCount;
            }
            weeklyPlanData = {};
            payload.forEach(item => {
                const dayIndex = (item.DayIndex || 1) - 1;
                const slotIndex = item.SlotIndex ?? 0;
                const key = `${dayIndex}-${slotIndex}`;
                weeklyPlanData[key] = {
                    title: item.Title || item.title || '',
                    img: item.ImagePath || item.img || '',
                    recipeId: item.RecipeId || item.recipeId
                };
            });
            renderPlan();
        }

        async function loadDraft() {
            const stored = localStorage.getItem(getDraftStorageKey());
            if (stored) {
                try {
                    const parsed = JSON.parse(stored);
                    const payload = parsed.mealPlanJson ? JSON.parse(parsed.mealPlanJson) : [];
                    applyDraftPayload(payload, parsed.personCount, parsed.title);
                    return;
                } catch (err) {
                    console.warn("Draft konnte nicht geladen werden.", err);
                }
            }

            const userHash = getUserHash();
            if (!userHash) return;

            const response = await fetch(`/WorldMiniApp/Home/GetFeedMealPlanDraft?userHash=${encodeURIComponent(userHash)}&title=${encodeURIComponent(document.getElementById('planTitleInput').value || 'Feed-Plan')}`);
            if (!response.ok) return;
            const data = await response.json();
            if (!data.mealPlanJson) return;

            const payload = JSON.parse(data.mealPlanJson || '[]');
            applyDraftPayload(payload, data.personCount, data.title);
        }

        async function prepareShoppingList() {
            const payload = buildMealPlanPayload();
            const recipeIds = getPlanRecipeIds(payload);
            if (recipeIds.length === 0) {
                alert("Bitte mindestens ein Rezept auswählen.");
                return;
            }
            const personCount = parseInt(document.getElementById('planPersonCount').value, 10) || 1;
            const params = new URLSearchParams();
            recipeIds.forEach(id => params.append('recipeIds', id));
            params.append('personCount', personCount);
            const response = await fetch(`/WorldMiniApp/Home/GetShoppingListText?${params.toString()}`);
            if (!response.ok) {
                alert("Einkaufsliste konnte nicht geladen werden.");
                return;
            }
            const data = await response.json();
            document.getElementById('shoppingListEditor').value = data.text || '';
        }

        function generateShareLink() {
            const text = document.getElementById('shoppingListEditor').value.trim();
            if (!text) {
                alert("Bitte zuerst eine Einkaufsliste laden oder einfügen.");
                return;
            }
            const shareLink = `${window.location.origin}/WorldMiniApp/Home/ShareShoppingList?list=${encodeURIComponent(text)}`;
            document.getElementById('shoppingShareLink').value = shareLink;
        }

        async function copyShareLink() {
            const linkInput = document.getElementById('shoppingShareLink');
            if (!linkInput.value) {
                generateShareLink();
            }
            if (linkInput.value) {
                await navigator.clipboard.writeText(linkInput.value);
                alert("Link kopiert!");
            }
        }

        /* === FEED BASIS LOGIK === */
        function unlockAudio() {
            if (hasUserInteracted) return;
            hasUserInteracted = true;
            isGlobalMuted = false;
            const hint = document.getElementById('firstInteractionHint');
            if(hint) hint.style.display = 'none';
            document.querySelectorAll('video').forEach(v => { v.muted = false; });
            document.querySelectorAll('.sound-toggle').forEach(btn => updateSoundIcon(btn.closest('.feed-item'), false));
            document.removeEventListener('click', unlockAudio);
        }
        document.addEventListener('click', unlockAudio);
        document.addEventListener('DOMContentLoaded', applyPlanThemeFromProfile);
        document.addEventListener('DOMContentLoaded', loadDraft);

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                const video = entry.target.querySelector('video');
                const container = entry.target;
                if (video) {
                    if(entry.isIntersecting) {
                        video.muted = isGlobalMuted;
                        updateSoundIcon(container, isGlobalMuted);
                        video.play().then(() => container.classList.remove('paused')).catch(e=>{});
                    } else { video.pause(); }
                }
            });
        }, { threshold: 0.6 });
        document.querySelectorAll('.feed-item').forEach(item => observer.observe(item));

        function toggleGlobalSound(btn) {
            hasUserInteracted = true;
            const hint = document.getElementById('firstInteractionHint');
            if(hint) hint.style.display = 'none';
            isGlobalMuted = !isGlobalMuted;
            const container = btn.closest('.feed-item');
            const video = container.querySelector('video');
            if(video) video.muted = isGlobalMuted;
            updateSoundIcon(container, isGlobalMuted);
        }

        function updateSoundIcon(container, isMuted) {
            const icon = container.querySelector('.sound-toggle i');
            if (!icon) return;
            if(isMuted) { icon.classList.remove('bi-volume-up-fill'); icon.classList.add('bi-volume-mute-fill'); }
            else { icon.classList.remove('bi-volume-mute-fill'); icon.classList.add('bi-volume-up-fill'); }
        }

        document.querySelectorAll('.feed-item').forEach(item => {
            let lastTap = 0; let tapTimeout;
            item.addEventListener('click', function(e) {
                if(e.target.closest('.action-btn') || e.target.closest('.sound-toggle') || e.target.closest('.chef-badge') || e.target.closest('.modal')) return;
                const currentTime = new Date().getTime();
                const tapLength = currentTime - lastTap;
                if (tapLength < 300 && tapLength > 0) {
                    clearTimeout(tapTimeout); triggerLike(this); lastTap = 0;
                } else {
                    lastTap = currentTime; tapTimeout = setTimeout(() => { togglePlayPause(this); }, 300);
                }
            });
        });

        function togglePlayPause(container) {
            const video = container.querySelector('video');
            if (video.paused) { video.play(); container.classList.remove('paused'); }
            else { video.pause(); container.classList.add('paused'); }
        }

        function triggerLike(container) {
            const recipeId = container.dataset.id;
            if(recipeId) sendLikeToBackend(recipeId);
            const heartBtn = container.querySelector('.heart-btn');
            const bigHeart = container.querySelector('.double-tap-heart');
            if(heartBtn) {
                if (heartBtn.classList.contains('liked')) { heartBtn.classList.remove('liked'); }
                else {
                    heartBtn.classList.add('liked');
                    if(bigHeart) {
                        bigHeart.style.display = 'block'; bigHeart.classList.remove('animate'); void bigHeart.offsetWidth;
                        bigHeart.classList.add('animate'); setTimeout(() => { bigHeart.classList.remove('animate'); }, 800);
                    }
                }
            }
        }

        document.querySelectorAll('.heart-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                const container = this.closest('.feed-item');
                const recipeId = container.dataset.id;
                if(recipeId) sendLikeToBackend(recipeId);
                this.classList.toggle('liked');
            });
        });
    </script>
</body>
</html>
