        function getAvatarColor(name) {
            let h = 0;
            for (let i = 0; i < (name || '').length; i++) h = ((h << 5) - h + name.charCodeAt(i)) | 0;
            return _avatarColors[Math.abs(h) % _avatarColors.length];
