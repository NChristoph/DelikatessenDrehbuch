        let nutritionTimer = null;

        function scheduleNutritionUpdate() {
            if (nutritionTimer) clearTimeout(nutritionTimer);
            nutritionTimer = setTimeout(() => {
                updatePlanNutritionTotals();
                updateDayNutritionTotals();
            }, 400);
        }

        function formatNutritionValue(value, decimals) {
            if (!Number.isFinite(value)) return 'â€”';
            return value.toLocaleString('de-DE', {
                minimumFractionDigits: decimals,
                maximumFractionDigits: decimals
            });
        }

        function setNutritionTotals(data) {
            const calories = data?.calories;
            const protein = data?.protein;
            const fat = data?.fat;
            const carbs = data?.carbohydrates;

            // v1-macro-kcal — big number with <span>kcal</span>
            const kcalEl = document.getElementById('planNutritionCalories');
            if (kcalEl) {
                const val = Number.isFinite(calories) ? Math.round(calories).toLocaleString('de-DE') : '\u2014';
                kcalEl.innerHTML = `${val} <span>kcal</span>`;
            }

            // v1-macro bars (protein / fat / carbs)
            const p = Number.isFinite(protein) ? protein : 0;
            const f = Number.isFinite(fat) ? fat : 0;
            const c = Number.isFinite(carbs) ? carbs : 0;
            const total = p + f + c;
            const pPct = total > 0 ? Math.round(p / total * 100) : 0;
            const fPct = total > 0 ? Math.round(f / total * 100) : 0;
            const cPct = total > 0 ? 100 - pPct - fPct : 0;

            const setBar = (id, pct, val) => {
                const fill = document.getElementById(id + 'Fill');
                const valEl = document.getElementById(id + 'Val');
                if (fill) fill.style.width = pct + '%';
                if (valEl) valEl.textContent = Math.round(val) + 'g';
            };
            setBar('macroBarProtein', pPct, p);
            setBar('macroBarFat', fPct, f);
            setBar('macroBarCarbs', cPct, c);

            // Goal ring (weekly target, default 14000 kcal = 2000/day × 7)
            const goalInput = document.getElementById('kcalGoalInput');
            const dailyGoal = parseInt(goalInput?.value || '2000', 10) || 2000;
            const weeklyGoal = dailyGoal * 7;
            const goalPct = Number.isFinite(calories) ? Math.min(Math.round(calories / weeklyGoal * 100), 100) : 0;
            const ringFill = document.getElementById('macroGoalRingFill');
            if (ringFill) ringFill.setAttribute('stroke-dasharray', `${(goalPct / 100) * 150.8} 150.8`);
            const goalPctEl = document.getElementById('macroGoalPct');
            if (goalPctEl) goalPctEl.textContent = goalPct + '%';

            // Day-nutrition donut still uses old updateMacroBar (with prefix)
            updateMacroBar(protein, fat, carbs, calories);
            updateHeroChips();
        }

        function updateMacroBar(protein, fat, carbs, calories, prefix, suffix) {
            prefix = prefix || '';
            suffix = suffix || '';
            const C = 314.16; // 2 * Math.PI * 50
            const p = Number.isFinite(protein) ? protein : 0;
            const f = Number.isFinite(fat) ? fat : 0;
            const c = Number.isFinite(carbs) ? carbs : 0;
            const total = p + f + c;
            const pPct = total > 0 ? Math.round(p / total * 100) : 0;
            const fPct = total > 0 ? Math.round(f / total * 100) : 0;
            const cPct = total > 0 ? 100 - pPct - fPct : 0;
            const el = (id) => document.getElementById(prefix ? prefix + id.charAt(0).toUpperCase() + id.slice(1) + suffix : id + suffix);
            const txt = (id, v) => { const e = el(id); if (e) e.textContent = v; };

            // SVG donut rings â€” stacked segments with offsets
            const pLen = C * pPct / 100;
            const fLen = C * fPct / 100;
            const cLen = C * cPct / 100;
            const gap = total > 0 ? 4 : 0; // small gap between segments

            const ringP = el('macroRingProtein');
            const ringF = el('macroRingFat');
            const ringC = el('macroRingCarbs');

            if (ringP) {
                ringP.setAttribute('stroke-dasharray', `${Math.max(0, pLen - gap)} ${C}`);
                ringP.setAttribute('stroke-dashoffset', '0');
            }
            if (ringF) {
                ringF.setAttribute('stroke-dasharray', `${Math.max(0, fLen - gap)} ${C}`);
                ringF.setAttribute('stroke-dashoffset', `${-pLen}`);
            }
            if (ringC) {
                ringC.setAttribute('stroke-dasharray', `${Math.max(0, cLen - gap)} ${C}`);
                ringC.setAttribute('stroke-dashoffset', `${-(pLen + fLen)}`);
            }

            // kcal center text + traffic light
            const kcalEl = el('macroDonutKcal');
            if (kcalEl) {
                kcalEl.textContent = Number.isFinite(calories) ? Math.round(calories) : 'â€”';
                applyKcalTrafficLight(kcalEl, calories, prefix === 'day');
            }

            // legend percentages
            txt('macroBarProteinPct', pPct);
            txt('macroBarFatPct', fPct);
            txt('macroBarCarbsPct', cPct);
        }

        function getKcalGoal() {
            const v = parseInt(localStorage.getItem('kcalGoal') || '', 10);
            return v > 0 ? v : 0;
        }

        function applyKcalTrafficLight(kcalEl, calories, isDay) {
            kcalEl.classList.remove('kcal-green', 'kcal-yellow', 'kcal-red');
            const goal = getKcalGoal();
            if (!goal || !Number.isFinite(calories) || calories <= 0) return;
            const compare = isDay ? calories : calories / 7;
            const ratio = compare / goal;
            if (ratio <= 0.9) kcalEl.classList.add('kcal-green');
            else if (ratio <= 1.1) kcalEl.classList.add('kcal-yellow');
            else kcalEl.classList.add('kcal-red');
        }

        function getTrafficClass(kcal) {
            const goal = getKcalGoal();
            if (!goal || kcal <= 0) return '';
            const ratio = kcal / goal;
            if (ratio <= 0.9) return 'kcal-green';
            if (ratio <= 1.1) return 'kcal-yellow';
            return 'kcal-red';
        }

        const dayLabels = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'];
        const _dayKcalCache = new Array(7).fill(0);

        function renderSparkline() {
            const wrap = document.getElementById('sparklineWrap');
            const svg = document.getElementById('sparklineSvg');
            if (!wrap || !svg) return;

            const vals = _dayKcalCache;
            const hasData = vals.some(v => v > 0);
            wrap.style.display = hasData ? '' : 'none';
            if (!hasData) return;

            const goal = getKcalGoal();
            const W = 200, H = 56, padX = 14, padTop = 6, padBot = 14;
            const plotH = H - padTop - padBot;
            const maxVal = Math.max(...vals, goal || 0, 100);
            const stepX = vals.length > 1 ? (W - 2 * padX) / (vals.length - 1) : 0;

            const pts = vals.map((v, i) => ({
                x: padX + i * stepX,
                y: padTop + plotH - (v / maxVal) * plotH
            }));

            const polyline = pts.map(p => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
            const fillPoly = `${padX},${padTop + plotH} ${polyline} ${pts[pts.length - 1].x.toFixed(1)},${padTop + plotH}`;

            let html = `<polygon class="sparkline-fill" points="${fillPoly}" />`;
            html += `<polyline class="sparkline-line" points="${polyline}" />`;

            // goal line
            if (goal > 0) {
                const gy = padTop + plotH - (goal / maxVal) * plotH;
                html += `<line class="sparkline-goal" x1="${padX}" y1="${gy.toFixed(1)}" x2="${W - padX}" y2="${gy.toFixed(1)}" />`;
            }

            // dots + labels
            pts.forEach((p, i) => {
                const tc = getTrafficClass(vals[i]);
                html += `<circle class="sparkline-dot${tc ? ' ' + tc : ''}" cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="3" />`;
                html += `<text class="sparkline-label" x="${p.x.toFixed(1)}" y="${H - 2}">${dayLabels[i] || ''}</text>`;
            });

            svg.innerHTML = html;
        }

        // === Quick-Peek Bottom Sheet ===
        let quickPeekCache = {};
        let cachedLanguage = document.cookie.match(/deli-lang=([^;]+)/)?.[1] || 'de';

        // Cache leeren wenn Sprache gewechselt wird
        function clearQuickPeekCacheIfLanguageChanged() {
            const currentLang = document.cookie.match(/deli-lang=([^;]+)/)?.[1] || 'de';
            if (currentLang !== cachedLanguage) {
                quickPeekCache = {};
                cachedLanguage = currentLang;
            }
        }

        function openQuickPeek(recipeId) {
            const sheet = document.getElementById('quickPeekSheet');
            const backdrop = document.getElementById('quickPeekBackdrop');
            if (!sheet || !backdrop || !recipeId) return;

            // Cache leeren falls Sprache gewechselt wurde
            clearQuickPeekCacheIfLanguageChanged();

            sheet.classList.add('is-open');
            backdrop.classList.add('is-open');

            const titleEl = document.getElementById('quickPeekTitle');
            const metaEl = document.getElementById('quickPeekMeta');
            const ingredientsEl = document.getElementById('quickPeekIngredients');

            if (quickPeekCache[recipeId]) {
                renderQuickPeekData(quickPeekCache[recipeId], titleEl, metaEl, ingredientsEl);
                return;
            }

            if (titleEl) titleEl.textContent = '@SharedLocalizer["Feed.Loading"]';
            if (metaEl) metaEl.textContent = '';
            if (ingredientsEl) ingredientsEl.innerHTML = '';

            fetch(`/WorldMiniApp/Home/GetRecipePreview?id=${recipeId}`)
                .then(r => r.ok ? r.json() : Promise.reject())
                .then(data => {
                    quickPeekCache[recipeId] = data;
                    renderQuickPeekData(data, titleEl, metaEl, ingredientsEl);
                })
                .catch(() => {
                    if (titleEl) titleEl.textContent = '@SharedLocalizer["Feed.ErrorLoading"]';
                });
        }

        function renderQuickPeekData(data, titleEl, metaEl, ingredientsEl) {
            if (titleEl) titleEl.textContent = data.title || '';
            const parts = [];
            if (data.category) parts.push(data.category);
            if (data.prepTime) parts.push(`${data.prepTime} Min`);
            if (data.personCount) parts.push(`${data.personCount} @SharedLocalizer["Feed.Persons"]`);
            if (metaEl) metaEl.textContent = parts.join(' · ');
            if (ingredientsEl) {
                ingredientsEl.innerHTML = (data.ingredients || []).map(ing => {
                    const qtyStr = ing.quantity ? `${ing.quantity} ${ing.unit || ''}`.trim() : '';
                    if (qtyStr) {
                        return `<span class="quick-peek-chip"><span class="chip-qty">${escapeHtml(qtyStr)}</span>${escapeHtml(ing.name)}</span>`;
                    }
                    return `<span class="quick-peek-chip">${escapeHtml(ing.name)}</span>`;
                }).join('');
            }
            renderQuickPeekMacros(data);
        }

        function renderQuickPeekMacros(data) {
            const wrap = document.getElementById('quickPeekMacros');
            if (!wrap) return;
            const p = Number(data.protein) || 0;
            const f = Number(data.fat) || 0;
            const c = Number(data.carbs) || 0;
            const cal = Number(data.calories) || 0;
            if (p + f + c === 0) { wrap.style.display = 'none'; return; }
            wrap.style.display = '';
            const C = 314.16;
            const total = p + f + c;
            const pPct = total > 0 ? Math.round(p / total * 100) : 0;
            const fPct = total > 0 ? Math.round(f / total * 100) : 0;
            const cPct = total > 0 ? 100 - pPct - fPct : 0;
            const pLen = C * pPct / 100;
            const fLen = C * fPct / 100;
            const cLen = C * cPct / 100;
            const gap = total > 0 ? 4 : 0;
            const ringP = document.getElementById('qpRingProtein');
            const ringF = document.getElementById('qpRingFat');
            const ringC = document.getElementById('qpRingCarbs');
            if (ringP) { ringP.setAttribute('stroke-dasharray', `${Math.max(0, pLen - gap)} ${C}`); ringP.setAttribute('stroke-dashoffset', '0'); }
            if (ringF) { ringF.setAttribute('stroke-dasharray', `${Math.max(0, fLen - gap)} ${C}`); ringF.setAttribute('stroke-dashoffset', `${-pLen}`); }
            if (ringC) { ringC.setAttribute('stroke-dasharray', `${Math.max(0, cLen - gap)} ${C}`); ringC.setAttribute('stroke-dashoffset', `${-(pLen + fLen)}`); }
            const kcalEl = document.getElementById('qpDonutKcal');
            if (kcalEl) kcalEl.textContent = Math.round(cal);
            const txt = (id, v) => { const e = document.getElementById(id); if (e) e.textContent = v; };
            txt('qpProteinPct', pPct);
            txt('qpFatPct', fPct);
            txt('qpCarbsPct', cPct);
        }

        function closeQuickPeek() {
            document.getElementById('quickPeekSheet')?.classList.remove('is-open');
            document.getElementById('quickPeekBackdrop')?.classList.remove('is-open');
        }

        // Backdrop click closes
        document.getElementById('quickPeekBackdrop')?.addEventListener('click', closeQuickPeek);

        function setDayNutritionTotals(dayIndex, data) {
            const caloriesEl = document.getElementById(`dayNutritionCalories-${dayIndex}`);
            const proteinEl = document.getElementById(`dayNutritionProtein-${dayIndex}`);
            const fatEl = document.getElementById(`dayNutritionFat-${dayIndex}`);
            const carbsEl = document.getElementById(`dayNutritionCarbs-${dayIndex}`);
            const sugarEl = document.getElementById(`dayNutritionSugar-${dayIndex}`);
            const fiberEl = document.getElementById(`dayNutritionFiber-${dayIndex}`);
            const saturatedEl = document.getElementById(`dayNutritionSaturatedFat-${dayIndex}`);
            const saltEl = document.getElementById(`dayNutritionSalt-${dayIndex}`);

            const ppCaloriesEl = document.getElementById(`dayNutritionPerPortionCalories-${dayIndex}`);
            const ppProteinEl = document.getElementById(`dayNutritionPerPortionProtein-${dayIndex}`);
            const ppFatEl = document.getElementById(`dayNutritionPerPortionFat-${dayIndex}`);
            const ppCarbsEl = document.getElementById(`dayNutritionPerPortionCarbs-${dayIndex}`);
            const ppSugarEl = document.getElementById(`dayNutritionPerPortionSugar-${dayIndex}`);
            const ppFiberEl = document.getElementById(`dayNutritionPerPortionFiber-${dayIndex}`);
            const ppSaturatedEl = document.getElementById(`dayNutritionPerPortionSaturatedFat-${dayIndex}`);
            const ppSaltEl = document.getElementById(`dayNutritionPerPortionSalt-${dayIndex}`);

            const calories = data?.calories;
            const protein = data?.protein;
            const fat = data?.fat;
            const carbs = data?.carbohydrates;
            const sugar = data?.sugar;
            const fiber = data?.fiber;
            const saturatedFat = data?.saturatedFat;
            const salt = data?.salt;

            if (caloriesEl) caloriesEl.textContent = formatNutritionValue(calories, 0);
            if (proteinEl) proteinEl.textContent = formatNutritionValue(protein, 1);
            if (fatEl) fatEl.textContent = formatNutritionValue(fat, 1);
            if (carbsEl) carbsEl.textContent = formatNutritionValue(carbs, 1);
            if (sugarEl) sugarEl.textContent = formatNutritionValue(sugar, 1);
            if (fiberEl) fiberEl.textContent = formatNutritionValue(fiber, 1);
            if (saturatedEl) saturatedEl.textContent = formatNutritionValue(saturatedFat, 1);
            if (saltEl) saltEl.textContent = formatNutritionValue(salt, 1);

            const personCount = Math.max(1, parseInt(document.getElementById('planPersonCount')?.value || '1', 10) || 1);
            const perPortion = (v) => (Number.isFinite(v) ? v / personCount : v);

            if (ppCaloriesEl) ppCaloriesEl.textContent = formatNutritionValue(perPortion(calories), 0);
            if (ppProteinEl) ppProteinEl.textContent = formatNutritionValue(perPortion(protein), 1);
            if (ppFatEl) ppFatEl.textContent = formatNutritionValue(perPortion(fat), 1);
            if (ppCarbsEl) ppCarbsEl.textContent = formatNutritionValue(perPortion(carbs), 1);
            if (ppSugarEl) ppSugarEl.textContent = formatNutritionValue(perPortion(sugar), 1);
            if (ppFiberEl) ppFiberEl.textContent = formatNutritionValue(perPortion(fiber), 1);
            if (ppSaturatedEl) ppSaturatedEl.textContent = formatNutritionValue(perPortion(saturatedFat), 1);
            if (ppSaltEl) ppSaltEl.textContent = formatNutritionValue(perPortion(salt), 1);

            updateMacroBar(protein, fat, carbs, calories, 'day', `-${dayIndex}`);
        }

        function togglePlanNutrition() {
            const nutritionEl = document.getElementById('planNutrition');
            const toggle = document.getElementById('planNutritionToggle');
            if (!nutritionEl || !toggle) return;

            const isCollapsed = nutritionEl.classList.contains('is-collapsed');
            nutritionEl.classList.toggle('is-collapsed', !isCollapsed);
            toggle.setAttribute('aria-expanded', isCollapsed ? 'true' : 'false');
        }

        function toggleDayNutrition(dayIndex) {
            const nutritionEl = document.querySelector(`.day-nutrition[data-day-index="${dayIndex}"]`);
            if (!nutritionEl) return;

            const isCollapsed = nutritionEl.classList.contains('is-collapsed');
            nutritionEl.classList.toggle('is-collapsed', !isCollapsed);
        }

        function getDayRecipeIds(dayIndex) {
            const ids = [];
            Object.keys(weeklyPlanData).forEach(key => {
                const [dayKey] = key.split('-').map(Number);
                if (dayKey !== dayIndex) return;
                const item = weeklyPlanData[key];
                if (!item || !item.recipeId || item.recipeId === '0') return;
                const parsed = parseInt(item.recipeId, 10);
                if (Number.isFinite(parsed)) ids.push(parsed);
            });
            return ids;
        }

        async function updateDayNutritionTotals() {
            const personCount = parseInt(document.getElementById('planPersonCount')?.value || "1", 10) || 1;
            const paramsBase = new URLSearchParams();
            paramsBase.append('personCount', personCount);

            await Promise.all(days.map(async (_, dayIndex) => {
                const statusEl = document.getElementById(`dayNutritionStatus-${dayIndex}`);
                const recipeIds = getDayRecipeIds(dayIndex);
                if (recipeIds.length === 0) {
                    if (statusEl) statusEl.textContent = 'Keine Rezepte';
                    setDayNutritionTotals(dayIndex, null);
                    _dayKcalCache[dayIndex] = 0;
                    return;
                }

                if (statusEl) statusEl.textContent = 'Lädt...';

                const params = new URLSearchParams(paramsBase);
                recipeIds.forEach(id => params.append('recipeIds', id));

                try {
                    const response = await fetch(`/WorldMiniApp/MealPlan/GetMealPlanNutritionTotals?${params.toString()}`);
                    if (!response.ok) throw new Error('Day nutrition fetch failed');
                    const data = await response.json();
                    setDayNutritionTotals(dayIndex, data);
                    _dayKcalCache[dayIndex] = Number.isFinite(data?.calories) ? data.calories : 0;
                    if (statusEl) statusEl.textContent = 'Aktuell';
                } catch (error) {
                    console.error("Tagesnährwerte konnten nicht geladen werden.", error);
                    setDayNutritionTotals(dayIndex, null);
                    _dayKcalCache[dayIndex] = 0;
                    if (statusEl) statusEl.textContent = 'Fehler';
                }
            }));

            renderSparkline();
        }

        async function updatePlanNutritionTotals() {
            const statusEl = document.getElementById('planNutritionStatus');
            const payload = buildMealPlanPayload();
            const recipeIds = getPlanRecipeIds(payload);
            const personCount = parseInt(document.getElementById('planPersonCount')?.value || "1", 10) || 1;

            if (recipeIds.length === 0) {
                if (statusEl) statusEl.textContent = 'Keine Rezepte';
                setNutritionTotals(null);
                return;
            }

            if (statusEl) statusEl.textContent = 'Lädt...';

            const params = new URLSearchParams();
            recipeIds.forEach(id => params.append('recipeIds', id));
            params.append('personCount', personCount);

            try {
                const response = await fetch(`/WorldMiniApp/MealPlan/GetMealPlanNutritionTotals?${params.toString()}`);
                if (!response.ok) throw new Error('Nutrition fetch failed');
                const data = await response.json();
                setNutritionTotals(data);
                if (statusEl) statusEl.textContent = 'Aktuell';
            } catch (error) {
                console.error(i18n.nutritionError, error);
                setNutritionTotals(null);
                if (statusEl) statusEl.textContent = 'Fehler';
            }
        }

        function parseShoppingListText(text) {
            const lines = text.split('\n');
            const items = [];
            let currentGroup = 'Sonstiges';
            for (const line of lines) {
                const trimmed = line.trim();
                if (!trimmed) continue;
                if (!trimmed.startsWith('-') && !trimmed.startsWith('\u2022') && !trimmed.match(/^\d/)) {
                    currentGroup = trimmed.replace(/:$/, '');
                    continue;
                }
                const content = trimmed.replace(/^[-\u2022]\s*/, '');
                const match = content.match(/^(\d+[.,]?\d*)\s+(\S+)\s+(.+)$/);
                if (match) {
                    items.push({ group: currentGroup, qty: match[1], unit: match[2], name: match[3].trim() });
                } else {
                    items.push({ group: currentGroup, name: content.trim(), qty: '', unit: '' });
                }
            }
            return items;
        }

        async function generateShareLink() {
            const text = (document.getElementById('shoppingListEditor')?.value || '').trim();
            if (!text) { showToast(i18n.shoppingListLoadFirst, "warn"); return; }

            try {
                const items = parseShoppingListText(text);

                // FormData mit CSRF-Token (ASP.NET Core erwartet das so)
                const formData = new FormData();
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInput) {
                    formData.append('__RequestVerificationToken', tokenInput.value);
                }
                formData.append('itemsJson', JSON.stringify(items));
                formData.append('userHash', window.worldUserHash || '');
                const activeSharedFeedId = getActiveSharedFeedId();
                if (activeSharedFeedId) {
                    formData.append('sharedFeedId', activeSharedFeedId.toString());
                }

                const resp = await fetch('/WorldMiniApp/MealPlan/SaveSharedShoppingList', {
                    method: 'POST',
                    body: formData
                });

                if (!resp.ok) {
                    const errorText = await resp.text();
                    console.error('SaveSharedShoppingList error:', errorText);
                    showToast("Fehler beim Erstellen des Links.", "error");
                    return;
                }

                const data = await resp.json();
                document.getElementById('shoppingShareLink').value = data.shareUrl;

                // Direkt teilen - einfacher Share-Button
                if (navigator.share) {
                    try {
                        await navigator.share({
                            title: i18n.shoppingListTitle,
                            text: i18n.shoppingListShare,
                            url: data.shareUrl
                        });
                        showToast("Link geteilt!", "success");
                    } catch (e) {
                        // User hat abgebrochen oder kein Share verfügbar
                        if (e.name !== 'AbortError') {
                            await navigator.clipboard.writeText(data.shareUrl);
                            showToast("Link kopiert!", "success");
                        }
                    }
                } else {
                    await navigator.clipboard.writeText(data.shareUrl);
                    showToast("Link kopiert!", "success");
                }
            } catch (error) {
                console.error('generateShareLink error:', error);
                showToast("Fehler: " + error.message, "error");
            }
        }

        async function copyShareLink() {
            const linkInput = document.getElementById('shoppingShareLink');
