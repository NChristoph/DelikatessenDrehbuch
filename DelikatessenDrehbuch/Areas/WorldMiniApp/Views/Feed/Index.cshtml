        function initHlsVideos(container) {
            const scope = container || document;
            scope.querySelectorAll('video.feed-media').forEach(video => {
                ensureSubtitleTrack(video).finally(() => attachCustomSubtitleOverlay(video));
            });
            const hlsVideos = scope.querySelectorAll('video[data-video-kind="hls"]');

            hlsVideos.forEach(video => {
                // Skip if already initialized
                if (video.dataset.hlsInitialized === 'true') return;

                const src = video.src || video.getAttribute('src');
                if (!src || !src.includes('.m3u8')) return;

                // Check if HLS.js is supported
                if (Hls.isSupported()) {
                    const hls = new Hls({
                        enableWorker: true,
                        lowLatencyMode: false,
                        backBufferLength: 90
                    });

                    hls.loadSource(src);
                    hls.attachMedia(video);

                    hls.on(Hls.Events.MANIFEST_PARSED, () => {
                        // Video is ready to play
                        video.dataset.hlsInitialized = 'true';
                        attachCustomSubtitleOverlay(video);
                    });

                    hls.on(Hls.Events.ERROR, (event, data) => {
                        if (data.fatal) {
                            console.error('HLS fatal error:', data);
                            switch(data.type) {
                                case Hls.ErrorTypes.NETWORK_ERROR:
                                    hls.startLoad();
                                    break;
                                case Hls.ErrorTypes.MEDIA_ERROR:
                                    hls.recoverMediaError();
                                    break;
                                default:
                                    hls.destroy();
                                    break;
                            }
                        }
                    });

                    // Store HLS instance for cleanup
                    video._hlsInstance = hls;
                } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
                    // Native HLS support (Safari, iOS)
                    video.dataset.hlsInitialized = 'true';
                    attachCustomSubtitleOverlay(video);
                } else {
                    console.warn('HLS not supported on this browser');
                }
            });
        }

        // ----------------- feed state restore (back from recipe detail) -----------------
        const FEED_STATE_KEY = 'worldminiapp.feed.state.v1';
        const FEED_RESTORE_FLAG_KEY = 'worldminiapp.feed.restore.v1';
        let lastVisibleFeedRecipeId = 0;
        let lastVisibleFeedPostingId = 0;
        let lastFeedStateWriteAt = 0;

        function safeParseJson(value) {
            try { return JSON.parse(value); } catch { return null; }
        }

        function buildReturnUrlWithScrollTo(recipeId) {
            const url = new URL(window.location.href);
            if (recipeId && Number.isFinite(Number(recipeId))) {
                url.searchParams.set('scrollToId', String(recipeId));
            }
            return url.pathname + url.search;
        }

        function persistFeedState(container) {
            const feedContainer = document.getElementById('feedContainer');
            if (!feedContainer) return;

            if (typeof activeSection !== 'undefined' && activeSection !== 'feed') return;

            const now = Date.now();
            if (now - lastFeedStateWriteAt < 250) return; // throttle writes
            lastFeedStateWriteAt = now;

            const recipeId = Number(container?.dataset?.id || lastVisibleFeedRecipeId || 0) || 0;
            const postingId = Number(container?.dataset?.postingId || lastVisibleFeedPostingId || 0) || 0;
            if (!recipeId) return;

            const state = {
                recipeId,
                postingId,
                scrollTop: feedContainer.scrollTop,
                returnUrl: buildReturnUrlWithScrollTo(recipeId),
                ts: now
            };

            sessionStorage.setItem(FEED_STATE_KEY, JSON.stringify(state));
        }

        function tryRestoreFeedScrollFromUrl() {
            const params = new URLSearchParams(window.location.search);
            const scrollToId = Number(params.get('scrollToId') || 0) || 0;
            const postingId = Number(params.get('postingId') || 0) || 0;
            const shouldOpenComments = params.get('openComments') === '1';

            let target = null;
            if (postingId) {
                target = document.querySelector(`#feedSection .feed-item[data-posting-id="${postingId}"]`);
            }

            if (!target && scrollToId) {
                target = document.querySelector(`#feedSection .feed-item[data-id="${scrollToId}"]`);
            }

            if (!target) return false;

            target.scrollIntoView({ block: 'start' });

            // Clean URL so refresh doesn't keep jumping.
            params.delete('scrollToId');
            if (!shouldOpenComments) {
                params.delete('postingId');
            }
            const cleaned = window.location.pathname + (params.toString() ? `?${params.toString()}` : '');
            history.replaceState(history.state, '', cleaned);
            return true;
        }

        function tryRestoreFeedScrollFromSession() {
            const shouldRestore = sessionStorage.getItem(FEED_RESTORE_FLAG_KEY) === '1';
            if (!shouldRestore) return false;
            sessionStorage.removeItem(FEED_RESTORE_FLAG_KEY);

            const state = safeParseJson(sessionStorage.getItem(FEED_STATE_KEY) || '');
            const recipeId = Number(state?.recipeId || 0) || 0;
            if (!recipeId) return false;

            const target = document.querySelector(`#feedSection .feed-item[data-id="${recipeId}"]`);
            if (!target) return false;

            target.scrollIntoView({ block: 'start' });
            return true;
        }

        // ----------------- toast -----------------
        function showToast(message, type = 'info', duration = 2800, action = null) {
            const c = document.getElementById('toastContainer');
            if (!c) return;
            const el = document.createElement('div');
            el.className = `toast-msg toast-${type}`;

            if (action?.label && typeof action.onClick === 'function') {
                el.classList.add('has-action');

                const content = document.createElement('div');
                content.className = 'toast-msg-content';
                content.textContent = message;
                el.appendChild(content);

                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'toast-action-btn';
                button.textContent = action.label;
                button.addEventListener('click', (event) => {
                    event.stopPropagation();
                    action.onClick();
                    dismissToast(el);
                });
                el.appendChild(button);
            } else {
                el.textContent = message;
            }

            c.appendChild(el);
            const timeoutId = window.setTimeout(() => dismissToast(el), duration);
            el.dataset.toastTimeoutId = String(timeoutId);
            return el;
        }

        function dismissToast(el) {
