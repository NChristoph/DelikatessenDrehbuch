    <script>
        window.worldChainMarketplaceConfig = {
            chainId: Number('@worldChainId'),
            wldTokenAddress: '@worldChainWldToken',
            usdtTokenAddress: '@worldChainUsdtToken',
            marketplaceAddress: '@worldChainMarketplace',
            testMode: @(worldChainTestMode ? "true" : "false")
        };

        let feedSelectedPaymentToken = 'WLD';
        let feedWldPriceUsd = null;
        let feedWalletAddresses = { WLD: '@walletWLD', USDT: '@walletUSDT', USDCE: '@walletUSDT' };
        const FEED_USER_HASH = '@userHash';
        const feedRefreshThresholdPx = 84;
        window.likedRecipeIds = new Set(@Html.Raw(Json.Serialize(likedRecipeIds)));
        window.bookmarkedRecipeIds = new Set(@Html.Raw(Json.Serialize(bookmarkedRecipeIds)));

        // ----------------- toast -----------------
        function showToast(message, type = 'info', duration = 2800) {
            const c = document.getElementById('toastContainer');
            if (!c) return;
            const el = document.createElement('div');
            el.className = `toast-msg toast-${type}`;
            el.textContent = message;
            c.appendChild(el);
            setTimeout(() => {
                el.classList.add('toast-out');
                el.addEventListener('animationend', () => el.remove(), { once: true });
            }, duration);
        }

        async function withButtonSpinner(btn, asyncFn) {
            if (!btn || btn.classList.contains('btn-loading')) return;
            const origHtml = btn.innerHTML;
            const label = btn.textContent.trim();
            btn.classList.add('btn-loading');
            btn.innerHTML = `<span class="btn-spinner"></span>${label}`;
            try { await asyncFn(); }
            finally { btn.classList.remove('btn-loading'); btn.innerHTML = origHtml; }
        }

        // ----------------- helpers -----------------
        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        function getUserHash() {
            const stored = sessionStorage.getItem("UserToken") || localStorage.getItem("UserToken");
            const fallback = '@ViewData["UserHash"]';
            return stored || fallback;
        }

        function triggerHaptic(kind = 'light') {
            if (!navigator.vibrate) return;

            const pattern = kind === 'success'
                ? [16, 24, 30]
                : kind === 'medium'
                    ? 18
                    : 10;

            try {
                navigator.vibrate(pattern);
            } catch (error) {
                console.debug('Haptic feedback unavailable', error);
            }
        }

        function setVideoProgress(container, progress) {
            const fill = container?.querySelector('.video-progress-fill');
            if (!fill) return;

            const clamped = Math.max(0, Math.min(1, progress || 0));
            fill.style.width = `${(clamped * 100).toFixed(2)}%`;
        }

        function updateVideoProgress(video) {
            if (!video) return;

            const container = video.closest('.feed-item');
            if (!container) return;

            container.classList.add('has-video');

            const duration = Number.isFinite(video.duration) && video.duration > 0 ? video.duration : 0;
            const progress = duration > 0 ? video.currentTime / duration : 0;
            setVideoProgress(container, progress);
        }

        function bindVideoProgress(container) {
            const video = container?.querySelector('video');
            if (!video || video.dataset.progressBound === 'true') return;

            video.dataset.progressBound = 'true';
            updateVideoProgress(video);

            ['loadedmetadata', 'timeupdate', 'seeking', 'durationchange', 'play', 'pause'].forEach(eventName => {
                video.addEventListener(eventName, () => updateVideoProgress(video));
            });

            video.addEventListener('ended', () => setVideoProgress(container, 1));
        }

        async function shareRecipeFromButton(btn) {
            const container = btn?.closest('.feed-item');
            if (!container) return;

            const recipeId = container.dataset.id;
            const title = container.querySelector('.recipe-title')?.textContent?.trim() || 'Rezept';
            const creatorName = container.dataset.creatorName || '';
            const url = `${window.location.origin}/WorldMiniApp/Home/ShowRecipe/${recipeId}`;
            const shareData = {
                title,
                text: creatorName ? `${title} von ${creatorName}` : title,
                url
            };

            try {
                if (navigator.share) {
                    await navigator.share(shareData);
                } else if (navigator.clipboard?.writeText) {
                    await navigator.clipboard.writeText(url);
                    showToast('Link kopiert!', 'success');
                } else {
                    window.prompt('Link teilen:', url);
                }

                triggerHaptic('medium');
            } catch (error) {
                if (error?.name === 'AbortError') return;
                console.error('Share failed', error);
                showToast('Teilen gerade nicht verfügbar.', 'warn');
            }
        }

        function bindFeedItemState(container) {
            if (!container || container.dataset.feedBound === 'true') return;

            container.dataset.feedBound = 'true';
            bindVideoProgress(container);
        }

        function setupPullToRefresh() {
            const feedContainer = document.getElementById('feedContainer');
            const indicator = document.getElementById('pullRefreshIndicator');
            const label = document.getElementById('pullRefreshLabel');
            if (!feedContainer || !indicator || !label) return;

            let startY = 0;
            let isTracking = false;
            let isReady = false;
            let isRefreshing = false;

            const resetIndicator = () => {
                indicator.classList.remove('is-visible', 'is-ready', 'is-refreshing');
                label.textContent = '@T("Zum Aktualisieren ziehen", "Pull to refresh", "Desliza para actualizar", "Puxe para atualizar")';
                indicator.style.transform = 'translate(-50%, -18px) scale(0.92)';
                isReady = false;
            };

            feedContainer.addEventListener('touchstart', (event) => {
                if (activeSection !== 'feed' || feedContainer.scrollTop > 0 || isRefreshing) return;

                const touch = event.touches?.[0];
                if (!touch) return;

                startY = touch.clientY;
                isTracking = true;
            }, { passive: true });

            feedContainer.addEventListener('touchmove', (event) => {
                if (!isTracking || activeSection !== 'feed' || isRefreshing) return;

                const touch = event.touches?.[0];
                if (!touch) return;

                const deltaY = touch.clientY - startY;
                if (deltaY <= 0 || feedContainer.scrollTop > 0) {
                    resetIndicator();
                    return;
                }

                const pullDistance = Math.min(deltaY * 0.6, 110);
                isReady = pullDistance >= feedRefreshThresholdPx;

                indicator.classList.add('is-visible');
                indicator.classList.toggle('is-ready', isReady);
                indicator.style.transform = `translate(-50%, ${Math.min(pullDistance - 18, 20)}px) scale(${0.92 + Math.min(pullDistance / 220, 0.12)})`;
                label.textContent = isReady
                    ? '@T("Loslassen zum Aktualisieren", "Release to refresh", "Suelta para actualizar", "Solte para atualizar")'
                    : '@T("Zum Aktualisieren ziehen", "Pull to refresh", "Desliza para actualizar", "Puxe para atualizar")';
            }, { passive: true });

            const finishPull = () => {
                if (!isTracking || isRefreshing) {
                    isTracking = false;
                    return;
                }

                isTracking = false;

                if (!isReady) {
                    resetIndicator();
                    return;
                }

                isRefreshing = true;
                indicator.classList.add('is-visible', 'is-refreshing');
                indicator.classList.remove('is-ready');
                label.textContent = '@T("Aktualisiere Feed...", "Refreshing feed...", "Actualizando feed...", "Atualizando feed...")';
                indicator.style.transform = 'translate(-50%, 0) scale(1)';
                triggerHaptic('success');
                window.location.reload();
            };

            feedContainer.addEventListener('touchend', finishPull, { passive: true });
            feedContainer.addEventListener('touchcancel', () => {
                isTracking = false;
                if (!isRefreshing) resetIndicator();
            }, { passive: true });
        }



        let activeSection = 'feed';
        let activeMarketplaceCreatorHash = '';

        function normalizeHash(value) {
            return (value || '').toString().trim().toLowerCase();
        }

        function getCurrentFeedCreatorContext() {
            const x = Math.floor(window.innerWidth / 2);
            const y = Math.floor(window.innerHeight / 2);
            const centerElement = document.elementFromPoint(x, y);
            const feedItem = centerElement?.closest?.('.feed-item');
            if (!feedItem) return null;

            const creatorHash = normalizeHash(feedItem.getAttribute('data-creator-id'));
            const creatorName = (feedItem.getAttribute('data-creator-name') || '').trim();
            if (!creatorHash) return null;

            return { creatorHash, creatorName };
        }

        function updateMarketplaceForCreator(context) {
            const sellerInfo = document.getElementById('marketplaceActiveSeller');
            const empty = document.getElementById('marketplaceFilteredEmpty');
            const cards = Array.from(document.querySelectorAll('.js-marketplace-listing'));

            if (!cards.length) return;

            const creatorHash = normalizeHash(context?.creatorHash);
            const creatorName = (context?.creatorName || '').trim();
            activeMarketplaceCreatorHash = creatorHash;

            let visibleCount = 0;
            cards.forEach(card => {
                const sellerHash = normalizeHash(card.getAttribute('data-seller-hash'));
                const isVisible = !creatorHash || sellerHash === creatorHash;
                card.style.display = isVisible ? '' : 'none';
                if (isVisible) visibleCount++;
            });

            if (sellerInfo) {
                sellerInfo.textContent = creatorName
                    ? `Angebote von ${creatorName}`
                    : 'Angebote vom aktuellen Creator';
            }

            if (empty) {
                empty.style.display = visibleCount === 0 ? '' : 'none';
            }
        }

        function syncMarketplaceToCurrentFeedItem() {
            const context = getCurrentFeedCreatorContext();
            updateMarketplaceForCreator(context);
        }

        function updateSectionPills() {
            document.querySelectorAll('[data-section-pill]').forEach(el => {
                const section = el.getAttribute('data-section-pill');
                el.classList.toggle('active', section === activeSection);
            });
        }

        let savedFeedScrollTop = 0;

        function setSection(section) {
            const sections = document.getElementById('feedSections');
            if (!sections) return;

            const feedContainer = document.getElementById('feedContainer');

            // Capture creator context BEFORE transform changes (elementFromPoint needs items on-screen)
            const feedCreatorContext = (activeSection === 'feed') ? getCurrentFeedCreatorContext() : null;

            // Save feed scroll position when leaving feed
            if (activeSection === 'feed' && section !== 'feed' && feedContainer) {
                savedFeedScrollTop = feedContainer.scrollTop;
            }

            // Pause creator feed videos when leaving creator section
            if (activeSection === 'creator' && section !== 'creator') {
                document.querySelectorAll('#creatorFeedItems .feed-item video').forEach(v => v.pause());
            }

            activeSection = (section === 'marketplace' || section === 'creator') ? section : 'feed';

            // Disable scroll-snap temporarily so the browser doesn't fight our scrollTop change
            if (feedContainer) {
                feedContainer.style.scrollSnapType = 'none';
                feedContainer.style.scrollBehavior = 'auto';
                feedContainer.scrollTop = (activeSection === 'feed') ? savedFeedScrollTop : 0;
                // Block feedContainer vertical scroll when not in feed (creator/marketplace have own scroll)
                feedContainer.style.overflowY = (activeSection === 'feed') ? 'scroll' : 'hidden';
            }

            sections.classList.remove('section-creator', 'section-marketplace');

            if (activeSection === 'creator') {
                sections.classList.add('section-creator');
                loadCreatorFeedForCurrentItem(feedCreatorContext);
            } else if (activeSection === 'marketplace') {
                sections.classList.add('section-marketplace');
                if (feedCreatorContext) updateMarketplaceForCreator(feedCreatorContext);
            }

            // Re-enable scroll-snap after transition completes (only relevant for feed)
            if (feedContainer) {
                setTimeout(() => {
                    feedContainer.style.scrollBehavior = '';
                    if (activeSection === 'feed') feedContainer.style.scrollSnapType = '';
                }, 400);
            }

            updateSectionPills();
        }

