                        lastTap = now;
                        tapTimeout = setTimeout(() => togglePlayPause(this), 300);
                    }
                });
            });
        }

        async function loadCreatorFeedForCurrentItem(preContext) {
            const context = preContext || getCurrentFeedCreatorContext();
            if (!context) return;

            const { creatorHash, creatorName } = context;

            // Update header
            const nameEl = document.getElementById('creatorFeedName');
            if (nameEl) nameEl.textContent = creatorName || 'Creator';

            // Cache check: skip reload if same creator
            if (creatorFeedCache.creatorHash === creatorHash && creatorFeedCache.loaded) return;

            const itemsEl = document.getElementById('creatorFeedItems');
            const emptyEl = document.getElementById('creatorFeedEmpty');
            if (!itemsEl) return;

            // Pause any existing creator feed videos
            itemsEl.querySelectorAll('.feed-item').forEach(item => {
                creatorObserver.unobserve(item);
                const video = item.querySelector('video');
                if (video) video.pause();
            });

            // Show skeleton loader
            itemsEl.innerHTML = `
                <div class="skeleton-feed">
                    ${[1,2,3].map(() => `<div class="skeleton-card"><div class="skeleton-shimmer"></div></div>`).join('')}
                </div>`;
            if (emptyEl) emptyEl.style.display = 'none';

            try {
                const resp = await fetch(`/WorldMiniApp/Feed/CreatorPostings?creatorHash=${encodeURIComponent(creatorHash)}`);
                if (!resp.ok) throw new Error('Fetch failed');
                const postings = await resp.json();

                if (!postings.length) {
                    itemsEl.innerHTML = '';
                    if (emptyEl) emptyEl.style.display = '';
                    creatorFeedCache = { creatorHash, loaded: true };
                    return;
                }

                if (emptyEl) emptyEl.style.display = 'none';
                itemsEl.innerHTML = postings.map(buildCreatorFeedItemHtml).join('');
                attachCreatorFeedHandlers();
                creatorFeedCache = { creatorHash, loaded: true };
            } catch (e) {
                console.error('Creator feed load error:', e);
                itemsEl.innerHTML = `<div class="feed-error-retry">
                    <i class="bi bi-wifi-off" style="font-size:1.6rem;opacity:0.5;"></i>
                    <div style="font-size:0.85rem;opacity:0.7;margin:6px 0;">Laden fehlgeschlagen</div>
                    <button class="btn btn-sm btn-outline-light" onclick="creatorFeedCache.loaded=false; loadCreatorFeedForCurrentItem();">
                        <i class="bi bi-arrow-clockwise me-1"></i>Nochmal versuchen
                    </button>
                </div>`;
            }
        }

        // ----------------- init -----------------
        document.addEventListener('DOMContentLoaded', () => {
            attachFeedHandlers();
            attachPlanScrollBehavior();
            setupPullToRefresh();
            loadDraft();
            renderPlan();
            updatePlanModeHeader();
            setSection('feed');
            syncMarketplaceToCurrentFeedItem();
            setFeedToken('WLD');
            loadFeedWldPrice();
        });
    </script>

</body>
</html>





