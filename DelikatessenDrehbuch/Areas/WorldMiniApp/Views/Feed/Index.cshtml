        function toggleSystemControls(feedItem) {
            const trigger = feedItem.querySelector('.system-controls-trigger');
            const dropdown = feedItem.querySelector('.system-controls-dropdown');

            if (!trigger || !dropdown) return;

            const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

            if (isExpanded) {
