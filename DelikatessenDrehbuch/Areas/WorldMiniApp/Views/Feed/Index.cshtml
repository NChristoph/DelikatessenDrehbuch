        function attachMealModeToggleListeners() {
            for (let i = 0; i < 7; i++) {
                const toggle = document.getElementById(`mealModeToggle-${i}`);
                if (toggle && !toggle.dataset.listenerAttached) {
                    toggle.dataset.listenerAttached = 'true';
                    toggle.addEventListener('change', function() {
                        const dayIndex = parseInt(this.getAttribute('data-day-index'));
                        const isChecked = this.checked;
                        dayMealModes[dayIndex] = isChecked;
                        localStorage.setItem(`feedPlanMealMode_day${dayIndex}`, isChecked ? 'mahlzeiten' : 'gaenge');

                        // Update label
                        const label = document.getElementById(`modeLabel-${dayIndex}`);
                        if (label) {
                            label.textContent = isChecked ? 'Mahlzeiten' : 'Gänge';
                        }

                        // Re-render plan
                        renderPlan();
                    });
                }
            }
        }

        function addToSlot(key) {
            if (!pendingRecipe) return;
            setSlotItem(key, pendingRecipe, {
                haptic: true,
                toastMessage: `"${pendingRecipe.title || 'Rezept'}" hinzugefügt`
            });
        }

        function removeFromSlot(key) {
            deleteSlotItem(key, { withUndo: false, save: true });
        }

        function startEditSlot(key) {
            editingSlotKey = key;
            const modalEl = document.getElementById('planModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) modalInstance.hide();
            showToast(i18n.chooseRecipe, 'info');
        }

        function buildMealPlanPayload() {
            const payload = [];
            Object.keys(weeklyPlanData).forEach(key => {
                const item = weeklyPlanData[key];
                if (!item || !item.recipeId || item.recipeId === '0') return;

                const [dayIndex, slotIndex] = key.split('-').map(Number);
                payload.push({
                    DayIndex: dayIndex + 1,
                    SlotIndex: slotIndex,
                    RecipeId: parseInt(item.recipeId, 10),
                    Title: item.title || '',
                    ImagePath: item.img || ''
                });
            });
            return payload;
        }

        function clearWeeklyPlanState(keepPendingRecipe = false) {
            weeklyPlanData = {};
            duplicateSourceDayIndex = null;
            clearPendingDeleteUndoState();
            if (!keepPendingRecipe) { pendingRecipe = null; editingSlotKey = null; }
            localStorage.removeItem(getDraftStorageKey());
            const linkInput = document.getElementById('planShareLink');
            if (linkInput) linkInput.value = '';
            updatePlanModeHeader();
            renderPlan();
            scheduleNutritionUpdate();
        }

        function exportPlanAsIcs() {
            const payload = buildMealPlanPayload();
            if (!payload.length) { showToast('Plan ist leer â€” nichts zu exportieren.', 'warn'); return; }

            // Start date = coming Monday
            const now = new Date();
            const dayOfWeek = now.getDay(); // 0=Sun
            const diff = dayOfWeek === 0 ? 1 : (8 - dayOfWeek);
            const monday = new Date(now.getFullYear(), now.getMonth(), now.getDate() + diff);

            const pad = (n) => String(n).padStart(2, '0');
            const fmtDate = (d) => `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}`;
            const uid = () => crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random().toString(36).slice(2)}`;

            let ics = 'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//DelikatessenDrehbuch//Wochenplan//DE\r\nCALSCALE:GREGORIAN\r\n';

            payload.forEach(item => {
                const eventDate = new Date(monday);
                eventDate.setDate(monday.getDate() + (item.DayIndex - 1));
                const nextDay = new Date(eventDate);
                nextDay.setDate(eventDate.getDate() + 1);
                const slotName = slots[item.SlotIndex] || '';
                const summary = item.Title.replace(/[\\;,]/g, '\\$&');

                ics += 'BEGIN:VEVENT\r\n';
                ics += `DTSTART;VALUE=DATE:${fmtDate(eventDate)}\r\n`;
                ics += `DTEND;VALUE=DATE:${fmtDate(nextDay)}\r\n`;
                ics += `SUMMARY:${slotName}: ${summary}\r\n`;
                ics += `CATEGORIES:${slotName}\r\n`;
                ics += `UID:${uid()}@@delikatessen\r\n`;
                ics += `DTSTAMP:${fmtDate(now)}T${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}Z\r\n`;
                ics += 'END:VEVENT\r\n';
            });

            ics += 'END:VCALENDAR\r\n';

            const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'wochenplan.ics';
            a.click();
            URL.revokeObjectURL(url);
            showToast('Kalender-Datei heruntergeladen!', 'success');
        }

        async function shufflePlanFromLikes() {
            // Collect empty slots
            const emptySlots = [];
            days.forEach((_, di) => {
                slots.forEach((_, si) => {
                    const key = `${di}-${si}`;
                    if (!weeklyPlanData[key] || !weeklyPlanData[key].recipeId || weeklyPlanData[key].recipeId === '0') {
                        emptySlots.push(key);
                    }
                });
            });

            if (!emptySlots.length) {
                showToast('Alle Slots sind bereits belegt.', 'info');
                return;
            }

            const resp = await fetch('/WorldMiniApp/Feed/GetLikedRecipes');
            if (!resp.ok) throw new Error('Fetch failed');
            const liked = await resp.json();

            if (!liked.length) {
                showToast('Keine gelikten Rezepte vorhanden.', 'warn');
                return;
            }

            // Fisher-Yates shuffle
            const shuffled = [...liked];
            for (let i = shuffled.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
            }

            // Fill empty slots with shuffled recipes (cycle if more slots than likes)
            emptySlots.forEach((key, idx) => {
                const recipe = shuffled[idx % shuffled.length];
                weeklyPlanData[key] = {
                    recipeId: String(recipe.recipeId),
                    title: recipe.title,
                    img: recipe.img || ''
                };
            });

            renderPlan();
            saveDraft();
            scheduleNutritionUpdate();
            showToast(`${emptySlots.length} Slots zufällig befüllt!`, 'success');
            triggerHaptic();
        }

        function handlePlanContainerClick(event) {
            if (Date.now() < suppressPlanClickUntil) {
                event.preventDefault();
                event.stopPropagation();
                return;
            }

            const actionButton = event.target.closest('[data-action]');
            if (actionButton) {
                const action = actionButton.dataset.action;
                const slotKey = actionButton.dataset.slotKey;
                const dayIndex = actionButton.dataset.dayIndex;

                if (action === 'toggle-day-nutrition' && dayIndex !== undefined) {
                    toggleDayNutrition(Number(dayIndex));
                    actionButton.classList.toggle('is-expanded');
                    return;
                }

                if (action === 'edit-slot' && slotKey) {
                    startEditSlot(slotKey);
                    return;
                }

                if (action === 'delete-slot' && slotKey) {
                    deleteSlotItem(slotKey, { withUndo: false, save: true });
                    return;
                }

                if (action === 'duplicate-day' && dayIndex !== undefined) {
                    handleDuplicateDaySelection(Number(dayIndex));
                    return;
                }
            }

            const segBtn = event.target.closest('.day-nutrition-segment .nutrition-seg-btn');
            if (segBtn) {
                const seg = segBtn.closest('.day-nutrition-segment');
                const di = seg?.dataset.dayIndex;
                if (di === undefined) return;
                const mode = segBtn.dataset.mode;
                seg.querySelectorAll('.nutrition-seg-btn').forEach(b => b.classList.toggle('is-active', b === segBtn));
                const totalGrid = document.getElementById(`dayNutritionGridTotal-${di}`);
                const portionGrid = document.getElementById(`dayNutritionGridPortion-${di}`);
                if (totalGrid) totalGrid.style.display = mode === 'total' ? '' : 'none';
                if (portionGrid) portionGrid.style.display = mode === 'portion' ? '' : 'none';
                return;
            }

            const emptySlot = event.target.closest('.v1-empty[data-slot-key]');
            if (emptySlot?.dataset.slotKey && pendingRecipe) {
                addToSlot(emptySlot.dataset.slotKey);
                return;
            }

            const filledSlot = event.target.closest('.v1-meal[data-slot-key]');
            if (filledSlot?.dataset.slotKey && pendingRecipe && !event.target.closest('.v1-meal-act') && !event.target.closest('.v1-meal-act-danger')) {
                setSlotItem(filledSlot.dataset.slotKey, pendingRecipe, {
                    save: true,
                    haptic: true,
                    toastMessage: `"${pendingRecipe.title || 'Rezept'}" hinzugefügt`
                });
            }
        }

        function initPlanInteractionHandlers() {
            const planContainer = document.getElementById('planContainer');
            if (!planContainer || planContainer.dataset.handlersBound === 'true') return;

            planContainer.dataset.handlersBound = 'true';
            planContainer.addEventListener('click', handlePlanContainerClick);
        }

        function saveWeeklyPlan() {
            const userHash = getUserHash();
            if (!userHash) { showToast("Bitte erst einloggen!", "warn"); return; }

            const payload = buildMealPlanPayload();
            if (payload.length === 0) { showToast("Bitte mindestens ein Rezept auswählen.", "warn"); return; }

            const title = (document.getElementById('planTitleInput')?.value || '').trim() || "Mein Wochenplan";
            const personCount = parseInt(document.getElementById('planPersonCount')?.value || "1", 10) || 1;

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : null;

            fetch('/WorldMiniApp/MealPlan/SaveMealPlanFromLayout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    ...(token ? { 'RequestVerificationToken': token } : {})
                },
                body: JSON.stringify({
                    mealPlanJson: JSON.stringify(payload),
                    personCount: personCount,
                    title: title,
                    userHash: userHash
                })
            })
                .then(async response => {
                    if (!response.ok) {
                        const errorText = await response.text();
                        throw new Error(errorText || 'Plan konnte nicht gespeichert werden.');
                    }

                    return response.json();
                })
                .then(data => {
                    clearWeeklyPlanState();
                    showToast("Plan gespeichert!", "success");

                    const redirectUrl = data?.redirectUrl || '/WorldMiniApp/Feed/MyProfile?tab=mealplans';
                    setTimeout(() => {
                        window.location.href = redirectUrl;
                    }, 500);
                })
                .catch(error => {
                    console.error('Meal plan save failed', error);
                    showToast(`Plan konnte nicht gespeichert werden. ${error.message || ''}`.trim(), "error");
                });
        }

        function getActiveSharedFeedId() {
            const rawValue = localStorage.getItem('wmActiveSharedFeedId');
            const parsed = parseInt(rawValue || '', 10);
            return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
        }

        async function shareWeeklyPlan() {
            const payload = buildMealPlanPayload();
            if (payload.length === 0) { showToast("Bitte mindestens ein Rezept auswählen.", "warn"); return; }

            const title = (document.getElementById('planTitleInput')?.value || '').trim() || "Mein Wochenplan";
            const personCount = parseInt(document.getElementById('planPersonCount')?.value || "1", 10) || 1;

            try {
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : null;

                const response = await fetch('/WorldMiniApp/MealPlan/SaveSharedMealPlan', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        ...(token ? { 'RequestVerificationToken': token } : {})
                    },
                    body: JSON.stringify({
                        mealPlanJson: JSON.stringify(payload),
                        personCount: personCount,
                        title: title,
                        userHash: getUserHash(),
                        sharedFeedId: getActiveSharedFeedId()
                    })
                });

                if (!response.ok) {
                    const errorText = await response.text();
                    showToast(`Plan konnte nicht geteilt werden. ${errorText}`, 'error');
                    return;
                }

                const data = await response.json();
                const linkInput = document.getElementById('planShareLink');
                if (linkInput) linkInput.value = data.shareUrl || '';

                if (!data.shareUrl) { showToast("Teilen fehlgeschlagen: Kein Link erhalten.", "error"); return; }

                try {
                    if (navigator.share) await navigator.share({ title: title, url: data.shareUrl });
                    else if (navigator.clipboard) { await navigator.clipboard.writeText(data.shareUrl); showToast("Link kopiert!", "success"); }
                } catch (shareError) {
                    console.warn("Teilen nicht verfügbar:", shareError);
                }
            } catch (error) {
                console.error("Teilen fehlgeschlagen:", error);
                showToast("Plan konnte nicht geteilt werden.", "error");
            }
        }

        function getDraftStorageKey() {
            const userHash = getUserHash();
            return `worldminiapp_feed_plan_${userHash || 'guest'}`;
        }

        function scheduleDraftSave() {
            if (saveTimer) clearTimeout(saveTimer);
            saveTimer = setTimeout(() => saveDraft(), 600);
        }

        async function saveDraft() {
            const payload = buildMealPlanPayload();
            const personCount = parseInt(document.getElementById('planPersonCount')?.value || "1", 10) || 1;
            const title = (document.getElementById('planTitleInput')?.value || '').trim() || "Feed-Plan";

            localStorage.setItem(getDraftStorageKey(), JSON.stringify({
                mealPlanJson: JSON.stringify(payload),
                personCount: personCount,
                title: title
            }));

            const userHash = getUserHash();
            if (!userHash) return;

            // optional: du hattest einen endpoint - wenn du ihn willst, ist das hier ok:
            try {
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : null;

                await fetch('/WorldMiniApp/MealPlan/SaveFeedMealPlanDraft', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        ...(token ? { 'RequestVerificationToken': token } : {})
                    },
                    body: JSON.stringify({
                        mealPlanJson: JSON.stringify(payload),
                        personCount: personCount,
                        title: title,
                        userHash: userHash
                    })
                });
            } catch { }
        }

        function applyDraftPayload(payload, personCount, title) {
            if (title) document.getElementById('planTitleInput').value = title;
            if (personCount) {
                document.getElementById('planPersonCount').value = personCount;
                if (typeof syncPersonPresets === 'function') syncPersonPresets();
            }

            weeklyPlanData = {};
            (payload || []).forEach(item => {
                const dayIndex = (item.DayIndex || 1) - 1;
                const slotIndex = item.SlotIndex ?? 0;
                const key = `${dayIndex}-${slotIndex}`;
                weeklyPlanData[key] = {
                    title: item.Title || item.title || '',
                    img: item.ImagePath || item.img || '',
                    recipeId: item.RecipeId || item.recipeId
                };
            });
            renderPlan();
            scheduleNutritionUpdate();
        }

        async function loadDraft() {
            const stored = localStorage.getItem(getDraftStorageKey());
            if (stored) {
                try {
                    const parsed = JSON.parse(stored);
                    const payload = parsed.mealPlanJson ? JSON.parse(parsed.mealPlanJson) : [];
                    applyDraftPayload(payload, parsed.personCount, parsed.title);
