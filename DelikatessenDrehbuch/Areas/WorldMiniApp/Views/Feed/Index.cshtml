        let savedFeedScrollTop = 0;

        function setSection(section) {
            const sections = document.getElementById('feedSections');
            if (!sections) return;

            const feedContainer = document.getElementById('feedContainer');

            // Capture creator context BEFORE transform changes (elementFromPoint needs items on-screen)
            const feedCreatorContext = (activeSection === 'feed') ? getCurrentFeedCreatorContext() : null;

            // Save feed scroll position when leaving feed
            if (activeSection === 'feed' && section !== 'feed' && feedContainer) {
                savedFeedScrollTop = feedContainer.scrollTop;
            }

            // Pause creator feed videos when leaving creator section
            if (activeSection === 'creator' && section !== 'creator') {
                document.querySelectorAll('#creatorFeedItems .feed-item video').forEach(v => v.pause());
            }

            activeSection = (section === 'marketplace' || section === 'creator') ? section : 'feed';

            // Disable scroll-snap temporarily so the browser doesn't fight our scrollTop change
            if (feedContainer) {
                feedContainer.style.scrollSnapType = 'none';
                feedContainer.style.scrollBehavior = 'auto';
                feedContainer.scrollTop = (activeSection === 'feed') ? savedFeedScrollTop : 0;
                // Block feedContainer vertical scroll when not in feed (creator/marketplace have own scroll)
                feedContainer.style.overflowY = (activeSection === 'feed') ? 'scroll' : 'hidden';
            }

            sections.classList.remove('section-creator', 'section-marketplace');

            if (activeSection === 'creator') {
                sections.classList.add('section-creator');
                loadCreatorFeedForCurrentItem(feedCreatorContext);
            } else if (activeSection === 'marketplace') {
                sections.classList.add('section-marketplace');
                if (feedCreatorContext) updateMarketplaceForCreator(feedCreatorContext);
            }

            // Re-enable scroll-snap after transition completes (only relevant for feed)
            if (feedContainer) {
                setTimeout(() => {
                    feedContainer.style.scrollBehavior = '';
                    if (activeSection === 'feed') feedContainer.style.scrollSnapType = '';
                }, 400);
            }

            updateSectionPills();
        }

