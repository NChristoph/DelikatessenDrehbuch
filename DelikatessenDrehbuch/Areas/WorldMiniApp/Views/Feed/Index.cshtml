    </style>

    <!-- Marketplace Preview Sheet (Avocado Theme) -->
    <div class="marketplace-preview-backdrop" id="marketplacePreviewBackdrop"></div>
    <div class="marketplace-preview-sheet" id="marketplacePreviewSheet">
        <div class="mp-prev-handle"></div>

        <div class="mp-prev-header">
            <div class="mp-prev-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
            </div>
            <div class="mp-prev-header-content">
                <h3 class="mp-prev-title" id="mpPrevTitle">Loading...</h3>
                <div class="mp-prev-meta" id="mpPrevMeta"></div>
            </div>
        </div>

        <div class="mp-prev-stats" id="mpPrevStats"></div>

        <div class="mp-prev-section-title" id="mpPrevRecipesSection" style="display:none;">Enthaltene Rezepte</div>
        <div class="mp-prev-recipes" id="mpPrevRecipes"></div>

        <div id="mpPrevMacrosSection" style="display:none;">
            <div class="mp-prev-section-title">Durchschnittliche Makros pro Tag</div>
            <div class="mp-prev-macros">
                <div class="mp-prev-macros-header">
                    <div>
                        <div class="mp-prev-macros-label">Kalorien</div>
                        <div class="mp-prev-macros-kcal">
                            <span id="mpPrevKcal">-</span><span class="mp-prev-macros-kcal-unit">kcal</span>
                        </div>
                    </div>
                </div>
                <div class="mp-prev-macro-bars" id="mpPrevMacroBars"></div>
            </div>
        </div>

        <div class="mp-prev-tags" id="mpPrevTags"></div>

        <div class="mp-prev-close-btn">
            <button onclick="closeMarketplacePreview()">Schließen</button>
        </div>
    </div>

    <script>
        // Marketplace Preview Functions
        function showFeedPreview(listingId) {
            const sheet = document.getElementById('marketplacePreviewSheet');
            const backdrop = document.getElementById('marketplacePreviewBackdrop');
            if (!sheet || !backdrop || !listingId) return;

            sheet.classList.add('is-open');
            backdrop.classList.add('is-open');

            // Show loading state
            document.getElementById('mpPrevTitle').textContent = 'Laden...';
            document.getElementById('mpPrevMeta').innerHTML = '';
            document.getElementById('mpPrevStats').innerHTML = '';
            document.getElementById('mpPrevRecipes').innerHTML = '';
            document.getElementById('mpPrevTags').innerHTML = '';
            document.getElementById('mpPrevRecipesSection').style.display = 'none';
            document.getElementById('mpPrevMacrosSection').style.display = 'none';

            // Fetch listing details
            fetch(`/WorldMiniApp/Home/GetMarketplacePreview?listingId=${listingId}`)
                .then(r => r.ok ? r.json() : Promise.reject('Error loading preview'))
                .then(data => renderMarketplacePreview(data))
                .catch(err => {
                    console.error('Preview error:', err);
                    document.getElementById('mpPrevTitle').textContent = 'Fehler beim Laden';
                });
        }

        function renderMarketplacePreview(data) {
            // Title & Meta
            document.getElementById('mpPrevTitle').textContent = data.title || 'Unbekannter Plan';
            const metaParts = [];
            if (data.creatorName) metaParts.push(`👤 ${data.creatorName}`);
            if (data.dayCount) metaParts.push(`${data.dayCount} Tage`);
            if (data.recipeCount) metaParts.push(`${data.recipeCount} Rezepte`);
            document.getElementById('mpPrevMeta').innerHTML = metaParts.join('<span class="mp-prev-meta-sep">·</span>');

            // Stats
            const statsHtml = [];
            if (data.rating) {
                statsHtml.push(`
                    <div class="mp-prev-stat">
                        <div class="mp-prev-stat-value">⭐ ${data.rating.toFixed(1)}</div>
                        <div class="mp-prev-stat-label">Rating</div>
                    </div>
                `);
            }
            if (data.soldCount !== undefined) {
                statsHtml.push(`
                    <div class="mp-prev-stat">
                        <div class="mp-prev-stat-value">${data.soldCount}</div>
                        <div class="mp-prev-stat-label">Verkauft</div>
                    </div>
                `);
            }
            if (data.activePlannerCount) {
                statsHtml.push(`
                    <div class="mp-prev-stat">
                        <div class="mp-prev-stat-value">${data.activePlannerCount}</div>
                        <div class="mp-prev-stat-label">Aktive Nutzer</div>
                    </div>
                `);
            }
            document.getElementById('mpPrevStats').innerHTML = statsHtml.join('');

            // Recipes
            if (data.recipes && data.recipes.length > 0) {
                document.getElementById('mpPrevRecipesSection').style.display = '';
                const recipesHtml = data.recipes.map(r => `
                    <div class="mp-prev-recipe-item">
                        ${r.imageUrl ? `<img src="${r.imageUrl}" class="mp-prev-recipe-thumb" alt="${r.title}">` : '<div class="mp-prev-recipe-thumb"></div>'}
                        <div class="mp-prev-recipe-info">
                            <div class="mp-prev-recipe-name">${r.title || 'Unbenanntes Rezept'}</div>
                            <div class="mp-prev-recipe-cat">${r.category || ''}</div>
                        </div>
                    </div>
                `).join('');
                document.getElementById('mpPrevRecipes').innerHTML = recipesHtml;
            }

            // Macros
            if (data.kcalPerDay || data.proteinGrams || data.fatGrams || data.carbsGrams) {
                document.getElementById('mpPrevMacrosSection').style.display = '';
                document.getElementById('mpPrevKcal').textContent = data.kcalPerDay ? Math.round(data.kcalPerDay) : '-';

                const total = (data.proteinGrams || 0) + (data.fatGrams || 0) + (data.carbsGrams || 0);
                const proteinPct = total > 0 ? Math.round((data.proteinGrams || 0) / 250 * 100) : 0;
                const fatPct = total > 0 ? Math.round((data.fatGrams || 0) / 250 * 100) : 0;
                const carbsPct = total > 0 ? Math.round((data.carbsGrams || 0) / 250 * 100) : 0;

                const barsHtml = [];
                if (data.proteinGrams) {
                    barsHtml.push(`
                        <div class="mp-prev-macro-bar-row">
                            <div class="mp-prev-macro-bar-label">Protein</div>
                            <div class="mp-prev-macro-bar-track">
                                <div class="mp-prev-macro-bar-fill protein" style="width: ${proteinPct}%"></div>
                            </div>
                            <div class="mp-prev-macro-bar-value">${data.proteinGrams.toFixed(1)}g</div>
                        </div>
                    `);
                }
                if (data.fatGrams) {
                    barsHtml.push(`
                        <div class="mp-prev-macro-bar-row">
                            <div class="mp-prev-macro-bar-label">Fett</div>
                            <div class="mp-prev-macro-bar-track">
                                <div class="mp-prev-macro-bar-fill fat" style="width: ${fatPct}%"></div>
                            </div>
                            <div class="mp-prev-macro-bar-value">${data.fatGrams.toFixed(1)}g</div>
                        </div>
                    `);
                }
                if (data.carbsGrams) {
                    barsHtml.push(`
                        <div class="mp-prev-macro-bar-row">
                            <div class="mp-prev-macro-bar-label">KH</div>
                            <div class="mp-prev-macro-bar-track">
                                <div class="mp-prev-macro-bar-fill carbs" style="width: ${carbsPct}%"></div>
                            </div>
                            <div class="mp-prev-macro-bar-value">${data.carbsGrams.toFixed(1)}g</div>
                        </div>
                    `);
                }
                document.getElementById('mpPrevMacroBars').innerHTML = barsHtml.join('');
            }

            // Tags
            if (data.tags && data.tags.length > 0) {
                const tagsHtml = data.tags.map(tag => `<span class="mp-prev-tag">${tag}</span>`).join('');
                document.getElementById('mpPrevTags').innerHTML = tagsHtml;
            }
        }

        function closeMarketplacePreview() {
            document.getElementById('marketplacePreviewSheet')?.classList.remove('is-open');
            document.getElementById('marketplacePreviewBackdrop')?.classList.remove('is-open');
        }

        // Backdrop click closes
        document.getElementById('marketplacePreviewBackdrop')?.addEventListener('click', closeMarketplacePreview);

        // Also support showPreview alias
        window.showPreview = showFeedPreview;
    </script>

</body>
</html>








