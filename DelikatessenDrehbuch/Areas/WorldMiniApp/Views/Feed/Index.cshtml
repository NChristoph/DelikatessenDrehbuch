        function getPlanRecipeIds(payload) {
            return (payload || []).map(x => x.RecipeId).filter(id => Number.isFinite(id));
        }

        async function prepareShoppingList() {
            const payload = buildMealPlanPayload();
            const recipeIds = getPlanRecipeIds(payload);
            if (recipeIds.length === 0) { showToast("Bitte mindestens ein Rezept auswählen.", "warn"); return; }

            const personCountInput = document.getElementById('planPersonCount');
            const personCount = Math.max(1, parseInt(personCountInput?.value || "1", 10) || 1);
            if (personCountInput) personCountInput.value = personCount;
            if (typeof syncPersonPresets === 'function') syncPersonPresets();

            const params = new URLSearchParams();
            recipeIds.forEach(id => params.append('recipeIds', id));
            params.append('personCount', personCount);

            const response = await fetch(`/WorldMiniApp/MealPlan/GetShoppingListText?${params.toString()}`);
            if (!response.ok) { showToast(i18n.shoppingListError, "error"); return; }

            const data = await response.json();
            const text = data.text || '';
            document.getElementById('shoppingListEditor').value = text;
            renderShoppingChecklist(text);
            const detail = document.getElementById('v1ShoppingDetail');
            if (detail) detail.style.display = '';
        }

        function renderShoppingChecklist(text) {
            const wrap = document.getElementById('shoppingChecklistWrap');
            if (!wrap) return;
            const lines = text.split('\n').filter(l => l.trim());
            if (!lines.length) { wrap.style.display = 'none'; return; }
            let html = '';
            let idx = 0;
            for (const line of lines) {
                const trimmed = line.trim();
                if (!trimmed.startsWith('-') && !trimmed.startsWith('â€¢') && !trimmed.match(/^\d/)) {
                    html += `<div class="shopping-check-group">${escapeHtml(trimmed.replace(/:$/, ''))}</div>`;
                } else {
                    const label = trimmed.replace(/^[-â€¢]\s*/, '');
                    html += `<label class="shopping-check-item" data-idx="${idx}">
                        <input type="checkbox" /><span>${escapeHtml(label)}</span>
                    </label>`;
                    idx++;
                }
            }
            wrap.innerHTML = html;
            wrap.style.display = '';
            wrap.querySelectorAll('input[type="checkbox"]').forEach(cb => {
                cb.addEventListener('change', () => {
                    cb.closest('.shopping-check-item').classList.toggle('is-checked', cb.checked);
                });
            });
        }

        function handlePlanPersonCountChange(forceNormalize) {
            const personInput = document.getElementById('planPersonCount');
            if (!personInput) return;

            if (forceNormalize) {
                const normalized = Math.max(1, parseInt(personInput.value || '1', 10) || 1);
                personInput.value = normalized;
            }

            scheduleNutritionUpdate();
            scheduleDraftSave();

            const shoppingEditor = document.getElementById('shoppingListEditor');
            if (shoppingEditor && shoppingEditor.value.trim().length > 0) {
                prepareShoppingList().catch(() => {
                    // noop: Fehler wird bereits in prepareShoppingList angezeigt.
                });
            }
        }

        function getCurrentPersonCount() {
            const personInput = document.getElementById('planPersonCount');
            if (!personInput) return 1;
            return Math.max(1, parseInt(personInput.value || '1', 10) || 1);
        }

        function setPersonCount(value) {
            const personInput = document.getElementById('planPersonCount');
            if (!personInput) return;
            const clamped = Math.max(1, Math.min(99, parseInt(value, 10) || 1));
            personInput.value = clamped;
            handlePlanPersonCountChange(true);
            syncPersonPresets();
