        function togglePlanNutrition() {
            const nutritionEl = document.getElementById('planNutrition');
            const toggle = document.getElementById('planNutritionToggle');
            if (!nutritionEl || !toggle) return;

            const isCollapsed = nutritionEl.classList.contains('is-collapsed');
            nutritionEl.classList.toggle('is-collapsed', !isCollapsed);
            toggle.setAttribute('aria-expanded', isCollapsed ? 'true' : 'false');
        }

        function toggleDayNutrition(dayIndex) {
            const nutritionEl = document.querySelector(`.day-nutrition[data-day-index="${dayIndex}"]`);
            const toggle = document.querySelector(`.day-nutrition-toggle[data-day-index="${dayIndex}"]`);
            if (!nutritionEl || !toggle) return;

            const isCollapsed = nutritionEl.classList.contains('is-collapsed');
            nutritionEl.classList.toggle('is-collapsed', !isCollapsed);
            toggle.setAttribute('aria-expanded', isCollapsed ? 'true' : 'false');
        }

        function getDayRecipeIds(dayIndex) {
            const ids = [];
            Object.keys(weeklyPlanData).forEach(key => {
                const [dayKey] = key.split('-').map(Number);
                if (dayKey !== dayIndex) return;
                const item = weeklyPlanData[key];
                if (!item || !item.recipeId || item.recipeId === '0') return;
                const parsed = parseInt(item.recipeId, 10);
                if (Number.isFinite(parsed)) ids.push(parsed);
            });
            return ids;
        }

        async function updateDayNutritionTotals() {
            const personCount = parseInt(document.getElementById('planPersonCount')?.value || "1", 10) || 1;
            const paramsBase = new URLSearchParams();
            paramsBase.append('personCount', personCount);

            await Promise.all(days.map(async (_, dayIndex) => {
                const statusEl = document.getElementById(`dayNutritionStatus-${dayIndex}`);
                const recipeIds = getDayRecipeIds(dayIndex);
                if (recipeIds.length === 0) {
                    if (statusEl) statusEl.textContent = 'Keine Rezepte';
                    setDayNutritionTotals(dayIndex, null);
                    return;
                }

                if (statusEl) statusEl.textContent = 'Lädt...';

                const params = new URLSearchParams(paramsBase);
                recipeIds.forEach(id => params.append('recipeIds', id));

                try {
                    const response = await fetch(`/WorldMiniApp/Home/GetMealPlanNutritionTotals?${params.toString()}`);
                    if (!response.ok) throw new Error('Day nutrition fetch failed');
                    const data = await response.json();
                    setDayNutritionTotals(dayIndex, data);
                    if (statusEl) statusEl.textContent = 'Aktuell';
                } catch (error) {
                    console.error("Tagesnährwerte konnten nicht geladen werden.", error);
                    setDayNutritionTotals(dayIndex, null);
                    if (statusEl) statusEl.textContent = 'Fehler';
                }
            }));
        }

        async function updatePlanNutritionTotals() {
            const statusEl = document.getElementById('planNutritionStatus');
            const payload = buildMealPlanPayload();
            const recipeIds = getPlanRecipeIds(payload);
            const personCount = parseInt(document.getElementById('planPersonCount')?.value || "1", 10) || 1;

            if (recipeIds.length === 0) {
                if (statusEl) statusEl.textContent = 'Keine Rezepte';
                setNutritionTotals(null);
                return;
            }

            if (statusEl) statusEl.textContent = 'Lädt...';

            const params = new URLSearchParams();
            recipeIds.forEach(id => params.append('recipeIds', id));
            params.append('personCount', personCount);

            try {
                const response = await fetch(`/WorldMiniApp/Home/GetMealPlanNutritionTotals?${params.toString()}`);
                if (!response.ok) throw new Error('Nutrition fetch failed');
                const data = await response.json();
                setNutritionTotals(data);
                if (statusEl) statusEl.textContent = 'Aktuell';
            } catch (error) {
                console.error("Nährwerte konnten nicht geladen werden.", error);
                setNutritionTotals(null);
                if (statusEl) statusEl.textContent = 'Fehler';
            }
        }

        function generateShareLink() {
            const text = (document.getElementById('shoppingListEditor')?.value || '').trim();
            if (!text) { alert("Bitte zuerst eine Einkaufsliste laden oder einfügen."); return; }

            const shareLink = `${window.location.origin}/WorldMiniApp/Home/ShareShoppingList?list=${encodeURIComponent(text)}`;
            document.getElementById('shoppingShareLink').value = shareLink;
        }

        async function copyShareLink() {
            const linkInput = document.getElementById('shoppingShareLink');
            if (!linkInput.value) generateShareLink();
            if (linkInput.value) {
                await navigator.clipboard.writeText(linkInput.value);
                alert("Link kopiert!");
            }
        }

        // hide settings on scroll down (inside modal body)
        let lastPlanScrollTop = 0;
        let planScrollTicking = false;
        function attachPlanScrollBehavior() {
            const body = document.getElementById('planModalBody');
            if (!body) return;
            lastPlanScrollTop = body.scrollTop || 0;

            body.addEventListener('scroll', () => {
                if (planScrollTicking) return;
                planScrollTicking = true;

                requestAnimationFrame(() => {
                    const st = body.scrollTop || 0;
                    const delta = st - lastPlanScrollTop;
                    if (Math.abs(delta) < 6) { planScrollTicking = false; return; }

                    if (delta > 0 && st > 10) hidePlanTools();
                    else showPlanTools();

                    lastPlanScrollTop = st;
                    planScrollTicking = false;
                });
            }, { passive: true });
        }

        // ----------------- FEED: Autoplay + Sound + DoubleTap Like -----------------
        let isGlobalMuted = true;
        let hasUserInteracted = false;
        const qualifiedWatchThresholdMs = 8000;
        const clipWatchStates = new Map();
        const watchTrackingEndpoint = '/WorldMiniApp/WatchAnalytics/TrackClipWatch';

        function updateSoundIcon(container, isMuted) {
            const icon = container?.querySelector('.sound-toggle i');
            if (!icon) return;
            if (isMuted) {
                icon.classList.remove('bi-volume-up-fill');
                icon.classList.add('bi-volume-mute-fill');
            } else {
                icon.classList.remove('bi-volume-mute-fill');
                icon.classList.add('bi-volume-up-fill');
            }
        }

        function getClipWatchState(container) {
            const key = container?.dataset?.postingId;
            if (!key) return null;

            if (!clipWatchStates.has(key)) {
                clipWatchStates.set(key, {
                    accumulatedMs: 0,
                    activeSinceMs: null,
                    sessionStartedAtMs: null
                });
            }

            return clipWatchStates.get(key);
        }

        function startClipWatch(container) {
            const state = getClipWatchState(container);
            if (!state || state.activeSinceMs !== null) return;

            const now = Date.now();
            state.activeSinceMs = now;
            state.sessionStartedAtMs ??= now;
        }

        function stopClipWatch(container) {
            const state = getClipWatchState(container);
            if (!state || state.activeSinceMs === null) return;

            state.accumulatedMs += Math.max(0, Date.now() - state.activeSinceMs);
            state.activeSinceMs = null;
        }

        function resetClipWatchState(state) {
            state.accumulatedMs = 0;
            state.activeSinceMs = null;
            state.sessionStartedAtMs = null;
        }

        function buildClipWatchFormData(container, state) {
            const postingId = container?.dataset?.postingId;
            if (!postingId) return null;

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const formData = new FormData();
            formData.append('postingId', postingId);
            formData.append('watchedSeconds', (state.accumulatedMs / 1000).toFixed(2).replace('.', ','));
            if (state.sessionStartedAtMs) {
                formData.append('sessionStartedAtUtc', new Date(state.sessionStartedAtMs).toISOString());
            }
            formData.append('sessionEndedAtUtc', new Date().toISOString());
            if (tokenInput) {
                formData.append('__RequestVerificationToken', tokenInput.value);
            }
            return formData;
        }

        function flushClipWatch(container, useBeacon = false) {
            stopClipWatch(container);

            const state = getClipWatchState(container);
            if (!state || state.accumulatedMs < qualifiedWatchThresholdMs) {
                return;
            }

            const formData = buildClipWatchFormData(container, state);
            if (!formData) {
                return;
            }

            resetClipWatchState(state);

            if (useBeacon && navigator.sendBeacon) {
                navigator.sendBeacon(watchTrackingEndpoint, formData);
                return;
            }

            fetch(watchTrackingEndpoint, {
                method: 'POST',
                body: formData,
                keepalive: true
            }).catch(error => console.error('Watch tracking failed', error));
        }

        function unlockAudio() {
            if (hasUserInteracted) return;
            hasUserInteracted = true;
            isGlobalMuted = false;

            document.querySelectorAll('.feed-item video').forEach(v => v.muted = false);
            document.querySelectorAll('.feed-item').forEach(item => updateSoundIcon(item, false));

            document.removeEventListener('click', unlockAudio);
            document.removeEventListener('touchstart', unlockAudio);
        }

        document.addEventListener('click', unlockAudio, { passive: true });
        document.addEventListener('touchstart', unlockAudio, { passive: true });

        document.addEventListener('DOMContentLoaded', () => {
            applyPlanThemeFromProfile();
            const personInput = document.getElementById('planPersonCount');
            if (personInput) {
                personInput.addEventListener('input', handlePlanPersonCountChange);
                personInput.addEventListener('change', handlePlanPersonCountChange);
            }
            const nutritionToggle = document.getElementById('planNutritionToggle');
            if (nutritionToggle) {
                nutritionToggle.addEventListener('click', togglePlanNutrition);
            }
            const planContainer = document.getElementById('planContainer');
            if (planContainer) {
                planContainer.addEventListener('click', (event) => {
                    const toggle = event.target.closest('.day-nutrition-toggle');
                    if (!toggle) return;
                    const dayIndex = toggle.dataset.dayIndex;
                    if (dayIndex === undefined) return;
                    toggleDayNutrition(Number(dayIndex));
                });
            }
        });

        document.addEventListener('visibilitychange', () => {
            if (!document.hidden) return;
            document.querySelectorAll('.feed-item').forEach(item => flushClipWatch(item, true));
        });

        window.addEventListener('pagehide', () => {
            document.querySelectorAll('.feed-item').forEach(item => flushClipWatch(item, true));
        });

        function toggleGlobalSound(btn) {
            hasUserInteracted = true;
            isGlobalMuted = !isGlobalMuted;

            const container = btn.closest('.feed-item');
            const video = container?.querySelector('video');
            if (video) video.muted = isGlobalMuted;

            updateSoundIcon(container, isGlobalMuted);
        }

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                const container = entry.target;
                const video = container.querySelector('video');

                if (entry.isIntersecting) {
                    if (video) {
                        video.muted = isGlobalMuted;
                        updateSoundIcon(container, isGlobalMuted);
                        video.play().then(() => {
                            container.classList.remove('paused');
                            startClipWatch(container);
                        }).catch(() => {});
                    } else {
                        startClipWatch(container);
                    }
                } else {
                    if (video) {
                        video.pause();
                    }
                    flushClipWatch(container);
                }
            });
        }, { threshold: 0.6 });

        async function sendLikeToBackend(recipeId) {
            const userHash = getUserHash();
            if (!userHash || !recipeId) return;

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : null;

            const formData = new FormData();
            formData.append('userHash', userHash);
            formData.append('recipeId', recipeId);
            if (token) formData.append('__RequestVerificationToken', token);

            try { await fetch('/WorldMiniApp/Feed/ToggleLike', { method: 'POST', body: formData }); }
            catch (e) { console.error(e); }
        }

        function togglePlayPause(container) {
            const video = container.querySelector('video');
            if (!video) return;
            if (video.paused) { video.play().catch(()=>{}); container.classList.remove('paused'); }
            else { video.pause(); container.classList.add('paused'); }
        }

        function triggerLike(container) {
            const recipeId = container.dataset.id;
            if (recipeId) sendLikeToBackend(recipeId);

            const heartBtn = container.querySelector('.heart-btn');
            const bigHeart = container.querySelector('.double-tap-heart');

            if (heartBtn) heartBtn.classList.toggle('liked');

            if (bigHeart) {
                bigHeart.style.display = 'block';
                bigHeart.classList.remove('animate');
                void bigHeart.offsetWidth;
                bigHeart.classList.add('animate');
                setTimeout(() => bigHeart.classList.remove('animate'), 800);
            }
        }

        function attachFeedHandlers() {
            document.querySelectorAll('.feed-item').forEach(item => observer.observe(item));

            document.querySelectorAll('.feed-item video').forEach(video => {
                const container = video.closest('.feed-item');
                if (!container) return;

                video.addEventListener('play', () => startClipWatch(container));
                video.addEventListener('pause', () => stopClipWatch(container));
                video.addEventListener('ended', () => flushClipWatch(container));
                video.addEventListener('waiting', () => stopClipWatch(container));
            });

            document.querySelectorAll('.feed-item').forEach(item => {
                let lastTap = 0;
                let tapTimeout = null;

                item.addEventListener('click', function (e) {
                    if (e.target.closest('.action-btn') ||
                        e.target.closest('.sound-toggle') ||
                        e.target.closest('.chef-badge') ||
                        e.target.closest('.modal')) return;

                    const now = Date.now();
                    const tapLen = now - lastTap;

                    if (tapLen < 300 && tapLen > 0) {
                        clearTimeout(tapTimeout);
                        triggerLike(this);
                        lastTap = 0;
                    } else {
                        lastTap = now;
                        tapTimeout = setTimeout(() => togglePlayPause(this), 300);
                    }
                });
            });

            document.querySelectorAll('.heart-btn').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const container = this.closest('.feed-item');
                    const recipeId = container?.dataset?.id;
                    if (recipeId) sendLikeToBackend(recipeId);
                    this.classList.toggle('liked');
                });
            });
        }

        // ----------------- FOLLOW (fix event global) -----------------
        async function toggleFollow(e, btn, creatorId) {
            if (e) e.stopPropagation();
            const userHash = getUserHash();
            if (!userHash) { console.warn("Nicht eingeloggt!"); return; }

            const icon = btn.querySelector('i');
            const isFollowing = icon.classList.contains('bi-check-lg');

            if (isFollowing) {
                icon.classList.remove('bi-check-lg');
                icon.classList.add('bi-person-plus-fill');
                btn.style.color = "white";
            } else {
                icon.classList.remove('bi-person-plus-fill');
                icon.classList.add('bi-check-lg');
                btn.style.color = "#4cd137";
            }

            const formData = new FormData();
            formData.append('userHash', userHash);
            formData.append('creatorId', creatorId);

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (tokenInput) formData.append('__RequestVerificationToken', tokenInput.value);

            try { await fetch('/WorldMiniApp/Feed/ToggleFollow', { method: 'POST', body: formData }); }
            catch (error) { console.error("Netzwerkfehler:", error); }
        }


        (function enableHorizontalSwipe() {
            const feedContainer = document.getElementById('feedContainer');
            if (!feedContainer) return;

            let touchStartX = 0;
            let touchStartY = 0;

            feedContainer.addEventListener('touchstart', (event) => {
                const touch = event.changedTouches?.[0];
                if (!touch) return;
                touchStartX = touch.clientX;
                touchStartY = touch.clientY;
            }, { passive: true });

            feedContainer.addEventListener('touchend', (event) => {
                const touch = event.changedTouches?.[0];
                if (!touch) return;

                const deltaX = touch.clientX - touchStartX;
                const deltaY = touch.clientY - touchStartY;

                if (Math.abs(deltaX) < 50 || Math.abs(deltaX) < Math.abs(deltaY)) return;

                if (deltaX < 0) {
                    syncMarketplaceToCurrentFeedItem();
                    setSection('marketplace');
                } else {
                    setSection('feed');
                }
            }, { passive: true });
        })();


        async function loadFeedWldPrice() {
            if (!window.worldChainMarketplace?.fetchWldPrice) return;
            feedWldPriceUsd = await window.worldChainMarketplace.fetchWldPrice();
            updateFeedPrices();
        }

        function setFeedToken(token, listingId = null) {
            const selected = token === 'USDCE' ? 'USDCE' : 'WLD';

            if (listingId) {
                const el = document.getElementById(`feedPrice-${listingId}`);
                if (!el) return;
                const wld = parseFloat(el.dataset.priceWld || '0');
                el.textContent = selected === 'USDCE' && feedWldPriceUsd
                    ? `${(wld * feedWldPriceUsd).toFixed(2)} USDCE`
                    : `${wld} WLD`;
                return;
            }

            feedSelectedPaymentToken = selected;
            document.querySelectorAll('.feed-token-switch').forEach(sw => { sw.checked = feedSelectedPaymentToken === 'USDCE'; });
            updateFeedPrices();
        }

        function updateFeedPrices() {
            document.querySelectorAll('[id^="feedPrice-"]').forEach(el => {
                const wld = parseFloat(el.dataset.priceWld || '0');
                if (feedSelectedPaymentToken === 'USDCE' && feedWldPriceUsd) {
                    el.textContent = `${(wld * feedWldPriceUsd).toFixed(2)} USDCE`;
                } else {
                    el.textContent = `${wld} WLD`;
                }
            });
        }

        async function ensureFeedWalletConnected() {
            const stored = feedWalletAddresses.WLD || feedWalletAddresses.USDCE;
            if (stored) return stored;
            let address = '';
            const ethereumProvider = window.worldChainMarketplace?.getEthereumProvider?.();
            if (ethereumProvider && window.worldChainMarketplace?.connectWallet) address = await window.worldChainMarketplace.connectWallet();
            if (!address && window.connectWalletOnly) address = await window.connectWalletOnly();
            if (!address) throw new Error('Wallet-Verbindung fehlgeschlagen.');
            feedWalletAddresses.WLD = address;
            feedWalletAddresses.USDT = address;
            feedWalletAddresses.USDCE = address;
            return address;
        }

        async function finalizeFeedPurchase(listingId, txHash, walletAddress, paymentToken) {
            const form = new FormData();
            form.append('ListingId', listingId);
            form.append('TxHash', txHash);
            form.append('WalletAddress', walletAddress || '');
            form.append('PaymentToken', paymentToken || 'WLD');
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (tokenInput) form.append('__RequestVerificationToken', tokenInput.value);
            const resp = await fetch('/WorldMiniApp/Marketplace/FinalizeWorldChainPurchase', { method: 'POST', body: form });
            return resp.json();
        }

        async function buyFeedListing(listingId, title, priceWld, sellerWallet) {
            if (!FEED_USER_HASH) { alert('Bitte zuerst einloggen.'); return; }
            if (!sellerWallet) { alert('Verkäufer-Wallet fehlt.'); return; }
            const token = feedSelectedPaymentToken;
            const actualPrice = token === 'USDCE' && feedWldPriceUsd ? parseFloat((priceWld * feedWldPriceUsd).toFixed(2)) : priceWld;
            if (token === 'USDCE' && !feedWldPriceUsd) { alert('WLD/USD Kurs fehlt.'); return; }

            try {
                await ensureFeedWalletConnected();
                if (window.startMiniKitPayment) {
                    const payResult = await window.startMiniKitPayment({
                        to: sellerWallet, tokenSymbol: token, amount: actualPrice,
                        reference: `feed-listing-${listingId}-${Date.now()}`,
                        description: `Essensplan: ${title}`
                    });
                    const txRef = payResult?.transaction_id || payResult?.txHash || `feed-${listingId}-${Date.now()}`;
                    const data = await finalizeFeedPurchase(listingId, txRef, sellerWallet, token);
                    if (data.success) { return; }
                    alert(data.error || 'Kauf konnte nicht finalisiert werden.');
                    return;
                }
                alert('Kein Zahlungsweg verfügbar.');
            } catch (e) {
                alert(e?.message || 'Kauf fehlgeschlagen.');
            }
        }

        async function showFeedPreview(listingId) {
            const titleEl = document.getElementById('feedPreviewTitle');
            const bodyEl = document.getElementById('feedPreviewBody');
            if (titleEl) titleEl.textContent = 'Plan-Vorschau';
            if (bodyEl) bodyEl.innerHTML = '<div class="text-center py-4">Lade Vorschau...</div>';

            const offcanvas = new bootstrap.Offcanvas(document.getElementById('feedPreviewOffcanvas'));
            offcanvas.show();

            try {
                const resp = await fetch(`/WorldMiniApp/Marketplace/GetListingPreview?listingId=${listingId}`);
                const data = await resp.json();
                if (!data.success) { bodyEl.innerHTML = '<p class="small text-danger">Vorschau nicht verfügbar.</p>'; return; }
                if (titleEl) titleEl.textContent = data.title || 'Plan-Vorschau';
                let html = '';
                if (data.description) {
                    html += `<p class="small mb-2">${data.description}</p>`;
                }
                if (data.nutrition) {
                    html += `<p class="small mb-2">kcal: ${Math.round(data.nutrition.calories)} · Protein: ${data.nutrition.protein}g · Fett: ${data.nutrition.fat}g · KH: ${data.nutrition.carbs}g</p>`;
                }
                if (data.days?.length) {
                    data.days.forEach(day => {
                        html += `<div class="fw-bold mt-2">Tag ${day.day}</div>`;
                        (day.recipes || []).forEach(r => {
                            html += `<div class="small opacity-75">• ${r.title}</div>`;
                        });
                    });
                }
                bodyEl.innerHTML = html || '<p class="small">Keine Vorschau verfügbar.</p>';
            } catch (e) {
                bodyEl.innerHTML = '<p class="small text-danger">Vorschau konnte nicht geladen werden.</p>';
            }
        }

        // ----------------- init -----------------
        document.addEventListener('DOMContentLoaded', () => {
            attachFeedHandlers();
            attachPlanScrollBehavior();
            loadDraft();
            renderPlan();
            updatePlanModeHeader();
            setSection('feed');
            syncMarketplaceToCurrentFeedItem();
            setFeedToken('WLD');
            loadFeedWldPrice();
        });
    </script>

</body>
</html>





