        function timeAgo(dateStr) {
            if (!dateStr) return '';
            const diff = (Date.now() - new Date(dateStr).getTime()) / 1000;
            if (diff < 60) return '@SharedLocalizer["Feed.TimeNow"]';
            if (diff < 3600) return `${Math.floor(diff / 60)} Min.`;
            if (diff < 86400) return `${Math.floor(diff / 3600)} @SharedLocalizer["Feed.TimeHours"]`;
            if (diff < 604800) return `${Math.floor(diff / 86400)} @SharedLocalizer["Feed.TimeDays"]`;
            return new Date(dateStr).toLocaleDateString();
        }

        function highlightMentions(text) {
            return escapeHtml(text).replace(/@@(\w+)/g, '<span class="mention">@@$1</span>');
        }

        const _heartOutlineSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>';
        const _heartFilledSvg = '<svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>';
        const _pinSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 17v5"/><path d="M5 17h14"/><path d="M15 3.5L9 3.5 8 9.5 5 12h14l-3-2.5L15 3.5z"/></svg>';
        const _verifiedSvg = '<svg viewBox="0 0 24 24" fill="#059669"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>';

        function renderSingleComment(item, isReply = false) {
            const name = item?.userName || 'User';
            const initial = name.charAt(0).toUpperCase();
            const avatarBg = getAvatarColor(name);
            const myReaction = (item?.myReaction || '').toLowerCase();
            const isLiked = myReaction === 'like';
            const canReact = !!activeCommentsState.canReactOrReport;
            const canDelete = !!item?.canDelete;
            const canPin = !!activeCommentsState.canPin && !isReply;
            const replyTargetId = item?.parentCommentId || item?.id || 0;
            const hiddenCls = item?.isAutoHidden ? ' is-auto-hidden' : '';
            const isVerified = (item?.verificationLevel || '').toLowerCase() === 'orb';
            const isCreator = !!item?.isCreator;
            const isPinned = !!item?.isPinned;
            const likeCount = item?.likeCount || 0;

            const pinnedHtml = isPinned
                ? `<div class="comment-pinned-label">${_pinSvg} @T("Angeheftet vom Creator", "Pinned by creator", "Fijado por el creador", "Fixado pelo criador")</div>`
                : '';

            const verifiedHtml = isVerified
                ? `<span class="comment-verified-badge">${_verifiedSvg}</span>`
                : '';

            const creatorBadgeHtml = isCreator
                ? `<span class="comment-creator-badge">${i18n.creator}</span>`
                : '';

            const likeText = likeCount > 0 ? `<span>${likeCount}</span>` : '';

            const deleteHtml = canDelete
                ? `<button class="comment-delete-text" onclick="event.stopPropagation(); deleteComment(${item?.id || 0});">@T("Loeschen", "Delete", "Eliminar", "Apagar")</button>`
                : '';

            const pinHtml = canPin
                ? `<button class="comment-pin-btn" onclick="event.stopPropagation(); pinComment(${item?.id || 0});">${isPinned ? '@T("Loslösen", "Unpin", "Desfijar", "Desafixar")' : '@T("Anheften", "Pin", "Fijar", "Fixar")'}</button>`
                : '';

            let repliesHtml = '';
            const replies = Array.isArray(item?.replies) ? item.replies : [];
            if (replies.length > 0) {
                const replyItems = replies.map(r => renderSingleComment(r, true)).join('');
                const toggleId = `replies-${item?.id || 0}`;
                const toggleBtnId = `replies-toggle-${item?.id || 0}`;
                const hidden = replies.length > 1 ? ' is-hidden' : '';
                const toggleBtn = replies.length > 1
                    ? `<button class="comment-replies-toggle" id="${toggleBtnId}" onclick="toggleReplies(${item?.id || 0}, ${replies.length})">${replies.length} @T("Antworten anzeigen", "View replies", "Ver respuestas", "Ver respostas")</button>`
                    : '';
                repliesHtml = `${toggleBtn}<div class="comment-replies${hidden}" id="${toggleId}">${replyItems}</div>`;
            }

            return `
                <div class="comment-item${isReply ? ' is-reply' : ''}${hiddenCls}" data-comment-id="${item?.id || 0}">
                    <div class="comment-avatar" style="background:${avatarBg}">${initial}</div>
                    <div class="comment-content">
                        ${pinnedHtml}
                        <div class="comment-meta">
                            <span class="comment-user">${escapeHtml(name)}</span>
                            ${verifiedHtml}
                            ${creatorBadgeHtml}
                            <span class="comment-time">${timeAgo(item?.createdAtUtc)}</span>
                        </div>
                        <div class="comment-text">${highlightMentions(item?.text || '')}</div>
                        <div class="comment-actions">
                            <button class="comment-heart-btn${isLiked ? ' is-liked' : ''}" ${canReact ? '' : 'disabled'} onclick="event.stopPropagation(); toggleCommentReaction(${item?.id || 0}, 'like');">
                                ${isLiked ? _heartFilledSvg : _heartOutlineSvg}
                                ${likeText}
                            </button>
                            <button class="comment-reply-btn" ${activeCommentsState.canWrite ? '' : 'disabled'} onclick="event.stopPropagation(); setReplyTarget(${replyTargetId}, '${escapeJsString(name)}');">@T("Antworten", "Reply", "Responder", "Responder")</button>
                            ${deleteHtml}
                            ${pinHtml}
                        </div>
                        ${repliesHtml}
                    </div>
                </div>`;
        }

        function renderComments(items) {
            const list = document.getElementById('commentsList');
            const empty = document.getElementById('commentsEmpty');
            if (!list || !empty) return;

            if (!Array.isArray(items) || items.length === 0) {
                list.innerHTML = '';
                empty.style.display = '';
                return;
            }

            empty.style.display = 'none';
            list.innerHTML = items.map(item => renderSingleComment(item, false)).join('');
        }

        function focusCommentAnchor(commentId) {
            if (!commentId) return;
            const target = document.querySelector(`#commentsList .comment-item[data-comment-id="${commentId}"]`);
            if (!target) return;
            target.scrollIntoView({ block: 'center', behavior: 'smooth' });
            target.classList.add('is-burst');
            window.setTimeout(() => target.classList.remove('is-burst'), 900);
        }

        async function loadComments(postingId) {
            const meta = document.getElementById('commentsMetaText');
            const input = document.getElementById('commentInput');
            const submitBtn = document.getElementById('commentSubmitBtn');
            if (meta) meta.textContent = '@T("Lade Kommentare...", "Loading comments...", "Cargando comentarios...", "Carregando comentários...")';

            const response = await fetch(`/WorldMiniApp/Feed/GetComments?postingId=${encodeURIComponent(postingId)}&sort=${encodeURIComponent(activeCommentsSort)}`, {
                method: 'GET',
                headers: { 'Accept': 'application/json' }
            });
            const payload = await response.json();
            if (!response.ok || !payload?.success) {
                throw new Error(payload?.message || 'Kommentare konnten nicht geladen werden.');
            }

            activeCommentsState = {
                canWrite: !!payload.canWrite,
                canReactOrReport: !!payload.canReactOrReport,
                canPin: !!payload.canPin,
                isLoggedIn: !!payload.isLoggedIn
            };
            activeCommentsSort = payload?.sort === 'new' ? 'new' : 'top';
            document.getElementById('commentSortTopBtn')?.classList.toggle('active', activeCommentsSort === 'top');
            document.getElementById('commentSortNewBtn')?.classList.toggle('active', activeCommentsSort === 'new');
            renderComments(payload.items || []);
            if (activeCommentAnchorId) {
                const anchorId = activeCommentAnchorId;
                activeCommentAnchorId = 0;
                window.setTimeout(() => focusCommentAnchor(anchorId), 80);
            }
            syncCommentCount(postingId, payload.commentCount || 0);

            if (meta) {
                const cnt = payload.commentCount || 0;
                meta.textContent = cnt === 1
                    ? '1 @T("Kommentar", "Comment", "Comentario", "Comentário")'
                    : `${cnt} @T("Kommentare", "Comments", "Comentarios", "Comentários")`;
            }

            if (input && submitBtn) {
                const canWrite = !!payload.canWrite;
                input.disabled = !canWrite;
                if (!canWrite) {
                    input.placeholder = '@T("Nur orb-verifizierte Nutzer koennen kommentieren.", "Only orb-verified users can comment.", "Solo usuarios verificados pueden comentar.", "Somente usuarios verificados podem comentar.")';
                }
            }
        }

        function burstCommentAction(commentId, selector) {
            const candidates = Array.from(document.querySelectorAll(selector));
            const button = candidates.find(x => (x.getAttribute('onclick') || '').includes(`(${commentId},`));
            if (!button) return;
            button.classList.remove('is-burst');
            void button.offsetWidth;
            button.classList.add('is-burst');
            window.setTimeout(() => button.classList.remove('is-burst'), 240);
        }

        async function toggleCommentReaction(commentId, reaction) {
            if (!commentId || !reaction) return;
            burstCommentAction(commentId, '.comment-heart-btn');

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            try {
                const formData = new FormData();
                formData.append('userHash', getUserHash() || '');
                formData.append('commentId', `${commentId}`);
                formData.append('reaction', reaction);
                if (tokenInput) formData.append('__RequestVerificationToken', tokenInput.value);

                const response = await fetch('/WorldMiniApp/Feed/ToggleCommentReaction', {
                    method: 'POST',
                    body: formData
                });
                const payload = await response.json().catch(() => null);
                if (!response.ok || !payload?.success) {
                    throw new Error(payload?.message || 'Reaktion konnte nicht gespeichert werden.');
                }

                await loadComments(activeCommentsPostingId);
            } catch (error) {
                showToast(error?.message || 'Reaktion konnte nicht gespeichert werden.', 'error');
            }
        }

        async function reportComment(commentId) {
            if (!commentId) return;

            const defaultReason = '@T("Unangemessener Kommentar", "Inappropriate comment", "Comentario inapropiado", "Comentario inadequado")';
            const reason = window.prompt('@T("Warum moechtest du diesen Kommentar melden?", "Why do you want to report this comment?", "Por que quieres reportar este comentario?", "Por que voce quer denunciar este comentario?")', defaultReason);
            if (reason === null) return;

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            try {
                const formData = new FormData();
                formData.append('userHash', getUserHash() || '');
                formData.append('commentId', `${commentId}`);
                formData.append('reason', (reason || '').trim());
                if (tokenInput) formData.append('__RequestVerificationToken', tokenInput.value);

                const response = await fetch('/WorldMiniApp/Feed/ReportComment', {
                    method: 'POST',
                    body: formData
                });
                const payload = await response.json().catch(() => null);
                if (!response.ok || !payload?.success) {
                    throw new Error(payload?.message || 'Kommentar konnte nicht gemeldet werden.');
                }

                showToast('@T("Kommentar wurde gemeldet.", "Comment reported.", "Comentario reportado.", "Comentario denunciado.")', 'success');
                await loadComments(activeCommentsPostingId);
            } catch (error) {
                showToast(error?.message || 'Kommentar konnte nicht gemeldet werden.', 'error');
            }
        }

        function setReplyTarget(commentId, userName) {
            activeReplyTarget = {
                commentId: commentId || 0,
                userName: userName || 'User'
            };

            const replyTarget = document.getElementById('commentReplyTarget');
            const input = document.getElementById('commentInput');
            if (replyTarget) {
                replyTarget.style.display = '';
                replyTarget.innerHTML = `@T("Antwort an", "Replying to", "Respuesta a", "Respondendo a") <strong>${escapeHtml(activeReplyTarget.userName)}</strong> <button onclick="clearReplyTarget()">@T("Abbrechen", "Cancel", "Cancelar", "Cancelar")</button>`;
            }
            if (input) {
                input.value = `@@${userName} `;
                input.focus();
            }
        }

        function clearReplyTarget() {
            activeReplyTarget = null;
            const replyTarget = document.getElementById('commentReplyTarget');
            if (replyTarget) {
                replyTarget.style.display = 'none';
                replyTarget.innerHTML = '';
            }
        }

        function toggleReplies(commentId, count) {
            const el = document.getElementById(`replies-${commentId}`);
            const btn = document.getElementById(`replies-toggle-${commentId}`);
            if (!el) return;
            const hidden = el.classList.toggle('is-hidden');
            if (btn) {
                btn.textContent = hidden
                    ? `${count} @T("Antworten anzeigen", "View replies", "Ver respuestas", "Ver respostas")`
                    : '@T("Antworten ausblenden", "Hide replies", "Ocultar respuestas", "Ocultar respostas")';
            }
        }

        async function pinComment(commentId) {
            if (!commentId) return;
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            try {
                const formData = new FormData();
                formData.append('userHash', getUserHash() || '');
                formData.append('commentId', `${commentId}`);
                if (tokenInput) formData.append('__RequestVerificationToken', tokenInput.value);
                const response = await fetch('/WorldMiniApp/Feed/PinComment', { method: 'POST', body: formData });
                const payload = await response.json().catch(() => null);
                if (!response.ok || !payload?.success) throw new Error(payload?.message || 'Fehler');
                await loadComments(activeCommentsPostingId);
            } catch (error) {
                showToast(error?.message || '@T("Fehler beim Anheften.", "Error pinning comment.", "Error al fijar.", "Erro ao fixar.")', 'error');
            }
        }

        async function changeCommentSort(sort) {
            activeCommentsSort = sort === 'new' ? 'new' : 'top';
            if (activeCommentsPostingId) {
                await loadComments(activeCommentsPostingId);
            }
        }

        async function deleteComment(commentId) {
            if (!commentId) return;
            const ok = window.confirm('@T("Kommentar wirklich loeschen?", "Really delete this comment?", "Eliminar realmente este comentario?", "Apagar realmente este comentario?")');
            if (!ok) return;

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            try {
                const formData = new FormData();
                formData.append('userHash', getUserHash() || '');
                formData.append('commentId', `${commentId}`);
                if (tokenInput) formData.append('__RequestVerificationToken', tokenInput.value);

                const response = await fetch('/WorldMiniApp/Feed/DeleteComment', {
                    method: 'POST',
                    body: formData
                });
                const payload = await response.json().catch(() => null);
                if (!response.ok || !payload?.success) {
                    throw new Error(payload?.message || 'Kommentar konnte nicht geloescht werden.');
                }

                syncCommentCount(payload.postingId || activeCommentsPostingId, payload.commentCount || 0);
                showToast('@T("Kommentar geloescht.", "Comment deleted.", "Comentario eliminado.", "Comentario apagado.")', 'success');
                await loadComments(activeCommentsPostingId);
            } catch (error) {
                showToast(error?.message || 'Kommentar konnte nicht geloescht werden.', 'error');
            }
        }

        async function openCommentsSheet(container) {
            const postingId = container?.dataset?.postingId;
            if (!postingId) return;
            activeCommentsPostingId = parseInt(postingId, 10);

            const modalEl = document.getElementById('commentsModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();

            const list = document.getElementById('commentsList');
            const empty = document.getElementById('commentsEmpty');
            const input = document.getElementById('commentInput');
            if (list) list.innerHTML = '';
            if (empty) empty.style.display = 'none';
            if (input) input.value = '';
            clearReplyTarget();

            await loadComments(activeCommentsPostingId);
        }

        // Send button activation + Enter key submit
        (function() {
            const input = document.getElementById('commentInput');
            const sendBtn = document.getElementById('commentSubmitBtn');
            if (input && sendBtn) {
                input.addEventListener('input', function() {
                    sendBtn.classList.toggle('is-active', this.value.trim().length > 0);
                });
                input.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' && !e.shiftKey && this.value.trim()) {
                        e.preventDefault();
                        submitComment();
                    }
                });
            }
        })();

        function tryOpenCommentsFromUrl() {
            const params = new URLSearchParams(window.location.search);
            const shouldOpenComments = params.get('openComments') === '1';
            const postingId = Number(params.get('postingId') || 0) || 0;
            const commentId = Number(params.get('commentId') || 0) || 0;
            if (!shouldOpenComments || !postingId) return false;

            const target = document.querySelector(`#feedSection .feed-item[data-posting-id="${postingId}"]`);
            if (!target) return false;

            activeCommentAnchorId = commentId;
            window.setTimeout(() => openCommentsSheet(target), 120);

            params.delete('openComments');
            params.delete('postingId');
            params.delete('commentId');
            const cleaned = window.location.pathname + (params.toString() ? `?${params.toString()}` : '');
            history.replaceState(history.state, '', cleaned);
            return true;
        }

        async function submitComment() {
            if (!activeCommentsPostingId) return;

            const input = document.getElementById('commentInput');
            const submitBtn = document.getElementById('commentSubmitBtn');
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const text = (input?.value || '').trim();
            if (!text) return;

            if (submitBtn) submitBtn.disabled = true;
            try {
                const formData = new FormData();
                formData.append('userHash', getUserHash() || '');
                formData.append('postingId', `${activeCommentsPostingId}`);
                formData.append('text', text);
                if (activeReplyTarget?.commentId) {
                    formData.append('parentCommentId', `${activeReplyTarget.commentId}`);
                }
                if (tokenInput) formData.append('__RequestVerificationToken', tokenInput.value);

                const response = await fetch('/WorldMiniApp/Feed/AddComment', {
                    method: 'POST',
                    body: formData
                });
                const payload = await response.json().catch(() => null);
                if (!response.ok || !payload?.success) {
                    throw new Error(payload?.message || 'Kommentar konnte nicht gespeichert werden.');
                }

                if (input) input.value = '';
                clearReplyTarget();
                await loadComments(activeCommentsPostingId);
            } catch (error) {
                showToast(error?.message || 'Kommentar konnte nicht gespeichert werden.', 'error');
            } finally {
                if (submitBtn) submitBtn.disabled = false;
            }
        }

        // ========== REPORT FUNCTIONS ==========
        let selectedReportReason = '';

        function openReportModal(postingId) {
            const modal = new bootstrap.Modal(document.getElementById('reportModal'));
            document.getElementById('reportPostingId').value = postingId;
            document.getElementById('reportDescription').value = '';
            selectedReportReason = '';

            // Reset reason buttons
            document.querySelectorAll('.report-reason-btn').forEach(btn => {
                btn.classList.remove('active');
            });

            // Hide feedback
            const feedback = document.getElementById('reportFeedback');
            if (feedback) feedback.style.display = 'none';

            modal.show();
        }

        async function submitReport() {
            const postingId = document.getElementById('reportPostingId').value;
            const description = document.getElementById('reportDescription').value.trim();
            const submitBtn = document.getElementById('submitReportBtn');
            const feedback = document.getElementById('reportFeedback');

            if (!selectedReportReason) {
                feedback.className = 'alert alert-warning';
                feedback.textContent = '@T("Bitte wähle einen Grund aus.", "Please select a reason.", "Por favor selecciona una razón.", "Por favor selecione um motivo.")';
                feedback.style.display = 'block';
                return;
            }

            submitBtn.disabled = true;
            feedback.style.display = 'none';

            try {
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const response = await fetch('/WorldMiniApp/Feed/ReportPosting', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': tokenInput ? tokenInput.value : ''
                    },
                    body: JSON.stringify({
                        userHash: getUserHash() || '',
                        postingId: parseInt(postingId),
                        reason: selectedReportReason,
                        description: description
                    })
                });

                const result = await response.json();

                if (result.success) {
                    feedback.className = 'alert alert-success';
                    feedback.textContent = result.message || '@T("Vielen Dank für deine Meldung!", "Thank you for your report!", "¡Gracias por tu reporte!", "Obrigado pela sua denúncia!")';
                    feedback.style.display = 'block';

                    setTimeout(() => {
                        const modal = bootstrap.Modal.getInstance(document.getElementById('reportModal'));
                        if (modal) modal.hide();
                    }, 1500);
                } else {
                    feedback.className = 'alert alert-danger';
                    if (result.cooldown) {
                        feedback.textContent = result.message || '@T("Du hast zu viele Meldungen eingereicht. Bitte warte einen Moment.", "You have submitted too many reports. Please wait a moment.", "Has enviado demasiados reportes. Por favor espera un momento.", "Você enviou muitas denúncias. Por favor, aguarde um momento.")';
                    } else {
                        feedback.textContent = result.message || '@T("Fehler beim Senden der Meldung.", "Error sending report.", "Error al enviar el reporte.", "Erro ao enviar a denúncia.")';
                    }
                    feedback.style.display = 'block';
                }
            } catch (error) {
                feedback.className = 'alert alert-danger';
                feedback.textContent = '@T("Fehler beim Senden der Meldung.", "Error sending report.", "Error al enviar el reporte.", "Erro ao enviar a denúncia.")';
                feedback.style.display = 'block';
            } finally {
                submitBtn.disabled = false;
            }
        }

        // Initialize report reason button handlers
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.report-reason-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.report-reason-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    selectedReportReason = this.dataset.reason;
                });
            });
        });

        function attachFeedHandlers() {
            prepareExpandableTitles(document);
            document.querySelectorAll('.feed-item').forEach(item => {
                bindFeedItemState(item);
                observer.observe(item);
            });
            applyLiveCommentBadges(activeLiveCommentBadgeCounts);

            // When opening a recipe detail page, store current feed position first.
            document.querySelectorAll('#feedSection .feed-item a[aria-label="Rezept anzeigen"]').forEach(link => {
                if (link.dataset.feedStateBound === 'true') return;
                link.dataset.feedStateBound = 'true';
                link.addEventListener('click', (event) => {
                    const container = link.closest('.feed-item');
                    persistFeedState(container);
                }, { passive: true });
            });

            document.querySelectorAll('.feed-item video').forEach(video => {
                const container = video.closest('.feed-item');
                if (!container) return;

                video.addEventListener('play', () => startClipWatch(container));
                video.addEventListener('pause', () => stopClipWatch(container));
                video.addEventListener('ended', () => flushClipWatch(container));
                video.addEventListener('waiting', () => stopClipWatch(container));
            });

            document.querySelectorAll('.feed-item').forEach(item => {
                let lastTap = 0;
                let tapTimeout = null;

                item.addEventListener('click', function (e) {
                    if (e.target.closest('.action-btn') ||
                        e.target.closest('.sound-toggle') ||
                        e.target.closest('.chef-badge') ||
                        e.target.closest('.modal')) return;

                    const now = Date.now();
                    const tapLen = now - lastTap;

                    if (tapLen < 300 && tapLen > 0) {
                        clearTimeout(tapTimeout);
                        triggerLike(this);
                        lastTap = 0;
                    } else {
                        lastTap = now;
                        tapTimeout = setTimeout(() => togglePlayPause(this), 300);
                    }
                });
            });

            document.querySelectorAll('.heart-btn').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    triggerLike(this.closest('.feed-item'));
                });
            });
        }

        // ----------------- FOLLOW (fix event global) -----------------
        async function toggleFollow(e, btn, creatorId) {
            if (e) e.stopPropagation();
            const userHash = getUserHash();
            if (!userHash) { console.warn("Nicht eingeloggt!"); return; }

            const icon = btn.querySelector('i');
            const isFollowing = icon.classList.contains('bi-check-lg');

            if (isFollowing) {
                icon.classList.remove('bi-check-lg');
                icon.classList.add('bi-person-plus-fill');
                btn.style.color = "white";
            } else {
                icon.classList.remove('bi-person-plus-fill');
                icon.classList.add('bi-check-lg');
                btn.style.color = "#4cd137";
            }

            const formData = new FormData();
            formData.append('userHash', userHash);
            formData.append('creatorId', creatorId);

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (tokenInput) formData.append('__RequestVerificationToken', tokenInput.value);

            try { await fetch('/WorldMiniApp/Feed/ToggleFollow', { method: 'POST', body: formData }); }
            catch (error) { console.error("Netzwerkfehler:", error); }

            triggerHaptic();
        }


        (function enableHorizontalSwipe() {
            const feedContainer = document.getElementById('feedContainer');
            if (!feedContainer) return;

            let touchStartX = 0;
            let touchStartY = 0;

            feedContainer.addEventListener('touchstart', (event) => {
                const touch = event.changedTouches?.[0];
                if (!touch) return;
                touchStartX = touch.clientX;
                touchStartY = touch.clientY;
            }, { passive: true });

            feedContainer.addEventListener('touchend', (event) => {
                const touch = event.changedTouches?.[0];
                if (!touch) return;

                const deltaX = touch.clientX - touchStartX;
                const deltaY = touch.clientY - touchStartY;

                if (Math.abs(deltaX) < 50 || Math.abs(deltaX) < Math.abs(deltaY)) return;

                if (deltaX > 0) {
                    // Finger nach rechts
                    if (activeSection === 'marketplace') setSection('feed');
                    else if (activeSection === 'feed') setSection('creator');
                } else {
                    // Finger nach links
                    if (activeSection === 'creator') setSection('feed');
                    else if (activeSection === 'feed') setSection('marketplace');
                }
            }, { passive: true });
        })();


        async function loadFeedWldPrice() {
            if (!window.worldChainMarketplace?.fetchWldPrice) return;
            feedWldPriceUsd = await window.worldChainMarketplace.fetchWldPrice();
            updateFeedPrices();
        }

        function setFeedToken(token, listingId = null) {
            const selected = token === 'USDCE' ? 'USDCE' : 'WLD';

            if (listingId) {
                const el = document.getElementById(`feedPrice-${listingId}`);
                if (!el) return;
                const wld = parseFloat(el.dataset.priceWld || '0');
                el.textContent = selected === 'USDCE' && feedWldPriceUsd
                    ? `${(wld * feedWldPriceUsd).toFixed(2)} USDCE`
                    : `${wld} WLD`;
                return;
            }

            feedSelectedPaymentToken = selected;
            document.querySelectorAll('.feed-token-switch').forEach(sw => { sw.checked = feedSelectedPaymentToken === 'USDCE'; });
            updateFeedPrices();
        }

        function updateFeedPrices() {
            document.querySelectorAll('[id^="feedPrice-"]').forEach(el => {
                const wld = parseFloat(el.dataset.priceWld || '0');
                if (feedSelectedPaymentToken === 'USDCE' && feedWldPriceUsd) {
                    el.textContent = `${(wld * feedWldPriceUsd).toFixed(2)} USDCE`;
                } else {
                    el.textContent = `${wld} WLD`;
                }
            });
        }

        async function ensureFeedWalletConnected() {
            const stored = feedWalletAddresses.WLD || feedWalletAddresses.USDCE;
            if (stored) return stored;
            let address = '';
            const ethereumProvider = window.worldChainMarketplace?.getEthereumProvider?.();
            if (ethereumProvider && window.worldChainMarketplace?.connectWallet) address = await window.worldChainMarketplace.connectWallet();
            if (!address && window.connectWalletOnly) address = await window.connectWalletOnly();
            if (!address) throw new Error('Wallet-Verbindung fehlgeschlagen.');
            feedWalletAddresses.WLD = address;
            feedWalletAddresses.USDT = address;
            feedWalletAddresses.USDCE = address;

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const saveWalletToSession = async (token) => {
                const form = new FormData();
                form.append('walletAddress', address);
                form.append('token', token);
                if (tokenInput) form.append('__RequestVerificationToken', tokenInput.value);

                const resp = await fetch('/WorldMiniApp/Marketplace/SaveWalletAddress', {
                    method: 'POST',
                    body: form
                });

                if (!resp.ok) {
                    throw new Error(`Wallet konnte nicht fuer ${token} in der Session gespeichert werden.`);
                }
            };

            await saveWalletToSession('WLD');
            await saveWalletToSession('USDT');
            return address;
        }

        async function finalizeFeedPurchase(listingId, txHash, walletAddress, paymentToken) {
            const form = new FormData();
            form.append('ListingId', listingId);
            form.append('TxHash', txHash);
            form.append('WalletAddress', walletAddress || '');
            form.append('PaymentToken', paymentToken || 'WLD');
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (tokenInput) form.append('__RequestVerificationToken', tokenInput.value);
            const resp = await fetch('/WorldMiniApp/Marketplace/FinalizeWorldChainPurchase', { method: 'POST', body: form });
            return resp.json();
        }

        async function buyFeedListing(listingId, title, priceWld, sellerWallet) {
            if (!FEED_USER_HASH) { showToast('Bitte zuerst einloggen.', 'warn'); return; }
            if (!sellerWallet) { showToast('Verkäufer-Wallet fehlt.', 'error'); return; }
            const token = feedSelectedPaymentToken;
            const actualPrice = token === 'USDCE' && feedWldPriceUsd ? parseFloat((priceWld * feedWldPriceUsd).toFixed(2)) : priceWld;
            if (token === 'USDCE' && !feedWldPriceUsd) { showToast('WLD/USD Kurs fehlt.', 'error'); return; }

            try {
                const buyerWallet = await ensureFeedWalletConnected();
                if (window.startMiniKitPayment) {
                    const payResult = await window.startMiniKitPayment({
                        to: sellerWallet, tokenSymbol: token, amount: actualPrice,
                        reference: `feed-listing-${listingId}-${Date.now()}`,
                        description: `Essensplan: ${title}`
                    });
                    const txRef = payResult?.transaction_id || payResult?.txHash || `feed-${listingId}-${Date.now()}`;
                    const data = await finalizeFeedPurchase(listingId, txRef, buyerWallet, token);
                    if (data.success) { return; }
                    showToast(data.error || 'Kauf konnte nicht finalisiert werden.', 'error');
                    return;
                }
                showToast('Kein Zahlungsweg verfügbar.', 'error');
            } catch (e) {
                showToast(e?.message || 'Kauf fehlgeschlagen.', 'error');
            }
        }

        async function showFeedPreview(listingId) {
            const titleEl = document.getElementById('feedPreviewTitle');
            const bodyEl = document.getElementById('feedPreviewBody');
            if (titleEl) titleEl.textContent = 'Plan-Vorschau';
            if (bodyEl) bodyEl.innerHTML = '<div class="text-center py-4">Lade Vorschau...</div>';

            const offcanvas = new bootstrap.Offcanvas(document.getElementById('feedPreviewOffcanvas'));
            offcanvas.show();

            try {
                const resp = await fetch(`/WorldMiniApp/Marketplace/GetListingPreview?listingId=${listingId}`);
                const data = await resp.json();
                if (!data.success) { bodyEl.innerHTML = '<p class="small text-danger">Vorschau nicht verfügbar.</p>'; return; }
                if (titleEl) titleEl.textContent = data.title || 'Plan-Vorschau';
                let html = '';
                if (data.description) {
                    html += `<p class="small mb-2">${data.description}</p>`;
                }
                if (data.nutrition) {
                    html += `<p class="small mb-2">kcal: ${Math.round(data.nutrition.calories)} · Protein: ${data.nutrition.protein}g · Fett: ${data.nutrition.fat}g · KH: ${data.nutrition.carbs}g</p>`;
                }
                if (data.days?.length) {
                    data.days.forEach(day => {
                        html += `<div class="fw-bold mt-2">Tag ${day.day}</div>`;
                        (day.recipes || []).forEach(r => {
                            html += `<div class="small opacity-75">â€¢ ${r.title}</div>`;
                        });
                    });
                }
                bodyEl.innerHTML = html || '<p class="small">Keine Vorschau verfügbar.</p>';
            } catch (e) {
                bodyEl.innerHTML = '<p class="small text-danger">Vorschau konnte nicht geladen werden.</p>';
            }
        }

        // ----------------- Creator Feed -----------------
        let creatorFeedCache = { creatorHash: null, loaded: false };

        const creatorObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                const container = entry.target;
                const video = container.querySelector('video');
                if (entry.isIntersecting) {
                    if (video) {
                        video.muted = isGlobalMuted;
                        updateSoundIcon(container, isGlobalMuted);
                        video.play().catch(() => {});
                        container.classList.remove('paused');
                    }
                } else {
                    if (video) video.pause();
                }
            });
        }, { threshold: 0.6 });

        function buildCreatorFeedItemHtml(item) {
            const source = (item.source || '').toString();
            const sourceLower = source.toLowerCase();
            const isHlsVideo = sourceLower.includes('.m3u8');
            const isVideo = sourceLower.includes('.mp4')
                || sourceLower.includes('.mov')
                || sourceLower.includes('.webm')
                || isHlsVideo;
            const thumbOrSource = item.thumbnailUrl || item.source;
            const prepLabel = item.prepTime ? `${item.prepTime} min` : '';
            const safeTitle = escapeHtml(item.title || '');
            const safeCreatorName = escapeHtml(item.creatorName || '');
            const isLiked = !!(item.isLiked || window.likedRecipeIds?.has(item.recipeId));
            const isLikedCls = isLiked ? ' liked' : '';


            let mediaHtml;
            if (isVideo) {
                mediaHtml = `
                    <video class="feed-media" src="${item.source}" playsinline loop muted preload="metadata" ${isHlsVideo ? 'crossorigin="anonymous"' : ''} poster="${thumbOrSource}" data-video-kind="${isHlsVideo ? 'hls' : 'file'}">
                    </video>
                    <div class="video-caption-overlay is-empty" aria-hidden="true">
                        <div class="video-caption-text"></div>
                    </div>
                    <div class="video-progress"><div class="video-progress-fill"></div></div>
                    <i class="bi bi-play-fill play-icon-overlay"></i>`;
            } else {
                mediaHtml = `<img class="feed-media" src="${item.source}" alt="${safeTitle}" loading="lazy" />`;
            }

            return `
                <div class="feed-item" data-id="${item.recipeId}" data-posting-id="${item.postingId}" data-creator-id="${item.creatorId}" data-creator-name="${safeCreatorName}">
                    ${mediaHtml}
                    <div class="overlay-gradient"></div>
                    <button type="button"
                            class="feed-like-indicator${isLiked ? ' is-liked' : ''}"
                            aria-label="Like"
                            onclick="event.stopPropagation(); triggerLike(this.closest('.feed-item'));"
                            data-recipe-id="${item.recipeId}">
                        <i class="bi bi-heart-fill"></i>
                    </button>
                    ${isVideo ? `
                    <button type="button"
                            class="subtitle-toggle is-active"
                            aria-label="Untertitel"
                            aria-pressed="true"
                            onclick="event.stopPropagation(); toggleSubtitles(this.closest('.feed-item'));"
                            title="Untertitel">
                        <i class="bi bi-badge-cc-fill"></i>
                    </button>` : ''}
                    <i class="bi bi-heart-fill double-tap-heart"></i>
                    <div class="info-container">
                        <div class="chef-badge">
                            <span class="chef-name">${safeCreatorName}</span>
                        </div>
                        <div class="recipe-title" data-title-limit="58">${safeTitle}</div>
                        <button type="button" class="title-toggle-btn" onclick="event.stopPropagation(); toggleFeedTitle(this);">@T("Mehr", "More", "Más", "Mais")</button>
                        <div class="recipe-meta">${prepLabel}</div>
                    </div>
                    <div class="action-bar">
                        <div class="action-btn" role="button" aria-label="Rezeptinfo" onclick="event.stopPropagation(); openQuickPeek('${item.recipeId}')">
                            <div class="icon-circle"><i class="bi bi-info-lg"></i></div>
                            <span class="action-label">Info</span>
                        </div>
                        <div class="action-btn heart-btn${isLikedCls}" role="button" aria-label="Gefällt mir" data-recipe-id="${item.recipeId}" onclick="event.stopPropagation(); triggerLike(this.closest('.feed-item'));">
                            <div class="icon-circle"><i class="bi bi-heart-fill"></i></div>
                            <span class="action-label like-count">${item.likeCount || 0}</span>
                        </div>
                        <div class="action-btn comment-btn" role="button" aria-label="Kommentare" data-posting-id="${item.postingId}" onclick="event.stopPropagation(); openCommentsSheet(this.closest('.feed-item'));">
                            <span class="live-comment-badge" data-live-comment-badge="${item.postingId}">0</span>
                            <div class="icon-circle"><i class="bi bi-chat-dots-fill"></i></div>
                            <span class="action-label comment-count">${item.commentCount || 0}</span>
                        </div>
                        <div class="action-btn share-action-btn" role="button" aria-label="Teilen" onclick="event.stopPropagation(); shareRecipeFromButton(this);">
                            <div class="icon-circle"><i class="bi bi-share-fill"></i></div>
                            <span class="action-label">@SharedLocalizer["Feed.Share"]</span>
                        </div>
                        <div class="action-btn" role="button" aria-label="Zum Plan hinzufügen" onclick="openPlanModal('${safeTitle}', '${thumbOrSource}', '${item.recipeId}')">
                            <div class="icon-circle"><i class="bi bi-file-earmark-plus"></i></div>
                            <span class="action-label">@SharedLocalizer["Feed.AddToPlan"]</span>
                        </div>
                        <div class="action-btn" role="button" aria-label="Rezept anzeigen" onclick="window.location.href='/WorldMiniApp/Home/SharedRecipe/${item.recipeId}'">
                            <div class="icon-circle"><i class="bi bi-journal-text"></i></div>
                            <span class="action-label">@SharedLocalizer["Feed.Recipe"]</span>
                        </div>
                        <div class="action-btn report-btn" role="button" aria-label="Inhalt melden" data-posting-id="${item.postingId}" onclick="event.stopPropagation(); openReportModal(${item.postingId}, '${safeTitle}')">
                            <div class="icon-circle"><i class="bi bi-flag-fill"></i></div>
                            <span class="action-label">@SharedLocalizer["Feed.Report"]</span>
                        </div>
                    </div>
                </div>`;
        }

        function attachCreatorFeedHandlers() {
            const container = document.getElementById('creatorFeedItems');
            if (!container) return;

            prepareExpandableTitles(container);
            applyLiveCommentBadges(activeLiveCommentBadgeCounts);

            container.querySelectorAll('.feed-item').forEach(item => {
                bindFeedItemState(item);
                creatorObserver.observe(item);

                let lastTap = 0;
                let tapTimeout = null;
                item.addEventListener('click', function(e) {
                    if (e.target.closest('.action-btn') || e.target.closest('.sound-toggle') || e.target.closest('.chef-badge')) return;
                    const now = Date.now();
                    const tapLen = now - lastTap;
                    if (tapLen < 300 && tapLen > 0) {
                        clearTimeout(tapTimeout);
                        triggerLike(this);
                        lastTap = 0;
                    } else {
                        lastTap = now;
                        tapTimeout = setTimeout(() => togglePlayPause(this), 300);
                    }
                });
            });
        }

        async function loadCreatorFeedForCurrentItem(preContext) {
            const context = preContext || getCurrentFeedCreatorContext();
            if (!context) return;

            const { creatorHash, creatorName } = context;

            // Update header
            const nameEl = document.getElementById('creatorFeedName');
            if (nameEl) nameEl.textContent = creatorName || 'Creator';

            // Cache check: skip reload if same creator
            if (creatorFeedCache.creatorHash === creatorHash && creatorFeedCache.loaded) return;

            const itemsEl = document.getElementById('creatorFeedItems');
            const emptyEl = document.getElementById('creatorFeedEmpty');
            if (!itemsEl) return;

            // Pause any existing creator feed videos
            itemsEl.querySelectorAll('.feed-item').forEach(item => {
                creatorObserver.unobserve(item);
                const video = item.querySelector('video');
                if (video) video.pause();
            });

            // Show skeleton loader
            itemsEl.innerHTML = `
                <div class="skeleton-feed">
                    ${[1,2,3].map(() => `<div class="skeleton-card"><div class="skeleton-shimmer"></div></div>`).join('')}
                </div>`;
            if (emptyEl) emptyEl.style.display = 'none';

            try {
                const resp = await fetch(`/WorldMiniApp/Feed/CreatorPostings?creatorHash=${encodeURIComponent(creatorHash)}`);
                if (!resp.ok) throw new Error('Fetch failed');
                const postings = await resp.json();

                if (!postings.length) {
                    itemsEl.innerHTML = '';
                    if (emptyEl) emptyEl.style.display = '';
                    creatorFeedCache = { creatorHash, loaded: true };
                    return;
                }

                if (emptyEl) emptyEl.style.display = 'none';
                itemsEl.innerHTML = postings.map(buildCreatorFeedItemHtml).join('');
                attachCreatorFeedHandlers();
                initHlsVideos(itemsEl); // Initialize HLS for dynamically loaded videos
                creatorFeedCache = { creatorHash, loaded: true };
            } catch (e) {
                console.error('Creator feed load error:', e);
                itemsEl.innerHTML = `<div class="feed-error-retry">
                    <i class="bi bi-wifi-off" style="font-size:1.6rem;opacity:0.5;"></i>
                    <div style="font-size:0.85rem;opacity:0.7;margin:6px 0;">Laden fehlgeschlagen</div>
                    <button class="btn btn-sm btn-outline-light" onclick="creatorFeedCache.loaded=false; loadCreatorFeedForCurrentItem();">
                        <i class="bi bi-arrow-clockwise me-1"></i>Nochmal versuchen
                    </button>
                </div>`;
            }
        }

        // ----------------- init -----------------
        document.addEventListener('DOMContentLoaded', () => {
            attachFeedHandlers();
            attachPlanScrollBehavior();
            setupPullToRefresh();
            loadDraft();
            renderPlan();
            updatePlanModeHeader();
            setSection('feed');

            // Initialize HLS videos
            initHlsVideos();

            // Check for toast messages from URL parameter
            const params = new URLSearchParams(window.location.search);
            const toastType = params.get('toast');
            if (toastType) {
                // Clean URL
                const cleanUrl = window.location.pathname;
                window.history.replaceState({}, '', cleanUrl);

                // Show appropriate toast
                setTimeout(() => {
                    if (toastType === 'published') {
                        showToast('Rezept veröffentlicht!', 'success', 2500);
                    } else if (toastType === 'video-uploading') {
                        showToast('Video wird hochgeladen. Du erhältst eine Nachricht wenn es bereit ist.', 'info', 4000);
                    }
                }, 300);
            }

            // Restore scroll position when navigating back from the recipe detail page.
            setTimeout(() => {
                const restoredFromUrl = tryRestoreFeedScrollFromUrl();
                if (!restoredFromUrl) {
                    tryRestoreFeedScrollFromSession();
                }
                tryOpenCommentsFromUrl();
            }, 60);

            syncMarketplaceToCurrentFeedItem();
            setFeedToken('WLD');
            loadFeedWldPrice();

            // Bootstrap Tooltips initialisieren
            const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
        });

        // Funktion für Orb-Required Nachricht
        function showOrbRequiredMessage() {
            const toast = document.createElement('div');
            toast.className = 'position-fixed top-50 start-50 translate-middle';
            toast.style.zIndex = '9999';
            toast.innerHTML = `
                <div class="alert alert-warning shadow-lg rounded-4 p-4 text-center" style="max-width: 320px; border: 2px solid #ff9800;">
                    <div class="fs-1 mb-2">🔒</div>
                    <h5 class="fw-bold mb-2">Orb-Verifizierung erforderlich</h5>
                    <p class="mb-0 small">Video-Uploads sind nur für Orb-verifizierte User verfügbar.</p>
                </div>
            `;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.3s';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }
    </script>

