    <form id="wmAntiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

    @* Feed: show only a toast/notice (no bottom bar) *@
    @await Html.PartialAsync("_AiResumeBar", new ViewDataDictionary(ViewData) { ["AiResumeMode"] = "toast" })

    <script src="https://cdn.jsdelivr.net/npm/ethers@6.13.2/dist/ethers.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.15/dist/hls.min.js"></script>
    <script src="~/js/worldchain-marketplace.js"></script>
    <script type="module" src="~/js/minikitt.js"></script>
    @* <script type="module" src="~/js/agent-payment.js"></script> *@

    <script>
        const DEBUG = false; // Set to true for TTS and system debug logging

        // Translations
        const i18n = {
            creator: '@SharedLocalizer["Feed.Creator"]',
            chooseRecipe: '@SharedLocalizer["MealPlan.ChooseRecipe"]',
            shoppingListError: '@SharedLocalizer["MealPlan.ShoppingListError"]',
            shoppingListLoadFirst: '@SharedLocalizer["MealPlan.ShoppingListLoadFirst"]',
            shoppingListTitle: '@SharedLocalizer["MealPlan.ShoppingListTitle"]',
            shoppingListShare: '@SharedLocalizer["MealPlan.ShoppingListShare"]',
            nutritionError: '@SharedLocalizer["MealPlan.NutritionError"]'
        };

        window.worldChainMarketplaceConfig = {
            chainId: Number('@worldChainId'),
            wldTokenAddress: '@worldChainWldToken',
            usdtTokenAddress: '@worldChainUsdtToken',
            marketplaceAddress: '@worldChainMarketplace',
            testMode: @(worldChainTestMode ? "true" : "false")
        };

        let feedSelectedPaymentToken = 'WLD';
        let feedWldPriceUsd = null;
        let feedWalletAddresses = { WLD: '@walletWLD', USDT: '@walletUSDT', USDCE: '@walletUSDT' };
        const FEED_USER_HASH = '@userHash';
        const feedRefreshThresholdPx = 84;
        const FEED_CAN_WRITE_COMMENTS = @(canWriteComments ? "true" : "false");
        window.likedRecipeIds = new Set(@Html.Raw(Json.Serialize(likedRecipeIds)));
        let activeCommentsPostingId = 0;
        let activeCommentsSort = 'top';
        let activeReplyTarget = null;
        let activeCommentAnchorId = 0;
        let activeLiveCommentBadgeCounts = {};
        let activeCommentsState = {
            canWrite: FEED_CAN_WRITE_COMMENTS,
            canReactOrReport: false,
            isLoggedIn: false
        };

        // Lightweight notifications overlay (client-only).
        try {
            window.WorldMiniAppNotify?.initFeedOverlay?.({
                buttonId: 'wmNotifyBtn',
                badgeId: 'wmNotifyBadge',
                canvasId: 'wmNotifyCanvas',
                listId: 'wmNotifyList',
                markAllId: 'wmNotifyMarkAll',
                clearId: 'wmNotifyClear',
                filterAllId: 'wmNotifyFilterAll',
                filterAiId: 'wmNotifyFilterAi',
                groupToggleId: 'wmNotifyGroupBySender',
                pollMs: 8000,
                // Server-backed notifications
                listUrl: '/WorldMiniApp/Home/GetWorldUserNotifications?take=30&includeSeen=true',
                unreadUrl: '/WorldMiniApp/Home/GetWorldUserNotifications?take=50&includeSeen=false',
                markSeenUrl: '/WorldMiniApp/Home/MarkWorldUserNotificationSeen',
                markAllSeenUrl: '/WorldMiniApp/Home/MarkAllWorldUserNotificationsSeen',
                clearAllUrl: '/WorldMiniApp/Home/ClearWorldUserNotifications',
                antiforgeryFormId: 'wmAntiForgeryForm'
            });

            window.addEventListener('wm:notify:feedbadges', (event) => {
                applyLiveCommentBadges(event?.detail?.counts || {});
            });

            // Wire custom group toggle button to hidden checkbox
            const _grpBtn = document.getElementById('wmNotifyGroupToggleBtn');
            const _grpCb = document.getElementById('wmNotifyGroupBySender');
            const _grpTrack = document.getElementById('wmNotifyGroupTrack');
            const _grpKnob = document.getElementById('wmNotifyGroupKnob');
            function _syncGrpVisual() {
                const on = _grpCb && _grpCb.checked;
                if (_grpTrack) _grpTrack.style.background = on ? '#14391f' : 'rgba(20,57,31,0.2)';
                if (_grpKnob) _grpKnob.style.left = on ? '14px' : '2px';
            }
            _grpBtn && _grpBtn.addEventListener('click', () => {
                if (_grpCb) { _grpCb.checked = !_grpCb.checked; _grpCb.dispatchEvent(new Event('change')); }
                _syncGrpVisual();
            });
            _grpCb && _grpCb.addEventListener('change', _syncGrpVisual);

            // Wire filter pill active styling
            const _fAll = document.getElementById('wmNotifyFilterAll');
            const _fAi = document.getElementById('wmNotifyFilterAi');
            function _syncFilterPills(active) {
                if (_fAll) { _fAll.style.background = active === 'all' ? '#14391f' : 'transparent'; _fAll.style.color = active === 'all' ? '#fff' : '#14391f'; }
                if (_fAi) { _fAi.style.background = active === 'ai' ? '#14391f' : 'transparent'; _fAi.style.color = active === 'ai' ? '#fff' : '#14391f'; }
            }
            _fAll && _fAll.addEventListener('click', () => _syncFilterPills('all'));
            _fAi && _fAi.addEventListener('click', () => _syncFilterPills('ai'));

            // Unread pill badge update
            window.addEventListener('wm:notify:changed', () => {
                try {
                    const pill = document.getElementById('wmNotifyUnreadPill');
                    const badge = document.getElementById('wmNotifyBadge');
                    if (!pill || !badge) return;
                    const n = parseInt(badge.textContent) || 0;
                    if (n > 0) { pill.textContent = n + ' neu'; pill.style.display = ''; }
                    else { pill.style.display = 'none'; }
                } catch { /* ignore */ }
            });

            const openPlanBtn = document.getElementById('wmNotifyOpenPlanBtn');
            openPlanBtn && openPlanBtn.addEventListener('click', () => {
                try {
                    const el = document.getElementById('wmNotifyCanvas');
                    const c = el && window.bootstrap ? bootstrap.Offcanvas.getInstance(el) : null;
                    c && c.hide();
                } catch { /* ignore */ }
                openPlanModal(null, null, null);
            });
        } catch { /* ignore */ }

        // ----------------- HLS.js Video Player Init -----------------
        const subtitleAvailabilityCache = new Map();
        const bunnyStorageCaptionHost = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bunnyStorageCaptionHost));
        const currentSubtitleLanguage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(language));
        let subtitlesEnabled = true;

        function getSubtitleLanguageCandidates(languageCode) {
            const normalized = (languageCode || '').toLowerCase();
            const candidates = [];
            if (normalized) {
                candidates.push(normalized);
                if (normalized === 'nb') candidates.push('no');
                if (normalized === 'no') candidates.push('nb');
            }
            if (!candidates.includes('de')) candidates.push('de');
            return candidates;
        }

        function buildSubtitleTrackUrls(source, languageCode) {
            if (!source || !languageCode) return [];

            const hlsMarker = '/playlist.m3u8';
            const hlsIndex = source.toLowerCase().indexOf(hlsMarker);
            if (hlsIndex < 0) return [];

            const parts = source.split('/');
            const videoGuid = parts[parts.length - 2];
            const urls = [];
            const languageCandidates = getSubtitleLanguageCandidates(languageCode);

            for (const candidate of languageCandidates) {
                if (bunnyStorageCaptionHost) {
                    urls.push(`https://${bunnyStorageCaptionHost}/captions/${videoGuid}/${candidate}.vtt`);
                }

                try {
                    const sourceUrl = new URL(source, window.location.origin);
                    urls.push(`${sourceUrl.origin}/${videoGuid}/captions/${candidate}-auto.vtt`);
                } catch {
                    // ignore
                }
            }

            return urls;
        }

        async function ensureSubtitleTrack(video, languageCode = currentSubtitleLanguage) {
            if (!video || video.dataset.subtitleProbeDone === 'true') return;
            video.dataset.subtitleProbeDone = 'true';

            const source = video.getAttribute('src') || video.src || '';
            const subtitleUrls = buildSubtitleTrackUrls(source, languageCode);
            if (!subtitleUrls.length) return;

            for (const subtitleUrl of subtitleUrls) {
                let exists = subtitleAvailabilityCache.get(subtitleUrl);
                if (typeof exists === 'undefined') {
                    try {
                        const response = await fetch(subtitleUrl, {
                            method: 'GET',
                            mode: 'cors',
                            cache: 'no-store'
                        });
                        exists = response.ok;
                    } catch {
                        exists = false;
                    }
                    subtitleAvailabilityCache.set(subtitleUrl, exists);
                }

                if (!exists) continue;

                const existingTrack = video.querySelector(`track[srclang="${languageCode}"]`);
                if (existingTrack) return;

                const track = document.createElement('track');
                track.kind = 'subtitles';
                track.srclang = languageCode;
                track.src = subtitleUrl;
                video.appendChild(track);
                video.dataset.subtitleUrl = subtitleUrl;
                return;
            }
        }

        function attachCustomSubtitleOverlay(video) {
            if (!video || video.dataset.subtitleInit === 'true') return;

            const container = video.closest('.feed-item');
            const overlay = container?.querySelector('.video-caption-overlay');
            const textEl = overlay?.querySelector('.video-caption-text');
            if (!overlay || !textEl) return;

            const setCaptionText = (value) => {
                if (!subtitlesEnabled) {
                    textEl.textContent = '';
                    overlay.classList.add('is-empty');
                    return;
                }
                const normalized = (value || '').trim();
                textEl.textContent = normalized;
                overlay.classList.toggle('is-empty', !normalized);
            };

            const wireTrack = () => {
                try {
                    const textTracks = video.textTracks;
                    if (!textTracks || !textTracks.length) return false;

                    const track = textTracks[0];
                    track.mode = 'hidden';

                    const updateFromTrack = () => {
                        const activeCueTexts = [];
                        const activeCues = track.activeCues;
                        if (activeCues) {
                            for (let i = 0; i < activeCues.length; i++) {
                                const cueText = (activeCues[i]?.text || '').trim();
                                if (cueText) activeCueTexts.push(cueText);
                            }
                        }
                        setCaptionText(activeCueTexts.join('\n'));
                    };

                    if (video._subtitleCueHandler) {
                        track.removeEventListener('cuechange', video._subtitleCueHandler);
                    }

                    video._subtitleCueHandler = updateFromTrack;
                    video._subtitleRefreshHandler = updateFromTrack;
                    track.addEventListener('cuechange', updateFromTrack);
                    video.addEventListener('timeupdate', updateFromTrack);
                    video.addEventListener('seeked', updateFromTrack);
                    video.addEventListener('pause', updateFromTrack);
                    video.addEventListener('play', updateFromTrack);
                    updateFromTrack();
                    video.dataset.subtitleInit = 'true';
                    return true;
                } catch {
                    return false;
                }
            };

            if (wireTrack()) return;

            const retryWire = () => {
                if (wireTrack()) {
                    video.removeEventListener('loadedmetadata', retryWire);
                    video.removeEventListener('loadeddata', retryWire);
                    video.removeEventListener('canplay', retryWire);
                }
            };

            if (video.readyState >= 1) {
                retryWire();
                if (video.dataset.subtitleInit === 'true') return;
            }

            video.addEventListener('loadedmetadata', retryWire);
            video.addEventListener('loadeddata', retryWire);
            video.addEventListener('canplay', retryWire);
        }

        function syncSubtitleButtons() {
            document.querySelectorAll('.subtitle-toggle').forEach(button => {
                button.classList.toggle('is-active', subtitlesEnabled);
                button.setAttribute('aria-pressed', subtitlesEnabled ? 'true' : 'false');
            });
        }

        function refreshSubtitleOverlays() {
            document.querySelectorAll('video.feed-media').forEach(video => {
                if (typeof video._subtitleRefreshHandler === 'function') {
                    video._subtitleRefreshHandler();
                } else {
                    const container = video.closest('.feed-item');
                    const overlay = container?.querySelector('.video-caption-overlay');
                    if (overlay && !subtitlesEnabled) {
                        overlay.classList.add('is-empty');
                    }
                }
            });
        }

        function toggleSubtitles(feedItem) {
            subtitlesEnabled = !subtitlesEnabled;
            syncSubtitleButtons();
            refreshSubtitleOverlays();
        }

        // ============================================================================
        // TTS (Text-to-Speech) System for Multilingual Audio
        // ============================================================================

        class TTSController {
            constructor(video, feedItem) {
                this.video = video;
                this.feedItem = feedItem;
                this.cues = [];
                this.currentCueIndex = -1;
                this.isActive = false;
                this.originalVolume = video.volume;
                this.utterance = null;
                this.language = 'de-DE';

                this.onTimeUpdate = this.onTimeUpdate.bind(this);
                this.onPause = this.onPause.bind(this);
                this.onPlay = this.onPlay.bind(this);
            }

            async parseVTT(vttUrl) {
                try {
                    const response = await fetch(vttUrl);
                    const text = await response.text();
                    return this.extractCues(text);
                } catch (error) {
                    console.error('Failed to load VTT:', error);
                    return [];
                }
            }

            extractCues(vttText) {
                const cues = [];
                const lines = vttText.split('\n');
                let i = 0;

                while (i < lines.length) {
                    const line = lines[i].trim();

                    if (line.includes('-->')) {
                        const timeMatch = line.match(/(\d{2}:\d{2}:\d{2}\.\d{3})\s*-->\s*(\d{2}:\d{2}:\d{2}\.\d{3})/);
                        if (timeMatch) {
                            const startTime = this.parseTimestamp(timeMatch[1]);
                            const endTime = this.parseTimestamp(timeMatch[2]);

                            i++;
                            let captionText = '';
                            while (i < lines.length && lines[i].trim() !== '') {
                                captionText += lines[i].trim() + ' ';
                                i++;
                            }

                            if (captionText.trim()) {
                                cues.push({
                                    start: startTime,
                                    end: endTime,
                                    text: captionText.trim()
                                });
                            }
                        }
                    }
                    i++;
                }

                return cues;
            }

            parseTimestamp(timestamp) {
                const parts = timestamp.split(':');
                const hours = parseInt(parts[0]);
                const minutes = parseInt(parts[1]);
                const seconds = parseFloat(parts[2]);
                return hours * 3600 + minutes * 60 + seconds;
            }

            async activate(language = null) {
                if (DEBUG) console.log('TTS: Activating...');
                this.isActive = true;

                if (language) {
                    this.language = this.mapLanguageCode(language);
                } else {
                    this.language = await this.detectLanguageFromSubtitles();
                }

                if (DEBUG) console.log('TTS: Language:', this.language);

                const vttUrl = await this.getCurrentVTTUrl();
                if (vttUrl) {
                    if (DEBUG) console.log('TTS: Loading VTT from:', vttUrl);
                    this.cues = await this.parseVTT(vttUrl);
                    if (DEBUG) console.log('TTS: Loaded', this.cues.length, 'cues');
                    if (this.cues.length === 0) {
                        console.warn('TTS: No cues found in VTT file');
                        this.isActive = false;
                        return;
                    }
                } else {
                    console.error('TTS: No VTT URL found - captions may not be available for this video');
                    this.isActive = false;
                    return;
                }

                // Video muten - mehrere Methoden für Robustheit
                this.originalVolume = this.video.volume;
                this.video.volume = 0;
                this.video.muted = true;
                if (DEBUG) console.log('TTS: Video muted, original volume was:', this.originalVolume);

                this.video.addEventListener('timeupdate', this.onTimeUpdate);
                this.video.addEventListener('pause', this.onPause);
                this.video.addEventListener('play', this.onPlay);

                if (DEBUG) console.log('TTS: Activated successfully');
            }

            deactivate() {
                if (DEBUG) console.log('TTS: Deactivating...');
                this.isActive = false;
                this.stopSpeaking();

                // Video unmuten
                this.video.volume = this.originalVolume || 0;
                this.video.muted = isGlobalMuted; // Globalen Mute-State wiederherstellen

                this.video.removeEventListener('timeupdate', this.onTimeUpdate);
                this.video.removeEventListener('pause', this.onPause);
                this.video.removeEventListener('play', this.onPlay);

                if (DEBUG) console.log('TTS: Deactivated, volume restored to:', this.video.volume, 'muted:', this.video.muted);
            }

            mapLanguageCode(code) {
                const map = {
                    'de': 'de-DE',
                    'en': 'en-US',
                    'es': 'es-ES',
                    'pt': 'pt-PT',
                    'id': 'id-ID',
                    'nl': 'nl-NL',
                    'sv': 'sv-SE',
                    'da': 'da-DK',
                    'nb': 'nb-NO',
                    'no': 'nb-NO',
                    'ms': 'ms-MY'
                };
                return map[code] || 'de-DE';
            }

            async detectLanguageFromSubtitles() {
                try {
                    const track = this.video.querySelector('track');
                    if (track && track.srclang) {
                        return this.mapLanguageCode(track.srclang);
                    }
                } catch (e) {}
                return 'de-DE';
            }

            async getCurrentVTTUrl() {
                try {
                    // 1. Versuche cached URL aus dataset
                    if (this.video.dataset.subtitleUrl) {
                        return this.video.dataset.subtitleUrl;
                    }

                    // 2. Versuche track element
                    const track = this.video.querySelector('track');
                    if (track && track.src) {
                        return track.src;
                    }

                    // 3. Konstruiere URL selbst
                    const source = this.video.getAttribute('src') || this.video.src || '';
                    const urls = buildSubtitleTrackUrls(source, currentSubtitleLanguage);

                    // Teste welche URL existiert
                    for (const url of urls) {
                        try {
                            const response = await fetch(url, { method: 'HEAD', cache: 'no-store' });
                            if (response.ok) {
                                return url;
                            }
                        } catch (e) {
                            continue;
                        }
                    }

                    return null;
                } catch (e) {
                    console.error('TTS: Failed to get VTT URL', e);
                    return null;
                }
            }

            onTimeUpdate() {
                if (!this.isActive || !this.cues.length) return;

                const currentTime = this.video.currentTime;

                // Starte TTS 0.4 Sekunden FRÜHER um Verzögerung zu kompensieren
                const lookAheadTime = currentTime + 0.4;

                const cue = this.cues.find(c => lookAheadTime >= c.start && currentTime < c.end);

                if (cue) {
                    const cueIndex = this.cues.indexOf(cue);
                    if (cueIndex !== this.currentCueIndex) {
                        this.currentCueIndex = cueIndex;
                        this.speak(cue.text);
                    }
                } else {
                    // Nur stoppen wenn wir wirklich außerhalb aller Cues sind
                    const inAnyCue = this.cues.some(c => currentTime >= c.start && currentTime < c.end);
                    if (!inAnyCue) {
                        this.stopSpeaking();
                    }
                }
            }

            speak(text) {
                this.stopSpeaking();

                if (!text || text.trim() === '') return;

                this.utterance = new SpeechSynthesisUtterance(text);
                this.utterance.lang = this.language;
                this.utterance.rate = 1.8; // Sehr schnelle Sprechgeschwindigkeit für Video-Synchronisation
                this.utterance.pitch = 1.0;
                this.utterance.volume = 1.0;

                speechSynthesis.speak(this.utterance);
            }

            stopSpeaking() {
                if (this.utterance) {
                    speechSynthesis.cancel();
                    this.utterance = null;
                }
            }

            onPause() {
                this.stopSpeaking();
            }

            onPlay() {
                // Resume will be handled by onTimeUpdate
            }
        }

        // Store TTS controllers for each video
        const ttsControllers = new Map();

        async function toggleTTS(feedItem) {
            const button = feedItem.querySelector('.system-control-item[data-control="tts"]');
            const video = feedItem.querySelector('video');

            if (!video) {
                console.error('TTS: No video element found');
                return;
            }
            if (!button) {
                console.error('TTS: No button element found');
                return;
            }

            const isActive = button.classList.contains('is-active');
            if (DEBUG) console.log('TTS toggleTTS - current isActive:', isActive);

            if (isActive) {
                // Deactivate TTS
                if (DEBUG) console.log('TTS: Deactivating...');
                const controller = ttsControllers.get(video);
                if (controller) {
                    controller.deactivate();
                }
                button.classList.remove('is-active');
                button.setAttribute('aria-pressed', 'false');
            } else {
                // Activate TTS
                if (DEBUG) console.log('TTS: Activating...');
                let controller = ttsControllers.get(video);
                if (!controller) {
                    if (DEBUG) console.log('TTS: Creating new controller');
                    controller = new TTSController(video, feedItem);
                    ttsControllers.set(video, controller);
                }

                try {
                    await controller.activate();
                    // Nur Klasse hinzufügen wenn activate erfolgreich war
                    if (controller.isActive) {
                        button.classList.add('is-active');
                        button.setAttribute('aria-pressed', 'true');
                        if (DEBUG) console.log('TTS: Button activated');
                    } else {
                        console.error('TTS: Activation failed - controller is not active');
                    }
                } catch (error) {
                    console.error('TTS: Activation error:', error);
                }
            }
        }

        // Cleanup on page unload
        window.addEventListener('beforeunload', () => {
            ttsControllers.forEach(controller => controller.deactivate());
        });

