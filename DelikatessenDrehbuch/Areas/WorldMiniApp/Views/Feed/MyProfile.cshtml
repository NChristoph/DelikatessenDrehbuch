@using DelikatessenDrehbuch.Areas.WorldMiniApp.Models
@model UserProfileViewModel
@{
    ViewData["Title"] = "Mein Profil";
    Layout = "_MiniAppLayout";
    bool isOrb = Model.User.IsVerified == "orb" || Model.User.UserHash == "0x2da33d4d7152caf4dad616bffa6fed2a7fd896ebe32be8806c79ed5010ff4839";
    var language = (Context.Request.Cookies["deli-lang"] ?? "de").ToLowerInvariant();
    string T(string de, string en, string es, string pt) => language switch
    {
        "en" => en,
        "es" => es,
        "pt" => pt,
        _ => de
    };
}

<style>
    body.profile-theme-color {
        background: linear-gradient(140deg, #fff8e1 0%, #fff 50%, #f3e5f5 100%);
        color: #2c3e50;
    }

    body.profile-theme-black {
        background: #121212;
        color: #f5f5f5;
    }

    body.profile-theme-black .card,
    body.profile-theme-black .nav-tabs,
    body.profile-theme-black .list-group-item {
        background: #1e1e1e !important;
        color: #f5f5f5 !important;
        border-color: #333 !important;
    }

    body.profile-theme-white {
        background: #ffffff;
        color: #1f2937;
    }

    .profile-wrap {
        max-width: 980px;
        margin: 0 auto;
        padding: 18px 14px 90px;
    }

    .profile-hero {
        border-radius: 20px;
        background: rgba(255,255,255,0.85);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(0,0,0,.06);
    }

    .theme-switch .form-check-label { min-width: 58px; }

    .video-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 6px;
    }

    .grid-item {
        position: relative;
        aspect-ratio: 2/3;
        border-radius: 10px;
        overflow: hidden;
        background: #f1f3f5;
        cursor: pointer;
    }

    .grid-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .type-icon {
        position: absolute;
        top: 6px;
        right: 6px;
        color: #fff;
        text-shadow: 0 1px 2px rgba(0,0,0,.8);
    }
</style>

<div class="profile-wrap">
    <div class="card profile-hero shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex align-items-center gap-3 mb-3">
                <img src="https://ui-avatars.com/api/?name=@(string.IsNullOrWhiteSpace(Model.User.UserName) ? "User" : Model.User.UserName)&background=random"
                     alt="avatar" class="rounded-circle" width="72" height="72" />
                <div class="flex-grow-1">
                    <h4 class="mb-1 fw-bold">@(string.IsNullOrWhiteSpace(Model.User.UserName) ? "User" : Model.User.UserName)</h4>
                    @if (isOrb)
                    {
                        <span class="badge bg-warning text-dark">@T("Verifiziert", "Verified", "Verificado", "Verificado")</span>
                    }
                    <div class="small opacity-75 mt-1">@@@((Model.User.UserHash ?? "").Substring(0, Math.Min(8, (Model.User.UserHash ?? "").Length)))...</div>
                </div>
            </div>

            <form method="post" action="@Url.Action("UpdateProfile", "Feed", new { area = "WorldMiniApp" })" class="row g-2 align-items-end mb-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userHash" value="@Model.User.UserHash" />
                <div class="col-12 col-md-7">
                    <label class="form-label mb-1">@T("Name", "Name", "Nombre", "Nome")</label>
                    <input class="form-control" name="userName" maxlength="80" value="@Model.User.UserName" placeholder="@T("Dein Name", "Your name", "Tu nombre", "Seu nome")" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-dark rounded-pill px-4">@T("Speichern", "Save", "Guardar", "Salvar")</button>
                </div>
            </form>

            <div class="d-flex flex-wrap gap-2 align-items-center theme-switch">
                <span class="small fw-semibold">@T("Layout", "Layout", "Diseño", "Layout"):</span>
                <div class="form-check form-check-inline m-0">
                    <input class="form-check-input" type="radio" name="profileTheme" id="themeBlack" value="black">
                    <label class="form-check-label" for="themeBlack">Black</label>
                </div>
                <div class="form-check form-check-inline m-0">
                    <input class="form-check-input" type="radio" name="profileTheme" id="themeWhite" value="white">
                    <label class="form-check-label" for="themeWhite">White</label>
                </div>
                <div class="form-check form-check-inline m-0">
                    <input class="form-check-input" type="radio" name="profileTheme" id="themeColor" value="color">
                    <label class="form-check-label" for="themeColor">Color</label>
                </div>
            </div>

            <div class="row text-center mt-3 g-2">
                <div class="col"><div class="fw-bold">@Model.Following.Count</div><small class="opacity-75">@T("Folge ich", "Following", "Siguiendo", "Seguindo")</small></div>
                <div class="col"><div class="fw-bold">@Model.LikedRecipes.Count</div><small class="opacity-75">@T("Likes", "Likes", "Me gusta", "Curtidas")</small></div>
                @if (isOrb)
                {
                    <div class="col"><div class="fw-bold">@Model.FollowerCount</div><small class="opacity-75">@T("Follower", "Followers", "Seguidores", "Seguidores")</small></div>
                }
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs" id="profileTab" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#likes" type="button">@T("Likes", "Likes", "Likes", "Curtidas")</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#abos" type="button">@T("Abos", "Following", "Siguiendo", "Seguindo")</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#mealplans" type="button">@T("Pläne", "Plans", "Planes", "Planos")</button></li>
        @if (isOrb)
        {
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#myvideos" type="button">@T("Meine Videos", "My videos", "Mis videos", "Meus vídeos")</button></li>
        }
    </ul>

    <div class="tab-content border border-top-0 rounded-bottom p-3 bg-white bg-opacity-75">
        <div class="tab-pane fade show active" id="likes">
            <div class="video-grid">
                @foreach (var recipe in Model.LikedRecipes)
                {
                    var thumbUrl = recipe.ThumbnailUrl;
                    var sourceUrl = recipe.Source;
                    var displayUrl = !string.IsNullOrEmpty(thumbUrl) ? thumbUrl : sourceUrl;
                    bool isVideo = sourceUrl != null && sourceUrl.EndsWith(".mp4");
                    bool useVideoTag = isVideo && string.IsNullOrEmpty(thumbUrl);

                    <div class="grid-item" onclick="openFeed('likes', @recipe.Id)">
                        @if (useVideoTag)
                        {
                            <video class="grid-img" muted playsinline preload="metadata" onloadeddata="this.currentTime=0.1"><source src="@displayUrl#t=0.1" type="video/mp4"></video>
                        }
                        else
                        {
                            <img src="@displayUrl" class="grid-img" loading="lazy">
                        }
                        @if (isVideo)
                        {
                            <div class="type-icon"><i class="bi bi-play-fill"></i></div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="abos">
            <div class="list-group list-group-flush">
                @foreach (var creator in Model.Following)
                {
                    <button class="list-group-item list-group-item-action d-flex align-items-center" onclick="openFeed('creator', 0, '@creator.UserHash')">
                        <img src="https://ui-avatars.com/api/?name=@creator.UserName" class="rounded-circle me-2" width="36" height="36" />
                        <span class="fw-semibold">@creator.UserName</span>
                        <i class="bi bi-chevron-right ms-auto"></i>
                    </button>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="mealplans">
            <div class="d-grid gap-2">
                @foreach (var plan in Model.MealPlans)
                {
                    <div class="card">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold">@plan.Title</div>
                                <div class="small opacity-75">@plan.CreationTime.ToString("dd.MM.yyyy")</div>
                            </div>
                            <a href="@Url.Action("ViewPlan", "Home", new { area = "WorldMiniApp", id = plan.Id })" class="btn btn-sm btn-outline-dark">@T("Anzeigen", "View", "Ver", "Ver")</a>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (isOrb)
        {
            <div class="tab-pane fade" id="myvideos">
                <div class="video-grid">
                    @foreach (var posting in Model.MyVideos)
                    {
                        var thumbUrl = posting.ThumbnailUrl;
                        var sourceUrl = posting.Source;
                        var displayUrl = !string.IsNullOrEmpty(thumbUrl) ? thumbUrl : sourceUrl;
                        bool isVideo = sourceUrl != null && sourceUrl.EndsWith(".mp4");
                        bool useVideoTag = isVideo && string.IsNullOrEmpty(thumbUrl);

                        <div class="grid-item" onclick="openFeed('myvideos', @posting.Recipe.Id)">
                            @if (useVideoTag)
                            {
                                <video class="grid-img" muted playsinline preload="metadata" onloadeddata="this.currentTime=0.1"><source src="@displayUrl#t=0.1" type="video/mp4"></video>
                            }
                            else
                            {
                                <img src="@displayUrl" class="grid-img" loading="lazy">
                            }
                            <div class="type-icon"><i class="bi @(isVideo ? "bi-play-fill" : "bi-image")"></i></div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function openFeed(filterMode, scrollToId, targetUserHash = "") {
            const myUserHash = sessionStorage.getItem("UserToken") || localStorage.getItem("UserToken") || "@Model.User.UserHash";
            let url = `/WorldMiniApp/Feed/Index?filter=${filterMode}&scrollToId=${scrollToId}&userHash=${myUserHash}`;
            if (filterMode === 'creator' && targetUserHash !== "") {
                url += `&targetUserHash=${targetUserHash}`;
            }
            window.location.href = url;
        }

        function applyProfileTheme(theme) {
            document.body.classList.remove('profile-theme-black', 'profile-theme-white', 'profile-theme-color');
            const normalized = (theme === 'black' || theme === 'white' || theme === 'color') ? theme : 'color';
            document.body.classList.add(`profile-theme-${normalized}`);
            localStorage.setItem('profile_theme', normalized);
            const radio = document.querySelector(`input[name="profileTheme"][value="${normalized}"]`);
            if (radio) radio.checked = true;
        }

        document.addEventListener('DOMContentLoaded', () => {
            applyProfileTheme(localStorage.getItem('profile_theme') || 'color');
            document.querySelectorAll('input[name="profileTheme"]').forEach(r => {
                r.addEventListener('change', e => applyProfileTheme(e.target.value));
            });
        });
    </script>
}
