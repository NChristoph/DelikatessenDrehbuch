@using DelikatessenDrehbuch.Areas.WorldMiniApp.Models
@model UserProfileViewModel
@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IConfiguration Configuration
@inject IStringLocalizer<DelikatessenDrehbuch.SharedResources> SharedLocalizer
@{
    ViewData["Title"] = "Mein Profil";
    Layout = "_MiniAppLayout";

    bool isAdmin = ViewData["IsWorldMiniAppAdmin"] is bool adminFlag && adminFlag;
    bool isOrb = Model.User.IsVerified == "orb" || isAdmin;

    string ShortHash(string h)
    {
        if (string.IsNullOrWhiteSpace(h)) return "0x00";
        return h.Length >= 8 ? h.Substring(0, 8) : h;
    }

    string Initials(string? name)
    {
        var value = (name ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(value)) return "AV";

        var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
        {
            var clean = new string(parts[0].Where(char.IsLetterOrDigit).Take(2).ToArray());
            return string.IsNullOrWhiteSpace(clean) ? "AV" : clean.ToUpperInvariant();
        }

        var initials = string.Concat(parts.Take(2).Select(p => p[0]));
        return string.IsNullOrWhiteSpace(initials) ? "AV" : initials.ToUpperInvariant();
    }

    string DeleteConfirmText(string title)
    {
        var text = T($"Möchtest du den Plan \"{title}\" wirklich löschen?",
                     $"Do you really want to delete the plan \"{title}\"?",
                     "¿Quieres eliminar el plan?",
                     "Quer mesmo apagar o plano?");
        return text.Replace("'", "\\'");
    }
}

<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/creator-shop-cards.css" />

<style>
    :root {
        --bg-cream: #ffffff;
        --card: #ffffff;
        --card-soft: #faf6ec;
        --hero-bg: linear-gradient(160deg,#f7f1e0 0%,#f1e6d4 60%,#f6d8c4 100%);
        --ink-deep: #14391f;
        --ink-deep-2: #0e2415;
        --avocado: #5fa052;
        --avocado-dark: #3f7536;
        --coral: #ff7849;
        --amber: #d99a3c;
        --crimson: #c44e4e;
        --ink-mute: #6b7868;
        --ink-soft: #9aa295;
        --ink-line: rgba(20,57,31,0.08);
        --shadow-sm: 0 4px 12px rgba(20,57,31,0.12), 0 2px 6px rgba(20,57,31,0.08);
        --shadow-md: 0 8px 24px rgba(20,57,31,0.16), 0 4px 12px rgba(20,57,31,0.12);
        --shadow-lg: 0 12px 32px rgba(20,57,31,0.18), 0 6px 16px rgba(20,57,31,0.14);
    }

    body {
        font-family: 'Inter', sans-serif;
        background: #ffffff;
        color: var(--ink-deep);
    }

    .profile-wrap {
        max-width: 500px;
        margin: 0 auto;
        padding: 12px 14px 120px;
    }

    .profile-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
    }

    .topbar-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        background: var(--card);
        color: var(--ink-deep);
        border: none;
        border-radius: 999px;
        padding: 8px 14px;
        font-size: 13px;
        font-weight: 700;
        box-shadow: var(--shadow-sm);
    }

    .topbar-lang {
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .profile-card {
        padding: 20px 18px;
        border-radius: 24px;
        margin-bottom: 12px;
        background: rgba(245, 255, 250, 0.85);
        border: 1px solid rgba(235, 250, 240, 0.9);
        box-shadow: 0 8px 24px rgba(20,57,31,0.14), 0 4px 12px rgba(20,57,31,0.10);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
    }

    .profile-top-row {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .avatar-main {
        width: 76px;
        height: 76px;
        border-radius: 22px;
        background: linear-gradient(135deg, var(--ink-deep), var(--ink-deep-2));
        color: #fff;
        font-family: 'Fraunces', serif;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -0.02em;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        box-shadow: 0 8px 22px rgba(20,57,31,0.18);
    }

    .profile-right {
        flex: 1;
        min-width: 0;
        text-align: left;
        padding-top: 4px;
    }

    .orb-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px 4px 8px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.9);
        color: var(--ink-deep);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 8px;
        border: 1px solid rgba(255, 255, 255, 0.95);
        box-shadow: 0 2px 6px rgba(20,57,31,0.08);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }

    .profile-name {
        font-family: 'Fraunces', serif;
        font-size: 26px;
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin: 0 0 2px 0;
        color: var(--ink-deep);
    }

    .profile-hash {
        font-size: 13px;
        color: var(--ink-mute);
        font-weight: 500;
    }

    .stats-container {
        display: flex;
        justify-content: flex-start;
        gap: 28px;
        margin: 18px 0 0 4px;
        flex-wrap: wrap;
    }

    .stat-val {
        font-family: 'Fraunces', serif;
        font-size: 22px;
        font-weight: 700;
        display: block;
        line-height: 1;
        color: var(--ink-deep);
        letter-spacing: -0.02em;
    }

    .stat-lbl {
        margin-top: 4px;
        font-size: 10px;
        color: var(--ink-soft);
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-weight: 700;
    }

    .btn-action {
        background: linear-gradient(135deg, var(--ink-deep), var(--ink-deep-2));
        color: #fff !important;
        border-radius: 16px;
        padding: 13px;
        width: 100%;
        border: none;
        font-weight: 700;
        font-size: 14px;
        box-shadow: 0 6px 20px rgba(20,57,31,0.24);
    }

    .theme-dot {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        cursor: pointer;
        border: 2px solid rgba(20,57,31,0.08);
        transition: 0.2s;
    }

    .settings-box {
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.9);
        border-radius: 18px;
        padding: 12px;
        color: var(--ink-deep);
        box-shadow: 0 4px 12px rgba(20,57,31,0.10);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }

    .quick-links {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        margin-top: 8px;
    }

    .quick-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        border-radius: 16px;
        padding: 12px;
        border: 1px solid rgba(255, 255, 255, 0.9);
        background: rgba(255, 255, 255, 0.85);
        color: var(--ink-deep);
        font-size: 13px;
        font-weight: 700;
        box-shadow: var(--shadow-sm);
        white-space: pre-line;
        text-align: left;
        min-height: 48px;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

    .quick-link-dashboard {
        width: 100%;
        margin-top: 8px;
        margin-bottom: 16px;
        border-radius: 16px;
        padding: 13px;
        justify-content: center;
        background: var(--card);
        border: 1px solid rgba(20,57,31,0.08);
        color: var(--ink-deep);
        box-shadow: var(--shadow-sm);
    }

    .quick-link-dashboard.is-open {
        background: var(--ink-deep);
        color: #fff;
        border-color: transparent;
        box-shadow: 0 6px 20px rgba(20,57,31,0.24);
    }

    .dashboard-embed-shell {
        margin-top: 12px;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(20,57,31,0.08);
        background: linear-gradient(135deg, #1a3a23, #0e2415);
        box-shadow: var(--shadow-lg);
    }

    .dashboard-embed-header {
        padding: 18px 18px 14px;
        color: #fff;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .dashboard-eyebrow {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.72);
        margin-bottom: 10px;
    }

    .dashboard-title {
        font-family: 'Fraunces', serif;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.05;
        margin: 0 0 6px;
    }

    .dashboard-hash {
        font-size: 12px;
        font-weight: 600;
        color: rgba(255,255,255,0.72);
    }

    .dashboard-embed-frame {
        width: 100%;
        min-height: 980px;
        border: 0;
        display: block;
        background: #fff;
    }

    .nav-custom {
        display: flex;
        background: rgba(20,57,31,0.06);
        border-radius: 22px;
        padding: 4px;
        border: none;
        margin-bottom: 18px;
        gap: 2px;
    }

    .nav-custom .nav-item {
        flex: 1;
    }

    .nav-custom .nav-link {
        width: 100%;
        border: none;
        border-radius: 16px;
        padding: 8px 4px 6px;
        background: transparent;
        color: var(--ink-soft);
        font-weight: 700;
        font-size: 9.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        transition: all .2s;
    }

    .nav-custom .nav-link.active {
        background: var(--card);
        color: var(--ink-deep);
        box-shadow: 0 4px 12px rgba(20,57,31,0.10);
    }

    .video-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .grid-item {
        aspect-ratio: 9/14;
        border-radius: 14px;
        overflow: hidden;
        position: relative;
        background: #222;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(20,57,31,0.12), 0 2px 6px rgba(20,57,31,0.08);
    }

    .grid-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .grid-item:active .grid-img {
        transform: scale(0.95);
    }

    .grid-overlay {
        position: absolute;
        bottom: 10px;
        left: 10px;
        color: white;
        font-size: 0.9rem;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }

    .grid-edit-link {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.55);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        z-index: 2;
        text-decoration: none;
    }

        .grid-edit-link:hover {
            color: #fff;
            background: rgba(0, 0, 0, 0.75);
        }

    .grid-action-bar {
        position: absolute;
        top: 10px;
        right: 10px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        z-index: 2;
    }

    .grid-action-btn {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: none;
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        text-decoration: none;
    }

    .grid-action-btn.edit { background: rgba(0, 0, 0, 0.55); }
    .grid-action-btn.edit:hover { background: rgba(0, 0, 0, 0.75); }
    .grid-action-btn.offline { background: rgba(217, 154, 60, 0.88); }
    .grid-action-btn.offline:hover { background: rgba(217, 154, 60, 1); }
    .grid-action-btn.online { background: rgba(95, 160, 82, 0.88); }
    .grid-action-btn.online:hover { background: rgba(95, 160, 82, 1); }
    .grid-action-btn.delete { background: rgba(196, 78, 78, 0.92); }
    .grid-action-btn.delete:hover { background: rgba(196, 78, 78, 1); }

    .grid-item.is-offline {
        opacity: 0.45;
    }

    .empty-grid-state {
        text-align: center;
        padding: 44px 18px;
        border-radius: 22px;
        background: var(--card);
        border: 1px solid rgba(20,57,31,0.08);
        color: var(--ink-mute);
        box-shadow: var(--shadow-sm);
    }

    .grid-offline-badge {
        position: absolute;
        bottom: 30px;
        left: 0;
        right: 0;
        text-align: center;
        font-size: 0.65rem;
        font-weight: 900;
        color: #fff;
        background: rgba(255, 165, 0, 0.8);
        padding: 3px 0;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .ai-card-footer {
        position: absolute;
        inset-inline: 0;
        bottom: 0;
        padding: 12px 10px 10px;
        background: linear-gradient(180deg, rgba(20,57,31,0) 0%, rgba(20,57,31,0.88) 100%);
        z-index: 3;
    }

    .ai-card-tag,
    .soft-pill,
    .open-pill,
    .plan-open-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        font-weight: 800;
    }

    .soft-pill {
        background: rgba(255,255,255,0.92);
        color: var(--ink-deep);
        padding: 6px 10px;
        border: 1px solid rgba(20,57,31,0.08);
        font-size: 11px;
    }

    .ai-card-tag {
        background: rgba(255,255,255,0.16);
        border: 1px solid rgba(255,255,255,0.22);
        color: #fff;
        padding: 5px 9px;
        font-size: 11px;
    }

    .follow-list,
    .plan-card {
        background: var(--card);
        border: 1px solid rgba(20,57,31,0.08);
        border-radius: 18px;
        box-shadow: var(--shadow-sm);
    }

    .follow-list .list-group-item {
        background: transparent;
        border: 0;
        color: var(--ink-deep);
    }

    .open-pill,
    .plan-open-btn {
        background: var(--ink-deep);
        color: #fff !important;
        padding: 8px 14px;
        text-decoration: none;
        font-size: 12px;
    }

    .trash-pill {
        width: 36px;
        height: 36px;
        border-radius: 999px;
        border: none;
        background: rgba(255, 120, 73, 0.12);
        color: var(--coral);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .purchase-price {
        font-family: 'Fraunces', serif;
        font-size: 20px;
        font-weight: 700;
        color: var(--ink-deep);
        letter-spacing: -0.02em;
    }
</style>

<div class="profile-wrap">

    <div class="profile-topbar">
        <a class="topbar-pill"
           href="@Url.Action("Index", "Feed", new { area = "WorldMiniApp", userHash = Model.User.UserHash })">
            <i class="bi bi-arrow-left"></i>
            @SharedLocalizer["MyProfile.BackToFeed"]
        </a>
        @* Alter Sprach-Button entfernt - Cookie-basierter Switcher wird verwendet *@
    </div>

    <div class="profile-card">
        <div class="profile-top-row">
            <div class="avatar-main">@Initials(Model.User.UserName)</div>

            <div class="profile-right">
                @if (isOrb)
                {
                    <div class="orb-badge">
                        <i class="bi bi-patch-check-fill"></i>
                        ORB VERIFIED
                    </div>
                }

                <div class="profile-name">
                    @(string.IsNullOrWhiteSpace(Model.User.UserName) ? "User" : Model.User.UserName)
                </div>

                <div class="profile-hash">
                    @@@ShortHash(Model.User.UserHash)
                </div>

                <div class="stats-container">
                    <div class="stat-item">
                        <span class="stat-val counter" data-target="@Model.Following.Count">0</span>
                        <span class="stat-lbl">@SharedLocalizer["MyProfile.Following"]</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-val counter" data-target="@Model.LikedRecipes.Count">0</span>
                        <span class="stat-lbl">@SharedLocalizer["MyProfile.Likes"]</span>
                    </div>
                    @if (isOrb)
                    {
                        <div class="stat-item">
                            <span class="stat-val counter" data-target="@Model.FollowerCount">0</span>
                            <span class="stat-lbl">@SharedLocalizer["MyProfile.Followers"]</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <button class="btn-action mt-3" data-bs-toggle="collapse" data-bs-target="#settingsCollapse">
            <i class="bi bi-gear-fill me-2"></i> @SharedLocalizer["MyProfile.Settings"]
        </button>

        <div class="collapse mt-2" id="settingsCollapse">
            <div class="settings-box">
                <form method="post" action="@Url.Action("UpdateProfile", "Feed", new { area = "WorldMiniApp" })">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userHash" value="@Model.User.UserHash" />

                    <label class="form-label small fw-bold">@SharedLocalizer["MyProfile.DisplayName"]</label>
                    <div class="input-group">
                        <input class="form-control rounded-3" name="userName" maxlength="80" value="@Model.User.UserName" />
                        <button class="btn btn-dark" type="submit">@SharedLocalizer["MyProfile.Save"]</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="quick-links">
            <a class="quick-link" href="@Url.Action("FeedLight", "Shared", new { area = "WorldMiniApp", userHash = Model.User.UserHash })">
                <i class="bi bi-send-check"></i> Geteilte Inhalte
            </a>
            <a class="quick-link" href="@Url.Action("Index", "Marketplace", new { area = "WorldMiniApp", userHash = Model.User.UserHash })">
                <i class="bi bi-shop"></i> @SharedLocalizer["MyProfile.Marketplace"]
            </a>
            <a class="quick-link" href="@Url.Action("MyListings", "Marketplace", new { area = "WorldMiniApp", userHash = Model.User.UserHash })">
                <i class="bi bi-bag-check"></i> @SharedLocalizer["MyProfile.MyListings"]
            </a>
            @if (isAdmin)
            {
                <a class="quick-link" href="@Url.Action("CommentModeration", "Feed", new { area = "WorldMiniApp", userHash = Model.User.UserHash })">
                    <i class="bi bi-flag-fill"></i> @SharedLocalizer["MyProfile.CommentModeration"]
                </a>
                <a class="quick-link" href="@Url.Action("ReportedContent", "Admin", new { area = "WorldMiniApp" })">
                    <i class="bi bi-shield-exclamation"></i> @SharedLocalizer["MyProfile.ReportedContent"]
                </a>
                <a class="quick-link" href="@Url.Action("CreatorManager", "Admin", new { area = "WorldMiniApp" })">
                    <i class="bi bi-people-fill"></i> @SharedLocalizer["MyProfile.CreatorManager"]
                </a>
            }
            else
            {
                <span></span>
                <span></span>
                <span></span>
            }
        </div>

    </div>

    @if (isOrb)
    {
        <button class="quick-link quick-link-dashboard"
                id="dashboardToggleBtn"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#dashboardEmbedCollapse"
                aria-expanded="false"
                aria-controls="dashboardEmbedCollapse">
            <i class="bi bi-speedometer2"></i> Creator Dashboard
            <span class="ms-1 opacity-75" id="dashboardToggleCaret">▾</span>
        </button>

        <div class="collapse" id="dashboardEmbedCollapse">
            <div class="dashboard-embed-shell">
                <div class="dashboard-embed-header">
                    <div class="dashboard-eyebrow">Premium Creator Area</div>
                    <h2 class="dashboard-title">@SharedLocalizer["MyProfile.CreatorDashboard"]</h2>
                    <div class="dashboard-hash">@Model.User.UserHash</div>
                </div>
                <iframe class="dashboard-embed-frame"
                        src="@Url.Action("UserDashboard", "Home", new { area = "WorldMiniApp" })"
                        loading="lazy"
                        title="Creator Dashboard"></iframe>
            </div>
        </div>
    }

    @if (Model.User.UserHash == "0x2da33d4d7152caf4dad616bffa6fed2a7fd896ebe32be8806c79ed5010ff4839")
    {
        <!-- Ad Manager Link -->
        <a href="@Url.Action("Index", "AdminAds", new { area = "WorldMiniApp" })" class="quick-link" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
            <i class="bi bi-megaphone-fill"></i> Ad Manager
        </a>

        <!-- Trading Agent Dropdown -->
        <button class="quick-link quick-link-dashboard"
                id="tradingAgentToggleBtn"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#tradingAgentCollapse"
                aria-expanded="false"
                aria-controls="tradingAgentCollapse">
            <i class="bi bi-robot"></i> Trading Agent
            <span class="ms-1 opacity-75" id="tradingAgentToggleCaret">▾</span>
        </button>

        <div class="collapse mt-1 mb-1" id="tradingAgentCollapse">
            <div class="dashboard-embed-shell" style="background: white; border-radius: 16px; padding: 24px;">
                <div id="agent-container">
                    <div class="text-center" style="padding: 40px 20px;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>

                @* Agent Payment Test UI - nur im Trading Agent Dashboard *@
                @Html.Partial("_AgentPaymentTest")
            </div>
        </div>
    }

    <!-- Tabs -->
    <ul class="nav nav-custom" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-likes">
                <i class="bi bi-heart-fill fs-5"></i><span>@SharedLocalizer["MyProfile.TabLikes"]</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-ai">
                <i class="bi bi-stars fs-5"></i><span>@SharedLocalizer["MyProfile.TabAI"]</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-abos">
                <i class="bi bi-people-fill fs-5"></i><span>@SharedLocalizer["MyProfile.TabCreators"]</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-plans">
                <i class="bi bi-calendar2-week-fill fs-5"></i><span>@SharedLocalizer["MyProfile.TabCreated"]</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-purchases">
                <i class="bi bi-bag-check-fill fs-5"></i><span>@SharedLocalizer["MyProfile.TabBought"]</span>
            </button>
        </li>
        @if (isOrb)
        {
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-videos">
                    <i class="bi bi-play-circle-fill fs-5"></i><span>@SharedLocalizer["MyProfile.TabVideos"]</span>
                </button>
            </li>
        }
    </ul>

    <div class="tab-content">

        <div class="tab-pane fade show active" id="tab-likes">
            <div class="likes-panel active" data-likes-panel="likes">
                @if (!Model.LikedRecipes.Any())
                {
                    <div class="empty-grid-state">
                        <i class="bi bi-heart fs-1"></i>
                        <p class="mt-3 mb-0 fw-bold">@SharedLocalizer["MyProfile.NoLikesYet"]</p>
                    </div>
                }
                else
                {
                    <div class="video-grid">
                        @foreach (var recipe in Model.LikedRecipes)
                        {
                            <div class="grid-item shadow-sm" onclick="openFeed('likes', @recipe.Id)">
                                @{
                                    var src = recipe.Source ?? string.Empty;
                                    var thumb = recipe.ThumbnailUrl ?? string.Empty;
                                    var lower = src.ToLowerInvariant();
                                    var isVideo = lower.Contains(".mp4") || lower.Contains(".mov") || lower.Contains(".webm") || lower.Contains(".m3u8");
                                }
                                @if (isVideo)
                                {
                                    var fallbackSrc = src.Replace("_processed.mp4", ".mp4", StringComparison.OrdinalIgnoreCase);
                                    <video class="grid-img" src="@src" data-wm-fallback-src="@fallbackSrc" muted playsinline preload="metadata" crossorigin="anonymous" poster="@thumb"></video>
                                }
                                else
                                {
                                    <img src="@(string.IsNullOrEmpty(thumb) ? src : thumb)" class="grid-img" loading="lazy">
                                }
                                <div class="grid-overlay"><i class="bi bi-play-fill"></i></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="tab-ai">
            @if (!Model.AiEditedRecipes.Any())
            {
                <div class="empty-grid-state">
                    <i class="bi bi-stars fs-1"></i>
                    <p class="mt-3 fw-bold">@SharedLocalizer["MyProfile.NoAIVariantsYet"]</p>
                </div>
            }
            else
            {
                <div class="video-grid">
                    @foreach (var card in Model.AiEditedRecipes)
                    {
                        // All cards are now swap variants (RecipeAiBaseRecipes removed)
                                var href = $"/WorldMiniApp/Home/SharedRecipe?id={card.BaseRecipeId}&swapVariantId={card.AiVariantId}";

                        <a href="@href" class="grid-item shadow-sm position-relative text-decoration-none" style="display: block; cursor: pointer;">
                            <img src="@card.ImageUrl" class="grid-img" loading="lazy">
                            <div class="position-absolute top-0 end-0 p-2" style="z-index:4;">
                                <span class="soft-pill">
                                    <i class="bi-arrow-left-right text-warning me-1"></i>Angepasst
                                </span>
                            </div>
                            <div class="ai-card-footer">
                                <div class="small fw-bold text-white text-truncate">@card.VariantTitle</div>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    <span class="ai-card-tag">@card.VariantLabel</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>

        <div class="tab-pane fade" id="tab-abos">
            <div class="list-group list-group-flush follow-list overflow-hidden">
                @foreach (var creator in Model.Following)
                {
                    <button class="list-group-item list-group-item-action d-flex align-items-center p-3 border-0"
                            onclick="openFeed('creator', 0, '@creator.UserHash')">
                        <img src="https://ui-avatars.com/api/?name=@creator.UserName" class="rounded-circle me-3" width="40" height="40" />
                        <span class="fw-bold">@creator.UserName</span>
                        <i class="bi bi-chevron-right ms-auto opacity-50"></i>
                    </button>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="tab-plans">
            @if (!Model.CreatedMealPlans.Any())
            {
                <div class="text-center py-5 opacity-50">
                    <i class="bi bi-calendar2-x fs-1"></i>
                    <p class="mt-3 fw-bold">@SharedLocalizer["MyProfile.NoCreatedPlansYet"]</p>
                </div>
            }
            else
            {
                @foreach (var plan in Model.CreatedMealPlans)
                {
                    <div class="plan-card p-3 mb-2 d-flex justify-content-between align-items-center shadow-sm">
                        <div>
                            <div class="fw-bold">@plan.Title</div>
                            <div class="small opacity-50">@plan.CreationTime.ToShortDateString()</div>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="@Url.Action("ViewPlanAsync", "MealPlan", new { area = "WorldMiniApp", id = plan.Id })"
                               class="open-pill">OPEN</a>

                            <form method="post"
                                  action="@Url.Action("DeletePlan", "MealPlan", new { area = "WorldMiniApp" })"
                                  onsubmit="return confirm('@DeleteConfirmText(plan.Title)');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@plan.Id" />
                                <input type="hidden" name="userHash" value="@Model.User.UserHash" />
                                <button type="submit" class="trash-pill"
                                        title="@SharedLocalizer["MyProfile.Delete"]">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="tab-pane fade" id="tab-purchases">
            @if (!Model.Purchases.Any())
            {
                <div class="empty-grid-state">
                    <i class="bi bi-bag-x fs-1"></i>
                    <p class="mt-3 mb-0 fw-bold">@SharedLocalizer["MyProfile.NoPurchasedPlansYet"]</p>
                    <a href="@Url.Action("Index", "Marketplace", new { area = "WorldMiniApp" })"
                       class="btn btn-dark rounded-pill px-4 mt-3">
                        @SharedLocalizer["MyProfile.GoToMarketplace"]
                    </a>
                </div>
            }
            else
            {
                @foreach (var purchase in Model.Purchases)
                {
                    var listing = purchase.Listing;
                    if (listing == null) continue;

                    var heroImage = ViewData[$"PurchaseHeroImage_{purchase.Id}"] as string;

                    <div class="cs-card mb-3">
                        <!-- Hero -->
                        <div class="cs-hero">
                            @if (!string.IsNullOrEmpty(heroImage))
                            {
                                <img src="@heroImage" class="cs-hero-img" alt="@listing.Title" />
                            }
                            else
                            {
                                <div class="cs-hero-fallback"></div>
                            }
                            <div class="cs-hero-overlay"></div>
                            <div class="cs-hero-bottom">
                                <h3 class="cs-title">@listing.Title</h3>
                                <div class="cs-creator-row">
                                    <div class="cs-creator-avatar">@listing.SellerName.Substring(0, Math.Min(2, listing.SellerName.Length)).ToUpper()</div>
                                    <span class="cs-creator-name">@listing.SellerName</span>
                                    <span class="cs-creator-sep">•</span>
                                    <span class="cs-creator-duration">@listing.DayCount @SharedLocalizer["MyProfile.DaysLowercase"]</span>
                                </div>
                            </div>
                        </div>

                        <!-- Stats strip -->
                        <div class="cs-stats-strip">
                            <div class="cs-stat-cell">
                                <div class="cs-stat-value">@listing.DayCount</div>
                                <div class="cs-stat-label">@SharedLocalizer["MyProfile.DaysLowercase"]</div>
                            </div>
                            <div class="cs-stat-cell">
                                <div class="cs-stat-value">@listing.RecipeCount</div>
                                <div class="cs-stat-label">@SharedLocalizer["MyProfile.Recipes"]</div>
                            </div>
                            <div class="cs-stat-cell">
                                <div class="cs-stat-value">
                                    <i class="bi bi-check-circle-fill text-success" style="font-size: 18px;"></i>
                                </div>
                                <div class="cs-stat-label">@SharedLocalizer["MyProfile.Purchased"]</div>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="cs-card-footer">
                            <div style="flex: 1;">
                                <div style="font-size: 10px; color: var(--ink-mute); text-transform: uppercase; letter-spacing: 0.04em;">
                                    @SharedLocalizer["MyProfile.PurchasedOn"]
                                </div>
                                <div style="font-size: 12px; color: var(--ink-deep); font-weight: 600; margin-top: 2px;">
                                    @purchase.PurchasedAt.ToString("dd.MM.yyyy HH:mm")
                                </div>
                            </div>
                            <div class="cs-footer-actions">
                                <a href="@Url.Action("ViewPlanAsync", "MealPlan", new { area = "WorldMiniApp", id = purchase.CreatedMealPlanId })"
                                   class="cs-btn-preview" style="background: linear-gradient(135deg, var(--ink-deep), var(--ink-deep-2)); color: white; border: none;">
                                    <i class="bi bi-calendar2-week me-1"></i>@SharedLocalizer["MyProfile.Open"]
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        @if (isOrb)
        {
            <div class="tab-pane fade" id="tab-videos">
                <div class="video-grid">
                    @foreach (var posting in Model.MyVideos)
                    {
                        <div class="grid-item shadow-sm @(posting.IsOffline ? "is-offline" : "")" onclick="openFeed('myvideos', @posting.Recipe.Id)">
                            <div class="grid-action-bar" onclick="event.stopPropagation();">
                                <a class="grid-action-btn edit"
                                   href="@Url.Action("EditRecipe", "Home", new { area = "WorldMiniApp", postingId = posting.Id })"
                                   title="@SharedLocalizer["MyProfile.Edit"]">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                @if (!posting.IsOffline)
                                {
                                    <form method="post" action="@Url.Action("SetPostingOffline", "Feed", new { area = "WorldMiniApp" })"
                                          onsubmit="return confirm('@SharedLocalizer["MyProfile.TakePostingOfflineConfirm"].Value.Replace("'", "\\'")') ;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="postingId" value="@posting.Id" />
                                        <input type="hidden" name="userHash" value="@Model.User.UserHash" />
                                        <button type="submit" class="grid-action-btn offline"
                                                title="@SharedLocalizer["MyProfile.TakeOffline"]">
                                            <i class="bi bi-eye-slash-fill"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" action="@Url.Action("SetPostingOnline", "Feed", new { area = "WorldMiniApp" })"
                                          onsubmit="return confirm('@SharedLocalizer["MyProfile.PutPostingOnlineConfirm"].Value.Replace("'", "\\'")') ;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="postingId" value="@posting.Id" />
                                        <input type="hidden" name="userHash" value="@Model.User.UserHash" />
                                        <button type="submit" class="grid-action-btn online"
                                                title="@SharedLocalizer["MyProfile.PutOnline"]">
                                            <i class="bi bi-eye-fill"></i>
                                        </button>
                                    </form>
                                }
                                @if (isAdmin)
                                {
                                    <form method="post" action="@Url.Action("DeletePosting", "Home", new { area = "WorldMiniApp" })"
                                          onsubmit="return confirm('@SharedLocalizer["MyProfile.DeletePostingPermanentlyConfirm"]') ;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="postingId" value="@posting.Id" />
                                        <input type="hidden" name="userHash" value="@Model.User.UserHash" />
                                        <button type="submit" class="grid-action-btn delete"
                                                title="@SharedLocalizer["MyProfile.DeletePermanently"]">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                            @{
                                var src = posting.Source ?? string.Empty;
                                var thumb = posting.ThumbnailUrl ?? string.Empty;
                                var lower = src.ToLowerInvariant();
                                var isVideo = lower.Contains(".mp4") || lower.Contains(".mov") || lower.Contains(".webm") || lower.Contains(".m3u8");
                            }
                            @if (isVideo)
                            {
                                var fallbackSrc = src.Replace("_processed.mp4", ".mp4", StringComparison.OrdinalIgnoreCase);
                                <video class="grid-img" src="@src" data-wm-fallback-src="@fallbackSrc" muted playsinline preload="metadata" crossorigin="anonymous" poster="@thumb"></video>
                            }
                            else
                            {
                                <img src="@(string.IsNullOrEmpty(thumb) ? src : thumb)" class="grid-img">
                            }
                            @if (posting.IsOffline)
                            {
                                <div class="grid-offline-badge">OFFLINE</div>
                            }
                            <div class="grid-overlay"><i class="bi bi-camera-reels"></i></div>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</div>

@section Scripts {
    <!-- MiniKit für World App (ES6 Module) -->
    <script type="module" src="~/js/minikitt.js"></script>

    <!-- ethers.js für Wallet Interaktion -->
    <script src="https://cdn.jsdelivr.net/npm/ethers@6.13.2/dist/ethers.umd.min.js"></script>

    <script>
        // Counter Animation
        function animateCounters() {
            const counters = document.querySelectorAll('.counter');
            counters.forEach(counter => {
                const target = +counter.getAttribute('data-target');
                const speed = 40;
                const updateCount = () => {
                    const count = +counter.innerText;
                    const inc = target / speed;
                    if (count < target) {
                        counter.innerText = Math.ceil(count + (inc < 1 ? 1 : inc));
                        setTimeout(updateCount, 20);
                    } else {
                        counter.innerText = target;
                    }
                };
                updateCount();
            });
        }

        // Feed Navigation (wie vorher)
        function openFeed(filterMode, scrollToId, targetUserHash = "") {
            const myUserHash = sessionStorage.getItem("UserToken") || localStorage.getItem("UserToken") || "@Model.User.UserHash";
            let url = `/WorldMiniApp/Feed/Index?filter=${filterMode}&scrollToId=${scrollToId}&userHash=${myUserHash}`;
            if (filterMode === 'creator' && targetUserHash !== "") {
                url += `&targetUserHash=${targetUserHash}`;
            }
            window.location.href = url;
        }

        function initLikesSwitcher() {
            const buttons = document.querySelectorAll('[data-likes-panel-target]');
            const panels = document.querySelectorAll('[data-likes-panel]');
            if (!buttons.length || !panels.length) return;

            buttons.forEach(button => {
                button.addEventListener('click', () => {
                    const target = button.getAttribute('data-likes-panel-target');
                    buttons.forEach(btn => btn.classList.toggle('active', btn === button));
                    panels.forEach(panel => panel.classList.toggle('active', panel.getAttribute('data-likes-panel') === target));
                });
            });
        }

        // If *_processed.mp4 is not available yet (common in local/dev), fall back to the raw upload.
        function initGridVideoFallback() {
            document.querySelectorAll('video[data-wm-fallback-src]').forEach(v => {
                v.addEventListener('error', () => {
                    const fb = v.getAttribute('data-wm-fallback-src') || '';
                    if (!fb) return;
                    if (v.getAttribute('data-wm-fallback-used') === '1') return;
                    v.setAttribute('data-wm-fallback-used', '1');
                    v.src = fb;
                    v.load();
                });
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            animateCounters();
            initLikesSwitcher();
            initGridVideoFallback();

            // Alter profileLanguageProxy Code entfernt - Button existiert nicht mehr

            const dashboardToggleBtn = document.getElementById('dashboardToggleBtn');
            const dashboardCaret = document.getElementById('dashboardToggleCaret');
            const dashboardCollapse = document.getElementById('dashboardEmbedCollapse');
            if (dashboardToggleBtn && dashboardCollapse) {
                const syncDashboardState = (open) => {
                    dashboardToggleBtn.classList.toggle('is-open', open);
                    if (dashboardCaret) {
                        dashboardCaret.textContent = open ? '▴' : '▾';
                    }
                };

                syncDashboardState(dashboardCollapse.classList.contains('show'));
                dashboardCollapse.addEventListener('shown.bs.collapse', () => syncDashboardState(true));
                dashboardCollapse.addEventListener('hidden.bs.collapse', () => syncDashboardState(false));
            }

            // Deep-link to a tab (e.g. .../MyProfile#tab-ai)
            try {
                const hash = (window.location.hash || '').trim();
                if (hash && hash.startsWith('#tab-')) {
                    const btn = document.querySelector(`[data-bs-target="${hash}"]`);
                    if (btn && window.bootstrap) {
                        const tab = bootstrap.Tab.getOrCreateInstance(btn);
                        tab.show();
                    }
                }
            } catch { /* ignore */ }

            // Trading Agent initialization
            initTradingAgent();
        });

        // Trading Agent Functions
        let currentAgent = null;
        let agentLoaded = false;

        function initTradingAgent() {
            const tradingAgentToggleBtn = document.getElementById('tradingAgentToggleBtn');
            const tradingAgentCaret = document.getElementById('tradingAgentToggleCaret');
            const tradingAgentCollapse = document.getElementById('tradingAgentCollapse');

            if (!tradingAgentCollapse) return;

            // Sync toggle button state
            const syncTradingAgentState = (open) => {
                if (tradingAgentToggleBtn) {
                    tradingAgentToggleBtn.classList.toggle('is-open', open);
                }
                if (tradingAgentCaret) {
                    tradingAgentCaret.textContent = open ? '▴' : '▾';
                }
            };

            // Load agent when collapse is opened
            tradingAgentCollapse.addEventListener('shown.bs.collapse', () => {
                syncTradingAgentState(true);
                if (!agentLoaded) {
                    loadAgentStatus();
                    agentLoaded = true;
                }
            });

            tradingAgentCollapse.addEventListener('hidden.bs.collapse', () => {
                syncTradingAgentState(false);
            });
        }

        async function loadAgentStatus() {
            const container = document.getElementById('agent-container');
            if (!container) return;

            container.innerHTML = '<div class="text-center" style="padding: 40px 20px;"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>';

            try {
                const response = await fetch('@Url.Action("GetAgentStatus", "TradingAgent", new { area = "WorldMiniApp" })');
                const data = await response.json();

                if (!data.success) {
                    container.innerHTML = `<div class="alert alert-danger">${data.error || 'Fehler beim Laden'}</div>`;
                    return;
                }

                if (!data.hasAgent) {
                    renderCreateAgentForm(container);
                } else {
                    currentAgent = data.agent;
                    renderAgentDashboard(container, data.agent, data.recentTrades || []);
                }
            } catch (error) {
                console.error('Error loading agent:', error);
                container.innerHTML = '<div class="alert alert-danger">Fehler beim Laden des Trading Agents</div>';
            }
        }

        function renderCreateAgentForm(container) {
            container.innerHTML = `
                <div style="max-width: 500px; margin: 0 auto; text-align: center;">
                    <div style="font-size: 60px; margin-bottom: 20px;">📊</div>
                    <h3 style="margin-bottom: 16px;">Trading Agent erstellen</h3>
                    <p style="color: var(--ink-mute); margin-bottom: 20px;">
                        Erstelle einen autonomen Trading Agent mit eigenem Wallet.<br>
                        Der Agent handelt automatisch mit deinem Funding (30 WLD empfohlen).
                    </p>
                    <div style="background: var(--surface-2); padding: 16px; border-radius: 12px; margin-bottom: 30px; text-align: left; font-size: 14px;">
                        <div style="font-weight: 600; margin-bottom: 8px;"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>AgentKit / World Flow:</div>
                        <ul style="margin: 0; padding-left: 20px; color: var(--ink-mute);">
                            <li>Trades laufen primär über AgentKit statt über einen separaten ETH-Gas-Puffer</li>
                            <li>Dein World-Hash wird an den AgentKit-Init weitergereicht</li>
                            <li>Kein initialer Auto-Swap von WLD zu ETH mehr beim Funding</li>
                        </ul>
                    </div>
                    <form id="createAgentForm" onsubmit="handleCreateAgent(event)">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <input type="text" class="form-control" name="agentName" placeholder="Agent Name (optional)" style="border-radius: 12px; padding: 12px;">
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg" style="border-radius: 12px; padding: 12px 40px; width: 100%;">
                            <i class="bi bi-robot me-2"></i>Agent erstellen
                        </button>
                    </form>
                </div>
            `;
        }

        async function handleCreateAgent(event) {
            event.preventDefault();
            const form = event.target;
            const formData = new FormData(form);
            const submitBtn = form.querySelector('button[type="submit"]');

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Erstelle...';

            try {
                const response = await fetch('@Url.Action("CreateAgent", "TradingAgent", new { area = "WorldMiniApp" })', {
                    method: 'POST',
                    body: formData
                });
                const data = await response.json();

                if (data.success) {
                    await loadAgentStatus();
                } else {
                    alert(data.error || 'Fehler beim Erstellen');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-robot me-2"></i>Agent erstellen';
                }
            } catch (error) {
                console.error('Error creating agent:', error);
                alert('Fehler beim Erstellen des Agents');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-robot me-2"></i>Agent erstellen';
            }
        }

        function renderAgentDashboard(container, agent, trades) {
            const statusColor = agent.status === 'Active' ? 'success' : agent.status === 'Paused' ? 'warning' : 'secondary';
            const profitColor = agent.profitLoss >= 0 ? 'success' : 'danger';
            const profitSign = agent.profitLoss >= 0 ? '+' : '';

            container.innerHTML = `
                <div style="max-width: 800px; margin: 0 auto;">
                    <!-- Header -->
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px;">
                        <div>
                            <h3 style="margin: 0 0 8px 0;">${agent.name}</h3>
                            <span class="badge bg-${statusColor}">${agent.status}</span>
                        </div>
                        <div style="text-align: right;">
                            <div style="font-size: 12px; color: var(--ink-mute);">Wallet</div>
                            <div style="font-size: 11px; font-family: monospace;">${agent.walletAddress.substring(0, 10)}...${agent.walletAddress.substring(agent.walletAddress.length - 8)}</div>
                        </div>
                    </div>

                    <!-- Stats Grid -->
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="card" style="border-radius: 16px; border: none; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                                <div class="card-body text-center">
                                    <div style="font-size: 12px; color: var(--ink-mute); margin-bottom: 4px;">WLD Balance</div>
                                    <div style="font-size: 20px; font-weight: 700;">${agent.currentBalance.toFixed(2)}</div>
                                    <div style="font-size: 11px; color: var(--ink-mute);">Trading</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card" style="border-radius: 16px; border: none; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                                <div class="card-body text-center">
                                    <div style="font-size: 12px; color: var(--ink-mute); margin-bottom: 4px;">ETH / WETH Reserve</div>
                                    <div style="font-size: 20px; font-weight: 700; color: ${agent.currentBalanceETH > 0 ? 'var(--bs-success)' : 'var(--ink-mute)'};">${agent.currentBalanceETH.toFixed(6)}</div>
                                    <div style="font-size: 11px; color: var(--ink-mute);">Optionaler Direkt-Swap-Puffer</div>
