            if (amount < 1) {
                alert('? Mindestbetrag: 1 WLD');
                return;
            }

            // Close modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('fundingModal'));
            modal.hide();

            // Start funding
            await handleFundAgent(currentFundingAgentId, currentFundingWallet, amount);
