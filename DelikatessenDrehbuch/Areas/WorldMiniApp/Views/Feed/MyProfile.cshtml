        function testWETHPayment(agentId, walletAddress) {
            const amount = prompt('💡 DEBUG TEST: WETH Payment\n\nWie viel WETH? (Test-Betrag)', '0.001');

            if (!amount || parseFloat(amount) <= 0) {
                alert('⚠️ Abgebrochen oder ungültiger Betrag');
                return;
            }

            alert('💡 Starte DEBUG Test mit:\n\nAgent: ' + agentId + '\nWallet: ' + walletAddress + '\nBetrag: ' + amount + ' WETH\n\nAlle Debug-Alerts werden angezeigt!');

            // Rufe die Debug-Version auf
            handleWETHFunding(agentId, walletAddress, parseFloat(amount));
        }

        async function handleWETHFunding(agentId, walletAddress, amount) {
            alert('?? DEBUG #1: handleWETHFunding GESTARTET\n\nAgent ID: ' + agentId + '\nWallet: ' + walletAddress + '\nBetrag: ' + amount + ' WETH');
            console.log('=== WETH Funding Debug Start ===');
            console.log('AgentId:', agentId);
            console.log('WalletAddress:', walletAddress);
            console.log('Amount:', amount);

            try {
                // Wait for MiniKit
                alert('?? DEBUG #2: Warte auf MiniKit...');
                let attempts = 0;
                while (!window.startMiniKitPayment && attempts < 30) {
                    await new Promise(resolve => setTimeout(resolve, 100));
                    attempts++;
                }

                if (!window.startMiniKitPayment) {
                    alert('? DEBUG #3: MiniKit NICHT gefunden!\n\nstartMiniKitPayment ist undefined.');
                    console.error('MiniKit not found!');
                    return;
                }

                alert('? DEBUG #4: MiniKit gefunden!\n\nVersuche jetzt Payment mit WETH...');
                console.log('MiniKit found, attempting payment...');

                // Use MiniKit Payment for WETH
                // Versuche verschiedene Token-Namen
                let payResult;
                let usedToken = '';

                try {
                    // Versuch 1: WETH
                    alert('?? DEBUG #5: Versuch 1 - Token: WETH\n\nStarte Payment...');
                    console.log('Attempting WETH payment...');

                    payResult = await window.startMiniKitPayment({
                        to: walletAddress,
                        tokenSymbol: 'WETH',
                        amount: amount.toString(),
                        reference: `agent-weth-funding-${agentId}-${Date.now()}`,
                        description: `WETH Funding für Trading Agent #${agentId}: ${amount} WETH`
                    });

                    usedToken = 'WETH';
                    alert('? DEBUG #6: WETH Payment erfolgreich!\n\nResult: ' + JSON.stringify(payResult, null, 2));
                    console.log('WETH payment success:', payResult);

                } catch (e1) {
                    alert('? DEBUG #7: WETH fehlgeschlagen!\n\nFehler: ' + e1.message + '\n\nVersuche jetzt ETH...');
                    console.error('WETH payment failed:', e1);

                    try {
                        // Versuch 2: ETH
                        alert('?? DEBUG #8: Versuch 2 - Token: ETH\n\nStarte Payment...');
                        console.log('Attempting ETH payment...');

                        payResult = await window.startMiniKitPayment({
                            to: walletAddress,
                            tokenSymbol: 'ETH',
                            amount: amount.toString(),
                            reference: `agent-eth-funding-${agentId}-${Date.now()}`,
                            description: `ETH Funding für Trading Agent #${agentId}: ${amount} ETH`
                        });

                        usedToken = 'ETH';
                        alert('? DEBUG #9: ETH Payment erfolgreich!\n\nResult: ' + JSON.stringify(payResult, null, 2));
                        console.log('ETH payment success:', payResult);

                    } catch (e2) {
                        alert('⚠️ DEBUG #10: BEIDE FEHLGESCHLAGEN!\n\nWETH Error: ' + e1.message + '\n\nETH Error: ' + e2.message + '\n\nGrund: MiniKit unterstützt vermutlich nur WLD!');
                        console.error('Both WETH and ETH failed:', { wethError: e1, ethError: e2 });

                        alert('💡 Verwende stattdessen "WETH senden (Anleitung)" Button für manuelles Senden!');
                        return;
                    }
                }

                alert('?? DEBUG #11: Payment abgeschlossen mit ' + usedToken + '\n\nPayload:\n' + JSON.stringify(payResult, null, 2));
                console.log('Final payment result:', payResult);

                const txHash = payResult?.transaction_id || payResult?.txHash || payResult?.reference || '';
                alert('?? DEBUG #12: Transaction Hash extrahiert:\n' + txHash);

                if (payResult?.status === 'success' || payResult?.transaction_id || payResult?.txHash) {
                    alert('⚠️ DEBUG #13: Payment Status OK!\n\nBestätige jetzt im Backend...');

                    // Bestätige WETH Funding im Backend
                    const formData = new FormData();
                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (tokenInput) {
                        formData.append('__RequestVerificationToken', tokenInput.value);
                    }
                    formData.append('agentId', agentId);
                    formData.append('amount', amount.toString());
                    formData.append('txHash', txHash);

