        async function handleWithdrawEthReserve(agentId, availableAmount) {
            const defaultTarget = '@(Model.User?.UserHash ?? string.Empty)';
            const normalizedDefaultTarget = defaultTarget && defaultTarget.startsWith('0x') && defaultTarget.length === 42
                ? defaultTarget
                : '';

            const targetWalletAddress = prompt(
                'ETH/WETH Zieladresse eingeben',
                normalizedDefaultTarget
            );

            if (!targetWalletAddress) {
                return;
            }

            const amountInput = prompt(
                `Wie viel ETH/WETH Reserve willst du abheben?\n\nVerfuegbar: ${Number(availableAmount).toFixed(6)}`,
                Number(availableAmount).toFixed(6)
            );

            if (!amountInput) {
                return;
            }

            const amount = parseFloat(amountInput);
            if (!amount || amount <= 0) {
                alert('? Bitte einen gueltigen Betrag eingeben.');
                return;
            }

            if (amount > Number(availableAmount)) {
                alert('? Betrag ist hoeher als die verfuegbare ETH/WETH-Reserve.');
                return;
            }

            if (!confirm(`${amount.toFixed(6)} ETH/WETH an\n${targetWalletAddress}\n\nauszahlen?`)) {
                return;
            }

            const formData = new FormData();
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (tokenInput) {
                formData.append('__RequestVerificationToken', tokenInput.value);
            }

            formData.append('agentId', agentId);
            formData.append('amount', amount.toString());
            formData.append('targetWalletAddress', targetWalletAddress.trim());

            try {
                const response = await fetch('@Url.Action("WithdrawEthReserve", "TradingAgent", new { area = "WorldMiniApp" })', {
                    method: 'POST',
                    body: formData
                });
                const data = await response.json();

                if (data.success) {
                    alert(`? ETH/WETH-Reserve ausgezahlt.\n\nTX: ${data.txHash || 'gesendet'}`);
                    agentLoaded = false;
                    await loadAgentStatus();
                } else {
                    alert('? Fehler:\n\n' + (data.error || 'Unbekannter Fehler'));
                }
            } catch (error) {
                console.error('Error withdrawing ETH/WETH reserve:', error);
                alert('? Fehler beim ETH/WETH-Abheben:\n\n' + error.message);
            }
        }

