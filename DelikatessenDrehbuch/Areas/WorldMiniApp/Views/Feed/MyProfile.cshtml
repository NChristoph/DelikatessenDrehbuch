@using DelikatessenDrehbuch.Areas.WorldMiniApp.Models

@model UserProfileViewModel
@{
    ViewData["Title"] = "Mein Profil";
    Layout = null;
    bool isOrb = Model.User.IsVerified == "orb" || Model.User.UserHash == "0x2da33d4d7152caf4dad616bffa6fed2a7fd896ebe32be8806c79ed5010ff4839";
}

<!DOCTYPE html>
<html lang="de">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #000;
            color: white;
            font-family: -apple-system, sans-serif;
            padding-bottom: 80px;
        }

        .profile-header {
            padding: 30px 20px 20px;
            text-align: center;
            background: linear-gradient(to bottom, #1a1a1a, #000);
        }

        .profile-img {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #FF9966;
            margin-bottom: 10px;
        }

        .stats-row {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-top: 15px;
        }

        .stat-item {
            text-align: center;
        }

        .stat-val {
            font-weight: bold;
            font-size: 1.1rem;
            display: block;
        }

        .stat-label {
            font-size: 0.75rem;
            color: #aaa;
            text-transform: uppercase;
        }

        .nav-tabs {
            border-bottom: 1px solid #1f1f1f;
            margin: 20px 16px 0;
            padding: 6px;
            gap: 8px;
            background: #101010;
            border-radius: 999px;
        }

        .nav-tabs .nav-item {
            flex: 1 1 0;
        }

        .nav-link {
            color: #cfcfcf;
            background: transparent;
            border: 1px solid transparent;
            padding: 10px 14px;
            font-size: 0.95rem;
            border-radius: 999px;
            transition: all 0.2s ease-in-out;
        }

            .nav-link:hover {
                color: #fff;
                background: #1c1c1c;
            }

            .nav-link.active {
                color: #111;
                background: linear-gradient(135deg, #FF9966, #FF5E62);
                border-color: #FF9966;
                font-weight: 700;
            }

        /* Grid */
        .video-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2px;
        }

        .grid-item {
            position: relative;
            aspect-ratio: 2/3;
            background: #222;
            overflow: hidden;
        }

        .grid-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Icon oben rechts im Grid-Item (Play oder Stern) */
        .type-icon {
            position: absolute;
            top: 5px;
            right: 5px;
            color: white;
            font-size: 0.9rem;
            text-shadow: 0 1px 3px rgba(0,0,0,0.8);
        }

        /* Abo Liste */
        .abo-item {
            display: flex;
            align-items: center;
            padding: 12px;
            border-bottom: 1px solid #222;
        }

        .abo-img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin-right: 15px;
        }

        .plan-card {
            background: #121212;
            border: 1px solid #1f1f1f;
        }

        /* Bottom Nav */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            width: 100%;
            height: 80px;
            background: rgba(20,20,20,0.95);
            display: flex;
            justify-content: space-around;
            align-items: center;
            border-top: 1px solid #333;
        }

        .nav-item {
            color: #bdc3c7;
            font-size: 1.8rem;
        }
    </style>
</head>
<body>

    <div class="profile-header">
        <img src="https://ui-avatars.com/api/?name=@Model.User.UserName&background=random" class="profile-img">
        <h1 class="profile-name">@Model.User.UserName</h1>

        @if (isOrb)
        {
            <div class="badge bg-warning text-dark mb-2">Verifiziert</div>
        }

        <div class="profile-hash">@@@Model.User.UserHash.Substring(0, 8)...</div>

        <div class="stats-row">
            <div class="stat-item"><span class="stat-val">@Model.Following.Count</span><span class="stat-label">Folge ich</span></div>
            <div class="stat-item"><span class="stat-val">@Model.LikedRecipes.Count</span><span class="stat-label">Likes</span></div>
            @if (isOrb)
            {
                <div class="stat-item"><span class="stat-val">@Model.FollowerCount</span><span class="stat-label">Follower</span></div>
            }
        </div>
    </div>

    <ul class="nav nav-tabs d-flex" role="tablist">
        <li class="nav-item flex-fill text-center" role="presentation">
            <button class="nav-link w-100 active" data-bs-toggle="tab" data-bs-target="#likes" type="button"><i class="bi bi-heart-fill"></i> Likes</button>
        </li>
        <li class="nav-item flex-fill text-center" role="presentation">
            <button class="nav-link w-100" data-bs-toggle="tab" data-bs-target="#abos" type="button"><i class="bi bi-people-fill"></i> Abos</button>
        </li>
        <li class="nav-item flex-fill text-center" role="presentation">
            <button class="nav-link w-100" data-bs-toggle="tab" data-bs-target="#mealplans" type="button"><i class="bi bi-calendar-week-fill"></i> Pläne</button>
        </li>
        @if (isOrb)
        {
            <li class="nav-item flex-fill text-center" role="presentation">
                <button class="nav-link w-100" data-bs-toggle="tab" data-bs-target="#myvideos" type="button"><i class="bi bi-camera-video-fill"></i> Videos</button>
            </li>
        }
    </ul>

    <div class="tab-content">

        <div class="tab-pane fade show active" id="likes">
            <div class="video-grid">
                @foreach (var recipe in Model.LikedRecipes)
                {
                    
                    var thumbUrl =  recipe.ThumbnailUrl;
                    var sourceUrl = recipe.Source;

                   
                    var displayUrl = !string.IsNullOrEmpty(thumbUrl) ? thumbUrl : sourceUrl;

                   
                    bool isVideo = sourceUrl.EndsWith(".mp4");

                    bool useVideoTag = isVideo && string.IsNullOrEmpty(thumbUrl);

                    <div class="grid-item" onclick="openFeed('likes', @recipe.Id)">

                        @if (useVideoTag)
                        {
                           
                            <video class="grid-img" muted playsinline preload="metadata" onloadeddata="this.currentTime=0.1">
                                <source src="@displayUrl#t=0.1" type="video/mp4">
                            </video>
                        }
                        else
                        {
                          
                            <img src="@displayUrl" class="grid-img" loading="lazy">
                        }

                        @if (isVideo)
                        {
                            <div class="type-icon"><i class="bi bi-play-fill"></i></div>
                        }
                    </div>
                }
            </div>
            @if (Model.LikedRecipes.Count == 0)
            {
                <p class="text-center text-secondary p-4">Keine Likes.</p>
            }
        </div>

        <div class="tab-pane fade" id="abos">
            <div class="p-2">
                @foreach (var creator in Model.Following)
                {
                    <div class="abo-item" onclick="openFeed('creator', 0, '@creator.UserHash')" style="cursor: pointer;">
                        <img src="https://ui-avatars.com/api/?name=@creator.UserName" class="abo-img">
                        <span class="fw-bold">@creator.UserName</span>
                        <i class="bi bi-chevron-right ms-auto text-secondary"></i>
                    </div>
                }
            </div>
            @if (Model.Following.Count == 0)
            {
                <p class="text-center text-secondary p-4">Niemand abonniert.</p>
            }
        </div>

        <div class="tab-pane fade" id="mealplans">
            <div class="p-3">
                @if (Model.MealPlans.Count == 0)
                {
                    <p class="text-center text-secondary p-4">Noch keine Pläne erstellt.</p>
                }
                else
                {
                    <div class="d-grid gap-3">
                        @foreach (var plan in Model.MealPlans)
                        {
                            <div class="plan-card rounded-4 p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h5 class="fw-bold mb-1">@plan.Title</h5>
                                        <div class="text-muted small">
                                            <i class="bi bi-calendar3 me-1"></i> @plan.CreationTime.ToString("dd. MMM yyyy")
                                        </div>
                                    </div>
                                    <div class="icon-box rounded-circle bg-dark d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        <span class="fs-6">🗓️</span>
                                    </div>
                                </div>
                                <div class="mt-3 d-flex gap-2">
                                    <a href="@Url.Action("ViewPlan", "Home", new { area = "WorldMiniApp", id = plan.Id })"
                                       class="btn btn-sm btn-light rounded-pill flex-grow-1 fw-semibold">
                                        <i class="bi bi-eye-fill me-2"></i> Anzeigen
                                    </a>
                                    <a href="@Url.Action("EditPlan", "Home", new { area = "WorldMiniApp", id = plan.Id })"
                                       class="btn btn-sm btn-outline-light rounded-pill">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @if (isOrb)
        {
            <div class="tab-pane fade" id="myvideos">
                <div class="video-grid">
                    @foreach (var posting in Model.MyVideos)
                    {
                        // Gleiche Logik wie bei Likes, aber wir sind direkt im Posting
                        var thumbUrl = posting.ThumbnailUrl;
                        var sourceUrl = posting.Source;
                        var displayUrl = !string.IsNullOrEmpty(thumbUrl) ? thumbUrl : sourceUrl;
                        bool isVideo = sourceUrl != null && sourceUrl.EndsWith(".mp4");
                        bool useVideoTag = isVideo && string.IsNullOrEmpty(thumbUrl);

                        <div class="grid-item" onclick="openFeed('myvideos', @posting.Recipe.Id)">

                            @if (useVideoTag)
                            {
                                <video class="grid-img" muted playsinline preload="metadata" onloadeddata="this.currentTime=0.1">
                                    <source src="@displayUrl#t=0.1" type="video/mp4">
                                </video>
                            }
                            else
                            {
                                <img src="@displayUrl" class="grid-img" loading="lazy">
                            }

                            <div class="type-icon">
                                @if (isVideo)
                                {
                                    <i class="bi bi-play-fill"></i>
                                }
                                else
                                {

                                    <i class="bi bi-image"></i>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (Model.MyVideos.Count == 0)
                {
                    <p class="text-center text-secondary p-4">Keine Videos.</p>
                }
            </div>
        }

    </div>

    <script>
        function openFeed(filterMode, scrollToId, targetUserHash = "") {
            const myUserHash = sessionStorage.getItem("UserToken") || localStorage.getItem("UserToken");
            let url = `/WorldMiniApp/Feed/Index?filter=${filterMode}&scrollToId=${scrollToId}&userHash=${myUserHash}`;
            if (filterMode === 'creator' && targetUserHash !== "") {
                url += `&targetUserHash=${targetUserHash}`;
            }
            window.location.href = url;
        }
    </script>

    <div class="bottom-nav">
        <a href="@Url.Action("Index", "Home")" class="nav-item"><i class="bi bi-house-door"></i></a>
        <div class="nav-item"><i class="bi bi-calendar-week"></i></div>
        <div style="position:relative; top:-25px;">
            <a href="@Url.Action("Upload", "Home")" style="background: linear-gradient(135deg, #FF9966, #FF5E62); width: 65px; height: 65px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; border: 5px solid white;">
                <i class="bi bi-plus" style="font-size: 2.2rem;"></i>
            </a>
        </div>
        <div class="nav-item"><i class="bi bi-search"></i></div>
        <div class="nav-item" style="color: #FF9966;"><i class="bi bi-person-fill"></i></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
