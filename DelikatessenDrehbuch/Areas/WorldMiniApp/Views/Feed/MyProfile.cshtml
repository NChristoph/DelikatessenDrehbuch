        async function handleFundAgent(agentId, walletAddress, amount) {
            alert('?? handleFundAgent AUFGERUFEN! Agent ID: ' + agentId + ', Betrag: ' + amount + ' WLD');

            try {
                // Wait for startMiniKitPayment function to load (max 3 seconds)
                let attempts = 0;
                while (!window.startMiniKitPayment && attempts < 30) {
                    await new Promise(resolve => setTimeout(resolve, 100));
                    attempts++;
                }

                if (!window.startMiniKitPayment) {
                    alert('⚠️ MiniKit nicht verfügbar!\n\nBitte Seite neu laden oder in World App öffnen.');
                    return;
                }

                alert('⚠️ MiniKit gefunden! Starte Zahlung für ' + amount + ' WLD...');

                // Use the global startMiniKitPayment function from minikitt.js
                const payResult = await window.startMiniKitPayment({
                    to: walletAddress,
                    tokenSymbol: 'WLD',
                    amount: amount.toString(),
                    reference: `agent-funding-${agentId}-${Date.now()}`,
                    description: `Funding für Trading Agent #${agentId}: ${amount} WLD`
                });

                console.log('Payment result:', payResult);
                alert('💡 Payment Result:\n\n' + JSON.stringify(payResult, null, 2));

                // Extract transaction ID from various possible locations
                const txHash = payResult?.transaction_id ||
                               payResult?.txHash ||
                               payResult?.reference ||
                               '';

                console.log('Extracted TX Hash:', txHash);
                alert('Transaction Hash: ' + txHash);

                if (payResult?.status === 'success' || payResult?.transaction_id || payResult?.txHash) {
                    // Bestätige Funding im Backend
                        const formData = new FormData();
                        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                        if (tokenInput) {
                            formData.append('__RequestVerificationToken', tokenInput.value);
                        }
                        formData.append('agentId', agentId);
                        formData.append('amount', amount.toString());
                        formData.append('txHash', txHash);

                        const response = await fetch('@Url.Action("ConfirmFunding", "TradingAgent", new { area = "WorldMiniApp" })', {
                            method: 'POST',
                            body: formData
                        });
                        const data = await response.json();

                    if (data.success) {
                        agentLoaded = false;
                        await loadAgentStatus();
                        alert('⚠️ Funding erfolgreich! ' + amount + ' WLD wurden übertragen.');
                    } else {
                        alert('⚠️ ' + (data.error || 'Fehler beim Bestätigen'));
                    }
                } else {
                    alert('⚠️ Zahlung abgebrochen oder fehlgeschlagen');
                }
            } catch (error) {
                console.error('Error funding agent:', error);

                // Show detailed error information
                const errorInfo = {
                    message: error.message,
                    stack: error.stack,
                    type: error.constructor.name,
                    full: error.toString()
                };

                alert('? ERROR DETAILS:\n\n' +
                      'Message: ' + error.message + '\n\n' +
                      'Type: ' + error.constructor.name + '\n\n' +
                      'Full: ' + error.toString());

                // If error message contains "Zahlung fehlgeschlagen" it might have transaction info
                if (error.message && error.message.includes('transaction')) {
                    alert('💡 Die Zahlung könnte trotzdem durchgegangen sein!\n\nBitte prüfe deine Wallet Transaktionen.');
                }
            }
        }

