@using DelikatessenDrehbuch.Areas.WorldMiniApp.Models
@model UserProfileViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Mein Profil";
    Layout = "_MiniAppLayout";

    bool isOrb = Model.User.IsVerified == "orb"
        || Model.User.UserHash == "0x2da33d4d7152caf4dad616bffa6fed2a7fd896ebe32be8806c79ed5010ff4839";

    var language = (Context.Request.Cookies["deli-lang"] ?? "de").ToLowerInvariant();
    string T(string de, string en, string es, string pt) => language switch
    {
        "en" => en,
        "es" => es,
        "pt" => pt,
        _ => de
    };

    string ShortHash(string h)
    {
        if (string.IsNullOrWhiteSpace(h)) return "0x00";
        return h.Length >= 8 ? h.Substring(0, 8) : h;
    }

    string DeleteConfirmText(string title)
    {
        var text = T($"Möchtest du den Plan \"{title}\" wirklich löschen?",
                     $"Do you really want to delete the plan \"{title}\"?",
                     "¿Quieres eliminar el plan?",
                     "Quer mesmo apagar o plano?");
        return text.Replace("'", "\\'");
    }
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --deli-primary: #2D4F1E;
        --deli-gold: #D4AF37;
        /* Theme-able surfaces (wichtig: Header + Settings sollen NICHT fix rosa/grün sein) */
        --surface: rgba(255,255,255,0.88);
        --surface-2: rgba(255,255,255,0.72);
        --text: #1A1A1A;
        --muted: rgba(0,0,0,0.55);
        --border: rgba(0,0,0,0.06);
        --shadow: 0 10px 30px rgba(0,0,0,0.04);
        /* Akzent, wird per Theme gesetzt */
        --accent: #2D4F1E;
        --accent-contrast: #ffffff;
        /* Header Background, wird per Theme gesetzt */
        --header-bg: linear-gradient(135deg, rgba(45,79,30,0.12) 0%, rgba(255, 153, 102, 0.12) 100%);
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background: #F8FAF7;
        color: var(--text);
        transition: background 0.25s ease, color 0.25s ease;
    }

        /* --- Themes: setzen Variablen statt fixen Farben --- */
        body.profile-theme-color {
            background: #F8FAF7;
            --accent: #2D4F1E;
            --accent-contrast: #ffffff;
            --surface: rgba(255,255,255,0.88);
            --surface-2: rgba(255,255,255,0.72);
            --text: #1A1A1A;
            --muted: rgba(0,0,0,0.55);
            --border: rgba(0,0,0,0.06);
            --header-bg: linear-gradient(135deg, rgba(45,79,30,0.12) 0%, rgba(255,153,102,0.12) 100%);
        }

        body.profile-theme-black {
            background: #000;
            --accent: #ffffff;
            --accent-contrast: #000;
            --surface: #111;
            --surface-2: #111;
            --text: #ffffff;
            --muted: rgba(255,255,255,0.65);
            --border: rgba(255,255,255,0.10);
            --shadow: none;
            --header-bg: #111;
        }

        body.profile-theme-white {
            background: #fff;
            --accent: #111;
            --accent-contrast: #ffffff;
            --surface: rgba(247,247,247,0.92);
            --surface-2: rgba(245,245,245,0.85);
            --text: #1A1A1A;
            --muted: rgba(0,0,0,0.55);
            --border: rgba(0,0,0,0.06);
            --header-bg: linear-gradient(135deg, rgba(0,0,0,0.06) 0%, rgba(0,0,0,0.02) 100%);
        }

        body.profile-theme-rose {
            background: linear-gradient(135deg, #FFF5F7 0%, #FEE2E7 100%);
            --accent: #FFB6C1;
            --accent-contrast: #3b0a14;
            --surface: rgba(255,255,255,0.88);
            --surface-2: rgba(255,255,255,0.72);
            --text: #852D3E;
            --muted: rgba(133,45,62,0.60);
            --border: rgba(0,0,0,0.05);
            --header-bg: linear-gradient(135deg, rgba(255,182,193,0.22) 0%, rgba(255,182,193,0.10) 100%);
        }

        body.profile-theme-lavender {
            background: linear-gradient(135deg, #F3F0FF 0%, #EBE4FF 100%);
            --accent: #A78BFA;
            --accent-contrast: #160b2d;
            --surface: rgba(255,255,255,0.88);
            --surface-2: rgba(255,255,255,0.72);
            --text: #4B3D8A;
            --muted: rgba(75,61,138,0.60);
            --border: rgba(0,0,0,0.05);
            --header-bg: linear-gradient(135deg, rgba(167,139,250,0.22) 0%, rgba(167,139,250,0.10) 100%);
        }

    .profile-wrap {
        max-width: 500px;
        margin: 0 auto;
        padding: 14px 15px 110px;
    }

    /* Zurück Button: oben links & scrollt mit */
    .back-to-feed {
        position: sticky;
        top: 10px;
        z-index: 999;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        font-weight: 800;
        font-size: 0.9rem;
        color: var(--text);
        opacity: 0.9;
        padding: 8px 10px;
        border-radius: 14px;
        background: var(--surface);
        border: 1px solid var(--border);
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
        margin-bottom: 12px;
    }

    .profile-card {
        padding: 18px 16px 16px;
        border-radius: 35px;
        margin-bottom: 22px;
        background: var(--header-bg);
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
        transition: all 0.25s ease;
        backdrop-filter: blur(10px);
    }

    /* Header layout genau wie du willst:
           Links Avatar, rechts Orb -> darunter Name -> darunter Hash -> darunter Stats -> darunter Settings */
    .profile-top-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .avatar-main {
        width: 88px;
        height: 88px;
        border-radius: 26px;
        object-fit: cover;
        border: 3px solid rgba(255,255,255,0.85);
        background: #fff;
        box-shadow: 0 8px 20px rgba(0,0,0,0.10);
        flex: 0 0 auto;
    }

    .profile-right {
        flex: 1;
        min-width: 0;
        text-align: left;
        padding-top: 2px;
    }

    .orb-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        font-weight: 900;
        font-size: 0.72rem;
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
        box-shadow: 0 8px 18px rgba(0,0,0,0.06);
        margin-bottom: 8px;
    }

    .profile-name {
        font-weight: 900;
        font-size: 1.25rem;
        line-height: 1.15;
        margin: 0 0 4px 0;
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .profile-hash {
        font-size: 0.78rem;
        font-weight: 800;
        opacity: 0.7;
        color: var(--text);
        margin-bottom: 12px;
    }

    .stats-container {
        display: flex;
        justify-content: flex-start;
        gap: 18px;
        margin: 10px 0 14px;
        flex-wrap: wrap;
    }

    .stat-item {
        text-align: left;
    }

    .stat-val {
        font-size: 1.3rem;
        font-weight: 900;
        display: block;
        line-height: 1.1;
        color: var(--text);
    }

    .stat-lbl {
        font-size: 0.7rem;
        opacity: 0.65;
        text-transform: uppercase;
        letter-spacing: 1.1px;
        font-weight: 800;
        color: var(--text);
    }

    .btn-action {
        background: var(--accent);
        color: var(--accent-contrast) !important;
        border-radius: 18px;
        padding: 12px;
        width: 100%;
        border: none;
        font-weight: 900;
        font-size: 0.95rem;
        transition: transform 0.2s;
    }

        .btn-action:active {
            transform: scale(0.98);
        }

    .theme-dot {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        cursor: pointer;
        border: 2px solid transparent;
        transition: 0.2s;
    }

        .theme-dot:hover {
            transform: scale(1.1);
        }

    /* Settings Box: ebenfalls theme-fähig */
    .settings-box {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 12px;
        color: var(--text);
    }

    /* --- Tabs: unverändert in Stil wie bei dir --- */
    .nav-custom {
        display: flex;
        background: rgba(128,128,128,0.1);
        border-radius: 22px;
        padding: 6px;
        border: none;
        margin-bottom: 25px;
    }

        .nav-custom .nav-item {
            flex: 1;
        }

        .nav-custom .nav-link {
            width: 100%;
            border: none;
            border-radius: 18px;
            color: inherit;
            padding: 12px 5px;
            font-size: 0.7rem;
            font-weight: 800;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
            background: transparent;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            opacity: 0.5;
        }

            .nav-custom .nav-link.active {
                background: var(--surface);
                color: var(--accent);
                opacity: 1;
                box-shadow: 0 4px 15px rgba(0,0,0,0.08);
                transform: scale(1.02);
            }

    /* --- Content Grid (Hochformat 9:16) --- */
    .video-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
    }

    .grid-item {
        aspect-ratio: 9/16;
        border-radius: 14px;
        overflow: hidden;
        position: relative;
        background: #222;
        cursor: pointer;
    }

    .grid-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .grid-item:active .grid-img {
        transform: scale(0.95);
    }

    .grid-overlay {
        position: absolute;
        bottom: 10px;
        left: 10px;
        color: white;
        font-size: 0.9rem;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }

    .grid-edit-link {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.55);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        z-index: 2;
        text-decoration: none;
    }

        .grid-edit-link:hover {
            color: #fff;
            background: rgba(0, 0, 0, 0.75);
        }

    /* --- Buttons & Utilities --- */
    .btn-action {
        background: var(--deli-primary);
        color: white !important;
        border-radius: 18px;
        color: var(--text);
    }


    .quick-links {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        margin-top: 10px;
    }

    .quick-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        border-radius: 14px;
        padding: 10px 12px;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
        font-size: 0.85rem;
        font-weight: 800;
    }

    body.profile-theme-black .plan-card,
    body.profile-theme-black .list-group-item {
        background: #111 !important;
        color: #fff !important;
        border-color: #222 !important;
    }
</style>

<div class="profile-wrap">

    <a class="back-to-feed"
       href="@Url.Action("Index", "Feed", new { area = "WorldMiniApp", userHash = Model.User.UserHash })">
        <i class="bi bi-arrow-left"></i>
        @T("Zurück zum Feed", "Back to feed", "Volver al feed", "Voltar ao feed")
    </a>

    <div class="profile-card">
        <div class="profile-top-row">
            <img src="https://ui-avatars.com/api/?name=@(string.IsNullOrWhiteSpace(Model.User.UserName) ? "User" : Model.User.UserName)&background=random&size=200"
                 class="avatar-main"
                 alt="Avatar" />

            <div class="profile-right">
                @if (isOrb)
                {
                    <div class="orb-badge">
                        <i class="bi bi-patch-check-fill"></i>
                        ORB VERIFIED
                    </div>
                }

                <div class="profile-name">
                    @(string.IsNullOrWhiteSpace(Model.User.UserName) ? "User" : Model.User.UserName)
                </div>

                <div class="profile-hash">
                    @@@ShortHash(Model.User.UserHash)
                </div>

                <div class="stats-container">
                    <div class="stat-item">
                        <span class="stat-val counter" data-target="@Model.Following.Count">0</span>
                        <span class="stat-lbl">@T("Abos", "Following", "Siguiendo", "Seguindo")</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-val counter" data-target="@Model.LikedRecipes.Count">0</span>
                        <span class="stat-lbl">@T("Likes", "Likes", "Me gusta", "Curtidas")</span>
                    </div>
                    @if (isOrb)
                    {
                        <div class="stat-item">
                            <span class="stat-val counter" data-target="@Model.FollowerCount">0</span>
                            <span class="stat-lbl">@T("Follower", "Followers", "Seguidores", "Seguidores")</span>
                        </div>
                    }
                </div>

                

            </div>
        </div>
        <button class="btn-action shadow-sm" data-bs-toggle="collapse" data-bs-target="#settingsCollapse">
            <i class="bi bi-gear-fill me-2"></i> @T("Einstellungen", "Settings", "Ajustes", "Ajustes")
        </button>

        <div class="collapse mt-2" id="settingsCollapse">
            <div class="settings-box">
                <label class="small fw-800 mb-2 d-block text-uppercase opacity-75">@T("Design", "Design", "Diseño", "Design")</label>
                <div class="d-flex gap-3 flex-wrap">
                    <div class="theme-dot bg-dark" onclick="setTheme('black')" title="Black"></div>
                    <div class="theme-dot bg-white border" onclick="setTheme('white')" title="White"></div>
                    <div class="theme-dot bg-success" onclick="setTheme('color')" title="Green"></div>
                    <div class="theme-dot" style="background: #FFB6C1;" onclick="setTheme('rose')" title="Rose"></div>
                    <div class="theme-dot" style="background: #A78BFA;" onclick="setTheme('lavender')" title="Lavender"></div>
                </div>

                <hr class="opacity-25 my-3" />

                <form method="post" action="@Url.Action("UpdateProfile", "Feed", new { area = "WorldMiniApp" })">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userHash" value="@Model.User.UserHash" />

                    <label class="form-label small fw-bold">@T("Anzeigename", "Display Name", "Nombre", "Nome")</label>
                    <div class="input-group">
                        <input class="form-control rounded-3" name="userName" maxlength="80" value="@Model.User.UserName" />
                        <button class="btn btn-dark" type="submit">@T("Speichern", "Save", "Guardar", "Salvar")</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="quick-links">
            <a class="quick-link" href="@Url.Action("Index", "Marketplace", new { area = "WorldMiniApp", userHash = Model.User.UserHash })">
                <i class="bi bi-shop"></i> @T("Marktplatz", "Marketplace", "Mercado", "Mercado")
            </a>
            <a class="quick-link" href="@Url.Action("MyListings", "Marketplace", new { area = "WorldMiniApp", userHash = Model.User.UserHash })">
                <i class="bi bi-bag-check"></i> @T("Meine Angebote", "My listings", "Mis ofertas", "Minhas ofertas")
            </a>
        </div>
    </div>

    <!-- Tabs (wie vorher) -->
    <ul class="nav nav-custom" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-likes">
                <i class="bi bi-heart-fill fs-5"></i><span>@T("LIKES", "LIKES", "ME GUSTA", "CURTIDAS")</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-abos">
                <i class="bi bi-people-fill fs-5"></i><span>@T("ABOS", "CREATORS", "SIGUIENDO", "SEGUINDO")</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-plans">
                <i class="bi bi-calendar2-week-fill fs-5"></i><span>@T("PLÄNE", "PLANS", "PLANES", "PLANOS")</span>
            </button>
        </li>
        @if (isOrb)
        {
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-videos">
                    <i class="bi bi-play-circle-fill fs-5"></i><span>@T("VIDEOS", "VIDEOS", "VIDEOS", "VÍDEOS")</span>
                </button>
            </li>
        }
    </ul>

    <div class="tab-content">

        <div class="tab-pane fade show active" id="tab-likes">
            <div class="video-grid">
                @foreach (var recipe in Model.LikedRecipes)
                {
                    <div class="grid-item shadow-sm" onclick="openFeed('likes', @recipe.Id)">
                        <img src="@(string.IsNullOrEmpty(recipe.ThumbnailUrl) ? recipe.Source : recipe.ThumbnailUrl)" class="grid-img" loading="lazy">
                        <div class="grid-overlay"><i class="bi bi-play-fill"></i></div>
                    </div>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="tab-abos">
            <div class="list-group list-group-flush rounded-4 overflow-hidden shadow-sm">
                @foreach (var creator in Model.Following)
                {
                    <button class="list-group-item list-group-item-action d-flex align-items-center p-3 border-0"
                            style="background: rgba(128,128,128,0.05);" onclick="openFeed('creator', 0, '@creator.UserHash')">
                        <img src="https://ui-avatars.com/api/?name=@creator.UserName" class="rounded-circle me-3" width="40" height="40" />
                        <span class="fw-bold">@creator.UserName</span>
                        <i class="bi bi-chevron-right ms-auto opacity-50"></i>
                    </button>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="tab-plans">
            @foreach (var plan in Model.MealPlans)
            {
                <div class="plan-card p-3 mb-2 d-flex justify-content-between align-items-center shadow-sm">
                    <div>
                        <div class="fw-bold">@plan.Title</div>
                        <div class="small opacity-50">@plan.CreationTime.ToShortDateString()</div>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("ViewPlan", "Home", new { area = "WorldMiniApp", id = plan.Id })"
                           class="btn btn-sm btn-dark rounded-pill px-3">OPEN</a>

                        <a href="@Url.Action("DeletePlan", "Home", new { area = "WorldMiniApp", userHash = plan.UserHash, id = plan.Id })"
                           onclick="return confirm('@DeleteConfirmText(plan.Title)');"
                           class="btn btn-sm btn-outline-danger rounded-pill px-3"
                           title="@T("Löschen", "Delete", "Eliminar", "Apagar")">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            }
        </div>

        @if (isOrb)
        {
            <div class="tab-pane fade" id="tab-videos">
                <div class="video-grid">
                    @foreach (var posting in Model.MyVideos)
                    {
                        <div class="grid-item shadow-sm" onclick="openFeed('myvideos', @posting.Recipe.Id)">
                            <a class="grid-edit-link"
                               href="@Url.Action("EditRecipe", "Home", new { area = "WorldMiniApp", postingId = posting.Id })"
                               onclick="event.stopPropagation();"
                               title="@T("Rezept bearbeiten", "Edit recipe", "Editar receta", "Editar receita")">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                            <img src="@(string.IsNullOrEmpty(posting.ThumbnailUrl) ? posting.Source : posting.ThumbnailUrl)" class="grid-img">
                            <div class="grid-overlay"><i class="bi bi-camera-reels"></i></div>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script>
        // Counter Animation
        function animateCounters() {
            const counters = document.querySelectorAll('.counter');
            counters.forEach(counter => {
                const target = +counter.getAttribute('data-target');
                const speed = 40;
                const updateCount = () => {
                    const count = +counter.innerText;
                    const inc = target / speed;
                    if (count < target) {
                        counter.innerText = Math.ceil(count + (inc < 1 ? 1 : inc));
                        setTimeout(updateCount, 20);
                    } else {
                        counter.innerText = target;
                    }
                };
                updateCount();
            });
        }

        // Theme setzen (wie vorher, aber sauber)
        function setTheme(t) {
            document.body.classList.remove(
                'profile-theme-black',
                'profile-theme-white',
                'profile-theme-color',
                'profile-theme-rose',
                'profile-theme-lavender'
            );
            document.body.classList.add(`profile-theme-${t}`);
            localStorage.setItem('profile_theme', t);
        }

        // Feed Navigation (wie vorher)
        function openFeed(filterMode, scrollToId, targetUserHash = "") {
            const myUserHash = sessionStorage.getItem("UserToken") || localStorage.getItem("UserToken") || "@Model.User.UserHash";
            let url = `/WorldMiniApp/Feed/Index?filter=${filterMode}&scrollToId=${scrollToId}&userHash=${myUserHash}`;
            if (filterMode === 'creator' && targetUserHash !== "") {
                url += `&targetUserHash=${targetUserHash}`;
            }
            window.location.href = url;
        }

        document.addEventListener('DOMContentLoaded', () => {
            setTheme(localStorage.getItem('profile_theme') || 'color');
            animateCounters();
        });
    </script>
}
