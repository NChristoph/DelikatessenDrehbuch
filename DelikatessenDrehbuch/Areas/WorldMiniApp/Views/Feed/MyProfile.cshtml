@using DelikatessenDrehbuch.Areas.WorldMiniApp.Models
@model UserProfileViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Mein Profil";
    Layout = "_MiniAppLayout";
    bool isOrb = Model.User.IsVerified == "orb" || Model.User.UserHash == "0x2da33d4d7152caf4dad616bffa6fed2a7fd896ebe32be8806c79ed5010ff4839";
    var language = (Context.Request.Cookies["deli-lang"] ?? "de").ToLowerInvariant();

    // Zentrale Übersetzungsfunktion
    string T(string de, string en, string es, string pt) => language switch
    {
        "en" => en,
        "es" => es,
        "pt" => pt,
        _ => de
    };
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --deli-primary: #2D4F1E;
        --deli-gold: #D4AF37;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        transition: background 0.3s ease, color 0.3s ease;
    }

        /* --- Themes --- */
        body.profile-theme-color {
            background: #F8FAF7;
            color: #1A1A1A;
        }

        body.profile-theme-black {
            background: #000000;
            color: #ffffff;
        }

        body.profile-theme-white {
            background: #ffffff;
            color: #1A1A1A;
        }

        /* Fix für Black Theme: Kein Glass bei Stats */
        body.profile-theme-black .profile-card {
            background: #111 !important;
            border: 1px solid #222;
            box-shadow: none !important;
        }

        body.profile-theme-black .nav-link.active {
            background: #333 !important;
            color: #fff !important;
        }

        body.profile-theme-black .list-group-item,
        body.profile-theme-black .plan-card {
            background: #111 !important;
            color: white !important;
            border-color: #222 !important;
        }

        /* --- Neue Feminine Themes --- */
        body.profile-theme-rose {
            background: linear-gradient(135deg, #FFF5F7 0%, #FEE2E7 100%);
            color: #852D3E;
        }

            body.profile-theme-rose .profile-card {
                background: #FFFFFF;
                color: #852D3E;
            }

            body.profile-theme-rose .nav-link.active {
                background: #FFB6C1 !important;
                color: white !important;
            }

            body.profile-theme-rose .btn-action {
                background: #FFB6C1;
            }

        body.profile-theme-lavender {
            background: linear-gradient(135deg, #F3F0FF 0%, #EBE4FF 100%);
            color: #4B3D8A;
        }

            body.profile-theme-lavender .profile-card {
                background: #FFFFFF;
                color: #4B3D8A;
            }

            body.profile-theme-lavender .nav-link.active {
                background: #A78BFA !important;
                color: white !important;
            }

            body.profile-theme-lavender .btn-action {
                background: #A78BFA;
            }

            /* Dark-Fix Ergänzung für die neuen Themes */
            body.profile-theme-rose .list-group-item, body.profile-theme-rose .plan-card,
            body.profile-theme-lavender .list-group-item, body.profile-theme-lavender .plan-card {
                background: rgba(255, 255, 255, 0.5) !important;
                border-color: rgba(0, 0, 0, 0.05) !important;
            }

    .profile-wrap {
        max-width: 500px;
        margin: 0 auto;
        padding: 20px 15px 100px;
    }

    .back-to-feed {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        color: inherit;
        opacity: 0.8;
        margin-bottom: 12px;
    }

        .back-to-feed:hover {
            opacity: 1;
        }

    /* --- Profile Card --- */
    .profile-card {
        padding: 30px 20px;
        text-align: center;
        border-radius: 35px;
        margin-bottom: 25px;
        background: white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.04);
        transition: all 0.3s ease;
    }

    .avatar-container {
        position: relative;
        display: inline-block;
        margin-bottom: 15px;
    }

    .avatar-main {
        width: 110px;
        height: 110px;
        border-radius: 35px; /* Squircle Look */
        object-fit: cover;
        border: 4px solid white;
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }

    /* --- Stats Section --- */
    .stats-container {
        display: flex;
        justify-content: center;
        gap: 30px;
        margin: 20px 0;
    }

    .stat-item {
        text-align: center;
    }

    .stat-val {
        font-size: 1.4rem;
        font-weight: 800;
        display: block;
        line-height: 1.2;
    }

    .stat-lbl {
        font-size: 0.7rem;
        opacity: 0.6;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        font-weight: 600;
    }

    /* --- Navigation Tabs --- */
    .nav-custom {
        display: flex;
        background: rgba(128,128,128,0.1);
        border-radius: 22px;
        padding: 6px;
        border: none;
        margin-bottom: 25px;
    }

        .nav-custom .nav-item {
            flex: 1;
        }

        .nav-custom .nav-link {
            width: 100%;
            border: none;
            border-radius: 18px;
            color: inherit;
            padding: 12px 5px;
            font-size: 0.7rem;
            font-weight: 800;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
            background: transparent;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            opacity: 0.5;
        }

            .nav-custom .nav-link.active {
                background: white;
                color: var(--deli-primary);
                opacity: 1;
                box-shadow: 0 4px 15px rgba(0,0,0,0.08);
                transform: scale(1.02);
            }

    /* --- Content Grid (Hochformat 9:16) --- */
    .video-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
    }

    .grid-item {
        aspect-ratio: 9/16;
        border-radius: 14px;
        overflow: hidden;
        position: relative;
        background: #222;
        cursor: pointer;
    }

    .grid-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .grid-item:active .grid-img {
        transform: scale(0.95);
    }

    .grid-overlay {
        position: absolute;
        bottom: 10px;
        left: 10px;
        color: white;
        font-size: 0.9rem;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }

    /* --- Buttons & Utilities --- */
    .btn-action {
        background: var(--deli-primary);
        color: white !important;
        border-radius: 18px;
        padding: 12px;
        width: 100%;
        border: none;
        font-weight: 700;
        font-size: 0.9rem;
        transition: transform 0.2s;
    }

        .btn-action:active {
            transform: scale(0.98);
        }

    .theme-dot {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        cursor: pointer;
        border: 2px solid transparent;
        transition: 0.2s;
    }

        .theme-dot:hover {
            transform: scale(1.1);
        }
</style>

<div class="profile-wrap">
    <a class="back-to-feed" href="@Url.Action("Index", "Feed", new { area = "WorldMiniApp", userHash = Model.User.UserHash })">
        <i class="bi bi-arrow-left"></i>
        @T("Zurück zum Feed", "Back to feed", "Volver al feed", "Voltar ao feed")
    </a>

    <div class="profile-card">
        <div class="avatar-container">
            <img src="https://ui-avatars.com/api/?name=@(string.IsNullOrWhiteSpace(Model.User.UserName) ? "User" : Model.User.UserName)&background=random&size=200" class="avatar-main">
        </div>

        <h3 class="fw-800 mb-0">@(string.IsNullOrWhiteSpace(Model.User.UserName) ? "User" : Model.User.UserName)</h3>
        <div class="small opacity-50 mb-3">@@@((Model.User.UserHash ?? "0x00").Substring(0, 8))</div>

        <div class="stats-container">
            <div class="stat-item">
                <span class="stat-val counter" data-target="@Model.Following.Count">0</span>
                <span class="stat-lbl">@T("Abos", "Following", "Siguiendo", "Seguindo")</span>
            </div>
            <div class="stat-item">
                <span class="stat-val counter" data-target="@Model.LikedRecipes.Count">0</span>
                <span class="stat-lbl">@T("Likes", "Likes", "Me gusta", "Curtidas")</span>
            </div>
            @if (isOrb)
            {
                <div class="stat-item">
                    <span class="stat-val counter" data-target="@Model.FollowerCount">0</span>
                    <span class="stat-lbl">@T("Follower", "Followers", "Seguidores", "Seguidores")</span>
                </div>
            }
        </div>

        <button class="btn-action shadow-sm" data-bs-toggle="collapse" data-bs-target="#settingsCollapse">
            <i class="bi bi-gear-fill me-2"></i> @T("Einstellungen", "Settings", "Ajustes", "Ajustes")
        </button>

        <div class="collapse mt-3 text-start" id="settingsCollapse">
            <div class="p-3 bg-light rounded-4 text-dark shadow-sm">
                <div class="mb-3">
                    <form method="post" action="@Url.Action("UpdateProfile", "Feed", new { area = "WorldMiniApp" })">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userHash" value="@Model.User.UserHash" />

                        <label class="form-label small fw-bold">@T("Anzeigename", "Display Name", "Nombre", "Nome")</label>
                        <div class="input-group">
                            <input class="form-control rounded-3" name="userName" maxlength="80" value="@Model.User.UserName" />
                            <button class="btn btn-dark" type="submit">@T("Speichern", "Save", "Guardar", "Salvar")</button>
                        </div>
                    </form>
                </div>
                <hr class="opacity-10">
                <div>
                    <label class="small fw-800 mb-2 d-block text-uppercase opacity-50">@T("Design", "Design", "Diseño", "Design")</label>
                    <div class="d-flex gap-3 flex-wrap">
                        <div class="theme-dot bg-dark" onclick="setTheme('black')" title="Black"></div>
                        <div class="theme-dot bg-white border" onclick="setTheme('white')" title="White"></div>
                        <div class="theme-dot bg-success" onclick="setTheme('color')" title="Green"></div>

                        <div class="theme-dot" style="background: #FFB6C1;" onclick="setTheme('rose')" title="Rose"></div>
                        <div class="theme-dot" style="background: #A78BFA;" onclick="setTheme('lavender')" title="Lavender"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav nav-custom" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-likes">
                <i class="bi bi-heart-fill fs-5"></i><span>@T("LIKES", "LIKES", "ME GUSTA", "CURTIDAS")</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-abos">
                <i class="bi bi-people-fill fs-5"></i><span>@T("ABOS", "CREATORS", "SIGUIENDO", "SEGUINDO")</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-plans">
                <i class="bi bi-calendar2-week-fill fs-5"></i><span>@T("PLÄNE", "PLANS", "PLANES", "PLANOS")</span>
            </button>
        </li>
        @if (isOrb)
        {
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-videos">
                    <i class="bi bi-play-circle-fill fs-5"></i><span>@T("VIDEOS", "VIDEOS", "VIDEOS", "VÍDEOS")</span>
                </button>
            </li>
        }
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="tab-likes">
            <div class="video-grid">
                @foreach (var recipe in Model.LikedRecipes)
                {
                    <div class="grid-item shadow-sm" onclick="openFeed('likes', @recipe.Id)">
                        <img src="@(string.IsNullOrEmpty(recipe.ThumbnailUrl) ? recipe.Source : recipe.ThumbnailUrl)" class="grid-img" loading="lazy">
                        <div class="grid-overlay"><i class="bi bi-play-fill"></i></div>
                    </div>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="tab-abos">
            <div class="list-group list-group-flush rounded-4 overflow-hidden shadow-sm">
                @foreach (var creator in Model.Following)
                {
                    <button class="list-group-item list-group-item-action d-flex align-items-center p-3 border-0"
                            style="background: rgba(128,128,128,0.05);" onclick="openFeed('creator', 0, '@creator.UserHash')">
                        <img src="https://ui-avatars.com/api/?name=@creator.UserName" class="rounded-circle me-3" width="40" height="40" />
                        <span class="fw-bold">@creator.UserName</span>
                        <i class="bi bi-chevron-right ms-auto opacity-50"></i>
                    </button>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="tab-plans">
            @foreach (var plan in Model.MealPlans)
            {
                <div class="plan-card p-3 rounded-4 mb-2 d-flex justify-content-between align-items-center shadow-sm" style="background: rgba(128,128,128,0.05);">
                    <div>
                        <div class="fw-bold">@plan.Title</div>
                        <div class="small opacity-50">@plan.CreationTime.ToShortDateString()</div>
                    </div>
                    <a href="@Url.Action("ViewPlan", "Home", new { area = "WorldMiniApp", id = plan.Id })" class="btn btn-sm btn-dark rounded-pill px-3">OPEN</a>
                </div>
            }
        </div>

        @if (isOrb)
        {
            <div class="tab-pane fade" id="tab-videos">
                <div class="video-grid">
                    @foreach (var posting in Model.MyVideos)
                    {
                        <div class="grid-item shadow-sm" onclick="openFeed('myvideos', @posting.Recipe.Id)">
                            <img src="@(string.IsNullOrEmpty(posting.ThumbnailUrl) ? posting.Source : posting.ThumbnailUrl)" class="grid-img">
                            <div class="grid-overlay"><i class="bi bi-camera-reels"></i></div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // --- Counter Animation ---
        function animateCounters() {
            const counters = document.querySelectorAll('.counter');
            counters.forEach(counter => {
                const target = +counter.getAttribute('data-target');
                const speed = 40; // Geschwindigkeit
                const updateCount = () => {
                    const count = +counter.innerText;
                    const inc = target / speed;
                    if (count < target) {
                        counter.innerText = Math.ceil(count + (inc < 1 ? 1 : inc));
                        setTimeout(updateCount, 20);
                    } else {
                        counter.innerText = target;
                    }
                };
                updateCount();
            });
        }

        // --- Sprache setzen ---
        function setLanguage(lang) {
            const date = new Date();
            date.setTime(date.getTime() + (365 * 24 * 60 * 60 * 1000));
            document.cookie = "deli-lang=" + lang + "; expires=" + date.toUTCString() + "; path=/";
            window.location.reload();
        }

        // --- Theme setzen ---
                // --- Theme setzen ---
        function setTheme(t) {
            // Hier MÜSSEN alle Namen der verfügbaren Themes stehen, damit sie sauber gelöscht werden
            document.body.classList.remove(
                'profile-theme-black',
                'profile-theme-white',
                'profile-theme-color',
                'profile-theme-rose',
                'profile-theme-lavender'
            );

            // Fügt das neu gewählte Theme hinzu
            document.body.classList.add(`profile-theme-${t}`);

            // Speichert die Wahl dauerhaft
            localStorage.setItem('profile_theme', t);
        }

        // --- Feed Navigation ---
        function openFeed(filterMode, scrollToId, targetUserHash = "") {
            const myUserHash = sessionStorage.getItem("UserToken") || localStorage.getItem("UserToken") || "@Model.User.UserHash";
            let url = `/WorldMiniApp/Feed/Index?filter=${filterMode}&scrollToId=${scrollToId}&userHash=${myUserHash}`;
            if (filterMode === 'creator' && targetUserHash !== "") {
                url += `&targetUserHash=${targetUserHash}`;
            }
            window.location.href = url;
        }

        document.addEventListener('DOMContentLoaded', () => {
            setTheme(localStorage.getItem('profile_theme') || 'color');
            animateCounters();
        });
    </script>
}
