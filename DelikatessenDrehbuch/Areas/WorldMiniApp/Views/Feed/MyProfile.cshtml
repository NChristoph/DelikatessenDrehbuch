        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(20,57,31,0.08);
        background: transparent;
        box-shadow: var(--shadow-lg);
    }

    .dashboard-embed-header {
        padding: 18px 18px 14px;
        color: #fff;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .dashboard-eyebrow {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.72);
        margin-bottom: 10px;
    }

    .dashboard-title {
        font-family: 'Fraunces', serif;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.05;
        margin: 0 0 6px;
    }

    .dashboard-hash {
        font-size: 12px;
        font-weight: 600;
        color: rgba(255,255,255,0.72);
    }

    .dashboard-embed-frame {
        width: 100%;
        min-height: 980px;
        border: 0;
        display: block;
        background: #fff;
    }

    .nav-custom {
        display: flex;
        background: rgba(20,20,20,0.045);
        border-radius: 22px;
        padding: 4px;
        border: none;
        margin-bottom: 18px;
        gap: 2px;
    }

    .nav-custom .nav-item {
        flex: 1;
    }

    .nav-custom .nav-link {
        width: 100%;
        border: none;
        border-radius: 16px;
        padding: 8px 4px 6px;
        background: transparent;
        color: var(--ink-soft);
        font-weight: 700;
        font-size: 9.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        transition: all .2s;
    }

    .nav-custom .nav-link.active {
        background: var(--card);
        color: var(--ink-deep);
        box-shadow: 0 4px 12px rgba(20,57,31,0.10);
    }

    .video-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .grid-item {
        aspect-ratio: 9/14;
        border-radius: 14px;
        overflow: hidden;
        position: relative;
        background: #222;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(20,57,31,0.12), 0 2px 6px rgba(20,57,31,0.08);
    }

    .grid-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .grid-item:active .grid-img {
        transform: scale(0.95);
    }

    .grid-overlay {
        position: absolute;
        bottom: 10px;
        left: 10px;
        color: white;
        font-size: 0.9rem;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }

    .grid-edit-link {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.55);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        z-index: 2;
        text-decoration: none;
    }

        .grid-edit-link:hover {
            color: #fff;
            background: rgba(0, 0, 0, 0.75);
        }

    .grid-action-bar {
        position: absolute;
        top: 10px;
        right: 10px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        z-index: 2;
    }

    .grid-action-btn {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: none;
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        text-decoration: none;
    }

    .grid-action-btn.edit { background: rgba(0, 0, 0, 0.55); }
    .grid-action-btn.edit:hover { background: rgba(0, 0, 0, 0.75); }
    .grid-action-btn.offline { background: rgba(217, 154, 60, 0.88); }
    .grid-action-btn.offline:hover { background: rgba(217, 154, 60, 1); }
    .grid-action-btn.online { background: rgba(95, 160, 82, 0.88); }
    .grid-action-btn.online:hover { background: rgba(95, 160, 82, 1); }
    .grid-action-btn.delete { background: rgba(196, 78, 78, 0.92); }
    .grid-action-btn.delete:hover { background: rgba(196, 78, 78, 1); }

    .grid-item.is-offline {
        opacity: 0.45;
    }

    .empty-grid-state {
        text-align: center;
        padding: 44px 18px;
        border-radius: 22px;
        background: var(--card);
        border: 1px solid rgba(20,57,31,0.08);
        color: var(--ink-mute);
        box-shadow: var(--shadow-sm);
    }

    .grid-offline-badge {
        position: absolute;
        bottom: 30px;
        left: 0;
        right: 0;
        text-align: center;
        font-size: 0.65rem;
        font-weight: 900;
        color: #fff;
        background: rgba(255, 165, 0, 0.8);
        padding: 3px 0;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .ai-card-footer {
        position: absolute;
        inset-inline: 0;
        bottom: 0;
        padding: 12px 10px 10px;
        background: linear-gradient(180deg, rgba(20,57,31,0) 0%, rgba(20,57,31,0.88) 100%);
        z-index: 3;
    }

    .ai-card-tag,
    .soft-pill,
    .open-pill,
    .plan-open-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        font-weight: 800;
    }

    .soft-pill {
        background: rgba(255,255,255,0.92);
        color: var(--ink-deep);
        padding: 6px 10px;
        border: 1px solid rgba(20,57,31,0.08);
        font-size: 11px;
    }

    .ai-card-tag {
        background: rgba(255,255,255,0.16);
        border: 1px solid rgba(255,255,255,0.22);
        color: #fff;
        padding: 5px 9px;
        font-size: 11px;
    }

    .follow-list,
    .plan-card {
        background: var(--card);
        border: 1px solid rgba(20,57,31,0.08);
        border-radius: 18px;
        box-shadow: var(--shadow-sm);
    }

    .follow-list .list-group-item {
        background: transparent;
        border: 0;
        color: var(--ink-deep);
    }

    .open-pill,
    .plan-open-btn {
        background: var(--ink-deep);
        color: #fff !important;
        padding: 8px 14px;
        text-decoration: none;
        font-size: 12px;
    }

    .trash-pill {
        width: 36px;
        height: 36px;
        border-radius: 999px;
        border: none;
        background: rgba(255, 120, 73, 0.12);
        color: var(--coral);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .purchase-price {
        font-family: 'Fraunces', serif;
        font-size: 20px;
        font-weight: 700;
        color: var(--ink-deep);
        letter-spacing: -0.02em;
    }
</style>

<div class="profile-wrap">

    <div class="profile-topbar">
        <a class="topbar-pill"
           href="@Url.Action("Index", "Feed", new { area = "WorldMiniApp", userHash = Model.User.UserHash })">
            <i class="bi bi-arrow-left"></i>
            @SharedLocalizer["MyProfile.BackToFeed"]
        </a>
        @* Alter Sprach-Button entfernt - Cookie-basierter Switcher wird verwendet *@
    </div>

    <div class="profile-card">
        <div class="profile-top-row">
            <div class="avatar-main">@Initials(Model.User.UserName)</div>

            <div class="profile-right">
                <div class="profile-name">
                    @(string.IsNullOrWhiteSpace(Model.User.UserName) ? "User" : Model.User.UserName)
                </div>

                <div class="profile-hash">
                    @@@ShortHash(Model.User.UserHash)
                </div>

                <div class="stats-container">
                    <div class="stat-item">
                        <span class="stat-val counter" data-target="@Model.Following.Count">0</span>
                        <span class="stat-lbl">@SharedLocalizer["MyProfile.Following"]</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-val counter" data-target="@Model.LikedRecipes.Count">0</span>
                        <span class="stat-lbl">@SharedLocalizer["MyProfile.Likes"]</span>
                    </div>
                </div>
            </div>
        </div>

        <button class="btn-action mt-3" data-bs-toggle="collapse" data-bs-target="#settingsCollapse">
            <i class="bi bi-gear-fill me-2"></i> @SharedLocalizer["MyProfile.Settings"]
        </button>

        <div class="collapse mt-2" id="settingsCollapse">
            <div class="settings-box">
                <form method="post" action="@Url.Action("UpdateProfile", "Feed", new { area = "WorldMiniApp" })">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userHash" value="@Model.User.UserHash" />

                    <label class="form-label small fw-bold">@SharedLocalizer["MyProfile.DisplayName"]</label>
                    <div class="input-group mb-2">
                        <input class="form-control rounded-3" name="userName" maxlength="80" value="@Model.User.UserName" />
                    </div>

                    <label class="form-label small fw-bold">Eigener Store (Link)</label>
                    <input class="form-control rounded-3 mb-2" type="url" name="storeUrl" maxlength="1024"
                           placeholder="https://dein-shop.de" value="@Model.User.StoreUrl" />
                    <div class="form-text small mb-2">Optionaler Link zu deinem externen Shop. Leer lassen zum Entfernen.</div>

                    <button class="btn btn-dark w-100" type="submit">@SharedLocalizer["MyProfile.Save"]</button>
                </form>
            </div>
        </div>

        <div class="quick-links">
            @if (!string.IsNullOrWhiteSpace(Model.User.StoreUrl))
            {
                <a class="quick-link" href="@Model.User.StoreUrl" target="_blank" rel="noopener nofollow">
                    <i class="bi bi-box-arrow-up-right"></i> Mein Store
                </a>
            }
            <a class="quick-link" href="@Url.Action("FeedLight", "Shared", new { area = "WorldMiniApp", userHash = Model.User.UserHash })">
                <i class="bi bi-send-check"></i> Geteilte Inhalte
            </a>
            <a class="quick-link" href="@Url.Action("Index", "Marketplace", new { area = "WorldMiniApp", userHash = Model.User.UserHash })">
                <i class="bi bi-shop"></i> @SharedLocalizer["MyProfile.Marketplace"]
            </a>
            <a class="quick-link" href="@Url.Action("MyListings", "Marketplace", new { area = "WorldMiniApp", userHash = Model.User.UserHash })">
                <i class="bi bi-bag-check"></i> @SharedLocalizer["MyProfile.MyListings"]
            </a>
            <a class="quick-link" href="@Url.Action("BuildOwn", "MealPlan", new { area = "WorldMiniApp" })">
                <i class="bi bi-journal-plus"></i> Verkaufsplan erstellen
            </a>
            @if (isAdmin)
            {
                <a class="quick-link" href="@Url.Action("CommentModeration", "FeedComments", new { area = "WorldMiniApp", userHash = Model.User.UserHash })">
                    <i class="bi bi-flag-fill"></i> @SharedLocalizer["MyProfile.CommentModeration"]
                </a>
                <a class="quick-link" href="@Url.Action("ReportedContent", "Admin", new { area = "WorldMiniApp" })">
                    <i class="bi bi-shield-exclamation"></i> @SharedLocalizer["MyProfile.ReportedContent"]
                </a>
                <a class="quick-link" href="@Url.Action("CreatorManager", "Admin", new { area = "WorldMiniApp" })">
                    <i class="bi bi-people-fill"></i> @SharedLocalizer["MyProfile.CreatorManager"]
                </a>
                <a class="quick-link" href="@Url.Action("Index", "AdminAds", new { area = "WorldMiniApp" })">
                    <i class="bi bi-megaphone-fill" style="color: var(--gold);"></i> Ad Manager
                </a>
                <button type="button" class="quick-link" style="border:none;cursor:pointer;width:100%;" onclick="toggleDebugConsole()">
                    <i class="bi bi-terminal-fill"></i> Debug-Konsole
                </button>
