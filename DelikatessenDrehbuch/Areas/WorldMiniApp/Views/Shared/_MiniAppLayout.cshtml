<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Mini Planer</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <style>
        body {
            background-color: var(--deli-cream); /* Deine Hintergrundfarbe */
            padding-bottom: 80px; /* Platz unten für Buttons */
            font-family: 'Segoe UI', sans-serif;
            /* Verhindert "Gummiband"-Effekt beim Scrollen am iPhone */
            overscroll-behavior-y: none;
        }
        /* Scrollbalken verstecken (sieht mehr nach App aus) */
        ::-webkit-scrollbar {
            display: none;
        }
    </style>
</head>
<body>

    <main role="main" class="container-fluid p-0">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/CreateNewMealPlan.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>@*
