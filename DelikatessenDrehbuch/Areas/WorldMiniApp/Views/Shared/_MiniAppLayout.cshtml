@using System.Globalization
@using Microsoft.AspNetCore.Localization
@{
    var requestCultureFeature = Context.Features.Get<IRequestCultureFeature>();
    var currentCultureLang = requestCultureFeature?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "de";
}
<!DOCTYPE html>
<html lang="@currentCultureLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@_sharedLocalizer["Layout.Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <style>
        body {
            background-color: var(--deli-cream);
            padding-bottom: 80px;
            font-family: 'Segoe UI', sans-serif;
            overscroll-behavior-y: none;
        }

        ::-webkit-scrollbar {
            display: none;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
@using Microsoft.Extensions.Localization
@using DelikatessenDrehbuch
@inject IStringLocalizer<SharedResources> _sharedLocalizer

@{
    var currentLang = currentCultureLang;

    string Flag(string lang) => lang switch
    {
        "en" => "🇬🇧",
        "es" => "🇪🇸",
        "pt" => "🇵🇹",
        "id" => "🇮🇩",
        "nl" => "🇳🇱",
        "sv" => "🇸🇪",
        "da" => "🇩🇰",
        "nb" or "no" => "🇳🇴",
        "ms" => "🇲🇾",
        _ => "🇩🇪"
    };

    var languages = new[]
    {
        ("de", "🇩🇪", "Deutsch"),
        ("en", "🇬🇧", "English"),
        ("es", "🇪🇸", "Español"),
        ("pt", "🇵🇹", "Português"),
        ("id", "🇮🇩", "Indonesia"),
        ("nl", "🇳🇱", "Nederlands"),
        ("sv", "🇸🇪", "Svenska"),
        ("da", "🇩🇰", "Dansk"),
        ("nb", "🇳🇴", "Norsk"),
        ("ms", "🇲🇾", "Melayu")
    };
}
<body>

    <main role="main" class="container-fluid p-0">
        @RenderBody()
    </main>

    @{
        var isImpersonating = !string.IsNullOrEmpty(Context.Request.Cookies["AdminOriginalHash"]);
    }

    @if (isImpersonating)
    {
        <div class="position-fixed top-0 start-0 m-3" style="z-index: 1070;">
            <form action="@Url.Action("ReturnToAdmin", "Admin", new { area = "WorldMiniApp" })" method="post" style="margin: 0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-warning shadow-lg" style="font-weight: 600;">
                    <i class="bi bi-arrow-left-circle"></i> Zurück zum Admin
                </button>
            </form>
        </div>
    }

    <div class="position-fixed top-0 end-0 m-3 dropdown" style="z-index: 1060;">
        <button class="btn btn-sm btn-light border rounded-pill dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            @Flag(currentLang) @currentLang.ToUpperInvariant()
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow" style="max-height: 400px; overflow-y: auto;">
            @foreach (var (code, flag, name) in languages)
            {
                <li>
                    <button class="dropdown-item @(currentLang == code ? "active" : "")" type="button" onclick="setAppLanguage('@code')">
                        @flag @name
                    </button>
                </li>
            }
        </ul>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Client-to-Server Debug Logging -->
    <script>
        (function() {
            const originalLog = console.log;
            const originalError = console.error;
            const originalWarn = console.warn;

            function formatArg(arg) {
                if (typeof arg === 'object' && arg !== null) {
                    try {
                        return JSON.stringify(arg);
                    } catch {
                        return String(arg);
                    }
                }
                return String(arg);
            }

            async function sendLogToServer(message, level) {
                try {
                    await fetch('/WorldMiniApp/Shared/LogFromClient', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ message, level })
                    });
                } catch {
                    // Fail silently to avoid infinite loops
                }
            }

            console.log = function(...args) {
                originalLog.apply(console, args);
                const msg = args.map(formatArg).join(' ');
                sendLogToServer(msg, 'LOG');
            };

            console.error = function(...args) {
                originalError.apply(console, args);
                const msg = args.map(formatArg).join(' ');
                sendLogToServer(msg, 'ERROR');
            };

            console.warn = function(...args) {
                originalWarn.apply(console, args);
                const msg = args.map(formatArg).join(' ');
                sendLogToServer(msg, 'WARN');
            };
        })();
    </script>

    <script src="~/js/worldminiapp-i18n.js"></script>
    <script src="~/js/CreateNewMealPlan.js"></script>
    <script>
        function setAppLanguage(lang) {
            // Cookie für Abwärtskompatibilität mit JSON-Mappings setzen
            const cookieLang = {
                'es': 'esp',
                'pt': 'prt',
                'nb': 'no',
                'sv': 'sv',
                'da': 'da'
            }[lang] || lang;

            document.cookie = `deli-lang=${cookieLang}; path=/; max-age=31536000`;

            // ASP.NET Core Culture Cookie setzen
            document.cookie = `.AspNetCore.Culture=c=${lang}|uic=${lang}; path=/; max-age=31536000`;

            window.location.reload();
        }
    </script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
