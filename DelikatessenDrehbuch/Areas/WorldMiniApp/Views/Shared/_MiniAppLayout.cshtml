@using System.Globalization
@using Microsoft.AspNetCore.Localization
@{
    var requestCultureFeature = Context.Features.Get<IRequestCultureFeature>();
    var currentCultureLang = requestCultureFeature?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "de";
}
<!DOCTYPE html>
<html lang="@currentCultureLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Mini Planer</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <style>
        body {
            background-color: var(--deli-cream);
            padding-bottom: 80px;
            font-family: 'Segoe UI', sans-serif;
            overscroll-behavior-y: none;
        }

        ::-webkit-scrollbar {
            display: none;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
@using Microsoft.Extensions.Localization
@using DelikatessenDrehbuch
@inject IStringLocalizer<SharedResources> _sharedLocalizer

@{
    var currentLang = currentCultureLang;

    string Flag(string lang) => lang switch
    {
        "en" => "🇬🇧",
        "es" => "🇪🇸",
        "pt" => "🇵🇹",
        "id" => "🇮🇩",
        "nl" => "🇳🇱",
        "sv" => "🇸🇪",
        "da" => "🇩🇰",
        "nb" or "no" => "🇳🇴",
        "ms" => "🇲🇾",
        _ => "🇩🇪"
    };

    var languages = new[]
    {
        ("de", "🇩🇪", "Deutsch"),
        ("en", "🇬🇧", "English"),
        ("es", "🇪🇸", "Español"),
        ("pt", "🇵🇹", "Português"),
        ("id", "🇮🇩", "Indonesia"),
        ("nl", "🇳🇱", "Nederlands"),
        ("sv", "🇸🇪", "Svenska"),
        ("da", "🇩🇰", "Dansk"),
        ("nb", "🇳🇴", "Norsk"),
        ("ms", "🇲🇾", "Melayu")
    };
}
<body>

    <main role="main" class="container-fluid p-0">
        @RenderBody()
    </main>

    <!-- Global AI resume bar + toast (used by recipe AI preview across pages) -->
    <div id="wmAiResumeBar" class="position-fixed start-0 end-0" style="bottom: 0; z-index: 1061; display:none;">
        <div class="d-flex align-items-center justify-content-between" style="background:#2D4F1E; color:white; padding:10px 14px; border-top: 1px solid rgba(255,255,255,.18);">
            <div class="d-flex align-items-center gap-2" id="wmAiResumeBarStatus">
                <span class="spinner-border spinner-border-sm text-light" id="wmAiResumeSpinner" style="display:none;"></span>
                <span id="wmAiResumeText">@_sharedLocalizer["AI.PreviewReady", _sharedLocalizer["AI.PreviewTitle"]]</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-light rounded-pill" id="wmAiResumeOpenBtn">@_sharedLocalizer["Common.Open"]</button>
                <button type="button" class="btn btn-sm btn-outline-light rounded-pill" id="wmAiResumeDismissBtn" aria-label="@_sharedLocalizer["Common.Close"]">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-0" style="z-index: 2000; right:0; bottom:0;">
        <div id="wmAiToast" class="toast text-bg-dark border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="wmAiToastBody">@_sharedLocalizer["AI.PreviewFinished"]</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="@_sharedLocalizer["Common.Close"]"></button>
            </div>
        </div>
    </div>

    <!-- Global modal for AI result preview (so we do NOT need to navigate to ShowRecipe) -->
    <div class="modal fade" id="wmAiResultModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="wmAiResultTitle">@_sharedLocalizer["AI.PreviewTitle"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@_sharedLocalizer["Common.Close"]"></button>
                </div>
                <div class="modal-body">
                    <div id="wmAiResultLoading" class="text-center py-4" style="display:none;">
                        <div class="spinner-border" role="status"></div>
                        <div class="mt-2 small text-muted">@_sharedLocalizer["Common.Loading"]</div>
                    </div>
                    <div id="wmAiResultError" class="alert alert-danger" style="display:none;"></div>

                    <div id="wmAiResultContent" style="display:none;">
                        <p class="text-muted" id="wmAiResultSummary" style="white-space:pre-wrap;"></p>
                        <hr />
                        <h6 id="wmAiResultIngredientsHeader"><!-- Will be set by script --></h6>
                        <pre id="wmAiResultIngredientsText" class="mb-3" style="white-space:pre-wrap; font-family:inherit;"></pre>
                        <h6 id="wmAiResultPreparationHeader"><!-- Will be set by script --></h6>
                        <pre id="wmAiResultPreparationText" style="white-space:pre-wrap; font-family:inherit;"></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @{
        var isImpersonating = !string.IsNullOrEmpty(Context.Request.Cookies["AdminOriginalHash"]);
    }

    @if (isImpersonating)
    {
        <div class="position-fixed top-0 start-0 m-3" style="z-index: 1070;">
            <form action="@Url.Action("ReturnToAdmin", "Admin", new { area = "WorldMiniApp" })" method="post" style="margin: 0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-warning shadow-lg" style="font-weight: 600;">
                    <i class="bi bi-arrow-left-circle"></i> Zurück zum Admin
                </button>
            </form>
        </div>
    }

    <div class="position-fixed top-0 end-0 m-3 dropdown" style="z-index: 1060;">
        <button class="btn btn-sm btn-light border rounded-pill dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            @Flag(currentLang) @currentLang.ToUpperInvariant()
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow" style="max-height: 400px; overflow-y: auto;">
            @foreach (var (code, flag, name) in languages)
            {
                <li>
                    <button class="dropdown-item @(currentLang == code ? "active" : "")" type="button" onclick="setAppLanguage('@code')">
                        @flag @name
                    </button>
                </li>
            }
        </ul>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/worldminiapp-i18n.js"></script>
    <script src="~/js/CreateNewMealPlan.js"></script>
    <script>
        function setAppLanguage(lang) {
            // Cookie für Abwärtskompatibilität mit JSON-Mappings setzen
            const cookieLang = {
                'es': 'esp',
                'pt': 'prt',
                'nb': 'no',
                'sv': 'sv',
                'da': 'da'
            }[lang] || lang;

            document.cookie = `deli-lang=${cookieLang}; path=/; max-age=31536000`;

            // ASP.NET Core Culture Cookie setzen
            document.cookie = `.AspNetCore.Culture=c=${lang}|uic=${lang}; path=/; max-age=31536000`;

            window.location.reload();
        }
    </script>

    <script>
        (async function worldMiniAppAiResume() {
            // Initialize localization first
            await WorldMiniAppI18n.ready();
            const t = WorldMiniAppI18n.t;

            const KEY = 'worldminiapp.ai.resume.v2';
            const bar = document.getElementById('wmAiResumeBar');
            const statusText = document.getElementById('wmAiResumeText');
            const spinner = document.getElementById('wmAiResumeSpinner');
            const openBtn = document.getElementById('wmAiResumeOpenBtn');
            const dismissBtn = document.getElementById('wmAiResumeDismissBtn');
            const toastEl = document.getElementById('wmAiToast');
            const toastBody = document.getElementById('wmAiToastBody');
            let toastInstance = null;

            const modalEl = document.getElementById('wmAiResultModal');
            const modalTitle = document.getElementById('wmAiResultTitle');
            const modalLoading = document.getElementById('wmAiResultLoading');
            const modalError = document.getElementById('wmAiResultError');
            const modalContent = document.getElementById('wmAiResultContent');
            const modalSummary = document.getElementById('wmAiResultSummary');
            const modalIngredientsText = document.getElementById('wmAiResultIngredientsText');
            const modalPreparationText = document.getElementById('wmAiResultPreparationText');
            let modalInstance = null;

            function anyAiModalOpen() {
                // Bootstrap sets this reliably even when the modal hasn't applied `.show` yet.
                if (document.body.classList.contains('modal-open')) return true;
                if (document.querySelector('.modal-backdrop')) return true;

                const ids = ['wmAiResultModal', 'aiTransformModal'];
                for (const id of ids) {
                    const el = document.getElementById(id);
                    if (el && el.classList.contains('show')) return true;
                }
                return false;
            }

            function read() {
                try {
                    const raw = sessionStorage.getItem(KEY);
                    return raw ? JSON.parse(raw) : null;
                } catch {
                    return null;
                }
            }

            function write(state) {
                try {
                    sessionStorage.setItem(KEY, JSON.stringify({ ...state, updatedAt: Date.now() }));
                } catch {
                    // ignore
                }
                render();
            }

            function clear() {
                try { sessionStorage.removeItem(KEY); } catch { /* ignore */ }
                render();
            }

            function showToast(message) {
                if (!toastEl || !toastBody || !window.bootstrap) return;
                // Only pop a notice when no AI overlay is currently open.
                if (anyAiModalOpen()) return;
                toastBody.textContent = message || t('AI.PreviewFinished');
                toastInstance = toastInstance || new bootstrap.Toast(toastEl, { delay: 4500 });
                toastInstance.show();
            }

            function render() {
                if (!bar || !statusText || !spinner) return;
                const state = read();
                if (!state || !state.recipeId || !state.variantType) {
                    bar.style.display = 'none';
                    return;
                }

                // Like before: hide the bar while an overlay is open.
                if (anyAiModalOpen()) {
                    bar.style.display = 'none';
                    return;
                }

                const stage = (state.stage || '').toString();
                if (stage !== 'queued' && stage !== 'running' && stage !== 'ready' && stage !== 'error') {
                    bar.style.display = 'none';
                    return;
                }
                const title = (state.title || '').toString();
                const label = title ? `AI: ${title}` : t('AI.PreviewTitle');

                if (stage === 'queued' || stage === 'running') {
                    spinner.style.display = '';
                    statusText.textContent = t('AI.PreviewCreating', label);
                } else if (stage === 'ready') {
                    spinner.style.display = 'none';
                    statusText.textContent = t('AI.PreviewReady', label);
                } else if (stage === 'error') {
                    spinner.style.display = 'none';
                    statusText.textContent = t('AI.PreviewError', label);
                } else {
                    spinner.style.display = 'none';
                    statusText.textContent = `${label}.`;
                }

                bar.style.display = '';
            }

            async function openOverlayFromState() {
                const state = read();
                if (!state) return;

                // Prefer the recipe page overlay when available (no navigation / no reload).
                if (typeof window.openAiJobResult === 'function' && state.jobId) {
                    window.openAiJobResult(state.jobId, state.variantType, state.aiProvider || 'openai');
                    return;
                }

                // If we don't have a job id yet (queued before the response came back), reopen the selection overlay.
                if (!state.jobId && typeof window.openAiTransformModal === 'function' && state.variantType) {
                    window.openAiTransformModal(state.variantType, state.aiProvider || 'openai');
                    return;
                }

                if (!state.jobId) {
                    showToast(t('AI.StillRunning'));
                    return;
                }

                if (!modalEl || !window.bootstrap) return;
                modalInstance = modalInstance || new bootstrap.Modal(modalEl);
                modalInstance.show();

                if (modalTitle) modalTitle.textContent = state.title ? `AI: ${state.title}` : t('AI.PreviewTitle');
                if (modalError) { modalError.style.display = 'none'; modalError.textContent = ''; }
                if (modalContent) modalContent.style.display = 'none';
                if (modalLoading) modalLoading.style.display = '';

                const jobId = state.jobId;

                async function fetchStatus() {
                    const url = `/WorldMiniApp/Home/GetAiRecipeVariantJobStatus?jobId=${encodeURIComponent(jobId)}`;
                    const res = await fetch(url, { method: 'GET', headers: { 'Accept': 'application/json' } });
                    const text = await res.text().catch(() => '');
                    let payload = null;
                    try { payload = text ? JSON.parse(text) : null; } catch { payload = null; }
                    return { ok: res.ok, status: res.status, payload, raw: text };
                }

                async function fetchResult() {
                    const url = `/WorldMiniApp/Home/GetAiRecipeVariantJobResult?jobId=${encodeURIComponent(jobId)}`;
                    const res = await fetch(url, { method: 'GET', headers: { 'Accept': 'application/json' } });
                    const text = await res.text().catch(() => '');
                    let payload = null;
                    try { payload = text ? JSON.parse(text) : null; } catch { payload = null; }
                    return { ok: res.ok, status: res.status, payload, raw: text };
                }

                try {
                    // If still running, show spinner and poll briefly until ready.
                    const initialStatus = await fetchStatus();
                    const st = (initialStatus.payload?.state || '').toString();

                    if (!initialStatus.ok && initialStatus.status === 404 && typeof window.openAiTransformModal === 'function') {
                        // Job doesn't exist - fall back to reopening the selection overlay so the user can restart.
                        modalInstance.hide();
                        window.openAiTransformModal(state.variantType, state.aiProvider || 'openai');
                        return;
                    }

                    if (st && st !== 'ready' && st !== 'error') {
                        const start = Date.now();
                        while ((Date.now() - start) < 20000) {
                            if (!modalEl.classList.contains('show')) break;
                            await new Promise(r => setTimeout(r, 1200));
                            const s2 = await fetchStatus();
                            const st2 = (s2.payload?.state || '').toString();
                            if (st2 === 'ready' || st2 === 'error') break;
                        }
                    }

                    const result = await fetchResult();
                    if (!result.ok || !result.payload) {
                        const msg = result.payload?.message || result.raw || t('AI.ResultNotReady');
                        throw new Error(msg);
                    }

                    const payload = result.payload;
                    if (modalTitle) modalTitle.textContent = payload.title || (state.title ? `AI: ${state.title}` : t('AI.PreviewTitle'));
                    if (modalSummary) modalSummary.textContent = payload.summary || '';
                    if (modalIngredientsText) modalIngredientsText.textContent = payload.ingredientsText || '';
                    if (modalPreparationText) modalPreparationText.textContent = payload.preparationText || '';
                    if (modalLoading) modalLoading.style.display = 'none';
                    if (modalContent) modalContent.style.display = '';
                } catch (e) {
                    if (modalLoading) modalLoading.style.display = 'none';
                    if (modalContent) modalContent.style.display = 'none';
                    if (modalError) {
                        modalError.textContent = (e && e.message) ? e.message : t('AI.ResultLoadFailed');
                        modalError.style.display = '';
                    }
                }
            }

            openBtn?.addEventListener('click', openOverlayFromState);
            dismissBtn?.addEventListener('click', clear);

            window.WorldMiniAppAiResume = {
                setState: write,
                clearState: clear,
                toast: showToast,
                readState: read,
                openOverlay: openOverlayFromState
            };

            async function pollOnce() {
                const state = read();
                if (!state || !state.jobId) return;
                const stage = (state.stage || '').toString();
                if (stage !== 'queued' && stage !== 'running') return;

                try {
                    const url = `/WorldMiniApp/Home/GetAiRecipeVariantJobStatus?jobId=${encodeURIComponent(state.jobId)}`;
                    const res = await fetch(url, { method: 'GET', headers: { 'Accept': 'application/json' } });
                    if (!res.ok) {
                        if (res.status === 404 && state.updatedAt && (Date.now() - Number(state.updatedAt)) < 15000) {
                            return;
                        }
                        const err = await res.json().catch(() => null);
                        const msg = (err && (err.message || err.error)) ? (err.message || err.error) : `HTTP ${res.status}`;
                        write({
                            ...state,
                            stage: 'error',
                            message: msg
                        });
                        showToast(`AI Vorschau: Fehler (${msg}).`);
                        return;
                    }
                    const payload = await res.json().catch(() => null);
                    if (!payload) return;

                    const nextStage = (payload.state || '').toString();
                    const nextTitle = (payload.title || state.title || '').toString();
                    const msg = (payload.message || '').toString();
                    write({
                        ...state,
                        stage: nextStage,
                        title: nextTitle,
                        message: msg
                    });

                    if (nextStage === 'ready') {
                        showToast(t('AI.PreviewFinished'));
                    } else if (nextStage === 'error') {
                        showToast(t('AI.PreviewFailed'));
                    }
                } catch {
                    // ignore polling errors
                }
            }

            setInterval(pollOnce, 1500);

            render();
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>@*
