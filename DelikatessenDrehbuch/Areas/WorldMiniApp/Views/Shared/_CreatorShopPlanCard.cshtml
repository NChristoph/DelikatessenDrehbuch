@model DelikatessenDrehbuch.Areas.WorldMiniApp.Models.PlanCardViewModel

<article class="cs-card" aria-label="Plan @Model.Title von @Model.CreatorName">
    <div class="cs-hero">
        @if (!string.IsNullOrWhiteSpace(Model.HeroImageUrl))
        {
            <img src="@Model.HeroImageUrl" alt="@Model.HeroImageAlt" class="cs-hero-img" loading="lazy" />
        }
        else
        {
            <div class="cs-hero-fallback" aria-hidden="true"></div>
        }

        <div class="cs-overlay"></div>

        <span class="cs-premium-pill">
            <i class="bi bi-stars me-1"></i>Premium
        </span>

        <div class="cs-hero-text">
            <h3 class="cs-title">@Model.Title</h3>
            <p class="cs-subline mb-0">@Model.DayCount Tage · @Model.RecipeCount Rezepte · @Model.CreatedDateLabel</p>
        </div>
    </div>

    <div class="cs-body">
        <div class="cs-creator-label">@Model.JourneyLabel</div>

        <div class="cs-macro-row" role="list" aria-label="Makros und Tags">
            @if (Model.CaloriesKcal.HasValue)
            {
                <span class="cs-chip" role="listitem">@Math.Round(Model.CaloriesKcal.Value) kcal</span>
            }
            @if (Model.ProteinGrams.HasValue)
            {
                <span class="cs-chip" role="listitem">@Math.Round(Model.ProteinGrams.Value, 1)g Protein</span>
            }
            @if (Model.IsLowCarb)
            {
                <span class="cs-chip cs-chip-tag" role="listitem">Low Carb</span>
            }
            @if (Model.IsDietFriendly)
            {
                <span class="cs-chip cs-chip-tag" role="listitem">Diät</span>
            }
        </div>

        <div class="cs-social-row" aria-label="Social Proof">
            <span>⭐ @Model.Rating.ToString("0.0")</span>
            <span>🔥 @Model.SoldCount verkauft</span>
            <span>👥 @Model.ActivePlannerCount planen aktuell</span>
        </div>


        <label class="cs-token-toggle" title="WLD / USDCE">
            <span>WLD</span>
            <input type="checkbox" class="feed-token-switch" onchange="setFeedToken(this.checked ? 'USDCE' : 'WLD')" aria-label="Währung zwischen WLD und USDCE wechseln" />
            <span>USDCE</span>
        </label>

        <div class="cs-cta-row">
            <button type="button"
                    class="cs-btn cs-btn-secondary"
                    aria-label="@($"Vorschau für {Model.Title} öffnen")"
                    onclick="showFeedPreview(@Model.ListingId)">
                Vorschau
            </button>

            <div class="cs-buy-wrap">
                <button type="button"
                        class="cs-btn cs-btn-primary"
                        aria-label="@($"Plan {Model.Title} freischalten")"
                        onclick="buyFeedListing(@Model.ListingId, '@Model.TitleJsSafe', @Model.PriceWld.ToString(System.Globalization.CultureInfo.InvariantCulture), '@(Model.SellerWalletAddress ?? "")')">
                    Freischalten
                </button>
                <div class="cs-price" id="feedPrice-@Model.ListingId" data-price-wld="@Model.PriceWld.ToString(System.Globalization.CultureInfo.InvariantCulture)">@Model.PriceLabel</div>
            </div>
        </div>
    </div>
</article>
