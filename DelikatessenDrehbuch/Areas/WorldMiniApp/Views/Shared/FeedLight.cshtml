@model DelikatessenDrehbuch.Areas.WorldMiniApp.Models.SharedFeedIndexViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    Layout = "_MiniAppLayout";
    ViewData["Title"] = Localizer["SharedFeed.Title"];
    var active = Model.ActiveFeed;
    var allFeeds = Model.Feeds.ToList();
}

<style>
    /* Critical CSS to prevent FOUC */
    .s-screen { width: 100%; min-height: 100vh; background: #f5efe1; font-family: 'Inter', -apple-system, sans-serif; color: #1a2e20; }
    .s-screen.is-loading { opacity: 0; }
    .s-screen.is-loaded { opacity: 1; transition: opacity 0.2s; }
</style>

<div class="s-screen is-loading">
    <!-- TopBar -->
    <div class="s-topbar">
        <a class="s-back-pill" href="@Url.Action("Index", "Home", new { area = "WorldMiniApp" })">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            <span>Home</span>
        </a>
        <div class="s-title-block">
            <div class="s-eyebrow">GRUPPEN</div>
            <h1>@Localizer["SharedFeed.Title"]</h1>
        </div>
        <div class="s-lang-pill">
            <span>DE</span>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m6 9 6 6 6-6"/></svg>
        </div>
    </div>

    <!-- Stories Row (Gruppen-Carousel) -->
    <div class="s-stories-row">
        <!-- Create Tile -->
        <div class="s-story-tile" onclick="showCreateGroupModal()">
            <div class="s-story-create">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
            </div>
            <div class="s-story-label">Neu</div>
        </div>

        <!-- Group Tiles -->
        @foreach (var feed in allFeeds)
        {
            var isActive = active?.Id == feed.Id;
            var initials = GetInitials(feed.Title);
            var gradientIndex = GetGradientIndex(feed.Title);

            <div class="s-story-tile @(isActive ? "is-active" : "")" onclick="switchGroup(@feed.Id)">
                <div class="s-story-avatar" data-gradient="@gradientIndex">
                    <span>@initials</span>
                </div>
                <div class="s-story-label">@(feed.Title.Length > 10 ? feed.Title.Substring(0, 10) : feed.Title)</div>
                @if (feed.UnreadCount > 0)
                {
                    <div class="s-story-badge">@feed.UnreadCount</div>
                }
            </div>
        }
    </div>

    @if (active != null)
    {
        <!-- Hero Banner -->
        <div class="s-hero">
            <div class="s-hero-glow"></div>
            <div class="s-hero-content">
                <div class="s-hero-pill">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    <span>AKTIVE GRUPPE</span>
                </div>
                <h2 class="s-hero-title">@active.Title</h2>
                <div class="s-hero-members">
                    @{
                        var maxAvatars = Math.Min(4, active.Members.Count);
                        for (int i = 0; i < maxAvatars; i++)
                        {
                            var member = active.Members[i];
                            var memberInitials = GetInitials(member.DisplayName);
                            var memberGradient = GetGradientIndex(member.DisplayName);
                            <div class="s-hero-member-avatar" data-gradient="@memberGradient">
                                <span>@memberInitials</span>
                            </div>
                        }
                    }
                    <span class="s-hero-meta">@active.MemberCount Mitglieder · @active.ItemCount Beiträge</span>
                </div>
                <button type="button" class="s-hero-invite" onclick="copyInviteUrl('@active.InviteUrl')">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    <span>Einladen</span>
                </button>
                <div class="s-hero-stats">
                    <div class="s-hero-stat">
                        <div class="s-hero-stat-val">@active.MemberCount</div>
                        <div class="s-hero-stat-label">MITGLIEDER</div>
                    </div>
                    <div class="s-hero-stat">
                        <div class="s-hero-stat-val">@active.ItemCount</div>
                        <div class="s-hero-stat-label">BEITRÄGE</div>
                    </div>
                    <div class="s-hero-stat">
                        <div class="s-hero-stat-val">@active.Todos.Count(t => !t.IsCompleted)</div>
                        <div class="s-hero-stat-label">AUFGABEN</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab Bar -->
        <div class="s-tab-bar">
            <button type="button" class="s-tab active" data-tab="feed" onclick="switchTab('feed')">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                <span>Feed</span>
            </button>
            <button type="button" class="s-tab" data-tab="chat" onclick="switchTab('chat')">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <span>Chat</span>
                @if (active.UnreadCount > 0)
                {
                    <div class="s-tab-badge">@active.UnreadCount</div>
                }
            </button>
            <button type="button" class="s-tab" data-tab="tasks" onclick="switchTab('tasks')">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                <span>Aufgaben</span>
            </button>
            <button type="button" class="s-tab" data-tab="members" onclick="switchTab('members')">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span>Mitglieder</span>
            </button>
        </div>

        <!-- Tab Bodies -->
        <div class="s-tab-content">
            <!-- Feed Tab -->
            <div class="s-tab-body active" data-tab-body="feed">
                @if (active.IsOwner)
                {
                    <!-- Admin Import Button -->
                    <button type="button" class="s-composer-trigger" onclick="showImportMealPlanModal()">
                        <div class="s-composer-avatar" data-gradient="0">
                            <span>@GetInitials(Model.CurrentUserHash)</span>
                        </div>
                        <span class="s-composer-text">Essensplan teilen...</span>
                        <div class="s-composer-pill">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            <span>Plan</span>
                        </div>
                    </button>
                }

                <!-- Feed Items -->
                @if (!active.Items.Any())
                {
                    <div class="s-empty">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                        <p>Noch keine Inhalte in dieser Gruppe. Teile einen Mealplan.</p>
                    </div>
                }
                else
                {
                    @foreach (var item in active.Items)
                    {
                        ViewData["FeedId"] = active.Id;
                        ViewData["CurrentUserHash"] = active.CurrentUserHash;
                        if (item.ContentType == "mealplan")
                        {
                            @await Html.PartialAsync("~/Areas/WorldMiniApp/Views/Shared/MealPlanSharedFeed.cshtml", item)
                        }
                        else
                        {
                            @await Html.PartialAsync("~/Areas/WorldMiniApp/Views/Shared/ShoppingListSharedFeed.cshtml", item)
                        }
                    }
                }
            </div>

            <!-- Chat Tab -->
            <div class="s-tab-body" data-tab-body="chat">
                <div class="s-chat-messages" id="chatMessages" data-feed-id="@active.Id" data-user-hash="@Model.CurrentUserHash">
                    <div class="s-chat-loading">Nachrichten werden geladen...</div>
                </div>
                <div class="s-chat-composer">
                    <input type="file" id="chatFileInput" accept="image/*,application/pdf,.doc,.docx" style="display: none;" />
                    <button type="button" class="s-chat-attach" onclick="document.getElementById('chatFileInput').click()">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                    </button>
                    <div class="s-chat-input-pill">
                        <div id="chatFilePreview" class="s-chat-file-preview" style="display: none;"></div>
                        <input type="text" id="chatInput" placeholder="Nachricht eingeben..." maxlength="1000" />
                        <button type="button" class="s-chat-emoji">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                        </button>
                    </div>
                    <button type="button" class="s-chat-send" id="chatSendBtn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
                    </button>
                </div>
            </div>

            <!-- Tasks Tab -->
            <div class="s-tab-body" data-tab-body="tasks">
                <div class="s-task-add">
                    <input type="text" id="todoInput" class="s-task-input" placeholder="Neue Aufgabe hinzufügen..." maxlength="200" />
                    <button type="button" id="todoAddBtn" class="s-task-add-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                    </button>
                </div>

                @if (active.Todos.Any())
                {
                    var completedCount = active.Todos.Count(t => t.IsCompleted);
                    var totalCount = active.Todos.Count;
                    var percentage = totalCount > 0 ? (completedCount * 100 / totalCount) : 0;

                    <div class="s-progress-card">
                        <div class="s-progress-row">
                            <div class="s-progress-left">
                                <div class="s-progress-eyebrow">DIESE WOCHE</div>
                                <div class="s-progress-num">@completedCount<span class="s-progress-total">/@totalCount erledigt</span></div>
                            </div>
                            <div class="s-progress-percent">@percentage%</div>
                        </div>
                        <div class="s-progress-bar">
                            <div class="s-progress-fill" style="width: @percentage%"></div>
                        </div>
                    </div>
                }

                <div class="s-task-list" id="todoList" data-feed-id="@active.Id" data-user-hash="@Model.CurrentUserHash" data-is-owner="@active.IsOwner">
                    @if (!active.Todos.Any())
                    {
                        <div class="s-empty">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            <p>Keine Aufgaben. Füge die erste hinzu!</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var todo in active.Todos)
                        {
                            <div class="s-task-row @(todo.IsCompleted ? "is-done" : "")" data-todo-id="@todo.Id">
                                <div class="s-task-checkbox" onclick="toggleTodo(@todo.Id)">
                                    @if (todo.IsCompleted)
                                    {
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                    }
                                    else
                                    {
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>
                                    }
                                </div>
                                <div class="s-task-content">
                                    <div class="s-task-text">@todo.Title</div>
                                    <div class="s-task-meta">
                                        @if (todo.IsCompleted && !string.IsNullOrEmpty(todo.CompletedByName))
                                        {
                                            <span>@todo.CompletedByName · Erledigt</span>
                                        }
                                        else
                                        {
                                            <span>@todo.CreatedByName</span>
                                        }
                                    </div>
                                </div>
                                @if (active.IsOwner)
                                {
                                    <form method="post" action="@Url.Action("DeleteTodo", "Shared", new { area = "WorldMiniApp" })" style="display:inline;" onsubmit="return confirm('Todo wirklich löschen?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="todoId" value="@todo.Id" />
                                        <input type="hidden" name="userHash" value="@Model.CurrentUserHash" />
                                        <input type="hidden" name="feedId" value="@active.Id" />
                                        <button type="submit" class="s-task-delete">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Members Tab -->
            <div class="s-tab-body" data-tab-body="members">
                <div class="s-invite-card">
                    <div class="s-invite-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    </div>
                    <div class="s-invite-text">
                        <div class="s-invite-title">Einladungslink</div>
                        <div class="s-invite-url">@active.InviteUrl.Substring(0, Math.Min(40, active.InviteUrl.Length))...</div>
                    </div>
                    <button type="button" class="s-invite-copy" onclick="copyInviteUrl('@active.InviteUrl')">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        <span>Kopieren</span>
                    </button>
                </div>

                @foreach (var member in active.Members)
                {
                    var memberInitials = GetInitials(member.DisplayName);
                    var memberGradient = GetGradientIndex(member.DisplayName);
                    var isOnline = false; // TODO: implement online status

                    <div class="s-member-row">
                        <div class="s-member-avatar" data-gradient="@memberGradient">
                            <span>@memberInitials</span>
                        </div>
                        <div class="s-member-text">
                            <div class="s-member-name">
                                @member.DisplayName
                                @if (member.Role == "OWNER" || member.Role == "owner")
                                {
                                    <span class="s-member-role">ADMIN</span>
                                }
                                @if (isOnline)
                                {
                                    <span class="s-member-dot"></span>
                                }
                            </div>
                            <div class="s-member-activity">Mitglied · @member.JoinedAtUtc.ToLocalTime().ToString("dd.MM.yyyy")</div>
                        </div>
                        <button type="button" class="s-member-more">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
                        </button>
                    </div>
                }

                <!-- Leave/Delete Group Buttons -->
                <div style="margin-top: 24px; padding: 16px 0;">
                    @if (active.IsOwner)
                    {
                        <!-- Delete Group Button (Admin only) -->
                        <form method="post" action="@Url.Action("DeleteFeed", "Shared", new { area = "WorldMiniApp" })" onsubmit="return confirm('⚠️ Möchtest du diese Gruppe wirklich LÖSCHEN? Alle Inhalte, Nachrichten und Mitglieder werden entfernt. Diese Aktion kann nicht rückgängig gemacht werden!');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="feedId" value="@active.Id" />
                            <input type="hidden" name="userHash" value="@Model.CurrentUserHash" />
                            <button type="submit" class="s-delete-group-btn">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"/>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                    <line x1="10" y1="11" x2="10" y2="17"/>
                                    <line x1="14" y1="11" x2="14" y2="17"/>
                                </svg>
                                Gruppe löschen
                            </button>
                        </form>
                    }
                    else
                    {
                        <!-- Leave Group Button -->
                        <form method="post" action="@Url.Action("LeaveFeed", "Shared", new { area = "WorldMiniApp" })" onsubmit="return confirm('Möchtest du diese Gruppe wirklich verlassen?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="feedId" value="@active.Id" />
                            <input type="hidden" name="userHash" value="@Model.CurrentUserHash" />
                            <button type="submit" class="s-leave-group-btn">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                    <polyline points="16 17 21 12 16 7"/>
                                    <line x1="21" y1="12" x2="9" y2="12"/>
                                </svg>
                                Gruppe verlassen
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="s-empty-main">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <h2>Erstelle deine erste Gruppe</h2>
            <p>Hier sammeln mehrere Nutzer Mealplans und Einkaufslisten an einem Ort.</p>
        </div>
    }
</div>

<!-- Create Group Modal -->
<div id="createGroupModal" class="s-modal" style="display: none;">
    <div class="s-modal-content">
        <div class="s-modal-header">
            <h3>Neue Gruppe erstellen</h3>
            <button type="button" class="s-modal-close" onclick="closeCreateGroupModal()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <form method="post" action="@Url.Action("CreateFeed", "Shared", new { area = "WorldMiniApp" })">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userHash" value="@Model.CurrentUserHash" />
            <div class="s-modal-body">
                <label class="s-form-label">Gruppen-Name</label>
                <input name="title" class="s-form-input" maxlength="160" placeholder="z. B. Familienplan oder WG-Küche" required />
            </div>
            <div class="s-modal-footer">
                <button type="button" class="s-btn s-btn-secondary" onclick="closeCreateGroupModal()">Abbrechen</button>
                <button type="submit" class="s-btn s-btn-primary">Erstellen</button>
            </div>
        </form>
    </div>
</div>

<!-- Import Meal Plan Modal -->
<div id="importMealPlanModal" class="s-modal" style="display: none;">
    <div class="s-modal-content">
        <div class="s-modal-header">
            <h3>Essensplan importieren</h3>
            <button type="button" class="s-modal-close" onclick="closeImportMealPlanModal()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div id="importMealPlanList" class="s-modal-body">
            <div class="s-modal-loading">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                Lade deine Essenspläne...
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var words = name.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (words.Length == 0) return "?";
        if (words.Length == 1) return words[0].Substring(0, Math.Min(2, words[0].Length)).ToUpper();
        return (words[0][0].ToString() + words[1][0].ToString()).ToUpper();
    }

    private int GetGradientIndex(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return 0;
        var sum = name.Sum(c => (int)c);
        return sum % 6;
    }
}

