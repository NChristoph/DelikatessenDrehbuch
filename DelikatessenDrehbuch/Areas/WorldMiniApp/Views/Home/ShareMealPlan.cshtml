@using Microsoft.Extensions.Localization
@using System.Linq
@using DelikatessenDrehbuch.Models
@using DelikatessenDrehbuch.Areas.WorldMiniApp.Models
@inject IStringLocalizer<DelikatessenDrehbuch.SharedResources> SharedLocalizer

@{
    Layout = "_MiniAppLayout";
    var title = ViewData["Title"] as string ?? "Geteilter Plan";
    var personCount = (int)(ViewData["PersonCount"] ?? 1);
    var mealPlan = ViewData["MealPlan"] as List<MealPlanHelperMobile> ?? new();
    var recipes = (ViewData["Recipes"] as System.Collections.IEnumerable)?.Cast<dynamic>().ToList() ?? new List<dynamic>();
    var shoppingListText = ViewData["ShoppingListText"] as string ?? string.Empty;

    string T(string de, string en, string es, string pt)
    {
        var culture = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
        return culture switch
        {
            "de" => de,
            "en" => en,
            "es" => es,
            "pt" => pt,
            _ => de
        };
    }

    string SlotLabel(int slotIndex) => slotIndex switch
    {
        0 => T("Vorspeise", "Starter", "Entrante", "Entrada"),
        1 => T("Hauptspeise", "Main", "Principal", "Principal"),
        2 => T("Dessert", "Dessert", "Postre", "Sobremesa"),
        _ => T("Gericht", "Meal", "Comida", "Refeicao")
    };

    string DayLabel(int dayIndex)
    {
        var daysDe = new[] { "Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag", "Samstag", "Sonntag" };
        var daysEn = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
        var daysEs = new[] { "Lunes", "Martes", "Miercoles", "Jueves", "Viernes", "Sabado", "Domingo" };
        var daysPt = new[] { "Segunda", "Terca", "Quarta", "Quinta", "Sexta", "Sabado", "Domingo" };

        if (dayIndex < 0 || dayIndex > 6)
        {
            return $"Tag {dayIndex + 1}";
        }

        var culture = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
        return culture switch
        {
            "de" => daysDe[dayIndex],
            "en" => daysEn[dayIndex],
            "es" => daysEs[dayIndex],
            "pt" => daysPt[dayIndex],
            _ => daysDe[dayIndex]
        };
    }

    string CategoryLabel(string category) => (category ?? string.Empty).ToLowerInvariant() switch
    {
        "appetizer" => T("Vorspeise", "Appetizer", "Entrante", "Entrada"),
        "main" => T("Hauptspeise", "Main course", "Plato principal", "Prato principal"),
        "dessert" => T("Dessert", "Dessert", "Postre", "Sobremesa"),
        "breakfast" => T("Fruehstueck", "Breakfast", "Desayuno", "Cafe da manha"),
        _ => category ?? string.Empty
    };

    decimal CalculateNutrition(dynamic recipe, string nutrientType)
    {
        decimal total = 0;
        try
        {
            foreach (var ing in recipe.Ingredients)
            {
                decimal quantity = 0;
                try { quantity = (decimal)(ing.QuantityFloat ?? 0m); } catch { }
                var nutrition = ing.Nutrition;
                if (nutrition == null) continue;

                var factor = quantity / 100m;
                total += nutrientType switch
                {
                    "calories" => (decimal)(nutrition.Kcal_a_100g ?? 0m) * factor,
                    "protein" => (decimal)(nutrition.Protein_a_100g ?? 0m) * factor,
                    "fat" => (decimal)(nutrition.Fat_a_100g ?? 0m) * factor,
                    "carbs" => (decimal)(nutrition.Carbohydrates_a_100g ?? 0m) * factor,
                    "sugar" => (decimal)(nutrition.Sugar_a_100g ?? 0m) * factor,
                    "fiber" => (decimal)(nutrition.Fiber_a_100g ?? 0m) * factor,
                    _ => 0m
                };
            }
        }
        catch { }
        return total;
    }

    var recipeMap = recipes
        .GroupBy(r => (int)r.Id)
        .ToDictionary(g => g.Key, g => g.First());

    decimal totalCalories = 0, totalProtein = 0, totalFat = 0, totalCarbs = 0, totalSugar = 0, totalFiber = 0;
    var uniqueRecipeIds = new HashSet<int>();
    foreach (var slot in mealPlan)
    {
        if (!recipeMap.TryGetValue(slot.RecipeId, out var slotRecipe))
        {
            continue;
        }

        uniqueRecipeIds.Add(slot.RecipeId);
        var recipePortions = Math.Max(1, (int)(slotRecipe.PersonCount ?? 1));
        totalCalories += CalculateNutrition(slotRecipe, "calories") / recipePortions * personCount;
        totalProtein += CalculateNutrition(slotRecipe, "protein") / recipePortions * personCount;
        totalFat += CalculateNutrition(slotRecipe, "fat") / recipePortions * personCount;
        totalCarbs += CalculateNutrition(slotRecipe, "carbs") / recipePortions * personCount;
        totalSugar += CalculateNutrition(slotRecipe, "sugar") / recipePortions * personCount;
        totalFiber += CalculateNutrition(slotRecipe, "fiber") / recipePortions * personCount;
    }
}

