<div class="shared-plan-shell">
    @Html.AntiForgeryToken()
    <section class="shared-plan-header">
        <div class="shared-plan-sub">@T("Geteilter Wochenplan", "Shared weekly plan", "Plan semanal compartido", "Plano semanal partilhado")</div>
        <h1 class="shared-plan-title">@title</h1>
        <div class="shared-plan-meta">
            <span class="shared-pill"><i class="bi bi-people-fill"></i> @personCount @T("Personen", "people", "personas", "pessoas")</span>
            <span class="shared-pill"><i class="bi bi-journal-richtext"></i> @mealPlan.Count @T("Mahlzeiten", "meals", "comidas", "refeicoes")</span>
            <span class="shared-pill"><i class="bi bi-grid-1x2-fill"></i> @uniqueRecipeIds.Count @T("Rezepte", "recipes", "recetas", "receitas")</span>
        </div>

        <div class="shared-plan-actions">
            <button type="button" class="shared-btn-add-to-feed" onclick="showAddToFeedModal()">
                <i class="bi bi-plus-circle-fill"></i>
                <span>@T("Zu Feed hinzufügen", "Add to feed", "Añadir a feed", "Adicionar ao feed")</span>
            </button>
        </div>
    </section>

    <div id="addToFeedModal" class="add-to-feed-modal" style="display: none;">
        <div class="add-to-feed-content">
            <div class="add-to-feed-header">
                <h3>@T("Zu Feed hinzufügen", "Add to feed", "Añadir a feed", "Adicionar ao feed")</h3>
                <button type="button" class="add-to-feed-close" onclick="closeAddToFeedModal()">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div id="feedListContainer" class="add-to-feed-list">
                <div class="add-to-feed-loading">
                    <i class="bi bi-hourglass-split"></i>
                    @T("Lade Feeds...", "Loading feeds...", "Cargando feeds...", "Carregando feeds...")
                </div>
            </div>
        </div>
    </div>

    <section class="shared-plan-nutrition">
        <h2><i class="bi bi-pie-chart-fill"></i> @T("Gesamt Nährwerte", "Total nutrition", "Nutricion total", "Nutricao total")</h2>
        <div class="shared-plan-nutrition-grid">
            <div class="shared-nutrition-item"><span>@T("Kalorien", "Calories", "Calorias", "Calorias")</span><strong>@Math.Round(totalCalories) kcal</strong></div>
            <div class="shared-nutrition-item"><span>@T("Protein", "Protein", "Proteina", "Proteina")</span><strong>@Math.Round(totalProtein, 1) g</strong></div>
            <div class="shared-nutrition-item"><span>@T("Fett", "Fat", "Grasa", "Gordura")</span><strong>@Math.Round(totalFat, 1) g</strong></div>
            <div class="shared-nutrition-item"><span>@T("Kohlenhydrate", "Carbs", "Carbohidratos", "Carboidratos")</span><strong>@Math.Round(totalCarbs, 1) g</strong></div>
            <div class="shared-nutrition-item"><span>@T("Zucker", "Sugar", "Azucar", "Acucar")</span><strong>@Math.Round(totalSugar, 1) g</strong></div>
            <div class="shared-nutrition-item"><span>@T("Ballaststoffe", "Fiber", "Fibra", "Fibra")</span><strong>@Math.Round(totalFiber, 1) g</strong></div>
        </div>
    </section>

    @{
        var groupedDays = mealPlan
            .OrderBy(x => x.DayIndex)
            .ThenBy(x => x.SlotIndex)
            .GroupBy(x => x.DayIndex)
            .ToList();
    }

    @foreach (var dayGroup in groupedDays)
    {
        <section class="shared-day-section">
            <div class="shared-day-header">
                <h2 class="shared-day-name">@DayLabel(dayGroup.Key)</h2>
                <span class="shared-day-count">@dayGroup.Count() @T("Gerichte", "meals", "platos", "pratos")</span>
            </div>

            <div class="shared-meal-stack">
                @foreach (var slot in dayGroup)
                {
                    if (!recipeMap.TryGetValue(slot.RecipeId, out var recipe))
                    {
                        continue;
                    }

                    var images = ((IEnumerable<string>)recipe.Images).Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
                    var keywords = ((IEnumerable<dynamic>)recipe.Keywords).Take(3).ToList();
                    var category = recipe.Category as string ?? string.Empty;
                    var prepTime = recipe.PreparationTime ?? 0;
                    var recipePersonCount = Math.Max(1, (int)(recipe.PersonCount ?? 1));
                    var recipeCalories = CalculateNutrition(recipe, "calories") / recipePersonCount * personCount;
                    var recipeProtein = CalculateNutrition(recipe, "protein") / recipePersonCount * personCount;
                    var recipeFat = CalculateNutrition(recipe, "fat") / recipePersonCount * personCount;
                    var recipeCarbs = CalculateNutrition(recipe, "carbs") / recipePersonCount * personCount;
                    var proteinPct = recipeProtein > 0 ? Math.Min(100, Math.Round((double)recipeProtein / 180.0 * 100.0)) : 0;
                    var fatPct = recipeFat > 0 ? Math.Min(100, Math.Round((double)recipeFat / 160.0 * 100.0)) : 0;
                    var carbsPct = recipeCarbs > 0 ? Math.Min(100, Math.Round((double)recipeCarbs / 240.0 * 100.0)) : 0;
                    var heroImage = images.FirstOrDefault();

                    <article class="shared-meal-card">
                        <div class="shared-meal-hero">
                            @if (!string.IsNullOrWhiteSpace(heroImage))
                            {
                                <img src="@heroImage" alt="@recipe.Title" loading="lazy" />
                            }
                            <div class="shared-meal-overlay"></div>
                            <div class="shared-meal-top">
                                <span class="shared-glass-pill">@SlotLabel(slot.SlotIndex)</span>
                                <span class="shared-glass-pill">@CategoryLabel(category)</span>
                            </div>
                            <div class="shared-meal-bottom">
                                <h3>@recipe.Title</h3>
                                <div class="shared-hero-tags">
                                    @foreach (var keyword in keywords)
                                    {
                                        var keywordText = (keyword.Word_DE ?? keyword.Word_EN ?? string.Empty)?.ToString();
                                        if (!string.IsNullOrWhiteSpace(keywordText))
                                        {
                                            <span class="shared-hero-tag">@keywordText</span>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="shared-meal-body">
                            <div class="shared-meal-stats">
                                <div class="shared-stat"><strong>@Math.Round(recipeCalories)</strong><span>kcal</span></div>
                                <div class="shared-stat"><strong>@prepTime</strong><span>@T("Minuten", "minutes", "minutos", "minutos")</span></div>
                                <div class="shared-stat"><strong>@personCount</strong><span>@T("Portionen", "servings", "porciones", "porcoes")</span></div>
                                <div class="shared-stat"><strong>@recipePersonCount</strong><span>@T("Basis", "base", "base", "base")</span></div>
                            </div>

                            <div class="shared-macro-bars">
                                <div class="shared-macro-row">
                                    <span>@T("Protein", "Protein", "Proteina", "Proteina")</span>
                                    <div class="shared-macro-track"><div class="shared-macro-fill protein" style="width:@(proteinPct)%"></div></div>
                                    <strong>@Math.Round(recipeProtein, 1) g</strong>
                                </div>
                                <div class="shared-macro-row">
                                    <span>@T("Fett", "Fat", "Grasa", "Gordura")</span>
                                    <div class="shared-macro-track"><div class="shared-macro-fill fat" style="width:@(fatPct)%"></div></div>
                                    <strong>@Math.Round(recipeFat, 1) g</strong>
                                </div>
                                <div class="shared-macro-row">
                                    <span>@T("KH", "Carbs", "Carbs", "Carbs")</span>
                                    <div class="shared-macro-track"><div class="shared-macro-fill carbs" style="width:@(carbsPct)%"></div></div>
                                    <strong>@Math.Round(recipeCarbs, 1) g</strong>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    <section class="shared-shopping">
        <h2><i class="bi bi-cart3"></i> @T("Einkaufsliste", "Shopping list", "Lista de compras", "Lista de compras")</h2>
        <pre>@shoppingListText</pre>
    </section>
</div>

<script>
    (function() {
        // Extract token from URL
        const urlParams = new URLSearchParams(window.location.search);
        const shareToken = urlParams.get('token');
        const userHash = '@(Context.Request.Cookies["WorldMiniAppUserHash"] ?? "")';

        if (!shareToken) {
            console.error('No share token found in URL');
            document.querySelector('.shared-btn-add-to-feed')?.remove();
            return;
        }

        window.showAddToFeedModal = function() {
            const modal = document.getElementById('addToFeedModal');
            modal.style.display = 'flex';
            loadUserFeeds();
        };

        window.closeAddToFeedModal = function() {
            document.getElementById('addToFeedModal').style.display = 'none';
        };

        function loadUserFeeds() {
            const container = document.getElementById('feedListContainer');
            container.innerHTML = '<div class="add-to-feed-loading"><i class="bi bi-hourglass-split"></i> @T("Lade Feeds...", "Loading feeds...", "Cargando feeds...", "Carregando feeds...")</div>';

            fetch(`/WorldMiniApp/Shared/GetUserFeeds?userHash=${encodeURIComponent(userHash)}`)
                .then(res => {
                    if (!res.ok) throw new Error('Failed to load feeds');
                    return res.json();
                })
                .then(feeds => {
                    if (feeds.length === 0) {
                        container.innerHTML = '<div class="add-to-feed-empty"><i class="bi bi-inbox"></i><p>@T("Du hast noch keine Feeds. Erstelle zuerst einen Feed.", "You don't have any feeds yet. Create a feed first.", "Aún no tienes feeds. Crea un feed primero.", "Você ainda não tem feeds. Crie um feed primeiro.")</p></div>';
                        return;
                    }

                    container.innerHTML = feeds.map(feed => `
                        <div class="feed-option" onclick="addToFeed(${feed.Id}, '${escapeHtml(feed.Title)}')">
                            <div class="feed-option-info">
                                <h4>${escapeHtml(feed.Title)}</h4>
                                <p>${feed.MemberCount} @T("Mitglieder", "members", "miembros", "membros") · ${feed.ItemCount} @T("Inhalte", "items", "elementos", "itens")</p>
                            </div>
                            <i class="bi bi-plus-circle feed-option-icon"></i>
                        </div>
                    `).join('');
                })
                .catch(err => {
                    console.error('Error loading feeds:', err);
                    container.innerHTML = '<div class="add-to-feed-error"><i class="bi bi-exclamation-triangle"></i><p>@T("Fehler beim Laden der Feeds.", "Error loading feeds.", "Error al cargar feeds.", "Erro ao carregar feeds.")</p></div>';
                });
        }

        window.addToFeed = function(feedId, feedTitle) {
            const container = document.getElementById('feedListContainer');
            container.innerHTML = '<div class="add-to-feed-loading"><i class="bi bi-hourglass-split"></i> @T("Wird hinzugefügt...", "Adding...", "Añadiendo...", "Adicionando...")</div>';

            fetch('/WorldMiniApp/Shared/AddExistingItem', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: new URLSearchParams({
                    '__RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '',
                    'feedId': feedId,
                    'contentType': 'mealplan',
                    'sourceToken': shareToken,
                    'userHash': userHash
                })
            })
            .then(res => {
                if (res.redirected) {
                    // Success - show confirmation
                    container.innerHTML = `
                        <div class="add-to-feed-success">
                            <i class="bi bi-check-circle-fill" style="font-size: 48px; color: #5b8a52;"></i>
                            <h4 style="margin: 16px 0 8px;">@T("Erfolgreich hinzugefügt!", "Successfully added!", "¡Añadido con éxito!", "Adicionado com sucesso!")</h4>
                            <p>@T("Der Essensplan wurde zu", "The meal plan was added to", "El plan de comida fue añadido a", "O plano de refeições foi adicionado ao")</p>
                            <p style="font-weight: 700; color: #14391f;">"${escapeHtml(feedTitle)}"</p>
                            <button type="button" onclick="closeAddToFeedModal()" style="margin-top: 16px; background: #5b8a52; color: white; border: none; padding: 10px 20px; border-radius: 12px; cursor: pointer;">@T("Schließen", "Close", "Cerrar", "Fechar")</button>
                        </div>
                    `;
                } else {
                    throw new Error('Failed to add to feed');
                }
            })
            .catch(err => {
                console.error('Error adding to feed:', err);
                container.innerHTML = `
                    <div class="add-to-feed-error">
                        <i class="bi bi-exclamation-triangle"></i>
                        <p>@T("Fehler beim Hinzufügen. Möglicherweise ist der Plan bereits im Feed.", "Error adding. The plan may already be in the feed.", "Error al añadir. El plan puede estar ya en el feed.", "Erro ao adicionar. O plano pode já estar no feed.")</p>
                        <button type="button" onclick="loadUserFeeds()" style="margin-top: 12px; background: #14391f; color: white; border: none; padding: 8px 16px; border-radius: 12px; cursor: pointer;">@T("Erneut versuchen", "Try again", "Intentar de nuevo", "Tentar novamente")</button>
                    </div>
                `;
            });
        };

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Close modal on backdrop click
        document.getElementById('addToFeedModal')?.addEventListener('click', function(e) {
            if (e.target === this) {
                closeAddToFeedModal();
            }
        });
    })();
</script>
