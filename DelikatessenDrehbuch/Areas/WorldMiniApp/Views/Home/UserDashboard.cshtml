@model DelikatessenDrehbuch.Areas.WorldMiniApp.Models.UserDashboardViewModel
@{
    Layout = "_MiniAppLayout";
    ViewData["Title"] = "Creator Dashboard";

    var fullUserHash = Model.UserHash ?? string.Empty;
    var shortUserHash = fullUserHash;
    if (!string.IsNullOrWhiteSpace(fullUserHash) && fullUserHash.Length > 12)
    {
        shortUserHash = $"{fullUserHash[..6]}...{fullUserHash[^4..]}";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/creator-dashboard.css" asp-append-version="true" />
}

<div class="creator-dashboard container py-4 px-3 px-sm-4">
    <div class="dashboard-shell mx-auto">
        <div class="d-flex align-items-start justify-content-between gap-3 mb-4">
            <div>
                <p class="dashboard-eyebrow mb-1">Premium Creator Area</p>
                <h1 class="dashboard-title mb-2">Creator Dashboard</h1>
                @if (Model.IsLoggedInWithWorldMiniApp)
                {
                    <div class="creator-hash-wrap" aria-live="polite">
                        <span class="creator-hash-label">User Hash</span>
                        <code id="userHashText" class="creator-hash" data-full-hash="@fullUserHash">@shortUserHash</code>
                        <button type="button" id="copyHashBtn" class="btn btn-sm creator-btn-outline" data-copy-text="@fullUserHash">
                            <i class="bi bi-copy me-1"></i>Kopieren
                        </button>
                        <span id="copyToast" class="copy-toast" role="status">Kopiert</span>
                    </div>
                }
            </div>
            <a class="btn creator-btn-outline d-md-none" href="@Url.Action("Index", "Home", new { area = "WorldMiniApp" })">
                <i class="bi bi-arrow-left"></i>
            </a>
        </div>

        @if (!Model.IsLoggedInWithWorldMiniApp)
        {
            <div class="alert alert-warning shadow-sm">
                Bitte zuerst in der World Mini App einloggen, damit dein Dashboard geladen werden kann.
            </div>
        }
        else
        {
            <section class="hero-earnings-card mb-4" aria-label="Earnings Overview">
                <div class="hero-bg-glow"></div>
                <div class="hero-main d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end gap-3">
                    <div>
                        <p class="metric-label mb-1">Verfügbar</p>
                        <div class="hero-value">@Model.OpenWldAmount.ToString("0.######") <span>WLD</span></div>
                    </div>
                    <button type="button" class="btn creator-btn-primary btn-lg">
                        <i class="bi bi-cash-coin me-2"></i>Geld anfordern
                    </button>
                </div>

                <div class="hero-sub-grid mt-4">
                    <div class="hero-sub-card">
                        <p class="metric-label mb-1">USDC/USDT offen</p>
                        <p class="metric-value mb-0">@Model.OpenUsdcAmount.ToString("0.######") USDC</p>
                    </div>
                    <div class="hero-sub-card">
                        <p class="metric-label mb-1">Insgesamt erhalten</p>
                        <p class="metric-value mb-0">@Model.TotalCreatorRevenue.ToString("0.######") WLD</p>
                    </div>
                </div>
            </section>

            <section class="mb-4" aria-label="Creator Stats">
                <div class="stats-grid">
                    <article class="stat-card">
                        <div class="stat-icon"><i class="bi bi-bag-check-fill"></i></div>
                        <p class="metric-label mb-1">Verkäufe</p>
                        <p class="stat-value mb-0">@Model.SoldMealPlanCount</p>
                    </article>
                    <article class="stat-card">
                        <div class="stat-icon"><i class="bi bi-lightning-charge-fill"></i></div>
                        <p class="metric-label mb-1">Verfügbar</p>
                        <p class="stat-value mb-0">@Model.OpenWldAmount.ToString("0.######") <span>WLD</span></p>
                    </article>
                    <article class="stat-card">
                        <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
                        <p class="metric-label mb-1">Ausstehend</p>
                        <p class="stat-value mb-0">@Model.OpenUsdcAmount.ToString("0.######") <span>USDC</span></p>
                    </article>
                    <article class="stat-card">
                        <div class="stat-icon"><i class="bi bi-patch-check-fill"></i></div>
                        <p class="metric-label mb-1">Bereits erhalten</p>
                        <p class="stat-value mb-0">@Model.TotalCreatorRevenue.ToString("0.######") <span>WLD</span></p>
                    </article>
                </div>
            </section>


            <section class="content-card mb-4" aria-label="Watch Analytics">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="section-title mb-0">Watch Analytics</h2>
                    <span class="section-meta">Nur qualifizierte Views ab 8 Sekunden</span>
                </div>

                <div class="stats-grid mb-4">
                    <article class="stat-card">
                        <div class="stat-icon"><i class="bi bi-play-btn-fill"></i></div>
                        <p class="metric-label mb-1">Qualifizierte Views</p>
                        <p class="stat-value mb-0">@Model.WatchAnalytics.QualifiedViewCount</p>
                    </article>
                    <article class="stat-card">
                        <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
                        <p class="metric-label mb-1">Echte Viewer</p>
                        <p class="stat-value mb-0">@Model.WatchAnalytics.UniqueQualifiedViewerCount</p>
                    </article>
                    <article class="stat-card">
                        <div class="stat-icon"><i class="bi bi-clock-history"></i></div>
                        <p class="metric-label mb-1">Watch-Minuten</p>
                        <p class="stat-value mb-0">@Model.WatchAnalytics.TotalQualifiedWatchMinutes.ToString("0.##")</p>
                    </article>
                    <article class="stat-card">
                        <div class="stat-icon"><i class="bi bi-stopwatch-fill"></i></div>
                        <p class="metric-label mb-1">Ø Watch-Sekunden</p>
                        <p class="stat-value mb-0">@Model.WatchAnalytics.AverageQualifiedWatchSeconds.ToString("0.##")</p>
                    </article>
                </div>

                <div class="hero-sub-grid mt-0 mb-4">
                    <div class="hero-sub-card">
                        <p class="metric-label mb-1">Von dir angesehen</p>
                        <p class="metric-value mb-0">@Model.WatchAnalytics.ViewerQualifiedClipCount Clips</p>
                    </div>
                    <div class="hero-sub-card">
                        <p class="metric-label mb-1">Deine Watch-Time</p>
                        <p class="metric-value mb-0">@Model.WatchAnalytics.ViewerQualifiedWatchMinutes.ToString("0.##") Minuten</p>
                    </div>
                </div>

                @if (!Model.WatchAnalytics.TopClips.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-bar-chart-line"></i>
                        <p class="mb-1">Noch keine qualifizierten Watch-Daten</p>
                        <small>Ein Clip zählt erst, wenn er mindestens 8 Sekunden aktiv angesehen wurde.</small>
                    </div>
                }
                else
                {
                    <div class="activity-feed">
                        @foreach (var clip in Model.WatchAnalytics.TopClips)
                        {
                            <article class="activity-card compact">
                                <div class="activity-head align-items-center">
                                    <div class="activity-status neutral" aria-hidden="true"><i class="bi bi-camera-reels-fill"></i></div>
                                    <div class="flex-grow-1">
                                        <h3 class="activity-title mb-1">@clip.RecipeTitle</h3>
                                        <p class="activity-amount mb-0">@clip.QualifiedViews Views &middot; @clip.TotalWatchMinutes.ToString("0.##") Minuten</p>
                                    </div>
                                    <div class="text-end">
                                        <div class="activity-time">Ø @clip.AverageWatchSeconds.ToString("0.##")s</div>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
            <section class="content-card mb-4" aria-label="Sales Activity Feed">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="section-title mb-0">Sales Activity</h2>
                    <span class="section-meta">@Model.SalesHistory.Count Einträge</span>
                </div>

                @if (!Model.SalesHistory.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-activity"></i>
                        <p class="mb-1">Noch keine Verkäufe</p>
                        <small>Deine Verkäufe erscheinen hier automatisch, sobald ein Listing gekauft wurde.</small>
                    </div>
                }
                else
                {
                    <div class="activity-feed">
                        @foreach (var sale in Model.SalesHistory.OrderByDescending(x => x.PurchasedAt))
                        {
                            <article class="activity-card">
                                <div class="activity-head">
                                    <div class="activity-status" aria-hidden="true"><i class="bi bi-check-circle-fill"></i></div>
                                    <div class="flex-grow-1">
                                        <h3 class="activity-title mb-1">@(sale.Listing?.Title ?? $"Listing #{sale.ListingId}")</h3>
                                        <p class="activity-amount mb-0">+@sale.CreatorAmount.ToString("0.######") @sale.PaymentToken</p>
                                    </div>
                                    <time class="activity-time" datetime="@sale.PurchasedAt.ToString("o")">@sale.PurchasedAt.ToString("dd.MM.yyyy HH:mm")</time>
                                </div>
                                <details class="activity-details mt-2">
                                    <summary>Details <i class="bi bi-chevron-down"></i></summary>
                                    <div class="activity-details-grid">
                                        <div><span>Token</span><strong>@sale.PaymentToken</strong></div>
                                        <div><span>Preis</span><strong>@sale.PricePaid.ToString("0.######")</strong></div>
                                        <div><span>Creator Anteil</span><strong>@sale.CreatorAmount.ToString("0.######")</strong></div>
                                    </div>
                                </details>
                            </article>
                        }
                    </div>
                }
            </section>

            @if (Model.WildCoinHistory.Any())
            {
                <section class="content-card mb-5" aria-label="Transactions History">
                    <h2 class="section-title mb-3">Transactions History</h2>
                    <div class="activity-feed muted-feed">
                        @foreach (var tx in Model.WildCoinHistory.OrderByDescending(x => x.CreatedAt))
                        {
                            <article class="activity-card compact">
                                <div class="activity-head">
                                    <div class="activity-status neutral" aria-hidden="true"><i class="bi bi-arrow-left-right"></i></div>
                                    <div class="flex-grow-1">
                                        <h3 class="activity-title mb-1">@tx.Type</h3>
                                        <p class="activity-amount mb-0">@tx.Amount.ToString("0.######") WLD</p>
                                    </div>
                                    <time class="activity-time" datetime="@tx.CreatedAt.ToString("o")">@tx.CreatedAt.ToString("dd.MM.yyyy HH:mm")</time>
                                </div>
                                <div class="activity-details-grid mt-2">
                                    <div><span>Saldo danach</span><strong>@tx.BalanceAfter.ToString("0.######")</strong></div>
                                    <div><span>Referenz</span><strong>@(tx.ReferenceInfo ?? "-")</strong></div>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }

            <div class="quick-actions-bar">
                <button type="button" class="btn creator-btn-primary flex-grow-1">
                    <i class="bi bi-cash-coin me-2"></i>Geld anfordern
                </button>
                <a class="btn creator-btn-secondary" href="@Url.Action("MyListings", "Marketplace", new { area = "WorldMiniApp" })">
                    <i class="bi bi-shop-window me-2"></i>Listings
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const theme = localStorage.getItem('profile_theme') || 'color';
            document.body.classList.remove(
                'profile-theme-black',
                'profile-theme-white',
                'profile-theme-color',
                'profile-theme-rose',
                'profile-theme-lavender'
            );
            document.body.classList.add(`profile-theme-${theme}`);
        })();
    </script>
    <script>
        (function () {
            const copyButton = document.getElementById('copyHashBtn');
            const toast = document.getElementById('copyToast');

            if (!copyButton || !toast) {
                return;
            }

            copyButton.addEventListener('click', async function () {
                const text = copyButton.getAttribute('data-copy-text') || '';
                if (!text) {
                    return;
                }

                try {
                    await navigator.clipboard.writeText(text);
                    toast.classList.add('show');
                    window.setTimeout(function () {
                        toast.classList.remove('show');
                    }, 1400);
                } catch {
                    toast.textContent = 'Fehler';
                    toast.classList.add('show');
                    window.setTimeout(function () {
                        toast.classList.remove('show');
                        toast.textContent = 'Kopiert';
                    }, 1400);
                }
            });
        })();
    </script>
}





