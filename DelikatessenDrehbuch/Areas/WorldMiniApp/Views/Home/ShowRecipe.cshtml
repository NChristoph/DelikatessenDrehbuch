<!-- Local AI Bottom-Bar removed (we use the global resume bar + toast in _MiniAppLayout.cshtml) -->
<div class="ai-bottom-bar" id="aiBottomBar" style="display:none">
    <div class="ai-bottom-bar-content">
        <div class="ai-bottom-bar-left" id="aiBottomBarStatus">
            <span class="spinner-border spinner-border-sm text-light"></span>
            <span>AI transformiert...</span>
