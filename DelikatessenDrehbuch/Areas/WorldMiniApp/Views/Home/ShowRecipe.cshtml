    function escapeHtml(value) {
        return (value || '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('\"', '&quot;')
            .replaceAll('\'', '&#39;');
    }

    function isGenericAutoAddedHint(value) {
        const text = (value || '').toString().trim().toLowerCase();
        if (!text) return false;
        // UI noise: this hint is an internal detail and shouldn't be shown to users.
        if (text === 'aus zutatenliste ergänzt' || text === 'aus zutatenliste ergaenzt') return true;
        if (text.startsWith('aus zutatenliste')) return true;
        return false;
    }

    function renderChangeHint(value, className) {
        if (!value || isGenericAutoAddedHint(value)) return '';
        return `<div class="${className}">${escapeHtml(value)}</div>`;
    }

    function formatIngredientQuantity(item) {
        const qRaw = (item?.quantity || '').toString().trim();
        const mRaw = (item?.measure || '').toString().trim();
        if (!qRaw) return '';
        if (!mRaw) return qRaw;

        // Avoid "2 Stk. Stk." when quantity already includes the unit (common for base recipe ingredients).
        const normalizeUnit = (s) => (s || '').toString().trim().replace(/\.+$/, '').toLowerCase();
        const qTokens = qRaw.split(/\s+/).filter(Boolean);
        const lastToken = qTokens.length ? qTokens[qTokens.length - 1] : '';
        if (normalizeUnit(lastToken) === normalizeUnit(mRaw)) return qRaw;

        return `${qRaw} ${mRaw}`.trim();
    }

    window.selectAiConcept = function selectAiConcept(conceptKey) {
        const concept = (aiPreviewState.suggestions || []).find(item => item.conceptKey === conceptKey);
        if (!concept) return;

        aiPreviewState.selectedConcept = {
            conceptKey: concept.conceptKey,
            conceptTitle: concept.conceptTitle || concept.name || '',
            conceptSummary: concept.conceptSummary || concept.aiReason || '',
            conceptApproach: concept.conceptApproach || '',
            conceptIngredientPlan: Array.isArray(concept.conceptIngredientPlan) ? concept.conceptIngredientPlan : []
        };
        aiPreviewState.selectedIngredientIds = [];
        aiPreviewState.preview = null;
        renderAiIngredientSuggestions(aiPreviewState.suggestionResponse);
    };

    function renderAiIngredientSuggestions(payload) {
        const list = document.getElementById('aiSuggestionList');
        const strategyLabel = document.getElementById('aiSuggestionStrategyLabel');
        const reasoning = document.getElementById('aiSuggestionReasoning');
        const selectionStatus = document.getElementById('aiSelectionStatus');
        const confirmButton = document.getElementById('aiConfirmSelectionBtn');

        if (!list || !strategyLabel || !reasoning || !selectionStatus || !confirmButton) return;

        if (!payload) {
            setAiConceptBlockVisible(true);
            strategyLabel.textContent = '';
            reasoning.textContent = 'Wir suchen stimmige Rezeptideen.';
            list.innerHTML = '';
            selectionStatus.textContent = 'Wähle gleich eine Rezeptidee aus und bestätige danach.';
            confirmButton.textContent = 'Rezeptidee wählen & generieren';
            confirmButton.disabled = true;
            return;
        }

        document.getElementById('aiPreviewModeLabel').textContent = payload.variantLabel || 'AI Vorschau';
        document.getElementById('aiPreviewTitle').textContent = 'Wähle deine Rezeptidee';
        document.getElementById('aiPreviewSummary').textContent = 'Die AI hat mehrere Richtungen vorbereitet. Nach deiner Auswahl bauen wir daraus das eigentliche Rezept.';

        strategyLabel.textContent = payload.strategy === 'replace' ? 'AI empfiehlt eher umbauen' : 'AI empfiehlt eher ergänzen';
        const baseReasoning = payload.reasoning || 'Wähle eine Richtung aus und bestätige danach.';
        const fallbackHint = payload.usedFallback
            ? ' (Lokaler Fallback: Kein erfolgreicher AI-Call oder kein AI-Key konfiguriert.)'
            : '';
        reasoning.textContent = baseReasoning + fallbackHint;

        const suggestions = payload.suggestions || [];
        confirmButton.textContent = 'Rezeptidee wählen & generieren';

        if (!suggestions.length) {
            list.innerHTML = '<div class="ai-suggestion-empty">Keine passende Rezeptidee gefunden.</div>';
            selectionStatus.textContent = 'Es gibt gerade keine passende Auswahl zum Bestätigen.';
            confirmButton.disabled = true;
            return;
        }

        list.innerHTML = suggestions.map(item => {
            const isSelected = aiPreviewState.selectedConcept?.conceptKey === item.conceptKey;
            const plan = Array.isArray(item.conceptIngredientPlan) ? item.conceptIngredientPlan : [];
            const planLines = plan
                .slice(0, 20)
                .map(p => {
                    const qty = (p.quantity || '').toString().trim();
                    const unit = (p.measure || '').toString().trim();
                    const name = (p.ingredientName || p.ingredientId || '').toString().trim();
                    const replacesName = (p.replacesIngredientName || p.replacesIngredientId || '').toString().trim();
                    const action = (p.action || 'add').toString().trim().toLowerCase();

                    if (action === 'replace') {
                        const rhs = [qty, unit, name].filter(Boolean).join(' ').trim();
                        return `Ersetzt ${escapeHtml(replacesName)} durch ${escapeHtml(rhs)}`;
                    }
                    if (action === 'remove') {
                        return `Entfernt ${escapeHtml(replacesName || name)}`;
                    }
                    const addText = [qty, unit, name].filter(Boolean).join(' ').trim();
                    return `+ ${escapeHtml(addText)}`;
                })
                .filter(Boolean);

            return `
                <button type="button" class="ai-suggestion-card${isSelected ? ' is-selected' : ''}" onclick="selectAiConcept('${escapeHtml(item.conceptKey || '')}')">
                    <span class="ai-suggestion-category"><i class="bi bi-stars"></i>${escapeHtml(item.conceptTitle || item.name || 'Konzept')}</span>
                    <div class="fw-bold">${escapeHtml(item.conceptSummary || item.aiReason || '')}</div>
                    <div class="small text-muted mt-1">${escapeHtml(item.conceptApproach || '')}</div>
                    ${planLines.length ? `<div class="small mt-2" style="opacity:0.9; text-align:left;">
                        <div class="fw-semibold" style="opacity:0.8;">Zutaten (Änderungsplan)</div>
                        ${planLines.map(line => `<div>• ${line}</div>`).join('')}
                    </div>` : ''}
                </button>`;
        }).join('');

        updateAiConfirmButtonState();
    }

    function updateAiConfirmButtonState() {
        const selectionStatus = document.getElementById('aiSelectionStatus');
        const confirmButton = document.getElementById('aiConfirmSelectionBtn');
        if (!selectionStatus || !confirmButton) return;

        if (aiPreviewState.previewInFlight) {
            selectionStatus.textContent = 'AI generiert gerade die Variante...';
            confirmButton.disabled = true;
            return;
        }

        if (!aiPreviewState.selectedConcept) {
            selectionStatus.textContent = 'Wähle eine Rezeptidee und bestätige danach.';
        } else {
            selectionStatus.textContent = `„${aiPreviewState.selectedConcept.conceptTitle}“ gewählt. Mit Bestätigen starten wir die Generierung.`;
        }

        confirmButton.textContent = 'Rezeptidee wählen & generieren';
        confirmButton.disabled = !aiPreviewState.selectedConcept || aiPreviewState.suggestionInFlight;
    }

    function confirmAiIngredientSelection() {
        if (!aiPreviewState.selectedConcept) {
            setAiPreviewError('Wähle zuerst eine Rezeptidee aus.');
            return;
        }

        if (aiPreviewState.previewInFlight) {
            return;
        }

        setAiPreviewError('');
        setAiPreviewDetailsVisible(false);
        aiPreviewState.suppressResumeBarOnce = true;
        getAiTransformModal().hide();

        // Start async background job: user can continue browsing immediately.
        (async () => {
            try {
                aiPreviewState.previewInFlight = true;
                aiPreviewState.jobId = null;
                setGlobalAiResume(AI_RESUME_STAGE.queued);
                window.WorldMiniAppAiResume?.toast?.('AI läuft im Hintergrund. Du kannst weiter scrollen.');

                const started = await startAiVariantJob(aiPreviewState.latestUserNote || '');
                aiPreviewState.jobId = started?.jobId || null;
                setGlobalAiResume(AI_RESUME_STAGE.running);
                aiPreviewState.previewInFlight = false;
            } catch (err) {
                aiPreviewState.previewInFlight = false;
                setAiPreviewError(err?.message || 'AI-Job konnte nicht gestartet werden.');
                setGlobalAiResume(AI_RESUME_STAGE.error);
            }
        })();
    }

    document.getElementById('aiPreviewRegenerateBtn')?.addEventListener('click', async () => {
        if (!aiPreviewState.preview || aiPreviewState.preview.remainingChanges <= 0) return;

        const noteInput = document.getElementById('aiPreviewUserNote');
        const userNote = (noteInput?.value || '').trim();
        if (!userNote) {
            setAiPreviewError('Schreib kurz, was noch angepasst werden soll.');
            return;
        }

        aiPreviewState.appliedChangeCount += 1;

        try {
            await requestAiPreview(userNote);
            if (noteInput) noteInput.value = '';
        } catch (error) {
            aiPreviewState.appliedChangeCount = Math.max(0, aiPreviewState.appliedChangeCount - 1);
            setAiPreviewError(error.message || 'AI-Änderung konnte nicht angewendet werden.');
        }
    });

    document.getElementById('aiPreviewApplyBtn')?.addEventListener('click', async () => {
        try {
            await applyAiPreviewToPage();
        } catch (error) {
            setAiPreviewError(error.message || 'AI-Variante konnte nicht gespeichert werden.');
        }
    });

    document.getElementById('aiConfirmSelectionBtn')?.addEventListener('click', () => {
        confirmAiIngredientSelection();
    });

    document.getElementById('aiTransformModal')?.addEventListener('hidden.bs.modal', () => {
        if (aiPreviewState.suppressResumeBarOnce) {
            aiPreviewState.suppressResumeBarOnce = false;
            return;
        }

        syncAiBottomBarForCurrentState();
    });

    // If we navigated here from the global resume bar, auto-open the modal.
    (function autoResumeAiModal() {
        try {
            const params = new URLSearchParams(window.location.search || '');
            if (params.get('aiResume') !== '1') return;

            const resumeState = window.WorldMiniAppAiResume?.readState?.() || null;
            const variant = ((params.get('variantType') || resumeState?.variantType || '') + '').trim();
            const jobId = ((params.get('jobId') || resumeState?.jobId || '') + '').trim();
            const provider = ((params.get('aiProvider') || resumeState?.aiProvider || 'openai') + '').trim() || 'openai';

            if (jobId && variant && typeof window.openAiJobResult === 'function') {
                window.openAiJobResult(jobId, variant, provider);
                return;
            }
            if (variant && typeof window.openAiTransformModal === 'function') {
                window.openAiTransformModal(variant, provider);
            }
        } catch {
            // ignore
        }
    })();

    // ----------------- Back To Feed (restore scroll position) -----------------
    (function bindBackToFeedRestore() {
        const FEED_STATE_KEY = 'worldminiapp.feed.state.v1';
        const FEED_RESTORE_FLAG_KEY = 'worldminiapp.feed.restore.v1';
        const btn = document.getElementById('backToFeedBtn');
        if (!btn) return;

        btn.addEventListener('click', (event) => {
            event.preventDefault();

            try {
                const raw = sessionStorage.getItem(FEED_STATE_KEY);
                const state = raw ? JSON.parse(raw) : null;
                const returnUrl = (state?.returnUrl || '').toString();

                if (returnUrl && returnUrl.includes('/WorldMiniApp/Feed')) {
                    sessionStorage.setItem(FEED_RESTORE_FLAG_KEY, '1');
                    window.location.href = returnUrl;
                    return;
                }
            } catch {
                // ignore parse errors and fall back
            }

            history.back();
        });
    })();

    renderSavedAiVariantButtons();

    // If we navigated here from the profile AI tab, auto-apply the requested variant silently.
    if (autoApplyAiVariantId && Array.isArray(savedAiVariants) && savedAiVariants.length) {
        const idx = savedAiVariants.findIndex(x => Number(x?.variantId || 0) === Number(autoApplyAiVariantId));
        if (idx >= 0 && typeof window.applySavedAiVariant === 'function') {
            try { window.applySavedAiVariant(idx); } catch { /* ignore */ }
        }
    }
</script>
