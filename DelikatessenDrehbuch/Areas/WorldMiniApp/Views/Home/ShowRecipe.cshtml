@model DelikatessenDrehbuch.Models.RecipeBaseData
@using System.Globalization
@using Microsoft.AspNetCore.Localization
@using DelikatessenDrehbuch
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> SharedLocalizer

@{
    Layout = "_MiniAppLayout";
    ViewData["Title"] = Model.Title;

    decimal totalCalories = 0, totalProtein = 0, totalFat = 0, totalCarbs = 0, totalSugar = 0, totalFiber = 0;

    foreach (var item in Model.Ingredients)
    {
        var nutri = item.Ingredient.IngredientsAndNutrients;
        var quantity = (decimal)item.Ingredient.Quantity.Quantitys;
        var unit = item.Ingredient.Measure.Metrics_DE.ToLower();

        decimal factor = (unit == "stk" || unit == "stück")
            ? (quantity * nutri.Weight_per_piece) / 100m
            : quantity / 100m;

        totalCalories += nutri.Calories_a_100g * factor;
        totalProtein += nutri.Protein_a_100g * factor;
        totalFat += nutri.Fat_a_100g * factor;
        totalCarbs += nutri.Carbohydrates_a_100g * factor;
        totalSugar += nutri.Sugar_a_100g * factor;
        totalFiber += nutri.Fiber_a_100g * factor;
    }

    var basePortions = Math.Max(1, Model.PersonCount);

    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture ?? CultureInfo.CurrentCulture;
    var language = currentCulture.TwoLetterISOLanguageName;

    string IngredientName(DelikatessenDrehbuch.Models.IngredientsAndNutrients item) => language switch
    {
        "en" => item.Name_EN,
        "es" => item.Name_ESP,
        "pt" => item.Name_PRT,
        "id" => item.Name_ID,
        "nl" => item.Name_NL,
        "sv" => item.Name_SE,
        "da" => item.Name_DK,
        "nb" => item.Name_NO,
        "ms" => item.Name_MS,
        _ => item.Name_DE
    };

    string StepText(DelikatessenDrehbuch.Models.RecipePreparationSteps step) => language switch
    {
        "en" => step.Step_EN,
        "es" => step.Step_ESP,
        "pt" => step.Step_PRT,
        _ => step.Step_DE
    };

    var canPublishToFeed = ViewData["CanPublishToFeed"] as bool? == true;
    var existingPostingId = ViewData["ExistingPostingId"] as int?;
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet">

<style>
    :root {
        --deli-primary: #2D4F1E;
        --deli-gold: #D4AF37;
        --deli-bg: #F8F9F5;
        --deli-dark: #1A1A1A;
        --shadow-sm: 0 4px 12px rgba(0,0,0,0.05);
        --shadow-md: 0 12px 24px rgba(0,0,0,0.08);
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--deli-bg);
        color: var(--deli-dark);
        margin: 0;
        padding: 0;
    }

    h1, h2, .serif-font {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
    }

    .hero-container {
        position: relative;
        height: 50vh;
        min-height: 400px;
        width: 100%;
        overflow: hidden;
    }

    .hero-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .header-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, transparent 30%, rgba(0,0,0,0.6) 100%);
    }

    .back-btn {
        position: absolute;
        top: 50px;
        left: 20px;
        z-index: 100;
        width: 45px;
        height: 45px;
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(10px);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--shadow-md);
        color: var(--deli-dark);
    }

    .recipe-main-content {
        position: relative;
        margin-top: -45px;
        background: var(--deli-bg);
        border-top-left-radius: 40px;
        border-top-right-radius: 40px;
        padding-top: 20px;
        z-index: 20;
        box-shadow: 0 -10px 30px rgba(0,0,0,0.05);
    }

    .drag-handle {
        width: 45px;
        height: 5px;
        background: #D1D1D1;
        border-radius: 10px;
        margin: 0 auto 25px;
    }

    .title-section {
        padding: 0 25px;
        margin-bottom: 30px;
    }

    .badge-row {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .premium-badge {
        background: white;
        padding: 10px 16px;
        border-radius: 18px;
        box-shadow: var(--shadow-sm);
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .nav-pills-custom {
        background: #EEEFEA;
        padding: 6px;
        border-radius: 22px;
        margin: 0 20px 30px;
        display: flex;
    }

    .nav-pills-custom .nav-link {
        flex: 1;
        border-radius: 18px;
        color: #707070;
        font-weight: 700;
        border: none;
        padding: 14px 5px;
        font-size: 0.9rem;
        transition: var(--transition);
        background: transparent;
    }

    .nav-pills-custom .nav-link.active {
        background: white;
        color: var(--deli-primary);
        box-shadow: var(--shadow-sm);
    }

    .portion-selector-wrapper {
        margin-bottom: 25px;
    }

    .portion-stepper {
        background: white;
        border-radius: 100px;
        padding: 10px 24px;
        display: inline-flex;
        align-items: center;
        box-shadow: var(--shadow-sm);
    }

    .ingredient-card {
        background: white;
        margin: 0 20px 12px;
        padding: 18px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        transition: var(--transition);
        cursor: pointer;
    }

    .ingredient-card.checked {
        background: #F1F1F1;
        opacity: 0.5;
        transform: scale(0.98);
    }

    .check-box {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #D7DCD3;
        margin-right: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .ingredient-card.checked .check-box {
        background: var(--deli-primary);
    }

    .step-container {
        padding: 0 20px 20px;
        display: grid;
        gap: 14px;
    }

    .step-card {
        background: white;
        border-radius: 24px;
        padding: 20px;
        box-shadow: var(--shadow-sm);
    }

    .step-badge {
        display: inline-block;
        margin-bottom: 10px;
        padding: 7px 12px;
        border-radius: 999px;
        background: rgba(45,79,30,0.08);
        color: var(--deli-primary);
        font-weight: 700;
        font-size: 0.8rem;
    }

    .nutri-grid {
        padding: 0 20px 20px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .nutri-item {
        background: white;
        border-radius: 24px;
        padding: 22px 16px;
        text-align: center;
        box-shadow: var(--shadow-sm);
    }

    .nutri-item-main {
        grid-column: 1 / -1;
        background: linear-gradient(145deg, #2D4F1E, #426B2E);
        color: white;
    }

    .nutri-val {
        font-size: 1.8rem;
        font-weight: 700;
        display: block;
        margin-bottom: 2px;
    }

    .nutri-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 600;
        opacity: 0.7;
        letter-spacing: 1px;
    }

    @@media (max-width: 768px) {
        .hero-container {
            min-height: 320px;
        }
    }
</style>

<div class="min-vh-100 pb-5">
    <div class="hero-container">
        <div class="header-overlay"></div>
        <a href="#" class="back-btn text-decoration-none" id="backToFeedBtn">
            <i class="bi bi-chevron-left fs-5"></i>
        </a>

        @if (ViewData["SwapsJson"] is string)
        {
            <a href="@Url.Action("ShowRecipe", "Home", new { area = "WorldMiniApp", id = Model.Id, original = true })"
               class="btn btn-sm btn-light shadow-sm"
               style="position: absolute; top: 20px; right: 20px; z-index: 20; border-radius: 20px; font-weight: 600; padding: 8px 16px;">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Original
            </a>
        }

        @if (Model.Images != null && Model.Images.Any())
        {
            <img src="@Model.Images.First().Image" class="hero-image" alt="@Model.Title" />
        }
        else if (ViewData["PostingThumbnailUrl"] is string thumbUrl && !string.IsNullOrWhiteSpace(thumbUrl))
        {
            <img src="@thumbUrl" class="hero-image" alt="@Model.Title" />
        }
        else
        {
            <div class="hero-image d-flex align-items-center justify-content-center" style="background: linear-gradient(145deg, #d9dfd3, #eef2e9);">
                <i class="bi bi-image text-muted" style="font-size: 4rem;"></i>
            </div>
        }
    </div>

    <div class="recipe-main-content">
        <div class="drag-handle"></div>

        <div class="title-section text-center">
            <h1 class="display-6 mb-3">@Model.Title</h1>

            @if (ViewData["SwapsJson"] is string)
            {
                <div class="mb-3">
                    <a href="@Url.Action("ShowRecipe", "Home", new { area = "WorldMiniApp", id = Model.Id, original = true })"
                       class="btn btn-dark btn-sm px-3 py-2 shadow-sm"
                       style="border-radius: 999px; font-weight: 700;">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Originalrezept anzeigen
                    </a>
                </div>
            }

            <div class="badge-row mb-3">
                @if (ViewData["SwapsJson"] is string swapsJsonBadge)
                {
                    var swapCount = 0;
                    try
                    {
                        var swaps = System.Text.Json.JsonSerializer.Deserialize<List<DelikatessenDrehbuch.Models.IngredientSwap>>(swapsJsonBadge);
                        swapCount = swaps?.Count ?? 0;
                    }
                    catch { }

                    if (swapCount > 0)
                    {
                        <div class="premium-badge" style="background: linear-gradient(135deg, #28a745, #20c997); color: white; font-weight: 700;">
                            <i class="bi bi-arrow-left-right"></i> @swapCount Angepasst
                        </div>
                    }
                }
                <div class="premium-badge">
                    <i class="bi bi-people text-primary"></i> @Model.PersonCount
                </div>
                <div class="premium-badge">
                    <i class="bi bi-clock text-warning"></i> @Model.PreparationTime Min.
                </div>
                <div class="premium-badge">
                    <i class="bi bi-fire text-danger"></i>
                    <span id="headerCalories" data-base="@((totalCalories / basePortions).ToString(CultureInfo.InvariantCulture))">@Math.Round(totalCalories / basePortions)</span> kcal
                </div>
            </div>

            @if (canPublishToFeed)
            {
                <div class="mt-3">
                    @if (existingPostingId.HasValue)
                    {
                        <a class="btn btn-sm btn-outline-primary"
                           href="@Url.Action("EditRecipe", "Home", new { area = "WorldMiniApp", postingId = existingPostingId.Value })">
                            <i class="bi bi-pencil-square me-1"></i> Feed-Posting bearbeiten
                        </a>
                    }
                    else
                    {
                        <form asp-action="PublishRecipeBaseDataToFeed" asp-controller="Home" asp-area="WorldMiniApp" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="recipeBaseDataId" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-primary">
                                <i class="bi bi-broadcast-pin me-1"></i> Als Feed-Posting anlegen
                            </button>
                        </form>
                    }
                </div>
            }
        </div>

        <nav class="nav nav-pills-custom" id="recipeTab" role="tablist">
            <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#ingredients" type="button">@SharedLocalizer["Recipe.Ingredients"]</button>
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#preparation" type="button">@SharedLocalizer["Recipe.Steps"]</button>
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#nutrition" type="button">@SharedLocalizer["Recipe.Nutrition"]</button>
        </nav>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="ingredients" role="tabpanel">
                <div class="text-center portion-selector-wrapper">
                    <div class="portion-stepper">
                        <span class="me-2 fw-bold text-muted small">@SharedLocalizer["Recipe.ServingsFor"]</span>
                        <input type="number"
                               id="portionInput"
                               class="fw-bold text-center"
                               value="@basePortions"
                               min="1"
                               onchange="updatePortions()"
                               style="width:45px; border:none; background:transparent; color:var(--deli-primary); font-size:1.1rem;">
                    </div>
                </div>

                <div id="ingredientListContainer">
                    @foreach (var group in Model.Ingredients.GroupBy(i => i.Ingredient.IngredientsAndNutrients.Group?.Name ?? "General"))
                    {
                        <h6 class="text-uppercase fw-bold opacity-50 mb-3 px-4" style="font-size:0.7rem; letter-spacing:2px;">@group.Key</h6>
                        @foreach (var item in group)
                        {
                            <div class="ingredient-card shadow-sm" data-ingredient-id="@item.Ingredient.IngredientsAndNutrients.Id">
                                <div class="check-box" onclick="toggleCheck(this.parentElement)" style="cursor: pointer;">
                                    <i class="bi bi-check-lg text-white d-none"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="ingredient-name fw-bold fs-6">@IngredientName(item.Ingredient.IngredientsAndNutrients)</span>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-muted small ingredient-quantity">
                                                <span class="dyn-qty fw-bold text-dark" data-base-qty="@item.Ingredient.Quantity.Quantitys.ToString(CultureInfo.InvariantCulture)">@item.Ingredient.Quantity.Quantitys</span> <span class="ingredient-unit">@item.Ingredient.Measure.Metrics_DE</span>
                                            </span>
                                            <button class="btn btn-sm btn-outline-primary swap-btn"
                                                    data-swap-ingredient="@item.Ingredient.IngredientsAndNutrients.Id"
                                                    data-recipe-id="@Model.Id"
                                                    data-ingredient-name="@IngredientName(item.Ingredient.IngredientsAndNutrients)"
                                                    title="@SharedLocalizer["Recipe.SwapIngredient"]"
                                                    style="padding: 4px 10px; font-size: 0.75rem; border-radius: 12px;">
                                                <i class="bi bi-arrow-left-right"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="preparation" role="tabpanel">
                <div class="step-container" id="preparationListContainer">
                    @foreach (var step in Model.Steps.OrderBy(s => s.StepIndex))
                    {
                        <div class="step-card">
                            <span class="step-badge">@SharedLocalizer["Recipe.Step"] @step.StepIndex</span>
                            <p class="mb-0 lh-lg" style="font-size:1.05rem; color:#444;">@StepText(step.RecipePreparationStep)</p>
                        </div>
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="nutrition" role="tabpanel">
                <div class="nutri-grid">
                    <div class="nutri-item nutri-item-main shadow-lg">
                        <span class="nutri-val dyn-nutri" data-base="@totalCalories.ToString(CultureInfo.InvariantCulture)" style="font-size:3rem;">@Math.Round(totalCalories)</span>
                        <span class="nutri-label">Gesamt Kcal</span>
                    </div>
                    <div class="nutri-item">
                        <span class="nutri-val dyn-nutri" data-base="@totalProtein.ToString(CultureInfo.InvariantCulture)">@Math.Round(totalProtein)</span>
                        <span class="nutri-label">@SharedLocalizer["Recipe.Protein"]</span>
                    </div>
                    <div class="nutri-item">
                        <span class="nutri-val dyn-nutri" data-base="@totalCarbs.ToString(CultureInfo.InvariantCulture)">@Math.Round(totalCarbs)</span>
                        <span class="nutri-label">@SharedLocalizer["Recipe.Carbs"]</span>
                    </div>
                    <div class="nutri-item">
                        <span class="nutri-val dyn-nutri" data-base="@totalFat.ToString(CultureInfo.InvariantCulture)">@Math.Round(totalFat)</span>
                        <span class="nutri-label">@SharedLocalizer["Recipe.Fat"]</span>
                    </div>
                    <div class="nutri-item">
                        <span class="nutri-val dyn-nutri" data-base="@totalSugar.ToString(CultureInfo.InvariantCulture)">@Math.Round(totalSugar, 1)</span>
                        <span class="nutri-label">@SharedLocalizer["Recipe.Sugar"]</span>
                    </div>
                </div>

                <div class="text-center mt-5 px-4 text-muted small fst-italic">
                    @SharedLocalizer["Recipe.NutritionDisclaimer"]
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/ingredient-swap.js"></script>

<script>
    const basePortionCount = @basePortions;

    function toggleCheck(element) {
        element.classList.toggle('checked');
        const icon = element.querySelector('.bi-check-lg');
        if (icon) icon.classList.toggle('d-none');
    }

    function updatePortions() {
        const input = document.getElementById('portionInput');
        let newCount = parseFloat(input.value);
        if (isNaN(newCount) || newCount < 0.1) newCount = 1;

        const ratio = newCount / basePortionCount;

        document.querySelectorAll('.dyn-qty').forEach(el => {
            const baseQty = parseFloat(el.getAttribute('data-base-qty').replace(',', '.'));
            if (!isNaN(baseQty)) {
                const newVal = baseQty * ratio;
                el.innerText = (Math.round(newVal * 100) / 100).toString().replace('.', ',');
            }
        });

        const headerCal = document.getElementById('headerCalories');
        const baseHeaderCal = parseFloat(headerCal.getAttribute('data-base').replace(',', '.'));
        headerCal.innerText = Math.round(baseHeaderCal * (newCount / basePortionCount)).toString();

        document.querySelectorAll('.dyn-nutri').forEach(el => {
            const baseNutri = parseFloat(el.getAttribute('data-base').replace(',', '.'));
            if (!isNaN(baseNutri)) {
                el.innerText = Math.round(baseNutri * ratio).toString();
            }
        });
    }

    (function bindBackToFeedRestore() {
        const FEED_STATE_KEY = 'worldminiapp.feed.state.v1';
        const FEED_RESTORE_FLAG_KEY = 'worldminiapp.feed.restore.v1';
        const btn = document.getElementById('backToFeedBtn');
        if (!btn) return;

        btn.addEventListener('click', (event) => {
            event.preventDefault();

            try {
                const raw = sessionStorage.getItem(FEED_STATE_KEY);
                const state = raw ? JSON.parse(raw) : null;
                const returnUrl = (state?.returnUrl || '').toString();

                if (returnUrl && returnUrl.includes('/WorldMiniApp/Feed')) {
                    sessionStorage.setItem(FEED_RESTORE_FLAG_KEY, '1');
                    window.location.href = returnUrl;
                    return;
                }
            } catch {
            }

            history.back();
        });
    })();

    // Apply ingredient swaps if variant loaded
    @if (ViewData["SwapsJson"] is string swapsJson)
    {
        <text>
        document.addEventListener('DOMContentLoaded', function() {
            try {
                const swapsJsonString = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(swapsJson));
                const swaps = JSON.parse(swapsJsonString);

                if (!swaps || !Array.isArray(swaps) || swaps.length === 0) {
                    return;
                }

                const escapeRegExp = (value) => String(value || '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                const applyIngredientSwapMarkup = (text, fromName, toName) => {
                    if (!text || !fromName || !toName) return text;

                    const re = new RegExp(escapeRegExp(fromName), 'g');
                    return String(text).replace(re,
                        `<span style="text-decoration: line-through; opacity: 0.55;">${fromName}</span> → <span style="color: #28a745; font-weight: 700;">${toName}</span>`
                    );
                };

                const stepParagraphs = Array.from(document.querySelectorAll('#preparationListContainer .step-card p'));
                const preparationContainer = document.getElementById('preparationListContainer');
                const stepLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["Recipe.Step"].Value));

                const escapeHtml = (text) => {
                    const div = document.createElement('div');
                    div.textContent = text == null ? '' : String(text);
                    return div.innerHTML;
                };

                const getSwapVariantId = () => {
                    try {
                        const u = new URL(window.location.href);
                        const raw = u.searchParams.get('swapVariantId');
                        const id = raw ? parseInt(raw, 10) : NaN;
                        return Number.isFinite(id) ? id : null;
                    } catch {
                        return null;
                    }
                };

                const showInlineStepLoader = (text) => {
                    if (!preparationContainer) return;
                    let el = document.getElementById('swapStepAiLoader');
                    if (!el) {
                        el = document.createElement('div');
                        el.id = 'swapStepAiLoader';
                        el.className = 'd-flex align-items-center gap-2 py-2 px-3 mb-3 rounded border bg-white small';
                        el.style.boxShadow = '0 6px 18px rgba(0,0,0,0.06)';
                        preparationContainer.parentElement?.insertBefore(el, preparationContainer);
                    }

                    // Dim existing steps so the user sees "something is happening" without hiding content.
                    preparationContainer.style.opacity = '0.55';

                    el.innerHTML = `
                        <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
                        <span><strong>AI:</strong> ${escapeHtml(text)}</span>
                    `;
                };

                const hideInlineStepLoader = () => {
                    const el = document.getElementById('swapStepAiLoader');
                    if (el) el.remove();
                    if (preparationContainer) {
                        preparationContainer.style.opacity = '1';
                    }
                };

                swaps.forEach(swap => {
                    const card = document.querySelector(`[data-ingredient-id="${swap.FromIngredientId}"]`);
                    if (!card) {
                        return;
                    }

                    const nameEl = card.querySelector('.ingredient-name');
                    const qtyEl = card.querySelector('.dyn-qty');
                    const unitEl = card.querySelector('.ingredient-unit');
                    const swapBtn = card.querySelector('.swap-btn');

                    if (nameEl) {
                        // Strike through old name and add new name in green
                        nameEl.innerHTML = `<span style="text-decoration: line-through; opacity: 0.5;">${swap.FromName}</span> → <span style="color: #28a745; font-weight: 700;">${swap.ToName}</span>`;
                    }

                    if (qtyEl && swap.NewQuantity) {
                        qtyEl.textContent = swap.NewQuantity;
                        qtyEl.style.color = '#28a745';
                    }

                    if (unitEl && swap.Unit) {
                        unitEl.textContent = swap.Unit;
                    }

                    // Add badge
                    card.style.borderLeft = '4px solid #28a745';
                    card.style.background = 'linear-gradient(to right, rgba(40, 167, 69, 0.05), white)';

                    // Hide swap button for already swapped ingredients
                    if (swapBtn) {
                        swapBtn.style.display = 'none';
                    }

                    // Apply swap to preparation steps (text only; we keep it robust and lightweight)
                    if (swap.FromName && swap.ToName && stepParagraphs.length > 0) {
                        stepParagraphs.forEach(p => {
                            const originalText = p.getAttribute('data-original-step') || p.textContent || '';
                            if (!p.getAttribute('data-original-step')) {
                                p.setAttribute('data-original-step', originalText);
                            }

                            const nextHtml = applyIngredientSwapMarkup(originalText, swap.FromName, swap.ToName);
                            if (nextHtml !== originalText) {
                                p.innerHTML = nextHtml;
                            }
                        });
                    }
                });

                // After the lightweight text-markup swap, ask the AI to rewrite steps properly
                // (technique + times + order), so protein swaps don't stay "word replaced" only.
                if (swaps.length > 0 && preparationContainer) {
                    const payload = {
                        recipeId: @Model.Id,
                        swapVariantId: getSwapVariantId(),
                        language: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(language))
                    };

                    showInlineStepLoader('Zubereitung wird an die getauschten Zutaten angepasst...');
                    fetch('/api/recipe-swap/rewrite-steps', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    })
                    .then(r => r.ok ? r.json() : r.text().then(t => Promise.reject(new Error(t || `HTTP ${r.status}`))))
                    .then(data => {
                        const steps = (data && Array.isArray(data.steps)) ? data.steps : [];
                        if (!steps || steps.length === 0) {
                            hideInlineStepLoader();
                            return;
                        }

                        preparationContainer.innerHTML = steps.map((s, idx) => `
                            <div class="step-card">
                                <span class="step-badge">${escapeHtml(stepLabel)} ${idx + 1}</span>
                                <p class="mb-0 lh-lg" style="font-size:1.05rem; color:#444;">${escapeHtml(s)}</p>
                            </div>
                        `).join('');

                        hideInlineStepLoader();
                    })
                    .catch(err => {
                        console.error('AI step rewrite failed:', err);
                        // Show a short message (no spinner) then restore
                        if (preparationContainer) {
                            preparationContainer.style.opacity = '1';
                        }
                        const el = document.getElementById('swapStepAiLoader');
                        if (el) {
                            el.innerHTML = `<span class="text-muted"><strong>AI:</strong> Konnte Steps nicht automatisch anpassen (Fallback aktiv).</span>`;
                        } else {
                            showInlineStepLoader('Konnte Steps nicht automatisch anpassen (Fallback aktiv).');
                        }
                        setTimeout(hideInlineStepLoader, 3500);
                    });
                }

            } catch (err) {
                console.error('Failed to apply swaps:', err);
            }
        });
        </text>
    }
</script>
