    async function pollAiJobUntilReady(jobId, maxWaitMs = 120000) {
        const id = (jobId || '').toString().trim();
        if (!id) throw new Error('jobId fehlt.');

        const startedAt = Date.now();
        let attempt = 0;

        while (Date.now() - startedAt < maxWaitMs) {
            attempt += 1;
            const statusUrl = '@Url.Action("GetAiRecipeVariantJobStatus", "Home", new { area = "WorldMiniApp" })' + '?jobId=' + encodeURIComponent(id);
            const statusRes = await fetch(statusUrl, { method: 'GET', headers: { 'Accept': 'application/json' } });
            const statusPayload = await readJsonOrText(statusRes);

            if (statusRes.status === 404) {
                throw new Error(statusPayload?.message || 'Job nicht gefunden (abgelaufen).');
            }

            if (!statusRes.ok) {
                // Keep trying briefly; transient errors happen.
                const msg = statusPayload?.message || statusPayload?.rawText || 'AI-Status konnte nicht geladen werden.';
                if (attempt >= 3) throw new Error(msg);
            } else {
                const state = (statusPayload?.state || '').toString().toLowerCase();
                if (state === 'ready') return;
                if (state === 'error') {
                    throw new Error(statusPayload?.message || 'AI-Job ist fehlgeschlagen.');
                }
            }

            // Backoff: 800ms -> 2.5s
            const delay = Math.min(2500, 800 + attempt * 220);
            await new Promise(r => setTimeout(r, delay));
        }

        throw new Error('AI braucht länger als erwartet. Bitte später erneut öffnen.');
    }

    window.openAiJobResult = async function openAiJobResult(jobId, variantType, aiProvider = 'openai') {
        const id = (jobId || '').toString().trim();
        if (!id) return;

        aiPreviewState.variantType = (variantType || aiPreviewState.variantType || '').toString();
        aiPreviewState.aiProvider = (aiProvider || 'openai').toString();
        aiPreviewState.jobId = id;
        setGlobalAiResume(AI_RESUME_STAGE.running);

        setAiPreviewError('');
        setAiPreviewDetailsVisible(false);
        setAiPreviewLoading(true);
        getAiTransformModal().show();

        try {
            // Do not call "result" immediately; it returns 404 while the job is still running.
            await pollAiJobUntilReady(id, 120000);
            const url = '@Url.Action("GetAiRecipeVariantJobResult", "Home", new { area = "WorldMiniApp" })' + '?jobId=' + encodeURIComponent(id);
            const res = await fetch(url, { method: 'GET', headers: { 'Accept': 'application/json' } });
            const payload = await readJsonOrText(res);
            if (!res.ok) {
                throw new Error(payload?.message || payload?.rawText || 'AI-Ergebnis ist noch nicht bereit.');
            }

            renderAiPreview(payload);
            aiPreviewState.preview = payload;
            setAiPreviewLoading(false);
            setGlobalAiResume(AI_RESUME_STAGE.ready, payload?.title || '');
        } catch (err) {
            setAiPreviewLoading(false);
            setAiPreviewError(err?.message || 'AI-Ergebnis konnte nicht geladen werden.');
            setGlobalAiResume(AI_RESUME_STAGE.error);
        }
    };

