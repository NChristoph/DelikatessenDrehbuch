@model DelikatessenDrehbuch.Models.RecipeBaseData
@using System.Globalization

@{
    Layout = "_MiniAppLayout";
    ViewData["Title"] = Model.Title;

    // --- C# Berechnung der Initial-Werte (Basis) ---
    decimal totalCalories = 0, totalProtein = 0, totalFat = 0, totalCarbs = 0, totalSugar = 0, totalFiber = 0;

    foreach (var item in Model.Ingredients)
    {
        var nutri = item.Ingredient.IngredientsAndNutrients;
        var quantity = (decimal)item.Ingredient.Quantity.Quantitys;
        var unit = item.Ingredient.Measure.Metrics_DE.ToLower();

        decimal factor = (unit == "stk" || unit == "stück")
            ? (quantity * nutri.Weight_per_piece) / 100m
            : quantity / 100m;

        totalCalories += nutri.Calories_a_100g * factor;
        totalProtein += nutri.Protein_a_100g * factor;
        totalFat += nutri.Fat_a_100g * factor;
        totalCarbs += nutri.Carbohydrates_a_100g * factor;
        totalSugar += nutri.Sugar_a_100g * factor;
        totalFiber += nutri.Fiber_a_100g * factor;
    }

    var basePortions = Model.PersonCount;
    var language = (Context.Request.Cookies["deli-lang"] ?? "de").ToLowerInvariant();

    string T(string de, string en, string es, string pt) => language switch
    {
        "en" => en,
        "es" => es,
        "pt" => pt,
        _ => de
    };

    string IngredientName(DelikatessenDrehbuch.Models.IngredientsAndNutrients item) => language switch
    {
        "en" => item.Name_EN,
        "es" => item.Name_ESP,
        "pt" => item.Name_PRT,
        _ => item.Name_DE
    };

    string StepText(DelikatessenDrehbuch.Models.RecipePreparationSteps step) => language switch
    {
        "en" => step.Step_EN,
        "es" => step.Step_ESP,
        "pt" => step.Step_PRT,
        _ => step.Step_DE
    };

    var canPublishToFeed = ViewData["CanPublishToFeed"] as bool? == true;
    var existingPostingId = ViewData["ExistingPostingId"] as int?;
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet">

<style>
    :root {
        --deli-primary: #2D4F1E;
        --deli-gold: #D4AF37;
        --deli-cream: #FEFFF2;
        --deli-dark: #1A1A1A;
        --deli-bg: #F8F9F5;
        --shadow-sm: 0 4px 12px rgba(0,0,0,0.05);
        --shadow-md: 0 12px 24px rgba(0,0,0,0.08);
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--deli-bg);
        color: var(--deli-dark);
        margin: 0;
        padding: 0;
    }

    h1, h2, .serif-font {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
    }

    /* --- Immersive Hero Header --- */
    .hero-container {
        position: relative;
        height: 50vh;
        min-height: 400px;
        width: 100%;
        overflow: hidden;
    }

    .hero-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .header-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, transparent 30%, rgba(0,0,0,0.6) 100%);
    }

    .back-btn {
        position: absolute;
        top: 50px;
        left: 20px;
        z-index: 100;
        width: 45px;
        height: 45px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--shadow-md);
        color: var(--deli-dark);
    }

    /* --- Content Body --- */
    .recipe-main-content {
        position: relative;
        margin-top: -45px;
        background: var(--deli-bg);
        border-top-left-radius: 40px;
        border-top-right-radius: 40px;
        padding-top: 20px;
        z-index: 20;
        box-shadow: 0 -10px 30px rgba(0,0,0,0.05);
    }

    .drag-handle {
        width: 45px;
        height: 5px;
        background: #D1D1D1;
        border-radius: 10px;
        margin: 0 auto 25px;
    }

    .title-section {
        padding: 0 25px;
        margin-bottom: 30px;
    }

    .badge-row {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .premium-badge {
        background: white;
        padding: 10px 16px;
        border-radius: 18px;
        box-shadow: var(--shadow-sm);
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        font-size: 0.85rem;
        border: 1px solid rgba(212, 175, 55, 0.1);
    }

    /* --- Custom Tab Navigation --- */
    .nav-pills-custom {
        background: #EEEFEA;
        padding: 6px;
        border-radius: 22px;
        margin: 0 20px 30px;
        display: flex;
    }

        .nav-pills-custom .nav-link {
            flex: 1;
            border-radius: 18px;
            color: #707070;
            font-weight: 700;
            border: none;
            padding: 14px 5px;
            font-size: 0.9rem;
            transition: var(--transition);
            background: transparent;
        }

            .nav-pills-custom .nav-link.active {
                background: white;
                color: var(--deli-primary);
                box-shadow: var(--shadow-sm);
            }

    /* --- Ingredients Section --- */
    .portion-selector-wrapper {
        margin-bottom: 25px;
    }

    .portion-stepper {
        background: white;
        border-radius: 100px;
        padding: 10px 24px;
        display: inline-flex;
        align-items: center;
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(0,0,0,0.03);
    }

    .ingredient-card {
        background: white;
        margin: 0 20px 12px;
        padding: 18px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        transition: var(--transition);
        border: 1px solid transparent;
        cursor: pointer;
    }

        .ingredient-card.checked {
            background: #F1F1F1;
            opacity: 0.5;
            transform: scale(0.98);
        }

    .check-box {
        width: 28px;
        height: 28px;
        border-radius: 10px;
        border: 2px solid var(--deli-gold);
        margin-right: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--transition);
    }

    .checked .check-box {
        background: var(--deli-primary);
        border-color: var(--deli-primary);
    }

    /* --- Preparation Steps --- */
    .step-container {
        padding: 0 20px;
    }

    .step-card {
        position: relative;
        padding: 25px;
        background: white;
        border-radius: 24px;
        margin-bottom: 20px;
        box-shadow: var(--shadow-sm);
        border-left: 5px solid var(--deli-gold);
    }

    .step-badge {
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--deli-gold);
        letter-spacing: 1.5px;
        margin-bottom: 10px;
        display: block;
    }

    /* --- Nutrition Grid --- */
    .nutri-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        padding: 0 20px;
    }

    .nutri-item {
        background: white;
        padding: 22px;
        border-radius: 24px;
        text-align: center;
        box-shadow: var(--shadow-sm);
    }

    .nutri-item-main {
        grid-column: span 2;
        background: var(--deli-primary);
        color: white;
    }

    .nutri-val {
        font-size: 1.8rem;
        font-weight: 700;
        display: block;
        margin-bottom: 2px;
    }

    .nutri-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 600;
        opacity: 0.7;
        letter-spacing: 1px;
    }

    .ai-fan-section {
        margin: 26px 20px 0;
        background: linear-gradient(180deg, rgba(45,79,30,0.06) 0%, rgba(212,175,55,0.12) 100%);
        border: 1px solid rgba(45,79,30,0.08);
        border-radius: 26px;
        padding: 18px;
        box-shadow: var(--shadow-sm);
    }

    .ai-fan-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        margin-bottom: 14px;
    }

    .ai-fan-kicker {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 1.6px;
        color: var(--deli-primary);
        font-weight: 800;
        margin-bottom: 4px;
    }

    .ai-fan-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--deli-dark);
        margin: 0;
    }

    .ai-fan-sub {
        font-size: 0.82rem;
        color: #5f6657;
        margin: 0;
    }

    .ai-fan-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .ai-fan-btn {
        border: none;
        border-radius: 18px;
        padding: 14px 12px;
        background: white;
        color: var(--deli-dark);
        font-weight: 700;
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .ai-fan-btn:hover,
    .ai-fan-btn:focus-visible {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
        outline: none;
    }

    .ai-fan-btn i {
        color: var(--deli-primary);
    }

    .ai-preview-modal .modal-content {
        border: none;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 24px 80px rgba(0,0,0,0.22);
        max-height: min(88vh, 960px);
    }

    .ai-preview-modal .modal-dialog {
        margin: 1rem auto;
    }

    .ai-preview-modal .modal-dialog-scrollable {
        height: calc(100% - 2rem);
    }

    .ai-preview-modal .modal-dialog-scrollable .modal-content {
        max-height: 100%;
    }

    .ai-preview-head {
        padding: 22px 22px 18px;
        background: linear-gradient(180deg, #24381d 0%, #304d24 100%);
        color: white;
    }

    .ai-preview-mode {
        font-size: 0.72rem;
        letter-spacing: 1.4px;
        text-transform: uppercase;
        opacity: 0.78;
        font-weight: 700;
    }

    .ai-preview-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.5rem;
        line-height: 1.15;
        margin: 8px 0 10px;
    }

    .ai-preview-summary {
        font-size: 0.94rem;
        line-height: 1.55;
        opacity: 0.9;
        margin: 0;
    }

    .ai-preview-body {
        padding: 20px 22px 22px;
        background: #f7f8f2;
        overflow-y: auto;
        overscroll-behavior: contain;
        -webkit-overflow-scrolling: touch;
    }

    .ai-preview-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 16px;
    }

    .ai-preview-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: white;
        border-radius: 999px;
        padding: 8px 12px;
        box-shadow: var(--shadow-sm);
        font-size: 0.78rem;
        font-weight: 700;
        color: #45503c;
    }

    .ai-preview-block {
        background: white;
        border-radius: 22px;
        padding: 18px;
        box-shadow: var(--shadow-sm);
        margin-bottom: 14px;
    }

    .ai-preview-block h6 {
        font-size: 0.78rem;
        letter-spacing: 1.4px;
        text-transform: uppercase;
        color: #67725d;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .ai-preview-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 10px;
    }

    .ai-preview-ingredient,
    .ai-preview-step {
        border-radius: 16px;
        background: #f6f7f2;
        padding: 12px 14px;
    }

    .ai-preview-ingredient.is-modified {
        background: #eef7e7;
        border: 1px solid rgba(45,79,30,0.12);
    }

    .ai-preview-step-index {
        width: 28px;
        height: 28px;
        border-radius: 999px;
        background: rgba(212,175,55,0.18);
        color: var(--deli-primary);
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 10px;
        flex-shrink: 0;
    }

    .ai-preview-highlight-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .ai-preview-highlight {
        background: rgba(45,79,30,0.08);
        color: var(--deli-primary);
        border-radius: 999px;
        padding: 7px 10px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .ai-preview-note {
        border: 1px solid rgba(45,79,30,0.12);
        border-radius: 18px;
        padding: 14px 16px;
        width: 100%;
        min-height: 96px;
        resize: vertical;
        font-size: 0.94rem;
        outline: none;
    }

    .ai-preview-note:focus {
        border-color: rgba(45,79,30,0.35);
        box-shadow: 0 0 0 4px rgba(45,79,30,0.08);
    }

    .ai-preview-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        flex-wrap: wrap;
    }

    .ai-preview-loading {
        display: none;
        text-align: center;
        padding: 26px 0;
        color: #58624d;
    }

    .ai-preview-loading.is-visible {
        display: block;
    }

    .ai-preview-error {
        display: none;
        margin-bottom: 14px;
    }

    .ai-preview-error.is-visible {
        display: block;
    }

    .recipe-ai-badge {
        display: none;
        margin-top: 14px;
    }

    .recipe-ai-badge.is-visible {
        display: inline-flex;
    }

    @@media (max-width: 576px) {
        .ai-fan-grid {
            grid-template-columns: 1fr;
        }

        .ai-preview-modal .modal-content {
            border-radius: 22px;
            max-height: 92vh;
        }

        .ai-preview-body {
            padding: 18px 16px 18px;
        }
    }
</style>

<div class="min-vh-100 pb-5">

    <div class="hero-container">
        <div class="header-overlay"></div>
        <a href="javascript:history.back()" class="back-btn text-decoration-none">
            <i class="bi bi-chevron-left fs-5"></i>
        </a>

        @if (Model.Images != null && Model.Images.Any())
        {
            <img src="@Model.Images.First().Image" class="hero-image" alt="@Model.Title" />
        }
        else if (ViewData["PostingThumbnailUrl"] is string thumbUrl && !string.IsNullOrWhiteSpace(thumbUrl))
        {
            <img src="@thumbUrl" class="hero-image" alt="@Model.Title" />
        }
        else
        {
            <img src="https://cdn.pixabay.com/photo/2014/12/21/23/28/recipe-575434_640.png" class="hero-image" alt="Recipe" />
        }
    </div>

    <div class="recipe-main-content">
        <div class="drag-handle"></div>

        <div class="title-section text-center">
            <h1 class="display-6 mb-3" id="recipeTitleValue">@Model.Title</h1>

            <div class="badge-row">
                <div class="premium-badge">
                    <i class="bi bi-clock text-warning"></i> @Model.PreparationTime Min.
                </div>
                <div class="premium-badge">
                    <i class="bi bi-fire text-danger"></i>
                    <span id="headerCalories" data-base="@(totalCalories / Model.PersonCount)">@Math.Round(totalCalories / Model.PersonCount)</span> kcal
                </div>
            </div>


            @if (canPublishToFeed)
            {
                <div class="mt-3">
                    @if (existingPostingId.HasValue)
                    {
                        <a class="btn btn-sm btn-outline-primary"
                           href="@Url.Action("EditRecipe", "Home", new { area = "WorldMiniApp", postingId = existingPostingId.Value })">
                            <i class="bi bi-pencil-square me-1"></i> Feed-Posting bearbeiten
                        </a>
                    }
                    else
                    {
                        <form asp-action="PublishRecipeBaseDataToFeed" asp-controller="Home" asp-area="WorldMiniApp" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="recipeBaseDataId" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-primary">
                                <i class="bi bi-broadcast-pin me-1"></i> Als Feed-Posting anlegen
                            </button>
                        </form>
                    }
                </div>
            }
        </div>

        <div class="ai-fan-section">
            <div class="ai-fan-header">
                <div>
                    <div class="ai-fan-kicker">AI Fächer</div>
                    <p class="ai-fan-title">Varianten aus diesem Rezept bauen</p>
                    <p class="ai-fan-sub">Vorschau mit bis zu 2 Änderungswünschen, ohne den Originaleintrag direkt kaputt zu machen.</p>
                </div>
                <span class="premium-badge recipe-ai-badge" id="recipeAiAppliedBadge">
                    <i class="bi bi-stars text-warning"></i> AI-Vorschau aktiv
                </span>
            </div>
            <div class="ai-fan-grid">
                <button type="button" class="ai-fan-btn" onclick="openAiTransformModal('vegan')"><i class="bi bi-flower1"></i> Vegan</button>
                <button type="button" class="ai-fan-btn" onclick="openAiTransformModal('mealprep')"><i class="bi bi-box-seam"></i> Meal Prep</button>
                <button type="button" class="ai-fan-btn" onclick="openAiTransformModal('lowcarb')"><i class="bi bi-lightning-charge"></i> Low Carb</button>
                <button type="button" class="ai-fan-btn" onclick="openAiTransformModal('highprotein')"><i class="bi bi-battery-charging"></i> Mehr Protein</button>
            </div>
        </div>

        <nav class="nav nav-pills-custom" id="recipeTab" role="tablist">
            <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#ingredients" type="button">@T("Einkauf", "Ingredients", "Compra", "Compras")</button>
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#preparation" type="button">@T("Schritte", "Steps", "Pasos", "Passos")</button>
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#nutrition" type="button">@T("Nährwerte", "Nutrition", "Nutrición", "Nutrição")</button>
        </nav>

        <div class="tab-content">

            <div class="tab-pane fade show active" id="ingredients" role="tabpanel">
                <div class="text-center portion-selector-wrapper">
                    <div class="portion-stepper">
                        <span class="me-2 fw-bold text-muted small">@T("Zutaten für", "Servings for", "Personas:", "Pessoas:")</span>
                        <input type="number" id="portionInput" class="fw-bold text-center" value="@Model.PersonCount" min="1" onchange="updatePortions()"
                               style="width: 45px; border:none; background:transparent; color:var(--deli-primary); font-size: 1.1rem;">
                    </div>
                </div>

                <div id="ingredientListContainer">
                    @foreach (var group in Model.Ingredients.GroupBy(i => i.Ingredient.IngredientsAndNutrients.Group?.Name ?? "General"))
                    {
                        <h6 class="text-uppercase fw-bold opacity-50 mb-3 px-4" style="font-size: 0.7rem; letter-spacing: 2px;">@group.Key</h6>
                        @foreach (var item in group)
                        {
                            <div class="ingredient-card shadow-sm" onclick="toggleCheck(this)">
                                <div class="check-box">
                                    <i class="bi bi-check-lg text-white d-none"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold fs-6">@IngredientName(item.Ingredient.IngredientsAndNutrients)</span>
                                        <span class="text-muted small">
                                            <span class="dyn-qty fw-bold text-dark" data-base-qty="@item.Ingredient.Quantity.Quantitys.ToString(CultureInfo.InvariantCulture)">@item.Ingredient.Quantity.Quantitys</span> @item.Ingredient.Measure.Metrics_DE
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="preparation" role="tabpanel">
                <div class="step-container" id="preparationListContainer">
                    @foreach (var step in Model.Steps.OrderBy(s => s.StepIndex))
                    {
                        <div class="step-card">
                            <span class="step-badge">@T("Schritt", "Step", "Paso", "Passo") @step.StepIndex</span>
                            <p class="mb-0 lh-lg" style="font-size: 1.05rem; color: #444;">@StepText(step.RecipePreparationStep)</p>
                        </div>
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="nutrition" role="tabpanel">
                <div class="nutri-grid">
                    <div class="nutri-item nutri-item-main shadow-lg">
                        <span class="nutri-val dyn-nutri" data-base="@totalCalories" style="font-size: 3rem;">@Math.Round(totalCalories)</span>
                        <span class="nutri-label">Gesamt Kcal</span>
                    </div>
                    <div class="nutri-item">
                        <span class="nutri-val dyn-nutri" data-base="@totalProtein">@Math.Round(totalProtein)</span>
                        <span class="nutri-label">@T("Protein (g)", "Protein", "Proteína", "Proteína")</span>
                    </div>
                    <div class="nutri-item">
                        <span class="nutri-val dyn-nutri" data-base="@totalCarbs">@Math.Round(totalCarbs)</span>
                        <span class="nutri-label">@T("Carbs (g)", "Carbs", "Carbo", "Carbo")</span>
                    </div>
                    <div class="nutri-item">
                        <span class="nutri-val dyn-nutri" data-base="@totalFat">@Math.Round(totalFat)</span>
                        <span class="nutri-label">@T("Fett (g)", "Fat", "Grasa", "Gordura")</span>
                    </div>
                    <div class="nutri-item">
                        <span class="nutri-val dyn-nutri" data-base="@totalSugar">@Math.Round(totalSugar, 1)</span>
                        <span class="nutri-label">@T("Zucker (g)", "Sugar", "Azúcar", "Açúcar")</span>
                    </div>
                </div>

                <div class="text-center mt-5 px-4 text-muted small fst-italic">
                    @T("Alle Werte basieren auf Standard-Nährwertangaben.", "Values based on standard estimates.", "Valores estimados.", "Valores estimados.")
                </div>
            </div>

        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<div class="modal fade ai-preview-modal" id="aiTransformModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="ai-preview-head">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <div class="ai-preview-mode" id="aiPreviewModeLabel">AI Vorschau</div>
                        <div class="ai-preview-title" id="aiPreviewTitle">Neue Rezeptidee wird geladen...</div>
                        <p class="ai-preview-summary" id="aiPreviewSummary">Wir bauen gerade eine stimmige Variante aus deinem Rezept.</p>
                    </div>
                    <button type="button" class="btn btn-sm btn-light rounded-pill px-3" data-bs-dismiss="modal">Schließen</button>
                </div>
            </div>
            <div class="ai-preview-body">
                <div class="alert alert-danger ai-preview-error" id="aiPreviewError"></div>

                <div class="ai-preview-loading is-visible" id="aiPreviewLoading">
                    <div class="spinner-border text-success mb-3" role="status"></div>
                    <div>AI transformiert gerade dein Rezept...</div>
                </div>

                <div id="aiPreviewContent" style="display:none;">
                    <div class="ai-preview-meta" id="aiPreviewMeta"></div>

                    <div class="ai-preview-block">
                        <h6>Highlights</h6>
                        <div class="ai-preview-highlight-list" id="aiPreviewHighlights"></div>
                    </div>

                    <div class="ai-preview-block">
                        <h6>Zutaten</h6>
                        <ul class="ai-preview-list" id="aiPreviewIngredients"></ul>
                    </div>

                    <div class="ai-preview-block">
                        <h6>Schritte</h6>
                        <ul class="ai-preview-list" id="aiPreviewSteps"></ul>
                    </div>

                    <div class="ai-preview-block">
                        <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
                            <h6 class="mb-0">Noch feiner anpassen</h6>
                            <span class="small text-muted" id="aiPreviewChangesLeft">Noch 2 Änderungen</span>
                        </div>
                        <textarea class="ai-preview-note" id="aiPreviewUserNote" placeholder="z. B. Ersetze die Beilage durch Kartoffeln"></textarea>
                        <div class="small text-muted mt-2">Maximal 2 Änderungswünsche pro Vorschau. Das hält den Flow schnell und kontrollierbar.</div>
                    </div>

                    <div class="ai-preview-actions">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" id="aiPreviewRegenerateBtn">Änderung anwenden</button>
                        <button type="button" class="btn btn-success rounded-pill px-4" id="aiPreviewApplyBtn">Vorschau übernehmen</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const basePortionCount = @basePortions;
    const recipeId = @Model.Id;
    const originalRecipeState = {
        title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Title)),
        ingredientMarkup: document.getElementById('ingredientListContainer')?.innerHTML || '',
        stepMarkup: document.getElementById('preparationListContainer')?.innerHTML || ''
    };
    const aiPreviewState = {
        variantType: '',
        appliedChangeCount: 0,
        latestUserNote: '',
        preview: null,
        saveInFlight: false
    };

    let aiTransformModalInstance = null;

    function toggleCheck(element) {
        element.classList.toggle('checked');
        const icon = element.querySelector('.bi-check-lg');
        if (icon) icon.classList.toggle('d-none');
    }

    function updatePortions() {
        const input = document.getElementById('portionInput');
        let newCount = parseFloat(input.value);
        if (isNaN(newCount) || newCount < 0.1) newCount = 1;

        const ratio = newCount / basePortionCount;

        // 1. Update Mengen (Zutaten)
        document.querySelectorAll('.dyn-qty').forEach(el => {
            const baseQty = parseFloat(el.getAttribute('data-base-qty').replace(',', '.'));
            if(!isNaN(baseQty)) {
                let newVal = (baseQty * ratio);
                el.innerText = (Math.round(newVal * 100) / 100).toString().replace('.', ',');
            }
        });

        // 2. Update Kcal im Header
        const headerCal = document.getElementById('headerCalories');
        const baseHeaderCal = parseFloat(headerCal.getAttribute('data-base').replace(',', '.'));
        headerCal.innerText = Math.round(baseHeaderCal * (newCount / basePortionCount)).toString();

        // 3. Update Nährwert-Tab
        document.querySelectorAll('.dyn-nutri').forEach(el => {
            const baseNutri = parseFloat(el.getAttribute('data-base').replace(',', '.'));
            if(!isNaN(baseNutri)) {
                el.innerText = Math.round(baseNutri * ratio).toString();
            }
        });
    }

    function getAiTransformModal() {
        if (!aiTransformModalInstance) {
            const modalElement = document.getElementById('aiTransformModal');
            aiTransformModalInstance = new bootstrap.Modal(modalElement);
        }

        return aiTransformModalInstance;
    }

    function openAiTransformModal(variantType) {
        aiPreviewState.variantType = variantType;
        aiPreviewState.appliedChangeCount = 0;
        aiPreviewState.latestUserNote = '';
        aiPreviewState.preview = null;
        aiPreviewState.saveInFlight = false;

        const noteInput = document.getElementById('aiPreviewUserNote');
        if (noteInput) noteInput.value = '';

        getAiTransformModal().show();
        requestAiPreview().catch(error => {
            setAiPreviewError(error.message || 'AI-Vorschau konnte nicht geladen werden.');
        });
    }

    async function requestAiPreview(userNote = '') {
        setAiPreviewLoading(true);
        setAiPreviewError('');

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const response = await fetch('@Url.Action("PreviewAiRecipeVariant", "Home", new { area = "WorldMiniApp" })', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                recipeId,
                variantType: aiPreviewState.variantType,
                userNote,
                appliedChangeCount: aiPreviewState.appliedChangeCount
            })
        });

        const payload = await response.json().catch(() => null);
        if (!response.ok) {
            throw new Error(payload?.message || 'AI-Vorschau konnte nicht geladen werden.');
        }

        if (userNote) {
            aiPreviewState.latestUserNote = userNote;
        }

        aiPreviewState.preview = payload;
        renderAiPreview(payload);
        setAiPreviewLoading(false);
    }

    function setAiPreviewLoading(isLoading) {
        document.getElementById('aiPreviewLoading')?.classList.toggle('is-visible', isLoading);
        const content = document.getElementById('aiPreviewContent');
        if (content) content.style.display = isLoading ? 'none' : '';
    }

    function setAiPreviewError(message) {
        const errorEl = document.getElementById('aiPreviewError');
        if (!errorEl) return;

        errorEl.textContent = message || '';
        errorEl.classList.toggle('is-visible', !!message);
        if (message) {
            setAiPreviewLoading(false);
            const content = document.getElementById('aiPreviewContent');
            if (content) content.style.display = 'none';
        }
    }

    function renderAiPreview(preview) {
        document.getElementById('aiPreviewModeLabel').textContent = preview.variantLabel || 'AI Vorschau';
        document.getElementById('aiPreviewTitle').textContent = preview.title || originalRecipeState.title;
        document.getElementById('aiPreviewSummary').textContent = preview.summary || 'Neue Variante bereit.';

        const meta = [];
        meta.push(`<span class="ai-preview-pill"><i class="bi bi-stars"></i>${escapeHtml(preview.variantLabel || 'AI')}</span>`);
        meta.push(`<span class="ai-preview-pill"><i class="bi bi-arrow-repeat"></i>${preview.remainingChanges} Änderungen übrig</span>`);
        if (preview.userNoteApplied) {
            meta.push('<span class="ai-preview-pill"><i class="bi bi-chat-left-text"></i>User-Wunsch drin</span>');
        }
        if (preview.usedFallback) {
            meta.push('<span class="ai-preview-pill"><i class="bi bi-cpu"></i>Lokaler Fallback</span>');
        }
        document.getElementById('aiPreviewMeta').innerHTML = meta.join('');

        document.getElementById('aiPreviewHighlights').innerHTML = (preview.highlights || [])
            .map(item => `<span class="ai-preview-highlight">${escapeHtml(item)}</span>`)
            .join('');

        document.getElementById('aiPreviewIngredients').innerHTML = (preview.ingredients || [])
            .map(item => `
                <li class="ai-preview-ingredient${item.isModified ? ' is-modified' : ''}">
                    <div class="fw-bold">${escapeHtml(item.name || '')}</div>
                    <div class="small text-muted">${escapeHtml(item.quantity || '')}</div>
                    ${item.changeHint ? `<div class="small mt-1 text-success-emphasis">${escapeHtml(item.changeHint)}</div>` : ''}
                </li>`)
            .join('');

        document.getElementById('aiPreviewSteps').innerHTML = (preview.steps || [])
            .map(item => `
                <li class="ai-preview-step d-flex align-items-start">
                    <span class="ai-preview-step-index">${item.index}</span>
                    <span>${escapeHtml(item.text || '')}</span>
                </li>`)
            .join('');

        const changesText = preview.remainingChanges === 1
            ? 'Noch 1 Änderung'
            : `Noch ${preview.remainingChanges} Änderungen`;
        document.getElementById('aiPreviewChangesLeft').textContent = changesText;
        document.getElementById('aiPreviewRegenerateBtn').disabled = preview.remainingChanges <= 0;
    }

    async function saveAiPreview() {
        if (!aiPreviewState.preview || aiPreviewState.saveInFlight) {
            return;
        }

        aiPreviewState.saveInFlight = true;
        const applyButton = document.getElementById('aiPreviewApplyBtn');
        const originalButtonText = applyButton?.textContent || 'Vorschau übernehmen';
        if (applyButton) {
            applyButton.disabled = true;
            applyButton.textContent = 'Speichert...';
        }

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const response = await fetch('@Url.Action("SaveAiRecipeVariant", "Home", new { area = "WorldMiniApp" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    baseRecipeId: recipeId,
                    latestUserNote: aiPreviewState.latestUserNote || null,
                    preview: aiPreviewState.preview
                })
            });

            const payload = await response.json().catch(() => null);
            if (!response.ok || !payload?.success) {
                throw new Error(payload?.message || 'AI-Variante konnte nicht gespeichert werden.');
            }
        } finally {
            aiPreviewState.saveInFlight = false;
            if (applyButton) {
                applyButton.disabled = false;
                applyButton.textContent = originalButtonText;
            }
        }
    }

    async function applyAiPreviewToPage() {
        if (!aiPreviewState.preview) return;

        await saveAiPreview();

        document.getElementById('recipeTitleValue').textContent = aiPreviewState.preview.title || originalRecipeState.title;
        document.getElementById('ingredientListContainer').innerHTML = (aiPreviewState.preview.ingredients || [])
            .map(item => `
                <div class="ingredient-card shadow-sm">
                    <div class="check-box">${item.isModified ? '<i class="bi bi-stars text-success"></i>' : ''}</div>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold fs-6">${escapeHtml(item.name || '')}</span>
                            <span class="text-muted small">${escapeHtml(item.quantity || '')}</span>
                        </div>
                        ${item.changeHint ? `<div class="small text-success mt-1">${escapeHtml(item.changeHint)}</div>` : ''}
                    </div>
                </div>`)
            .join('');

        document.getElementById('preparationListContainer').innerHTML = (aiPreviewState.preview.steps || [])
            .map(step => `
                <div class="step-card">
                    <span class="step-badge">@T("Schritt", "Step", "Paso", "Passo") ${step.index}</span>
                    <p class="mb-0 lh-lg" style="font-size: 1.05rem; color: #444;">${escapeHtml(step.text || '')}</p>
                </div>`)
            .join('');

        document.getElementById('recipeAiAppliedBadge')?.classList.add('is-visible');
        getAiTransformModal().hide();
    }

    function escapeHtml(value) {
        return (value || '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('\"', '&quot;')
            .replaceAll('\'', '&#39;');
    }

    document.getElementById('aiPreviewRegenerateBtn')?.addEventListener('click', async () => {
        if (!aiPreviewState.preview || aiPreviewState.preview.remainingChanges <= 0) return;

        const noteInput = document.getElementById('aiPreviewUserNote');
        const userNote = (noteInput?.value || '').trim();
        if (!userNote) {
            setAiPreviewError('Schreib kurz, was noch angepasst werden soll.');
            return;
        }

        aiPreviewState.appliedChangeCount += 1;

        try {
            await requestAiPreview(userNote);
            if (noteInput) noteInput.value = '';
        } catch (error) {
            aiPreviewState.appliedChangeCount = Math.max(0, aiPreviewState.appliedChangeCount - 1);
            setAiPreviewError(error.message || 'AI-Änderung konnte nicht angewendet werden.');
        }
    });

    document.getElementById('aiPreviewApplyBtn')?.addEventListener('click', async () => {
        try {
            await applyAiPreviewToPage();
        } catch (error) {
            setAiPreviewError(error.message || 'AI-Variante konnte nicht gespeichert werden.');
        }
    });
</script>
