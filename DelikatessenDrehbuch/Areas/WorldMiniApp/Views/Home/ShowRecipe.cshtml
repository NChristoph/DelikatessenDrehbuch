    window.openAiPreviewFromBar = function openAiPreviewFromBar() {
        // Global bar open button is handled in _MiniAppLayout.cshtml.
        // Fallback: just open the modal on this page.
        getAiTransformModal().show();
        return;

        const bar = document.getElementById('aiBottomBar');
        const state = bar?.dataset.state;

        if (state === 'error') {
            // Retry the stage that actually failed.
            if (aiPreviewState.lastErrorStage === 'suggestions') {
                setAiPreviewError('');
                setAiPreviewLoading(true);
                getAiTransformModal().show();
                showAiBottomBar('suggestions');
                requestAiIngredientSuggestions()
                    .then(() => showAiBottomBar('selection'))
                    .catch(error => {
                        setAiPreviewError(error?.message || 'AI-ZutatenvorschlÃ¤ge konnten nicht geladen werden.');
                        showAiBottomBar('error');
                    });
                return;
            }

            showAiBottomBar('pending');
            requestAiPreviewInBackground().catch(() => {});
            return;
        }

        if (state === 'ready') {
            // Preview already rendered — ensure loading is off and content visible
            setAiPreviewLoading(false);
            const content = document.getElementById('aiPreviewContent');
            if (content) content.style.display = '';
        } else if (state === 'pending' || state === 'suggestions') {
            // Still loading — show spinner inside modal
            setAiPreviewLoading(true);
            const content = document.getElementById('aiPreviewContent');
            if (content) content.style.display = '';
        } else if (state === 'selection') {
            setAiPreviewLoading(false);
            const content = document.getElementById('aiPreviewContent');
            if (content) content.style.display = '';
        }
        getAiTransformModal().show();
    };

