@model DelikatessenDrehbuch.Models.RecipeBaseData
@using System.Globalization
@using Microsoft.AspNetCore.Localization
@using DelikatessenDrehbuch
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> SharedLocalizer

@{
    Layout = "_MiniAppLayout";
    var variantTitle = (ViewData["VariantTitle"] as string ?? string.Empty).Trim();
    var variantSummary = (ViewData["VariantSummary"] as string ?? string.Empty).Trim();
    var displayTitle = string.IsNullOrWhiteSpace(variantTitle) ? Model.Title : variantTitle;

    ViewData["Title"] = displayTitle;

    decimal totalCalories = 0, totalProtein = 0, totalFat = 0, totalCarbs = 0, totalSugar = 0, totalFiber = 0;

    foreach (var item in Model.Ingredients)
    {
        var nutri = item.Ingredient.IngredientsAndNutrients;
        var quantity = (decimal)item.Ingredient.Quantity.Quantitys;
        var unit = item.Ingredient.Measure.Metrics_DE.ToLower();

        decimal factor = (unit == "stk" || unit == "stück")
            ? (quantity * nutri.Weight_per_piece) / 100m
            : quantity / 100m;

        totalCalories += nutri.Calories_a_100g * factor;
        totalProtein += nutri.Protein_a_100g * factor;
        totalFat += nutri.Fat_a_100g * factor;
        totalCarbs += nutri.Carbohydrates_a_100g * factor;
        totalSugar += nutri.Sugar_a_100g * factor;
        totalFiber += nutri.Fiber_a_100g * factor;
    }

    // If this page is rendered with swaps (user/community variant), the controller provides
    // an override computed from SwapsJson + IngredientsAndNutrients DB. Use it for correct macros.
    if (ViewData["NutritionOverride"] is { } nutritionOverride)
    {
        try
        {
            var t = nutritionOverride.GetType();
            totalCalories = (decimal)(t.GetProperty("calories")?.GetValue(nutritionOverride) ?? totalCalories);
            totalProtein = (decimal)(t.GetProperty("protein")?.GetValue(nutritionOverride) ?? totalProtein);
            totalFat = (decimal)(t.GetProperty("fat")?.GetValue(nutritionOverride) ?? totalFat);
            totalCarbs = (decimal)(t.GetProperty("carbs")?.GetValue(nutritionOverride) ?? totalCarbs);
            totalSugar = (decimal)(t.GetProperty("sugar")?.GetValue(nutritionOverride) ?? totalSugar);
            totalFiber = (decimal)(t.GetProperty("fiber")?.GetValue(nutritionOverride) ?? totalFiber);
        }
        catch { }
    }

    var basePortions = Math.Max(1, Model.PersonCount);

    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture ?? CultureInfo.CurrentCulture;
    var language = currentCulture.TwoLetterISOLanguageName;

    string IngredientName(DelikatessenDrehbuch.Models.IngredientsAndNutrients item) => language switch
    {
        "en" => item.Name_EN,
        "es" => item.Name_ESP,
        "pt" => item.Name_PRT,
        "id" => item.Name_ID,
        "nl" => item.Name_NL,
        "sv" => item.Name_SE,
        "da" => item.Name_DK,
        "nb" => item.Name_NO,
        "ms" => item.Name_MS,
        _ => item.Name_DE
    };

    string StepText(DelikatessenDrehbuch.Models.RecipePreparationSteps step) => language switch
    {
        "en" => step.Step_EN,
        "es" => step.Step_ESP,
        "pt" => step.Step_PRT,
        _ => step.Step_DE
    };

    var canPublishToFeed = ViewData["CanPublishToFeed"] as bool? == true;
    var existingPostingId = ViewData["ExistingPostingId"] as int?;
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet">

<style>
    :root {
        --deli-primary: #2D4F1E;
        --deli-gold: #D4AF37;
        --deli-bg: #F8F9F5;
        --deli-dark: #1A1A1A;
        --shadow-sm: 0 4px 12px rgba(0,0,0,0.05);
        --shadow-md: 0 12px 24px rgba(0,0,0,0.08);
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--deli-bg);
        color: var(--deli-dark);
        margin: 0;
        padding: 0;
    }

    h1, h2, .serif-font {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
    }

    .hero-container {
        position: relative;
        height: 50vh;
        min-height: 400px;
        width: 100%;
        overflow: hidden;
    }

    .hero-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .header-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, transparent 30%, rgba(0,0,0,0.6) 100%);
    }

    .back-btn {
        position: absolute;
        top: 50px;
        left: 20px;
        z-index: 100;
        width: 45px;
        height: 45px;
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(10px);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--shadow-md);
        color: var(--deli-dark);
    }

    .recipe-main-content {
        position: relative;
        margin-top: -45px;
        background: var(--deli-bg);
        border-top-left-radius: 40px;
        border-top-right-radius: 40px;
        padding-top: 20px;
        z-index: 20;
        box-shadow: 0 -10px 30px rgba(0,0,0,0.05);
    }

    .drag-handle {
        width: 45px;
        height: 5px;
        background: #D1D1D1;
        border-radius: 10px;
        margin: 0 auto 25px;
    }

    .title-section {
        padding: 0 25px;
        margin-bottom: 30px;
    }

    .badge-row {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .premium-badge {
        background: white;
        padding: 10px 16px;
        border-radius: 18px;
        box-shadow: var(--shadow-sm);
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .nav-pills-custom {
        background: #EEEFEA;
        padding: 6px;
        border-radius: 22px;
        margin: 0 20px 30px;
        display: flex;
    }

    .nav-pills-custom .nav-link {
        flex: 1;
        border-radius: 18px;
        color: #707070;
        font-weight: 700;
        border: none;
        padding: 14px 5px;
        font-size: 0.9rem;
        transition: var(--transition);
        background: transparent;
    }

    .nav-pills-custom .nav-link.active {
        background: white;
        color: var(--deli-primary);
        box-shadow: var(--shadow-sm);
    }

    .portion-selector-wrapper {
        margin-bottom: 25px;
    }

    .portion-stepper {
        background: white;
        border-radius: 100px;
        padding: 10px 24px;
        display: inline-flex;
        align-items: center;
        box-shadow: var(--shadow-sm);
    }

    .ingredient-card {
        background: white;
        margin: 0 20px 12px;
        padding: 18px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        transition: var(--transition);
        cursor: pointer;
    }

    .ingredient-card.checked {
        background: #F1F1F1;
        opacity: 0.5;
        transform: scale(0.98);
    }

    .check-box {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #D7DCD3;
        margin-right: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .ingredient-card.checked .check-box {
        background: var(--deli-primary);
    }

    .step-container {
        padding: 0 20px 20px;
        display: grid;
        gap: 14px;
    }

    .step-card {
        background: white;
        border-radius: 24px;
        padding: 20px;
        box-shadow: var(--shadow-sm);
    }

    .step-badge {
        display: inline-block;
        margin-bottom: 10px;
        padding: 7px 12px;
        border-radius: 999px;
        background: rgba(45,79,30,0.08);
        color: var(--deli-primary);
        font-weight: 700;
        font-size: 0.8rem;
    }

    .nutri-grid {
        padding: 0 20px 20px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .nutri-item {
        background: white;
        border-radius: 24px;
        padding: 22px 16px;
        text-align: center;
        box-shadow: var(--shadow-sm);
    }

    .nutri-item-main {
        grid-column: 1 / -1;
        background: linear-gradient(145deg, #2D4F1E, #426B2E);
        color: white;
    }

    .nutri-val {
        font-size: 1.8rem;
        font-weight: 700;
        display: block;
        margin-bottom: 2px;
    }

    .nutri-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 600;
        opacity: 0.7;
        letter-spacing: 1px;
    }

    @@media (max-width: 768px) {
        .hero-container {
            min-height: 320px;
        }
    }
</style>

<div class="min-vh-100 pb-5">
    <div class="hero-container">
        <div class="header-overlay"></div>
        <a href="#" class="back-btn text-decoration-none" id="backToFeedBtn">
            <i class="bi bi-chevron-left fs-5"></i>
        </a>

        @if (ViewData["SwapsJson"] is string)
        {
            <a href="@Url.Action("ShowRecipe", "Home", new { area = "WorldMiniApp", id = Model.Id, original = true })"
               class="btn btn-sm btn-light shadow-sm"
               style="position: absolute; top: 20px; right: 20px; z-index: 20; border-radius: 20px; font-weight: 600; padding: 8px 16px;">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Original
            </a>
        }

        @if (Model.Images != null && Model.Images.Any())
        {
            <img src="@Model.Images.First().Image" class="hero-image" alt="@displayTitle" />
        }
        else if (ViewData["PostingThumbnailUrl"] is string thumbUrl && !string.IsNullOrWhiteSpace(thumbUrl))
        {
            // Some environments have only the full thumbnail (no *_thumb_small.webp) or CDN propagation delays.
            // Provide fallbacks to keep the hero image from breaking.
            var fallbackThumb1 = thumbUrl.Replace("_thumb_small.webp", "_thumb.webp").Replace(" ", "%20");
            var fallbackThumb2 = fallbackThumb1.Replace(
                "https://DelekatesenDrehbuchCdn-beecexhdaghhacab.z01.azurefd.net/",
                "https://blobdelikatessendrehbuch.blob.core.windows.net/");

            <img src="@thumbUrl"
                 class="hero-image"
                 alt="@Model.Title"
                 data-fallback-1="@fallbackThumb1"
                 data-fallback-2="@fallbackThumb2"
                 onerror="(function(img){ if(!img) return; const f1=img.dataset.fallback1||''; const f2=img.dataset.fallback2||''; const cur=img.getAttribute('src')||''; if(f1 && cur!==f1){ img.onerror=null; img.src=f1; img.onerror=function(){ if(f2 && img.src!==f2){ img.onerror=null; img.src=f2; } }; } })(this);" />
        }
        else
        {
            <div class="hero-image d-flex align-items-center justify-content-center" style="background: linear-gradient(145deg, #d9dfd3, #eef2e9);">
                <i class="bi bi-image text-muted" style="font-size: 4rem;"></i>
            </div>
        }
    </div>

    <div class="recipe-main-content">
        <div class="drag-handle"></div>

        <div class="title-section text-center">
            <h1 class="display-6 mb-3" id="recipeDisplayTitle">@displayTitle</h1>
            <!-- Summary/description is meant for variant cards (discovery), not for the main ShowRecipe header. -->

            @{
                var communityCount = ViewData["CommunityVariantCount"] as int? ?? 0;
            }
            @if (communityCount > 0)
            {
                <div class="mb-2 d-flex justify-content-center gap-2 flex-wrap">
                    <button type="button"
                            class="btn btn-sm btn-outline-dark px-3 py-2 shadow-sm"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#communityVariantsCanvas"
                            aria-controls="communityVariantsCanvas"
                            style="border-radius: 999px; font-weight: 800;">
                        <i class="bi bi-layers me-1"></i> Varianten (@communityCount)
                    </button>
                </div>
            }

            @if (ViewData["SwapsJson"] is string)
            {
                <div class="mb-3">
                    <a href="@Url.Action("ShowRecipe", "Home", new { area = "WorldMiniApp", id = Model.Id, original = true })"
                       class="btn btn-dark btn-sm px-3 py-2 shadow-sm"
                       style="border-radius: 999px; font-weight: 700;">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Originalrezept anzeigen
                    </a>
                </div>
            }

            @if (ViewData["SwapVariantId"] is int swapVariantId && swapVariantId > 0)
            {
                <div class="mb-3 d-flex justify-content-center gap-2 flex-wrap">
                    <button type="button"
                            class="btn btn-sm btn-success px-3 py-2 shadow-sm"
                            id="publishCommunityVariantBtn"
                            data-recipe-id="@Model.Id"
                            data-swap-variant-id="@swapVariantId"
                            data-parent-community-variant-id="@(ViewData["CommunityVariantId"] as int? ?? 0)"
                            style="border-radius: 999px; font-weight: 800;">
                        <i class="bi bi-check2-circle me-1"></i> Akzeptieren &amp; als Variante speichern
                    </button>
                </div>
            }

            <div class="badge-row mb-3">
                @if (ViewData["SwapsJson"] is string swapsJsonBadge)
                {
                    var swapCount = 0;
                    try
                    {
                        var swaps = System.Text.Json.JsonSerializer.Deserialize<List<DelikatessenDrehbuch.Models.IngredientSwap>>(swapsJsonBadge);
                        swapCount = swaps?.Count ?? 0;
                    }
                    catch { }

                    if (swapCount > 0)
                    {
                        <div class="premium-badge" style="background: linear-gradient(135deg, #28a745, #20c997); color: white; font-weight: 700;">
                            <i class="bi bi-arrow-left-right"></i> @swapCount Angepasst
                        </div>
                    }
                }
                <div class="premium-badge">
                    <i class="bi bi-people text-primary"></i> @Model.PersonCount
                </div>
                <div class="premium-badge">
                    <i class="bi bi-clock text-warning"></i> @Model.PreparationTime Min.
                </div>
                <div class="premium-badge">
                    <i class="bi bi-fire text-danger"></i>
                    <span id="headerCalories" data-base="@((totalCalories / basePortions).ToString(CultureInfo.InvariantCulture))">@Math.Round(totalCalories / basePortions)</span> kcal
                </div>
            </div>

            @if (canPublishToFeed)
            {
                <div class="mt-3">
                    @if (existingPostingId.HasValue)
                    {
                        <a class="btn btn-sm btn-outline-primary"
                           href="@Url.Action("EditRecipe", "Home", new { area = "WorldMiniApp", postingId = existingPostingId.Value })">
                            <i class="bi bi-pencil-square me-1"></i> Feed-Posting bearbeiten
                        </a>
                    }
                    else
                    {
                        <form asp-action="PublishRecipeBaseDataToFeed" asp-controller="Home" asp-area="WorldMiniApp" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="recipeBaseDataId" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-primary">
                                <i class="bi bi-broadcast-pin me-1"></i> Als Feed-Posting anlegen
                            </button>
                        </form>
                    }
                </div>
            }
        </div>

        <nav class="nav nav-pills-custom" id="recipeTab" role="tablist">
            <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#ingredients" type="button">@SharedLocalizer["Recipe.Ingredients"]</button>
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#preparation" type="button">@SharedLocalizer["Recipe.Steps"]</button>
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#nutrition" type="button">@SharedLocalizer["Recipe.Nutrition"]</button>
        </nav>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="ingredients" role="tabpanel">
                <div class="text-center portion-selector-wrapper">
                    <div class="portion-stepper">
                        <span class="me-2 fw-bold text-muted small">@SharedLocalizer["Recipe.ServingsFor"]</span>
                        <input type="number"
                               id="portionInput"
                               class="fw-bold text-center"
                               value="@basePortions"
                               min="1"
                               onchange="updatePortions()"
                               style="width:45px; border:none; background:transparent; color:var(--deli-primary); font-size:1.1rem;">
                    </div>
                </div>

                <div id="ingredientListContainer">
                    @foreach (var group in Model.Ingredients.GroupBy(i => i.Ingredient.IngredientsAndNutrients.Group?.Name ?? "General"))
                    {
                        <h6 class="text-uppercase fw-bold opacity-50 mb-3 px-4" style="font-size:0.7rem; letter-spacing:2px;">@group.Key</h6>
                        @foreach (var item in group)
                        {
                            <div class="ingredient-card shadow-sm" data-ingredient-id="@item.Ingredient.IngredientsAndNutrients.Id">
                                <div class="check-box" onclick="toggleCheck(this.parentElement)" style="cursor: pointer;">
                                    <i class="bi bi-check-lg text-white d-none"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="ingredient-name fw-bold fs-6">@IngredientName(item.Ingredient.IngredientsAndNutrients)</span>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-muted small ingredient-quantity">
                                                <span class="dyn-qty fw-bold text-dark" data-base-qty="@item.Ingredient.Quantity.Quantitys.ToString(CultureInfo.InvariantCulture)">@item.Ingredient.Quantity.Quantitys</span> <span class="ingredient-unit">@item.Ingredient.Measure.Metrics_DE</span>
                                            </span>
                                            <button class="btn btn-sm btn-outline-primary swap-btn"
                                                    data-swap-ingredient="@item.Ingredient.IngredientsAndNutrients.Id"
                                                    data-recipe-id="@Model.Id"
                                                    data-ingredient-name="@IngredientName(item.Ingredient.IngredientsAndNutrients)"
                                                    title="@SharedLocalizer["Recipe.SwapIngredient"]"
                                                    style="padding: 4px 10px; font-size: 0.75rem; border-radius: 12px;">
                                                <i class="bi bi-arrow-left-right"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div id="swapBatchBar" class="px-4 pb-3" style="display:none;"></div>
            </div>

            <div class="tab-pane fade" id="preparation" role="tabpanel">
                <div class="step-container" id="preparationListContainer">
                    @foreach (var step in Model.Steps.OrderBy(s => s.StepIndex))
                    {
                        <div class="step-card">
                            <span class="step-badge">@SharedLocalizer["Recipe.Step"] @step.StepIndex</span>
                            <p class="mb-0 lh-lg" style="font-size:1.05rem; color:#444;">@StepText(step.RecipePreparationStep)</p>
                        </div>
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="nutrition" role="tabpanel">
                <div class="nutri-grid">
                    <div class="nutri-item nutri-item-main shadow-lg">
                        <span class="nutri-val dyn-nutri" data-base="@totalCalories.ToString(CultureInfo.InvariantCulture)" style="font-size:3rem;">@Math.Round(totalCalories)</span>
                        <span class="nutri-label">Gesamt Kcal</span>
                    </div>
                    <div class="nutri-item">
                        <span class="nutri-val dyn-nutri" data-base="@totalProtein.ToString(CultureInfo.InvariantCulture)">@Math.Round(totalProtein)</span>
                        <span class="nutri-label">@SharedLocalizer["Recipe.Protein"]</span>
                    </div>
                    <div class="nutri-item">
                        <span class="nutri-val dyn-nutri" data-base="@totalCarbs.ToString(CultureInfo.InvariantCulture)">@Math.Round(totalCarbs)</span>
                        <span class="nutri-label">@SharedLocalizer["Recipe.Carbs"]</span>
                    </div>
                    <div class="nutri-item">
                        <span class="nutri-val dyn-nutri" data-base="@totalFat.ToString(CultureInfo.InvariantCulture)">@Math.Round(totalFat)</span>
                        <span class="nutri-label">@SharedLocalizer["Recipe.Fat"]</span>
                    </div>
                    <div class="nutri-item">
                        <span class="nutri-val dyn-nutri" data-base="@totalSugar.ToString(CultureInfo.InvariantCulture)">@Math.Round(totalSugar, 1)</span>
                        <span class="nutri-label">@SharedLocalizer["Recipe.Sugar"]</span>
                    </div>
                </div>

                <div class="text-center mt-5 px-4 text-muted small fst-italic">
                    @SharedLocalizer["Recipe.NutritionDisclaimer"]
                </div>
            </div>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-bottom" tabindex="-1" id="communityVariantsCanvas" aria-labelledby="communityVariantsCanvasLabel" style="height: 75vh; border-top-left-radius: 18px; border-top-right-radius: 18px;">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="communityVariantsCanvasLabel" style="font-weight:900;">Varianten entdecken</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="d-flex gap-2 align-items-center mb-3 flex-wrap">
            <input id="variantSearchInput" class="form-control" placeholder="Suchen (Titel oder Beschreibung)..." style="max-width: 420px; border-radius: 14px;" />
            <div class="btn-group" role="group" aria-label="Sortierung">
                <button type="button" class="btn btn-outline-secondary active" id="variantSortNewBtn">Neu</button>
                <button type="button" class="btn btn-outline-secondary" id="variantSortTopBtn">Top</button>
            </div>
            <span class="text-muted small" id="variantResultMeta"></span>
        </div>

        <div id="variantList" class="variant-card-grid"></div>

        <div id="variantListEmpty" class="text-center text-muted py-5" style="display:none;">
            Keine Varianten gefunden.
        </div>
    </div>
</div>

<script src="~/js/ingredient-swap.js"></script>

<style>
    .variant-card-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; max-width: 760px; margin: 0 auto; }
    @@media (max-width: 576px) { .variant-card-grid { grid-template-columns: 1fr; } }

    /* Important for CSS-grid: allow items to shrink instead of overflowing the container */
    .variant-card-grid > a { min-width: 0; }

    .variant-card {
        border-radius: 16px;
        border: 1px solid rgba(0,0,0,0.06);
        background: #fff;
        box-shadow: 0 10px 26px rgba(0,0,0,0.06);
        overflow: hidden;
        transition: transform 140ms ease, box-shadow 140ms ease;
        width: 100%;
        min-width: 0;
    }
    .variant-card:hover { transform: translateY(-1px); box-shadow: 0 14px 34px rgba(0,0,0,0.10); }

    .variant-card__body { padding: 14px 14px 12px; }
    .variant-card__header { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .variant-card__titleWrap { min-width: 0; flex: 1 1 auto; }
    .variant-card__title {
        font-weight: 950;
        color: #0f172a;
        line-height: 1.15;
        font-size: 1.02rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
    }
    .variant-card__summary {
        margin-top: 8px;
        color: rgba(15, 23, 42, 0.66);
        font-size: 0.92rem;
        line-height: 1.25;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 3.45em;
    }
    .variant-card__meta {
        margin-top: 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        color: rgba(15, 23, 42, 0.55);
        font-size: 0.82rem;
        flex-wrap: wrap;
    }
    .variant-badges { display: flex; gap: 8px; flex-wrap: wrap; }
    .variant-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        font-weight: 900;
        border: 1px solid rgba(0,0,0,0.06);
        background: rgba(255,255,255,0.96);
        max-width: 100%;
    }
    .variant-badge--lang { background: rgba(0,0,0,0.03); }
    .variant-badge--like { background: rgba(231, 76, 60, 0.10); border-color: rgba(231, 76, 60, 0.22); color: #b83a2c; }
    .variant-badge--swap { background: rgba(52, 152, 219, 0.10); border-color: rgba(52, 152, 219, 0.22); color: #1b5e8a; }
    .variant-badge--time { background: rgba(46, 204, 113, 0.10); border-color: rgba(46, 204, 113, 0.22); color: #1b7f45; }
</style>

<script>
    // Shared helper (some sections are conditionally rendered).
    // Keep it on window so any handler can use it safely.
    window.escapeHtml = window.escapeHtml || function (text) {
        const div = document.createElement('div');
        div.textContent = text == null ? '' : String(text);
        return div.innerHTML;
    };

    const basePortionCount = @basePortions;

    function toggleCheck(element) {
        element.classList.toggle('checked');
        const icon = element.querySelector('.bi-check-lg');
        if (icon) icon.classList.toggle('d-none');
    }

    function updatePortions() {
        const input = document.getElementById('portionInput');
        let newCount = parseFloat(input.value);
        if (isNaN(newCount) || newCount < 0.1) newCount = 1;

        const ratio = newCount / basePortionCount;

        document.querySelectorAll('.dyn-qty').forEach(el => {
            const baseQty = parseFloat(el.getAttribute('data-base-qty').replace(',', '.'));
            if (!isNaN(baseQty)) {
                const newVal = baseQty * ratio;
                el.innerText = (Math.round(newVal * 100) / 100).toString().replace('.', ',');
            }
        });

        const headerCal = document.getElementById('headerCalories');
        const baseHeaderCal = parseFloat(headerCal.getAttribute('data-base').replace(',', '.'));
        headerCal.innerText = Math.round(baseHeaderCal * (newCount / basePortionCount)).toString();

        document.querySelectorAll('.dyn-nutri').forEach(el => {
            const baseNutri = parseFloat(el.getAttribute('data-base').replace(',', '.'));
            if (!isNaN(baseNutri)) {
                el.innerText = Math.round(baseNutri * ratio).toString();
            }
        });
    }

    (function bindBackToFeedRestore() {
        const FEED_STATE_KEY = 'worldminiapp.feed.state.v1';
        const FEED_RESTORE_FLAG_KEY = 'worldminiapp.feed.restore.v1';
        const btn = document.getElementById('backToFeedBtn');
        if (!btn) return;

        const currentRecipeId = Number(@Model.Id) || 0;

        function buildReferrerReturnUrl() {
            try {
                const ref = (document.referrer || '').toString();
                if (!ref || !ref.includes('/WorldMiniApp/Feed')) return null;
                const u = new URL(ref);
                if (currentRecipeId) u.searchParams.set('scrollToId', String(currentRecipeId));
                return u.pathname + u.search;
            } catch {
                return null;
            }
        }

        function tryMarkRestoreFlagIfCameFromFeed() {
            try {
                const raw = sessionStorage.getItem(FEED_STATE_KEY);
                const state = raw ? JSON.parse(raw) : null;
                const returnUrl = (state?.returnUrl || '').toString();
                if (returnUrl && returnUrl.includes('/WorldMiniApp/Feed')) {
                    sessionStorage.setItem(FEED_RESTORE_FLAG_KEY, '1');
                    return returnUrl;
                }
            } catch {
            }
            const referrerUrl = buildReferrerReturnUrl();
            if (referrerUrl) {
                sessionStorage.setItem(FEED_RESTORE_FLAG_KEY, '1');
                return referrerUrl;
            }
            return null;
        }

        btn.addEventListener('click', (event) => {
            event.preventDefault();

            try {
                const returnUrl = tryMarkRestoreFlagIfCameFromFeed();
                if (returnUrl) {
                    window.location.href = returnUrl;
                    return;
                }
            } catch {
            }

            history.back();
        });

        // Also handle OS/browser back gestures (Android back, swipe back, browser back button):
        // mark restore flag when leaving this page, but only if we actually came from the feed.
        window.addEventListener('pagehide', () => {
            tryMarkRestoreFlagIfCameFromFeed();
        });
    })();

    // Apply ingredient swaps if variant loaded
    @if (ViewData["SwapsJson"] is string swapsJson)
    {
        <text>
        document.addEventListener('DOMContentLoaded', function() {
            try {
                const swapsJsonString = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(swapsJson));
                const swaps = JSON.parse(swapsJsonString);

                if (!swaps || !Array.isArray(swaps) || swaps.length === 0) {
                    return;
                }

                const escapeRegExp = (value) => String(value || '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                const applyIngredientSwapMarkup = (text, fromName, toName) => {
                    if (!text || !fromName || !toName) return text;

                    const re = new RegExp(escapeRegExp(fromName), 'g');
                    return String(text).replace(re,
                        `<span style="text-decoration: line-through; opacity: 0.55;">${fromName}</span> → <span style="color: #28a745; font-weight: 700;">${toName}</span>`
                    );
                };

                const stepParagraphs = Array.from(document.querySelectorAll('#preparationListContainer .step-card p'));
                const preparationContainer = document.getElementById('preparationListContainer');
                const stepLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["Recipe.Step"].Value));

                const escapeHtml = (text) => {
                    const div = document.createElement('div');
                    div.textContent = text == null ? '' : String(text);
                    return div.innerHTML;
                };

                const getSwapVariantId = () => {
                    try {
                        const u = new URL(window.location.href);
                        const raw = u.searchParams.get('swapVariantId');
                        const id = raw ? parseInt(raw, 10) : NaN;
                        return Number.isFinite(id) ? id : null;
                    } catch {
                        return null;
                    }
                };

                const showInlineStepLoader = (text) => {
                    if (!preparationContainer) return;
                    let el = document.getElementById('swapStepAiLoader');
                    if (!el) {
                        el = document.createElement('div');
                        el.id = 'swapStepAiLoader';
                        el.className = 'd-flex align-items-center gap-2 py-2 px-3 mb-3 rounded border bg-white small';
                        el.style.boxShadow = '0 6px 18px rgba(0,0,0,0.06)';
                        preparationContainer.parentElement?.insertBefore(el, preparationContainer);
                    }

                    // Dim existing steps so the user sees "something is happening" without hiding content.
                    preparationContainer.style.opacity = '0.55';

                    el.innerHTML = `
                        <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
                        <span><strong>AI:</strong> ${escapeHtml(text)}</span>
                    `;
                };

                const hideInlineStepLoader = () => {
                    const el = document.getElementById('swapStepAiLoader');
                    if (el) el.remove();
                    if (preparationContainer) {
                        preparationContainer.style.opacity = '1';
                    }
                };

                swaps.forEach(swap => {
                    const card = document.querySelector(`[data-ingredient-id="${swap.FromIngredientId}"]`);
                    if (!card) {
                        return;
                    }

                    const nameEl = card.querySelector('.ingredient-name');
                    const qtyEl = card.querySelector('.dyn-qty');
                    const unitEl = card.querySelector('.ingredient-unit');
                    const swapBtn = card.querySelector('.swap-btn');

                    if (nameEl) {
                        // Strike through old name and add new name in green
                        nameEl.innerHTML = `<span style="text-decoration: line-through; opacity: 0.5;">${swap.FromName}</span> → <span style="color: #28a745; font-weight: 700;">${swap.ToName}</span>`;
                    }

                    if (qtyEl && swap.NewQuantity) {
                        qtyEl.textContent = swap.NewQuantity;
                        qtyEl.style.color = '#28a745';
                    }

                    if (unitEl && swap.Unit) {
                        unitEl.textContent = swap.Unit;
                    }

                    // Add badge
                    card.style.borderLeft = '4px solid #28a745';
                    card.style.background = 'linear-gradient(to right, rgba(40, 167, 69, 0.05), white)';

                    // Hide swap button for already swapped ingredients
                    if (swapBtn) {
                        swapBtn.style.display = 'none';
                    }

                    // Apply swap to preparation steps (text only; we keep it robust and lightweight)
                    if (swap.FromName && swap.ToName && stepParagraphs.length > 0) {
                        stepParagraphs.forEach(p => {
                            const originalText = p.getAttribute('data-original-step') || p.textContent || '';
                            if (!p.getAttribute('data-original-step')) {
                                p.setAttribute('data-original-step', originalText);
                            }

                            const nextHtml = applyIngredientSwapMarkup(originalText, swap.FromName, swap.ToName);
                            if (nextHtml !== originalText) {
                                p.innerHTML = nextHtml;
                            }
                        });
                    }
                });

                // After the lightweight text-markup swap, ask the AI to rewrite steps properly
                // (technique + times + order), so protein swaps don't stay "word replaced" only.
                if (swaps.length > 0 && preparationContainer) {
                    const payload = {
                        recipeId: @Model.Id,
                        swapVariantId: getSwapVariantId(),
                        language: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(language))
                    };

                    showInlineStepLoader('Zubereitung wird an die getauschten Zutaten angepasst...');
                    fetch('/api/recipe-swap/rewrite-steps', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    })
                    .then(r => r.ok ? r.json() : r.text().then(t => Promise.reject(new Error(t || `HTTP ${r.status}`))))
                    .then(data => {
                        const steps = (data && Array.isArray(data.steps)) ? data.steps : [];
                        if (!steps || steps.length === 0) {
                            hideInlineStepLoader();
                            return;
                        }

                        preparationContainer.innerHTML = steps.map((s, idx) => `
                            <div class="step-card">
                                <span class="step-badge">${escapeHtml(stepLabel)} ${idx + 1}</span>
                                <p class="mb-0 lh-lg" style="font-size:1.05rem; color:#444;">${escapeHtml(s)}</p>
                            </div>
                        `).join('');

                        hideInlineStepLoader();

                        // Separate call: ask AI for a good title/summary after steps are updated.
                        // (No fallback: if it fails, we simply keep the current title/summary.)
                        try {
                            const publishBtn = document.getElementById('publishCommunityVariantBtn');
                            if (publishBtn) {
                                publishBtn.disabled = true;
                                publishBtn.dataset.metaStatus = 'loading';
                            }
                            fetch('/api/recipe-swap/generate-meta', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    recipeId: @Model.Id,
                                    swapVariantId: getSwapVariantId(),
                                    language: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(language))
                                })
                            })
                            .then(async r => {
                                const body = await r.json().catch(() => null);
                                if (!r.ok) {
                                    console.warn('generate-meta failed:', r.status, body);
                                    return null;
                                }
                                return body;
                            })
                            .then(meta => {
                                if (!meta) {
                                    if (publishBtn) {
                                        publishBtn.disabled = false;
                                        publishBtn.dataset.metaStatus = 'failed';
                                    }
                                    return;
                                }
                                const t = (meta.title || '').toString().trim();
                                const s = (meta.summary || '').toString().trim();
                                if (t) {
                                    const h = document.getElementById('recipeDisplayTitle');
                                    if (h) h.textContent = t;
                                    window.__swapVariantMeta = window.__swapVariantMeta || {};
                                    window.__swapVariantMeta.title = t;
                                }
                                if (s) {
                                    window.__swapVariantMeta = window.__swapVariantMeta || {};
                                    window.__swapVariantMeta.summary = s;
                                }
                                if (publishBtn) {
                                    publishBtn.disabled = !(t && s);
                                    publishBtn.dataset.metaStatus = (t && s) ? 'ready' : 'failed';
                                }
                            })
                            .catch(() => {
                                if (publishBtn) {
                                    publishBtn.disabled = false;
                                    publishBtn.dataset.metaStatus = 'failed';
                                }
                            });
                        } catch { }
                    })
                    .catch(err => {
                        console.error('AI step rewrite failed:', err);
                        // Show a short message (no spinner) then restore
                        if (preparationContainer) {
                            preparationContainer.style.opacity = '1';
                        }
                        const el = document.getElementById('swapStepAiLoader');
                        if (el) {
                            el.innerHTML = `<span class="text-muted"><strong>AI:</strong> Konnte Steps nicht automatisch anpassen (Fallback aktiv).</span>`;
                        } else {
                            showInlineStepLoader('Konnte Steps nicht automatisch anpassen (Fallback aktiv).');
                        }
                        setTimeout(hideInlineStepLoader, 3500);
                    });
                }

            } catch (err) {
                console.error('Failed to apply swaps:', err);
            }
        });
        </text>
    }

    // Publish current user swap-variant as a shared community variant
    document.addEventListener('DOMContentLoaded', function () {
        const btn = document.getElementById('publishCommunityVariantBtn');
        if (!btn) return;

        btn.addEventListener('click', async function () {
            // Require AI meta to be ready. We don't want to store fallback titles like "... (Variante)".
            const metaReady = (window.__swapVariantMeta && window.__swapVariantMeta.title && window.__swapVariantMeta.summary);
            if (!metaReady) {
                alert('Bitte kurz warten: Titel/Beschreibung werden noch generiert.');
                return;
            }
            const recipeId = parseInt(btn.getAttribute('data-recipe-id') || '0', 10);
            const swapVariantId = parseInt(btn.getAttribute('data-swap-variant-id') || '0', 10);
            const parentRaw = parseInt(btn.getAttribute('data-parent-community-variant-id') || '0', 10);
            const parentCommunityVariantId = Number.isFinite(parentRaw) && parentRaw > 0 ? parentRaw : null;

            if (!Number.isFinite(recipeId) || recipeId <= 0 || !Number.isFinite(swapVariantId) || swapVariantId <= 0) {
                return;
            }

            btn.disabled = true;
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Speichern...';

            try {
                const res = await fetch('/api/recipe-swap/publish', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        recipeId,
                        swapVariantId,
                        parentCommunityVariantId,
                        title: (window.__swapVariantMeta && window.__swapVariantMeta.title) ? window.__swapVariantMeta.title : null,
                        summary: (window.__swapVariantMeta && window.__swapVariantMeta.summary) ? window.__swapVariantMeta.summary : null,
                        language: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(language))
                    })
                });

                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data?.success || !data?.communityVariant?.id) {
                    throw new Error(data?.error || `HTTP ${res.status}`);
                }

                // Require title + summary before allowing a save redirect.
                const t = (data?.communityVariant?.title || '').toString().trim();
                const s = (data?.communityVariant?.summary || '').toString().trim();
                if (!t || !s) {
                    throw new Error('Variante hat keinen Titel/Beschreibung (AI). Bitte erneut versuchen.');
                }

                const id = data.communityVariant.id;
                window.location.href = `/WorldMiniApp/Home/ShowRecipe?id=${recipeId}&communityVariantId=${id}`;
            } catch (e) {
                console.error(e);
                btn.disabled = false;
                btn.innerHTML = originalHtml;
                alert('Konnte Variante nicht speichern. Bitte erneut versuchen.');
            }
        });
    });

    // Community variants browser (search + sort)
    document.addEventListener('DOMContentLoaded', function () {
        const listEl = document.getElementById('variantList');
        const emptyEl = document.getElementById('variantListEmpty');
        const qEl = document.getElementById('variantSearchInput');
        const metaEl = document.getElementById('variantResultMeta');
        const sortNewBtn = document.getElementById('variantSortNewBtn');
        const sortTopBtn = document.getElementById('variantSortTopBtn');

        if (!listEl || !qEl || !metaEl || !sortNewBtn || !sortTopBtn) return;

        const escapeHtml = (text) => {
            const div = document.createElement('div');
            div.textContent = text == null ? '' : String(text);
            return div.innerHTML;
        };

        let currentSort = 'new';
        let debounce = null;

        function setSort(next) {
            currentSort = next;
            sortNewBtn.classList.toggle('active', next === 'new');
            sortTopBtn.classList.toggle('active', next === 'top');
            load();
        }

        sortNewBtn.addEventListener('click', () => setSort('new'));
        sortTopBtn.addEventListener('click', () => setSort('top'));

        qEl.addEventListener('input', () => {
            if (debounce) clearTimeout(debounce);
            debounce = setTimeout(load, 220);
        });

        async function load() {
            const q = (qEl.value || '').trim();
            metaEl.textContent = 'Lade...';
            listEl.innerHTML = '';
            emptyEl.style.display = 'none';

            try {
                const url = `/api/recipe-swap/community-variants?recipeId=@Model.Id&lang=${encodeURIComponent(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(language)))}&sort=${encodeURIComponent(currentSort)}&q=${encodeURIComponent(q)}`;
                const res = await fetch(url, { method: 'GET' });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data?.error || `HTTP ${res.status}`);

                const items = Array.isArray(data?.items) ? data.items : [];
                const total = Number.isFinite(data?.total) ? data.total : items.length;
                metaEl.textContent = `${items.length}/${total}`;

                if (!items.length) {
                    emptyEl.style.display = 'block';
                    return;
                }

                listEl.innerHTML = items.map(i => {
                    const title = escapeHtml(i.title || '');
                    const summary = escapeHtml(i.summary || '');
                    const lang = escapeHtml(i.language || '');
                    const like = Number.isFinite(i.likeCount) ? i.likeCount : 0;
                    const swapCount = Number.isFinite(i.swapCount) ? i.swapCount : 0;
                    const prep = Number.isFinite(i.preparationTime) ? i.preparationTime : 0;

                    return `
                        <a class="text-decoration-none" href="/WorldMiniApp/Home/ShowRecipe?id=@Model.Id&communityVariantId=${i.id}">
                            <div class="variant-card">
                                <div class="variant-card__body">
                                    <div class="variant-card__header">
                                        <div class="variant-card__titleWrap">
                                            <div class="variant-card__title">${title}</div>
                                        </div>
                                        ${lang ? `<span class="variant-badge variant-badge--lang">${lang.toUpperCase()}</span>` : ''}
                                    </div>

                                    ${summary ? `<div class="variant-card__summary">${summary}</div>` : `<div class="variant-card__summary">Variante ohne Beschreibung.</div>`}

                                    <div class="variant-card__meta">
                                        <div class="variant-badges">
                                            <span class="variant-badge variant-badge--like"><i class="bi bi-heart-fill"></i> ${like}</span>
                                            <span class="variant-badge variant-badge--swap"><i class="bi bi-arrow-left-right"></i> ${swapCount}</span>
                                            ${prep > 0 ? `<span class="variant-badge variant-badge--time"><i class="bi bi-clock"></i> ${prep} min</span>` : ''}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    `;
                }).join('');
            } catch (e) {
                console.error(e);
                metaEl.textContent = 'Fehler';
            }
        }

        // Lazy-load when the offcanvas is opened the first time
        let loadedOnce = false;
        const canvas = document.getElementById('communityVariantsCanvas');
        if (canvas) {
            canvas.addEventListener('shown.bs.offcanvas', () => {
                if (loadedOnce) return;
                loadedOnce = true;
                load();
            });
        }
    });
</script>
