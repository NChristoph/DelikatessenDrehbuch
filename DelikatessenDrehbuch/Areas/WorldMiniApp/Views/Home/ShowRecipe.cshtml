    async function requestAiPreviewInBackground(userNote = '') {
        if (aiPreviewState.previewInFlight) {
            return;
        }

        aiPreviewState.previewInFlight = true;
        aiPreviewState.lastErrorStage = null;
        setGlobalAiResume(AI_RESUME_STAGE.preview);
        const requestId = ++aiPreviewState.previewRequestId;
        const sessionId = aiPreviewState.modalSessionId;
        aiPreviewState.previewAbortController?.abort();
        aiPreviewState.previewAbortController = new AbortController();
        updateAiConfirmButtonState();

        try {
            const payload = await fetchGeneratedVariant(userNote);
            if (requestId !== aiPreviewState.previewRequestId || sessionId !== aiPreviewState.modalSessionId) {
                return;
            }
            renderAiPreview(payload);
            setAiPreviewLoading(false);
            aiPreviewState.preview = payload;
            if (userNote) aiPreviewState.latestUserNote = userNote;
            showAiBottomBar('ready');
            setGlobalAiResume(AI_RESUME_STAGE.ready, payload?.title || '');

            // If the user closed the modal while the request was running, show a toast when ready.
            const modalVisible = document.getElementById('aiTransformModal')?.classList.contains('show') === true;
            if (!modalVisible) {
                window.WorldMiniAppAiResume?.toast?.('AI Vorschau ist fertig. Tippe unten auf „Öffnen“.');
            }
        } catch (error) {
            if (error?.name === 'AbortError') {
                return;
            }
            console.warn('AI background preview failed:', error);
            aiPreviewState.lastErrorStage = 'preview';
            setAiPreviewLoading(false);
            setAiPreviewError(error?.message || 'AI-Variante konnte nicht generiert werden.');
            showAiBottomBar('error');
            setGlobalAiResume(AI_RESUME_STAGE.error);
        } finally {
            if (requestId === aiPreviewState.previewRequestId) {
                aiPreviewState.previewInFlight = false;
                aiPreviewState.previewAbortController = null;
                updateAiConfirmButtonState();
            }
        }
    }

