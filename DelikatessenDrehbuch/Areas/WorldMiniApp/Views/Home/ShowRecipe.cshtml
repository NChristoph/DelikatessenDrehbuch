<script>
    const basePortionCount = @basePortions;
    let savedAiVariants = @Html.Raw(savedAiVariantsJson);
    const autoApplyAiVariantId = @(autoApplyAiVariantId.HasValue ? autoApplyAiVariantId.Value.ToString(CultureInfo.InvariantCulture) : "null");
    const recipeId = @Model.Id;
    // Expose for the global AI resume bar (layout) so it can open the modal directly on this page.
    window.recipeId = recipeId;
    const originalRecipeState = {
        title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Title)),
        ingredientMarkup: document.getElementById('ingredientListContainer')?.innerHTML || '',
        stepMarkup: document.getElementById('preparationListContainer')?.innerHTML || '',
        nutrition: @Html.Raw(originalNutritionJson)
    };
    const aiPreviewState = {
        variantType: '',
        aiProvider: 'openai',
        appliedChangeCount: 0,
        latestUserNote: '',
        lastErrorStage: null, // 'suggestions' | 'preview' | null
        suggestionResponse: null,
        suggestions: [],
        selectedConcept: null,
        selectedIngredientIds: [],
        preview: null,
        jobId: null,
        saveInFlight: false,
        suggestionInFlight: false,
        previewInFlight: false,
        suggestionRequestId: 0,
        previewRequestId: 0,
        modalSessionId: 0,
        suggestionAbortController: null,
        previewAbortController: null,
        suppressResumeBarOnce: false
    };

    let aiTransformModalInstance = null;

    const AI_RESUME_STAGE = {
        queued: 'queued',
        running: 'running',
        ready: 'ready',
        error: 'error'
    };

    function setGlobalAiResume(stage, titleOverride = '') {
        const api = window.WorldMiniAppAiResume;
        if (!api?.setState) return;
        api.setState({
            recipeId,
            variantType: aiPreviewState.variantType || '',
            aiProvider: aiPreviewState.aiProvider || 'openai',
            stage,
            jobId: aiPreviewState.jobId || null,
            title: titleOverride || aiPreviewState.preview?.title || originalRecipeState.title || ''
        });
    }

    function clearGlobalAiResume() {
        window.WorldMiniAppAiResume?.clearState?.();
    }

    function toggleCheck(element) {
        element.classList.toggle('checked');
        const icon = element.querySelector('.bi-check-lg');
        if (icon) icon.classList.toggle('d-none');
    }

    function setAiDebugStamp(message) {
        const el = document.getElementById('aiDebugStamp');
        if (!el) return;
        const now = new Date();
        const ts = now.toLocaleTimeString('de-AT', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        el.textContent = message ? `[${ts}] ${message}` : '';
    }

    function getPayloadBool(payload, camelKey, pascalKey) {
        if (!payload) return false;
        if (payload[camelKey] === true || payload[pascalKey] === true) return true;
        return false;
    }

    async function readJsonOrText(response) {
        const text = await response.text().catch(() => '');
        if (!text) return { rawText: '' };
        try {
            return JSON.parse(text);
        } catch {
            return { rawText: text };
        }
    }

    function updatePortions() {
        const input = document.getElementById('portionInput');
        let newCount = parseFloat(input.value);
        if (isNaN(newCount) || newCount < 0.1) newCount = 1;

        const ratio = newCount / basePortionCount;

        // 1. Update Mengen (Zutaten)
        document.querySelectorAll('.dyn-qty').forEach(el => {
            const baseQty = parseFloat(el.getAttribute('data-base-qty').replace(',', '.'));
            if(!isNaN(baseQty)) {
                let newVal = (baseQty * ratio);
                el.innerText = (Math.round(newVal * 100) / 100).toString().replace('.', ',');
            }
        });

        // 2. Update Kcal im Header
        const headerCal = document.getElementById('headerCalories');
        const baseHeaderCal = parseFloat(headerCal.getAttribute('data-base').replace(',', '.'));
        headerCal.innerText = Math.round(baseHeaderCal * (newCount / basePortionCount)).toString();

        // 3. Update Nährwert-Tab
        document.querySelectorAll('.dyn-nutri').forEach(el => {
            const baseNutri = parseFloat(el.getAttribute('data-base').replace(',', '.'));
            if(!isNaN(baseNutri)) {
                el.innerText = Math.round(baseNutri * ratio).toString();
            }
        });
    }

    function formatScaledQuantity(value) {
        if (!Number.isFinite(value)) return '';
        const rounded = Math.round(value * 100) / 100;
        return rounded.toString().replace('.', ',');
    }

    function parseAiQuantityParts(quantityText) {
        const text = (quantityText || '').trim();
        if (!text) {
            return null;
        }

        const fractionMatch = text.match(/^(\d+)\s*\/\s*(\d+)(.*)$/);
        if (fractionMatch) {
            const numerator = Number(fractionMatch[1]);
            const denominator = Number(fractionMatch[2]);
            if (denominator) {
                return {
                    numericValue: numerator / denominator,
                    suffix: (fractionMatch[3] || '').trim()
                };
            }
        }

        const decimalMatch = text.match(/^(\d+(?:[.,]\d+)?)(.*)$/);
        if (decimalMatch) {
            const numericValue = Number((decimalMatch[1] || '').replace(',', '.'));
            if (Number.isFinite(numericValue)) {
                return {
                    numericValue,
                    suffix: (decimalMatch[2] || '').trim()
                };
            }
        }

        return null;
    }

    function buildAiIngredientMarkup(item) {
        const quantityText = (item?.quantity || '').toString().trim();
        const displayQuantity = formatIngredientQuantity(item);
        const quantityParts = parseAiQuantityParts(quantityText);
        let quantityMarkup = escapeHtml(displayQuantity);

        if (quantityParts && displayQuantity) {
            const suffixText = displayQuantity.startsWith(quantityText)
                ? displayQuantity.slice(quantityText.length).trim()
                : quantityParts.suffix;
            const suffixMarkup = suffixText ? ` ${escapeHtml(suffixText)}` : '';
            quantityMarkup = `<span class="dyn-qty fw-bold text-dark" data-base-qty="${quantityParts.numericValue.toString().replace(',', '.')}">${formatScaledQuantity(quantityParts.numericValue)}</span>${suffixMarkup}`;
        }

        return `
            <div class="ingredient-card shadow-sm">
                <div class="check-box">${item.isModified ? '<i class="bi bi-stars text-success"></i>' : ''}</div>
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-6">${escapeHtml(item.name || '')}</span>
                        <span class="text-muted small">${quantityMarkup}</span>
                    </div>
                    ${renderChangeHint(item.changeHint, 'small text-success mt-1')}
                </div>
            </div>`;
    }

    function setNutritionBases(nutrition) {
        const source = nutrition || originalRecipeState.nutrition;
        const headerCal = document.getElementById('headerCalories');
        if (headerCal) {
            const perPersonCalories = basePortionCount > 0
                ? (Number(source.calories || 0) / basePortionCount)
                : Number(source.calories || 0);
            headerCal.setAttribute('data-base', perPersonCalories.toString().replace(',', '.'));
        }

        const nutritionValues = [
            Number(source.calories || 0),
            Number(source.protein || 0),
            Number(source.carbs || 0),
            Number(source.fat || 0),
            Number(source.sugar || 0)
        ];

        document.querySelectorAll('.dyn-nutri').forEach((el, index) => {
            const nextValue = nutritionValues[index] || 0;
            el.setAttribute('data-base', nextValue.toString().replace(',', '.'));
        });
    }

    window.renderSavedAiVariantButtons = function renderSavedAiVariantButtons() {
        const container = document.getElementById('savedAiVariantList');
        if (!container) return;

        if (!Array.isArray(savedAiVariants) || !savedAiVariants.length) {
            container.innerHTML = '';
            return;
        }

        container.innerHTML = savedAiVariants.map((item, index) => {
            const label = escapeHtml(item.variantLabel || item.variantType || 'AI');
            const provider = 'GPT';
            const ownerHint = item.isOwnedByCurrentUser ? 'Meine Version' : 'Gespeichert';
            const title = escapeHtml(item.title || 'Gespeicherte Variante');
            return `
                <button type="button" class="ai-fan-btn text-start" onclick="applySavedAiVariant(${index})">
                    <div class="fw-bold">${label}</div>
                    <div class="small opacity-75">${escapeHtml(provider)} · ${escapeHtml(ownerHint)}</div>
                    <div class="small opacity-75">${title}</div>
                </button>`;
        }).join('');
    };

    function upsertSavedAiVariant(preview, saveResult) {
        if (!preview) return;

        const variantId = saveResult?.variantId || 0;
        const variantType = preview.variantType || aiPreviewState.variantType || '';
        const aiProvider = preview.aiProvider || aiPreviewState.aiProvider || 'openai';
        const selectedIngredientKey = preview.selectedIngredientKey || '';

        const item = {
            variantId,
            variantType,
            variantLabel: preview.variantLabel || variantType || 'AI',
            aiProvider,
            title: preview.title || originalRecipeState.title,
            summary: preview.summary || '',
            selectedIngredientKey,
            updatedAtUtc: new Date().toISOString(),
            isOwnedByCurrentUser: true,
            preview
        };

        savedAiVariants = (Array.isArray(savedAiVariants) ? savedAiVariants : [])
            .filter(existing => {
                if (variantId && existing.variantId === variantId) {
                    return false;
                }

                return !(
                    (existing.variantType || '') === variantType &&
                    (existing.aiProvider || 'openai') === aiProvider &&
                    (existing.selectedIngredientKey || '') === selectedIngredientKey &&
                    !!existing.isOwnedByCurrentUser
                );
            });

        savedAiVariants.unshift(item);
        savedAiVariants = savedAiVariants.slice(0, 12);
        renderSavedAiVariantButtons();
    }

    function getAiTransformModal() {
        if (!aiTransformModalInstance) {
            const modalElement = document.getElementById('aiTransformModal');
            aiTransformModalInstance = new bootstrap.Modal(modalElement);
        }

        return aiTransformModalInstance;
    }

    window.openAiTransformModal = function openAiTransformModal(variantType, aiProvider = 'openai') {
        aiPreviewState.modalSessionId += 1;
        aiPreviewState.variantType = variantType;
        aiPreviewState.aiProvider = aiProvider || 'openai';
        aiPreviewState.appliedChangeCount = 0;
        aiPreviewState.latestUserNote = '';
        aiPreviewState.suggestionResponse = null;
        aiPreviewState.suggestions = [];
        aiPreviewState.selectedConcept = null;
        aiPreviewState.selectedIngredientIds = [];
        aiPreviewState.preview = null;
        aiPreviewState.saveInFlight = false;
        aiPreviewState.suggestionInFlight = false;
        aiPreviewState.previewInFlight = false;
        aiPreviewState.suggestionAbortController?.abort();
        aiPreviewState.previewAbortController?.abort();
        aiPreviewState.suggestionAbortController = null;
        aiPreviewState.previewAbortController = null;
        setAiDebugStamp(`openAiTransformModal(${variantType})`);

        const noteInput = document.getElementById('aiPreviewUserNote');
        if (noteInput) noteInput.value = '';

        document.getElementById('aiPreviewModeLabel').textContent = 'OpenAI Vorschau';
        document.getElementById('aiPreviewTitle').textContent = 'Rezeptideen werden gesucht...';
        document.getElementById('aiPreviewSummary').textContent = 'Wähle gleich eine Richtung aus. Erst danach baut die AI das fertige Rezept.';
        setAiConceptBlockVisible(true);
        renderAiIngredientSuggestions(null);
        setAiPreviewDetailsVisible(false);
        getAiTransformModal().show();
        requestAiIngredientSuggestions().catch(error => {
            setAiPreviewError(error.message || 'AI-Zutatenvorschläge konnten nicht geladen werden.');
            setAiDebugStamp(`suggestions error: ${error && error.message ? error.message : error}`);
        });
    };

    function hasAiResumeState() {
        const errorVisible = document.getElementById('aiPreviewError')?.classList.contains('is-visible') === true;
        return aiPreviewState.suggestionInFlight
            || aiPreviewState.previewInFlight
            || !!aiPreviewState.preview
            || !!aiPreviewState.suggestionResponse
            || errorVisible
            || (aiPreviewState.selectedIngredientIds?.length || 0) > 0;
    }

    function syncAiBottomBarForCurrentState() {
        if (!hasAiResumeState()) {
            hideAiBottomBar();
            return;
        }

        if (aiPreviewState.previewInFlight) {
            showAiBottomBar('pending');
            return;
        }

        if (aiPreviewState.suggestionInFlight) {
            showAiBottomBar('suggestions');
            return;
        }

        const errorVisible = document.getElementById('aiPreviewError')?.classList.contains('is-visible') === true;
        if (errorVisible && !aiPreviewState.preview) {
            showAiBottomBar('error');
            return;
        }

        if (aiPreviewState.preview) {
            showAiBottomBar('ready');
            return;
        }

        showAiBottomBar('selection');
    }

    async function requestAiIngredientSuggestions() {
        if (aiPreviewState.suggestionInFlight) {
            return;
        }

        aiPreviewState.suggestionInFlight = true;
        aiPreviewState.lastErrorStage = null;
        setGlobalAiResume(AI_RESUME_STAGE.suggestions);
        const requestId = ++aiPreviewState.suggestionRequestId;
        const sessionId = aiPreviewState.modalSessionId;
        setAiDebugStamp(`suggestions fetch start (req=${requestId})`);
        aiPreviewState.suggestionAbortController?.abort();
        aiPreviewState.suggestionAbortController = new AbortController();
        setAiPreviewLoading(true);
        setAiPreviewError('');

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const response = await fetch('@Url.Action("SuggestAiVariantIngredients", "Home", new { area = "WorldMiniApp" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                signal: aiPreviewState.suggestionAbortController.signal,
                body: JSON.stringify({
                    recipeId,
                    variantType: aiPreviewState.variantType,
                    aiProvider: aiPreviewState.aiProvider,
                    userNote: aiPreviewState.latestUserNote || null
                })
            });

            const payload = await readJsonOrText(response);
            setAiDebugStamp(`suggestions fetch done (req=${requestId}, http=${response.status})`);
            if (!response.ok) {
                const msg = payload?.message || payload?.title || payload?.rawText || 'AI-Zutatenvorschläge konnten nicht geladen werden.';
                throw new Error(msg);
            }

            // If the backend had to fall back, treat this as an error in the UI (debug).
            // We want a clear message instead of silently showing default concepts.
            if ((payload?.usedFallback === true) || (payload?.UsedFallback === true)) {
                throw new Error(payload?.message || 'AI ist gerade nicht verfÃ¼gbar (lokaler Fallback). Bitte erneut versuchen.');
            }

            if (requestId !== aiPreviewState.suggestionRequestId || sessionId !== aiPreviewState.modalSessionId) {
                return;
            }

            aiPreviewState.suggestionResponse = payload;
            aiPreviewState.suggestions = payload?.suggestions || [];
            aiPreviewState.selectedConcept = null;
            aiPreviewState.selectedIngredientIds = [];
            aiPreviewState.preview = null;
            renderAiIngredientSuggestions(payload);
            setAiPreviewDetailsVisible(false);
            setAiPreviewLoading(false);
            setGlobalAiResume(AI_RESUME_STAGE.selection);
        } catch (error) {
            if (error?.name === 'AbortError') {
                return;
            }

            aiPreviewState.lastErrorStage = 'suggestions';
            // Clear potentially stale data so we don't render old concepts after errors.
            aiPreviewState.suggestionResponse = null;
            aiPreviewState.suggestions = [];
            aiPreviewState.selectedConcept = null;
            aiPreviewState.selectedIngredientIds = [];
            aiPreviewState.preview = null;
            setAiDebugStamp(`suggestions failed (req=${requestId}): ${error && error.message ? error.message : error}`);
            setGlobalAiResume(AI_RESUME_STAGE.error);
            throw error;
        } finally {
            if (requestId === aiPreviewState.suggestionRequestId) {
                aiPreviewState.suggestionInFlight = false;
                aiPreviewState.suggestionAbortController = null;
            }
        }
    }

