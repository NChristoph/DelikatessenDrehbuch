    // --- Bottom-Bar Functions ---
    function showAiBottomBar(state) {
        // Use only the global resume bar (layout). Keep local bar hidden to avoid duplicates.
        // For any in-flight UI state we show "running" globally.
        if (state === 'ready') setGlobalAiResume(AI_RESUME_STAGE.ready, aiPreviewState.preview?.title || '');
        else if (state === 'error') setGlobalAiResume(AI_RESUME_STAGE.error);
        else setGlobalAiResume(AI_RESUME_STAGE.running);
        return;

        const bar = document.getElementById('aiBottomBar');
        const status = document.getElementById('aiBottomBarStatus');
        const openBtn = document.getElementById('aiBottomBarOpenBtn');
        if (!bar || !status) return;

        if (state === 'pending') {
            status.innerHTML = '<span class="spinner-border spinner-border-sm text-light"></span><span>AI transformiert...</span>';
            if (openBtn) openBtn.textContent = 'Vorschau öffnen';
        } else if (state === 'suggestions') {
            status.innerHTML = '<span class="spinner-border spinner-border-sm text-light"></span><span>AI sucht Zutaten...</span>';
            if (openBtn) openBtn.textContent = 'Auswahl öffnen';
        } else if (state === 'selection') {
            status.innerHTML = '<i class="bi bi-list-check"></i><span>AI-Auswahl wartet auf dich</span>';
            if (openBtn) openBtn.textContent = 'Auswahl öffnen';
        } else if (state === 'ready') {
            status.innerHTML = '<i class="bi bi-check-circle-fill"></i><span>AI-Vorschau bereit</span>';
            if (openBtn) openBtn.textContent = 'Vorschau öffnen';
        } else if (state === 'error') {
            status.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i><span>AI fehlgeschlagen</span>';
            if (openBtn) openBtn.textContent = 'Erneut versuchen';
        }

        bar.dataset.state = state;
        bar.style.display = '';
        // Re-trigger slide-up animation
        bar.style.animation = 'none';
        bar.offsetHeight; // reflow
        bar.style.animation = '';

        // Mirror into the global resume bar (layout), so users can reopen even after closing the modal.
        if (state === 'pending') setGlobalAiResume(AI_RESUME_STAGE.pending);
        else if (state === 'suggestions') setGlobalAiResume(AI_RESUME_STAGE.suggestions);
        else if (state === 'selection') setGlobalAiResume(AI_RESUME_STAGE.selection);
        else if (state === 'ready') setGlobalAiResume(AI_RESUME_STAGE.ready, aiPreviewState.preview?.title || '');
        else if (state === 'error') setGlobalAiResume(AI_RESUME_STAGE.error);
    }

