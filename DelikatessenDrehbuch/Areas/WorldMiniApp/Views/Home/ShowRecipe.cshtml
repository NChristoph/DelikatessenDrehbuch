    async function requestAiPreview(userNote = '') {
        if (!aiPreviewState.selectedConcept) {
            throw new Error('Wähle zuerst eine Rezeptidee aus.');
        }

        setAiPreviewLoading(true, true);
        setAiPreviewError('');

        const payload = await fetchGeneratedVariant(userNote);
        renderAiPreview(payload);
        setAiPreviewLoading(false);
        aiPreviewState.preview = payload;

        if (userNote) {
            aiPreviewState.latestUserNote = userNote;
        }
