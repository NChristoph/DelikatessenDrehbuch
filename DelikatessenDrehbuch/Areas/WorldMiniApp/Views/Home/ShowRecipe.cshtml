@model DelikatessenDrehbuch.Models.RecipeBaseData
@using System.Globalization
@using Microsoft.AspNetCore.Localization
@using DelikatessenDrehbuch
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> SharedLocalizer

@{
    Layout = "_MiniAppLayout";
    var variantTitle = (ViewData["VariantTitle"] as string ?? string.Empty).Trim();
    var variantSummary = (ViewData["VariantSummary"] as string ?? string.Empty).Trim();
    var displayTitle = string.IsNullOrWhiteSpace(variantTitle) ? Model.Title : variantTitle;

    ViewData["Title"] = displayTitle;

    decimal totalCalories = 0, totalProtein = 0, totalFat = 0, totalCarbs = 0, totalSugar = 0, totalFiber = 0;

    foreach (var item in Model.Ingredients)
    {
        var nutri = item.Ingredient.IngredientsAndNutrients;
        var quantity = (decimal)item.Ingredient.Quantity.Quantitys;
        var unit = item.Ingredient.Measure.Metrics_DE.ToLower();

        decimal factor = (unit == "stk" || unit == "stück")
            ? (quantity * nutri.Weight_per_piece) / 100m
            : quantity / 100m;

        totalCalories += nutri.Calories_a_100g * factor;
        totalProtein += nutri.Protein_a_100g * factor;
        totalFat += nutri.Fat_a_100g * factor;
        totalCarbs += nutri.Carbohydrates_a_100g * factor;
        totalSugar += nutri.Sugar_a_100g * factor;
        totalFiber += nutri.Fiber_a_100g * factor;
    }

    // If this page is rendered with swaps (user/community variant), the controller provides
    // an override computed from SwapsJson + IngredientsAndNutrients DB. Use it for correct macros.
    if (ViewData["NutritionOverride"] is { } nutritionOverride)
    {
        try
        {
            var t = nutritionOverride.GetType();
            totalCalories = (decimal)(t.GetProperty("calories")?.GetValue(nutritionOverride) ?? totalCalories);
            totalProtein = (decimal)(t.GetProperty("protein")?.GetValue(nutritionOverride) ?? totalProtein);
            totalFat = (decimal)(t.GetProperty("fat")?.GetValue(nutritionOverride) ?? totalFat);
            totalCarbs = (decimal)(t.GetProperty("carbs")?.GetValue(nutritionOverride) ?? totalCarbs);
            totalSugar = (decimal)(t.GetProperty("sugar")?.GetValue(nutritionOverride) ?? totalSugar);
            totalFiber = (decimal)(t.GetProperty("fiber")?.GetValue(nutritionOverride) ?? totalFiber);
        }
        catch { }
    }

    var basePortions = Math.Max(1, Model.PersonCount);

    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture ?? CultureInfo.CurrentCulture;
    var language = currentCulture.TwoLetterISOLanguageName;

    string T(string de, string en, string es, string pt) => language switch
    {
        "en" => en,
        "es" => es,
        "pt" => pt,
        _ => de
    };

    string IngredientName(DelikatessenDrehbuch.Models.IngredientsAndNutrients item) => language switch
    {
        "en" => item.Name_EN,
        "es" => item.Name_ESP,
        "pt" => item.Name_PRT,
        "id" => item.Name_ID,
        "nl" => item.Name_NL,
        "sv" => item.Name_SE,
        "da" => item.Name_DK,
        "nb" => item.Name_NO,
        "ms" => item.Name_MS,
        _ => item.Name_DE
    };

    string IngredientIcon(DelikatessenDrehbuch.Models.IngredientsAndNutrients item)
    {
        if (!string.IsNullOrWhiteSpace(item.Icon))
        {
            return item.Icon.Trim();
        }

        var source = $"{item.Name_DE} {item.Name_EN} {item.Name_ESP} {item.Name_PRT}".ToLowerInvariant();
        if (source.Contains("garlic") || source.Contains("knoblauch")) return "🧄";
        if (source.Contains("onion") || source.Contains("zwiebel")) return "🧅";
        if (source.Contains("carrot") || source.Contains("karotte")) return "🥕";
        if (source.Contains("tomat")) return "🍅";
        if (source.Contains("potato") || source.Contains("kartoff")) return "🥔";
        if (source.Contains("broccoli")) return "🥦";
        if (source.Contains("paprika") || source.Contains("pepper")) return "🫑";
        if (source.Contains("salat") || source.Contains("lettuce")) return "🥬";
        if (source.Contains("pork") || source.Contains("schwein")) return "🥩";
        if (source.Contains("beef") || source.Contains("rind")) return "🍖";
        if (source.Contains("chicken") || source.Contains("huhn")) return "🍗";
        if (source.Contains("fish") || source.Contains("lachs") || source.Contains("salmon")) return "🐟";
        if (source.Contains("egg") || source.Contains("ei")) return "🥚";
        if (source.Contains("milk") || source.Contains("milch")) return "🥛";
        if (source.Contains("cheese") || source.Contains("käse") || source.Contains("kaese")) return "🧀";
        if (source.Contains("rice") || source.Contains("reis")) return "🍚";
        if (source.Contains("pasta") || source.Contains("nudel")) return "🍝";
        if (source.Contains("bread") || source.Contains("brot")) return "🍞";
        if (source.Contains("honey") || source.Contains("honig")) return "🍯";
        if (source.Contains("beer") || source.Contains("bier")) return "🍺";
        return "🥘";
    }

    List<string> GetTranslatedSteps()
    {
        if (ViewData["TranslatedSteps"] is string stepsText && !string.IsNullOrWhiteSpace(stepsText))
        {
            return stepsText
                .Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(line => line.Trim())
                .Where(line => !string.IsNullOrWhiteSpace(line))
                .ToList();
        }
        return new List<string>();
    }

    var canPublishToFeed = ViewData["CanPublishToFeed"] as bool? == true;
    var existingPostingId = ViewData["ExistingPostingId"] as int?;
    var communityCount = ViewData["CommunityVariantCount"] as int? ?? 0;
    var isSwapVariant = ViewData["SwapsJson"] is string;

    // Übersetze Kategorie über .resx Dateien
    string TranslateCategory(string category)
    {
        if (string.IsNullOrWhiteSpace(category)) return SharedLocalizer["Category.Rezept"];

        var key = category.ToLowerInvariant() switch
        {
            "hauptspeise" or "hauptgericht" => "Category.Hauptspeise",
            "vorspeise" => "Category.Vorspeise",
            "dessert" or "nachtisch" or "nachspeise" => "Category.Dessert",
            "frühstück" or "fruehstueck" => "Category.Fruehstueck",
            "snack" => "Category.Snack",
            "getränk" or "getränke" or "getraenk" => "Category.Getraenk",
            "salat" => "Category.Salat",
            "suppe" => "Category.Suppe",
            "beilage" => "Category.Beilage",
            _ => null
        };

        return key != null ? SharedLocalizer[key] : category;
    }

    var categoryLabel = TranslateCategory(Model.Category);
    var recipeModeLabel = isSwapVariant ? SharedLocalizer["Category.Variante"] : SharedLocalizer["Category.Original"];
    var creatorName = (ViewData["PostingCreatorName"] as string ?? string.Empty).Trim();
    if (string.IsNullOrWhiteSpace(creatorName))
    {
        creatorName = T("Delikatessen Drehbuch", "Delikatessen Drehbuch", "Delikatessen Drehbuch", "Delikatessen Drehbuch");
    }
    var authorInitial = creatorName.FirstOrDefault(char.IsLetter);
    if (authorInitial == default)
    {
        authorInitial = 'D';
    }
}

<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --bg-cream: #f5efe1;
        --card: #ffffff;
        --ink-deep: #14391f;
        --ink-deep-2: #0e2415;
        --ink-mute: #6b7868;
        --ink-mute-2: #9aa295;
        --ink-line: rgba(20,57,31,0.12);
        --avocado: #5fa052;
        --avocado-soft: rgba(95,160,82,0.14);
        --coral: #ff7849;
        --orange: #ff9a3c;
        --ing-tile: #ede7d4;
        --shadow-sm: 0 2px 8px rgba(20,57,31,0.06);
        --shadow-md: 0 4px 12px rgba(20,57,31,0.10);
        --shadow-lg: 0 12px 30px rgba(20,57,31,0.18);
        --shadow-float: 0 2px 10px rgba(0,0,0,0.15);
        --transition: all 0.2s ease;
    }

    body {
        font-family: 'Inter', sans-serif;
        background: var(--bg-cream);
        color: var(--ink-deep);
        margin: 0;
        padding: 0;
    }

    .recipe-detail-page {
        min-height: 100vh;
        background: var(--bg-cream);
        padding-bottom: 126px;
    }

    .hero-container {
        position: relative;
        height: 320px;
        width: 100%;
        overflow: hidden;
    }

    .hero-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .header-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(0,0,0,0.18) 0%, rgba(0,0,0,0) 35%, rgba(0,0,0,0) 60%, #f5efe1 100%);
    }

    .hero-top-controls {
        position: absolute;
        top: 12px;
        left: 14px;
        right: 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        z-index: 5;
    }

    .hero-right-controls {
        display: flex;
        gap: 8px;
    }

    .back-btn {
        width: 38px;
        height: 38px;
        background: rgba(255,255,255,0.92);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--shadow-float);
        color: var(--ink-deep);
        border: none;
    }

    .hero-icon-btn {
        background: rgba(255,255,255,0.92);
        box-shadow: var(--shadow-float);
        border: none;
        color: var(--ink-deep);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
    }

    .hero-icon-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .author-tag {
        position: absolute;
        left: 18px;
        bottom: 60px;
        z-index: 4;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(20,57,31,0.55);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        padding: 5px 5px 5px 5px;
        border-radius: 999px;
        color: white;
        font-size: 11px;
        font-weight: 600;
    }

    .author-monogram {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--orange), var(--coral));
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
    }

    .recipe-main-content {
        position: relative;
        margin-top: -28px;
        background: var(--bg-cream);
        border-top-left-radius: 28px;
        border-top-right-radius: 28px;
        padding: 14px 18px 0;
        z-index: 3;
    }

    .drag-handle {
        width: 38px;
        height: 4px;
        background: rgba(20,57,31,0.18);
        border-radius: 999px;
        margin: 0 auto 14px;
    }

    .title-section {
        margin-bottom: 14px;
    }

    .eyebrow-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 8px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-mute);
    }

    .eyebrow-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--avocado);
    }

    .recipe-title {
        font-family: 'Fraunces', serif;
        font-size: 26px;
        font-weight: 600;
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: var(--ink-deep);
        margin: 0;
        text-wrap: pretty;
    }

    .top-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 14px;
    }

    .top-pill-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 14px;
        border-radius: 999px;
        border: 1.5px solid rgba(20,57,31,0.18);
        background: transparent;
        color: var(--ink-deep);
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        box-shadow: none;
    }

    .badge-row {
        display: flex;
        gap: 8px;
        margin-top: 14px;
        flex-wrap: wrap;
    }

    .premium-badge {
        background: white;
        padding: 8px 14px;
        border-radius: 999px;
        box-shadow: var(--shadow-sm);
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1px solid rgba(20,57,31,0.06);
    }

    .premium-badge i {
        font-size: 0.95rem;
    }

    .premium-badge .badge-value {
        font-family: 'Fraunces', serif;
        font-size: 15px;
        font-weight: 600;
        color: var(--ink-deep);
        letter-spacing: -0.01em;
    }

    .premium-badge .badge-unit {
        font-size: 12px;
        font-weight: 500;
        color: var(--ink-mute);
    }

    .nav-pills-custom {
        background: rgba(20,57,31,0.06);
        padding: 4px;
        border-radius: 999px;
        margin: 14px 0 18px;
        display: flex;
        gap: 2px;
    }

    .nav-pills-custom .nav-link {
        flex: 1;
        border-radius: 999px;
        color: var(--ink-mute);
        font-weight: 600;
        border: none;
        padding: 10px 6px;
        font-size: 13px;
        transition: var(--transition);
        background: transparent;
    }

    .nav-pills-custom .nav-link.active {
        background: white;
        color: var(--ink-deep);
        box-shadow: var(--shadow-sm);
    }

    .portion-selector-wrapper {
        display: flex;
        justify-content: center;
        margin-bottom: 14px;
    }

    .portion-stepper {
        background: white;
        border-radius: 100px;
        padding: 4px 6px 4px 16px;
        display: inline-flex;
        align-items: center;
        box-shadow: var(--shadow-sm);
        gap: 12px;
    }

    .portion-stepper-label {
        font-size: 13px;
        color: var(--ink-mute);
        font-weight: 500;
    }

    .portion-step-btn {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 700;
        line-height: 1;
    }

    .portion-step-btn.minus {
        background: white;
        border: 1px solid var(--ink-line);
        color: var(--ink-deep);
    }

    .portion-step-btn.plus {
        background: var(--ink-deep);
        border: none;
        color: white;
    }

    .portion-input {
        width: 28px;
        min-width: 28px;
        border: none;
        background: transparent;
        color: var(--ink-deep);
        font-family: 'Fraunces', serif;
        font-size: 18px;
        font-weight: 700;
        text-align: center;
        padding: 0;
    }

    .portion-input:focus {
        outline: none;
    }

    .ingredient-group-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-mute-2);
        padding: 0 4px 8px;
        margin: 14px 0 0;
    }

    .ingredient-card {
        background: white;
        margin: 0 0 6px;
        padding: 12px 14px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        transition: var(--transition);
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(20,57,31,0.05);
    }

    .ingredient-card.checked {
        background: #F1F1F1;
        opacity: 0.5;
        transform: scale(0.98);
    }

    .check-box {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: var(--ing-tile);
        margin-right: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: none;
        color: var(--ink-deep);
        font-size: 1.1rem;
    }

    .ingredient-card.checked .check-box {
        background: var(--ink-deep);
        color: white;
    }

    .ingredient-name {
        font-size: 14px;
        font-weight: 700;
        line-height: 1.2;
        color: var(--ink-deep);
    }

    .ingredient-quantity {
        font-family: 'Fraunces', serif;
        font-size: 16px;
        font-weight: 600;
        color: var(--ink-deep);
        white-space: nowrap;
    }

    .ingredient-unit {
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 500;
        color: var(--ink-mute);
        margin-left: 2px;
    }

    .swap-btn {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: white;
        border: 1px solid var(--ink-line);
        color: var(--ink-deep);
    }

    .step-container {
        padding: 0 0 8px;
        display: grid;
        gap: 10px;
    }

    .step-card {
        background: white;
        border-radius: 18px;
        padding: 14px 16px 16px;
        box-shadow: 0 2px 8px rgba(20,57,31,0.05);
    }

    .step-badge {
        display: inline-block;
        margin-bottom: 10px;
        padding: 4px 11px;
        border-radius: 999px;
        background: var(--avocado-soft);
        color: var(--ink-deep);
        font-family: 'Fraunces', serif;
        font-weight: 700;
        font-size: 11px;
    }

    .nutri-grid {
        padding: 0 0 8px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .nutri-item {
        background: white;
        border-radius: 18px;
        padding: 20px 14px 16px;
        box-shadow: 0 2px 8px rgba(20,57,31,0.05);
    }

    .nutri-item-main {
        grid-column: 1 / -1;
        background: linear-gradient(135deg, #1a3a23, #0e2415);
        color: white;
        border-radius: 22px;
        padding: 24px 18px 20px;
        box-shadow: var(--shadow-lg);
    }

    .nutri-val {
        font-family: 'Fraunces', serif;
        font-size: 38px;
        font-weight: 700;
        display: block;
        margin-bottom: 2px;
        line-height: 1;
        letter-spacing: -0.02em;
        color: var(--ink-deep);
        text-align: center;
    }

    .nutri-label {
        font-size: 10px;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.16em;
        color: var(--ink-mute-2);
        display: block;
        text-align: center;
    }

    .nutri-item-main .nutri-val {
        font-size: 56px;
        letter-spacing: -0.03em;
        color: white;
    }

    .nutri-item-main .nutri-label {
        color: rgba(255,255,255,0.75);
    }

    .nutrition-caption {
        margin-top: 12px;
        color: var(--ink-mute-2);
        font-size: 11px;
        font-style: italic;
        line-height: 1.4;
        text-align: center;
    }

    .bottom-action-bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1030;
        padding: 12px 16px calc(env(safe-area-inset-bottom, 0px) + 28px);
        background: linear-gradient(180deg, rgba(245,239,225,0) 0%, rgba(245,239,225,0.95) 30%, #f5efe1 100%);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .bottom-action-inner {
        display: block;
        max-width: 520px;
        margin: 0 auto;
    }

    .bottom-primary-btn {
        width: 100%;
        min-height: 56px;
        border: none;
        border-radius: 16px;
        background: linear-gradient(135deg, #1a3a23, #0e2415);
        color: white;
        font-weight: 700;
        font-size: 15px;
        box-shadow: 0 6px 20px rgba(20,57,31,0.28);
    }

    @@media (max-width: 768px) {
        .hero-container {
            height: 320px;
        }
    }
</style>

<div class="recipe-detail-page">
    <div class="hero-container">
        @if (Model.Images != null && Model.Images.Any())
        {
            <img src="@Model.Images.First().Image" class="hero-image" alt="@displayTitle" />
        }
        else if (ViewData["PostingThumbnailUrl"] is string thumbUrl && !string.IsNullOrWhiteSpace(thumbUrl))
        {
            // Some environments have only the full thumbnail (no *_thumb_small.webp) or CDN propagation delays.
            // Provide fallbacks to keep the hero image from breaking.
            var fallbackThumb1 = thumbUrl.Replace("_thumb_small.webp", "_thumb.webp").Replace(" ", "%20");
            var fallbackThumb2 = fallbackThumb1.Replace(
                "https://DelekatesenDrehbuchCdn-beecexhdaghhacab.z01.azurefd.net/",
                "https://blobdelikatessendrehbuch.blob.core.windows.net/");

            <img src="@thumbUrl"
                 class="hero-image"
                 alt="@Model.Title"
                 data-fallback-1="@fallbackThumb1"
                 data-fallback-2="@fallbackThumb2"
                 onerror="(function(img){ if(!img) return; const f1=img.dataset.fallback1||''; const f2=img.dataset.fallback2||''; const cur=img.getAttribute('src')||''; if(f1 && cur!==f1){ img.onerror=null; img.src=f1; img.onerror=function(){ if(f2 && img.src!==f2){ img.onerror=null; img.src=f2; } }; } })(this);" />
        }
        else
        {
            <div class="hero-image d-flex align-items-center justify-content-center" style="background: linear-gradient(145deg, #d9dfd3, #eef2e9);">
                <i class="bi bi-image text-muted" style="font-size: 4rem;"></i>
            </div>
        }

        <div class="header-overlay"></div>

        <div class="hero-top-controls">
            <a href="#" class="back-btn text-decoration-none" id="backToFeedBtn" aria-label="Back">
                <i class="bi bi-chevron-left"></i>
            </a>
        </div>

        <div class="author-tag">
            <span class="author-monogram">@char.ToUpperInvariant(authorInitial)</span>
            <span class="pe-2">@creatorName</span>
        </div>
    </div>

    <div class="recipe-main-content">
        <div class="drag-handle"></div>

        <div class="title-section">
            <div class="eyebrow-row">
                <span class="eyebrow-dot"></span>
                <span>@categoryLabel · @recipeModeLabel</span>
            </div>

            <h1 class="recipe-title" id="recipeDisplayTitle">@displayTitle</h1>

            @if (!string.IsNullOrWhiteSpace(variantSummary))
            {
                <p class="mt-2 mb-0" style="color: var(--ink-mute); font-size: 0.95rem; line-height: 1.45;">@variantSummary</p>
            }

            <div class="badge-row">
                @if (ViewData["SwapsJson"] is string swapsJsonBadge)
                {
                    var swapCount = 0;
                    try
                    {
                        var swaps = System.Text.Json.JsonSerializer.Deserialize<List<DelikatessenDrehbuch.Models.IngredientSwap>>(swapsJsonBadge);
                        swapCount = swaps?.Count ?? 0;
                    }
                    catch { }

                    if (swapCount > 0)
                    {
                        <div class="premium-badge" style="background: linear-gradient(135deg, #28a745, #20c997); color: white; font-weight: 700;">
                            <i class="bi bi-arrow-left-right"></i>
                            <span class="badge-value" style="color:white;">@swapCount</span>
                            <span class="badge-unit" style="color:rgba(255,255,255,0.85);">@SharedLocalizer["Recipe.Swaps"]</span>
                        </div>
                    }
                }
                <div class="premium-badge">
                    <i class="bi bi-people" style="color: var(--ink-deep);"></i>
                    <span class="badge-value">@Model.PersonCount</span>
                </div>
                <div class="premium-badge">
                    <i class="bi bi-clock" style="color: var(--avocado);"></i>
                    <span class="badge-value">@Model.PreparationTime</span>
                    <span class="badge-unit">Min.</span>
                </div>
                <div class="premium-badge">
                    <i class="bi bi-fire" style="color: var(--coral);"></i>
                    <span class="badge-value" id="headerCalories" data-base="@((totalCalories / basePortions).ToString(CultureInfo.InvariantCulture))">@Math.Round(totalCalories / basePortions)</span>
                    <span class="badge-unit">kcal</span>
                </div>
            </div>

            <div class="top-actions">
                @if (communityCount > 0)
                {
                    <button type="button"
                            class="top-pill-btn"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#communityVariantsCanvas"
                            aria-controls="communityVariantsCanvas">
                        <i class="bi bi-layers"></i> @SharedLocalizer["Recipe.Variants"] (@communityCount)
                    </button>
                }

                @if (ViewData["SwapVariantId"] is int swapVariantId && swapVariantId > 0)
                {
                    <button type="button"
                            class="top-pill-btn"
                            id="publishCommunityVariantBtn"
                            data-recipe-id="@Model.Id"
                            data-swap-variant-id="@swapVariantId"
                            data-parent-community-variant-id="@(ViewData["CommunityVariantId"] as int? ?? 0)">
                        <i class="bi bi-check2-circle"></i> @SharedLocalizer["Recipe.SaveAsVariant"]
                    </button>
                }

                @if (canPublishToFeed)
                {
                    @if (existingPostingId.HasValue)
                    {
                        <a class="top-pill-btn"
                           href="@Url.Action("EditRecipe", "Home", new { area = "WorldMiniApp", postingId = existingPostingId.Value })">
                            <i class="bi bi-pencil-square"></i> @SharedLocalizer["Recipe.EditFeedPost"]
                        </a>
                    }
                    else
                    {
                        <form asp-action="PublishRecipeBaseDataToFeed" asp-controller="Home" asp-area="WorldMiniApp" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="recipeBaseDataId" value="@Model.Id" />
                            <button type="submit" class="top-pill-btn">
                                <i class="bi bi-broadcast-pin"></i> @SharedLocalizer["Recipe.CreateFeedPost"]
                            </button>
                        </form>
                    }
                }
            </div>

            @if (communityCount > 0)
            {
                <div style="height: 2px;"></div>
            }
        </div>

        <nav class="nav nav-pills-custom" id="recipeTab" role="tablist">
            <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#ingredients" type="button">@SharedLocalizer["Recipe.Ingredients"]</button>
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#preparation" type="button">@SharedLocalizer["Recipe.Steps"]</button>
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#nutrition" type="button">@SharedLocalizer["Recipe.Nutrition"]</button>
        </nav>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="ingredients" role="tabpanel">
                <div class="portion-selector-wrapper">
                    <div class="portion-stepper">
                        <span class="portion-stepper-label">@SharedLocalizer["Recipe.ServingsFor"]</span>
                        <button type="button" class="portion-step-btn minus" onclick="adjustPortions(-1)">−</button>
                        <input type="number"
                               id="portionInput"
                               class="portion-input"
                               value="@basePortions"
                               min="1"
                               onchange="updatePortions()"
                               inputmode="numeric">
                        <button type="button" class="portion-step-btn plus" onclick="adjustPortions(1)">+</button>
                    </div>
                </div>

                <div id="ingredientListContainer">
                    @foreach (var group in Model.Ingredients.GroupBy(i => i.Ingredient.IngredientsAndNutrients.Group?.Name ?? "General"))
                    {
                        <h6 class="ingredient-group-label">@group.Key</h6>
                        @foreach (var item in group)
                        {
                            <div class="ingredient-card" data-ingredient-id="@item.Ingredient.IngredientsAndNutrients.Id">
                                <div class="check-box" onclick="toggleCheck(this.parentElement)" style="cursor: pointer;">
                                    @{
                                        var ingredientIcon = IngredientIcon(item.Ingredient.IngredientsAndNutrients);
                                        var ingredientIconIsImage = ingredientIcon.StartsWith("/") || ingredientIcon.StartsWith("http", StringComparison.OrdinalIgnoreCase) || ingredientIcon.Contains(".");
                                    }
                                    @if (ingredientIconIsImage)
                                    {
                                        <img src="@ingredientIcon" alt="" class="ingredient-icon-image" />
                                    }
                                    else
                                    {
                                        <span class="ingredient-emoji">@ingredientIcon</span>
                                    }
                                    <i class="bi bi-check-lg d-none"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="ingredient-name">@IngredientName(item.Ingredient.IngredientsAndNutrients)</span>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="ingredient-quantity">
                                                <span class="dyn-qty" data-base-qty="@item.Ingredient.Quantity.Quantitys.ToString(CultureInfo.InvariantCulture)">@item.Ingredient.Quantity.Quantitys</span>
                                                <span class="ingredient-unit">@item.Ingredient.Measure.Metrics_DE</span>
                                            </span>
                                            <button class="swap-btn"
                                                    data-swap-ingredient="@item.Ingredient.IngredientsAndNutrients.Id"
                                                    data-recipe-id="@Model.Id"
                                                    data-ingredient-name="@IngredientName(item.Ingredient.IngredientsAndNutrients)"
                                                    title="@SharedLocalizer["Recipe.SwapIngredient"]">
                                                <i class="bi bi-arrow-left-right"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div id="swapBatchBar" class="px-4 pb-3" style="display:none;"></div>
            </div>

            <div class="tab-pane fade" id="preparation" role="tabpanel">
                <div class="step-container" id="preparationListContainer">
                    @{
                        var translatedSteps = GetTranslatedSteps();
                        var stepNumber = 1;
                    }
                    @foreach (var stepText in translatedSteps)
                    {
                        <div class="step-card">
                            <span class="step-badge">@SharedLocalizer["Recipe.Step"] @stepNumber</span>
                            <p class="mb-0" style="font-size:14.5px; line-height:1.5; color:var(--ink-deep);">@stepText</p>
                        </div>
                        stepNumber++;
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="nutrition" role="tabpanel">
                <div class="nutri-grid">
                    <div class="nutri-item nutri-item-main">
                        <span class="nutri-val dyn-nutri" data-base="@totalCalories.ToString(CultureInfo.InvariantCulture)">@Math.Round(totalCalories)</span>
                        <span class="nutri-label">@SharedLocalizer["Recipe.TotalCalories"]</span>
                    </div>
                    <div class="nutri-item">
                        <span class="nutri-val dyn-nutri" data-base="@totalProtein.ToString(CultureInfo.InvariantCulture)">@Math.Round(totalProtein)</span>
                        <span class="nutri-label">@SharedLocalizer["Recipe.Protein"]</span>
                    </div>
                    <div class="nutri-item">
                        <span class="nutri-val dyn-nutri" data-base="@totalCarbs.ToString(CultureInfo.InvariantCulture)">@Math.Round(totalCarbs)</span>
                        <span class="nutri-label">@SharedLocalizer["Recipe.Carbs"]</span>
                    </div>
                    <div class="nutri-item">
                        <span class="nutri-val dyn-nutri" data-base="@totalFat.ToString(CultureInfo.InvariantCulture)">@Math.Round(totalFat)</span>
                        <span class="nutri-label">@SharedLocalizer["Recipe.Fat"]</span>
                    </div>
                    <div class="nutri-item">
                        <span class="nutri-val dyn-nutri" data-base="@totalSugar.ToString(CultureInfo.InvariantCulture)">@Math.Round(totalSugar, 1)</span>
                        <span class="nutri-label">@SharedLocalizer["Recipe.Sugar"]</span>
                    </div>
                </div>

                <div class="nutrition-caption">
                    @SharedLocalizer["Recipe.NutritionDisclaimer"]
                </div>
            </div>
        </div>
    </div>
</div>

<div class="bottom-action-bar">
    <div class="bottom-action-inner">
        <button type="button" class="bottom-primary-btn" id="sharePrimaryBtn">
            @SharedLocalizer["Recipe.Share"]
        </button>
    </div>
</div>

<div class="offcanvas offcanvas-bottom" tabindex="-1" id="communityVariantsCanvas" aria-labelledby="communityVariantsCanvasLabel" style="height: 75vh; border-top-left-radius: 18px; border-top-right-radius: 18px;">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="communityVariantsCanvasLabel" style="font-weight:900;">Varianten entdecken</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="d-flex gap-2 align-items-center mb-3 flex-wrap">
            <input id="variantSearchInput" class="form-control" placeholder="@SharedLocalizer["ShowRecipe.SearchPlaceholder"]" style="max-width: 420px; border-radius: 14px;" />
            <div class="btn-group" role="group" aria-label="Sortierung">
                <button type="button" class="btn btn-outline-secondary active" id="variantSortNewBtn">Neu</button>
                <button type="button" class="btn btn-outline-secondary" id="variantSortTopBtn">Top</button>
            </div>
            <span class="text-muted small" id="variantResultMeta"></span>
        </div>

        <div id="variantList" class="variant-card-grid"></div>

        <div id="variantListEmpty" class="text-center text-muted py-5" style="display:none;">
            Keine Varianten gefunden.
        </div>
    </div>
</div>

@* Ingredient Alternatives Popup *@
<div id="ingredientAlternativesModal" class="alt-modal" style="display:none;">
    <div class="alt-backdrop"></div>
    <div class="alt-sheet">
        @* Header *@
        <div class="alt-header">
            <div class="alt-drag-handle"></div>
            <div class="alt-header-content">
                <div class="alt-header-left">
                    <div class="alt-label">Alternativen für</div>
                    <h2 class="alt-title" id="altIngredientName">Carrot</h2>
                    <div class="alt-meta">
                        <span class="alt-meta-badge">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="#f5b942"><path d="M12 2l1.6 5.2L19 9l-5.4 1.8L12 16l-1.6-5.2L5 9l5.4-1.8L12 2z"/><path d="M19 14l.7 2.3L22 17l-2.3.7L19 20l-.7-2.3L16 17l2.3-.7L19 14z"/></svg>
                            <span>ChatGPT · GPT-4o-mini</span>
                        </span>
                        <span class="alt-meta-time">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            <span>9.8s</span>
                        </span>
                    </div>
                </div>
                <button type="button" class="alt-close" id="closeAltModal">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
        </div>

        @* Scroll Content *@
        <div class="alt-scroll" id="altScrollContent">
            @* Original Card *@
            <div class="alt-original-card">
                <div class="alt-original-label">ORIGINAL</div>
                <div class="alt-original-header">
                    <span class="alt-original-name" id="altOriginalName">Carrot</span>
                    <span class="alt-original-amount" id="altOriginalAmount">2 Stk.</span>
                </div>
                <div class="alt-original-macros" id="altOriginalMacros">
                    <span class="alt-macro-pill alt-macro-kcal"><span class="alt-macro-val">41</span><span class="alt-macro-unit">kcal</span></span>
                    <span class="alt-macro-pill alt-macro-protein"><span class="alt-macro-val">0.9</span><span class="alt-macro-unit">P</span></span>
                    <span class="alt-macro-pill alt-macro-carbs"><span class="alt-macro-val">10.0</span><span class="alt-macro-unit">C</span></span>
                    <span class="alt-macro-pill alt-macro-fat"><span class="alt-macro-val">0.2</span><span class="alt-macro-unit">F</span></span>
                </div>
            </div>

            @* Alternative Cards (will be generated dynamically) *@
            <div id="altOptionsList"></div>
        </div>

        @* Footer *@
        <div class="alt-footer">
            <button type="button" class="alt-cancel-btn" id="cancelAltModal">@SharedLocalizer["Common.Cancel"]</button>
        </div>
    </div>
</div>

<script src="~/js/ingredient-swap.js"></script>

<style>
    .variant-card-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; max-width: 760px; margin: 0 auto; }
    @@media (max-width: 576px) { .variant-card-grid { grid-template-columns: 1fr; } }

    /* Important for CSS-grid: allow items to shrink instead of overflowing the container */
    .variant-card-grid > a { min-width: 0; }

    .variant-card {
        border-radius: 16px;
        border: 1px solid rgba(0,0,0,0.06);
        background: #fff;
        box-shadow: 0 10px 26px rgba(0,0,0,0.06);
        overflow: hidden;
        transition: transform 140ms ease, box-shadow 140ms ease;
        width: 100%;
        min-width: 0;
    }
    .variant-card:hover { transform: translateY(-1px); box-shadow: 0 14px 34px rgba(0,0,0,0.10); }

    .variant-card__body { padding: 14px 14px 12px; }
    .variant-card__header { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .variant-card__titleWrap { min-width: 0; flex: 1 1 auto; }
    .variant-card__title {
        font-weight: 950;
        color: #0f172a;
        line-height: 1.15;
        font-size: 1.02rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
    }
    .variant-card__summary {
        margin-top: 8px;
        color: rgba(15, 23, 42, 0.66);
        font-size: 0.92rem;
        line-height: 1.25;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 3.45em;
    }
    .variant-card__meta {
        margin-top: 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        color: rgba(15, 23, 42, 0.55);
        font-size: 0.82rem;
        flex-wrap: wrap;
    }
    .variant-badges { display: flex; gap: 8px; flex-wrap: wrap; }
    .variant-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        font-weight: 900;
        border: 1px solid rgba(0,0,0,0.06);
        background: rgba(255,255,255,0.96);
        max-width: 100%;
    }
    .variant-badge--lang { background: rgba(0,0,0,0.03); }
    .variant-badge--like { background: rgba(231, 76, 60, 0.10); border-color: rgba(231, 76, 60, 0.22); color: #b83a2c; }
    .variant-badge--swap { background: rgba(52, 152, 219, 0.10); border-color: rgba(52, 152, 219, 0.22); color: #1b5e8a; }
    .variant-badge--time { background: rgba(46, 204, 113, 0.10); border-color: rgba(46, 204, 113, 0.22); color: #1b7f45; }

    /* Ingredient Alternatives Modal */
    .alt-modal {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
    }

    .alt-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(10,28,17,0.42);
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
    }

    .alt-sheet {
        position: relative;
        background: #f5efe1;
        border-top-left-radius: 28px;
        border-top-right-radius: 28px;
        height: 92%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 -20px 60px rgba(10,28,17,0.30);
    }

    .alt-header {
        background: linear-gradient(135deg, #1f4329, #0e2415);
        padding: 16px 18px 18px;
        color: white;
        flex-shrink: 0;
        position: relative;
    }

    .alt-drag-handle {
        width: 38px;
        height: 4px;
        border-radius: 2px;
        background: rgba(255,255,255,0.30);
        margin: 0 auto 14px;
    }

    .alt-header-content {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
    }

    .alt-header-left {
        min-width: 0;
        flex: 1;
    }

    .alt-label {
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.62);
        margin-bottom: 5px;
    }

    .alt-title {
        font-family: 'Fraunces', serif;
        font-size: 26px;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin: 0;
        line-height: 1.05;
        color: white;
    }

    .alt-meta {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-top: 10px;
        flex-wrap: wrap;
    }

    .alt-meta-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.16);
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: 600;
        color: rgba(255,255,255,0.92);
        white-space: nowrap;
    }

    .alt-meta-time {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 11px;
        font-weight: 600;
        color: rgba(255,255,255,0.55);
    }

    .alt-close {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(255,255,255,0.14);
        border: 1px solid rgba(255,255,255,0.18);
        color: white;
        cursor: pointer;
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .alt-close:hover {
        background: rgba(255,255,255,0.22);
    }

    .alt-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 14px 16px 100px;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .alt-original-card {
        background: #faf6ec;
        border: 1px solid rgba(20,57,31,0.07);
        border-radius: 18px;
        padding: 14px 16px;
        box-shadow: 0 2px 8px rgba(20,57,31,0.06);
    }

    .alt-original-label {
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #9aa295;
        margin-bottom: 8px;
    }

    .alt-original-header {
        display: flex;
        align-items: baseline;
        gap: 7px;
        margin-bottom: 12px;
    }

    .alt-original-name {
        font-family: 'Fraunces', serif;
        font-size: 21px;
        font-weight: 600;
        color: #14391f;
        letter-spacing: -0.02em;
    }

    .alt-original-amount {
        font-size: 13px;
        color: #6b7868;
        font-weight: 500;
    }

    .alt-original-macros {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .alt-macro-pill {
        display: inline-flex;
        align-items: baseline;
        gap: 3px;
        border-radius: 999px;
        padding: 5px 11px;
        white-space: nowrap;
    }

    .alt-macro-val {
        font-family: 'Fraunces', serif;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: -0.01em;
    }

    .alt-macro-unit {
        font-size: 10px;
        font-weight: 700;
        opacity: 0.78;
        letter-spacing: 0.02em;
    }

    .alt-macro-kcal {
        background: rgba(20,57,31,0.07);
        color: #2a4a32;
        box-shadow: inset 0 0 0 1px rgba(20,57,31,0.10);
    }

    .alt-macro-protein {
        background: rgba(95,160,82,0.16);
        color: #3f7a36;
        box-shadow: inset 0 0 0 1px rgba(95,160,82,0.28);
    }

    .alt-macro-carbs {
        background: rgba(60,108,158,0.13);
        color: #3a6390;
        box-shadow: inset 0 0 0 1px rgba(60,108,158,0.24);
    }

    .alt-macro-fat {
        background: rgba(245,185,66,0.20);
        color: #9a7415;
        box-shadow: inset 0 0 0 1px rgba(245,185,66,0.40);
    }

    .alt-option-card {
        position: relative;
        background: white;
        border-radius: 22px;
        padding: 16px 16px 16px 18px;
        box-shadow: 0 4px 16px rgba(20,57,31,0.12);
        overflow: hidden;
        margin-bottom: 18px;
    }

    .alt-option-card:last-child {
        margin-bottom: 0;
    }

    .alt-option-accent {
        position: absolute;
        left: 0;
        top: 14px;
        bottom: 14px;
        width: 3px;
        border-radius: 3px;
        background: #5fa052;
    }

    .alt-option-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
    }

    .alt-option-left {
        min-width: 0;
        flex: 1;
    }

    .alt-option-name {
        font-family: 'Fraunces', serif;
        font-size: 20px;
        font-weight: 600;
        color: #14391f;
        letter-spacing: -0.02em;
        line-height: 1.12;
    }

    .alt-option-amount {
        font-family: 'Fraunces', serif;
        font-size: 14px;
        color: #6b7868;
        font-weight: 500;
        margin-top: 3px;
    }

    .alt-option-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 7px;
