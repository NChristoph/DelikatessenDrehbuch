@using DelikatessenDrehbuch.Areas.WorldMiniApp.Models
@model List<WorldUserMealPlan>

@{
    Layout = "_MiniAppLayout";
    ViewData["Title"] = "Meine Pläne";
    var userHash = ViewData["UserHash"] as string;
}

<div class="px-4 pt-4 pb-2">
    <a href="@Url.Action("Index", "Home", new { area = "WorldMiniApp" })" class="text-decoration-none text-muted mb-3 d-inline-block opacity-75">
        <i class="bi bi-arrow-left"></i> Zurück
    </a>
    <h2 class="fw-bold mb-1" style="color: #2c3e50;">Deine Pläne 🥑</h2>
    <p class="text-muted small">Verwalte deine gespeicherten Wochenpläne.</p>
</div>

<div class="container px-4 pb-5">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
                <div>
                    <h6 class="fw-bold mb-1">Zutaten &amp; Nährwerte erweitern</h6>
                    <p class="text-muted small mb-0">Füge 50 neue Zutaten hinzu, die noch nicht in der Datenbank sind.</p>
                </div>
                <form asp-action="SeedWorldIngredientsAndNutrients" method="post" class="ms-md-auto">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userHash" value="@userHash" />
                    <button type="submit" class="btn btn-dark rounded-pill px-4">
                        50 Zutaten hinzufügen
                    </button>
                </form>
            </div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 opacity-50">
            <i class="bi bi-journal-x fs-1 mb-3 d-block"></i>
            <p>Noch keine Pläne erstellt.</p>
        </div>
    }
    else
    {
        <div class="d-grid gap-3">
            @foreach (var plan in Model)
            {
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden plan-card">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="fw-bold text-dark mb-1">@plan.Title</h5>
                                <div class="text-muted small">
                                    <i class="bi bi-calendar3 me-1"></i> @plan.CreationTime.ToString("dd. MMM yyyy")
                                </div>
                            </div>
                            <div class="icon-box rounded-circle bg-light d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <span class="fs-5">📝</span>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-white border-0 p-2 d-flex gap-2">

                        <a href="@Url.Action("ViewPlan", new { id = plan.Id })"
                           class="btn border-0 rounded-4 flex-grow-1 fw-bold text-white d-flex align-items-center justify-content-center btn-hover-scale"
                           style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 12px;">
                            <i class="bi bi-eye-fill me-2"></i> Anzeigen
                        </a>

                        <a href="@Url.Action("EditPlan", new { id = plan.Id })"
                           class="btn border-0 rounded-4 d-flex align-items-center justify-content-center btn-hover-scale"
                           style="background: #fff3e0; color: #ff9800; width: 50px;"
                           title="Bearbeiten">
                            <i class="bi bi-pencil-fill"></i>
                        </a>

                        <a href="@Url.Action("DeletePlan", new { userHash=plan.UserHash,id = plan.Id })"
                           onclick="return confirm('Möchtest du den Plan \'@plan.Title\' wirklich löschen?');"
                           class="btn border-0 rounded-4 d-flex align-items-center justify-content-center btn-hover-scale"
                           style="background: #ffebee; color: #ef5350; width: 50px;"
                           title="Löschen">
                            <i class="bi bi-trash-fill"></i>
                        </a>

                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    body {
        /* Hintergrund passend zu den anderen Seiten */
        background: linear-gradient(140deg, #fff8e1 0%, #fff 50%, #f3e5f5 100%);
        min-height: 100vh;
    }

    .plan-card {
        transition: transform 0.2s, box-shadow 0.2s;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
    }

    .btn-hover-scale {
        transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

        .btn-hover-scale:active {
            transform: scale(0.9);
        }
</style>
