@using DelikatessenDrehbuch.Models
@using DelikatessenDrehbuch.StaticScripts
@using System.Globalization
@model DelikatessenDrehbuch.Areas.WorldMiniApp.Models.WorldMealPlanViewModel

@{
    Layout = "_MiniAppLayout";
    ViewData["Title"] = Model.Title;
    var isGerman = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.Equals("de", StringComparison.OrdinalIgnoreCase);
    string T(string de, string en) => isGerman ? de : en;

    var groupedDays = Model.MealPlan
        .Where(x => x.Recipes != null)
        .GroupBy(x => x.Index)
        .OrderBy(x => x.Key)
        .ToList();

    var groupedShoppingList = Model.ShoppingList
        .GroupBy(x => x.GroupName ?? "Sonstiges")
        .OrderBy(x => x.Key)
        .ToList();

    string ResolveThumbnail(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return string.Empty;
        }

        var smallPath = FrontendFunctions.GetSmallImagePath(path);
        if (string.IsNullOrWhiteSpace(smallPath) || smallPath == "_small.webp")
        {
            return path;
        }

        return smallPath;
    }
}

<div class="min-vh-100 pb-5" style="background: linear-gradient(140deg, #fff8e1 0%, #fff 50%, #f3e5f5 100%);">
    <div class="px-4 pt-4 pb-2">
        <a href="@Url.Action("Personality", "Home", new { area = "WorldMiniApp" })"
           class="text-decoration-none text-muted mb-2 d-inline-flex align-items-center small opacity-75 hover-opacity">
            <i class="bi bi-arrow-left me-1"></i> @T("Zurück zu meinen Plänen", "Back to my plans")
        </a>

        <h2 class="fw-bold mb-1" style="color: #2c3e50;">@Model.Title</h2>
        <p class="text-muted small">@T("Personen", "People"): @Model.PersonCount</p>
    </div>

    <div class="container px-3 mt-2">
        @foreach (var dayGroup in groupedDays)
        {
            var dayKey = dayGroup.Key;
            var list = dayGroup.ToList();

            <div class="glass-card mb-4 overflow-hidden">
                <div class="d-flex align-items-center justify-content-between p-3 border-bottom border-light bg-white bg-opacity-50">
                    <h5 class="fw-bold m-0 text-dark">@T("Tag", "Day") @dayKey</h5>
                </div>

                <div class="p-2">
                    @foreach (var item in list)
                    {
                        var recipeId = item.Recipes.Id;
                        var imagePath = ResolveThumbnail(item.Recipes.ImagePath);

                        if (item.IsBaseData)
                        {
                            <a class="d-flex align-items-center gap-3 p-2 rounded-3 hover-bg clickable-item mb-1 text-decoration-none"
                               href="@Url.Action("ShowRecipe", "Home", new { area = "WorldMiniApp", id = recipeId })">
                                <div class="rounded-3 overflow-hidden bg-light shadow-sm" style="width: 55px; height: 55px; flex-shrink: 0;">
                                    @if (!string.IsNullOrEmpty(item.Recipes.ImagePath))
                                    {
                                        <img src="@imagePath" class="w-100 h-100 object-fit-cover" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center h-100 text-muted"><i class="bi bi-egg"></i></div>
                                    }
                                </div>

                                <div class="flex-grow-1 overflow-hidden" style="min-width: 0;">
                                    <small class="text-uppercase fw-bold text-warning" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                                        @item.Recipes.Category
                                    </small>
                                    <h6 class="mb-0 fw-bold text-dark text-truncate">@item.Recipes.Name</h6>
                                </div>

                                <div class="text-muted opacity-25">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </div>
                            </a>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-3 p-2 rounded-3 hover-bg mb-1">
                                <div class="rounded-3 overflow-hidden bg-light shadow-sm" style="width: 55px; height: 55px; flex-shrink: 0;">
                                    @if (!string.IsNullOrEmpty(item.Recipes.ImagePath))
                                    {
                                        <img src="@imagePath" class="w-100 h-100 object-fit-cover" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center h-100 text-muted"><i class="bi bi-egg"></i></div>
                                    }
                                </div>

                                <div class="flex-grow-1 overflow-hidden" style="min-width: 0;">
                                    <small class="text-uppercase fw-bold text-warning" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                                        @item.Recipes.Category
                                    </small>
                                    <h6 class="mb-0 fw-bold text-dark text-truncate">@item.Recipes.Name</h6>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>

    <div class="fixed-bottom p-3" style="background: linear-gradient(to top, #f3e5f5 0%, transparent 100%); pointer-events: none;">
        <div style="pointer-events: auto;">
            <button class="btn border-0 w-100 py-3 rounded-pill fw-bold shadow-lg d-flex align-items-center justify-content-center text-white btn-hover-effect"
                    style="background: linear-gradient(135deg, #FF9966 0%, #FF5E62 100%);"
                    data-bs-toggle="offcanvas" data-bs-target="#WorldShoppingList">
                <i class="bi bi-cart-check-fill fs-4 me-2"></i>
                <span class="fs-5">@T("Einkaufsliste", "Shopping list")</span>
            </button>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-bottom h-100 rounded-top-0" tabindex="-1" id="WorldShoppingList">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title fw-bold">@T("Einkaufsliste", "Shopping list") 🛒</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body bg-light">
        <div class="bg-white p-3 rounded-4 shadow-sm border">
            @if (!groupedShoppingList.Any())
            {
                <p class="text-muted mb-0">@T("Keine Einkaufsliste verfügbar.", "No shopping list available.")</p>
            }
            else
            {
                @foreach (var group in groupedShoppingList)
                {
                    <div class="mb-3">
                        <h6 class="fw-bold text-dark mb-2">@group.Key</h6>
                        <ul class="list-unstyled mb-0">
                            @foreach (var item in group.OrderBy(x => x.IngredientName))
                            {
                                <li class="d-flex justify-content-between border-bottom py-1">
                                    <span>@item.IngredientName</span>
                                    <span class="text-muted">@item.Quantity @item.Unit</span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 24px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
    }

    .hover-bg { transition: background-color 0.2s; cursor: pointer; }
    .hover-bg:active { background-color: rgba(0,0,0,0.05); }
    .object-fit-cover { object-fit: cover; }
    .text-truncate {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .btn-hover-effect:active { transform: scale(0.98); }
</style>
