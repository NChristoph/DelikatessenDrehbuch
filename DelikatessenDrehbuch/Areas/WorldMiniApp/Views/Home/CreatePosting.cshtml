        }


    .creator-top-head {
        padding: 12px 14px 8px;
        border-bottom: 1px solid rgba(255,255,255,0.12);
        background: rgba(12, 16, 28, 0.28);
    }

    .template-selection-wrap {
        margin-top: 10px;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    .creator-preview-canvas {
        height: auto;
        padding: 16px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
    }


    .ingredient-top-strip {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 8px;
    }

    .ingredient-top-title {
        font-size: .74rem;
        color: var(--creator-sub);
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .ingredient-swiper-top {
