<style>

    /* --- Bottom Dock Layout --- */
    .ingredient-bottom-dock {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 14px;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .ingredient-bottom-dock {
            grid-template-columns: 1fr;
        }
    }

    .glass-panel {
        border-radius: 18px;
        padding: 12px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.14);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: 0 10px 35px rgba(0,0,0,0.18);
    }

    .dock-title {
        font-weight: 700;
        font-size: 0.95rem;
        letter-spacing: .02em;
        margin-bottom: 10px;
        opacity: .95;
    }

    /* Lists are vertical (untereinander) */
    .dock-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    /* Item rows (nice cards) */
    .dock-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 10px 10px;
        border-radius: 16px;
        background: rgba(0,0,0,0.22);
        border: 1px solid rgba(255,255,255,0.10);
    }

        .dock-item .dock-name {
            font-weight: 650;
            line-height: 1.2;
        }

        .dock-item .dock-meta {
            font-size: 0.82rem;
            opacity: .75;
            margin-top: 2px;
        }

    /* Action buttons */
    .dock-actions {
        display: flex;
        gap: 8px;
    }

    .btn-glass {
        border-radius: 14px !important;
        padding: 6px 10px !important;
        border: 1px solid rgba(255,255,255,0.18) !important;
        background: rgba(255,255,255,0.10) !important;
        color: #fff !important;
        backdrop-filter: blur(10px);
    }

        .btn-glass:hover {
            background: rgba(255,255,255,0.16) !important;
        }

    .btn-glass-danger {
        background: rgba(255,80,80,0.12) !important;
        border-color: rgba(255,80,80,0.25) !important;
    }
    /* ---------- Background / Shell ---------- */
    .creator-bg {
        background: radial-gradient(900px 420px at 20% 0%, rgba(255, 153, 102, .18), transparent 60%), radial-gradient(900px 520px at 80% 10%, rgba(139, 92, 246, .16), transparent 65%), #ffffff;
    }

    .feed-shell {
        max-width: 720px;
        padding: 12px 12px 120px 12px; /* space for bottom bar */
    }

    /* ---------- Loading Overlay ---------- */
    .creator-loading {
        position: fixed;
        inset: 0;
        background: rgba(255,255,255,0.72);
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
    }

    .creator-loading-card {
        background: #fff;
        border-radius: 18px;
        padding: 20px 24px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.15);
        text-align: center;
        border: 1px solid rgba(0,0,0,0.06);
    }

    /* ---------- Topbar ---------- */
    body > .position-fixed.top-0.end-0.m-3.dropdown {
        z-index: 2601 !important;
    }

    .creator-topbar {
        position: sticky;
        top: 0;
        z-index: 1500;
        background: rgba(255,255,255,0.86);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(0,0,0,0.06);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .topbar-btn {
        width: 42px;
        height: 42px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(0,0,0,0.10);
        background: #fff;
        color: #111;
        text-decoration: none;
    }

    .topbar-primary {
        border: none;
        background: linear-gradient(135deg, #FF9966 0%, #FF5E62 100%);
        color: #fff;
    }

    .topbar-title {
        flex: 1;
        min-width: 0;
        line-height: 1.15;
    }

    /* ---------- Hero ---------- */
    .creator-hero {
        border-radius: 26px;
        background: rgba(255,255,255,0.82);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.06);
