@model DelikatessenDrehbuch.Areas.WorldMiniApp.Models.WorldUserPosting
@using System.Text.Json
@using System.Linq
@using Newtonsoft.Json

@{
    var stepIngredientBindings = Model.IngredientStepJoins
        .Where(x => x.Preperation != null && x.Ingredient != null)
        .GroupBy(x => x.Preperation.Id)
        .ToDictionary(
            group => group.Key,
            group => group.Select(x => x.Ingredient.Id).Distinct().ToList());

    var stepCatalogJson = JsonSerializer.Serialize(
        Model.ToSelectRecipePreperationSteps?.Select(step => new
        {
            id = step.Id,
            de = step.Step_DE,
            en = step.Step_EN,
            esp = step.Step_ESP,
            prt = step.Step_PRT
        }) ?? Enumerable.Empty<object>());

    ViewData["Title"] = "Rezept Erstellen";
    Layout = "_MiniAppLayout";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

<div class="creator-bg min-vh-100 position-relative">
    <!-- Loading Overlay -->
    <div id="datatableLoadingOverlay" class="creator-loading d-none">
        <div class="creator-loading-card">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Lade...</span>
            </div>
            <div class="fw-bold mt-2">Lade Daten...</div>
            <div class="small text-muted">Einen Moment bitte</div>
        </div>
    </div>

    <!-- Topbar (Social Creator) -->
    <div class="creator-topbar px-3 py-3">
        <a href="@Url.Action("Index", "Home", new { area = "WorldMiniApp" })" class="topbar-btn" aria-label="Zurück">
            <i class="bi bi-chevron-left"></i>
        </a>

        <div class="topbar-title">
            <div class="fw-bold text-truncate">Creator Studio</div>
            <div class="small text-muted text-truncate">Neuer Upload · Rezeptpost</div>
        </div>

        <!-- Optional: Quick Publish -->
        <button type="submit" form="recipeForm" class="topbar-btn topbar-primary" aria-label="Veröffentlichen">
            <i class="bi bi-send-fill"></i>
        </button>
    </div>

    <div class="feed-shell mx-auto">
        <form asp-action="UploadNewVideo" method="post" enctype="multipart/form-data" id="recipeForm" onsubmit="return prepareBinding()">
            <input type="hidden" name="userHash" id="hiddenUserTokenField" />

            <!-- HERO CARD -->
            <div class="creator-hero mb-3">
                <div class="creator-hero-left">
                    <div class="creator-hero-badge">
                        <i class="bi bi-stars me-2"></i>
                        <span class="label-lang" data-de="Upload ready" data-en="Upload ready" data-esp="Listo para subir" data-prt="Pronto para envio">Upload ready</span>
                    </div>

                    <h1 class="creator-hero-title mb-1">Neuen Content erstellen</h1>
                    <p class="creator-hero-sub mb-0">
                        Erstelle einen Social-Post wie im Feed: Media + Zutaten + Schritte + Keywords.
                    </p>
                </div>

                <div class="creator-hero-right">
                    <div class="progress-dots" aria-hidden="true">
                        <span class="dot active"></span>
                        <span class="dot"></span>
                        <span class="dot"></span>
                        <span class="dot"></span>
                        <span class="dot"></span>
                    </div>
                    <div class="small text-muted mt-2">5 Schritte</div>
                </div>
            </div>

            <!-- 1) BASICS -->
            <section class="creator-card mb-3" id="card-basics">
                <div class="creator-card-head">
                    <div class="d-flex align-items-center gap-2">
                        <div class="card-icon candy-blue"><i class="bi bi-ui-checks-grid"></i></div>
                        <div>
                            <div class="creator-card-title label-lang" data-de="Basis" data-en="Basics" data-esp="Básico" data-prt="Base">Basis</div>
                            <div class="creator-card-sub label-lang" data-de="Titel, Kategorie, Personen, Dauer" data-en="Title, category, persons, time" data-esp="Título, categoría, personas, tiempo" data-prt="Título, categoria, pessoas, tempo">
                                Titel, Kategorie, Personen, Dauer
                            </div>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light border">1/5</span>
                </div>

                <div class="creator-card-body">
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-2 label-lang"
                               data-de="Titel"
                               data-en="Title"
                               data-esp="Título"
                               data-prt="Título">Titel</label>

                        <div class="input-pill">
                            <i class="bi bi-fonts text-muted"></i>
                            <input asp-for="Title"
                                   class="form-control border-0 bg-transparent fw-bold shadow-none lang-ph"
                                   placeholder="Titel"
                                   data-ph-de="Titel" data-ph-en="Title" data-ph-esp="Título" data-ph-prt="Título"
                                   required />
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-2 label-lang"
                                   data-de="Kategorie"
                                   data-en="Category"
                                   data-esp="Categoría"
                                   data-prt="Categoria">Kategorie</label>

                            <div class="select-pill">
                                <i class="bi bi-grid text-muted"></i>
                                <select asp-for="Recipe.Category" class="form-select border-0 bg-transparent fw-bold shadow-none cursor-pointer">
                                    <option value="" selected disabled class="lang-opt"
                                            data-txt-de="Kategorie"
                                            data-txt-en="Category"
                                            data-txt-esp="Categoría"
                                            data-txt-prt="Categoria">Kategorie</option>

                                    <option value="Appetizer" class="lang-opt" data-txt-de="Vorspeise" data-txt-en="Appetizer" data-txt-esp="Entrada" data-txt-prt="Entrada">Vorspeise</option>
                                    <option value="Main" class="lang-opt" data-txt-de="Hauptspeise" data-txt-en="Main Course" data-txt-esp="Plato principal" data-txt-prt="Prato principal">Hauptspeise</option>
                                    <option value="Dessert" class="lang-opt" data-txt-de="Dessert" data-txt-en="Dessert" data-txt-esp="Postre" data-txt-prt="Sobremesa">Dessert</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-6">
                            <label class="form-label small text-muted mb-2 label-lang"
                                   data-de="Präferenz"
                                   data-en="Preference"
                                   data-esp="Preferencia"
                                   data-prt="Preferência">Präferenz</label>

                            <div class="select-pill">
                                <i class="bi bi-heart text-muted"></i>
                                <select asp-for="Recipe.Preferences" class="form-select border-0 bg-transparent fw-bold shadow-none cursor-pointer">
                                    <option value="" selected disabled class="lang-opt"
                                            data-txt-de="Präferenz"
                                            data-txt-en="Preference"
                                            data-txt-esp="Preferencia"
                                            data-txt-prt="Preferência">Präferenz</option>

                                    <option value="Vegan" class="lang-opt" data-txt-de="Vegan" data-txt-en="Vegan" data-txt-esp="Vegano" data-txt-prt="Vegano">Vegan</option>
                                    <option value="Vegetarian" class="lang-opt" data-txt-de="Vegetarisch" data-txt-en="Vegetarian" data-txt-esp="Vegetariano" data-txt-prt="Vegetariano">Vegetarisch</option>
                                    <option value="Fish" class="lang-opt" data-txt-de="Fisch" data-txt-en="Fish" data-txt-esp="Pescado" data-txt-prt="Peixe">Fisch</option>
                                    <option value="Pork" class="lang-opt" data-txt-de="Schwein" data-txt-en="Pork" data-txt-esp="Cerdo" data-txt-prt="Porco">Schwein</option>
                                    <option value="Beef" class="lang-opt" data-txt-de="Rind" data-txt-en="Beef" data-txt-esp="Res" data-txt-prt="Carne">Rind</option>
                                    <option value="OtherMeat" class="lang-opt" data-txt-de="Anderes Fleisch" data-txt-en="Other Meat" data-txt-esp="Otra carne" data-txt-prt="Outra carne">Anderes Fleisch</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-2 label-lang"
                                   data-de="Personen"
                                   data-en="Persons"
                                   data-esp="Personas"
                                   data-prt="Pessoas">Personen</label>

                            <div class="input-pill">
                                <i class="bi bi-people text-muted"></i>
                                <input asp-for="Recipe.PersonCount"
                                       type="number"
                                       class="form-control border-0 bg-transparent fw-bold shadow-none lang-ph"
                                       placeholder="Personen"
                                       data-ph-de="Personen" data-ph-en="Persons" data-ph-esp="Personas" data-ph-prt="Pessoas" />
                            </div>
                        </div>

                        <div class="col-6">
                            <label class="form-label small text-muted mb-2 label-lang"
                                   data-de="Dauer (Min)"
                                   data-en="Time (min)"
                                   data-esp="Tiempo (min)"
                                   data-prt="Tempo (min)">Dauer (Min)</label>

                            <div class="input-pill">
                                <i class="bi bi-clock text-muted"></i>
                                <input asp-for="Recipe.PreperationTime"
                                       type="number"
                                       class="form-control border-0 bg-transparent fw-bold shadow-none lang-ph"
                                       placeholder="Minuten"
                                       data-ph-de="Minuten" data-ph-en="Minutes" data-ph-esp="Minutos" data-ph-prt="Minutos" />
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 2) MEDIA -->
            <section class="creator-card mb-3" id="card-media">
                <div class="creator-card-head">
                    <div class="d-flex align-items-center gap-2">
                        <div class="card-icon candy-pink"><i class="bi bi-camera-reels"></i></div>
                        <div>
                            <div class="creator-card-title label-lang" data-de="Media" data-en="Media" data-esp="Medios" data-prt="Mídia">Media</div>
                            <div class="creator-card-sub label-lang" data-de="Video oder Bild für den Feed" data-en="Video or image for the feed" data-esp="Video o imagen para el feed" data-prt="Vídeo ou imagem para o feed">
                                Video oder Bild für den Feed
                            </div>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light border">2/5</span>
                </div>

                <div class="creator-card-body">
                    <div id="videoPreviewContainer" class="d-none mb-3">
                        <div class="media-preview">
                            <img id="imagePreview" class="w-100 d-none" style="max-height: 320px; object-fit: cover;" alt="Preview" />
                            <video id="videoPreview" class="w-100" style="max-height: 320px; object-fit: cover;" controls></video>
                            <button type="button" class="btn btn-light btn-sm media-reset" onclick="resetVideo()">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>

                    <label id="uploadLabel" class="upload-drop" for="videoInput">
                        <div class="upload-icon">
                            <i class="bi bi-cloud-arrow-up-fill"></i>
                        </div>
                        <div class="fw-bold mb-1 label-lang"
                             data-de="Upload starten"
                             data-en="Start upload"
                             data-esp="Iniciar subida"
                             data-prt="Iniciar envio">
                            Upload starten
                        </div>

                        <div class="small text-muted label-lang"
                             data-de="Wähle ein Video oder Bild (Feed-Style)."
                             data-en="Choose a video or image (feed style)."
                             data-esp="Elige un video o imagen (estilo feed)."
                             data-prt="Escolha um vídeo ou imagem (estilo feed).">
                            Wähle ein Video oder Bild (Feed-Style).
                        </div>

                        <input asp-for="Content" type="file" accept="video/*,image/*" class="d-none" id="videoInput" onchange="handleVideoUpload(this)" />
                    </label>
                </div>
            </section>

            <!-- 3) INGREDIENTS -->
            <section class="creator-card mb-3" id="card-ingredients">
                <div class="creator-card-head">
                    <div class="d-flex align-items-center gap-2">
                        <div class="card-icon candy-green"><i class="bi bi-basket"></i></div>
                        <div>
                            <div class="creator-card-title label-lang" data-de="Zutaten" data-en="Ingredients" data-esp="Ingredientes" data-prt="Ingredientes">Zutaten</div>
                            <div class="creator-card-sub label-lang" data-de="Suche + hinzufügen wie im Creator Flow" data-en="Search + add like a creator flow" data-esp="Buscar + añadir como flujo" data-prt="Buscar + adicionar como fluxo">
                                Suche + hinzufügen wie im Creator Flow
                            </div>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light border">3/5</span>
                </div>

                <div class="creator-card-body">
                    <div class="mb-2">
                        <input type="text"
                               id="ingredientSearch"
                               class="form-control form-control-sm"
                               placeholder="Zutaten suchen..." />
                    </div>

                    <div class="table-responsive creator-table-wrap">
                        <table id="ingredientsDbTable" class="table table-hover align-middle small border-0 w-100">
                            <thead>
                                <tr>
                                    <th class="small text-muted">Zutat, Menge, Einheit</th>
                                    <th class="d-none" aria-hidden="true"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.ToSelectIngredientsAndNutrients != null)
                                {
                                    foreach (var item in Model.ToSelectIngredientsAndNutrients)
                                    {
                                        <tr class="ingredient-db-row"
                                            data-name-de="@item.Name_DE"
                                            data-name-en="@item.Name_EN"
                                            data-name-esp="@item.Name_ESP"
                                            data-name-prt="@item.Name_PRT">
                                            <td>
                                                <div class="fw-bold display-name">@item.Name_DE</div>

                                                <div class="row g-2 mt-2 ingredient-inline-inputs align-items-end">
                                                    <div class="col-5" style="max-width: 26%">
                                                        <label class="small text-muted">Menge</label>
                                                        <input type="text" inputmode="decimal" class="form-control form-control-sm js-db-qty js-decimal-input" value="0" />
                                                    </div>

                                                    <div class="col-5" style="max-width: 54%">
                                                        <label class="small text-muted">Einheit</label>
                                                        <select class="form-select form-select-sm js-db-unit">
                                                            @if (Model.Measure != null)
                                                            {
                                                                foreach (var measure in Model.Measure)
                                                                {
                                                                    <option value="@measure.UnitOfMeasurement">@measure.UnitOfMeasurement</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>

                                                    <div class="col-2 text-end" style="max-width: fit-content">
                                                        <button type="button" class="btn btn-sm candy-green rounded-circle shadow-sm" onclick="addIngredient('@item.Id', this)">
                                                            <i class="bi bi-plus"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="d-none" aria-hidden="true"></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div id="selectedIngredients" class="mt-3 selected-zone"></div>
                </div>
            </section>

            <!-- 4) STEPS + SANDBOX -->
            <section class="creator-card mb-3" id="card-steps">
                <div class="creator-card-head">
                    <div class="d-flex align-items-center gap-2">
                        <div class="card-icon candy-purple"><i class="bi bi-list-check"></i></div>
                        <div>
                            <div class="creator-card-title label-lang" data-de="Arbeitsschritte" data-en="Steps" data-esp="Pasos" data-prt="Passos">Arbeitsschritte</div>
                            <div class="creator-card-sub label-lang" data-de="Add & sortiere wie ein Script" data-en="Add & order like a script" data-esp="Añadir y ordenar como guion" data-prt="Adicionar e ordenar como roteiro">
                                Add & sortiere wie ein Script
                            </div>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light border">4/5</span>
                </div>

                <div class="creator-card-body">
                    <!-- Sandbox Studio -->
                    <div class="sandbox-studio mt-3">
                        <div class="sandbox-head">
                            <div>
                                <div class="sandbox-title">Sandbox Studio</div>
                                <div class="sandbox-sub">Schnelles Verknüpfen wie in einem Creator-Workflow</div>
                            </div>
                            <span class="badge text-bg-light border">Beta</span>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-5">
                                <div class="sandbox-panel h-100">
                                    <div class="fw-bold small mb-2">Ausgewählte Zutaten</div>
                                    <div id="sandboxIngredientList" class="d-flex flex-column gap-2">
                                        <div class="text-muted small">Noch keine Zutat ausgewählt.</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-7">
                                <div class="sandbox-panel h-100">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="fw-bold small">Vorschläge</div>
                                        <span id="sandboxActiveIngredientLabel" class="badge text-bg-light border">Keine aktive Zutat</span>
                                    </div>

                                    <div class="mb-2">
                                        <input type="text"
                                               id="stepSearch"
                                               class="form-control form-control-sm"
                                               placeholder="Schritte durchsuchen..." />
                                    </div>

                                    <div class="sandbox-tabs" id="sandboxStepTabs" role="tablist">
                                        <button class="sandbox-tab active" type="button" data-sandbox-tab="linked">Verknüpft</button>
                                        <button class="sandbox-tab" type="button" data-sandbox-tab="unbound">Nicht gebunden</button>
                                    </div>

                                    <div id="sandboxStepCandidates" class="d-flex flex-column gap-2 mt-2 sandbox-step-list">
                                        <div class="text-muted small">Wähle links eine Zutat aus.</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <div id="sandboxCurrentStep" class="sandbox-current text-muted">Aktueller Schritt: noch keiner.</div>
                            <div id="sandboxPreviousSteps" class="mt-2 d-flex flex-column gap-2">
                                <div class="text-muted small">Vorherige Schritte erscheinen hier.</div>
                            </div>
                        </div>
                    </div>

                    <div id="selectedSteps" class="mt-3 selected-zone"></div>
                </div>
            </section>

            <!-- 5) KEYWORDS -->
            <section class="creator-card mb-4" id="card-keywords">
                <div class="creator-card-head">
                    <div class="d-flex align-items-center gap-2">
                        <div class="card-icon candy-blue"><i class="bi bi-hash"></i></div>
                        <div>
                            <div class="creator-card-title label-lang" data-de="Keywords" data-en="Keywords" data-esp="Palabras clave" data-prt="Palavras-chave">Keywords</div>
                            <div class="creator-card-sub label-lang" data-de="Hilft beim Feed & bei Suche" data-en="Helps feed & search" data-esp="Ayuda al feed y búsqueda" data-prt="Ajuda no feed e busca">
                                Hilft beim Feed & bei Suche
                            </div>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light border">5/5</span>
                </div>

                <div class="creator-card-body">
                    <div class="d-flex flex-wrap gap-2">
                        @if (Model.ToSelectKeywords != null)
                        {
                            foreach (var keyword in Model.ToSelectKeywords)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary rounded-pill keyword-btn"
                                        data-keyword-id="@keyword.Id"
                                        data-word-de="@keyword.Word_DE"
                                        data-word-en="@keyword.Word_EN"
                                        data-word-esp="@keyword.Word_ESP"
                                        data-word-prt="@keyword.Word_PRT"
                                        onclick="toggleKeyword('@keyword.Id', this)">
                                    @keyword.Word_DE
                                </button>
                            }
                        }
                    </div>

                    <div id="selectedKeywords" class="mt-3 selected-zone"></div>
                </div>
            </section>

            <!-- Bottom Action Bar (Feed Style) -->
            <div class="fixed-bottom creator-bottom p-3">
                <div class="creator-bottom-inner">
                    <div class="d-flex align-items-center gap-2">
                        <div class="bottom-hint">
                            <div class="fw-bold">Bereit zum Posten?</div>
                            <div class="small text-muted">Alles fühlt sich wie ein Feed-Upload an.</div>
                        </div>

                        <button type="submit" class="btn publish-btn w-100">
                            <span class="label-lang" data-de="Veröffentlichen" data-en="Publish" data-esp="Publicar" data-prt="Publicar">Veröffentlichen</span>
                            <i class="bi bi-send-fill ms-2"></i>
                        </button>
                    </div>
                </div>
            </div>

        </form>
    </div>
</div>

<style>
    /* ---------- Background / Shell ---------- */
    .creator-bg {
        background: radial-gradient(900px 420px at 20% 0%, rgba(255, 153, 102, .18), transparent 60%), radial-gradient(900px 520px at 80% 10%, rgba(139, 92, 246, .16), transparent 65%), #ffffff;
    }

    .feed-shell {
        max-width: 720px;
        padding: 12px 12px 120px 12px; /* space for bottom bar */
    }

    /* ---------- Loading Overlay ---------- */
    .creator-loading {
        position: fixed;
        inset: 0;
        background: rgba(255,255,255,0.72);
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
    }

    .creator-loading-card {
        background: #fff;
        border-radius: 18px;
        padding: 20px 24px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.15);
        text-align: center;
        border: 1px solid rgba(0,0,0,0.06);
    }

    /* ---------- Topbar ---------- */
    body > .position-fixed.top-0.end-0.m-3.dropdown {
        z-index: 2601 !important;
    }

    .creator-topbar {
        position: sticky;
        top: 0;
        z-index: 1500;
        background: rgba(255,255,255,0.86);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(0,0,0,0.06);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .topbar-btn {
        width: 42px;
        height: 42px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(0,0,0,0.10);
        background: #fff;
        color: #111;
        text-decoration: none;
    }

    .topbar-primary {
        border: none;
        background: linear-gradient(135deg, #FF9966 0%, #FF5E62 100%);
        color: #fff;
    }

    .topbar-title {
        flex: 1;
        min-width: 0;
        line-height: 1.15;
    }

    /* ---------- Hero ---------- */
    .creator-hero {
        border-radius: 26px;
        background: rgba(255,255,255,0.82);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.06);
        box-shadow: 0 10px 32px rgba(0,0,0,0.06);
        padding: 18px;
        display: flex;
        justify-content: space-between;
        gap: 14px;
        overflow: hidden;
    }

    .creator-hero-title {
        font-size: 1.35rem;
        font-weight: 900;
        color: #111827;
        letter-spacing: -0.01em;
    }

    .creator-hero-sub {
        color: rgba(17,24,39,.70);
        font-size: .95rem;
    }

    .creator-hero-badge {
        display: inline-flex;
        align-items: center;
