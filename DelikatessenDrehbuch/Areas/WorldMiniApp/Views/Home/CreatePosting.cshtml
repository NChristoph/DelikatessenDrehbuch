        color: var(--creator-text);
        min-height: 72px;
    }

    .token-highlight {
        color: #ffe08a;
        text-shadow: 0 0 16px rgba(255,208,95,.35);
        cursor: pointer;
        border-bottom: 1px dashed rgba(255,224,138,.75);
        touch-action: manipulation;
        user-select: none;
        -webkit-tap-highlight-color: rgba(255,224,138,.3);
