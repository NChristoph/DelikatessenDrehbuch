            function updateLanguageLabels() {
                const langKey = resolveLangKey(currentLang);
                $('.label-lang').each(function () { $(this).text($(this).data(langKey)); });
                $('.lang-ph').each(function () { $(this).attr('placeholder', $(this).data('ph-' + langKey)); });
