@model DelikatessenDrehbuch.Areas.WorldMiniApp.Models.WorldUserPosting
@using System.Text.Json

@{
    var stepIngredientBindings = Model.IngredientStepJoins
        .Where(x => x.Preperation != null && x.Ingredient != null)
        .GroupBy(x => x.Preperation.Id)
        .ToDictionary(
            group => group.Key,
            group => group.Select(x => x.Ingredient.Id).Distinct().ToList());
}
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Rezept Erstellen";
    Layout = "_MiniAppLayout";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

<div class="min-vh-100 pb-5 position-relative" style="background: linear-gradient(140deg, #fff8e1 0%, #fff 50%, #f3e5f5 100%);">
    <div id="datatableLoadingOverlay" class="datatable-loading d-none">
        <div class="datatable-loading-card">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Lade...</span>
            </div>
            <div class="fw-bold mt-2">Lade Daten...</div>
            <div class="small text-muted">Einen Moment bitte</div>
        </div>
    </div>

    <div class="px-4 pt-4 pb-2 d-flex justify-content-between align-items-start">
        <div>
            <a href="@Url.Action("Index", "Home", new { area = "WorldMiniApp" })" class="text-decoration-none text-muted mb-3 d-inline-block opacity-75">
                <i class="bi bi-arrow-left"></i> Zurück
            </a>
            <h2 class="fw-bold mb-1" style="color: #2c3e50;">Creator Studio 🥑</h2>
        </div>
    </div>

    <form asp-action="UploadNewVideo" method="post" enctype="multipart/form-data" id="recipeForm" onsubmit="return prepareBinding()" class="pb-5">
        <div class="container px-4">
            <input type="hidden" name="userHash" id="hiddenUserTokenField" />
            <div class="mb-4">
                <label class="fw-bold text-uppercase text-muted small mb-3 opacity-50 label-lang" data-de="Basis Informationen" data-en="Basic Info" data-esp="Información básica" data-prt="Informação básica">Basis Informationen</label>

                <div class="card border-0 shadow-sm p-1 rounded-4 bg-white mb-3">
                    <div class="d-flex align-items-center px-3">
                        <div class="icon-box-small text-muted"><i class="bi bi-fonts"></i></div>
                        <input asp-for="Title" class="form-control border-0 bg-transparent py-3 fw-bold text-dark shadow-none lang-ph"
                               placeholder="Titel"
                               data-ph-de="Titel" data-ph-en="Title" data-ph-esp="Título" data-ph-prt="Título" required />
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <div class="card border-0 shadow-sm p-1 rounded-4 bg-white h-100 d-flex justify-content-center">
                            <select asp-for="Recipe.Category" class="form-select border-0 bg-transparent text-center small fw-bold shadow-none cursor-pointer">
                                <option value="" selected disabled class="lang-opt" data-txt-de="Kategorie" data-txt-en="Category" data-txt-esp="Categoría" data-txt-prt="Categoria">Kategorie</option>
                                <option value="Appetizer" class="lang-opt" data-txt-de="Vorspeise" data-txt-en="Appetizer" data-txt-esp="Entrada" data-txt-prt="Entrada">Vorspeise</option>
                                <option value="Main" class="lang-opt" data-txt-de="Hauptspeise" data-txt-en="Main Course" data-txt-esp="Plato principal" data-txt-prt="Prato principal">Hauptspeise</option>
                                <option value="Dessert" class="lang-opt" data-txt-de="Dessert" data-txt-en="Dessert" data-txt-esp="Postre" data-txt-prt="Sobremesa">Dessert</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card border-0 shadow-sm p-1 rounded-4 bg-white h-100 d-flex justify-content-center">
                            <select asp-for="Recipe.Preferences" class="form-select border-0 bg-transparent text-center small fw-bold shadow-none cursor-pointer">
                                <option value="" selected disabled class="lang-opt" data-txt-de="Präferenz" data-txt-en="Preference" data-txt-esp="Preferencia" data-txt-prt="Preferência">Präferenz</option>
                                <option value="Vegan" class="lang-opt" data-txt-de="Vegan" data-txt-en="Vegan" data-txt-esp="Vegano" data-txt-prt="Vegano">Vegan</option>
                                <option value="Vegetarian" class="lang-opt" data-txt-de="Vegetarisch" data-txt-en="Vegetarian" data-txt-esp="Vegetariano" data-txt-prt="Vegetariano">Vegetarisch</option>
                                <option value="Fish" class="lang-opt" data-txt-de="Fisch" data-txt-en="Fish" data-txt-esp="Pescado" data-txt-prt="Peixe">Fisch</option>
                                <option value="Pork" class="lang-opt" data-txt-de="Schwein" data-txt-en="Pork" data-txt-esp="Cerdo" data-txt-prt="Porco">Schwein</option>
                                <option value="Beef" class="lang-opt" data-txt-de="Rind" data-txt-en="Beef" data-txt-esp="Res" data-txt-prt="Carne">Rind</option>
                                <option value="OtherMeat" class="lang-opt" data-txt-de="Anderes Fleisch" data-txt-en="Other Meat" data-txt-esp="Otra carne" data-txt-prt="Outra carne">Anderes Fleisch</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <div class="card border-0 shadow-sm p-1 rounded-4 bg-white">
                            <input asp-for="Recipe.PersonCount" type="number" class="form-control border-0 bg-transparent py-2 text-center small fw-bold shadow-none lang-ph"
                                   placeholder="Personen"
                                   data-ph-de="Personen" data-ph-en="Persons" data-ph-esp="Personas" data-ph-prt="Pessoas" />
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card border-0 shadow-sm p-1 rounded-4 bg-white">
                            <div class="d-flex align-items-center justify-content-center">
                                <input asp-for="Recipe.PreperationTime" type="number" class="form-control border-0 bg-transparent py-2 text-center small fw-bold shadow-none lang-ph"
                                       placeholder="Minuten"
                                       data-ph-de="Minuten" data-ph-en="Minutes" data-ph-esp="Minutos" data-ph-prt="Minutos" />
                                <span class="small text-muted me-3 opacity-50"><i class="bi bi-clock"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <label class="fw-bold text-uppercase text-muted small mb-3 opacity-50 label-lang" data-de="Media-Drehbuch" data-en="Media Script" data-esp="Guion de medios" data-prt="Roteiro de mídia">Media-Drehbuch</label>
                <div id="videoPreviewContainer" class="d-none mb-3">
                    <div class="card border-0 shadow-lg rounded-4 overflow-hidden position-relative bg-dark">
                        <img id="imagePreview" class="w-100 d-none" style="max-height: 250px; object-fit: cover;" alt="Preview" />
                        <video id="videoPreview" class="w-100" style="max-height: 250px; object-fit: cover;" controls></video>
                        <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2 rounded-circle" onclick="resetVideo()"><i class="bi bi-x"></i></button>
                    </div>
                </div>
                <label id="uploadLabel" class="diet-card-upload card border-0 shadow-sm p-4 rounded-4 cursor-pointer text-center w-100" for="videoInput">
                    <div class="icon-box mx-auto mb-2 rounded-circle candy-blue" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-cloud-arrow-up-fill fs-3 text-primary"></i>
                    </div>
                    <span class="fw-bold label-lang" data-de="Video oder Bild wählen" data-en="Select Video or Image" data-esp="Seleccionar video o imagen" data-prt="Selecionar vídeo ou imagem">Video oder Bild wählen</span>
                    <input asp-for="Content" type="file" accept="video/*,image/*" class="d-none" id="videoInput" onchange="handleVideoUpload(this)" />
                </label>
            </div>

            <div class="mb-4">
                <label class="fw-bold text-uppercase text-muted small mb-3 opacity-50 label-lang" data-de="Zutaten wählen" data-en="Select Ingredients" data-esp="Seleccionar ingredientes" data-prt="Selecionar ingredientes">Zutaten wählen</label>
                <div class="card border-0 shadow-sm p-3 rounded-4 bg-white-glass">
                    <div class="table-responsive">
                        <table id="ingredientsDbTable" class="table table-hover align-middle small border-0 w-100">
                            <thead><tr><th class="small text-muted">Zutat + Menge</th><th class="small text-muted text-end">Hinzufügen</th></tr></thead>
                            <tbody>
                                @if (Model.ToSelectIngredientsAndNutrients != null)
                                {
                                    foreach (var item in Model.ToSelectIngredientsAndNutrients)
                                    {
                                        <tr class="ingredient-db-row" data-name-de="@item.Name_DE" data-name-en="@item.Name_EN" data-name-esp="@item.Name_ESP" data-name-prt="@item.Name_PRT">
                                            <td>
                                                <div class="fw-bold display-name">@item.Name_DE</div>
                                                <div class="row g-2 mt-1 ingredient-inline-inputs">
                                                    <div class="col-6">
                                                        <label class="small text-muted">Menge</label>
                                                        <input type="text" inputmode="decimal" class="form-control form-control-sm js-db-qty js-decimal-input" value="0" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="small text-muted">Einheit</label>
                                                        <select class="form-select form-select-sm js-db-unit">
                                                            @if (Model.Measure != null)
                                                            {
                                                                foreach (var measure in Model.Measure)
                                                                {
                                                                    <option value="@measure.UnitOfMeasurement">@measure.UnitOfMeasurement</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-end align-top">
                                                <button type="button" class="btn btn-sm candy-green rounded-circle shadow-sm" onclick="addIngredient('@item.Id', this)"><i class="bi bi-plus"></i></button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div id="selectedIngredients" class="mt-3"></div>
                </div>
            </div>

            <div class="mb-4">
                <label class="fw-bold text-uppercase text-muted small mb-3 opacity-50 label-lang" data-de="Arbeitsschritte" data-en="Steps" data-esp="Pasos" data-prt="Passos">Arbeitsschritte</label>
                <div class="card border-0 shadow-sm p-3 rounded-4 bg-white-glass">
                    <div class="table-responsive">
                        <table id="stepsDbTable" class="table table-hover align-middle small border-0 w-100">
                            <thead><tr class="d-none"><th>Text</th><th>Add</th></tr></thead>
                            <tbody>
                                @if (Model.ToSelectRecipePreperationSteps != null)
                                {
                                    foreach (var step in Model.ToSelectRecipePreperationSteps)
                                    {
                                        <tr class="step-db-row" data-step-id="@step.Id" data-step-de="@step.Step_DE" data-step-en="@step.Step_EN" data-step-esp="@step.Step_ESP" data-step-prt="@step.Step_PRT">
                                            <td class="small display-step text-muted">@step.Step_DE</td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm candy-pink rounded-circle shadow-sm" onclick="addStep('@step.Id', this)"><i class="bi bi-arrow-down"></i></button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-3 border rounded-4 p-3 bg-white">
                        <div class="small fw-bold text-uppercase text-muted mb-2">Sandbox Modus</div>
                        <div class="row g-3">
                            <div class="col-md-5">
                                <div class="sandbox-box h-100">
                                    <div class="fw-bold small mb-2">Ausgewählte Zutaten</div>
                                    <div id="sandboxIngredientList" class="d-flex flex-column gap-2">
                                        <div class="text-muted small">Noch keine Zutat ausgewählt.</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-7">
                                <div class="sandbox-box h-100">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="fw-bold small">Verknüpfte Schritte</div>
                                        <span id="sandboxActiveIngredientLabel" class="badge text-bg-light border">Keine aktive Zutat</span>
                                    </div>
                                    <ul class="nav nav-pills nav-fill mb-2" id="sandboxStepTabs" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link active" type="button" data-sandbox-tab="linked">Verknüpft</button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link" type="button" data-sandbox-tab="unbound">Nicht gebunden</button>
                                        </li>
                                    </ul>
                                    <div id="sandboxStepCandidates" class="d-flex flex-column gap-2">
                                        <div class="text-muted small">Wähle links eine Zutat aus.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <div id="sandboxCurrentStep" class="sandbox-current-step text-muted">Aktueller Schritt: noch keiner.</div>
                            <div id="sandboxPreviousSteps" class="mt-2 d-flex flex-column gap-2">
                                <div class="text-muted small">Vorherige Schritte erscheinen hier.</div>
                            </div>
                        </div>
                    </div>
                    <div id="selectedSteps" class="mt-3"></div>
                </div>
            </div>

            <div class="mb-4">
                <label class="fw-bold text-uppercase text-muted small mb-3 opacity-50 label-lang" data-de="Keywords wählen" data-en="Select Keywords" data-esp="Seleccionar palabras clave" data-prt="Selecionar palavras-chave">Keywords wählen</label>
                <div class="card border-0 shadow-sm p-3 rounded-4 bg-white-glass">
                    <div class="d-flex flex-wrap gap-2">
                        @if (Model.ToSelectKeywords != null)
                        {
                            foreach (var keyword in Model.ToSelectKeywords)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary rounded-pill keyword-btn"
                                        data-keyword-id="@keyword.Id"
                                        data-word-de="@keyword.Word_DE"
                                        data-word-en="@keyword.Word_EN"
                                        data-word-esp="@keyword.Word_ESP"
                                        data-word-prt="@keyword.Word_PRT"
                                        onclick="toggleKeyword('@keyword.Id', this)">
                                    @keyword.Word_DE
                                </button>
                            }
                        }
                    </div>
                    <div id="selectedKeywords" class="mt-3"></div>
                </div>
            </div>
        </div>

        <div class="fixed-bottom p-3" style="background: linear-gradient(to top, #f3e5f5 0%, transparent 100%); pointer-events: none;">
            <div style="pointer-events: auto;">
                <button type="submit" class="btn border-0 w-100 py-3 rounded-pill fw-bold shadow-lg text-white" style="background: linear-gradient(135deg, #FF9966 0%, #FF5E62 100%);">
                    <span class="label-lang" data-de="Veröffentlichen" data-en="Publish" data-esp="Publicar" data-prt="Publicar">Veröffentlichen</span>
                    <i class="bi bi-send-fill ms-2"></i>
                </button>
            </div>
        </div>
    </form>
</div>

<style>
    .bg-white-glass {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
    }

    .candy-blue {
        background-color: #e3f2fd !important;
    }

    .candy-green {
        background-color: #f0fdf4 !important;
        color: #22c55e !important;
        border: none;
    }

    .candy-pink {
        background-color: #fdf2f8 !important;
        color: #ec4899 !important;
        border: none;
    }

    .candy-purple {
        background-color: #f5f3ff !important;
        color: #8b5cf6 !important;
    }

    .dynamic-item {
        background: white;
        border-radius: 18px;
        padding: 12px;
        margin-bottom: 10px;
        border: 1px solid rgba(0,0,0,0.03);
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
    }

    .cursor-pointer {
        cursor: pointer;
    }

    .datatable-loading {
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(6px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
    }

    .datatable-loading-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 20px 24px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.15);
        text-align: center;
    }
    /* Verhindert den blauen Fokus-Rahmen bei Inputs für cleaneres Design */
    .form-control:focus, .form-select:focus {
        box-shadow: none;
        border-color: transparent;
    }

    .sandbox-box {
        border: 1px solid rgba(0,0,0,0.08);
        border-radius: 14px;
        padding: 10px;
        background: #fafafa;
    }

    .sandbox-ingredient-btn.active {
        border-color: #8b5cf6;
        background: #f3e8ff;
        color: #6d28d9;
    }

    .sandbox-step-candidate {
        text-align: left;
    }

    #ingredientsDbTable .ingredient-inline-inputs .form-control,
    #ingredientsDbTable .ingredient-inline-inputs .form-select {
        min-height: 38px;
    }

    #sandboxStepTabs .nav-link {
        font-size: .8rem;
        border-radius: 999px;
    }

    .sandbox-current-step {
        border-left: 4px solid #8b5cf6;
        background: #f5f3ff;
        border-radius: 10px;
        padding: 10px;
    }
</style>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        // Einheiten aus der DB laden
        var dbUnits = @Html.Raw(JsonConvert.SerializeObject(Model.Measure?.Select(x => x.UnitOfMeasurement).ToList() ?? new List<string>()));
        function getCookieValue(name) {
            const cookie = document.cookie
                .split('; ')
                .find(row => row.startsWith(`${name}=`));
            return cookie ? decodeURIComponent(cookie.split('=')[1]) : null;
        }

        function resolveLangKey(value) {
            const normalized = (value || 'de').toLowerCase();
            if (normalized === 'es') return 'esp';
            if (normalized === 'pt') return 'prt';
            return normalized;
        }

        let currentLang = resolveLangKey(getCookieValue('deli-lang'));

        let ingredientsTable;
        let stepsTable;
        let activeSandboxIngredientId = null;
        let activeSandboxIngredientName = '';
        let activeSandboxTab = 'linked';
        const stepIngredientBindings = @Html.Raw(JsonSerializer.Serialize(stepIngredientBindings));

        function setDataTableLoading(isLoading) {
            const overlay = document.getElementById('datatableLoadingOverlay');
            if (!overlay) return;
            overlay.classList.toggle('d-none', !isLoading);
        }

        $(document).ready(function() {
            setDataTableLoading(true);
            // DataTables initialisieren
            ingredientsTable = $('#ingredientsDbTable').DataTable({
                pageLength: 9, lengthChange: false, info: false, searching: true,
                language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/de-DE.json' },
                columns: [
                    { orderable: true },
                    { orderable: false, searchable: false }
                ]
            });
            stepsTable = $('#stepsDbTable').DataTable({
                pageLength: 9, lengthChange: false, info: false, searching: true,
                language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/de-DE.json' }
            });

            $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
                if (settings.nTable.id !== 'stepsDbTable') {
                    return true;
                }

                const rowNode = stepsTable.row(dataIndex).node();
                const stepId = parseInt($(rowNode).attr('data-step-id'), 10);
                if (isNaN(stepId)) {
                    return true;
                }

                const selectedIngredientIds = getSelectedIngredientIds();
                return isStepBoundToSelectedIngredients(stepId, selectedIngredientIds);
            });

            ingredientsTable.on('draw', function() {
                updateLanguageLabels();
            });
            stepsTable.on('draw', function() {
                updateLanguageLabels();
            });

            updateLanguageLabels();
            refreshStepsByIngredientSelection();
            renderSandboxIngredientList();
            refreshSandboxProgress();
            renderSandboxStepTab();
            setDataTableLoading(false);
        });

        function getSelectedIngredientIds() {
            return $('#selectedIngredients input[name$="IngredientsAndNutrients.Id"]')
                .map(function() { return parseInt($(this).val(), 10); })
                .get()
                .filter(id => !isNaN(id));
        }

        function getSelectedIngredientsForSandbox() {
            return $('#selectedIngredients .ingredient-row').map(function() {
                const row = $(this);
                const id = row.find('input[name$="IngredientsAndNutrients.Id"]').val()?.toString() || '';
                const name = row.find('.display-name-selected').text()?.trim() || 'Zutat';
                return { id, name };
            }).get();
        }

        function renderSandboxStepCandidates(stepIds, emptyText = 'Keine verknüpften Schritte gefunden.') {
            const container = $('#sandboxStepCandidates');
            container.empty();

            if (!stepIds || !stepIds.length) {
                container.append(`<div class="text-muted small">${emptyText}</div>`);
                return;
            }

            const langKey = resolveLangKey(currentLang);
            stepIds.forEach(stepId => {
                const sourceRow = $(`#stepsDbTable .step-db-row[data-step-id="${stepId}"]`);
                if (!sourceRow.length) return;
                const label = sourceRow.data('step-' + langKey) || sourceRow.data('step-de') || `Step ${stepId}`;
                const btn = $(`<button type="button" class="btn btn-outline-secondary btn-sm sandbox-step-candidate"><i class="bi bi-plus-circle me-1"></i>${label}</button>`);
                btn.on('click', function() { addStep(stepId.toString(), null, label); });
                container.append(btn);
            });

            if (!container.children().length) {
                container.append(`<div class="text-muted small">${emptyText}</div>`);
            }
        }

        function loadSandboxUnboundSteps() {
            const allStepIds = $('#stepsDbTable .step-db-row').map(function() {
                return parseInt($(this).attr('data-step-id'), 10);
            }).get().filter(x => !isNaN(x));

            const unboundStepIds = allStepIds.filter(stepId => {
                const boundIngredientIds = stepIngredientBindings[stepId] ?? stepIngredientBindings[stepId.toString()] ?? [];
                return !Array.isArray(boundIngredientIds) || boundIngredientIds.length === 0;
            });

            renderSandboxStepCandidates(unboundStepIds, 'Keine ungebundenen Schritte gefunden.');
        }

        function renderSandboxStepTab() {
            if (activeSandboxTab === 'unbound') {
                $('#sandboxActiveIngredientLabel').text('Ungebundene Schritte');
                loadSandboxUnboundSteps();
                return;
            }

            $('#sandboxActiveIngredientLabel').text(activeSandboxIngredientName || 'Keine aktive Zutat');
            loadSandboxStepsForActiveIngredient();
        }

        function loadSandboxStepsForActiveIngredient() {
            if (!activeSandboxIngredientId) {
                renderSandboxStepCandidates([]);
                return;
            }

            const stepIds = Object.entries(stepIngredientBindings)
                .filter(([_, ingredientIds]) => Array.isArray(ingredientIds) && ingredientIds.map(x => x.toString()).includes(activeSandboxIngredientId.toString()))
                .map(([stepId, _]) => parseInt(stepId, 10))
                .filter(x => !isNaN(x));

            renderSandboxStepCandidates(stepIds);
        }

        function renderSandboxIngredientList() {
            const container = $('#sandboxIngredientList');
            const selectedIngredients = getSelectedIngredientsForSandbox();
            container.empty();

            if (!selectedIngredients.length) {
                activeSandboxIngredientId = null;
                activeSandboxIngredientName = '';
                container.append('<div class="text-muted small">Noch keine Zutat ausgewählt.</div>');
                if (activeSandboxTab === 'unbound') {
                    renderSandboxStepTab();
                } else {
                    $('#sandboxActiveIngredientLabel').text('Keine aktive Zutat');
                    renderSandboxStepCandidates([]);
                }
                return;
            }

            if (!selectedIngredients.some(x => x.id === activeSandboxIngredientId)) {
                activeSandboxIngredientId = selectedIngredients[0].id;
                activeSandboxIngredientName = selectedIngredients[0].name;
            }

            selectedIngredients.forEach(item => {
                const active = item.id === activeSandboxIngredientId ? 'active' : '';
                const btn = $(`<button type="button" class="btn btn-outline-secondary btn-sm sandbox-ingredient-btn ${active}" data-id="${item.id}" data-name="${item.name}">${item.name}</button>`);
                container.append(btn);
            });

            renderSandboxStepTab();
        }

        function refreshSandboxProgress() {
            const rows = $('#selectedSteps .step-row');
            const current = $('#sandboxCurrentStep');
            const previous = $('#sandboxPreviousSteps');
            previous.empty();

            if (!rows.length) {
                current.text('Aktueller Schritt: noch keiner.').addClass('text-muted');
                previous.append('<div class="text-muted small">Vorherige Schritte erscheinen hier.</div>');
                return;
            }

            const currentRow = rows.last();
            const currentIdx = currentRow.find('.step-index-input').val() || rows.length;
            const currentText = currentRow.find('.display-step-selected').text() || '';
            current.removeClass('text-muted').html(`<strong>Aktueller Schritt ${currentIdx}:</strong> ${currentText}`);

            rows.slice(0, -1).get().reverse().forEach(r => {
                const row = $(r);
                const idx = row.find('.step-index-input').val() || '';
                const txt = row.find('.display-step-selected').text() || '';
                previous.append(`<div class="border rounded p-2 bg-light"><strong>Schritt ${idx}:</strong> ${txt}</div>`);
            });

            if (!rows.slice(0, -1).length) {
                previous.append('<div class="text-muted small">Noch keine vorherigen Schritte.</div>');
            }
        }

        function isStepBoundToSelectedIngredients(stepId, selectedIngredientIds) {
            if (!Array.isArray(selectedIngredientIds) || selectedIngredientIds.length === 0) {
                return true;
            }

            const boundIngredientIds = stepIngredientBindings[stepId] ?? [];
            if (boundIngredientIds.length === 0) {
                return false;
            }

            return boundIngredientIds.some(boundId => selectedIngredientIds.includes(boundId));
        }

        function refreshStepsByIngredientSelection() {
            if (!stepsTable) {
                return;
            }

            stepsTable.draw();
        }

        function updateLanguageLabels() {
            const langKey = resolveLangKey(currentLang);

            // 2. Statische Labels (h2, labels, button text)
            $('.label-lang').each(function() {
                $(this).text($(this).data(langKey));
            });

            // 3. Input Placeholders
            $('.lang-ph').each(function() {
                $(this).attr('placeholder', $(this).data('ph-' + langKey));
            });

            // 4. Dropdown Optionen (nur der angezeigte Text, nicht der Value!)
            $('.lang-opt').each(function() {
                $(this).text($(this).data('txt-' + langKey));
            });

            // 5. DB Listen Items (Ingredients/Steps in der Tabelle)
            $('.ingredient-db-row').each(function() { $(this).find('.display-name').text($(this).data('name-' + langKey)); });
            $('.step-db-row').each(function() { $(this).find('.display-step').text($(this).data('step-' + langKey)); });
            $('.keyword-btn').each(function() { $(this).text($(this).data('word-' + langKey)); });
            $('.keyword-pill').each(function() {
                $(this).find('.keyword-text').text($(this).data('word-' + langKey));
            });

            renderSandboxStepTab();
        }

        // Video Preview Logic
        function handleVideoUpload(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const fileUrl = URL.createObjectURL(file);
                const isVideo = file.type.startsWith('video/');

                if (isVideo) {
                    $('#videoPreview').attr('src', fileUrl).removeClass('d-none');
                    $('#imagePreview').addClass('d-none').attr('src', '');
                } else {
                    $('#imagePreview').attr('src', fileUrl).removeClass('d-none');
                    $('#videoPreview').addClass('d-none').attr('src', '');
                }

                $('#videoPreviewContainer').removeClass('d-none');
                $('#uploadLabel').addClass('d-none');
            }
        }

        function resetVideo() {
            $('#videoInput').val('');
            $('#videoPreviewContainer').addClass('d-none');
            $('#uploadLabel').removeClass('d-none');
            $('#videoPreview').attr('src', '');
            $('#imagePreview').attr('src', '').addClass('d-none');
        }

        // Zutat hinzufügen
        function addIngredient(id, btn) {
            const existing = $('#selectedIngredients input[name$="IngredientsAndNutrients.Id"]').filter(function() {
                return $(this).val()?.toString() === id.toString();
            }).length > 0;

            if (existing) {
                return;
            }

            const row = $(btn).closest('tr');
            const name = row.data('name-' + currentLang.toLowerCase());
            const selectedQuantity = normalizeDecimalInputValue(row.find('.js-db-qty').val()) || '0';
            const selectedUnit = row.find('.js-db-unit').val() || (dbUnits[0] ?? 'Gramm');
            let unitOptions = dbUnits.map(u => `<option value="${u}" ${u === selectedUnit ? 'selected' : ''}>${u}</option>`).join('');

            const html = `<div class="dynamic-item ingredient-row">
                <input type="hidden" name="IngredientMeasureQuantity[INDEX].IngredientsAndNutrients.Id" value="${id}" />
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1 small fw-bold display-name-selected text-dark">${name}</div>
                    <button type="button" class="btn btn-sm text-danger opacity-50" onclick="removeIngredientRow(this)"><i class="bi bi-trash3"></i></button>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <input type="text" inputmode="decimal" name="IngredientMeasureQuantity[INDEX].Quantity.Quantitys" class="form-control form-control-sm border-0 candy-purple rounded-3 fw-bold text-center js-decimal-input" style="width:90px" placeholder="0,0" value="${selectedQuantity}" />
                    <select name="IngredientMeasureQuantity[INDEX].Measure.UnitOfMeasurement" class="form-select form-select-sm border-0 candy-purple rounded-3 fw-bold">
                        ${unitOptions}
                    </select>
                </div>
            </div>`;
            $('#selectedIngredients').append(html);
            refreshStepsByIngredientSelection();
            renderSandboxIngredientList();
        }

        function removeIngredientRow(btn) {
            $(btn).closest('.ingredient-row').remove();
            refreshStepsByIngredientSelection();
            renderSandboxIngredientList();
        }

        // Schritt hinzufügen
        function addStep(id, btn, manualText = null) {
            const alreadySelected = $('#selectedSteps .step-row').filter(function() {
                return $(this).data('step-id')?.toString() === id.toString();
            }).length > 0;

            if (alreadySelected) {
                return;
            }

            const text = manualText || (btn ? $(btn).closest('tr').data('step-' + currentLang.toLowerCase()) : null) || `Schritt ${id}`;

            const html = `<div class="dynamic-item d-flex align-items-center step-row" draggable="true" data-step-id="${id}">
                <input type="hidden" name="RecipePreperationSteps[INDEX].PreperationStepId" value="${id}" />
                <input type="hidden" class="step-index-input" name="RecipePreperationSteps[INDEX].StepIndex" value="0" />
                <div class="badge candy-purple rounded-pill me-3 step-badge">0</div>
                <div class="small flex-grow-1 display-step-selected text-muted">${text}</div>
                <div class="btn-group ms-2" role="group">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="moveStepRow(this, -1)" title="Schritt nach oben"><i class="bi bi-arrow-up"></i></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="moveStepRow(this, 1)" title="Schritt nach unten"><i class="bi bi-arrow-down"></i></button>
                    <button type="button" class="btn btn-sm text-danger opacity-50" onclick="$(this).closest('.step-row').remove(); updateStepIndices();"><i class="bi bi-trash3"></i></button>
                </div>
            </div>`;
            $('#selectedSteps').append(html);
            updateStepIndices();
            refreshSandboxProgress();
        }

        function toggleKeyword(id, btn) {
            const container = $('#selectedKeywords');
            const existing = container.find(`.keyword-pill[data-keyword-id="${id}"]`);

            if (existing.length > 0) {
                existing.remove();
                $(btn).removeClass('btn-secondary').addClass('btn-outline-secondary');
                return;
            }

            const langKey = currentLang.toLowerCase();
            const word = $(btn).data('word-' + langKey);

            const html = `<div class="keyword-pill badge rounded-pill bg-secondary text-white d-inline-flex align-items-center me-2 mb-2"
                data-keyword-id="${id}"
                data-word-de="${$(btn).data('word-de')}"
                data-word-en="${$(btn).data('word-en')}"
                data-word-esp="${$(btn).data('word-esp')}"
                data-word-prt="${$(btn).data('word-prt')}">
                <input type="hidden" name="SelectedKeywordIds" value="${id}" />
                <span class="me-2 keyword-text">${word}</span>
                <button type="button" class="btn btn-sm btn-light rounded-circle p-0" style="width:20px;height:20px;line-height:1;" onclick="removeKeyword('${id}')">
                    <i class="bi bi-x"></i>
                </button>
            </div>`;
            container.append(html);
            $(btn).removeClass('btn-outline-secondary').addClass('btn-secondary');
        }

        function removeKeyword(id) {
            const container = $('#selectedKeywords');
            container.find(`.keyword-pill[data-keyword-id="${id}"]`).remove();
            $(`.keyword-btn[data-keyword-id="${id}"]`).removeClass('btn-secondary').addClass('btn-outline-secondary');
        }

        // Schritt-Nummern aktualisieren
        function updateStepIndices() {
            $('#selectedSteps .step-row').each(function(i) {
                $(this).find('.step-badge').text(i + 1);
                $(this).find('.step-index-input').val(i + 1);
            });
            refreshSandboxProgress();
        }

        // Model Binding Vorbereitung (Indices korrigieren)
        function normalizeDecimalInputValue(value) {
            if (!value) return value;
            return value.toString().trim().replace(/\s/g, '').replace(',', '.');
        }

        function prepareBinding() {
            updateStepIndices();
            $('.ingredient-row').each(function(i) {
                $(this).find('input, select').each(function() {
                    if (this.name) this.name = this.name.replace(/\[.*?\]/, '[' + i + ']');
                });
            });
            $('.step-row').each(function(i) {
                $(this).find('input, select').each(function() {
                    if (this.name) this.name = this.name.replace(/\[.*?\]/, '[' + i + ']');
                });
            });

            $('input[name$=".Quantity.Quantitys"], .js-decimal-input').each(function() {
                this.value = normalizeDecimalInputValue(this.value);
            });

            return true;
        }

        function moveStepRow(btn, direction) {
            const row = $(btn).closest('.step-row');
            if (direction < 0) {
                const prev = row.prev('.step-row');
                if (prev.length) prev.before(row);
            } else {
                const next = row.next('.step-row');
                if (next.length) next.after(row);
            }
            updateStepIndices();
        }

        let draggedStepRow = null;
        $('#selectedSteps').on('dragstart', '.step-row', function(e) {
            draggedStepRow = this;
            e.originalEvent.dataTransfer.effectAllowed = 'move';
            $(this).addClass('opacity-50');
        });

        $('#selectedSteps').on('dragend', '.step-row', function() {
            $(this).removeClass('opacity-50');
            draggedStepRow = null;
        });

        $('#selectedSteps').on('dragover', '.step-row', function(e) {
            e.preventDefault();
            if (!draggedStepRow || draggedStepRow === this) return;
            const rect = this.getBoundingClientRect();
            const offset = e.originalEvent.clientY - rect.top;
            if (offset > rect.height / 2) {
                $(this).after(draggedStepRow);
            } else {
                $(this).before(draggedStepRow);
            }
            updateStepIndices();
        });

        $('#sandboxIngredientList').on('click', '.sandbox-ingredient-btn', function() {
            activeSandboxIngredientId = $(this).data('id')?.toString() || null;
            activeSandboxIngredientName = $(this).data('name')?.toString() || '';
            activeSandboxTab = 'linked';
            $('#sandboxStepTabs .nav-link').removeClass('active');
            $('#sandboxStepTabs .nav-link[data-sandbox-tab="linked"]').addClass('active');
            $('#sandboxIngredientList .sandbox-ingredient-btn').removeClass('active');
            $(this).addClass('active');
            renderSandboxStepTab();
        });

        $('#sandboxStepTabs').on('click', '.nav-link', function() {
            activeSandboxTab = $(this).data('sandbox-tab')?.toString() || 'linked';
            $('#sandboxStepTabs .nav-link').removeClass('active');
            $(this).addClass('active');
            renderSandboxStepTab();
        });

            document.addEventListener("DOMContentLoaded", function() {
            var token = sessionStorage.getItem("UserToken") || localStorage.getItem("UserToken");
            if (token) {
                document.getElementById("hiddenUserTokenField").value = token;
            }
        });
    </script>
}
