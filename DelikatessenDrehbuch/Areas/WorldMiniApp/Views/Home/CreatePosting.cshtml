        .creator-topbar[data-theme="navy"] .theme-switch-btn.is-active[data-create-posting-theme="profile"] {
            background: linear-gradient(135deg, #7fb3ff 0%, #3c67c8 100%);
            color: #fff;
        }
            background: linear-gradient(135deg, #7fb3ff 0%, #3c67c8 100%);
            color: #fff;
