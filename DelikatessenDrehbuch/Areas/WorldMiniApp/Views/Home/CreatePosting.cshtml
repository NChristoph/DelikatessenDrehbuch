@section Scripts {
    <script src="~/js/create-posting-utils.js" asp-append-version="true"></script>
    <script src="~/js/create-posting-data-urls.js" asp-append-version="true"></script>
    <script src="~/js/create-posting-data-store.js" asp-append-version="true"></script>
    <script src="~/js/create-posting-feedback.js" asp-append-version="true"></script>
    <script src="~/js/create-posting-page-data.js" asp-append-version="true"></script>
    <script src="~/js/create-posting-template-builder.js" asp-append-version="true"></script>
    <script src="~/js/create-posting-template-draft-engine.js" asp-append-version="true"></script>
    <script src="~/js/create-posting-step-filter-ui.js" asp-append-version="true"></script>
    <script defer src="~/js/CreatePostingSmartStepCreator.js" asp-append-version="true"></script>
    <script defer src="~/js/master-step-renderer.js" asp-append-version="true"></script>
    <script defer src="~/js/recipe-step-suggest.js" asp-append-version="true"></script>
    <script>
        window.CreatePostingPageConfig = {
            upsertStepUrl: "@Url.Action("UpsertStep", "Home", new { area = "WorldMiniApp" })",
            suggestMissingIngredientUrl: "@Url.Action("SuggestMissingIngredient", "Home", new { area = "WorldMiniApp" })",
            saveSuggestedIngredientUrl: "@Url.Action("SaveSuggestedIngredient", "Home", new { area = "WorldMiniApp" })"
        };
    </script>
    <script defer src="~/js/create-posting-probability.js" asp-append-version="true"></script>
    <script defer src="~/js/CreatePostingPage.js" asp-append-version="true"></script>
    <script defer src="~/js/create-posting-publish-checklist.js" asp-append-version="true"></script>

    <!-- Scroll-Spy & Tab Navigation -->
    <script>
        // ========================================
        // Scroll-Spy & Tab Navigation
        // ========================================

        let completionStates = {
            'card-basics': false,
            'card-media': false,
            'card-ingredients': false,
            'card-steps': false,
            'card-keywords': false
        };

        function initScrollSpy() {
            const tabs = document.querySelectorAll('.cp-tab');
            const sections = document.querySelectorAll('.cp-section');
            const feed = document.getElementById('cpFeed');

            // Tab Click Handler
            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    const targetId = tab.getAttribute('data-section');
                    scrollToSection(targetId);
                });
            });

            // Scroll Observer for active tab highlighting
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const id = entry.target.id;
                        tabs.forEach(t => {
                            if (t.getAttribute('data-section') === id) {
                                tabs.forEach(tab => tab.classList.remove('active'));
                                t.classList.add('active');
                            }
                        });
                    }
                });
            }, {
                root: feed,
                threshold: 0.3,
                rootMargin: '-100px 0px -100px 0px'
            });

            sections.forEach(section => observer.observe(section));
        }

        function scrollToSection(sectionId) {
            const section = document.getElementById(sectionId);
            if (section) {
                section.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        function updateCompletionStates() {
            // Basis
            const title = document.querySelector('input[name="Title"]').value.trim();
            const category = document.querySelector('select[name="Recipe.Category"]').value;
            completionStates['card-basics'] = !!(title && category);

            // Media
            const videoPreview = document.getElementById('videoPreviewContainer');
            const hasMedia = !videoPreview.classList.contains('d-none');
            completionStates['card-media'] = hasMedia || @(isEditMode ? "true" : "false");

            // Ingredients
            const selectedIngredients = document.getElementById('selectedIngredients');
            completionStates['card-ingredients'] = selectedIngredients.children.length > 0;

            // Steps (check if SmartStepCreator has steps)
            const stepsList = document.getElementById('smartStepCreatorStepsList') || document.getElementById('selectedSteps');
            completionStates['card-steps'] = stepsList && stepsList.children.length > 0;

            // Keywords
            const selectedKeywords = document.getElementById('selectedKeywords');
            completionStates['card-keywords'] = selectedKeywords.children.length > 0;

            // Update UI
            updateCompletionUI();
        }

        function updateCompletionUI() {
            let completedCount = 0;
            const total = 5;

            Object.keys(completionStates).forEach((id, index) => {
                const isComplete = completionStates[id];
                if (isComplete) completedCount++;

                const section = document.getElementById(id);
                const counter = section.querySelector('.cp-section-counter');
                const icon = section.querySelector('.cp-section-icon');

                if (isComplete) {
                    section.classList.add('complete');
                    icon.innerHTML = '<i class="bi bi-check-lg"></i>';
                } else {
                    section.classList.remove('complete');
                    // Restore original icon
                    const icons = ['bi-ui-checks-grid', 'bi-camera-reels', 'bi-basket', 'bi-list-ol', 'bi-hash'];
                    icon.innerHTML = `<i class="bi ${icons[index]}"></i>`;
                }
            });

            // Update top bar
            const topProgress = document.getElementById('creatorTopbarProgress');
            topProgress.textContent = `${completedCount}/5 bereit`;

            // Update publish bar
            const progressBar = document.getElementById('publishProgressBar');
            const publishBtn = document.getElementById('publishBtn');
            const percentage = (completedCount / total) * 100;
            progressBar.style.width = `${percentage}%`;

            if (completedCount === total) {
                progressBar.classList.add('complete');
                publishBtn.disabled = false;
            } else {
                progressBar.classList.remove('complete');
                publishBtn.disabled = true;
            }

            // Update tab checkmarks
            document.querySelectorAll('.cp-tab').forEach((tab, index) => {
                const sectionId = tab.getAttribute('data-section');
                const isComplete = completionStates[sectionId];

                // Remove existing checkmark
                const existingCheck = tab.querySelector('.cp-tab-check');
                if (existingCheck) existingCheck.remove();

                // Add checkmark if complete
                if (isComplete) {
                    const check = document.createElement('span');
                    check.className = 'cp-tab-check';
                    check.innerHTML = '<i class="bi bi-check" style="font-size:10px;color:white;"></i>';
                    tab.appendChild(check);
                }
            });
        }

        // Monitor form changes
        function setupCompletionMonitoring() {
            // Title & selects
            document.querySelectorAll('#card-basics input, #card-basics select').forEach(el => {
                el.addEventListener('change', updateCompletionStates);
                el.addEventListener('input', updateCompletionStates);
            });

            // Media upload
            const videoInput = document.getElementById('videoInput');
            if (videoInput) {
                const originalHandler = window.handleVideoUpload;
                window.handleVideoUpload = function(input) {
                    originalHandler(input);
                    setTimeout(updateCompletionStates, 100);
                };
            }

            // Ingredients (use MutationObserver)
            const selectedIngredients = document.getElementById('selectedIngredients');
            if (selectedIngredients) {
                new MutationObserver(updateCompletionStates).observe(selectedIngredients, {
                    childList: true,
                    subtree: true
                });
            }

            // Steps (MutationObserver)
            const stepsList = document.getElementById('smartStepCreatorStepsList') || document.getElementById('selectedSteps');
            if (stepsList) {
                new MutationObserver(updateCompletionStates).observe(stepsList, {
                    childList: true,
                    subtree: true
                });
            }

            // Keywords
            const selectedKeywords = document.getElementById('selectedKeywords');
            if (selectedKeywords) {
                new MutationObserver(updateCompletionStates).observe(selectedKeywords, {
                    childList: true,
                    subtree: true
                });
            }
        }

        // Init on page load
        document.addEventListener('DOMContentLoaded', () => {
            initScrollSpy();
            setupCompletionMonitoring();
            updateCompletionStates();
        });
    </script>
}
