<style>
    /* Performance: eliminate 300ms tap-delay on interactive elements */
    .creator-card button,
    .creator-card input,
    .creator-card select,
    .creator-card textarea,
    .smart-step-creator button,
    .smart-step-creator input,
    .smart-step-creator select,
    .smart-step-creator textarea,
    .creator-topbar button,
    .creator-checklist-toolbar { touch-action: manipulation; }

    /* Performance: GPU-hint for sticky bars */
    .creator-topbar,
    .creator-checklist-toolbar { will-change: transform; }

    /* Performance: skip rendering of off-screen form sections */
    #card-basics,
    #card-media,
    #card-ingredients,
    #card-steps,
    #card-keywords { content-visibility: auto; }
</style>

