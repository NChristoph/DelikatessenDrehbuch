    .smart-step-creator {
        --creator-sheet: rgba(22, 32, 68, 0.62);
        --creator-border: rgba(170, 190, 255, 0.20);
        --creator-text: #f8f9ff;
        --creator-sub: rgba(220, 228, 255, 0.72);
        --creator-accent: #7c8cff;
        --creator-bg: radial-gradient( 120% 120% at 10% 0%, #38418a 0%, #1a2247 45%, #0e1429 100% );
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.12);
        background: var(--creator-bg);
        color: var(--creator-text);
        min-height: 76vh;
        position: relative;
        box-shadow: 0 18px 40px rgba(16,20,40,0.26);
    }


        .smart-step-creator[data-theme="light"] {
            --creator-bg: linear-gradient(180deg, #e8f0ff 0%, #f8fbff 60%, #ffffff 100%);
            --creator-sheet: rgba(255,255,255,0.72);
            --creator-border: rgba(26,36,56,0.12);
            --creator-text: #101828;
            --creator-sub: rgba(16,24,40,0.65);
            --creator-accent: #5b6df9;
        }


    .creator-top-head {
        padding: 12px 14px 8px;
        border-bottom: 1px solid rgba(255,255,255,0.12);
        background: rgba(12, 16, 28, 0.28);
    }

    .template-selection-wrap {
        margin-top: 10px;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    .creator-preview-canvas {
        height: auto;
        padding: 16px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
    }


    .ingredient-top-strip {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 8px;
    }

    .ingredient-top-title {
        font-size: .74rem;
        color: var(--creator-sub);
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .ingredient-swiper-top {
        margin-bottom: 4px;
    }

    .preview-step-card {
        margin-top: 10px;
        border-radius: 22px;
        border: 1px solid var(--creator-border);
        background: rgba(255,255,255,0.12);
        backdrop-filter: blur(12px);
        padding: 16px;
        box-shadow: 0 14px 30px rgba(0,0,0,0.2);
        transform: translateY(0);
        opacity: 1;
        transition: transform .28s ease, opacity .28s ease;
    }

        .preview-step-card.preview-animate {
            transform: translateY(-6px);
            opacity: .86;
        }

    .preview-step-title {
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--creator-sub);
        margin-bottom: 6px;
    }

    .preview-step-text {
        font-size: clamp(1.05rem, 2.5vw, 1.4rem);
        line-height: 1.42;
        font-weight: 700;
        color: var(--creator-text);
        min-height: 72px;
    }

    .token-highlight {
        color: #ffe08a;
        text-shadow: 0 0 16px rgba(255,208,95,.35);
        cursor: pointer;
        border-bottom: 1px dashed rgba(255,224,138,.75);
        touch-action: manipulation;
        user-select: none;
        -webkit-tap-highlight-color: rgba(255,224,138,.3);
    }

    .placeholder-token.token-active {
        background: rgba(255,224,138,.2);
        border-radius: 8px;
        padding: 0 4px;
    }

    .placeholder-token.drag-over {
        outline: 2px dashed rgba(141,99,255,.85);
        outline-offset: 2px;
    }

    .placeholder-wrap {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        touch-action: manipulation;
        cursor: pointer;
        margin-right: 2px;
    }

    .placeholder-reset {
        border: 0;
        background: rgba(255,255,255,0.18);
        color: var(--creator-text);
        border-radius: 999px;
        width: 16px;
        height: 16px;
        line-height: 16px;
        font-size: .62rem;
        padding: 0;
        cursor: pointer;
    }

    /* ── Optionale Parameter: Inline-Pill im aktiven Step-Editor ── */
    .optional-inline-pill {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        padding: 1px 8px 1px 5px;
        border-radius: 20px;
        border: 1.5px dashed rgba(255,255,255,0.22);
        color: rgba(255,255,255,0.32);
        font-size: 0.80em;
        cursor: pointer;
        transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
        user-select: none;
        vertical-align: middle;
        margin: 0 2px;
        line-height: 1.5;
    }
    .optional-inline-pill:hover,
    .optional-inline-pill:focus {
        color: rgba(255,255,255,0.85);
        border-color: rgba(141,99,255,0.75);
        background: rgba(141,99,255,0.14);
        outline: none;
    }
    .optional-inline-pill i {
        font-size: 0.80em;
        pointer-events: none;
    }
    .optional-pill-label {
        pointer-events: none;
    }

    /* ── Optionale Parameter: Kleines Badge in der Template-Karten-Vorschau ── */
    .opt-snippet-badge {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        padding: 0 5px;
        border-radius: 10px;
        border: 1px dashed currentColor;
        opacity: 0.45;
        font-size: 0.85em;
        vertical-align: middle;
        white-space: nowrap;
    }

    .preview-step-card.token-replace-active {
        box-shadow: 0 0 0 2px rgba(255,224,138,.4), 0 14px 30px rgba(0,0,0,0.2);
    }

    .duration-editor {
        border-top: 1px solid rgba(255,255,255,.2);
        padding-top: 10px;
    }

    .phase-badge {
        font-size: .68rem;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 6px;
        margin-right: 5px;
        display: inline-block;
        line-height: 1.3;
    }

    .phase-badge-1 {
        background: rgba(34,197,94,.18);
        color: #166534;
    }

    .phase-badge-2 {
        background: rgba(239,68,68,.18);
        color: #991b1b;
    }

    .phase-badge-3 {
        background: rgba(245,158,11,.2);
        color: #92400e;
    }

    .phase-badge-4 {
        background: rgba(99,102,241,.18);
        color: #3730a3;
    }

    .creator-bottom-sheet {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: auto;
        background: var(--creator-sheet);
        border-top: 1px solid var(--creator-border);
        backdrop-filter: blur(16px);
        border-radius: 24px 24px 0 0;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        z-index: 10;
        transition: padding .22s ease;
    }

    #creatorBottomSheet {
        display: none !important;
    }

    .bottom-sheet-editor {
        border-bottom: 1px solid var(--creator-border);
        padding-bottom: 10px;
        margin-bottom: 4px;
    }

        .bottom-sheet-editor .btn-primary {
            white-space: nowrap;
        }

        .bottom-sheet-editor .inline-article-opt,
        .bottom-sheet-editor .inline-equipment-opt,
        .bottom-sheet-editor .inline-tool-opt,
        .bottom-sheet-editor .inline-base-opt,
        .bottom-sheet-editor .inline-item-opt,
        .bottom-sheet-editor .inline-balance-opt,
        .bottom-sheet-editor .inline-seasonings-opt {
            white-space: nowrap;
        }

            .bottom-sheet-editor .inline-article-opt.btn-outline-light,
            .bottom-sheet-editor .inline-equipment-opt.btn-outline-light,
            .bottom-sheet-editor .inline-tool-opt.btn-outline-light,
            .bottom-sheet-editor .inline-base-opt.btn-outline-light,
            .bottom-sheet-editor .inline-item-opt.btn-outline-light,
            .bottom-sheet-editor .inline-balance-opt.btn-outline-light,
            .bottom-sheet-editor .inline-seasonings-opt.btn-outline-light {
                background: transparent;
                color: var(--creator-text);
                border-color: rgba(255,255,255,0.45);
            }

            .bottom-sheet-editor .inline-article-opt.btn-light,
            .bottom-sheet-editor .inline-equipment-opt.btn-light,
            .bottom-sheet-editor .inline-tool-opt.btn-light,
            .bottom-sheet-editor .inline-base-opt.btn-light,
            .bottom-sheet-editor .inline-item-opt.btn-light,
            .bottom-sheet-editor .inline-balance-opt.btn-light,
            .bottom-sheet-editor .inline-seasonings-opt.btn-light {
                background: #fff;
                border-color: #fff;
                color: #10131f;
            }

    .sheet-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
    }

    .sheet-title {
        font-weight: 800;
    }

    .sheet-sub {
        font-size: .77rem;
        color: var(--creator-sub);
    }

    .advanced-gear {
        border-radius: 999px;
        width: 34px;
        height: 34px;
        padding: 0;
    }

    .ingredient-swiper {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        overflow: visible;
        padding: 4px 6px 6px;
        scrollbar-width: none;
    }

        .ingredient-swiper::-webkit-scrollbar {
            display: none;
        }

    .ingredient-chip {
        border: 1px solid var(--creator-border);
        background: rgba(255,255,255,0.08);
        color: var(--creator-text);
        border-radius: 14px;
        padding: 8px 12px;
        font-size: .82rem;
        white-space: nowrap;
        flex: 0 0 auto;
        margin: 1px 0;
        transition: all .2s ease;
    }

        .ingredient-chip.active {
            transform: scale(1.06);
            border-color: rgba(141,99,255,.8);
            box-shadow: 0 0 0 3px rgba(141,99,255,.28);
            background: rgba(141,99,255,.25);
        }

    .template-library {
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-right: 2px;
        min-height: 0;
        flex: 1;
    }


    .template-library-fixed {
        height: 50vh;
        max-height: 50vh;
        overflow-y: auto;
    }

    .template-card {
        border: 1px solid var(--creator-border);
        border-radius: 14px;
        background: rgba(255,255,255,0.08);
        color: var(--creator-text);
        text-align: left;
        padding: 10px;
        transition: transform .18s ease, border-color .18s ease, background .18s ease;
    }

        .template-card.active {
            border-color: rgba(141,99,255,.8);
            background: rgba(141,99,255,.2);
        }

        .template-card.template-tap {
            transform: scale(.98);
        }

    .template-title {
        font-weight: 700;
        font-size: .86rem;
    }

    .template-snippet {
        font-size: .76rem;
        color: var(--creator-sub);
        white-space: normal;
        overflow: visible;
        text-overflow: unset;
        line-height: 1.35;
    }

    .action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-top: auto;
    }

    .story-meta {
        font-size: .76rem;
        color: var(--creator-sub);
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .creator-cta-primary {
        border: 0;
        border-radius: 999px;
        background: linear-gradient(135deg, #8d63ff 0%, #5f85ff 100%);
        color: #fff;
        font-weight: 700;
        font-size: .82rem;
        padding: 8px 12px;
    }


    .creator-toast {
        position: absolute;
        left: 50%;
        transform: translateX(-50%) translateY(10px);
        bottom: 44%;
        opacity: 0;
        pointer-events: none;
        transition: all .25s ease;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(16,20,35,.86);
        border: 1px solid rgba(255,255,255,0.2);
        font-size: .78rem;
    }

        .creator-toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

    .template-fly-ghost {
        position: absolute;
        z-index: 6;
        opacity: 0;
        pointer-events: none;
        font-size: .74rem;
        background: rgba(141,99,255,.85);
        border-radius: 999px;
        padding: 6px 10px;
        color: #fff;
    }

        .template-fly-ghost.fly {
            animation: flyToPreview .5s ease forwards;
        }

    @@keyframes flyToPreview {
        0% {
            opacity: 0;
            transform: translate(0,0) scale(.85);
        }

        30% {
            opacity: 1;
        }

        100% {
            opacity: 0;
            transform: translate(0,-120px) scale(1.04);
        }
    }

    /* === Ingredient Edit Inline Popup === */
    #ingredientConfigOverlay {
        position: fixed;
        inset: 0;
        background: transparent;
        z-index: 500;
        display: none;
    }

        #ingredientConfigOverlay.ing-active {
            display: block;
        }

    #ingredientConfigDock {
        display: none;
        background: rgba(15,23,42,0.98);
        border: 1px solid rgba(255,255,255,0.22);
        border-radius: 16px;
        padding: 12px 14px;
        margin-top: 6px;
        position: relative;
        z-index: 501;
    }

        #ingredientConfigDock.ing-active {
            display: block;
            animation: ingDockSlideIn 0.18s ease;
        }

    @@keyframes ingDockSlideIn {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* === Probability Variable Editor Bottom Sheet === */
    #probVarEditorOverlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.6);
        z-index: 1052;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
    }

        #probVarEditorOverlay.ing-active {
            opacity: 1;
            pointer-events: auto;
        }

    #probVarEditorDock {
        position: fixed;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%) translateY(100%);
        width: min(480px, 100%);
        z-index: 1053;
        background: #1a1a2e;
        border-radius: 20px 20px 0 0;
        padding: 20px 20px calc(20px + env(safe-area-inset-bottom, 0px)) 20px;
        border-top: 1px solid rgba(255,255,255,0.15);
        border-left: 1px solid rgba(255,255,255,0.08);
        border-right: 1px solid rgba(255,255,255,0.08);
        transition: transform 0.3s cubic-bezier(0.32,0.72,0,1);
        pointer-events: none;
    }

        #probVarEditorDock.ing-active {
            transform: translateX(-50%) translateY(0);
            pointer-events: auto;
        }

        #probVarEditorDock.prob-inline-mode {
            position: relative;
            bottom: auto;
            left: auto;
            transform: none;
            width: 100%;
            z-index: 2;
            border-radius: 14px;
            margin-top: 12px;
            padding: 14px;
            background: rgba(39,42,61,0.98);
            border: 1px solid rgba(255,255,255,0.16);
            box-shadow: 0 14px 30px rgba(0,0,0,0.3);
            pointer-events: auto;
        }

            #probVarEditorDock.prob-inline-mode .ing-sheet-handle {
                display: none;
            }

        #probVarEditorDock .ing-sheet-handle {
            width: 40px;
            height: 4px;
            background: rgba(255,255,255,0.25);
            border-radius: 999px;
            margin: 0 auto 16px;
        }

    .prob-var-chip {
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.55);
        background: rgba(255,255,255,0.08);
        color: #ffffff;
        font-weight: 700;
        padding: 6px 14px;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
    }

        .prob-var-chip:hover, .prob-var-chip.active {
            background: rgba(255,255,255,0.2);
            border-color: rgba(255,255,255,0.85);
            color: #ffffff;
        }

    #ingredientConfigDock .form-control,
    #ingredientConfigDock .form-select {
        min-height: 40px;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.22);
        color: #fff;
        border-radius: 12px;
    }
        #ingredientConfigDock .form-control::placeholder {
            color: rgba(255,255,255,0.65);
        }
        #ingredientConfigDock .form-control:focus,
        #ingredientConfigDock .form-select:focus {
            background: rgba(255,255,255,0.14);
            border-color: rgba(255,255,255,0.42);
            color: #fff;
            box-shadow: 0 0 0 0.15rem rgba(141,99,255,0.2);
        }
        #ingredientConfigDock .form-select option {
            background: #182235;
            color: #fff;
        }
</style>


<div id="ingredientConfigOverlay" aria-hidden="true"></div>
<div id="ingredientConfigDock" role="dialog" aria-labelledby="ingredientConfigTitle">
    <div class="d-flex align-items-center gap-2 mb-2">
        <div class="fw-bold text-white small" id="ingredientConfigTitle"></div>
        <button type="button" id="btnCloseIngredientConfig" class="btn btn-sm p-0 text-white-50 d-none" aria-label="Schließen">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    <div class="d-flex gap-2 align-items-center mb-2">
        <input type="text" inputmode="decimal" id="ingredientConfigQty" class="form-control form-control-sm" placeholder="1" value="1" style="background:#ffffff !important; color:#111827 !important; -webkit-text-fill-color:#111827 !important; caret-color:#111827 !important; text-shadow:none !important;" />
        <select id="ingredientConfigUnit" class="form-select form-select-sm" style="background:#ffffff !important; color:#111827 !important; -webkit-text-fill-color:#111827 !important; text-shadow:none !important;"></select>
        <button type="button" id="btnApplyIngredientConfig" class="btn btn-sm creator-cta-primary px-3">
            <i class="bi bi-check-lg"></i>
        </button>
    </div>
</div>

<div id="probVarEditorOverlay" aria-hidden="true"></div>
<div id="probVarEditorDock" role="dialog" aria-modal="true" aria-labelledby="probVarEditorTitle">
    <div class="ing-sheet-handle"></div>
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="fw-bold text-white" id="probVarEditorTitle">Variable auswählen</div>
        <button type="button" id="btnCloseProbVarEditor" class="btn btn-sm p-0 text-white-50" aria-label="Schließen">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    <div id="probVarIngredientArea" class="d-none">
        <div class="small text-white-50 mb-2">Zutaten</div>
        <div id="probVarIngredientChips" class="d-flex flex-wrap gap-2"></div>
        <div class="small text-white-50 mt-3 mb-2">Artikel</div>
        <div id="probVarIngredientArticleChips" class="d-flex flex-wrap gap-2"></div>
    </div>
    <div id="probVarDurationArea" class="d-none">
        <div class="small text-white-50 mb-2">Dauer</div>
        <div class="d-flex gap-2">
            <input type="number" min="1" step="1" id="probVarDurationVal" class="form-control" value="5" style="background:#fff;color:#212529;" />
            <select id="probVarDurationUnit" class="form-select" style="background:#fff;color:#212529;">
                <option value="minute">Minuten</option>
                <option value="hour">Stunden</option>
            </select>
        </div>
    </div>
    <div id="probVarCountArea" class="d-none">
        <div class="small text-white-50 mb-2">Anzahl</div>
        <input type="number" min="1" step="1" id="probVarCountVal" class="form-control" value="1" style="background:#fff;color:#212529;" />
    </div>
    <div id="probVarTempArea" class="d-none">
        <div class="small text-white-50 mb-2">Temperatur</div>
        <div class="d-flex gap-2">
            <input type="number" min="1" step="1" id="probVarTempVal" class="form-control" value="180" style="background:#fff;color:#212529;" />
            <select id="probVarTempUnit" class="form-select" style="background:#fff;color:#212529;">
                <option value="celsius">°C</option>
                <option value="fahrenheit">°F</option>
            </select>
        </div>
    </div>
    <div id="probVarTextArea" class="d-none">
        <div class="small text-white-50 mb-2">Wert</div>
        <input type="text" id="probVarTextVal" class="form-control" style="background:#fff;color:#212529;" />
    </div>
    <div id="probVarOptionsArea" class="d-none">
        <div id="probVarOptionChips" class="d-flex flex-wrap gap-2"></div>
    </div>
    <div class="d-flex gap-2 mt-3" id="probVarApplyRow">
        <button type="button" id="btnApplyProbVar" class="btn btn-sm creator-cta-primary flex-grow-1">
            <i class="bi bi-check-lg me-1"></i>Übernehmen
        </button>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="~/js/CreatePostingSmartStepCreator.js" asp-append-version="true"></script>
    <script src="~/js/master-step-renderer.js" asp-append-version="true"></script>
    <script src="~/js/recipe-step-suggest.js" asp-append-version="true"></script>
    <script>
        window.CreatePostingPageConfig = {
            upsertStepUrl: "@Url.Action("UpsertStep", "Home", new { area = "WorldMiniApp" })"
        };
    </script>
    <script src="~/js/create-posting-probability.js" asp-append-version="true"></script>
    <script src="~/js/CreatePostingPage.js" asp-append-version="true"></script>
    <script src="~/js/create-posting-publish-checklist.js"></script>
}




