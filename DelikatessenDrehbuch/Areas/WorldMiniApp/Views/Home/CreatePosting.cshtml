<div id="ingredientConfigOverlay" style="position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:2000;opacity:0;pointer-events:none;transition:opacity 0.2s;" aria-hidden="true"></div>
<div id="ingredientConfigDock" style="position:fixed;bottom:0;left:0;right:0;background:linear-gradient(to right,#0f234d,#18366f,#1f4d92);border-top:1px solid rgba(173,207,255,0.3);border-radius:24px 24px 0 0;padding:20px;transform:translateY(100%);transition:transform 0.3s;z-index:2001;max-width:720px;margin:0 auto;" role="dialog" aria-modal="true">
    <div style="width:40px;height:4px;background:rgba(255,255,255,0.3);border-radius:2px;margin:0 auto 16px;"></div>
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div style="font-weight:700;color:#f7fbff;" id="ingredientConfigName">Zutat konfigurieren</div>
        <button type="button" id="btnCloseIngredientConfig" style="border:0;background:transparent;color:rgba(247,251,255,0.5);padding:0;width:2rem;height:2rem;display:inline-flex;align-items:center;justify-content:center;border-radius:999px;cursor:pointer;">
