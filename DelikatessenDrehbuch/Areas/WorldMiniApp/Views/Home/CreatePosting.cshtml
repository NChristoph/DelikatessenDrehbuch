    }

    .preview-step-card {
        margin-top: 10px;
        border-radius: 22px;
        border: 1px solid var(--creator-border);
        background: rgba(255,255,255,0.12);
        backdrop-filter: blur(12px);
        padding: 16px;
        box-shadow: 0 14px 30px rgba(0,0,0,0.2);
        transform: translateY(0);
