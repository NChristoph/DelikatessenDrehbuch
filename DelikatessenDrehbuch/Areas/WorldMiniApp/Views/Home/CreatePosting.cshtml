@model DelikatessenDrehbuch.Areas.WorldMiniApp.Models.WorldUserPosting
@using System.Text.Json
@using System.Linq
@using Newtonsoft.Json

@{
    var isEditMode = ViewData["IsEditMode"] as bool? ?? false;
    ViewData["Title"] = isEditMode ? "Rezept Bearbeiten" : "Rezept Erstellen";
    Layout = "_MiniAppLayout";
}

<link rel="stylesheet" href="~/css/create-posting-step-filter.css" asp-append-version="true" />

<div class="creator-bg min-vh-100 position-relative">
    <div id="datatableLoadingOverlay" class="creator-loading">
        <div class="creator-loading-card">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Lade...</span>
            </div>
            <div class="fw-bold mt-2">Lade Daten...</div>
            <div class="small text-muted">Einen Moment bitte</div>
        </div>
    </div>

    <div class="creator-topbar px-3 py-3" style="visibility:hidden" data-theme="navy">
        <a href="@Url.Action("Index", "Home", new { area = "WorldMiniApp" })" class="topbar-btn" aria-label="Zurück">
            <i class="bi bi-chevron-left"></i>
        </a>

        <div class="topbar-title">
            <div class="fw-bold text-truncate" id="creatorTopbarProgress" style="color:#172033 !important; text-shadow:none;">0/5 bereit</div>
            <div class="small text-muted text-truncate">@(isEditMode ? "Edit Posting" : "Create Posting")</div>
        </div>


        <button type="submit" form="recipeForm" class="topbar-btn topbar-primary" aria-label="@(isEditMode ? "Speichern" : "Veröffentlichen")">
            <i class="bi bi-@(isEditMode ? "check-lg" : "send-fill")"></i>
        </button>
    </div>

    <div class="feed-shell mx-auto" style="visibility:hidden" data-theme="navy">
        <form asp-action="@(isEditMode ? "UpdateRecipeFromCreateForm" : "UploadNewVideo")" method="post" enctype="multipart/form-data" id="recipeForm" onsubmit="return prepareBinding()">
            @if (isEditMode)
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="EditPostingId" value="@ViewData["PostingId"]" />
                <input type="hidden" name="EditRecipeId" value="@ViewData["RecipeId"]" />
            }
            <input type="hidden" name="userHash" id="hiddenUserTokenField" />
            <div id="draftRestoreBanner" class="draft-restore-banner d-none" @(isEditMode ? "style=display:none !important" : "")>
                <div class="draft-restore-content">
                    <span class="draft-restore-text">
                        <i class="bi bi-clock-history me-1"></i>
                        <span class="label-lang"
                              data-de="Gespeicherte Session gefunden"
                              data-en="Saved session found"
                              data-esp="Sesión guardada encontrada"
                              data-prt="Sessão guardada encontrada"
                              data-id="Sesi tersimpan ditemukan"
                              data-nl="Opgeslagen sessie gevonden"
                              data-sv="Sparad session hittad"
                              data-da="Gemt session fundet"
                              data-no="Lagret økt funnet"
                              data-ms="Sesi tersimpan ditemui">Gespeicherte Session gefunden</span>
                    </span>
                    <div class="d-flex gap-2">
                        <button type="button" id="restoreDraftBtn" class="btn btn-sm btn-outline-success rounded-pill">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                            <span class="label-lang"
                                  data-de="Wiederherstellen"
                                  data-en="Restore"
                                  data-esp="Restaurar"
                                  data-prt="Restaurar"
                                  data-id="Pulihkan"
                                  data-nl="Herstellen"
                                  data-sv="Återställ"
                                  data-da="Gendan"
                                  data-no="Gjenopprett"
                                  data-ms="Pulihkan">Wiederherstellen</span>
                        </button>
                        <button type="button" id="discardDraftBtn" class="btn btn-sm btn-outline-secondary rounded-pill">
                            <i class="bi bi-x-lg me-1"></i>
                            <span class="label-lang"
                                  data-de="Verwerfen"
                                  data-en="Discard"
                                  data-esp="Descartar"
                                  data-prt="Descartar"
                                  data-id="Buang"
                                  data-nl="Verwerpen"
                                  data-sv="Förkasta"
                                  data-da="Kassér"
                                  data-no="Forkast"
                                  data-ms="Buang">Verwerfen</span>
                        </button>
                    </div>
                </div>
            </div>

            <section class="creator-card mb-3" data-theme="navy" id="card-basics">
                <div class="creator-card-head">
                    <div class="d-flex align-items-center gap-2">
                        <div class="card-icon candy-blue"><i class="bi bi-ui-checks-grid"></i></div>
                        <div>
                            <div class="creator-card-title label-lang" data-de="Basis" data-en="Basics" data-esp="Básico" data-prt="Base">Basis</div>
                            <div class="creator-card-sub label-lang" data-de="Titel, Kategorie, Personen, Dauer" data-en="Title, category, persons, time" data-esp="Título, categoría, personas, tiempo" data-prt="Título, categoria, pessoas, tempo">
                                Titel, Kategorie, Personen, Dauer
                            </div>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light border">1/5</span>
                </div>

                <div class="creator-card-body">
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-2 label-lang"
                               data-de="Titel"
                               data-en="Title"
                               data-esp="Título"
                               data-prt="Título">Titel</label>

                        <div class="input-pill" data-theme="navy">
                            <i class="bi bi-fonts text-muted"></i>
                            <input asp-for="Title"
                                   class="form-control border-0 bg-transparent fw-bold shadow-none lang-ph"
                                   placeholder="Titel"
                                   data-ph-de="Titel" data-ph-en="Title" data-ph-esp="Título" data-ph-prt="Título" data-ph-id="Judul" data-ph-nl="Titel" data-ph-sv="Titel" data-ph-da="Titel" data-ph-no="Tittel" data-ph-ms="Tajuk"
                                   required />
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-2 label-lang"
                                   data-de="Kategorie"
                                   data-en="Category"
                                   data-esp="Categoría"
                                   data-prt="Categoria">Kategorie</label>

                            <div class="select-pill" data-theme="navy">
                                <i class="bi bi-grid text-muted"></i>
                                <select asp-for="Recipe.Category" class="form-select border-0 bg-transparent fw-bold shadow-none cursor-pointer">
                                    <option value="" selected disabled class="lang-opt"
                                            data-txt-de="Kategorie"
                                            data-txt-en="Category"
                                            data-txt-esp="Categoría"
                                            data-txt-prt="Categoria">Kategorie</option>

                                    <option value="Appetizer" class="lang-opt" data-txt-de="Vorspeise" data-txt-en="Appetizer" data-txt-esp="Entrada" data-txt-prt="Entrada">Vorspeise</option>
                                    <option value="Main" class="lang-opt" data-txt-de="Hauptspeise" data-txt-en="Main Course" data-txt-esp="Plato principal" data-txt-prt="Prato principal">Hauptspeise</option>
                                    <option value="Dessert" class="lang-opt" data-txt-de="Dessert" data-txt-en="Dessert" data-txt-esp="Postre" data-txt-prt="Sobremesa">Dessert</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-6">
                            <label class="form-label small text-muted mb-2 label-lang"
                                   data-de="Präferenz"
                                   data-en="Preference"
                                   data-esp="Preferencia"
                                   data-prt="Preferência">Präferenz</label>

                            <div class="select-pill" data-theme="navy">
                                <i class="bi bi-heart text-muted"></i>
                                <select asp-for="Recipe.Preferences" class="form-select border-0 bg-transparent fw-bold shadow-none cursor-pointer">
                                    <option value="" selected disabled class="lang-opt"
                                            data-txt-de="Präferenz"
                                            data-txt-en="Preference"
                                            data-txt-esp="Preferencia"
                                            data-txt-prt="Preferência">Präferenz</option>

                                    <option value="Vegan" class="lang-opt" data-txt-de="Vegan" data-txt-en="Vegan" data-txt-esp="Vegano" data-txt-prt="Vegano">Vegan</option>
                                    <option value="Vegetarian" class="lang-opt" data-txt-de="Vegetarisch" data-txt-en="Vegetarian" data-txt-esp="Vegetariano" data-txt-prt="Vegetariano">Vegetarisch</option>
                                    <option value="Fish" class="lang-opt" data-txt-de="Fisch" data-txt-en="Fish" data-txt-esp="Pescado" data-txt-prt="Peixe">Fisch</option>
                                    <option value="Pork" class="lang-opt" data-txt-de="Schwein" data-txt-en="Pork" data-txt-esp="Cerdo" data-txt-prt="Porco">Schwein</option>
                                    <option value="Beef" class="lang-opt" data-txt-de="Rind" data-txt-en="Beef" data-txt-esp="Res" data-txt-prt="Carne">Rind</option>
                                    <option value="OtherMeat" class="lang-opt" data-txt-de="Anderes Fleisch" data-txt-en="Other Meat" data-txt-esp="Otra carne" data-txt-prt="Outra carne">Anderes Fleisch</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-2 label-lang"
                                   data-de="Personen"
                                   data-en="Persons"
                                   data-esp="Personas"
                                   data-prt="Pessoas">Personen</label>

                            <div class="input-pill" data-theme="navy">
                                <i class="bi bi-people text-muted"></i>
                                <input asp-for="Recipe.PersonCount"
                                       type="number"
                                       class="form-control border-0 bg-transparent fw-bold shadow-none lang-ph"
                                       placeholder="Personen"
                                       data-ph-de="Personen" data-ph-en="Persons" data-ph-esp="Personas" data-ph-prt="Pessoas" data-ph-id="Orang" data-ph-nl="Personen" data-ph-sv="Personer" data-ph-da="Personer" data-ph-no="Personer" data-ph-ms="Orang" />
                            </div>
                        </div>

                        <div class="col-6">
                            <label class="form-label small text-muted mb-2 label-lang"
                                   data-de="Dauer (Min)"
                                   data-en="Time (min)"
                                   data-esp="Tiempo (min)"
                                   data-prt="Tempo (min)">Dauer (Min)</label>

                            <div class="input-pill" data-theme="navy">
                                <i class="bi bi-clock text-muted"></i>
                                <input asp-for="Recipe.PreparationTime"
                                       type="number"
                                       class="form-control border-0 bg-transparent fw-bold shadow-none lang-ph"
                                       placeholder="Minuten"
                                       data-ph-de="Minuten" data-ph-en="Minutes" data-ph-esp="Minutos" data-ph-prt="Minutos" data-ph-id="Menit" data-ph-nl="Minuten" data-ph-sv="Minuter" data-ph-da="Minutter" data-ph-no="Minutter" data-ph-ms="Minit" />
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="creator-card mb-3" data-theme="navy" id="card-media">
                <div class="creator-card-head">
                    <div class="d-flex align-items-center gap-2">
                        <div class="card-icon candy-pink"><i class="bi bi-camera-reels"></i></div>
                        <div>
                            <div class="creator-card-title label-lang" data-de="Media" data-en="Media" data-esp="Medios" data-prt="Mídia">Media</div>
                            <div class="creator-card-sub label-lang" data-de="Video oder Bild für den Feed" data-en="Video or image for the feed" data-esp="Video o imagen para el feed" data-prt="Vídeo ou imagem para o feed">
                                Video oder Bild für den Feed
                            </div>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light border">2/5</span>
                </div>

                <div class="creator-card-body">
                    <div id="videoPreviewContainer" class="d-none mb-3">
                        <div class="media-preview">
                            <img id="imagePreview" class="w-100 d-none" style="max-height: 320px; object-fit: cover;" alt="Preview" />
                            <video id="videoPreview" class="w-100" style="max-height: 320px; object-fit: cover;" controls></video>
                            <button type="button" class="btn btn-light btn-sm media-reset" onclick="resetVideo()">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>

                    @if (isEditMode)
                    {
                        <div id="editCurrentMediaPreview" class="mb-3">
                            <div class="small text-muted mb-2 label-lang" data-de="Aktuelles Bild/Video" data-en="Current image/video">Aktuelles Bild/Video</div>
                            <img id="editCurrentImage" class="w-100 rounded" style="max-height: 200px; object-fit: cover;" alt="Current media" />
                            <div class="small text-muted mt-2 label-lang" data-de="Optional: neues Bild/Video hochladen" data-en="Optional: upload new image/video">Optional: neues Bild/Video hochladen</div>
                        </div>
                    }

                    <label id="uploadLabel" class="upload-drop" data-theme="navy" for="videoInput">
                        <div class="upload-icon">
                            <i class="bi bi-cloud-arrow-up-fill"></i>
                        </div>
                        <div class="fw-bold mb-1 label-lang"
                             data-de="Upload starten"
                             data-en="Start upload"
                             data-esp="Iniciar subida"
                             data-prt="Iniciar envio">
                            Upload starten
                        </div>

                        <div class="small text-muted label-lang"
                             data-de="Wähle ein Video oder Bild (Feed-Style)."
                             data-en="Choose a video or image (feed style)."
                             data-esp="Elige un video o imagen (estilo feed)."
                             data-prt="Escolha um vídeo oder imagem (estilo feed).">
                            Wähle ein Video oder Bild (Feed-Style).
                        </div>

                        <input asp-for="Content" type="file" accept="video/*,image/*" class="d-none" id="videoInput" onchange="handleVideoUpload(this)" />
                    </label>
                </div>
            </section>

            <section class="smart-step-creator mb-3" id="card-ingredients" data-theme="navy">
                <div class="creator-top-head sheet-head">
                    <div class="d-flex align-items-center gap-2">
                        <div class="card-icon candy-green"><i class="bi bi-basket"></i></div>
                        <div>
                            <div class="sheet-title label-lang" data-de="Zutaten Auswahl" data-en="Ingredients Selection">Zutaten Auswahl</div>
                            <div class="sheet-sub label-lang" data-de="Suche & konfiguriere deine Zutaten" data-en="Search & configure your ingredients">Suche & konfiguriere deine Zutaten</div>
                        </div>
                    </div>
                    <span class="badge rounded-pill bg-transparent border border-light text-light">3/5</span>
                </div>

                <div class="creator-preview-canvas">
                    <div class="mb-4">
                        <div class="input-pill ingredient-search-pill" data-theme="navy">
                            <i class="bi bi-search text-white-50"></i>
                            <input type="text" id="ingredientSearch" class="form-control border-0 bg-transparent text-white shadow-none lang-ph" placeholder="Zutat suchen..."
                                   data-ph-de="Zutat suchen..." data-ph-en="Search ingredient..." data-ph-esp="Buscar ingrediente..." data-ph-prt="Buscar ingrediente..."
                                   data-ph-id="Cari bahan..." data-ph-nl="Ingrediënt zoeken..." data-ph-sv="Sök ingrediens..." data-ph-da="Søg ingrediens..."
                                   data-ph-no="Søg ingrediens..." data-ph-ms="Cari bahan..." />
                            <button type="button" id="clearIngredientSearch" class="ingredient-search-clear d-none" aria-label="Suche leeren" title="Suche leeren">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <div class="small text-white-50 text-center mt-2 label-lang" data-de="Zum Bearbeiten antippen" data-en="Tap to edit" data-esp="Toca para editar" data-prt="Toque para editar">Zum Bearbeiten antippen</div>
                    </div>

                    <div class="template-library ingredient-catalog-scroll" id="ingredientsCatalog">
                        @if (Model.ToSelectIngredientsAndNutrients != null)
                        {
                            foreach (var item in Model.ToSelectIngredientsAndNutrients)
                            {
                                <div class="preview-step-card mb-1  ingredient-db-row"
                                     data-ingredient-id="@item.Id"
                                     data-name-de="@item.Name_DE"
                                     data-name-en="@item.Name_EN"
                                     data-name-esp="@item.Name_ESP"
                                     data-name-prt="@item.Name_PRT"
                                     data-name-id="@item.Name_ID"
                                     data-name-nl="@item.Name_NL"
                                     data-name-sv="@item.Name_SE"
                                     data-name-da="@item.Name_DK"
                                     data-name-no="@item.Name_NO"
                                     data-name-ms="@item.Name_MS"
                                     data-genus-de="@item.Genus_DE"
                                     data-genus-en="@item.Genus_EN"
                                     data-genus-esp="@item.Genus_ESP"
                                     data-genus-prt="@item.Genus_PRT"
                                     data-genus-id="@item.Genus_ID"
                                     data-genus-nl="@item.Genus_NL"
                                     data-genus-sv="@item.Genus_SE"
                                     data-genus-da="@item.Genus_DK"
                                     data-genus-no="@item.Genus_NO"
                                     data-genus-ms="@item.Genus_MS"
                                     data-group-id="@item.GroupId"
                                     data-group-icon="@(item.Icon ?? item.Group?.Icon)"
                                     data-is-liquid="@item.is_liquid.ToString().ToLower()"
                                     data-is-fat="@item.is_fat.ToString().ToLower()"
                                     data-is-hard="@item.is_hard.ToString().ToLower()"
                                     data-is-soft="@item.is_soft.ToString().ToLower()"
                                     data-selected-qty="1"
                                     data-theme="navy"
                                     data-selected-unit="@(Model.Measure?.FirstOrDefault()?.Metrics_DE ?? "")">

                                    <div class="d-flex align-items-center gap-2 mb-1 ingredient-card-head" style="min-height:max-content">
                                        <div class="preview-step-text display-name mb-0 flex-grow-1 d-flex align-items-center gap-2" style="min-height:max-content"><span class="ingredient-group-icon">@Html.Raw(item.Icon ?? item.Group?.Icon)</span><span class="ingredient-name-text">@item.Name_DE</span></div>
                                        <button type="button" class="btn btn-sm creator-cta-primary ms-auto" onclick="addIngredient('@item.Id', this)" title="Zutat hinzufügen" aria-label="Zutat hinzufügen">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>

                                    <div class="duration-editor mt-2 ingredient-db-details d-none">
                                        <div class="d-flex gap-2 align-items-center">
                                            <input type="text" inputmode="decimal"
                                                   class="form-control form-control-sm js-db-qty js-decimal-input candy-purple-input"
                                                   style="max-width:85px; border-radius: 12px; background:#ffffff !important; color:#111827 !important; -webkit-text-fill-color:#111827 !important; caret-color:#111827 !important; text-shadow:none !important; border:1px solid rgba(15,23,42,0.18) !important;" placeholder="1"
                                                   oninput="$(this).closest('.preview-step-card').attr('data-selected-qty', this.value)" />

                                            <select class="form-select form-select-sm js-db-unit candy-purple-input"
                                                    style="max-width:140px; border-radius: 12px; cursor: pointer; background:#ffffff !important; color:#111827 !important; -webkit-text-fill-color:#111827 !important; text-shadow:none !important; border:1px solid rgba(15,23,42,0.18) !important;"
                                                    onchange="$(this).closest('.preview-step-card').attr('data-selected-unit', this.value)">
                                                @if (Model.Measure != null)
                                                {
                                                    foreach (var m in Model.Measure)
                                                    {
                                                        <option value="@m.Metrics_DE">@m.Metrics_DE</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div class="common-unit-chips mt-2" role="group" aria-label="Schnelle Einheiten">
                                            <button type="button" class="btn btn-sm common-unit-chip js-common-unit-chip" data-unit-key="g">g.</button>
                                            <button type="button" class="btn btn-sm common-unit-chip js-common-unit-chip" data-unit-key="ml">ml.</button>
                                            <button type="button" class="btn btn-sm common-unit-chip js-common-unit-chip" data-unit-key="piece">Stk.</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div id="ingredientFlyGhost" class="template-fly-ghost" aria-hidden="true"></div>

                    <div class="ingredient-top-strip mt-4">
                        <div class="ingredient-top-title">Ausgewählte Zutaten</div>
                        <div class="small text-white-50 mt-1 mb-2 label-lang" data-de="Zum Bearbeiten antippen" data-en="Tap to edit">Zum Bearbeiten antippen</div>
                        <div id="selectedIngredients" class="selected-zone mt-2"></div>
                        <div id="selectedIngredientsSuggestions" class="d-flex flex-wrap gap-2 mt-2"></div>
                    </div>
                </div>
            </section>

            @*was könnte es sein bereich oben*@
            <section class="smart-step-creator mb-3" data-theme="dark" id="card-probability">
                <div class="creator-top-head sheet-head">
                    <div class="d-flex align-items-center gap-2">
                        <div class="card-icon" style="background:linear-gradient(135deg,#8d63ff,#5b6df9);border-radius:12px;width:36px;height:36px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="bi bi-graph-up-arrow text-white"></i>
                        </div>
                        <div>
                            <div class="sheet-title label-lang" data-de="Was könnte es sein?" data-en="What could it be?">
                                Was könnte es sein?
                            </div>
                            <div class="sheet-sub label-lang" data-de="Rezepttyp-Erkennung & Step-Vorschläge" data-en="Recipe type detection & step suggestions">
                                Rezepttyp-Erkennung & Step-Vorschläge
                            </div>
                        </div>
                    </div>
                </div>
                <div class="creator-preview-canvas">
                    <div id="ingredientProbabilityBadges" class="d-flex flex-wrap gap-2 small text-white-50">Wähle Zutaten aus, um Wahrscheinlichkeiten zu sehen.</div>
                    <div id="ingredientProbabilityTemplates" class="mt-2 d-none"></div>
                </div>
            </section>
            @*smart stap cretor bereich uten*@
            @await Html.PartialAsync("~/Areas/WorldMiniApp/Views/Home/_SmartStepCreatorPartial.cshtml")

            <section class="creator-card mb-4" data-theme="navy" id="card-keywords">
                <div class="creator-card-head">
                    <div class="d-flex align-items-center gap-2">
                        <div class="card-icon candy-blue"><i class="bi bi-hash"></i></div>
                        <div>
                            <div class="creator-card-title label-lang" data-de="Keywords" data-en="Keywords">Keywords</div>
                            <div class="creator-card-sub label-lang" data-de="Hilft beim Feed & bei Suche" data-en="Helps feed & search">
                                Hilft beim Feed & bei Suche
                            </div>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light border">5/5</span>
                </div>

                <div class="creator-card-body">
                    <div class="d-flex flex-wrap gap-2">
                        @if (Model.ToSelectKeywords != null)
                        {
                            foreach (var keyword in Model.ToSelectKeywords)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary rounded-pill keyword-btn"
                                        data-keyword-id="@keyword.Id"
                                        data-word-de="@keyword.Word_DE"
                                        data-word-en="@keyword.Word_EN"
                                        onclick="toggleKeyword('@keyword.Id', this)">
                                    @keyword.Word_DE
                                </button>
                            }
                        }
                    </div>
                    <div id="selectedKeywords" class="mt-3 selected-zone"></div>
                </div>
            </section>

            <div class="creator-bottom p-3">
