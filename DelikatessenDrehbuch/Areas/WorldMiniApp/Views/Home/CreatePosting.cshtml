        border-radius: 999px;
    }

    #ingredientsDbTable .ingredient-inline-inputs .form-control,
    #ingredientsDbTable .ingredient-inline-inputs .form-select {
        min-height: 38px;
    }


    /* ---------- Bottom Bar ---------- */
    .creator-bottom {
        left: 50% !important;
        transform: translateX(-50%);
        width: min(720px, 100%);
        z-index: 1600;
        background: linear-gradient(to top, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.55) 60%, transparent 100%);
        pointer-events: none;
    }

    .creator-bottom-inner {
        pointer-events: auto;
        border-radius: 999px;
        background: rgba(255,255,255,0.92);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.08);
        box-shadow: 0 14px 36px rgba(0,0,0,0.10);
        padding: 10px;
    }

    .bottom-hint {
        min-width: 210px;
        display: none;
    }

    .publish-btn {
        border: none;
        border-radius: 999px;
        padding: 14px 16px;
        font-weight: 900;
        color: #fff;
        background: linear-gradient(135deg, #FF9966 0%, #FF5E62 100%);
        box-shadow: 0 14px 30px rgba(255, 94, 98, 0.28);
    }

    /* ---------- Responsive ---------- */
    @@media (min-width: 768px) {
        .bottom-hint {
            display: block;
        }
    }

    @@media (max-width: 576px) {
        .feed-shell {
            padding-left: 10px;
            padding-right: 10px;
        }

        .creator-hero {
            flex-direction: column;
        }

        .creator-hero-right {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .creator-table-wrap {
            height: 20rem;
            overflow-y: auto;
        }

        .table-responsive {
            overflow-x: hidden;
        }

        #ingredientsDbTable thead, #stepsDbTable thead {
            display: none;
        }

        #ingredientsDbTable tbody tr, #stepsDbTable tbody tr {
            display: block;
            margin-bottom: 12px;
            background: rgba(255,255,255,0.95);
            border-radius: 18px;
            padding: 12px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.06);
        }

        #ingredientsDbTable tbody td, #stepsDbTable tbody td {
            display: block;
            border: 0;
            padding: 0;
        }

            #ingredientsDbTable tbody td + td,
            #stepsDbTable tbody td + td {
                margin-top: 10px;
                text-align: right !important;
            }
    }


    .smart-step-creator {
        --creator-bg: radial-gradient(120% 120% at 10% 0%, #2f2f5f 0%, #17172a 45%, #0f1119 100%);
        --creator-sheet: rgba(20, 25, 40, 0.62);
        --creator-border: rgba(255,255,255,0.18);
        --creator-text: #f8f9ff;
        --creator-sub: rgba(248,249,255,0.72);
        --creator-accent: #8d63ff;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.12);
        background: var(--creator-bg);
        color: var(--creator-text);
        min-height: 76vh;
        position: relative;
        box-shadow: 0 18px 40px rgba(16,20,40,0.26);
    }

    .smart-step-creator[data-theme="light"] {
        --creator-bg: linear-gradient(180deg, #e8f0ff 0%, #f8fbff 60%, #ffffff 100%);
        --creator-sheet: rgba(255,255,255,0.72);
        --creator-border: rgba(26,36,56,0.12);
        --creator-text: #101828;
        --creator-sub: rgba(16,24,40,0.65);
        --creator-accent: #5b6df9;
    }


    .creator-top-head {
        padding: 12px 14px 8px;
        border-bottom: 1px solid rgba(255,255,255,0.12);
        background: rgba(12, 16, 28, 0.28);
    }

    .template-selection-wrap {
        margin-top: 10px;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    .creator-preview-canvas {
        height: auto;
        padding: 16px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
    }


    .ingredient-top-strip {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 8px;
    }

    .ingredient-top-title {
        font-size: .74rem;
        color: var(--creator-sub);
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .ingredient-swiper-top {
        margin-bottom: 4px;
    }

    .preview-step-card {
        margin-top: 10px;
        border-radius: 22px;
        border: 1px solid var(--creator-border);
        background: rgba(255,255,255,0.12);
        backdrop-filter: blur(12px);
        padding: 16px;
        box-shadow: 0 14px 30px rgba(0,0,0,0.2);
        transform: translateY(0);
        opacity: 1;
        transition: transform .28s ease, opacity .28s ease;
    }

    .preview-step-card.preview-animate {
        transform: translateY(-6px);
        opacity: .86;
    }

    .preview-step-title {
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--creator-sub);
        margin-bottom: 6px;
    }

    .preview-step-text {
        font-size: clamp(1.05rem, 2.5vw, 1.4rem);
        line-height: 1.42;
        font-weight: 700;
        color: var(--creator-text);
        min-height: 72px;
    }

    .token-highlight {
        color: #ffe08a;
        text-shadow: 0 0 16px rgba(255,208,95,.35);
        cursor: pointer;
        border-bottom: 1px dashed rgba(255,224,138,.75);
        touch-action: manipulation;
        user-select: none;
        -webkit-tap-highlight-color: rgba(255,224,138,.3);
    }

    .placeholder-token.token-active {
        background: rgba(255,224,138,.2);
        border-radius: 8px;
        padding: 0 4px;
    }

    .placeholder-token.drag-over {
        outline: 2px dashed rgba(141,99,255,.85);
        outline-offset: 2px;
    }

    .placeholder-wrap {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        touch-action: manipulation;
        cursor: pointer;
        margin-right: 2px;
    }

    .placeholder-reset {
        border: 0;
        background: rgba(255,255,255,0.18);
        color: var(--creator-text);
        border-radius: 999px;
        width: 16px;
        height: 16px;
        line-height: 16px;
        font-size: .62rem;
        padding: 0;
        cursor: pointer;
    }

    .preview-step-card.token-replace-active {
        box-shadow: 0 0 0 2px rgba(255,224,138,.4), 0 14px 30px rgba(0,0,0,0.2);
    }

    .duration-editor {
        border-top: 1px solid rgba(255,255,255,.2);
        padding-top: 10px;
    }

    .phase-badge {
        font-size: .68rem;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 6px;
        margin-right: 5px;
        display: inline-block;
        line-height: 1.3;
    }

    .phase-badge-1 { background: rgba(34,197,94,.18); color: #166534; }
    .phase-badge-2 { background: rgba(239,68,68,.18); color: #991b1b; }
    .phase-badge-3 { background: rgba(245,158,11,.2); color: #92400e; }
    .phase-badge-4 { background: rgba(99,102,241,.18); color: #3730a3; }

    .creator-bottom-sheet {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: auto;
        background: var(--creator-sheet);
        border-top: 1px solid var(--creator-border);
        backdrop-filter: blur(16px);
        border-radius: 24px 24px 0 0;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        z-index: 10;
        transition: padding .22s ease;
    }

    #creatorBottomSheet { display: none !important; }

    .bottom-sheet-editor {
        border-bottom: 1px solid var(--creator-border);
        padding-bottom: 10px;
        margin-bottom: 4px;
    }

    .bottom-sheet-editor .btn-primary {
        white-space: nowrap;
    }

    .bottom-sheet-editor .inline-article-opt,
    .bottom-sheet-editor .inline-equipment-opt,
    .bottom-sheet-editor .inline-tool-opt,
    .bottom-sheet-editor .inline-base-opt,
    .bottom-sheet-editor .inline-item-opt,
    .bottom-sheet-editor .inline-balance-opt,
    .bottom-sheet-editor .inline-seasonings-opt {
        white-space: nowrap;
    }

    .bottom-sheet-editor .inline-article-opt.btn-outline-light,
    .bottom-sheet-editor .inline-equipment-opt.btn-outline-light,
    .bottom-sheet-editor .inline-tool-opt.btn-outline-light,
    .bottom-sheet-editor .inline-base-opt.btn-outline-light,
    .bottom-sheet-editor .inline-item-opt.btn-outline-light,
    .bottom-sheet-editor .inline-balance-opt.btn-outline-light,
    .bottom-sheet-editor .inline-seasonings-opt.btn-outline-light {
        background: transparent;
        color: var(--creator-text);
        border-color: rgba(255,255,255,0.45);
    }

    .bottom-sheet-editor .inline-article-opt.btn-light,
    .bottom-sheet-editor .inline-equipment-opt.btn-light,
    .bottom-sheet-editor .inline-tool-opt.btn-light,
    .bottom-sheet-editor .inline-base-opt.btn-light,
    .bottom-sheet-editor .inline-item-opt.btn-light,
    .bottom-sheet-editor .inline-balance-opt.btn-light,
    .bottom-sheet-editor .inline-seasonings-opt.btn-light {
        background: #fff;
        border-color: #fff;
        color: #10131f;
    }

    .sheet-head { display:flex; justify-content:space-between; align-items:center; gap:8px; }
    .sheet-title { font-weight: 800; }
    .sheet-sub { font-size: .77rem; color: var(--creator-sub); }

    .advanced-gear { border-radius: 999px; width: 34px; height: 34px; padding: 0; }

    .ingredient-swiper {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        overflow: visible;
        padding: 4px 6px 6px;
        scrollbar-width: none;
    }
    .ingredient-swiper::-webkit-scrollbar { display:none; }

    .ingredient-chip {
        border: 1px solid var(--creator-border);
        background: rgba(255,255,255,0.08);
        color: var(--creator-text);
        border-radius: 14px;
        padding: 8px 12px;
        font-size: .82rem;
        white-space: nowrap;
        flex: 0 0 auto;
        margin: 1px 0;
        transition: all .2s ease;
    }

    .ingredient-chip.active {
        transform: scale(1.06);
        border-color: rgba(141,99,255,.8);
        box-shadow: 0 0 0 3px rgba(141,99,255,.28);
        background: rgba(141,99,255,.25);
    }

    .template-library {
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-right: 2px;
        min-height: 0;
        flex: 1;
    }


    .template-library-fixed {
        height: 50vh;
        max-height: 50vh;
        overflow-y: auto;
    }

    .template-card {
        border: 1px solid var(--creator-border);
        border-radius: 14px;
        background: rgba(255,255,255,0.08);
        color: var(--creator-text);
        text-align: left;
        padding: 10px;
        transition: transform .18s ease, border-color .18s ease, background .18s ease;
    }

    .template-card.active {
        border-color: rgba(141,99,255,.8);
        background: rgba(141,99,255,.2);
    }

    .template-card.template-tap { transform: scale(.98); }

    .template-title { font-weight: 700; font-size: .86rem; }
    .template-snippet { font-size: .76rem; color: var(--creator-sub); white-space: normal; overflow: visible; text-overflow: unset; line-height: 1.35; }

    .action-bar {
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap: 8px;
        margin-top: auto;
    }

    .story-meta { font-size: .76rem; color: var(--creator-sub); display:flex; gap:6px; align-items:center; }
    .action-buttons { display:flex; gap:8px; }

    .creator-cta-primary {
        border: 0;
        border-radius: 999px;
        background: linear-gradient(135deg, #8d63ff 0%, #5f85ff 100%);
        color: #fff;
        font-weight: 700;
        font-size: .82rem;
        padding: 8px 12px;
    }


    .creator-toast {
        position: absolute;
        left: 50%;
        transform: translateX(-50%) translateY(10px);
        bottom: 44%;
        opacity: 0;
        pointer-events: none;
        transition: all .25s ease;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(16,20,35,.86);
        border: 1px solid rgba(255,255,255,0.2);
        font-size: .78rem;
    }

    .creator-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

    .template-fly-ghost {
        position: absolute;
        z-index: 6;
        opacity: 0;
        pointer-events: none;
        font-size: .74rem;
        background: rgba(141,99,255,.85);
        border-radius: 999px;
        padding: 6px 10px;
        color: #fff;
    }

    .template-fly-ghost.fly { animation: flyToPreview .5s ease forwards; }

    @@keyframes flyToPreview {
        0% { opacity: 0; transform: translate(0,0) scale(.85); }
        30% { opacity: 1; }
        100% { opacity: 0; transform: translate(0,-120px) scale(1.04); }
    }



</style>



@section Scripts {
    <script>window.MasterStepRendererConfig = { dataUrl: '@Url.Content("~/data/master_steps.json")' };</script>
    <script>
        window.CreatePostingConfig = {
            stepCatalog: @Html.Raw(stepCatalogJson),
            stepIngredientBindings: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stepIngredientBindings)),
            dbUnits: @Html.Raw(dbUnitsJson),
            upsertStepUrl: '@Url.Action("UpsertStep", "Home", new { area = "WorldMiniApp" })'
        };
    </script>
    <script src="~/js/master-step-renderer.js" asp-append-version="true"></script>
    <script src="~/js/world-create-posting.js" asp-append-version="true"></script>
}
