@model DelikatessenDrehbuch.Areas.WorldMiniApp.Models.WorldUserPosting
@using System.Text.Json
@using System.Linq
@using Newtonsoft.Json


@{
   
    var stepIngredientBindings = Model.IngredientStepJoins
        .Where(x => x.Preperation != null && x.Ingredient != null)
        .GroupBy(x => x.Preperation.Id)
        .ToDictionary(
            group => group.Key,
            group => group.Select(x => x.Ingredient.Id).Distinct().ToList());

    var stepCatalogJson = System.Text.Json.JsonSerializer.Serialize(
        Model.ToSelectRecipePreperationSteps?.Select(step => new
        {
            id = step.Id,
            de = step.Step_DE,
            en = step.Step_EN,
            esp = step.Step_ESP,
            prt = step.Step_PRT,
            phase = step.Phase,
            equipment = step.Equipment
        }) ?? Enumerable.Empty<object>());

    ViewData["Title"] = "Rezept Erstellen";
    Layout = "_MiniAppLayout";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/creator-studio.css" asp-append-version="true" />
}

<div class="creator-bg min-vh-100 position-relative">
    <!-- Loading Overlay -->
    <div id="datatableLoadingOverlay" class="creator-loading">
        <div class="creator-loading-card">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Lade...</span>
            </div>
            <div class="fw-bold mt-2">Lade Daten...</div>
            <div class="small text-muted">Einen Moment bitte</div>
        </div>
    </div>

    <!-- Topbar (Social Creator) -->
    <div class="creator-topbar px-3 py-3" style="visibility:hidden">
        <a href="@Url.Action("Index", "Home", new { area = "WorldMiniApp" })" class="topbar-btn" aria-label="Zurück">
            <i class="bi bi-chevron-left"></i>
        </a>

        <div class="topbar-title">
            <div class="fw-bold text-truncate">Creator Studio</div>
            <div class="small text-muted text-truncate">Neuer Upload · Rezeptpost</div>
        </div>

        <div class="autosave-badge" aria-live="polite">
            <i class="bi bi-check2-circle me-1"></i>Auto-Saved
        </div>
    </div>

    <div class="feed-shell mx-auto" style="visibility:hidden">
        <form asp-action="UploadNewVideo" method="post" enctype="multipart/form-data" id="recipeForm" onsubmit="return prepareBinding()">
            <input type="hidden" name="userHash" id="hiddenUserTokenField" />

            <!-- HERO CARD -->
            <div class="creator-hero mb-3">
                <div class="creator-hero-left">
                    <div class="creator-hero-badge">
                        <i class="bi bi-stars me-2"></i>
                        <span class="label-lang" data-de="Upload ready" data-en="Upload ready" data-esp="Listo para subir" data-prt="Pronto para envio">Upload ready</span>
                    </div>

                    <h1 class="creator-hero-title mb-1">Neuen Content erstellen</h1>
                    <p class="creator-hero-sub mb-0">
                        Media · Zutaten · Schritte · Keywords
                    </p>
                </div>

                <div class="creator-hero-right">
                    <div class="progress-dots" aria-hidden="true">
                        <span class="dot active"></span>
                        <span class="dot"></span>
                        <span class="dot"></span>
                        <span class="dot"></span>
                        <span class="dot"></span>
                    </div>
                    <div class="small text-muted mt-2">5 Steps</div>
                    <div class="hero-progress-track mt-2" role="progressbar" aria-valuemin="0" aria-valuemax="5" aria-valuenow="1">
                        <span class="hero-progress-value"></span>
                    </div>
                </div>
            </div>

            <!-- 1) BASICS -->
            <section class="creator-card mb-3" id="card-basics">
                <div class="creator-card-head">
                    <div class="d-flex align-items-center gap-2">
                        <div class="card-icon candy-blue"><i class="bi bi-ui-checks-grid"></i></div>
                        <div>
                            <div class="creator-card-title label-lang" data-de="Basis" data-en="Basics" data-esp="Básico" data-prt="Base">Basis</div>
                            <div class="creator-card-sub label-lang" data-de="Titel, Kategorie, Personen, Dauer" data-en="Title, category, persons, time" data-esp="Título, categoría, personas, tiempo" data-prt="Título, categoria, pessoas, tempo">
                                Titel, Kategorie, Personen, Dauer
                            </div>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light border">1/5</span>
                </div>

                <div class="creator-card-body">
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-2 label-lang"
                               data-de="Titel"
                               data-en="Title"
                               data-esp="Título"
                               data-prt="Título">Titel</label>

                        <div class="input-pill">
                            <i class="bi bi-fonts text-muted"></i>
                            <input asp-for="Title"
                                   class="form-control border-0 bg-transparent fw-bold shadow-none lang-ph"
                                   placeholder="Titel"
                                   data-ph-de="Titel" data-ph-en="Title" data-ph-esp="Título" data-ph-prt="Título"
                                   required />
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-2 label-lang"
                                   data-de="Kategorie"
                                   data-en="Category"
                                   data-esp="Categoría"
                                   data-prt="Categoria">Kategorie</label>

                            <div class="select-pill">
                                <i class="bi bi-grid text-muted"></i>
                                <select asp-for="Recipe.Category" class="form-select border-0 bg-transparent fw-bold shadow-none cursor-pointer">
                                    <option value="" selected disabled class="lang-opt"
                                            data-txt-de="Kategorie"
                                            data-txt-en="Category"
                                            data-txt-esp="Categoría"
                                            data-txt-prt="Categoria">Kategorie</option>

                                    <option value="Appetizer" class="lang-opt" data-txt-de="Vorspeise" data-txt-en="Appetizer" data-txt-esp="Entrada" data-txt-prt="Entrada">Vorspeise</option>
                                    <option value="Main" class="lang-opt" data-txt-de="Hauptspeise" data-txt-en="Main Course" data-txt-esp="Plato principal" data-txt-prt="Prato principal">Hauptspeise</option>
                                    <option value="Dessert" class="lang-opt" data-txt-de="Dessert" data-txt-en="Dessert" data-txt-esp="Postre" data-txt-prt="Sobremesa">Dessert</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-6">
                            <label class="form-label small text-muted mb-2 label-lang"
                                   data-de="Präferenz"
                                   data-en="Preference"
                                   data-esp="Preferencia"
                                   data-prt="Preferência">Präferenz</label>

                            <div class="select-pill">
                                <i class="bi bi-heart text-muted"></i>
                                <select asp-for="Recipe.Preferences" class="form-select border-0 bg-transparent fw-bold shadow-none cursor-pointer">
                                    <option value="" selected disabled class="lang-opt"
                                            data-txt-de="Präferenz"
                                            data-txt-en="Preference"
                                            data-txt-esp="Preferencia"
                                            data-txt-prt="Preferência">Präferenz</option>

                                    <option value="Vegan" class="lang-opt" data-txt-de="Vegan" data-txt-en="Vegan" data-txt-esp="Vegano" data-txt-prt="Vegano">Vegan</option>
                                    <option value="Vegetarian" class="lang-opt" data-txt-de="Vegetarisch" data-txt-en="Vegetarian" data-txt-esp="Vegetariano" data-txt-prt="Vegetariano">Vegetarisch</option>
                                    <option value="Fish" class="lang-opt" data-txt-de="Fisch" data-txt-en="Fish" data-txt-esp="Pescado" data-txt-prt="Peixe">Fisch</option>
                                    <option value="Pork" class="lang-opt" data-txt-de="Schwein" data-txt-en="Pork" data-txt-esp="Cerdo" data-txt-prt="Porco">Schwein</option>
                                    <option value="Beef" class="lang-opt" data-txt-de="Rind" data-txt-en="Beef" data-txt-esp="Res" data-txt-prt="Carne">Rind</option>
                                    <option value="OtherMeat" class="lang-opt" data-txt-de="Anderes Fleisch" data-txt-en="Other Meat" data-txt-esp="Otra carne" data-txt-prt="Outra carne">Anderes Fleisch</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-2 label-lang"
                                   data-de="Personen"
                                   data-en="Persons"
                                   data-esp="Personas"
                                   data-prt="Pessoas">Personen</label>

                            <div class="input-pill">
                                <i class="bi bi-people text-muted"></i>
                                <input asp-for="Recipe.PersonCount"
                                       type="number"
                                       class="form-control border-0 bg-transparent fw-bold shadow-none lang-ph"
                                       placeholder="Personen"
                                       data-ph-de="Personen" data-ph-en="Persons" data-ph-esp="Personas" data-ph-prt="Pessoas" />
                            </div>
                        </div>

                        <div class="col-6">
                            <label class="form-label small text-muted mb-2 label-lang"
                                   data-de="Dauer (Min)"
                                   data-en="Time (min)"
                                   data-esp="Tiempo (min)"
                                   data-prt="Tempo (min)">Dauer (Min)</label>

                            <div class="input-pill">
                                <i class="bi bi-clock text-muted"></i>
                                <input asp-for="Recipe.PreperationTime"
                                       type="number"
                                       class="form-control border-0 bg-transparent fw-bold shadow-none lang-ph"
                                       placeholder="Minuten"
                                       data-ph-de="Minuten" data-ph-en="Minutes" data-ph-esp="Minutos" data-ph-prt="Minutos" />
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 2) MEDIA -->
            <section class="creator-card mb-3" id="card-media">
                <div class="creator-card-head">
                    <div class="d-flex align-items-center gap-2">
                        <div class="card-icon candy-pink"><i class="bi bi-camera-reels"></i></div>
                        <div>
                            <div class="creator-card-title label-lang" data-de="Media" data-en="Media" data-esp="Medios" data-prt="Mídia">Media</div>
                            <div class="creator-card-sub label-lang" data-de="Video oder Bild für den Feed" data-en="Video or image for the feed" data-esp="Video o imagen para el feed" data-prt="Vídeo ou imagem para o feed">
                                Video oder Bild für den Feed
                            </div>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light border">2/5</span>
                </div>

                <div class="creator-card-body">
                    <div id="videoPreviewContainer" class="d-none mb-3">
                        <div class="media-preview">
                            <img id="imagePreview" class="w-100 d-none" style="max-height: 320px; object-fit: cover;" alt="Preview" />
                            <video id="videoPreview" class="w-100" style="max-height: 320px; object-fit: cover;" controls></video>
                            <button type="button" class="btn btn-light btn-sm media-reset" onclick="resetVideo()">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>

                    <label id="uploadLabel" class="upload-drop" for="videoInput">
                        <div class="upload-icon">
                            <i class="bi bi-cloud-arrow-up-fill"></i>
                        </div>
                        <div class="fw-bold mb-1 label-lang"
                             data-de="Upload starten"
                             data-en="Start upload"
                             data-esp="Iniciar subida"
                             data-prt="Iniciar envio">
                            Upload starten
                        </div>

                        <div class="small text-muted label-lang"
                             data-de="Wähle ein Video oder Bild (Feed-Style)."
                             data-en="Choose a video or image (feed style)."
                             data-esp="Elige un video o imagen (estilo feed)."
                             data-prt="Escolha um vídeo ou imagem (estilo feed).">
                            Wähle ein Video oder Bild (Feed-Style).
                        </div>

                        <input asp-for="Content" type="file" accept="video/*,image/*" class="d-none" id="videoInput" onchange="handleVideoUpload(this)" />
                    </label>
                </div>
            </section>

            <!-- 3) INGREDIENTS -->
            <section class="creator-card mb-3" id="card-ingredients">
                <div class="creator-card-head">
                    <div class="d-flex align-items-center gap-2">
                        <div class="card-icon candy-green"><i class="bi bi-basket"></i></div>
                        <div>
                            <div class="creator-card-title label-lang" data-de="Zutaten" data-en="Ingredients" data-esp="Ingredientes" data-prt="Ingredientes">Zutaten</div>
                            <div class="creator-card-sub label-lang" data-de="Suche + hinzufügen wie im Creator Flow" data-en="Search + add like a creator flow" data-esp="Buscar + añadir como flujo" data-prt="Buscar + adicionar como fluxo">
                                Suche + hinzufügen wie im Creator Flow
                            </div>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light border">3/5</span>
                </div>

                <div class="creator-card-body">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="creatorFlowToggle" checked>
                            <label class="form-check-label small" for="creatorFlowToggle">Creator Flow</label>
                        </div>
                    </div>

                    <div class="mb-2">
                        <input type="text"
                               id="ingredientSearch"
                               class="form-control form-control-sm"
                               placeholder="Zutaten suchen..." />
                    </div>

                    <div class="table-responsive creator-table-wrap">
                        <table id="ingredientsDbTable" class="table table-hover align-middle small border-0 w-100">
                            <thead>
                                <tr>
                                    <th class="small text-muted">Zutat, Menge, Einheit</th>
                                    <th class="d-none" aria-hidden="true"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.ToSelectIngredientsAndNutrients != null)
                                {
                                    foreach (var item in Model.ToSelectIngredientsAndNutrients)
                                    {
                                        <tr class="ingredient-db-row"
                                            data-ingredient-id="@item.Id"
                                            data-name-de="@item.Name_DE"
                                            data-name-en="@item.Name_EN"
                                            data-name-esp="@item.Name_ESP"
                                            data-name-prt="@item.Name_PRT">
                                            <td>
                                                <div class="fw-bold display-name">@item.Name_DE</div>

                                                <div class="row g-2 mt-2 ingredient-inline-inputs align-items-end">
                                                    <div class="col-5" style="max-width: 26%">
                                                        <label class="small text-muted">Menge</label>
                                                        <input type="text" inputmode="decimal" class="form-control form-control-sm js-db-qty js-decimal-input" value="0" />
                                                    </div>

                                                    <div class="col-5" style="max-width: 54%">
                                                        <label class="small text-muted">Einheit</label>
                                                        <select class="form-select form-select-sm js-db-unit">
                                                            @if (Model.Measure != null)
                                                            {
                                                                foreach (var measure in Model.Measure)
                                                                {
                                                                    <option value="@measure.UnitOfMeasurement">@measure.UnitOfMeasurement</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>

                                                    <div class="col-2 text-end" style="max-width: fit-content">
                                                        <button type="button" class="btn btn-sm candy-green rounded-circle shadow-sm" onclick="addIngredient('@item.Id', this)">
                                                            <i class="bi bi-plus"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="d-none" aria-hidden="true"></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    
                </div>
                <div class="selected-subsection-title">Ausgewählte Zutaten</div>
                <div id="selectedIngredients" class="mt-2 selected-zone"></div>
            </section>

            <!-- 4) STEPS + SANDBOX -->
            <section class="creator-card mb-3" id="card-steps">
                <div class="creator-card-head">
                    <div class="d-flex align-items-center gap-2">
                        <div class="card-icon candy-purple"><i class="bi bi-list-check"></i></div>
                        <div>
                            <div class="creator-card-title label-lang" data-de="Arbeitsschritte" data-en="Steps" data-esp="Pasos" data-prt="Passos">Arbeitsschritte</div>
                            <div class="creator-card-sub label-lang" data-de="Add & sortiere wie ein Script" data-en="Add & order like a script" data-esp="Añadir y ordenar como guion" data-prt="Adicionar e ordenar como roteiro">
                                Add & sortiere wie ein Script
                            </div>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light border">4/5</span>
                </div>

                <div class="creator-card-body">
                    <!-- Sandbox Studio -->
                    <div class="sandbox-studio mt-3">
                        <div class="sandbox-head">
                            <div>
                                <div class="sandbox-title">Sandbox Studio</div>
                                <div class="sandbox-sub">Schnelles Verknüpfen wie in einem Creator-Workflow</div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" id="btnSuggestSteps" class="btn btn-sm btn-outline-primary rounded-pill" onclick="suggestSteps()" disabled>
                                    <i class="bi bi-magic me-1"></i>Schritte vorschlagen
                                </button>
                                <span class="badge text-bg-light border">Beta</span>
                            </div>
                        </div>
                        <div id="recipeTypeScoreBar" class="mt-2 d-none">
                            <div class="d-flex flex-wrap align-items-center gap-1">
                                <span class="small text-muted me-1">Rezepttyp:</span>
                                <span id="recipeTypeBadges"></span>
                            </div>
                        </div>
                        <div id="masterStepPreviewBox" class="mt-2 d-none">
                            <div class="small text-muted mb-1">Master-Step Vorschau:</div>
                            <div id="masterStepPreviewList" class="d-flex flex-column gap-1"></div>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-5">
                                <div class="sandbox-panel h-100">
                                    <div class="fw-bold small mb-2">Ausgewählte Zutaten</div>
                                    <div id="sandboxIngredientList" class="d-flex flex-column gap-2">
                                        <div class="text-muted small">Noch keine Zutat ausgewählt.</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-7" id="suggestSheetColumn">
                                <div class="sandbox-panel h-100 suggest-sheet" id="suggestSheet">
                                    <button type="button" class="btn btn-sm btn-light sheet-close d-md-none" id="closeSuggestSheet" aria-label="Schließen"><i class="bi bi-x-lg"></i></button>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="fw-bold small">Vorschläge</div>
                                        <span id="sandboxActiveIngredientLabel" class="badge text-bg-light border">Keine aktive Zutat</span>
                                    </div>

                                    <div class="mb-2">
                                        <input type="text"
                                               id="stepSearch"
                                               class="form-control form-control-sm"
                                               placeholder="Schritte durchsuchen..." />
                                    </div>

                                    <div class="sandbox-tabs" id="sandboxStepTabs" role="tablist">
                                        <button class="sandbox-tab active" type="button" data-sandbox-tab="linked">Aktive Zutat</button>
                                        <button class="sandbox-tab" type="button" data-sandbox-tab="all">Alle Zutaten</button>
                                        <button class="sandbox-tab" type="button" data-sandbox-tab="unbound">Ohne Binding</button>
                                    </div>

                                    <div class="mt-2 d-none" id="sandboxUnboundSearchWrap">
                                        <input type="text"
                                               id="sandboxUnboundSearch"
                                               class="form-control form-control-sm"
                                               placeholder="Ungebundene Schritte durchsuchen..." />
                                        <div class="d-flex flex-wrap gap-1 mt-2" id="equipmentFilterBar">
                                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill equipment-filter-btn active" data-equipment="all" style="font-size:.78rem;">
                                                <i class="bi bi-grid me-1"></i>Alle
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill equipment-filter-btn" data-equipment="1" style="font-size:.78rem;">
                                                <i class="bi bi-thermometer-high me-1"></i>Backofen
                                            </button>
                                            <button type="button" class="btn btn-outline-warning btn-sm rounded-pill equipment-filter-btn" data-equipment="2" style="font-size:.78rem;">
                                                <i class="bi bi-fire me-1"></i>Pfanne
                                            </button>
                                            <button type="button" class="btn btn-outline-info btn-sm rounded-pill equipment-filter-btn" data-equipment="3" style="font-size:.78rem;">
                                                <i class="bi bi-cup-hot me-1"></i>Topf
                                            </button>
                                            <button type="button" class="btn btn-outline-success btn-sm rounded-pill equipment-filter-btn" data-equipment="4" style="font-size:.78rem;">
                                                <i class="bi bi-fire me-1"></i>Bräter
                                            </button>
                                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill equipment-filter-btn" data-equipment="5" style="font-size:.78rem;">
                                                <i class="bi bi-lightning me-1"></i>Kochfeld
                                            </button>
                                        </div>
                                    </div>

                                    <div id="sandboxStepCandidates" class="d-flex flex-column gap-2 mt-2 sandbox-step-list">
                                        <div class="text-muted small">Wähle links eine Zutat aus.</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <div id="sandboxCurrentStep" class="sandbox-current text-muted">Aktueller Schritt: noch keiner.</div>
                            <div id="sandboxPreviousSteps" class="mt-2 d-flex flex-column gap-2">
                                <div class="text-muted small">Vorherige Schritte erscheinen hier.</div>
                            </div>
                        </div>
                    </div>

                    <div class="master-accordion mt-3">
                        <button class="master-accordion-trigger" type="button" aria-expanded="false" aria-controls="masterBuilderPanel">
                            <span>Master Template Builder</span>
                            <small>Schnelles Verknüpfen</small>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div id="masterBuilderPanel" class="master-accordion-panel">
                            <div class="master-step-builder p-3">
                                <div class="fw-bold mb-2">Master Template Builder</div>
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1">Zutaten (Mehrfachauswahl)</label>
                                <div id="masterIngredientButtons" class="d-flex flex-wrap gap-2 master-button-wrap"></div>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small text-muted mb-1">Template</label>
                                <select id="masterTemplateSelect" class="form-select form-select-sm"></select>
                            </div>
                            <div class="col-md-3 d-grid">
                                <button type="button" id="btnAddRenderedStep" class="btn btn-sm btn-primary">
                                    <i class="bi bi-check2-circle me-1"></i>Übernehmen
                                </button>
                            </div>
                        </div>
                        <div id="masterVariables" class="row g-2 mt-1"></div>
                        <div class="small text-muted mt-2 d-flex align-items-center justify-content-between">
                            <span>Preview:</span>
                            <button type="button" id="copyMasterPreview" class="btn btn-sm btn-light rounded-pill"><i class="bi bi-copy"></i></button>
                        </div>
                        <div id="masterPreviewText" class="small border rounded px-2 py-2 bg-light">Noch kein Template gewählt.</div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="fw-bold">Zusammengestellte Arbeitsschritte</div>
                            <div class="small text-muted">Sortieren, prüfen und bearbeiten</div>
                        </div>
                        <div id="selectedSteps" class="selected-zone"></div>
                    </div>
                </div>
            </section>

            <!-- 5) KEYWORDS -->
            <section class="creator-card mb-4" id="card-keywords">
                <div class="creator-card-head">
                    <div class="d-flex align-items-center gap-2">
                        <div class="card-icon candy-blue"><i class="bi bi-hash"></i></div>
                        <div>
                            <div class="creator-card-title label-lang" data-de="Keywords" data-en="Keywords" data-esp="Palabras clave" data-prt="Palavras-chave">Keywords</div>
                            <div class="creator-card-sub label-lang" data-de="Hilft beim Feed & bei Suche" data-en="Helps feed & search" data-esp="Ayuda al feed y búsqueda" data-prt="Ajuda no feed e busca">
                                Hilft beim Feed & bei Suche
                            </div>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light border">5/5</span>
                </div>

                <div class="creator-card-body">
                    <div id="keywordGrid" class="d-flex flex-wrap gap-2 keyword-grid">
                        @if (Model.ToSelectKeywords != null)
                        {
                            foreach (var keyword in Model.ToSelectKeywords)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary rounded-pill keyword-btn"
                                        data-keyword-id="@keyword.Id"
                                        data-word-de="@keyword.Word_DE"
                                        data-word-en="@keyword.Word_EN"
                                        data-word-esp="@keyword.Word_ESP"
                                        data-word-prt="@keyword.Word_PRT"
                                        onclick="toggleKeyword('@keyword.Id', this)">
                                    @keyword.Word_DE
                                </button>
                            }
                        }
                    </div>

                    <button type="button" id="toggleKeywordExpand" class="btn btn-link btn-sm px-0 mt-2">Mehr anzeigen</button>
                    <div id="selectedKeywords" class="mt-3 selected-zone"></div>
                </div>
            </section>

            <div class="fixed-bottom creator-bottom p-3">
                <div class="creator-bottom-inner">
                    <button type="button" class="btn draft-btn">Entwurf speichern</button>
                    <button type="submit" class="btn publish-btn">
                        <span class="label-lang" data-de="Veröffentlichen" data-en="Publish" data-esp="Publicar" data-prt="Publicar">Veröffentlichen</span>
                        <i class="bi bi-send-fill ms-2"></i>
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>





@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="~/js/recipe-step-suggest.js"></script>
    <script src="~/js/master-step-renderer.js"></script>
    <script>
        const stepCatalog = @Html.Raw(stepCatalogJson);
         const stepIngredientBindings = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stepIngredientBindings));
         var dbUnits = @Html.Raw(JsonConvert.SerializeObject(Model.Measure?.Select(x => x.UnitOfMeasurement).ToList() ?? new List<string>()));

         function getCookieValue(name) {
             const cookie = document.cookie.split('; ').find(row => row.startsWith(`${name}=`));
             return cookie ? decodeURIComponent(cookie.split('=')[1]) : null;
         }

        function resolveLangKey(value) {
            const normalized = (value || 'de').toLowerCase();
            if (normalized === 'es') return 'esp';
            if (normalized === 'pt') return 'prt';
            return normalized;
        }

        let currentLang = resolveLangKey(getCookieValue('deli-lang'));
        let activeSandboxIngredientId = null;
        let activeSandboxIngredientName = '';
        let activeSandboxTab = 'linked';
        let sandboxUnboundSteps = [];
        let activeEquipmentFilter = 'all';
        let selectedMasterIngredientNames = [];
        let selectedMasterTemplateId = '';
        let tempStepIdCounter = -1;

        function getAllStepRows() {
            return Array.isArray(stepCatalog) ? stepCatalog : [];
        }

        function getPhaseLabel(phase) {
            const map = {
                1: { text: 'Vorb.', cls: 'phase-badge-1' },
                2: { text: 'Kochen', cls: 'phase-badge-2' },
                3: { text: 'Würzen', cls: 'phase-badge-3' },
                4: { text: 'Finish', cls: 'phase-badge-4' }
            };
            const info = map[phase];
            if (!info) return '';
            return `<span class="phase-badge ${info.cls}">${info.text}</span>`;
        }

        function getEquipmentLabel(equipment) {
            const map = {
                1: { text: 'Backofen', cls: 'equip-badge-1', icon: 'bi-thermometer-high' },
                2: { text: 'Pfanne', cls: 'equip-badge-2', icon: 'bi-fire' },
                3: { text: 'Topf', cls: 'equip-badge-3', icon: 'bi-cup-hot' },
                4: { text: 'Bräter', cls: 'equip-badge-4', icon: 'bi-fire' },
                5: { text: 'Kochfeld', cls: 'equip-badge-5', icon: 'bi-lightning' }
            };
            const info = map[equipment];
            if (!info) return '';
            return `<span class="equipment-badge ${info.cls}"><i class="bi ${info.icon} me-1"></i>${info.text}</span>`;
        }

        function updateSuggestButtonState() {
            const hasIngredients = getSelectedIngredientIds().length > 0;
            $('#btnSuggestSteps').prop('disabled', !hasIngredients);
        }

        /** Live recipe type detection when ingredients change */
        function updateRecipeTypeDetection() {
            const selectedIds = getSelectedIngredientIds();
            const selectedNames = getSelectedIngredientsForSandbox().map(x => x.name);
            const scoreBar = $('#recipeTypeScoreBar');
            const badges = $('#recipeTypeBadges');
            const masterBox = $('#masterStepPreviewBox');
            const masterList = $('#masterStepPreviewList');

            if (!selectedIds.length) {
                scoreBar.addClass('d-none');
                masterBox.addClass('d-none');
                return;
            }

            const suggest = window.RecipeStepSuggest;
            if (suggest && typeof suggest.isLoaded === 'function' && !suggest.isLoaded() && typeof suggest.loadMapping === 'function') {
                suggest.loadMapping().then(() => updateRecipeTypeDetection());
                return;
            }

            const types = suggest && typeof suggest.detectRecipeTypes === 'function'
                ? suggest.detectRecipeTypes(selectedIds)
                : [];

            if (types.length && suggest && typeof suggest.renderRecipeTypeBadges === 'function') {
                badges.html(suggest.renderRecipeTypeBadges(types, 3));
                scoreBar.removeClass('d-none');
            } else {
                scoreBar.addClass('d-none');
            }

            if (window.MasterStepRenderer && typeof MasterStepRenderer.suggestForIngredient === 'function' && typeof MasterStepRenderer.render === 'function') {
                const previews = [];
                selectedNames.slice(0, 2).forEach(name => {
                    const steps = MasterStepRenderer.suggestForIngredient(name).slice(0, 3);
                    steps.forEach(step => {
                        const defaults = MasterStepRenderer.getSmartDefaults(step.master_id, { ingredientName: name, recipeCategory: $('#Recipe_Category').val() });
                        const text = MasterStepRenderer.render(step.master_id, defaults, currentLang);
                        if (text) {
                            previews.push({ phase: parseInt(step.phase || 0, 10), text });
                        }
                    });
                });

                if (previews.length) {
                    masterList.empty();
                    previews.slice(0, 5).forEach(item => {
                        masterList.append(`<div class="small border rounded px-2 py-1 bg-light"><span class="badge text-bg-secondary me-2">P${item.phase}</span>${item.text}</div>`);
                    });
                    masterBox.removeClass('d-none');
                } else {
                    masterBox.addClass('d-none');
                }
            } else {
                masterBox.addClass('d-none');
            }
        }

        // Hilfsfunktion: Gibt die Zutat-IDs zurück, an die ein Step gebunden ist
        function getStepBoundIngredientIds(stepId) {
            return (stepIngredientBindings[stepId] ?? stepIngredientBindings[stepId?.toString?.()] ?? []).map(x => parseInt(x, 10));
        }

        // Prüft ob für eine bestimmte Zutat+Phase Kombination bereits ein Step ausgewählt ist
        function isIngredientPhaseCovered(ingredientId, phase) {
            const ingIdStr = ingredientId.toString();
            let covered = false;
            $('#selectedSteps .step-row').each(function () {
                const rowStepId = $(this).data('step-id')?.toString();
                const rowStep = getAllStepRows().find(x => x && x.id?.toString() === rowStepId);
                if (!rowStep) return;
                const rowPhase = parseInt(rowStep.phase ?? 0, 10);
                if (rowPhase !== phase || rowPhase < 1) return;
                const rowBoundIds = getStepBoundIngredientIds(rowStepId).map(x => x.toString());
                if (rowBoundIds.includes(ingIdStr)) {
                    covered = true;
                    return false; // break
                }
            });
            return covered;
        }

        function suggestSteps() {
            const selectedIds = getSelectedIngredientIds();
            if (!selectedIds.length) return;

            const existingSteps = $('#selectedSteps .step-row').length;
            if (existingSteps > 0) {
                if (!confirm('Bestehende Schritte ersetzen?')) return;
            }

            // Collect selected ingredient names for conflict checking
            const selectedNames = getSelectedIngredientsForSandbox().map(x => x.name);

            // Build a stepId lookup from the page catalog
            const catalogById = {};
            getAllStepRows().forEach(s => { catalogById[s.id.toString()] = s; });

            function runSuggestion() {
                const result = RecipeStepSuggest.suggestStepsForIngredients(selectedIds, catalogById, {
                    selectedIngredientNames: selectedNames,
                    maxSteps: 20
                });

                // Show recipe type score
                const scoreBar = $('#recipeTypeScoreBar');
                const badges = $('#recipeTypeBadges');
                if (result.recipeTypes.length) {
                    badges.html(RecipeStepSuggest.renderRecipeTypeBadges(result.recipeTypes, 3));
                    scoreBar.removeClass('d-none');
                } else {
                    scoreBar.addClass('d-none');
                }

                // If mapping has results, use them; otherwise fall back to DB binding logic
                if (result.steps.length) {
                    $('#selectedSteps').empty();
                    result.steps.forEach(item => {
                        const sourceRow = catalogById[item.stepId.toString()];
                        const label = sourceRow ? getStepLabelFromRow(sourceRow) : `Schritt ${item.stepId}`;
                        addStep(item.stepId.toString(), null, label, { skipRender: true });
                    });
                    updateStepIndices();
                    renderSandboxStepTab();
                    return;
                }

                // Fallback: original DB-binding-based logic
                suggestStepsFallback();
            }

            if (RecipeStepSuggest.isLoaded()) {
                runSuggestion();
            } else {
                RecipeStepSuggest.loadMapping()
                    .then(() => runSuggestion())
                    .catch(() => suggestStepsFallback());
            }
        }

        /** Original suggest logic as fallback when JSON mapping is unavailable */
        function suggestStepsFallback() {
            const selectedIds = getSelectedIngredientIds();
            const allSteps = getAllStepRows();
            const bestPerCombo = new Map();

            allSteps.forEach(step => {
                const stepId = step.id;
                const phase = parseInt(step.phase ?? 0, 10);
                if (phase < 1) return;
                const boundIds = getStepBoundIngredientIds(stepId);
                if (!boundIds.length) return;
                const matchingIngredients = boundIds.filter(bid => selectedIds.includes(bid));
                if (!matchingIngredients.length) return;

                matchingIngredients.forEach(ingId => {
                    const key = `${ingId}_${phase}`;
                    const matchCount = matchingIngredients.length;
                    const existing = bestPerCombo.get(key);
                    if (!existing || matchCount > existing.matchCount) {
                        bestPerCombo.set(key, { stepId, phase, matchCount, ingId });
                    }
                });
            });

            const uniqueSteps = new Map();
            const phaseOrder = { 1: 0, 2: 1, 3: 2, 4: 3, 0: 4 };
            bestPerCombo.forEach(item => {
                if (!uniqueSteps.has(item.stepId)) uniqueSteps.set(item.stepId, item);
            });

            const sorted = [...uniqueSteps.values()].sort((a, b) => {
                const pa = phaseOrder[a.phase] ?? 4;
                const pb = phaseOrder[b.phase] ?? 4;
                if (pa !== pb) return pa - pb;
                return b.matchCount - a.matchCount;
            });

            $('#selectedSteps').empty();
            sorted.forEach(item => {
                const sourceRow = allSteps.find(x => x.id === item.stepId);
                const label = sourceRow ? getStepLabelFromRow(sourceRow) : `Schritt ${item.stepId}`;
                addStep(item.stepId.toString(), null, label, { skipRender: true });
            });
            updateStepIndices();
            renderSandboxStepTab();
        }

        function getSelectedIngredientIds() {
            return $('#selectedIngredients input[name$="IngredientsAndNutrients.Id"]').map(function () {
                return parseInt($(this).val(), 10);
            }).get().filter(id => !isNaN(id));
        }

        function getSelectedIngredientsForSandbox() {
            const fromSelected = $('#selectedIngredients .ingredient-row').map(function () {
                const row = $(this);
                const id = row.find('input[name$="IngredientsAndNutrients.Id"]').val()?.toString() || '';
                const name = row.find('.display-name-selected').text()?.trim() || '';
                return { id, name };
            }).get().filter(x => x.id || x.name);

            if (fromSelected.length) {
                return fromSelected.map(x => ({ id: x.id || '', name: x.name || 'Zutat' }));
            }

            const fromSandbox = $('#sandboxIngredientList .sandbox-ingredient-btn').map(function () {
                const btn = $(this);
                return {
                    id: btn.data('id')?.toString() || '',
                    name: btn.data('name')?.toString() || 'Zutat'
                };
            }).get();

            if (fromSandbox.length) {
                return fromSandbox;
            }

            return [];
        }

        function buildIngredientTextForMaster() {
            const selected = selectedMasterIngredientNames.filter(x => !!x && x.trim());
            if (!selected.length) return '';
            if (selected.length === 1) return selected[0];
            if (selected.length === 2) return `${selected[0]} und ${selected[1]}`;
            return `${selected.slice(0, -1).join(', ')} und ${selected[selected.length - 1]}`;
        }

        const upsertStepUrl = '@Url.Action("UpsertStep", "Home", new { area = "WorldMiniApp" })';

        function refreshMasterTemplateBuilder() {
            const ingredientButtons = $('#masterIngredientButtons');
            const ingredients = getSelectedIngredientsForSandbox();
            ingredientButtons.empty();

            const availableNames = ingredients.map(item => item.name).filter(Boolean);
            selectedMasterIngredientNames = selectedMasterIngredientNames.filter(name => availableNames.includes(name));
            if (!selectedMasterIngredientNames.length && availableNames.length) {
                selectedMasterIngredientNames = [availableNames[0]];
            }

            if (!availableNames.length) {
                ingredientButtons.append('<div class="text-muted small">Keine Zutat gewählt</div>');
                $('#masterVariables').empty();
                $('#masterPreviewText').text('Noch kein Template gewählt.');
                refreshMasterTemplateOptions();
                return;
            }

            availableNames.forEach(name => {
                const isActive = selectedMasterIngredientNames.includes(name);
                ingredientButtons.append(`<button type="button" class="btn btn-sm ${isActive ? 'btn-primary' : 'btn-outline-secondary'} master-ingredient-btn" data-name="${name}">${name}</button>`);
            });

            // Hinweis: Mehrere Zutaten auswählbar
            if (availableNames.length > 1 && selectedMasterIngredientNames.length > 0) {
                ingredientButtons.append(`<div class="text-muted small mt-1">${selectedMasterIngredientNames.length} von ${availableNames.length} gewählt</div>`);
            }

            refreshMasterTemplateOptions();
        }

        function refreshMasterTemplateOptions() {
            const templateSelect = $('#masterTemplateSelect');
            const ingredientName = buildIngredientTextForMaster();
            templateSelect.empty();

            if (!window.MasterStepRenderer || typeof MasterStepRenderer.getAllTemplates !== 'function') {
                templateSelect.append('<option value="">Keine Templates</option>');
                $('#masterVariables').empty();
                $('#masterPreviewText').text('Master-Step Renderer nicht verfügbar.');
                selectedMasterTemplateId = '';
                return;
            }

            const templates = MasterStepRenderer.getAllTemplates();
            if (!templates.length) {
                templateSelect.append('<option value="">Keine Templates gefunden</option>');
                $('#masterVariables').empty();
                $('#masterPreviewText').text('Keine Master-Templates gefunden.');
                selectedMasterTemplateId = '';
                return;
            }

            if (!selectedMasterTemplateId || !templates.some(step => step.master_id === selectedMasterTemplateId)) {
                selectedMasterTemplateId = templates[0].master_id;
            }

            templates.forEach(step => {
                const defaults = MasterStepRenderer.getSmartDefaults(step.master_id, {
                    ingredientName: ingredientName,
                    recipeCategory: $('#Recipe_Category').val()
                });
                const localized = MasterStepRenderer.render(step.master_id, defaults, currentLang);
                const label = localized || step.description || step.master_id;
                templateSelect.append(`<option value="${step.master_id}">${label}</option>`);
            });

            templateSelect.val(selectedMasterTemplateId);
            renderMasterTemplateEditor();
        }

        function renderMasterTemplateEditor() {
            const templateId = selectedMasterTemplateId || $('#masterTemplateSelect').val();
            const ingredientName = buildIngredientTextForMaster();
            const box = $('#masterVariables');
            box.empty();

            if (!templateId || !window.MasterStepRenderer) {
                $('#masterPreviewText').text('Noch kein Template gewählt.');
                return;
            }

            const template = MasterStepRenderer.findTemplate(templateId);
            if (!template) {
                $('#masterPreviewText').text('Template nicht gefunden.');
                return;
            }

            const vars = MasterStepRenderer.getSmartDefaults(templateId, {
                ingredientName: ingredientName,
                recipeCategory: $('#Recipe_Category').val()
            });

            (template.variables || []).forEach(key => {
                const value = vars[key] || '';
                box.append(`<div class="col-md-4"><label class="form-label small text-muted mb-1">${key}</label><input type="text" class="form-control form-control-sm master-var-input" data-var="${key}" value="${value}" /></div>`);
            });

            updateMasterPreview();
        }

        function collectMasterVariables() {
            const vars = {};
            $('#masterVariables .master-var-input').each(function () {
                vars[$(this).data('var')] = $(this).val();
            });
            return vars;
        }

        function updateMasterPreview() {
            const templateId = selectedMasterTemplateId || $('#masterTemplateSelect').val();
            if (!templateId || !window.MasterStepRenderer) return;

            const vars = collectMasterVariables();
            const text = MasterStepRenderer.render(templateId, vars, currentLang);
            $('#masterPreviewText').text(text || 'Keine Vorschau verfügbar.');
        }

        function getCurrentUserHashForRequests() {
            const fromCookie = getCookieValue('WorldMiniAppUserHash');
            if (fromCookie) return fromCookie;

            const fromHidden = ($('#hiddenUserTokenField').val() || '').toString().trim();
            if (fromHidden) return fromHidden;

            const fromQuery = new URLSearchParams(window.location.search).get('userHash');
            return (fromQuery || '').toString().trim();
        }


        function createFallbackStepId() {
            tempStepIdCounter -= 1;
            return tempStepIdCounter.toString();
        }

        async function addRenderedMasterStep() {
            const templateId = selectedMasterTemplateId || $('#masterTemplateSelect').val();
            if (!templateId || !window.MasterStepRenderer) return;

            const template = MasterStepRenderer.findTemplate(templateId);
            if (!template) return;

            const vars = collectMasterVariables();
            const rendered = MasterStepRenderer.renderAll(templateId, vars);
            const payload = {
                de: rendered.de,
                en: rendered.en,
                esp: rendered.esp,
                prt: rendered.prt,
                phase: parseInt(template.phase || 0, 10),
                equipment: parseInt(template.equipment || 0, 10)
            };

            try {
                const userHash = getCurrentUserHashForRequests();
                const url = userHash ? `${upsertStepUrl}?userHash=${encodeURIComponent(userHash)}` : upsertStepUrl;
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(errorText || 'Upsert fehlgeschlagen');
                }

                const result = await response.json();
                const newId = result?.id;
                if (!newId) {
                    throw new Error('Keine Step-ID erhalten');
                }

                const alreadyExists = getAllStepRows().some(x => x && x.id?.toString() === newId.toString());
                if (!alreadyExists) {
                    getAllStepRows().push({
                        id: newId,
                        de: rendered.de,
                        en: rendered.en,
                        esp: rendered.esp,
                        prt: rendered.prt,
                        phase: payload.phase,
                        equipment: payload.equipment
                    });
                }

                addStep(newId.toString(), null, rendered[currentLang] || rendered.de || `Schritt ${newId}`, { skipRender: true });
                updateStepIndices();
                renderSandboxStepTab();
            } catch (error) {
                console.warn('Master-Step Upsert nicht möglich, nutze lokalen Fallback-Step', error);

                const fallbackId = createFallbackStepId();
                getAllStepRows().push({
                    id: fallbackId,
                    de: rendered.de,
                    en: rendered.en,
                    esp: rendered.esp,
                    prt: rendered.prt,
                    phase: payload.phase,
                    equipment: payload.equipment
                });

                addStep(fallbackId, null, rendered[currentLang] || rendered.de || 'Neuer Schritt', {
                    skipRender: true,
                    stepData: {
                        de: rendered.de,
                        en: rendered.en,
                        esp: rendered.esp,
                        prt: rendered.prt,
                        phase: payload.phase,
                        equipment: payload.equipment
                    }
                });
                updateStepIndices();
                renderSandboxStepTab();
            }
        }

        function syncIngredientSourceVisibility() {
            const query = ($('#ingredientSearch').val() || '').toString().trim().toLowerCase();
            const selectedIds = $('#selectedIngredients input[name$="IngredientsAndNutrients.Id"]').map(function () {
                return $(this).val()?.toString();
            }).get();

            $('.ingredient-db-row').each(function () {
                const row = $(this);
                const id = row.data('ingredient-id')?.toString() || '';
                const text = ((row.data('name-' + currentLang) || row.data('name-de') || '') + '').toLowerCase();
                const isSelected = !!id && selectedIds.includes(id);
                const matchesSearch = !query || text.includes(query);
                row.toggle(!isSelected && matchesSearch);
            });
        }

        function getStepLabelFromRow(row) {
            if (!row) return '';
            return row[currentLang] || row.de || `Step ${row.id}`;
        }

        // Prüft ob ein Step bereits in der Auswahl ist
        function isStepAlreadySelected(stepId) {
            return $('#selectedSteps .step-row').filter(function () {
                return $(this).data('step-id')?.toString() === stepId.toString();
            }).length > 0;
        }

        function renderSandboxStepCandidates(stepItems, emptyText = 'Keine verknüpften Schritte gefunden.') {
            const container = $('#sandboxStepCandidates');
            container.empty();

            if (!stepItems || !stepItems.length) {
                container.append(`<div class="text-muted small">${emptyText}</div>`);
                return;
            }

            const search = (activeSandboxTab === 'unbound'
                ? ($('#sandboxUnboundSearch').val() || '')
                : ($('#stepSearch').val() || '')).toString().trim().toLowerCase();
            const activeId = activeSandboxIngredientId?.toString() || '';
            const isUnbound = activeSandboxTab === 'unbound';

            const phaseGroups = { 1: [], 2: [], 3: [], 4: [], 0: [] };
            const phaseNames = { 1: 'Vorbereitung', 2: 'Kochen', 3: 'Würzen', 4: 'Finish', 0: 'Sonstige' };

            stepItems.forEach(item => {
                const sourceRow = getAllStepRows().find(x => x && x.id?.toString() === item.stepId.toString());
                if (!sourceRow) return;

                // Equipment filter (only for unbound tab)
                if (isUnbound && activeEquipmentFilter !== 'all') {
                    const equipVal = parseInt(sourceRow.equipment ?? 0, 10);
                    if (equipVal.toString() !== activeEquipmentFilter) return;
                }

                const label = (getStepLabelFromRow(sourceRow) || '').toString();
                if (!label) return;
                if (search && !label.toLowerCase().includes(search)) return;

                const phase = parseInt(sourceRow.phase ?? 0, 10);
                if (!isUnbound && activeId && phase > 0 && isIngredientPhaseCovered(activeId, phase)) return;

                const group = phaseGroups[phase] ?? phaseGroups[0];
                group.push({ stepId: item.stepId, label, phase, matchCount: item.matchCount || 0, equipment: parseInt(sourceRow.equipment ?? 0, 10) });
            });

            let totalRendered = 0;
            [1, 2, 3, 4, 0].forEach(phase => {
                const items = phaseGroups[phase];
                if (!items.length) return;

                const phaseBadge = getPhaseLabel(phase);
                if (phaseBadge) {
                    container.append(`<div class="sandbox-phase-header mt-1 mb-1">${phaseBadge} <span class="text-muted small">${phaseNames[phase]}</span></div>`);
                } else {
                    container.append(`<div class="sandbox-phase-header mt-1 mb-1 text-muted small">Sonstige</div>`);
                }

                items.forEach(item => {
                    const selected = isStepAlreadySelected(item.stepId);
                    const equipBadge = isUnbound ? getEquipmentLabel(item.equipment) : '';
                    const hint = item.matchCount > 0
                        ? `<span class="small text-muted">Matches: ${item.matchCount}</span>`
                        : (equipBadge ? equipBadge : '<span class="small text-muted">Ungebundener Schritt</span>');

                    const card = $(`<div class="border rounded p-2 sandbox-step-card bg-white">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 text-start sandbox-step-candidate" data-id="${item.stepId}">
                            <i class="bi bi-journal-check me-1"></i>${equipBadge}${item.label}
                            ${selected ? '<span class="ms-2 badge bg-success sandbox-selected-label">Ausgewählt</span>' : ''}
                        </button>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            ${hint}
                            <button type="button" class="btn btn-success btn-sm sandbox-accept-step-btn" data-id="${item.stepId}" ${selected ? 'disabled' : ''}>Akzeptieren</button>
                        </div>
                    </div>`);

                    card.find('.sandbox-step-candidate').on('click', function () {
                        $('#sandboxCurrentStep').removeClass('text-muted').html(`<strong>Ausgewählt:</strong> ${item.label}`);
                    });

                    card.find('.sandbox-accept-step-btn').on('click', function () {
                        addStep(item.stepId.toString(), null, item.label, { enforceIngredientPhaseUniqueness: !isUnbound });
                    });

                    container.append(card);
                    totalRendered++;
                });
            });

            if (!totalRendered) {
                container.empty();
                const activeHasSteps = activeId && $('#selectedSteps .step-row').length > 0;
                const msg = activeHasSteps && !isUnbound
                    ? 'Alle Phasen für diese Zutat sind abgedeckt.'
                    : emptyText;
                container.append(`<div class="text-muted small">${msg}</div>`);
            }
        }

        function loadSandboxSteps() {
            const selectedIngredientIds = getSelectedIngredientIds();
            const allSteps = getAllStepRows();
            const activeId = activeSandboxIngredientId?.toString() || '';

            if (activeSandboxTab === 'unbound') {
                sandboxUnboundSteps = allSteps
                    .map(step => {
                        const stepId = parseInt(step.id, 10);
                        if (isNaN(stepId)) return null;
                        const boundIds = getStepBoundIngredientIds(stepId).map(x => x.toString());
                        if (boundIds.length) return null;
                        return { stepId, matchCount: 0 };
                    })
                    .filter(Boolean);

                renderSandboxStepCandidates(sandboxUnboundSteps, 'Keine ungebundenen Schritte gefunden.');
                return;
            }

            if (!allSteps.length || !activeId) {
                renderSandboxStepCandidates([], 'Wähle links eine Zutat aus.');
                return;
            }

            const candidates = [];
            allSteps.forEach(step => {
                const stepId = parseInt(step.id, 10);
                if (isNaN(stepId)) return;
                const boundIds = getStepBoundIngredientIds(stepId).map(x => x.toString());

                if (activeSandboxTab === 'all') {
                    const matchCount = selectedIngredientIds.filter(sid => boundIds.includes(sid.toString())).length;
                    if (matchCount > 0) {
                        candidates.push({ stepId, matchCount });
                    }
                } else {
                    if (boundIds.includes(activeId)) {
                        const matchCount = selectedIngredientIds.filter(sid => boundIds.includes(sid.toString())).length;
                        candidates.push({ stepId, matchCount });
                    }
                }
            });

            candidates.sort((a, b) => b.matchCount - a.matchCount);

            renderSandboxStepCandidates(
                candidates,
                'Keine passenden Schritte für diese Zutat gefunden.'
            );
        }

        function renderSandboxStepTab() {
            $('#sandboxStepTabs .sandbox-tab').removeClass('active');
            $(`#sandboxStepTabs [data-sandbox-tab="${activeSandboxTab}"]`).addClass('active');

            const showUnboundSearch = activeSandboxTab === 'unbound';
            $('#sandboxUnboundSearchWrap').toggleClass('d-none', !showUnboundSearch);

            $('#sandboxActiveIngredientLabel').text(
                activeSandboxTab === 'all'
                    ? 'Alle Zutaten'
                    : activeSandboxTab === 'unbound'
                        ? 'Ohne Binding'
                        : (activeSandboxIngredientName || 'Keine Zutat')
            );
            loadSandboxSteps();
        }

