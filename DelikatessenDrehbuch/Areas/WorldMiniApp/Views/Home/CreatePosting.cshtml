                    return options;
                }
            }
            return ['niedriger', 'mittlerer', 'hoher'];
        }

        function populateHeatSelect() {
            const sel = $('#heatValueSelect');
            if (!sel.length) return;
            const options = getHeatOptions();
            const currentVal = (sel.val() || '').toString().trim().toLowerCase();
