    /* ---------- Inputs ---------- */
    .input-pill, .select-pill {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 14px;
        border-radius: 18px;
        border: 1px solid rgba(0,0,0,0.08);
