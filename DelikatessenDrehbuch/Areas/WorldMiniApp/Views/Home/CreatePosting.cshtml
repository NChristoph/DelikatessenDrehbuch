        .preview-step-card.preview-animate {
            transform: translateY(-6px);
            opacity: .86;
        }

    .preview-step-title {
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--creator-sub);
