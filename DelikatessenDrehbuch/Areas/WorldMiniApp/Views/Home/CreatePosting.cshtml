    <div class="d-flex gap-2 align-items-center mb-2">
        <input type="text" inputmode="decimal" id="ingredientConfigQty" placeholder="1" value="1" style="flex:1;border-radius:14px;border:none;padding:10px 12px;background:#ffffff;color:#111827;font-size:14px;" />
        <select id="ingredientConfigUnit" style="flex:1;border-radius:14px;border:none;padding:10px 12px;background:#ffffff;color:#111827;font-size:14px;cursor:pointer;"></select>
