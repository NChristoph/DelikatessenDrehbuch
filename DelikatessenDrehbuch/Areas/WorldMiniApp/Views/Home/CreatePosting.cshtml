        #ingredientsDbTable thead, #stepsDbTable thead {
            display: none;
        }

        #ingredientsDbTable tbody tr, #stepsDbTable tbody tr {
            display: block;
            margin-bottom: 12px;
            background: rgba(255,255,255,0.95);
            border-radius: 18px;
            padding: 12px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.06);
        }

        #ingredientsDbTable tbody td, #stepsDbTable tbody td {
            display: block;
            border: 0;
            padding: 0;
