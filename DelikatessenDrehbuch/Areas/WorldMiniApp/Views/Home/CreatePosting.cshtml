    .placeholder-reset {
        border: 0;
        background: rgba(255,255,255,0.18);
        color: var(--creator-text);
        border-radius: 999px;
        width: 16px;
        height: 16px;
        line-height: 16px;
        font-size: .62rem;
        padding: 0;
        cursor: pointer;
    }

    .preview-step-card.token-replace-active {
        box-shadow: 0 0 0 2px rgba(255,224,138,.4), 0 14px 30px rgba(0,0,0,0.2);
    }

    .duration-editor {
        border-top: 1px solid rgba(255,255,255,.2);
        padding-top: 10px;
    }

    .phase-badge {
        font-size: .68rem;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 6px;
        margin-right: 5px;
        display: inline-block;
        line-height: 1.3;
    }

    .phase-badge-1 {
        background: rgba(34,197,94,.18);
        color: #166534;
    }

    .phase-badge-2 {
        background: rgba(239,68,68,.18);
        color: #991b1b;
    }

    .phase-badge-3 {
        background: rgba(245,158,11,.2);
        color: #92400e;
    }

    .phase-badge-4 {
        background: rgba(99,102,241,.18);
        color: #3730a3;
    }

    .creator-bottom-sheet {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: auto;
        background: var(--creator-sheet);
        border-top: 1px solid var(--creator-border);
        backdrop-filter: blur(16px);
        border-radius: 24px 24px 0 0;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        z-index: 10;
        transition: padding .22s ease;
    }

    #creatorBottomSheet {
        display: none !important;
    }

    .bottom-sheet-editor {
        border-bottom: 1px solid var(--creator-border);
        padding-bottom: 10px;
        margin-bottom: 4px;
    }

        .bottom-sheet-editor .btn-primary {
            white-space: nowrap;
        }

        .bottom-sheet-editor .inline-article-opt,
        .bottom-sheet-editor .inline-equipment-opt,
        .bottom-sheet-editor .inline-tool-opt,
        .bottom-sheet-editor .inline-base-opt,
        .bottom-sheet-editor .inline-item-opt,
        .bottom-sheet-editor .inline-balance-opt,
        .bottom-sheet-editor .inline-seasonings-opt {
            white-space: nowrap;
        }

            .bottom-sheet-editor .inline-article-opt.btn-outline-light,
            .bottom-sheet-editor .inline-equipment-opt.btn-outline-light,
            .bottom-sheet-editor .inline-tool-opt.btn-outline-light,
            .bottom-sheet-editor .inline-base-opt.btn-outline-light,
            .bottom-sheet-editor .inline-item-opt.btn-outline-light,
            .bottom-sheet-editor .inline-balance-opt.btn-outline-light,
            .bottom-sheet-editor .inline-seasonings-opt.btn-outline-light {
                background: transparent;
                color: var(--creator-text);
                border-color: rgba(255,255,255,0.45);
            }

            .bottom-sheet-editor .inline-article-opt.btn-light,
            .bottom-sheet-editor .inline-equipment-opt.btn-light,
            .bottom-sheet-editor .inline-tool-opt.btn-light,
            .bottom-sheet-editor .inline-base-opt.btn-light,
            .bottom-sheet-editor .inline-item-opt.btn-light,
            .bottom-sheet-editor .inline-balance-opt.btn-light,
            .bottom-sheet-editor .inline-seasonings-opt.btn-light {
                background: #fff;
                border-color: #fff;
                color: #10131f;
            }

    .sheet-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
    }

    .sheet-title {
        font-weight: 800;
    }

    .sheet-sub {
        font-size: .77rem;
        color: var(--creator-sub);
    }

    .advanced-gear {
        border-radius: 999px;
        width: 34px;
        height: 34px;
        padding: 0;
    }

    .ingredient-swiper {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        overflow: visible;
        padding: 4px 6px 6px;
        scrollbar-width: none;
    }

        .ingredient-swiper::-webkit-scrollbar {
            display: none;
        }

    .ingredient-chip {
        border: 1px solid var(--creator-border);
        background: rgba(255,255,255,0.08);
        color: var(--creator-text);
        border-radius: 14px;
        padding: 8px 12px;
        font-size: .82rem;
        white-space: nowrap;
        flex: 0 0 auto;
        margin: 1px 0;
        transition: all .2s ease;
    }

        .ingredient-chip.active {
            transform: scale(1.06);
            border-color: rgba(141,99,255,.8);
            box-shadow: 0 0 0 3px rgba(141,99,255,.28);
            background: rgba(141,99,255,.25);
        }

    .template-library {
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-right: 2px;
        min-height: 0;
        flex: 1;
    }


    .template-library-fixed {
        height: 50vh;
        max-height: 50vh;
        overflow-y: auto;
    }

    .template-card {
        border: 1px solid var(--creator-border);
        border-radius: 14px;
        background: rgba(255,255,255,0.08);
        color: var(--creator-text);
        text-align: left;
        padding: 10px;
        transition: transform .18s ease, border-color .18s ease, background .18s ease;
    }

        .template-card.active {
            border-color: rgba(141,99,255,.8);
            background: rgba(141,99,255,.2);
        }

        .template-card.template-tap {
            transform: scale(.98);
        }

    .template-title {
        font-weight: 700;
        font-size: .86rem;
    }

    .template-snippet {
        font-size: .76rem;
        color: var(--creator-sub);
        white-space: normal;
        overflow: visible;
        text-overflow: unset;
        line-height: 1.35;
    }

    .action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-top: auto;
    }

    .story-meta {
        font-size: .76rem;
        color: var(--creator-sub);
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .creator-cta-primary {
        border: 0;
        border-radius: 999px;
        background: linear-gradient(135deg, #8d63ff 0%, #5f85ff 100%);
        color: #fff;
        font-weight: 700;
        font-size: .82rem;
        padding: 8px 12px;
    }


    .creator-toast {
        position: absolute;
        left: 50%;
        transform: translateX(-50%) translateY(10px);
        bottom: 44%;
        opacity: 0;
        pointer-events: none;
        transition: all .25s ease;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(16,20,35,.86);
        border: 1px solid rgba(255,255,255,0.2);
        font-size: .78rem;
    }

        .creator-toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

    .template-fly-ghost {
        position: absolute;
        z-index: 6;
        opacity: 0;
        pointer-events: none;
        font-size: .74rem;
        background: rgba(141,99,255,.85);
        border-radius: 999px;
        padding: 6px 10px;
        color: #fff;
    }

        .template-fly-ghost.fly {
            animation: flyToPreview .5s ease forwards;
        }

    @@keyframes flyToPreview {
        0% {
            opacity: 0;
            transform: translate(0,0) scale(.85);
        }

        30% {
            opacity: 1;
        }

        100% {
            opacity: 0;
            transform: translate(0,-120px) scale(1.04);
        }
    }

    /* === Ingredient Edit Inline Popup === */
    #ingredientConfigOverlay {
        position: fixed;
        inset: 0;
        background: transparent;
        z-index: 500;
        display: none;
    }

        #ingredientConfigOverlay.ing-active {
            display: block;
        }

    #ingredientConfigDock {
        display: none;
        background: rgba(15,23,42,0.98);
        border: 1px solid rgba(255,255,255,0.22);
        border-radius: 16px;
        padding: 12px 14px;
        margin-top: 6px;
        position: relative;
        z-index: 501;
    }

        #ingredientConfigDock.ing-active {
            display: block;
            animation: ingDockSlideIn 0.18s ease;
        }

    @@keyframes ingDockSlideIn {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* === Probability Variable Editor Bottom Sheet === */
    #probVarEditorOverlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.6);
        z-index: 1052;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
    }

        #probVarEditorOverlay.ing-active {
            opacity: 1;
            pointer-events: auto;
        }

    #probVarEditorDock {
        position: fixed;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%) translateY(100%);
        width: min(480px, 100%);
        z-index: 1053;
        background: #1a1a2e;
        border-radius: 20px 20px 0 0;
        padding: 20px 20px calc(20px + env(safe-area-inset-bottom, 0px)) 20px;
        border-top: 1px solid rgba(255,255,255,0.15);
        border-left: 1px solid rgba(255,255,255,0.08);
        border-right: 1px solid rgba(255,255,255,0.08);
        transition: transform 0.3s cubic-bezier(0.32,0.72,0,1);
        pointer-events: none;
    }

        #probVarEditorDock.ing-active {
            transform: translateX(-50%) translateY(0);
            pointer-events: auto;
        }

        #probVarEditorDock.prob-inline-mode {
            position: relative;
            bottom: auto;
            left: auto;
            transform: none;
            width: 100%;
            z-index: 2;
            border-radius: 14px;
            margin-top: 12px;
            padding: 14px;
            background: rgba(39,42,61,0.98);
            border: 1px solid rgba(255,255,255,0.16);
            box-shadow: 0 14px 30px rgba(0,0,0,0.3);
            pointer-events: auto;
        }

            #probVarEditorDock.prob-inline-mode .ing-sheet-handle {
                display: none;
            }

        #probVarEditorDock .ing-sheet-handle {
            width: 40px;
            height: 4px;
            background: rgba(255,255,255,0.25);
            border-radius: 999px;
            margin: 0 auto 16px;
        }

    .prob-var-chip {
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.55);
        background: rgba(255,255,255,0.08);
        color: #ffffff;
        font-weight: 700;
        padding: 6px 14px;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
    }

        .prob-var-chip:hover, .prob-var-chip.active {
            background: rgba(255,255,255,0.2);
            border-color: rgba(255,255,255,0.85);
            color: #ffffff;
        }

</style>

<!-- ===== Ingredient Edit Bottom Sheet ===== -->
<div id="ingredientConfigOverlay" aria-hidden="true"></div>
<div id="ingredientConfigDockParking" style="display:none;"></div>
<div id="ingredientConfigDock" role="dialog" aria-labelledby="ingredientConfigTitle">
    <div class="d-flex align-items-center gap-2 mb-2">
        <div class="fw-bold text-white small" id="ingredientConfigTitle" style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"></div>
        <button type="button" id="btnCloseIngredientConfig" class="btn btn-sm p-0 text-white-50" style="flex-shrink:0;" aria-label="Schließen">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    <div class="d-flex gap-2 align-items-center mb-2">
        <input type="text" inputmode="decimal" id="ingredientConfigQty"
               pattern="[0-9]*[.,]?[0-9]*"
               class="form-control form-control-sm candy-purple-input" style="max-width:80px;" placeholder="0" />
        <select id="ingredientConfigUnit" class="form-select form-select-sm candy-purple-input" style="flex:1;"></select>
        <button type="button" id="btnApplyIngredientConfig" class="btn btn-sm creator-cta-primary px-3" aria-label="Übernehmen">
            <i class="bi bi-check-lg"></i>
        </button>
    </div>
    <div class="common-unit-chips">
        <button type="button" class="btn btn-sm common-unit-chip js-config-unit-chip" data-unit-key="g">g.</button>
        <button type="button" class="btn btn-sm common-unit-chip js-config-unit-chip" data-unit-key="ml">ml.</button>
        <button type="button" class="btn btn-sm common-unit-chip js-config-unit-chip" data-unit-key="piece">Stk.</button>
    </div>
</div>

<!-- ===== Probability Variable Editor Bottom Sheet ===== -->
<div id="probVarEditorOverlay" aria-hidden="true"></div>
<div id="probVarEditorDockParking" style="display:none;"></div>
<div id="probVarEditorDock" role="dialog" aria-modal="true" aria-labelledby="probVarEditorTitle">
    <div class="ing-sheet-handle"></div>
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="fw-bold text-white" id="probVarEditorTitle">Variable auswählen</div>
        <button type="button" id="btnCloseProbVarEditor" class="btn btn-sm p-0 text-white-50" style="font-size:1.1rem;" aria-label="Schließen">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <!-- Ingredient chips -->
    <div id="probVarIngredientArea" class="d-none">
        <div class="small text-white-50 mb-2">Zutaten einsetzen:</div>
        <div id="probVarIngredientChips" class="d-flex flex-wrap gap-2"></div>
    </div>

    <!-- Duration -->
    <div id="probVarDurationArea" class="d-none">
        <div class="d-flex gap-2 align-items-center">
            <input type="number" id="probVarDurationVal" class="form-control form-control-sm candy-purple-input" style="max-width:90px" value="5" min="1" />
            <select id="probVarDurationUnit" class="form-select form-select-sm candy-purple-input" style="flex:1">
                <option value="minute">Minuten</option>
                <option value="hour">Stunden</option>
            </select>
        </div>
    </div>

    <!-- Count -->
    <div id="probVarCountArea" class="d-none">
        <input type="number" id="probVarCountVal" class="form-control form-control-sm candy-purple-input" style="max-width:120px" value="1" min="1" />
    </div>

    <!-- Temperature -->
    <div id="probVarTempArea" class="d-none">
        <div class="d-flex gap-2 align-items-center">
            <input type="number" id="probVarTempVal" class="form-control form-control-sm candy-purple-input" style="max-width:90px" value="180" min="0" max="500" step="5" />
            <select id="probVarTempUnit" class="form-select form-select-sm candy-purple-input" style="max-width:80px">
                <option value="celsius">°C</option>
                <option value="fahrenheit">°F</option>
            </select>
        </div>
    </div>

    <!-- Option chips (heat, mode, tool, etc.) -->
    <div id="probVarOptionsArea" class="d-none">
        <div id="probVarOptionChips" class="d-flex flex-wrap gap-2"></div>
    </div>

    <!-- Text fallback -->
    <div id="probVarTextArea" class="d-none">
        <input type="text" id="probVarTextVal" class="form-control form-control-sm candy-purple-input" placeholder="Wert eingeben..." />
    </div>

    <!-- Buttons (only needed for non-chip areas) -->
    <div class="d-flex gap-2 mt-3" id="probVarApplyRow">
        <button type="button" id="btnApplyProbVar" class="btn btn-sm creator-cta-primary flex-grow-1">
            <i class="bi bi-check-lg me-1"></i>Übernehmen
        </button>
        <button type="button" id="btnCancelProbVar" class="btn btn-sm btn-outline-secondary">Abbrechen</button>
    </div>
</div>



@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="~/js/CreatePostingSmartStepCreator.js"></script>
    <script>
        window.CreatePostingPageConfig = {
            upsertStepUrl: "@Url.Action("UpsertStep", "Home", new { area = "WorldMiniApp" })"
        };
    </script>
    <script src="~/js/CreatePostingPage.js"></script>
}

