
@{
    ViewData["Title"] = "Feed";
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Delikatessen Feed</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        /* === DAS DESIGN (TikTok Style) === */
        body, html {
            margin: 0;
            padding: 0;
            background-color: #000;
            height: 100%;
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        .feed-container {
            height: 100vh;
            width: 100vw;
            overflow-y: scroll;
            scroll-snap-type: y mandatory;
            scroll-behavior: smooth;
        }

        .feed-item {
            position: relative;
            height: 100vh;
            width: 100vw;
            scroll-snap-align: start;
            background-color: #1a1a1a;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .feed-media {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
        }

        .overlay-gradient {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 50%;
            background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
            z-index: 2;
            pointer-events: none;
        }

        .info-container {
            position: absolute;
            bottom: 80px;
            left: 20px;
            right: 80px;
            z-index: 3;
            color: white;
            text-align: left;
        }

        .chef-badge {
            display: inline-flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(5px);
            padding: 5px 10px;
            border-radius: 20px;
            margin-bottom: 10px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .recipe-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 5px;
            line-height: 1.2;
            text-shadow: 0 2px 4px rgba(0,0,0,0.5);
        }

        .recipe-meta {
            font-size: 0.85rem;
            opacity: 0.9;
            margin-bottom: 10px;
        }

        .difficulty-dot {
            height: 10px;
            width: 10px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 5px;
        }

        .action-bar {
            position: absolute;
            bottom: 100px;
            right: 10px;
            z-index: 3;
            display: flex;
            flex-direction: column;
            gap: 25px;
            align-items: center;
        }

        .action-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: white;
            text-decoration: none;
            cursor: pointer;
        }

        .icon-circle {
            width: 50px;
            height: 50px;
            background: rgba(0, 0, 0, 0.4);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 5px;
            border: 1px solid rgba(255,255,255,0.1);
        }

        /* Bottom Nav */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            width: 100%;
            height: 60px;
            background: black;
            border-top: 1px solid #333;
            z-index: 10;
            display: flex;
            justify-content: space-around;
            align-items: center;
        }

        .nav-item {
            color: #888;
            font-size: 1.5rem;
        }

            .nav-item.active {
                color: white;
            }

        .add-btn {
            background: linear-gradient(45deg, #ff0050, #00f2ea);
            width: 45px;
            height: 30px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
        }
    </style>
</head>
<body>

    <div class="feed-container" id="feedContainer">

        <div class="feed-item">
            <video class="feed-media" playsinline loop muted>
                <source src="https://www.pexels.com/de-de/download/video/34629981/" type="video/mp4">
            </video>
            <div class="overlay-gradient"></div>
            <div class="info-container">
                <div class="chef-badge">🤖 System Test</div>
                <h2 class="recipe-title">Willkommen im Feed! 🎥</h2>
                <div class="recipe-meta">
                    <span class="difficulty-dot" style="background: white;"></span> Info • ⏱️ 0:30
                </div>
                <p>Das hier ist ein statisches Test-Video, um zu sehen, ob der Player funktioniert.</p>
            </div>
            <div class="action-bar">
                <div class="action-btn"><div class="icon-circle"><i class="bi bi-heart-fill"></i></div><span>100</span></div>
            </div>
        </div>

        <div class="feed-item">
            <video class="feed-media" playsinline loop muted poster="https://images.pexels.com/photos/1256875/pexels-photo-1256875.jpeg">
                <source src="https://videos.pexels.com/video-files/3196238/3196238-uhd_2560_1440_25fps.mp4" type="video/mp4">
            </video>
            <div class="overlay-gradient"></div>
            <div class="info-container">
                <div class="chef-badge"><img src="https://ui-avatars.com/api/?name=Chef+Mario&background=random" style="width:20px;height:20px;border-radius:50%;margin-right:5px;"> ChefMario</div>
                <h2 class="recipe-title">Echte Carbonara 🍝</h2>
                <div class="recipe-meta"><span class="difficulty-dot" style="background: orange;"></span> Mittel • ⏱️ 20 Min</div>
                <p>Keine Sahne! Nur Eigelb, Pecorino und Guanciale. 🇮🇹</p>
            </div>
            <div class="action-bar">
                <div class="action-btn" onclick="toggleLike(this)"><div class="icon-circle"><i class="bi bi-heart-fill"></i></div><span>12k</span></div>
                <div class="action-btn"><div class="icon-circle"><i class="bi bi-journal-text"></i></div><span>Rezept</span></div>
                <div class="action-btn"><div class="icon-circle"><i class="bi bi-share-fill"></i></div><span>Teilen</span></div>
            </div>
        </div>

        <div class="feed-item">
            <video class="feed-media" playsinline loop muted poster="https://images.pexels.com/photos/1639557/pexels-photo-1639557.jpeg">
                <source src="https://videos.pexels.com/video-files/2928073/2928073-uhd_2560_1440_24fps.mp4" type="video/mp4">
            </video>
            <div class="overlay-gradient"></div>
            <div class="info-container">
                <div class="chef-badge">AnnaKocht</div>
                <h2 class="recipe-title">Smash Burger 🍔</h2>
                <div class="recipe-meta"><span class="difficulty-dot" style="background: green;"></span> Einfach • ⏱️ 15 Min</div>
                <p>Knusprige Ränder, saftiges Fleisch. 🔥</p>
            </div>
            <div class="action-bar">
                <div class="action-btn"><div class="icon-circle"><i class="bi bi-heart-fill"></i></div><span>3k</span></div>
            </div>
        </div>

        <div class="feed-item">
            <img src="https://images.pexels.com/photos/1211887/pexels-photo-1211887.jpeg" class="feed-media" />
            <div class="overlay-gradient"></div>
            <div class="info-container">
                <div class="chef-badge">VeganVibes</div>
                <h2 class="recipe-title">Sommer Salat 🥗</h2>
                <div class="recipe-meta"><span class="difficulty-dot" style="background: green;"></span> Einfach • ⏱️ 10 Min</div>
                <p>Perfekt für heiße Tage.</p>
            </div>
            <div class="action-bar">
                <div class="action-btn"><div class="icon-circle"><i class="bi bi-heart-fill"></i></div><span>850</span></div>
            </div>
        </div>

        <div id="feedContent">
          @*   <partial name="_RecipeFeedItems" model="Model" /> *@
        </div>

        <div id="loadingSpinner" style="text-align:center; padding:20px; display:none;">
            <div class="spinner-border text-light" role="status"></div>
        </div>

    </div>

    <div class="bottom-nav">
        <div class="nav-item active"><i class="bi bi-house-door-fill"></i></div>
        <div class="nav-item"><i class="bi bi-search"></i></div>
        <div class="add-btn"><i class="bi bi-plus"></i></div>
        <div class="nav-item"><i class="bi bi-chat-dots"></i></div>
        <div class="nav-item"><i class="bi bi-person"></i></div>
    </div>

    <script>
        // === LIKE FUNKTION ===
        function toggleLike(btn) {
            const icon = btn.querySelector('i');
            if (icon.style.color === 'red') icon.style.color = 'white';
            else icon.style.color = 'red';
        }

        // === AUTOPLAY & INFINITE SCROLL ===
        let skip = 15;
        let isLoading = false;
        let allLoaded = false;

        const container = document.getElementById('feedContainer');
        const contentDiv = document.getElementById('feedContent');
        const loadingSpinner = document.getElementById('loadingSpinner');

        // Observer für Videos
        const videoObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                const video = entry.target;
                if (entry.isIntersecting) {
                    video.play().catch(e => {});
                } else {
                    video.pause();
                }
            });
        }, { threshold: 0.6 });

        function observeNewVideos() {
            document.querySelectorAll('video').forEach(v => videoObserver.observe(v));
        }

        // Starten
        observeNewVideos();

        // Infinite Scroll
        container.addEventListener('scroll', () => {
            if (isLoading || allLoaded) return;
            const remainingHeight = container.scrollHeight - container.scrollTop;
            // Wenn wir nur noch 3 Bildschirmlängen Platz haben -> Laden
            if (remainingHeight < window.innerHeight * 3) {
                loadNextBatch();
            }
        });

        async function loadNextBatch() {
            isLoading = true;
            loadingSpinner.style.display = 'block';

            try {
                const response = await fetch(`/Home/LoadMoreRecipes?skip=${skip}`);
                if (response.ok) {
                    const html = await response.text();
                    if (html.trim().length === 0) {
                        allLoaded = true;
                    } else {
                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = html;
                        while (tempDiv.firstChild) {
                             const child = tempDiv.firstChild;
                             contentDiv.appendChild(child);
                             if(child.querySelector && child.querySelector('video')) {
                                 videoObserver.observe(child.querySelector('video'));
                             }
                        }
                        skip += 15;
                    }
                }
            } catch (err) { console.error(err); }

            isLoading = false;
            loadingSpinner.style.display = 'none';
        }
    </script>
</body>
</html>