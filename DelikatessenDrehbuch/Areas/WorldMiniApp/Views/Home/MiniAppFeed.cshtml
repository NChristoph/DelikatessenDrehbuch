@model List<RecipeBaseDataImage>
@{
    ViewData["Title"] = "Feed";
    Layout = null;

    //TODO: Front door link on the fly (link in js oder im controler durch front dor ersetzen )
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Delikatessen Feed</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        /* === FEED BASIS (Muss dunkel sein für Videos) === */
        body, html {
            margin: 0;
            padding: 0;
            background-color: #000; /* Kino-Modus für Videos */
            height: 100%;
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        .feed-container {
            height: 100vh;
            width: 100vw;
            overflow-y: scroll;
            scroll-snap-type: y mandatory;
            scroll-behavior: smooth;
            overscroll-behavior-y: contain; /* Verhindert Bouncen */
        }

        .feed-item {
            position: relative;
            height: 100vh;
            width: 100vw;
            scroll-snap-align: start;
            scroll-snap-stop: always; /* Zwingt zum Anhalten bei jedem Video */
            background-color: #1a1a1a;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .feed-media {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
        }

        /* Weicher Verlauf unten, damit Text lesbar ist */
        .overlay-gradient {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 60%;
            background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 50%, transparent 100%);
            z-index: 2;
            pointer-events: none;
        }

        /* === INFO BOX (Angepasst an Start-Screen Typography) === */
        .info-container {
            position: absolute;
            bottom: 100px;
            left: 20px;
            right: 80px;
            z-index: 3;
            color: white;
            text-align: left;
        }

        .chef-badge {
            display: inline-flex;
            align-items: center;
            /* Glassmorphismus passend zu deinem Start-Screen Style */
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.3);
            padding: 6px 14px;
            border-radius: 20px;
            margin-bottom: 12px;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        .recipe-title {
            font-size: 1.8rem;
            font-weight: 800;
            margin-bottom: 6px;
            line-height: 1.1;
            text-shadow: 0 2px 10px rgba(0,0,0,0.5);
            color: #fff;
            letter-spacing: -0.5px; /* Wie "Delikatessen Drehbuch" Titel */
        }

        .recipe-meta {
            font-size: 0.95rem;
            opacity: 0.95;
            margin-bottom: 10px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* === ACTION BUTTONS RECHTS (Candy Style) === */
        .action-bar {
            position: absolute;
            bottom: 120px;
            right: 15px;
            z-index: 3;
            display: flex;
            flex-direction: column;
            gap: 20px;
            align-items: center;
        }

        .action-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: white;
            text-decoration: none;
            cursor: pointer;
            transition: transform 0.2s;
        }

            .action-btn:active {
                transform: scale(0.9);
            }

        .icon-circle {
            width: 52px;
            height: 52px;
            /* Helles Milchglas wie deine Cards */
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            margin-bottom: 4px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        /* LIKED STATE: Dein Orange-Pink Gradient! */
        .action-btn.liked .icon-circle {
            background: linear-gradient(135deg, #FF9966 0%, #FF5E62 100%);
            border: none;
            box-shadow: 0 4px 20px rgba(255, 94, 98, 0.5);
        }

        .action-label {
            font-size: 0.75rem;
            font-weight: 700;
            text-shadow: 0 1px 3px rgba(0,0,0,0.8);
        }

        /* === BOTTOM NAV (Candy Style: Weiß & Rund) === */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            width: 100%;
            height: 80px; /* Etwas höher für den Style */
            /* Helles Weiß mit leichtem Milchglas - passend zum Hintergrund von Start */
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(20px);
            /* Rundungen oben wie bei deinen Modals/Cards */
            border-top-left-radius: 30px;
            border-top-right-radius: 30px;
            /* Feiner Rand oben */
            border-top: 1px solid rgba(255,255,255,0.8);
            z-index: 10;
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding-bottom: 15px; /* Platz für Home-Bar */
            box-shadow: 0 -10px 40px rgba(0,0,0,0.15);
        }

        .nav-item {
            color: #bdc3c7; /* Dezentes Grau */
            font-size: 1.8rem; /* Größere Icons */
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 50px;
            height: 50px;
        }

            /* AKTIVES ICON: Nutzt deinen Gradient als Farbe */
            .nav-item.active i {
                background: linear-gradient(135deg, #FF9966 0%, #FF5E62 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                filter: drop-shadow(0 2px 5px rgba(255, 94, 98, 0.3));
            }

        /* === FLOATING UPLOAD BUTTON (Dein Signature Button) === */
        .add-btn-wrapper {
            position: relative;
            top: -25px; /* Schwebt oben raus */
        }

        .add-btn {
            /* EXAKT DEIN GRADIENT VOM START-SCREEN (Wochenplan Button) */
            background: linear-gradient(135deg, #FF9966 0%, #FF5E62 100%);
            width: 65px;
            height: 65px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2.2rem;
            /* Glow Effekt */
            box-shadow: 0 8px 25px rgba(255, 94, 98, 0.5);
            border: 5px solid white; /* Weißer Rand zur Trennung wie bei Instagram/TikTok */
            transition: transform 0.2s;
        }

            .add-btn:active {
                transform: scale(0.95);
            }

    </style>
</head>
<body>

    <div class="feed-container" id="feedContainer">

        <div class="feed-item">
            <video class="feed-media" playsinline loop muted>
                <source src="https://www.pexels.com/de-de/download/video/4551939/" type="video/mp4">
            </video>
            <div class="overlay-gradient"></div>

            <div class="info-container">
                <div class="chef-badge">
                    🥑 Delikatessen
                </div>
                <h2 class="recipe-title">Willkommen im Feed 👋</h2>
                <div class="recipe-meta">
                    <span style="color: #FF9966;">●</span> Info • ⏱️ 0:30
                </div>
                <p style="opacity: 0.9; font-size: 0.95rem; line-height: 1.4;">
                    Hier erscheinen bald die besten Rezepte der Community. Swipe weiter! 👇
                </p>
            </div>

            <div class="action-bar">
                <div class="action-btn liked">
                    <div class="icon-circle"><i class="bi bi-heart-fill"></i></div>
                    <span class="action-label">124</span>
                </div>
                <div class="action-btn">
                    <div class="icon-circle"><i class="bi bi-person-plus"></i></div>
                    <span class="action-label">12</span>
                </div>
                <div class="action-btn">
                    <div class="icon-circle"><i class="bi bi-share-fill"></i></div>
                    <span class="action-label">Teilen</span>
                </div>
            </div>
        </div>

        @foreach(var item in Model)
        {
            <div class="feed-item">
                <video class="feed-media" playsinline loop muted poster="@item.Image">
                    <source src="@item.Image" type="video/mp4">
                </video>
                <div class="overlay-gradient"></div>

                <div class="info-container">
                    <div class="chef-badge">
                        🥑 Delikatessen
                    </div>
                    <h2 class="recipe-title">@item.Recipe.Title</h2>
                    <div class="recipe-meta">
                        <span style="color: #FF9966;">●</span> Info • ⏱️ @item.Recipe.PreperationTime Min
                    </div>
                    <p style="opacity: 0.9; font-size: 0.95rem; line-height: 1.4;">
                        Hier erscheinen bald die besten Rezepte der Community. Swipe weiter! 👇
                    </p>
                </div>

                <div class="action-bar">
                    <div class="action-btn liked">
                        <div class="icon-circle"><i class="bi bi-heart-fill"></i></div>
                        <span class="action-label">124</span>
                    </div>
                    <div class="action-btn">
                        <div class="icon-circle"><i class="bi bi-person-plus"></i></div>
                        <span class="action-label">12</span>
                    </div>
                    <div class="action-btn">
                        <a href="@Url.Action("ShowRecipe", "Home", new { area = "WorldMiniApp", id=item.Recipe.Id })" class="add-btn text-decoration-none">
                            <div class="icon-circle"><i class="bi bi-journal-text"></i></div>
                            <span class="action-label">Rezept</span>
                        </a>
                    </div>
                </div>
            </div>
        }

        

        <div class="feed-item">
            <video class="feed-media" playsinline loop muted poster="https://images.pexels.com/photos/1256875/pexels-photo-1256875.jpeg">
                <source src="https://videos.pexels.com/video-files/3196238/3196238-uhd_2560_1440_25fps.mp4" type="video/mp4">
            </video>
            <div class="overlay-gradient"></div>

            <div class="info-container">
                <div class="chef-badge">
                    <img src="https://ui-avatars.com/api/?name=Chef+Mario&background=random" style="width:18px;height:18px;border-radius:50%;margin-right:6px;">
                    ChefMario
                </div>
                <h2 class="recipe-title">Echte Carbonara 🍝</h2>
                <div class="recipe-meta">
                    <span class="difficulty-dot" style="background: orange; box-shadow: 0 0 5px orange;"></span> Mittel • ⏱️ 20 Min
                </div>
                <p style="opacity: 0.95; font-size: 0.95rem; line-height: 1.4; text-shadow: 0 1px 2px black;">
                    Keine Sahne! Nur Eigelb, Pecorino und Guanciale. So schmeckt Italien! 🇮🇹
                </p>
            </div>

            <div class="action-bar">
                <div class="action-btn liked" onclick="toggleLike(this)">
                    <div class="icon-circle"><i class="bi bi-heart-fill"></i></div>
                    <span class="action-label">12k</span>
                </div>
                <div class="action-btn">
                    <div class="icon-circle"><i class="bi bi-person-plus"></i></div>
                    <span class="action-label">420</span>
                </div>
                <div class="action-btn">
                    <div class="icon-circle"><i class="bi bi-journal-text"></i></div>
                    <span class="action-label">Rezept</span>
                </div>
            </div>
        </div>

        <div class="feed-item">
            <video class="feed-media" playsinline loop muted poster="https://images.pexels.com/photos/1639557/pexels-photo-1639557.jpeg">
                <source src="https://videos.pexels.com/video-files/2928073/2928073-uhd_2560_1440_24fps.mp4" type="video/mp4">
            </video>
            <div class="overlay-gradient"></div>

            <div class="info-container">
                <div class="chef-badge">
                    <img src="https://ui-avatars.com/api/?name=Anna+Kocht&background=random" style="width:18px;height:18px;border-radius:50%;margin-right:6px;">
                    AnnaKocht
                </div>
                <h2 class="recipe-title">Smash Burger 🍔</h2>
                <div class="recipe-meta">
                    <span class="difficulty-dot" style="background: #4caf50; box-shadow: 0 0 5px #4caf50;"></span> Einfach • ⏱️ 15 Min
                </div>
                <p style="opacity: 0.95; font-size: 0.95rem; line-height: 1.4; text-shadow: 0 1px 2px black;">
                    Knusprige Ränder, saftiges Fleisch. Das Geheimnis ist die Hitze! 🔥
                </p>
            </div>

            <div class="action-bar">
                <div class="action-btn liked" onclick="toggleLike(this)">
                    <div class="icon-circle"><i class="bi bi-heart-fill"></i></div>
                    <span class="action-label">12k</span>
                </div>
                <div class="action-btn">
                    <div class="icon-circle"><i class="bi bi-person-plus"></i></div>
                    <span class="action-label">420</span>
                </div>
                <div class="action-btn">
                    <div class="icon-circle"><i class="bi bi-journal-text"></i></div>
                    <span class="action-label">Rezept</span>
                </div>
            </div>
        </div>

        <div class="feed-item">
            <img src="https://images.pexels.com/photos/1211887/pexels-photo-1211887.jpeg" class="feed-media" />
            <div class="overlay-gradient"></div>

            <div class="info-container">
                <div class="chef-badge">VeganVibes</div>
                <h2 class="recipe-title">Sommer Salat Bowl 🥗</h2>
                <div class="recipe-meta">
                    <span class="difficulty-dot" style="background: #4caf50;"></span> Einfach • ⏱️ 10 Min
                </div>
                <p style="opacity: 0.95;">
                    Perfekt für heiße Tage. Erfrischend und gesund.
                </p>
            </div>

            <div class="action-bar">
                <div class="action-btn liked" onclick="toggleLike(this)">
                    <div class="icon-circle"><i class="bi bi-heart-fill"></i></div>
                    <span class="action-label">12k</span>
                </div>
                <div class="action-btn">
                    <div class="icon-circle"><i class="bi bi-person-plus"></i></div>
                    <span class="action-label">420</span>
                </div>
                <div class="action-btn">
                    <div class="icon-circle"><i class="bi bi-journal-text"></i></div>
                    <span class="action-label">Rezept</span>
                </div>
            </div>
        </div>

        <div id="feedContent"></div>
        <div id="loadingSpinner" style="display:none; text-align:center; padding:20px;">
            <div class="spinner-border text-light" role="status"></div>
        </div>

    </div>

    <div class="bottom-nav">
        <a href="@Url.Action("Index", "Home", new { area = "WorldMiniApp" })" class="nav-item text-decoration-none">
            <i class="bi bi-house-door-fill"></i>
        </a>

        <div class="nav-item active">
            <i class="bi bi-compass-fill"></i>
        </div>

        <div class="add-btn-wrapper">
            <a href="@Url.Action("Upload", "Home", new { area = "WorldMiniApp" })" class="add-btn text-decoration-none">
                <i class="bi bi-plus"></i>
            </a>
        </div>

        <div class="nav-item">
            <i class="bi bi-chat-dots-fill"></i>
        </div>

        <div class="nav-item">
            <i class="bi bi-person-fill"></i>
        </div>
    </div>

    <script>
        // === SCRIPT LOGIK ===
        // 1. Video Autoplay Observer
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if(entry.isIntersecting) entry.target.play().catch(e=>{});
                else entry.target.pause();
            });
        }, { threshold: 0.6 });

        document.querySelectorAll('video').forEach(v => observer.observe(v));

        // 2. Like Funktion (Optik)
        document.querySelectorAll('.action-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                // Nur beim Herz-Icon toggeln
                if(this.querySelector('.bi-heart-fill')) {
                    this.classList.toggle('liked');
                }
            });
        });

        // 3. Infinite Scroll (Platzhalter)
        // ... hier kommt später deine LoadMore Logik rein ...
    </script>
</body>
</html>