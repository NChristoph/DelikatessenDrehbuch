@using Microsoft.Extensions.Localization
@inject IStringLocalizer<DelikatessenDrehbuch.SharedResources> SharedLocalizer
@{
    Layout = "_MiniAppLayout";
    ViewData["Title"] = SharedLocalizer["ShareShoppingList.Title"].Value;
    var list = ViewData["List"] as string ?? string.Empty;
}

<div class="px-4 pt-4 pb-2">
    <a href="@Url.Action("Index", "Home", new { area = "WorldMiniApp" })" class="text-decoration-none text-muted mb-3 d-inline-block opacity-75">
        <i class="bi bi-arrow-left"></i> @SharedLocalizer["Common.Back"]
    </a>
    <h2 class="fw-bold mb-1" style="color: #2c3e50;">@SharedLocalizer["ShareShoppingList.Heading"] 🛒</h2>
    <p class="text-muted small">@SharedLocalizer["ShareShoppingList.Editable"]</p>
</div>

<div class="container px-4 pb-5">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <textarea class="form-control bg-light" rows="14">@list</textarea>
        </div>
    </div>
</div>

<style>
    body {
        background: linear-gradient(140deg, #fff8e1 0%, #fff 50%, #f3e5f5 100%);
        min-height: 100vh;
    }
</style>
