@* Smart Step Creator — shared between CreatePosting and EditRecipe *@
<style>
    /* ===== Base smart-step-creator ===== */
    .smart-step-creator {
        --creator-sheet: rgba(22, 32, 68, 0.62);
        --creator-border: rgba(170, 190, 255, 0.20);
        --creator-text: #f8f9ff;
        --creator-sub: rgba(220, 228, 255, 0.72);
        --creator-accent: #7c8cff;
        --creator-bg: radial-gradient(120% 120% at 10% 0%, #38418a 0%, #1a2247 45%, #0e1429 100%);
        border-radius: 24px;
        overflow: clip;
        border: 1px solid rgba(255,255,255,0.12);
        background: var(--creator-bg);
        color: var(--creator-text);
        min-height: 76vh;
        position: relative;
        box-shadow: 0 18px 40px rgba(16,20,40,0.26);
    }


        /* ===== Theme: Avocado (replaces Navy) ===== */
        .smart-step-creator[data-theme="navy"] {
            --creator-sheet: white;
            --creator-border: rgba(20, 57, 31, 0.12);
            --creator-text: #14391f;
            --creator-sub: #6b7868;
            --creator-accent: #5fa052;
            --creator-bg: white;
            border-radius: 24px;
            overflow: clip;
            border: 1px solid var(--creator-border);
            background: var(--creator-bg);
            color: var(--creator-text);
            position: relative;
            box-shadow: 0 8px 24px rgba(20, 57, 31, 0.10);
        }

            .smart-step-creator[data-theme="navy"]::before {
                content: "";
                position: absolute;
                inset: -20%;
                background: radial-gradient(circle at 20% 20%, rgba(95,160,82,.08), transparent 60%);
                filter: blur(40px);
                pointer-events: none;
            }

    .preview-step-card[data-theme="navy"] {
        background: white;
        border-color: rgba(20, 57, 31, 0.12);
        color: #14391f !important;
    }

    /* ===== Structural layout classes ===== */
    .sheet-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
    }

    .creator-top-head {
        padding: 12px 14px 8px;
        border-bottom: 1px solid rgba(255,255,255,0.12);
        background: rgba(12, 16, 28, 0.28);
    }

    .smart-step-creator[data-theme="navy"] .creator-top-head {
        background: var(--cp-card-soft);
        border-bottom: 1px solid var(--creator-border);
    }

    .smart-step-creator[data-theme="navy"] .text-muted {
        color: var(--creator-sub) !important;
    }

    .smart-step-creator[data-theme="navy"] .btn-outline-light {
        border-color: var(--creator-border) !important;
        color: var(--creator-text) !important;
    }

        .smart-step-creator[data-theme="navy"] .btn-outline-light:hover {
            background: var(--cp-card-soft) !important;
            border-color: var(--creator-accent) !important;
            color: var(--creator-text) !important;
        }

    .sheet-title {
        font-weight: 800;
    }

    .sheet-sub {
        font-size: .77rem;
        color: var(--creator-sub);
    }

    .creator-preview-canvas {
        height: auto;
        padding: 16px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
    }

    .selected-zone {
        padding-top: 6px;
    }

    /* ===== Preview step card ===== */
    .preview-step-card {
        margin-top: 10px;
        border-radius: 22px;
        border: 1px solid var(--creator-border);
        background: rgba(255,255,255,0.18);
        padding: 16px;
        box-shadow: 0 14px 30px rgba(0,0,0,0.2);
        transform: translateY(0);
        opacity: 1;
        transition: transform .28s ease, opacity .28s ease;
    }

        .preview-step-card.preview-animate {
            transform: translateY(-6px);
            opacity: .86;
        }

    .preview-step-text {
        font-size: clamp(1.05rem, 2.5vw, 1.4rem);
        line-height: 1.42;
        font-weight: 700;
        color: var(--creator-text);
        min-height: 72px;
    }

    /* ===== Ingredient strips & chips ===== */
    .ingredient-top-strip {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 8px;
    }

    .ingredient-top-title {
        font-size: .74rem;
        color: var(--creator-sub);
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .ingredient-swiper {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        overflow: visible;
        padding: 4px 6px 6px;
        scrollbar-width: none;
    }

        .ingredient-swiper::-webkit-scrollbar {
            display: none;
        }

    .ingredient-swiper-top {
        margin-bottom: 4px;
    }

    .ingredient-chip {
        border: 1px solid var(--creator-border);
        background: rgba(255,255,255,0.08);
        color: var(--creator-text);
        border-radius: 14px;
        padding: 8px 12px;
        font-size: .82rem;
        white-space: nowrap;
        flex: 0 0 auto;
        margin: 1px 0;
        transition: all .2s ease;
    }

        .ingredient-chip.active {
            transform: scale(1.06);
            border-color: rgba(141,99,255,.8);
            box-shadow: 0 0 0 3px rgba(141,99,255,.28);
            background: rgba(141,99,255,.25);
        }

        .ingredient-chip.fraction-remainder {
            border-style: dashed;
            border-color: rgba(255,180,50,0.6);
        }

        .ingredient-chip.ingredient-chip-dimmed {
            opacity: 0.4;
            filter: grayscale(0.5);
            order: 99;
        }

    .ingredient-chip-divider {
        display: block;
        width: 100%;
        height: 1px;
        background: var(--creator-border);
        margin: 4px 0;
        order: 98;
    }

    .fraction-picker-row {
        border-top: 1px solid var(--creator-border);
        padding-top: 8px;
        margin-top: 6px;
    }

    .fraction-pick {
        font-size: 0.78rem;
        padding: 4px 10px;
        border-radius: 12px;
        border: 1px solid var(--creator-border);
        background: rgba(255,255,255,0.08);
        color: var(--creator-text);
        transition: all .18s ease;
        cursor: pointer;
    }

        .fraction-pick.active {
            border-color: rgba(141,99,255,.8);
            box-shadow: 0 0 0 2px rgba(141,99,255,.28);
            background: rgba(141,99,255,.25);
        }

    /* ===== CTA button ===== */
    .creator-cta-primary {
        border: 0;
        border-radius: 999px;
        background: linear-gradient(135deg, #8d63ff 0%, #5f85ff 100%);
        color: #fff;
        font-weight: 700;
        font-size: .82rem;
        padding: 8px 12px;
    }

    /* ===== Template selection ===== */
    .template-selection-wrap {
        margin-top: 10px;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    .template-library {
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-right: 2px;
        min-height: 0;
        flex: 1;
    }

    .template-library-fixed {
        height: 50vh;
        max-height: 50vh;
        overflow-y: auto;
    }

    .phase-header {
        border-bottom: 2px solid var(--creator-border);
        padding-bottom: 4px;
    }

    .phase-icon {
        font-size: 1.15rem;
    }

    .phase-title {
        font-weight: 700;
        font-size: .92rem;
        color: var(--creator-text);
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .sub-group-header {
        text-align: center;
        padding: 6px 0 4px;
        border-top: 1px solid var(--creator-border);
    }

    .sub-group-icon {
        font-size: 1.05rem;
        display: block;
        margin-bottom: 1px;
    }

    .sub-group-title {
        display: block;
        font-weight: 600;
        font-size: 1.5rem;
        color: var(--creator-text);
        letter-spacing: .3px;
        text-align: center;
    }

    .sub-group-desc {
        display: block;
        width: 100%;
        max-width: none;
        margin: 1px 0 0.25rem;
        font-size: .8rem;
        font-weight: 400;
        color: var(--creator-sub);
        line-height: 1.25;
        text-align: center;
        opacity: .72;
    }

    .template-card {
        border: 1px solid var(--creator-border);
        border-radius: 14px;
        background: rgba(255,255,255,0.08);
        color: var(--creator-text);
        text-align: left;
        padding: 10px;
        transition: transform .18s ease, border-color .18s ease, background .18s ease;
    }

        .template-card.active {
            border-color: rgba(141,99,255,.8);
            background: rgba(141,99,255,.2);
        }

        .template-card.template-tap {
            transform: scale(.98);
        }

    .template-title {
        font-weight: 700;
        font-size: .86rem;
    }

    .template-snippet {
        font-size: .76rem;
        color: var(--creator-sub);
        white-space: normal;
        overflow: visible;
        text-overflow: unset;
        line-height: 1.35;
    }

    .template-snippet-var {
        color: #ffe08a;
        text-shadow: 0 0 12px rgba(255,208,95,.28);
        border-bottom: 1px dashed rgba(255,224,138,.65);
        font-weight: 700;
    }

    /* ===== Selected steps ===== */
    #selectedSteps .step-row {
        border: 1px solid var(--creator-border);
        border-radius: 14px;
        background: rgba(255,255,255,0.08);
        color: var(--creator-text);
        padding: 10px;
        box-shadow: none;
    }

    #selectedSteps .step-badge {
        display: none;
    }

    #selectedSteps .display-step-selected {
        color: var(--creator-text);
    }

    #selectedSteps .step-text-content {
        display: block;
        font-weight: 700;
        margin-top: 6px;
    }

    .step-row-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 10px;
    }

    /* Hauptcontainer des Buttons */
    .template-card-modern {
        background: #ffffff;
        border: 1px solid rgba(20, 57, 31, 0.1);
        border-radius: 14px;
        padding: 12px;
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        font-family: inherit;
        text-align: left;
        width: 100%;
        transition: transform 0.1s, box-shadow 0.1s;
    }

        .template-card-modern:active {
            transform: scale(0.98);
        }

    /* Icon-Box links */
    .template-card-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #faf6ec;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    /* Text-Bereich */
    .template-card-content {
        flex: 1;
        min-width: 0; /* Verhindert Overflow bei langem Text */
    }

    .template-card-title {
        font-size: 13px;
        font-weight: 700;
        color: #14391f;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .template-card-snippet {
        font-size: 11px;
        color: #6b7868;
        margin-top: 2px;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Rechte Seite (Sterne & Plus) */
    .template-card-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
        flex-shrink: 0;
    }

    .template-card-score {
        font-size: 10px;
        color: #f5b942; /* Goldfarbe für die Sterne */
    }

    .template-card-plus {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: #ff7849; /* Dein Korallen-Farbton */
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
    }

    .cp-smart-panel {
        background: linear-gradient(135deg, var(--ink-deep), var(--ink-deep-2));
        border-radius: 16px;
        padding: 16px;
        color: white;
        margin: 15px 0;
    }

    :root {
        --bg-cream: #f5efe1;
        --bg-cream-2: #ede5d2;
        --card: #ffffff;
        --card-soft: #faf6ec;
        --ink-deep: #14391f;
        --ink-deep-2: #0e2415;
        --ink-mid: #2a4a32;
        --ink-text: #1a2e20;
        --ink-mute: #6b7868;
        --ink-line: rgba(20, 57, 31, 0.12);
        --ink-line-soft: rgba(20, 57, 31, 0.08);
        --avocado: #5fa052;
        --coral: #ff7849;
        --coral-soft: #ffb494;
        --orange: #ff9a3c;
        --gold: #f5b942;
        --radius-sm: 10px;
        --radius-md: 14px;
        --radius-lg: 18px;
        --radius-xl: 22px;
        --radius-pill: 999px;
        --shadow-sm: 0 2px 8px rgba(20, 57, 31, 0.06);
        --shadow-md: 0 8px 24px rgba(20, 57, 31, 0.10);
        --shadow-card: 0 8px 24px rgba(20, 57, 31, 0.06);
        --shadow-bar: 0 12px 30px rgba(20, 57, 31, 0.16);
        --shadow-coral: 0 6px 20px rgba(255, 120, 73, 0.40);
        --font-sans: 'Inter', -apple-system, sans-serif;
        --font-serif: 'Fraunces', Georgia, serif;
    }
</style>

<section class="mt-3 mb-4" id="card-steps" style="min-height:auto">
    <div id="sc2MasterPreviewCard" class="preview-step-card">
        <div id="MasterText" class="preview-step-text">Template auswählen.</div>
    </div>

    <div class="template-selection-wrap">
        <div class="ingredient-top-title mb-1">Weitere Steps zur Auswahl</div>
        <partial name="partials/_smartStepCreatorFilter.cshtml" />
        <div id="sc2MasterTemplateCards" class="preview-step-text template-library-fixed p-2">
        </div>

        <div id="stepsChipStrip" class="ingredient-top-strip mb-3 d-none">
            <div class="ingredient-top-title">Zutat für Schritt wählen</div>
            <div class="ingredient-swiper ingredient-swiper-top mb-2" id="stepsIngredientButtons"></div>
            <div class="d-flex gap-2 mt-1">
                <button type="button" id="btnApplyStepIngredient" class="btn btn-sm creator-cta-primary">Einsetzen</button>
                <button type="button" id="btnCancelStepIngredient" class="btn btn-sm btn-outline-light">Abbrechen</button>
            </div>
        </div>
    <div id="selectedSteps" class="selected-zone"></div>
</section>
