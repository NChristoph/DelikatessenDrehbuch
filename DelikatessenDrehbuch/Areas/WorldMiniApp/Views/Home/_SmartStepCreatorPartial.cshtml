@* Smart Step Creator — shared between CreatePosting and EditRecipe *@
<style>
    /* ===== Base smart-step-creator ===== */
    .smart-step-creator {
        --creator-sheet: rgba(22, 32, 68, 0.62);
        --creator-border: rgba(170, 190, 255, 0.20);
        --creator-text: #f8f9ff;
        --creator-sub: rgba(220, 228, 255, 0.72);
        --creator-accent: #7c8cff;
        --creator-bg: radial-gradient(120% 120% at 10% 0%, #38418a 0%, #1a2247 45%, #0e1429 100%);
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.12);
        background: var(--creator-bg);
        color: var(--creator-text);
        min-height: 76vh;
        position: relative;
        box-shadow: 0 18px 40px rgba(16,20,40,0.26);
    }

    .smart-step-creator[data-theme="light"] {
        --creator-bg: linear-gradient(180deg, #e8f0ff 0%, #f8fbff 60%, #ffffff 100%);
        --creator-sheet: rgba(255,255,255,0.72);
        --creator-border: rgba(26,36,56,0.12);
        --creator-text: #101828;
        --creator-sub: rgba(16,24,40,0.65);
        --creator-accent: #5b6df9;
    }

    /* ===== Theme: Rosa ===== */
    .smart-step-creator[data-theme="rosa"] {
        --creator-sheet: rgba(68, 22, 56, 0.62);
        --creator-border: rgba(255, 170, 220, 0.22);
        --creator-text: #111111;
        --creator-sub: rgba(17, 17, 17, 0.72);
        --creator-accent: #ff7fcf;
        --creator-bg: radial-gradient(120% 120% at 10% 0%, #ff9adf 0%, #8a3f75 45%, #ff9adf 100%);
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.12);
        background: var(--creator-bg);
        color: var(--creator-text);
        min-height: 76vh;
        position: relative;
        box-shadow: 0 18px 40px rgba(40,10,30,0.30);
    }

    .smart-step-creator[data-theme="rosa"] {
        --creator-text: #ffffff;
        --creator-sub: rgba(255, 255, 255, 0.92);
    }

    .smart-step-creator[data-theme="rosa"] .sheet-head *,
    .smart-step-creator[data-theme="rosa"] .creator-preview-canvas *,
    .smart-step-creator[data-theme="rosa"] .template-selection-wrap *,
    .smart-step-creator[data-theme="rosa"] .ingredient-top-strip *,
    .smart-step-creator[data-theme="rosa"] .display-name,
    .smart-step-creator[data-theme="rosa"] .display-name-selected,
    .smart-step-creator[data-theme="rosa"] .ingredient-row-meta,
    .smart-step-creator[data-theme="rosa"] .template-title,
    .smart-step-creator[data-theme="rosa"] .probability-template-card,
    .smart-step-creator[data-theme="rosa"] .probability-template-card *,
    .smart-step-creator[data-theme="rosa"] .ingredient-db-row .display-name,
    .smart-step-creator[data-theme="rosa"] .ingredient-card-head .display-name,
    .smart-step-creator[data-theme="rosa"] #sc2StoryStepCount,
    .smart-step-creator[data-theme="rosa"] #ingredientProbabilityBadges,
    .smart-step-creator[data-theme="rosa"] #insertContainer,
    .smart-step-creator[data-theme="rosa"] #MasterText,
    .smart-step-creator[data-theme="rosa"] #acceptedStepsRecipeText {
        color: #fff !important;
        text-shadow: -1px 0 #000, 0 1px #000, 1px 0 #000, 0 -1px #000;
    }

    .smart-step-creator[data-theme="rosa"] #ingredientProbabilityBadges,
    .smart-step-creator[data-theme="rosa"] #ingredientProbabilityBadges *,
    .smart-step-creator[data-theme="rosa"] #ingredientProbabilityTemplates,
    .smart-step-creator[data-theme="rosa"] #ingredientProbabilityTemplates *,
    .smart-step-creator[data-theme="rosa"] #probVarIngredientChips,
    .smart-step-creator[data-theme="rosa"] #probVarIngredientChips *,
    .smart-step-creator[data-theme="rosa"] #masterTemplateCards,
    .smart-step-creator[data-theme="rosa"] #masterTemplateCards *,
    .smart-step-creator[data-theme="rosa"] #sc2MasterTemplateCards,
    .smart-step-creator[data-theme="rosa"] #sc2MasterTemplateCards *,
    .smart-step-creator[data-theme="rosa"] #currentStepIngredientButtons,
    .smart-step-creator[data-theme="rosa"] #currentStepIngredientButtons *,
    .smart-step-creator[data-theme="rosa"] #stepsIngredientButtons,
    .smart-step-creator[data-theme="rosa"] #stepsIngredientButtons * {
        color: #fff !important;
        text-shadow: -1px 0 #000, 0 1px #000, 1px 0 #000, 0 -1px #000;
    }

    .smart-step-creator[data-theme="rosa"] .token-highlight,
    .smart-step-creator[data-theme="rosa"] .placeholder-token {
        color: #ffe08a !important;
        text-shadow: -1px 0 #000, 0 1px #000, 1px 0 #000, 0 -1px #000, 0 0 16px rgba(255,208,95,.35) !important;
        border-bottom: 1px dashed rgba(255,224,138,.75);
    }

    .smart-step-creator[data-theme="rosa"] .placeholder-token.token-active {
        background: rgba(255,224,138,.2) !important;
        border-radius: 8px;
        padding: 0 4px;
    }

    .smart-step-creator[data-theme="rosa"] .placeholder-reset {
        border: 0;
        background: rgba(255,255,255,0.18) !important;
        color: #fff !important;
        text-shadow: none !important;
        border-radius: 999px;
        width: 16px;
        height: 16px;
        line-height: 16px;
        font-size: .62rem;
        padding: 0;
        cursor: pointer;
        box-shadow: 0 1px 4px rgba(0,0,0,.25);
    }

    .smart-step-creator[data-theme="rosa"] .placeholder-reset:hover {
        background: rgba(255,255,255,0.28) !important;
    }

    .smart-step-creator[data-theme="rosa"] option {
        color: #111 !important;
        text-shadow: none !important;
    }

    .preview-step-card[data-theme="rosa"] {
        background: rgba(255, 235, 245, 0.88);
        border-color: rgba(122, 36, 96, 0.25);
        color: #111 !important;
    }

    /* ===== Theme: Gold ===== */
    .smart-step-creator[data-theme="gold"] {
        --creator-sheet: linear-gradient(to right, #FDEB9E, #C68F18, #D39903);
        --creator-border: white;
        --creator-text: white;
        --creator-sub: white;
        --creator-accent: #e7b95a;
        --creator-bg: radial-gradient(120% 120% at 10% 0%, #f0c97a 0%, #9a6b24 45%, #FDE383 100%);
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(255, 220, 140, 0.25);
        background: var(--creator-bg);
        color: var(--creator-text);
        position: relative;
        box-shadow: 0 18px 40px rgba(30,20,0,0.35);
    }

    .smart-step-creator[data-theme="gold"]::before {
        content: "";
        position: absolute;
        inset: -20%;
        background: radial-gradient(circle at 20% 20%, rgba(255,215,120,0.35), transparent 60%);
        filter: blur(40px);
        pointer-events: none;
        min-height: 76vh;
    }

    .preview-step-card[data-theme="gold"] {
        background: #2a3756;
    }

    .template-card[data-theme="gold"] {
        background: #2a3756;
    }

    /* ===== Theme: Navy ===== */
    .smart-step-creator[data-theme="navy"] {
        --creator-sheet: linear-gradient(to right, #0f234d, #18366f, #1f4d92);
        --creator-border: rgba(173, 207, 255, 0.30);
        --creator-text: #f7fbff;
        --creator-sub: rgba(237, 245, 255, 0.88);
        --creator-accent: #79aaff;
        --creator-bg: radial-gradient(120% 120% at 10% 0%, #244a88 0%, #0f234d 48%, #081528 100%);
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(163, 199, 255, 0.20);
        background: var(--creator-bg);
        color: var(--creator-text);
        position: relative;
        box-shadow: 0 18px 40px rgba(4, 10, 26, 0.45);
    }

    .smart-step-creator[data-theme="navy"]::before {
        content: "";
        position: absolute;
        inset: -20%;
        background: radial-gradient(circle at 20% 20%, rgba(118,168,255,.25), transparent 60%);
        filter: blur(40px);
        pointer-events: none;
    }

    .preview-step-card[data-theme="navy"] {
        background: rgba(7, 20, 46, 0.76);
        border-color: rgba(164, 193, 255, 0.18);
        color: #fff !important;
    }

    /* ===== Structural layout classes ===== */
    .sheet-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
    }

    .creator-top-head {
        padding: 12px 14px 8px;
        border-bottom: 1px solid rgba(255,255,255,0.12);
        background: rgba(12, 16, 28, 0.28);
    }

    .sheet-title { font-weight: 800; }

    .sheet-sub {
        font-size: .77rem;
        color: var(--creator-sub);
    }

    .creator-preview-canvas {
        height: auto;
        padding: 16px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
    }

    .selected-zone { padding-top: 6px; }

    /* ===== Preview step card ===== */
    .preview-step-card {
        margin-top: 10px;
        border-radius: 22px;
        border: 1px solid var(--creator-border);
        background: rgba(255,255,255,0.18);
        padding: 16px;
        box-shadow: 0 14px 30px rgba(0,0,0,0.2);
        transform: translateY(0);
        opacity: 1;
        transition: transform .28s ease, opacity .28s ease;
    }

    .preview-step-card.preview-animate {
        transform: translateY(-6px);
        opacity: .86;
    }

    .preview-step-text {
        font-size: clamp(1.05rem, 2.5vw, 1.4rem);
        line-height: 1.42;
        font-weight: 700;
        color: var(--creator-text);
        min-height: 72px;
    }

    /* ===== Ingredient strips & chips ===== */
    .ingredient-top-strip {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 8px;
    }

    .ingredient-top-title {
        font-size: .74rem;
        color: var(--creator-sub);
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .ingredient-swiper {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        overflow: visible;
        padding: 4px 6px 6px;
        scrollbar-width: none;
    }

    .ingredient-swiper::-webkit-scrollbar { display: none; }

    .ingredient-swiper-top { margin-bottom: 4px; }

    .ingredient-chip {
        border: 1px solid var(--creator-border);
        background: rgba(255,255,255,0.08);
        color: var(--creator-text);
        border-radius: 14px;
        padding: 8px 12px;
        font-size: .82rem;
        white-space: nowrap;
        flex: 0 0 auto;
        margin: 1px 0;
        transition: all .2s ease;
    }

    .ingredient-chip.active {
        transform: scale(1.06);
        border-color: rgba(141,99,255,.8);
        box-shadow: 0 0 0 3px rgba(141,99,255,.28);
        background: rgba(141,99,255,.25);
    }

    .ingredient-chip.fraction-remainder {
        border-style: dashed;
        border-color: rgba(255,180,50,0.6);
    }

    .ingredient-chip.ingredient-chip-dimmed {
        opacity: 0.4;
        filter: grayscale(0.5);
        order: 99;
    }

    .ingredient-chip-divider {
        display: block;
        width: 100%;
        height: 1px;
        background: var(--creator-border);
        margin: 4px 0;
        order: 98;
    }

    .fraction-picker-row {
        border-top: 1px solid var(--creator-border);
        padding-top: 8px;
        margin-top: 6px;
    }

    .fraction-pick {
        font-size: 0.78rem;
        padding: 4px 10px;
        border-radius: 12px;
        border: 1px solid var(--creator-border);
        background: rgba(255,255,255,0.08);
        color: var(--creator-text);
        transition: all .18s ease;
        cursor: pointer;
    }

    .fraction-pick.active {
        border-color: rgba(141,99,255,.8);
        box-shadow: 0 0 0 2px rgba(141,99,255,.28);
        background: rgba(141,99,255,.25);
    }

    /* ===== CTA button ===== */
    .creator-cta-primary {
        border: 0;
        border-radius: 999px;
        background: linear-gradient(135deg, #8d63ff 0%, #5f85ff 100%);
        color: #fff;
        font-weight: 700;
        font-size: .82rem;
        padding: 8px 12px;
    }

    /* ===== Template selection ===== */
    .template-selection-wrap {
        margin-top: 10px;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    .template-library {
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-right: 2px;
        min-height: 0;
        flex: 1;
    }

    .template-library-fixed {
        height: 50vh;
        max-height: 50vh;
        overflow-y: auto;
    }

    .phase-header {
        border-bottom: 2px solid var(--creator-border);
        padding-bottom: 4px;
    }

    .phase-icon { font-size: 1.15rem; }

    .phase-title {
        font-weight: 700;
        font-size: .92rem;
        color: var(--creator-text);
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .sub-group-header {
        text-align: center;
        padding: 6px 0 4px;
        border-top: 1px solid var(--creator-border);
    }

    .sub-group-icon { font-size: 1.05rem; display: block; margin-bottom: 1px; }

    .sub-group-title {
        display: block;
        font-weight: 600;
        font-size: 1.5rem;
        color: var(--creator-text);
        letter-spacing: .3px;
        text-align: center;
    }

    .sub-group-desc {
        display: block;
        width: 100%;
        max-width: none;
        margin: 1px 0 0.25rem;
        font-size: .8rem;
        font-weight: 400;
        color: var(--creator-sub);
        line-height: 1.25;
        text-align: center;
        opacity: .72;
    }

    .template-card {
        border: 1px solid var(--creator-border);
        border-radius: 14px;
        background: rgba(255,255,255,0.08);
        color: var(--creator-text);
        text-align: left;
        padding: 10px;
        transition: transform .18s ease, border-color .18s ease, background .18s ease;
    }

    .template-card.active {
        border-color: rgba(141,99,255,.8);
        background: rgba(141,99,255,.2);
    }

    .template-card.template-tap { transform: scale(.98); }

    .template-title { font-weight: 700; font-size: .86rem; }

    .template-snippet {
        font-size: .76rem;
        color: var(--creator-sub);
        white-space: normal;
        overflow: visible;
        text-overflow: unset;
        line-height: 1.35;
    }

    .template-snippet-var {
        color: #ffe08a;
        text-shadow: 0 0 12px rgba(255,208,95,.28);
        border-bottom: 1px dashed rgba(255,224,138,.65);
        font-weight: 700;
    }

    /* ===== Selected steps ===== */
    #selectedSteps .step-row {
        border: 1px solid var(--creator-border);
        border-radius: 14px;
        background: rgba(255,255,255,0.08);
        color: var(--creator-text);
        padding: 10px;
        box-shadow: none;
    }

    #selectedSteps .step-badge { display: none; }

    #selectedSteps .display-step-selected { color: var(--creator-text); }

    #selectedSteps .step-text-content {
        display: block;
        font-weight: 700;
        margin-top: 6px;
    }

    .step-row-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 10px;
    }
</style>

<section class="smart-step-creator mt-3 mb-4" data-theme="rosa" id="card-steps" style="min-height:auto">
    <div class="sheet-head creator-top-head">
        <div>
            <div class="sheet-title label-lang" data-de="Arbeitsschritte" data-en="Steps">Arbeitsschritte</div>
            <div class="sheet-sub label-lang" data-de="Sortiere & bearbeite wie ein Script" data-en="Order & edit like a script">Sortiere & bearbeite wie ein Script</div>
        </div>
        <span class="badge rounded-pill bg-transparent border border-light text-light">4/5</span>
    </div>

    <div class="creator-preview-canvas" style="min-height:auto; padding:14px 16px;">
        <div id="sc2MasterPreviewCanvas" style="border-bottom:1px solid rgba(255,255,255,0.12);padding-bottom:16px;margin-bottom:16px;">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <div class="sheet-title" style="font-size:14px;">Smart Step Creator</div>
                    <div class="sheet-sub" style="font-size:12px;">Wähle Zutat + Template wie im Creator Flow</div>
                    <div class="small text-muted mt-1"><span id="sc2StoryStepCount">Schritte: 0</span></div>
                </div>
            </div>

            <div id="sc2MasterPreviewCard" class="preview-step-card" data-theme="gold">
                <div id="MasterText" class="preview-step-text">Template auswählen.</div>
            </div>

            <div class="template-selection-wrap">
                <div class="ingredient-top-title mb-1">Weitere Steps zur Auswahl</div>
                <div id="sc2MasterTemplateCards" class="template-library-fixed p-2"></div>
            </div>
        </div>

        <div id="stepsChipStrip" class="ingredient-top-strip mb-3 d-none">
            <div class="ingredient-top-title">Zutat für Schritt wählen</div>
            <div class="ingredient-swiper ingredient-swiper-top mb-2" id="stepsIngredientButtons"></div>
            <div class="d-flex gap-2 mt-1">
                <button type="button" id="btnApplyStepIngredient" class="btn btn-sm creator-cta-primary">Einsetzen</button>
                <button type="button" id="btnCancelStepIngredient" class="btn btn-sm btn-outline-light">Abbrechen</button>
            </div>
        </div>

        <div id="selectedSteps" class="selected-zone"></div>
    </div>
</section>
