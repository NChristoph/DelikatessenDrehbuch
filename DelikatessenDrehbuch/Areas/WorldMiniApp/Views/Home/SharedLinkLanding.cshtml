@{
    Layout = null;
    var shareType = ViewData["ShareType"] as string ?? "content";
    var token = ViewData["Token"] as string ?? "";
    var title = ViewData["Title"] as string ?? "Geteilter Inhalt";
    var description = ViewData["Description"] as string ?? "Oeffne diesen Inhalt in der World App";
    var targetPath = ViewData["TargetPath"] as string ?? "";
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - World App</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            padding: 20px;
        }

        .landing-card {
            background: white;
            border-radius: 24px;
            padding: 48px 32px;
            max-width: 480px;
            width: 100%;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            text-align: center;
        }

        .world-logo {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            font-size: 40px;
            color: white;
        }

        h1 {
            font-size: 28px;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 12px;
        }

        .description {
            color: #666;
            font-size: 16px;
            margin-bottom: 32px;
            line-height: 1.5;
        }

        .open-app-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 16px;
            padding: 16px 32px;
            font-size: 18px;
            font-weight: 600;
            width: 100%;
            cursor: pointer;
            margin-bottom: 16px;
            transition: transform 0.2s, box-shadow 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            text-decoration: none;
        }

        .open-app-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(102, 126, 234, 0.4);
            color: white;
        }

        .open-app-btn:active {
            transform: translateY(0);
        }

        .secondary-btn {
            background: #f5f5f5;
            color: #333;
        }

        .secondary-btn:hover {
            background: #e8e8e8;
            color: #333;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        }

        .fallback-text {
            color: #999;
            font-size: 14px;
            margin: 24px 0 16px;
        }

        .download-links {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .download-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            background: #f5f5f5;
            border-radius: 12px;
            color: #333;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: background 0.2s;
        }

        .download-link:hover {
            background: #e8e8e8;
            color: #333;
        }

        .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: white;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .status-message {
            color: #666;
            font-size: 14px;
            margin-top: 16px;
            min-height: 20px;
        }
    </style>
</head>
<body>
    <div class="landing-card"
         data-token="@token"
         data-target-path="@targetPath"
         data-share-type="@shareType">
        <div class="world-logo">
            <i class="bi bi-globe2"></i>
        </div>

        <h1>@title</h1>
        <p class="description">@description</p>

        <button class="open-app-btn" id="openAppBtn" onclick="openInWorldApp()">
            <span id="btnContent">
                <i class="bi bi-app"></i>
                In World App oeffnen
            </span>
        </button>

        <div class="status-message" id="statusMessage"></div>

        <div style="margin-top: 16px;">
            <button class="open-app-btn" style="background: linear-gradient(135deg, #5fa052 0%, #3f7536 100%);" onclick="copyLinkAndOpenApp()">
                <i class="bi bi-clipboard-check"></i>
                Link kopieren und App oeffnen
            </button>
            <p style="font-size: 12px; color: #666; margin-top: 8px;">
                Kopiert den Link und oeffnet World App. Navigiere dort zur Mini App und fuege den Link ein.
            </p>
        </div>

        <a class="open-app-btn secondary-btn" id="openBrowserBtn" href="#">
            <i class="bi bi-browser-chrome"></i>
            Im Browser oeffnen
        </a>

        <div class="fallback-text">
            Noch keine World App?
        </div>

        <div class="download-links">
            <a href="https://apps.apple.com/app/worldcoin/id1560859847" class="download-link" target="_blank" rel="noopener noreferrer">
                <i class="bi bi-apple"></i>
                iOS herunterladen
            </a>
            <a href="https://play.google.com/store/apps/details?id=com.worldcoin" class="download-link" target="_blank" rel="noopener noreferrer">
                <i class="bi bi-google-play"></i>
                Android herunterladen
            </a>
        </div>
    </div>

    <script>
        const card = document.querySelector(".landing-card");
        const token = card.dataset.token || "";
        const targetPath = card.dataset.targetPath || "";
        const shareType = card.dataset.shareType || "";

        let attemptCount = 0;
        let appOpened = false;

        function buildTargetUrl() {
            return window.location.origin + targetPath;
        }

        function isInWorldApp() {
            const ua = navigator.userAgent || "";
            const hasWorldAppUA = ua.toLowerCase().includes("worldapp") ||
                ua.toLowerCase().includes("minikit") ||
                ua.toLowerCase().includes("worldcoin");
            const hasMiniKit = window.MiniKit !== undefined || window.minikit !== undefined;

            return hasWorldAppUA || hasMiniKit;
        }

        function openInWorldApp() {
            const btn = document.getElementById("openAppBtn");
            const status = document.getElementById("statusMessage");
            const btnContent = document.getElementById("btnContent");
            const fullUrl = buildTargetUrl();

            attemptCount++;
            btnContent.innerHTML = '<span class="spinner"></span> Oeffne World App...';
            btn.disabled = true;

            if (isInWorldApp()) {
                window.location.replace(fullUrl);
                return;
            }

            const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
            const isAndroid = /Android/.test(navigator.userAgent);

            if (isAndroid) {
                try {
                    const urlObj = new URL(fullUrl);
                    const path = urlObj.pathname + urlObj.search;
                    const intentLink = `intent:${path}#Intent;scheme=https;package=com.worldcoin;action=android.intent.action.VIEW;S.browser_fallback_url=${encodeURIComponent(fullUrl)};end`;
                    window.location.href = intentLink;
                } catch (e) {
                    console.error("Intent failed:", e);
                    window.location.href = fullUrl;
                }

                setTimeout(() => {
                    if (!document.hidden && !appOpened) {
                        window.location.href = fullUrl;
                    }
                }, 2000);
            } else if (isIOS) {
                window.location.href = fullUrl;
            } else {
                window.location.href = fullUrl;
            }

            const startTime = Date.now();
            setTimeout(() => {
                const elapsed = Date.now() - startTime;

                if (!document.hidden && elapsed > 3000) {
                    btnContent.innerHTML = '<i class="bi bi-app"></i> Erneut versuchen';
                    btn.disabled = false;

                    if (attemptCount === 1) {
                        status.innerHTML = 'World App konnte nicht geoeffnet werden.<br><small>Oeffne den Inhalt direkt im Browser oder installiere die App.</small>';
                    } else {
                        status.textContent = "Bitte oeffne die World App manuell oder nutze direkt den Browser-Button.";
                    }
                } else {
                    appOpened = true;
                }
            }, 3500);

            setTimeout(() => {
                if (!appOpened) {
                    btnContent.innerHTML = '<i class="bi bi-app"></i> In World App oeffnen';
                    btn.disabled = false;
                }
            }, 7000);
        }

        document.addEventListener("visibilitychange", () => {
            if (document.hidden) {
                appOpened = true;
                document.getElementById("statusMessage").textContent = "World App wird geoeffnet...";
            }
        });

        window.addEventListener("focus", () => {
            if (attemptCount > 0 && !appOpened) {
                setTimeout(() => {
                    const status = document.getElementById("statusMessage");
                    if (!appOpened) {
                        status.textContent = "Zurueck zur Seite. Du kannst es erneut versuchen oder direkt im Browser oeffnen.";
                    }
                }, 300);
            }
        });

        function copyLinkAndOpenApp() {
            const fullUrl = buildTargetUrl();

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(fullUrl).then(() => {
                    document.getElementById("statusMessage").textContent = "Link kopiert. Oeffne jetzt die World App...";

                    setTimeout(() => {
                        if (/Android/.test(navigator.userAgent)) {
                            window.location.href = "intent://launch#Intent;scheme=worldapp;package=com.worldcoin;end";
                        } else {
                            window.location.href = "worldapp://";
                        }
                    }, 500);
                }).catch(() => {
                    alert("Link: " + fullUrl);
                });
            } else {
                alert("Kopiere diesen Link:\n\n" + fullUrl);
            }
        }

        window.addEventListener("DOMContentLoaded", () => {
            const fullUrl = buildTargetUrl();
            const browserButton = document.getElementById("openBrowserBtn");
            if (browserButton) {
                browserButton.href = fullUrl;
            }

            if (isInWorldApp()) {
                window.location.replace(fullUrl);
                return;
            }

            setTimeout(() => {
                openInWorldApp();
            }, 500);
        });
    </script>
</body>
</html>
