<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-DelikatessenDrehbuch-525cf141-ec89-4d26-be78-5ae55cd97ab0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="EmailSetting\**" />
    <Content Remove="EmailSetting\**" />
    <EmbeddedResource Remove="EmailSetting\**" />
    <None Remove="EmailSetting\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\ads.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="nul" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Views\Payment\Success.cshtml" />
    <None Include="wwwroot\ads.txt" />
    <None Include="wwwroot\css\Logo\DelikatessenDrehbuch_Logo.png" />
    <None Include="wwwroot\css\Logo\Schema Querys.png" />
  </ItemGroup>

  <!-- ✅ NUGET: sauber & net6-kompatibel -->
  <ItemGroup>
    <!-- Azure Storage -->
    <PackageReference Include="AWSSDK.Polly" Version="4.0.100.3" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.27.0" />
    <!-- DataProtection-Keys persistent in SQL (überlebt Neustart / mehrere Instanzen) -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="8.0.23" />
    <PackageReference Include="Azure.Storage.Queues" Version="12.25.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Nethereum.Web3" Version="6.1.0" />

    <!-- Fix für dein Downgrade-Problem: nur 1x, und auf 8.0.1 -->

    <!-- ASP.NET Core / EF Core (alle auf 6.x passend zu net6.0) -->
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="8.0.23" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.23" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="8.0.23" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.23" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.23" />

    <!-- Redis (net6-geeignet) -->

    <!-- Sonstiges -->
    <PackageReference Include="Polly" Version="8.4.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Stripe.net" Version="50.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\Migrations\" />
    <Folder Include="MealPlaner\Models\" />
  </ItemGroup>

  <!-- Localization Resources -->
  <ItemGroup>
    <!-- Neutral resource file - generates Designer.cs with ResourceManager -->
    <EmbeddedResource Update="Resources\SharedResources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>SharedResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>

    <Compile Update="Resources\SharedResources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>SharedResources.resx</DependentUpon>
    </Compile>

    <EmbeddedResource Update="Resources\SharedResources.de.resx">
      <DependentUpon>SharedResources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\SharedResources.en.resx">
      <DependentUpon>SharedResources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\SharedResources.es.resx">
      <DependentUpon>SharedResources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\SharedResources.pt.resx">
      <DependentUpon>SharedResources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\SharedResources.id.resx">
      <DependentUpon>SharedResources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\SharedResources.nl.resx">
      <DependentUpon>SharedResources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\SharedResources.sv.resx">
      <DependentUpon>SharedResources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\SharedResources.da.resx">
      <DependentUpon>SharedResources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\SharedResources.nb.resx">
      <DependentUpon>SharedResources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\SharedResources.ms.resx">
      <DependentUpon>SharedResources.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
