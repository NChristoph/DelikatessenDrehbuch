@using DelikatessenDrehbuch.StaticScripts;
@model Dictionary<int, List<Recipes>>




<div class=" flexColumn w-100 flexAlginItemCenter">
    @{
        foreach (var key in Model.Keys)
        {
            <hr class="w-75" style="height:2px" />

            <span class="m-2 w-100"
                  style="text-align:center;display:block;">
                <strong> Rezepte für Tag @key.ToString()</strong>

            </span>

            var recipesList = Model[key];
            Recipes container = new()
            {
                Id = key + 99998888,
                Name = "Zutaten für den Tag",
                Preparation = string.Join(";", recipesList.Select(x => x.Id)),
                Description = "Zutaten"

            };
            recipesList.Add(container);
            foreach (var recipes in recipesList)
            {
                <button class="btn bgRed Border-Gold mb-2 w-50 mobieleWidth90 mobileCenter"
                        style="color:white;max-width:90%"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#MealPlanCanvas_@key@recipes.Id"
                        aria-controls="navbarSupportedContent">
                    @recipes.Name

                </button>

                if (recipes.Description != "Zutaten")
                {
                    <div class="offcanvas offcanvas-start w-50 mobieleWidth100 tableteSize75"
                         tabindex="-1"
                         id="MealPlanCanvas_@key@recipes.Id"
                         aria-labelledby="offcanvasExampleLabel">

                        <div class="offcanvas-header ">
                            <img class="grid-Logo"
                                 src="/css/Logo/DelikatessenDrehbuch_Logo_Ohne hintergrund.png"
                                 style=" max-height:100px;object-fit:contain" />

                            <div class="grid-Name"
                                 style="color:#D4AF37;font-size:14px">
                                Delikatessen Drehbuch
                            </div>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="offcanvas"
                                    aria-label="Close">
                            </button>
                        </div>

                        <div class="offcanvas-body Bg-Cream w-100 ">

                            <span class="w-100 mt-2 mb-2"
                                  style="text-align:center;display:block">
                                <strong>@recipes.Name</strong>
                            </span>

                            <div class=" flexRowToColumn flexAlginItemCenter Bg-Cream Border-Gold w-100 mobieleWidth90">

                                <div class=" mobieleWidth100 ">
                                    <div name="Recipes"
                                         title="@recipes.Id">
                                    </div>

                                    <div class="flexRowToColumn flexJustifyContendSpaceAround mobileItemCenter">

                                        <div class="flexColumn mt-4 mobieleWidth90 mobileItemCenter"
                                             style="max-width:40%">

                                            <div id="ingredientPartialView_@recipes.Id@key"
                                                 class="p-2 mobieleWidth80"
                                                 style="min-width:40%">
                                            </div>

                                            @{


                                                @if (!string.IsNullOrEmpty(recipes.ImagePath))
                                                {

                                                    var subPath = FrontendFunctions.CaseInsensitivePath(recipes.ImagePath);

                                                    var smallPath = subPath?.Replace(Environment.GetEnvironmentVariable("BigPic"),
                                                    Environment.GetEnvironmentVariable("SmalPic"));

                                                    <div class=" grid-Image w-100 flex flexJustifyContendCenter mt-3">

                                                        <picture class="mobieleWidth90 " style="max-width:450px;max-height:450px">

                                                            <source srcset="@($"{smallPath}_small.webp")">

                                                            <img class="img-fluid"
                                                                 src="@smallPath"
                                                                 alt="@(!string.IsNullOrEmpty(recipes.Description) ? recipes.Description : recipes.Name)"
                                                                 title="@recipes.Name"
                                                                 width="450"
                                                                 height="450"
                                                                 decoding="async"
                                                                 style="aspect-ratio: 3 / 2; object-fit: cover;" />
                                                        </picture>

                                                    </div>


                                                }
                                                else
                                                {
                                                    <img class="img-fluid" src="https://cdn.pixabay.com/photo/2020/04/22/18/22/excuse-me-5079442_640.jpg" />
                                                }

                                                <ins class="adsbygoogle"
                                                     style="display:flex"
                                                     data-ad-client="ca-pub-2332503983815482"
                                                     data-ad-slot="6882535678"
                                                     data-ad-format="auto"
                                                     data-full-width-responsive="true"></ins>
                                                <script>
                                                    (adsbygoogle = window.adsbygoogle || []).push({});
                                                </script>
                                            }
                                        </div>


                                        <span class="p-2 mobieleWidth90"
                                              style="max-width:49%;white-space:pre-line">
                                            @Html.Raw(@recipes.Preparation)
                                        </span>

                                    </div>
                                    <script>

                                        document.addEventListener("DOMContentLoaded", function () {
                                        ReloadIngredientList("ingredientPartialView_@recipes.Id@key",@recipes.Id);

                                        });
                                    </script>
                                </div>

                            </div>

                        </div>
                    </div>
                }
                else
                {
                    <div class="offcanvas offcanvas-start w-50 mobieleWidth100 tableteSize75"
                         tabindex="-1"
                         id="MealPlanCanvas_@key@recipes.Id"
                         aria-labelledby="offcanvasExampleLabel">

                        <div class="offcanvas-header ">
                            <img class="grid-Logo"
                                 src="/css/Logo/DelikatessenDrehbuch_Logo_Ohne hintergrund.png"
                                 style=" max-height:100px;object-fit:contain" />

                            <div class="grid-Name"
                                 style="color:#D4AF37;font-size:14px">
                                Delikatessen Drehbuch
                            </div>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="offcanvas"
                                    aria-label="Close">
                            </button>
                        </div>

                        <div class="offcanvas-body Bg-Cream Border-Gold w-100 ">


                            <span class="w-100 mt-2 mb-2"
                                  style="text-align:center;display:block">
                                <strong>@recipes.Name</strong>
                            </span>
                            <div class="flexRowToColumn flexAlginItemCenter flexJustifyContendCenter mobileItemCenter">

                                <div class="flexColumn mt-4 mobieleWidth90 mobileItemCenter">

                                    <div id="ingredientPartialView_@recipes.Id"
                                         class="p-2 mobieleWidth80"
                                         style="min-width:40%">
                                    </div>

                                </div>




                            </div>
                            <script>
                                document.addEventListener("DOMContentLoaded", function () {
                                ReloadIngredientList("ingredientPartialView_@recipes.Id","@recipes.Preparation");});
                            </script>
                        </div>
                    </div>
                }




            }
        }
    }
    <hr class="w-75" />

    <button class="btn bgRed Border-Gold mb-2 w-50 mobieleWidth90 mobileCenter"
            style="color:white;max-width:90%"
            type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#Gesamte_ZutatenListe"
            aria-controls="navbarSupportedContent">
        Gesamte ZutatenListe
    </button>
</div>


<div class="offcanvas offcanvas-start w-50 mobieleWidth100 tableteSize75  "
     tabindex="-1"
     id="Gesamte_ZutatenListe"
     aria-labelledby="offcanvasExampleLabel">

    <div class="offcanvas-header ">
        <img class="grid-Logo"
             src="/css/Logo/DelikatessenDrehbuch_Logo_Ohne hintergrund.png"
             style=" max-height:100px;object-fit:contain" />

        <div class="grid-Name"
             style="color:#D4AF37;font-size:14px">
            Delikatessen Drehbuch
        </div>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas"
                aria-label="Close">
        </button>

    </div>
    <div class="offcanvas-body Bg-Cream Border-Gold w-100 ">


        <span class="w-100 mt-2 mb-2"
              style="text-align:center;display:block">
            <strong>Einkaufliste :</strong>
        </span>

        <div class="flexRowToColumn flexAlginItemCenter mobileItemCenter">

            <div class="flexColumn mt-4 mobieleWidth90 mobileItemCenter">
                <div id="ingredientPartialView"
                     class="p-2 mobieleWidth80"
                     style="min-width:40%">
                </div>

            </div>


        </div>

        <script>

                document.addEventListener("DOMContentLoaded", function () {
                ReloadIngredientList();

            });
        </script>
    </div>
</div>

