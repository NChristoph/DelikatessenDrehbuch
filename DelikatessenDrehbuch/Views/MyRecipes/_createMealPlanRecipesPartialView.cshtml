@using DelikatessenDrehbuch.StaticScripts
@model Recipes
@{
    var index = ViewData["Index"];
    
}





<div id="@Model.Id"
     
     style="max-width:fit-content">
     <div name="Data"
          data-Name="@Model.Name"
          data-description="@Model.Description"
          data-preperationTime="@Model.PreparationTime">
          
     </div>
   
    <div name="Recipes"
         title="@Model.Id"
         class="Bg-Cream">

        <div class="flexColumn flexJustifyContendCenter flexAlginItemCenter"
             style="max-width:max-content">
            @{
                var subPath = FrontendFunctions.CaseInsensitivePath(Model.ImagePath);

                var smallPath = subPath?.Replace(Environment.GetEnvironmentVariable("BigPic"),
                Environment.GetEnvironmentVariable("SmalPic"));

                <img style="width:180px;"
                     onload="if (window.innerWidth < 768) this.style.width='100px';"
                     src="@($"{smallPath}_small.webp")" />
            }


           
           

        </div>
       

    </div>
    


</div>



