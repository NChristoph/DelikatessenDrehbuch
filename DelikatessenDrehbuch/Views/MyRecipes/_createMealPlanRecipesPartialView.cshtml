@using DelikatessenDrehbuch.StaticScripts
@model Recipes
@{
    var index = (int)ViewData["Index"];
    
}

<div name="Recipes"
     data-index="@index"
     data-id="@Model.Id"
     style="max-width:100%"
     class="mt-1">
   
   
    <div class="Bg-Cream flexRow w-100">

        <div class="flexColumn flexJustifyContendCenter">
            @{
                var subPath = FrontendFunctions.CaseInsensitivePath(Model.ImagePath);

                var smallPath = subPath?.Replace(Environment.GetEnvironmentVariable("BigPic"),
                Environment.GetEnvironmentVariable("SmalPic"));

                <img style="width:180px;"
                     onload="if (window.innerWidth < 768) this.style.width='100px';"
                     src="@($"{smallPath}_small.webp")" />
            }

        </div>
        <div class="flexColumn flexJustifyContendSpaceBetween w-100"
             style="margin-left:10px">
            <div class="flexRow" style="height:56%">
                <span>@Model.Name</span>
            </div>
            <div class="flexRow flexAlginItemEnd">
                <span>@Model.PreparationTime min</span>
            </div>
            <div class="flexRow flexAlginItemEnd mobile-hidden ">
                <div class="dropdown mt-2 mb-2 w-100">
                    <button class="btn btn-secondary bgRed dropdown-toggle w-100"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        Beschreibung
                    </button>
                    <ul class="dropdown-menu p-1">
                        <li>@Model.Description</li>

                    </ul>
                </div>
            </div>

        </div>
       
      
    </div>
    <div class="flexRow mobile-aktive desktop-Hidden" style="height:max-content">
        <div class="dropdown mt-2 mb-2 w-100">
            <button class="btn btn-secondary bgRed dropdown-toggle w-100"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                Beschreibung
            </button>
            <ul class="dropdown-menu p-1">
                <li>@Model.Description</li>

            </ul>
        </div>
    </div>
    <hr/>
</div>



