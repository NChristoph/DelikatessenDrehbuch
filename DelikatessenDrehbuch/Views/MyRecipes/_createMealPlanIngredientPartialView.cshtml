@using DelikatessenDrehbuch.Services.Interfaces
@inject IIngredientService IIngredientService
@model List<IngredientHandlerModel>
@{
    int personCount = 1;
    if (ViewData["PersonCount"]!=null)
    {
         personCount = (int)ViewData["PersonCount"];
    }

}

@{
    var _ingredientHandlerService = IIngredientService;
    Model.RemoveAll(i => i.Ingredient.Name == "Salz" || i.Ingredient.Name == "Pfeffer");
    var combined = _ingredientHandlerService.CombineIngredienthanderModel(Model);
   
    var sortedList = combined.OrderBy(x => x.Quantity.Quantitys).Reverse();

    foreach (var ingredient in sortedList)
    {
        var value = ingredient.Quantity.Quantitys * personCount;
        var quantity = Math.Round(value, value < 1 ? 2 : 0);
        <div class="row mt-1 minWidth100">
            <div class="col minWidth30 mobieleFontSize"
                 style="white-space:normal;text-align:start">
                @ingredient.Ingredient.Name
            </div>
            <div class="col p-0 minWidth30 maxWidth30 mobieleFontSize">
                @quantity
                @ingredient.Measure.UnitOfMeasurement
            </div>

        </div>
    }



    <span class="mt-1">Salz und Pfeffer</span>
}