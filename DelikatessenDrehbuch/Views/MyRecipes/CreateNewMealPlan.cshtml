@using DelikatessenDrehbuch.Models
@model MealModel

<div class="flexRowToColumn minWidth100 mobieleWidth90 mobileItemCenter mt-5">



    <div class="flexcolumn maxWidth60 mobieleWidth90 flexJustifyContendCenter">

        @{
            int index = 0;
            foreach (var recipes in Model.Recipes)
            {
                index++;
                
                <span class="m-2 p-2">Tag @index</span>
                <div name="recipesContainer"
                     id="recipesContainer_@index">
                   
                    <div id="@recipes.Id"
                        class="mobieleWidth90 col m-3 Bg-Cream p-2">

                        @await Html.PartialAsync(
                             "~/Views/MyRecipes/_createMealPlanRecipesPartialView.cshtml",
                             recipes,
                             new ViewDataDictionary(ViewData) { { "Index", index } })
                    </div>
                    
                </div>

            }
        }

    </div>

    <div class="Bg-Cream flexColumn maxWidth30 mobieleWidth90 m-2 p-2">
        <span class="w-100"
              style="text-align:center">
            <strong>Einkaufliste :</strong>
        </span>
        <div id="ingredientPartialView"
             class="w-100">
            <partial model="@Model.Ingredients"
                     name="~/Views/MyRecipes/_createMealPlanIngredientPartialView.cshtml" />
        </div>

    </div>




</div>


<script>
    function CangeRecipes(button)
    {

        var recipeId = button.value;
        
        var index = button.getAttribute("data-index");
        var recipe = document.getElementById(recipeId);

        var ingredientList = document.getElementById("ingredientPartialView").innerHTML = "";
      
        recipe.remove();
         
        var recipesIds = GetRecipesIdsList().join(";");
       
        

        $.get("/CreateNewMealPlan/LoadRecipesPartialView", { recipesIds: recipesIds,recipeId:recipeId ,index:index }, function (html) {
         $("#recipesContainer_" + index).html(html);
        });

        ReloadIngredientList();

    }

    function GetRecipesIdsList(){

         var recipesElements = document.getElementsByName("Recipes");

         var recipesIdsList = Array.from(recipesElements).map(function (el) {
              return el.title;
        });

        return recipesIdsList;
    }

    function ReloadIngredientList()
    {
        var recipesIdsList = GetRecipesIdsList();


       $("#ingredientPartialView").load("/CreateNewMealPlan/LoadIngredientPartialView?recipesIds="+recipesIdsList.join(";"));

    }
</script>