@using DelikatessenDrehbuch.Models
@using DelikatessenDrehbuch.StaticScripts
@model List<PersonalMealPlanRecipeModel>
@{
    var personCount = (int)ViewData["PersonCount"];

}

<div class="flexRowToColumn minWidth100 mobieleWidth90 mobileItemCenter mt-5">

    <div class="flexcolumn maxWidth60 mobieleWidth90 flexJustifyContendCenter"
         style="min-width:55%">
        <input type="number" id="personCount" value="@personCount" hidden />
        @{
            int index = 0;
            foreach (var recipes in Model)
            {
                index++;
                recipes.Index = index;

                <div name="RecipesContainer" class="day-item" data-day="@index">

                    <span class="m-2 p-2 day-label">Tag @index</span>
                    <div class="ms-2 flexRow justify-content-center w-100 mt-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="moveDayUp(this)">
                            ▲ Rezept nach oben verschieben
                        </button>
                    </div>

                    <ul class="flexColumn Bg-Cream p-1 mt-2"
                        style="list-style-type:none;min-width:49%">

                        @if (!FrontendFunctions.CheckCategory(recipes.Recipes.Category))
                        {
                            <li class="mt-1 flexColumn">
                                <div class="flexRow w-100">
                                    <div id="appetizer_@index" class="w-100"></div>
                                    <a id="appetizerDeleteButton_@index"
                                       onclick="RemoveItem('appetizer_@index,appetizerName_@index,appetizerPreperationTime_@index,appetizerDiscription_@index','appetizerDeleteButton_@index')"
                                       hidden>
                                        <i class="bi bi-trash3"></i> Löschen
                                    </a>
                                </div>

                            </li>

                        }

                        <li class="flexColumn flexAlginItemStart w-100">
                            <div class="flexRow w-100">
                                <div name="recipesContainer"
                                     id="recipesContainer_@index"
                                     style="width:100%">
                                    @await Html.PartialAsync(
                                    "~/Views/MyRecipes/_createMealPlanRecipesPartialView.cshtml",
                                                        recipes.Recipes,
                                                        new ViewDataDictionary(ViewData) { { "Index", index }
                                                        })
                        </div>

                    </div>

                </li>

                @if (!FrontendFunctions.CheckCategory(recipes.Recipes.Category))
                        {
                            <li class="flexColumn">
                                <div class="flexRow w-100">
                                    <div id="dessert_@index" class="w-100"></div>
                                    <a id="dessertDeleteButton_@index"
                                       onclick="RemoveItem('dessert_@index,dessertName_@index,dessertPreperationTime_@index,dessertDiscription_@index','dessertDeleteButton_@index')"
                                       hidden>
                                        <i class="bi bi-trash3"></i> Löschen
                                    </a>
                                </div>
                                <div class="flexRow w-100 mobieleWidth90" id="dessertDiscription_@index"></div>
                            </li>
                        }
                    </ul>

                    <span class="w-100" style="text-align:center">
                        Hinzufügen oder ändern ?
                    </span>
                    <ul class="flexRow flexAlginItemCenter flexJustifyContendSpaceBetween w-100 m-0 p-0"
                        style="list-style-type:none">
                        <li>
                            <button data-index="@index"
                                    data-category="Vorspeise"
                                    onclick="ChangeMealPlanRecipes(this,'appetizer_')"
                                    class="bgRed Border-Gold"
                                    style="margin-left:auto;max-width:max-content;color:white;border-radius:0.5rem;border-color:white">
                                Vorspeise
                            </button>
                        </li>
                        <li>
                            <button data-index="@index"
                                    data-category="@recipes.Recipes.Category"
                                    value="@recipes.Id"
                                    onclick="ChangeMealPlanRecipes(this,'recipesContainer_')"
                                    class="bgRed Border-Gold"
                                    style="margin-left:auto;max-width:max-content;color:white;border-radius:0.5rem;border-color:white">
                                Hauptspeise
                            </button>
                        </li>
                        <li>
                            <button data-index="@index"
                                    data-category="Dessert"
                                    onclick="ChangeMealPlanRecipes(this,'dessert_')"
                                    class="bgRed Border-Gold"
                                    style="margin-left:auto;max-width:max-content;color:white;border-radius:0.5rem;border-color:white">
                                Dessert
                            </button>
                        </li>
                    </ul>
                    <div class="ms-2 flexRow justify-content-center w-100 mt-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="moveDayDown(this)">
                            ▼ Rezept nach unten verschieben
                        </button>
                    </div>
                    <hr />

                </div>
            }
        }

    </div>

    <div class="Bg-Cream flexColumn maxWidth30 minWidth30 mobieleWidth90 m-2 p-2">
        <span class="w-100" style="text-align:center">
            <strong>Einkaufliste :</strong>
        </span>
        <div id="ingredientPartialView" class="w-100">
        </div>
    </div>
</div>

<a typeof="button" 
    class="btn bgRed" 
    style="color:white" 
    onclick="CreatedMealPlan()">Hier Essensplan Erstellen !</a>

@section Scripts {
    <script src="/js/CreateNewMealPlan.js" asp-append-version="true"></script>
}
