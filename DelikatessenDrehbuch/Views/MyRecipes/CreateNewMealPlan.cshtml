@model List<Recipes>

<div class="flexColumn minWidth100 mobieleWidth90 flexAlginItemCenter mt-5">



    <div class="flexcolumn minWidth100 flexJustifyContendCenter">
        @{
            int index = 0;
            foreach (var recipes in Model)
            {
                index++;

                <div class="mobieleWidth90 col m-3 Bg-Cream p-2">
                    <span class="m-2 p-2">Tag @index</span>

                    <div class="row m-1">
                    </div>
                    <hr />
                    <div class="flexRowToColumn m-1">
                        <div class="flexColumn flexJustifyContendCenter m-2 mobieleWidth100 flexAlginItemCenter"
                             style="max-width:max-content">
                            <img style="width:150px;"
                                 onload="if (window.innerWidth < 768) this.style.width='90%';"
                                 src="@recipes.ImagePath" />
                        </div>
                        <div class="col">
                            <div class="d-none d-md-block"><strong>@recipes.Name</strong></div>
                            <div class="d-none d-md-block">@recipes.Description</div>
                            <div class="d-block d-md-none">
                                <button class="btn btn-sm bgRed Border-Gold text-white mb-2 mobieleWidth100 flexAlginItemCenter"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#descCollapse_@recipes.Id">
                                    Beschreibung anzeigen
                                </button>
                                <div class="mobieleWidth100"
                                     style="text-align:center">
                                    <strong>@recipes.Name</strong>
                                </div>
                                <div class="collapse" id="descCollapse_@recipes.Id">
                                    <div class="card card-body">
                                        @recipes.Description
                                    </div>
                                </div>
                            </div>


                            <div class="flexRow flexJustifyContendSpaceBetween mt-2">
                                <div class="col">
                                    <button class="bgRed Border-Gold"
                                            style="margin-left:auto;max-width:max-content;color:white;border-radius:0.5rem;border-color:white">
                                        Vorspeise hinzufügen
                                    </button>
                                </div>
                                <div class="col">
                                    <button class="bgRed Border-Gold"
                                            style="margin-left:auto;max-width:max-content;color:white;border-radius:0.5rem;border-color:white">
                                        Dessert hinzufügen
                                    </button>
                                </div>
                                <div class="col">
                                    <button class="bgRed"
                                            style="margin-left:auto;max-width:max-content;color:white;border-radius:0.5rem;border-color:white">
                                        Rezept Ändern
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>
                    <hr />
                    <div class="row m-1">
                    </div>
                </div>
                <hr />

            }
        }

    </div>



</div>
