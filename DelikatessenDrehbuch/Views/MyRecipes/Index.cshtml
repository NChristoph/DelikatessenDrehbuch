@using Microsoft.AspNetCore.Identity
@model MyRecipesModel
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Mein Bereich";
}

<style>
    /* mobile Layout fix: Checkboxen & Flex-Container */
    .filter-card {
        border-radius: .5rem;
    }

    .filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        justify-content: space-around;
        width: 100%;
    }

        .filter-row .form-check {
            min-width: 140px;
            margin-bottom: .25rem;
        }



    #IngredientTable td {
        vertical-align: top;
    }

    .form-check-input {
        transform: scale(1.2);
        margin-right: .35rem;
    }

    /* Mobil: Tabs nicht umbrechen lassen */
    @@media (max-width: 576px) {
        .nav-tabs .nav-link {
            font-size: 13px;
            padding: .4rem .6rem;
        }
    }
</style>

<div class="col">
    <div class="flexRow justify-content-center flexAlginItemCenter minWidth100 mobieleWidth90 bg-white mt-5">
        <ul class="nav nav-tabs m-2" id="recipeTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link text-black active"
                        id="Myrecipes-tab"
                        onclick="loadRecipesILike()"
                        data-bs-toggle="tab"
                        data-bs-target="#myRecipes"
                        type="button" role="tab"
                        style="font-size:14px;">
                    Favoriten
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link text-black"
                        id="Menue-tab"
                        onclick="loadMealPlanView()"
                        data-bs-toggle="tab"
                        data-bs-target="#Menue"
                        type="button" role="tab"
                        style="font-size:14px;">
                    Fertige Menüs
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link text-black"
                        id="MenuePlan-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#MenuePlan"
                        type="button" role="tab"
                        style="font-size:14px;">
                    Wochenplan erstellen
                </button>
            </li>
        </ul>
    </div>
</div>

<div class="tab-content mt-3 p-3" id="MyRecipesTabconted" style="height:min-content">
    <div class="tab-pane fade show active Bg-Cream" id="myRecipes" role="tabpanel" style="padding:2%">
        <div id="Favoriten"></div>
    </div>

    <div class="tab-pane fade Bg-Cream" id="Menue" role="tabpanel" style="padding:2%">
        <div id="Menue"></div>
    </div>

    @if (User.IsInRole("PremiumUser") || User.Identity.Name?.ToLower() == "free.88@mailxl.at")
    {
        <div id="MenuePlan" class="tab-pane fade shadow-sm flex justify-content-center" role="tabpanel" style="padding:2% ">
            <form asp-controller="CreateNewMealPlan" asp-action="Index" method="post">
                @Html.AntiForgeryToken()

                <div class="flexColumn bg-white" style="min-width:100%">

                    <!-- VEG-Bereich -->
                    <div class="flexColumn w-100 filter-card border mb-2 shadow-sm p-2">
                        <h3 class="mb-2">Ich möchte nur:</h3>

                        <div class="filter-row" aria-label="veg-only">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="checkVegan" name="Vegan" value="true">
                                <input type="hidden" name="Vegan" value="false" />
                                <label class="form-check-label" for="checkVegan">Vegan</label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="checkVegetarisch" name="Vegetarisch" value="true">
                                <input type="hidden" name="Vegetarisch" value="false" />
                                <label class="form-check-label" for="checkVegetarisch">Vegetarisch</label>
                            </div>
                        </div>

                        <hr class="my-2" />

                        <!-- No*-Filter -->
                        <div class="filter-row" aria-label="veg-excludes">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="checkNoVegan" name="NoVegan" value="true">
                                <input type="hidden" name="NoVegan" value="false" />
                                <label class="form-check-label" for="checkNoVegan">Vegan ausschließen</label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="checkNoVegetarisch" name="NoVegetarisch" value="true">
                                <input type="hidden" name="NoVegetarisch" value="false" />
                                <label class="form-check-label" for="checkNoVegetarisch">Vegetarisch ausschließen</label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="checkNoPork" name="NoPork" value="true">
                                <input type="hidden" name="NoPork" value="false" />
                                <label class="form-check-label" for="checkNoPork">Kein Schwein</label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="checkNoFish" name="NoFish" value="true">
                                <input type="hidden" name="NoFish" value="false" />
                                <label class="form-check-label" for="checkNoFish">Kein Fisch</label>
                            </div>
                        </div>
                    </div>

                    <!-- Kochdauer -->
                    <div class="flexColumn flexAlginItemCenter mb-2 filter-card border shadow-sm p-2">
                        <h3 class="mb-2">Kochdauer (optional):</h3>
                        <div class="filter-row">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="checkFirstTime" name="CookingTimeOne" value="true">
                                <input type="hidden" name="CookingTimeOne" value="false" />
                                <label class="form-check-label" for="checkFirstTime">25–45 min</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="checkSecondTime" name="CookingTimeTwo" value="true">
                                <input type="hidden" name="CookingTimeTwo" value="false" />
                                <label class="form-check-label" for="checkSecondTime">45 min +</label>
                            </div>
                        </div>
                    </div>

                    <!-- Tage / Personen -->
                    <div class="flexRowToColumn flexJustifyContendCenter w-100 filter-card border shadow-sm p-2">
                        <span class="flexRow flexAlginItemCenter w-100 m-2">
                            Plan für :
                            <input class="form-control form-control-sm m-2" type="number" id="dayCount" name="DayCount" style="width:80px" />
                            Tage erstellen.
                        </span>
                        <span class="flexRow flexAlginItemCenter w-100 m-2">
                            Plan für :
                            <input class="form-control form-control-sm m-2" type="number" id="personCount" name="PersonCount" style="width:80px" />
                            Personen erstellen.
                        </span>
                    </div>

                    <!-- Zutaten-Tabelle -->

                    <table id="IngredientTable" class="display nowrap bg-white table table-sm" style="width:100%">
                        <thead class="bg-white">
                            <tr class="bg-white">
                                <th data-priority="1">Zutat</th>
                                <th data-priority="2">Optionen</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ingredient in Model.IngredientList)
                            {
                                <tr>
                                    <td style="max-width:45%;text-wrap:auto">@ingredient.Name</td>
                                    <td>
                                        <div class="form-check mb-2">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   onchange="CreateIngredient(this)"
                                                   value="@ingredient.Id"
                                                   data-name="@ingredient.Name"
                                                   id="Ingredient_@ingredient.Id" />

                                            <label class="form-check-label">Zutat ausschließen</label>
                                        </div>

                                        <hr class="my-1" />

                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   onchange="CreateHaveAtHome(this)"
                                                   value="@ingredient.Id"
                                                   data-name="@ingredient.Name"
                                                   
                                                   id="HaveAtHome_@ingredient.Id" />
                                            <label class="form-check-label">Habe ich zuhause</label>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="flexRowToColumn flexJustifyContendSpaceBetween flexAlginItemCenter flexJustifyContendCenter">
                        <div class="flexColumn mt-2 mobieleWidth90 flexAlginItemCenter shadow-sm border-1"
                             style="min-width:45%;background-color:#FFCACA;border:1px,solid;border-radius:0.5rem">
                            <h3>Das mag ich nicht:</h3>
                            <hr style="width:90%" />
                            <div class="flexColumn flexAlginItemCenter"
                                 id="Ingredients"></div>
                        </div>
                        <div class="flexColumn mt-2 mobieleWidth90 flexAlginItemCenter shadow-sm"
                             style="min-width:45%;background-color:#CCEED5;border:1px,solid;border-radius:0.5rem">
                            <h3>Hab ich Zuhause:</h3>
                            <hr style="width:90%" />
                            <div class="flexColumn flexAlginItemCenter"
                                 id="HaveAtHome"></div>
                        </div>


                    </div>


                    <button class="btn bgRed Border-Gold mt-2"
                            type="submit"
                            style="max-width:fit-content;color:white;margin-left:auto">
                        Essensplan Erstellen
                    </button>
                </div>
            </form>
        </div>
    }
</div>

@section Scripts {
    <script>


        $(document).ready(function () {
            // Favoriten initial laden
            $("#Favoriten").load("/MyRecipes/LoadRecipesILike");

            // DataTable init (responsive + no horizontal overflow)
            new DataTable('#IngredientTable', {
                responsive: true,
                pageLength: 10,
                lengthChange: false,
                ordering: false
            });
        });

               function CreateIngredient(html) {
            var checkbox = document.getElementById('HaveAtHome_' + html.value);
            if (checkbox && checkbox.checked) {
                checkbox.checked = false;
                document.getElementById('divHaveAtHome_' + html.value)?.remove();
            }


                 const existingSpan = document.getElementById('spanIngredient_' + html.value);
