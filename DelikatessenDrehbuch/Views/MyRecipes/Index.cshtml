    </div> *@

    </div>


</div>

<div class="tab-content mt-3" id="MyRecipesTabconted" style="height:min-content">
    <div class="tab-pane fade show active Bg-Cream" id="myRecipes" role="tabpanel" style="padding:2%">
        <div id="Favoriten"></div>

    </div>
    <div class="tab-pane fade Bg-Cream" id="Menue" role="tabpanel" style="padding:2%">
        <div id="Menue"></div>

    </div>
    @if (User.IsInRole("PremiumUser"))
    {
        <div id="MenuePlan"
             class="tab-pane fade Bg-Cream"
             role="tabpanel"
             style="padding:2%">

           

            <span>Wählen sie die dienge aus die sie Essen !</span>

            <div class="flexRowToColumn">
                <form asp-controller="CreateNewMealPlan"
                      asp-action="CreateNewMealPlan" 
                      class="flexRowToColumn flexWrap"
                      style="min-width:100%">

                    <span class="flexRow flexAlginItemCenter w-100 m-2">
                        Menü für :
                        <input class=" m-2"
                               type="number"
                               name="dayCount"
                               style="width:55px" />
                        Tage erstellen.

                    </span>

                    @{
                        int index = 0;
                        foreach (var query in Model)
                        {
                            index++;
                            <div class="form-check m-2"
                                 style="max-width:fit-content">
                                <input class="form-check-input"
                                       checked
                                       name="queryList"
                                       type="checkbox"
                                       value="@query"
                                       id="filterCheckbox@{index.ToString();}">

                                <label class="form-check-label"
                                       for="filterCheckbox@{index.ToString();}">
                                    @query
                                </label>
                            </div>

                        }


                    }

                    <button class="btn bgRed Border-Gold"
                            type="submit"
                            style="max-width:fit-content;color:white">
                        Essensplan Erstellen
                    </button>

                </form>
            </div>



        </div>
    }


</div>


@section Scripts {
    <script>

        function loadAboPage() {
            $('#PartailaView').load("MyRecipes/PremiumUserPage")

        }

        function loadMealPlanView() {
            $('#Menue').load("MyRecipes/MealPlanView")

        }

        function loadRecipesILike() {

            $('#Favoriten').load("MyRecipes/LoadRecipesILike")
        }



        function loadPremiumPartialView() {
            $('#PartailaView').load("MyRecipes/Premium")
        }


    </script>
}


