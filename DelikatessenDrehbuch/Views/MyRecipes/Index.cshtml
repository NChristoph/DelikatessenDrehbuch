            hidden.name = "IngredientIds";
            hidden.value = html.value;
            hidden.id = 'hiddenIngredient_' + html.value;

            element.innerText = dataName;

            $("#Ingredients").append(element);
            $("#Ingredients").append(hidden);
        }


