@model MealModel
@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
<div class="flexRowToColumn minWidth100 mobieleWidth100">

    <div class="flexColumn minWidth50 maxWidth50 mobieleWidth90 flexJustifyContendCenter  mobileCenter p-3">
        @{
            foreach (var recipes in Model.Recipes)
            {
                <a asp-route-id="@recipes.Id" asp-controller="SelectedRecipe" asp-action="Index" class="row p-1" style="text-decoration:none;color:black">
                    <div class="flexColumn flexAlginItemCenter minWidth40 maxWidth40 mobieleWidth100">
                        <img src="@recipes.ImagePath" class="mobieleWidth90" alt="@recipes.Description" width="150" />
                    </div>
                    <div class="flexColumn flexJustifyContendCenter flexAlginItemCenter mobieleWidth100 minWidth50 maxWidth50">
                        <span style="text-align:center">@recipes.Name</span>

                    </div>

                </a>

                <hr style="width:90%" class="flexAlginSelfCenter" />

            }
        }
    </div>
    <div class="flexColumn minWidth50 maxWidth50 mobieleWidth90 mobileCenter Bg-Cream p-3">
        <div class="flexRow flexJustifyContendCenter ">
            <h3 style="font-family:'Lucida Handwriting';color:#D4AF37">Einkauf's Liste :</h3>


        </div>
        @{
            foreach (var ingredient in Model.Ingredients)
            {
                <div class="row p-1 mobieleWidth100 mt-1 minWidth100">
                    <div class="col minWidth30 maxWidth60" style="white-space:normal">@ingredient.Ingredient.Name</div>
                    <div class="col minWidth20 maxWidth20">@ingredient.Quantity.Quantitys</div>
                    <div class="col minWidth10 maxWidth10">@ingredient.Measure.UnitOfMeasurement</div>

                </div>
            }
        }
    </div>



</div>


<div class="minWidth100 mobieleWidth90 p-2 mt-3 Border-Gold ">
    @{
        int maxChars = 1;
        if (Model.MealPlan.Preperation.ToString().Length < 400)
        {
            maxChars = 400;
        }
        // Beispiel: Zeige die ersten 200 Zeichen

        // Der vollständige Text der Zubereitung
        string halfPreperation = Model.MealPlan.Preperation.Substring(0, maxChars) + "<br><br>.....Auf Premium upgraden, um die vollständige Zubereitung zu sehen.<br><br>Premium kommt bald.<br><br>Bis dahin können Sie die Rezepte einfach anklicken und der Reihe nach machen";


        if (User.IsInRole("PremiumUser"))
        {
            <p class=" p-4"><strong>Menü Zubereitung:</strong><br /><br />@Html.Raw(@Model.MealPlan.Preperation)</p>
        }
        else
        {
            <hr />
            //TODO:PremiumAboAbschluss ermöglichen
            <p class=" p-4"><strong>Menü Zubereitung:</strong><br /><br />@Html.Raw(halfPreperation)</p>
        }

    }

</div>
<div class="flexColumn">

    <span class="m-1 flexAlginSelfCenter">Nährstoffe je Hundert gramm:</span>

    <div class="card-group flexJustifyContendSpaceAround flex flexWrap mobileCenter ">
        @{
            var group = Model.NutrientsHandlers.GroupBy(x => x.IngredientNutrientHandler.Ingredient.Name).ToList();

            foreach (var nurient in group)
            {
                string effect = nurient.Select(x => x.IngredientNutrientHandler.Effect).First();
                <div class="card  Border-Gold minWidth30  mobieleWidth90 mt-3 m-2">
                    <div class="card-header Bg-Cream" style="text-align:center;"><strong>@nurient.Key</strong></div>
                    <div class="card-body p-2 flexColumn">
                        @foreach (var ingredient in nurient)
                        {
                            
                            <div class="flexRow flexJustifyContendSpaceBetween flexWrap Bg-Cream mt-2 p-1 Border-Gold">
                                <span class="col minWidth50 maxWidth50">@ingredient.Nutrient.Name</span>
                                <span class="col minWidth20 maxWidth20" style="text-align:end">@ingredient.Quantity.Quantitys</span>
                                <span class="col minWidth20 maxWidth20">@ingredient.Measure.UnitOfMeasurement</span>

                            </div>
                        }
                    </div>
                    <div class="card-footer Bg-Cream">@effect</div>
                </div>





            }


        }
    </div>



</div>
