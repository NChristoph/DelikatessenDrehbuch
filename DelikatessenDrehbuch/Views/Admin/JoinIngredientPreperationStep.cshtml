@model DelikatessenDrehbuch.Models.JoinIngredientPreparationStepViewModel
@using System.Text.Json

@{
    var stepBindings = Model.ExistingJoins
        .Where(x => x.Preperation != null && x.Ingredient != null)
        .GroupBy(x => x.Preperation.Id)
        .ToDictionary(
            group => group.Key,
            group => group
                .Select(x => new { id = x.Ingredient!.Id, name = x.Ingredient.Name_DE })
                .Distinct()
                .OrderBy(x => x.name)
                .ToList());

    var ingredientGroups = Model.Ingredients
        .Where(x => x.Group != null && !string.IsNullOrWhiteSpace(x.Group.Name))
        .GroupBy(x => x.Group!.Name)
        .OrderBy(x => x.Key)
        .ToDictionary(
            group => group.Key,
            group => group
                .Select(x => new { id = x.Id, name = x.Name_DE })
                .OrderBy(x => x.name)
                .ToList());
}

<div class="recipe-card minWidth90 mobieleWidth90 mx-auto" style="border-left-color: #dc3545;">
    <h3 class="section-title" style="color: #dc3545;">
        <i class="fa-solid fa-link me-2"></i>Zutaten mit Zubereitungsschritt verknüpfen
    </h3>

    <p class="text-muted">Schritte auswählen, Zutaten markieren und gemeinsam speichern.</p>

    <form asp-action="SaveJoinIngredientPreperationStep" asp-controller="Admin" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" id="selectedStepId" name="selectedStepId" />
        <input type="hidden" id="selectedStepIds" name="selectedStepIds" />
        <input type="hidden" id="selectedIngredientIds" name="selectedIngredientIds" />

        <div class="row g-3">
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header fw-bold">Zubereitungsschritte</div>
                    <div class="card-body">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="onlyUnboundSteps" />
                            <label class="form-check-label" for="onlyUnboundSteps">
                                Nur Schritte ohne Zutaten-Verknüpfung anzeigen
                            </label>
                        </div>
                        <table id="prepStepsTable" class="table table-sm table-hover w-100">
                            <thead>
                                <tr><th>ID</th><th>Text</th><th>Aktion</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var step in Model.PreparationSteps)
                                {
                                    var hasBindings = stepBindings.ContainsKey(step.Id);
                                    <tr>
                                        <td data-has-binding="@hasBindings.ToString().ToLowerInvariant()">@step.Id</td>
                                        <td>@step.Step_DE</td>
                                        <td>
                                            <button type="button" class="btn btn-outline-primary btn-sm step-toggle-btn" data-step-id="@step.Id" onclick="toggleStep(@step.Id, '@Html.Raw((step.Step_DE ?? string.Empty).Replace("'", "\\'"))')">Hinzufügen</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header fw-bold">Zutaten</div>
                    <div class="card-body">
                        <div class="row g-2 mb-3 align-items-end">
                            <div class="col-md-8">
                                <label for="ingredientGroupSelect" class="form-label mb-1">Zutatengruppe auswählen</label>
                                <select id="ingredientGroupSelect" class="form-select form-select-sm">
                                    <option value="">Bitte Gruppe wählen…</option>
                                    @foreach (var group in ingredientGroups)
                                    {
                                        <option value="@group.Key">@group.Key (@group.Value.Count)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4 d-grid gap-2">
                                <button type="button" class="btn btn-outline-success btn-sm" onclick="addGroupIngredients()">Gruppe hinzufügen</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeGroupIngredients()">Gruppe entfernen</button>
                            </div>
                        </div>

                        <table id="ingredientsTable" class="table table-sm table-hover w-100">
                            <thead>
                                <tr><th>ID</th><th>Name</th><th>Aktion</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var ingredient in Model.Ingredients)
                                {
                                    <tr>
                                        <td>@ingredient.Id</td>
                                        <td>@ingredient.Name_DE</td>
                                        <td>
                                            <button type="button" class="btn btn-outline-success btn-sm ingredient-toggle-btn" data-ingredient-id="@ingredient.Id" onclick="toggleIngredient(@ingredient.Id, '@Html.Raw((ingredient.Name_DE ?? string.Empty).Replace("'", "\\'"))')">Hinzufügen</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-3 shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold">Ausgewählte Zubereitungsschritte</h5>
                <ul id="selectedStepPreview" class="list-group list-group-flush"><li class="list-group-item text-muted">Noch kein Schritt ausgewählt.</li></ul>
                <div id="selectedStepBindingInfo" class="small text-muted mt-2">Keine Schritte ausgewählt.</div>
                <hr />
                <h5 class="fw-bold">Ausgewählte Zutaten</h5>
                <ul id="selectedIngredientsPreview" class="list-group list-group-flush"></ul>
            </div>
        </div>

        <button type="submit" class="btn bgRed Border-Gold mt-3" style="color:white">Verknüpfung speichern</button>
    </form>

    <div class="card mt-4 shadow-sm">
        <div class="card-header fw-bold">Bereits gespeicherte Verknüpfungen</div>
        <div class="card-body">
            <table id="existingJoinTable" class="table table-sm table-striped w-100">
                <thead>
                    <tr><th>Schritt</th><th>Zutat</th></tr>
                </thead>
                <tbody>
                    @foreach (var join in Model.ExistingJoins)
                    {
                        <tr>
                            <td>@join.Preperation?.Step_DE</td>
                            <td>@join.Ingredient?.Name_DE</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    const selectedIngredients = new Map();
    const selectedSteps = new Map();
    const stepBindings = @Html.Raw(JsonSerializer.Serialize(stepBindings));
    const ingredientGroups = @Html.Raw(JsonSerializer.Serialize(ingredientGroups));
    const onlyUnboundStepsStorageKey = 'join-ingredient-only-unbound-steps';

    function updateStepToggleButtons() {
        document.querySelectorAll('.step-toggle-btn').forEach(button => {
            const stepId = Number(button.dataset.stepId);
            const isSelected = selectedSteps.has(stepId);
            button.classList.toggle('btn-outline-primary', !isSelected);
            button.classList.toggle('btn-outline-danger', isSelected);
            button.textContent = isSelected ? 'Entfernen' : 'Hinzufügen';
        });
    }

    function updateSelectedStepsPreview() {
        const selectedStepIds = Array.from(selectedSteps.keys());
        document.getElementById('selectedStepIds').value = selectedStepIds.join(',');
        document.getElementById('selectedStepId').value = selectedStepIds[0] ?? '';

        const preview = document.getElementById('selectedStepPreview');
        const bindingInfo = document.getElementById('selectedStepBindingInfo');
        preview.innerHTML = '';

        if (selectedSteps.size === 0) {
            preview.innerHTML = '<li class="list-group-item text-muted">Noch kein Schritt ausgewählt.</li>';
            bindingInfo.className = 'small text-muted mt-2';
            bindingInfo.textContent = 'Keine Schritte ausgewählt.';
            updateStepToggleButtons();
            return;
        }

        selectedSteps.forEach((stepText, stepId) => {
            const li = document.createElement('li');
            li.className = 'list-group-item';
            li.textContent = `${stepId}: ${stepText}`;
            preview.appendChild(li);
        });

        const stepsWithoutBindings = selectedStepIds.filter(stepId => (stepBindings[stepId] ?? []).length === 0);
        if (stepsWithoutBindings.length === selectedStepIds.length) {
            bindingInfo.className = 'small text-muted mt-2';
            bindingInfo.textContent = 'Für die ausgewählten Schritte gibt es noch keine gespeicherten Zutaten-Verknüpfungen.';
        } else {
            bindingInfo.className = 'small text-success mt-2';
            bindingInfo.textContent = 'Bei erneutem Speichern werden bestehende Verknüpfungen der gewählten Schritte ersetzt.';
        }

        updateStepToggleButtons();
    }

    function toggleStep(stepId, stepText) {
        if (selectedSteps.has(stepId)) {
            selectedSteps.delete(stepId);
        } else {
            selectedSteps.set(stepId, stepText);
        }

        updateSelectedStepsPreview();
    }

    function updateIngredientToggleButtons() {
        document.querySelectorAll('.ingredient-toggle-btn').forEach(button => {
            const ingredientId = Number(button.dataset.ingredientId);
            const isSelected = selectedIngredients.has(ingredientId);
            button.classList.toggle('btn-outline-success', !isSelected);
            button.classList.toggle('btn-outline-danger', isSelected);
            button.textContent = isSelected ? 'Entfernen' : 'Hinzufügen';
        });
    }

    function removeSelectedIngredient(ingredientId) {
        selectedIngredients.delete(Number(ingredientId));
        updateSelectedIngredientsPreview();
    }

    function updateSelectedIngredientsPreview() {
        document.getElementById('selectedIngredientIds').value = Array.from(selectedIngredients.keys()).join(',');

        const preview = document.getElementById('selectedIngredientsPreview');
        preview.innerHTML = '';

        if (selectedIngredients.size === 0) {
            preview.innerHTML = '<li class="list-group-item text-muted">Noch keine Zutaten ausgewählt.</li>';
            updateIngredientToggleButtons();
            return;
        }

        selectedIngredients.forEach((name, id) => {
            const li = document.createElement('li');
            li.className = 'list-group-item d-flex justify-content-between align-items-center';
            li.innerHTML = `<span>${id}: ${name}</span><button type="button" class="btn btn-outline-danger btn-sm" onclick="removeSelectedIngredient(${id})">Entfernen</button>`;
            preview.appendChild(li);
        });

        updateIngredientToggleButtons();
    }

    function toggleIngredient(ingredientId, ingredientName) {
        if (selectedIngredients.has(ingredientId)) {
            selectedIngredients.delete(ingredientId);
        } else {
            selectedIngredients.set(ingredientId, ingredientName);
        }

        updateSelectedIngredientsPreview();
    }

    function addGroupIngredients() {
        const selectedGroupName = document.getElementById('ingredientGroupSelect').value;
        if (!selectedGroupName) {
            return;
        }

        const ingredients = ingredientGroups[selectedGroupName] ?? [];
        ingredients.forEach(ingredient => {
            selectedIngredients.set(ingredient.id, ingredient.name);
        });

        updateSelectedIngredientsPreview();
    }

    function removeGroupIngredients() {
        const selectedGroupName = document.getElementById('ingredientGroupSelect').value;
        if (!selectedGroupName) {
            return;
        }

        const ingredients = ingredientGroups[selectedGroupName] ?? [];
        ingredients.forEach(ingredient => {
            selectedIngredients.delete(ingredient.id);
        });

        updateSelectedIngredientsPreview();
    }

    $(document).ready(function () {
        const onlyUnboundStepsToggle = document.getElementById('onlyUnboundSteps');
        const storedOnlyUnboundValue = localStorage.getItem(onlyUnboundStepsStorageKey);
        if (storedOnlyUnboundValue !== null) {
            onlyUnboundStepsToggle.checked = storedOnlyUnboundValue === 'true';
        }

        const prepStepsTable = $('#prepStepsTable').DataTable({ pageLength: 8, lengthChange: false, info: false });
        $('#ingredientsTable').DataTable({ pageLength: 8, lengthChange: false, info: false });
        $('#existingJoinTable').DataTable({ pageLength: 8, lengthChange: false, info: false });

        const normalizeDataTablePagingButtons = () => {
            document.querySelectorAll('#prepStepsTable_wrapper .dt-paging-button, #prepStepsTable_wrapper .paginate_button').forEach(button => {
                button.setAttribute('type', 'button');
            });
        };

        $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
            if (settings.nTable.id !== 'prepStepsTable') {
                return true;
            }

            if (!onlyUnboundStepsToggle.checked) {
                return true;
            }

            const rowNode = settings.aoData[dataIndex]?.nTr;
            const hasBinding = rowNode?.querySelector('td[data-has-binding]')?.dataset.hasBinding === 'true';

            return !hasBinding;
        });

        const applyOnlyUnboundStepsFilter = () => {
            localStorage.setItem(onlyUnboundStepsStorageKey, onlyUnboundStepsToggle.checked ? 'true' : 'false');
            prepStepsTable.draw();
            normalizeDataTablePagingButtons();
        };

        onlyUnboundStepsToggle.addEventListener('change', applyOnlyUnboundStepsFilter);

        $('#prepStepsTable').on('draw.dt', function () {
            normalizeDataTablePagingButtons();
        });

        document.querySelector('#prepStepsTable_wrapper')?.addEventListener('click', function (event) {
            const pagingButton = event.target.closest('.dt-paging-button, .paginate_button');
            if (!pagingButton) {
                return;
            }

            event.preventDefault();
            event.stopPropagation();
        });

        applyOnlyUnboundStepsFilter();
        updateSelectedStepsPreview();
        updateSelectedIngredientsPreview();
    });
</script>
