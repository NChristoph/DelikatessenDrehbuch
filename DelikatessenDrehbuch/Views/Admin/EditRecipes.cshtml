                                    </button>
                                    <button type="button" class="btn btn-outline-info btn-sm rounded-pill equipment-filter-btn" data-equipment="3">
                                        <i class="fa-solid fa-bowl-food me-1"></i>Topf
                                    </button>
                                    <button type="button" class="btn btn-outline-success btn-sm rounded-pill equipment-filter-btn" data-equipment="4">
                                        <i class="fa-solid fa-fire me-1"></i>Bräter
                                    </button>
                                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill equipment-filter-btn" data-equipment="5">
                                        <i class="fa-solid fa-kitchen-set me-1"></i>Kochfeld
                                    </button>
                                </div>
                                <div id="sandboxUnboundStepCandidates" class="d-flex flex-column gap-2">
                                    <div class="text-muted small">Ungebundene Schritte werden hier angezeigt.</div>
                                </div>
                            </div>
