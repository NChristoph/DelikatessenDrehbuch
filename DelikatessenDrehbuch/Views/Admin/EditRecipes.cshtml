@model EditRecipesModel
@using Newtonsoft.Json
@using System.Linq

@{
    var stepIngredientBindings = ViewData["StepIngredientBindings"] as Dictionary<int, List<int>>
        ?? new Dictionary<int, List<int>>();

    var stepCatalogJson = JsonConvert.SerializeObject(
        Model.RecipePreperationSteps?.Select(step => new {
            id = step.Id,
            step_DE = step.Step_DE,
            phase = step.Phase,
            equipment = step.Equipment,
            ingredientIds = stepIngredientBindings.ContainsKey(step.Id)
                ? stepIngredientBindings[step.Id]
                : new List<int>()
        }) ?? Enumerable.Empty<object>());

    var ingredientLookupByName = (Model.IngredientsAndNutrients ?? new List<IngredientsAndNutrients>())
        .Where(x => !string.IsNullOrWhiteSpace(x.Name_DE))
        .GroupBy(x => x.Name_DE.Trim().ToLowerInvariant())
        .ToDictionary(g => g.Key, g => g.First().Id);

    var initialIngredientsJson = JsonConvert.SerializeObject(
        (Model.IngredientHandler ?? new List<IngredientHandlerModel>())
            .Select(old => {
                var normalizedName = (old.Ingredient?.Name ?? string.Empty).Trim().ToLowerInvariant();
                ingredientLookupByName.TryGetValue(normalizedName, out var mappedId);
                return new {
                    id = mappedId,
                    name = old.Ingredient?.Name ?? string.Empty,
                    quantity = old.Quantity?.Quantitys,
                    unit = old.Measure?.UnitOfMeasurement ?? "Gramm"
                };
            })
            .ToList());
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

