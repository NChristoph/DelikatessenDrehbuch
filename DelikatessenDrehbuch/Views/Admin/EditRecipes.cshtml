@model EditRecipesModel
@using Newtonsoft.Json

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* Styling Anpassungen */
    .Bg-Cream {
        background-color: #FDFCF0;
        min-height: 100vh;
    }

    #fileInput {
        display: none;
    }

    /* Karten Design */
    .recipe-card, .recipe-card-blue, .recipe-card-green {
        background-color: white;
        border-radius: 12px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.05);
        padding: 1.5rem;
        margin-bottom: 2rem;
        border-left: 6px solid #b02a37; /* Standard Rot */
    }

    .recipe-card-blue {
        border-left-color: #0d6efd;
    }

    .recipe-card-green {
        border-left-color: #198754;
    }

    /* Überschriften */
    .section-title {
        font-weight: 700;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid #eee;
        padding-bottom: 0.8rem;
        color: #333;
    }

        .section-title i {
            margin-right: 10px;
        }

    .text-red {
        color: #b02a37;
    }

    .text-blue {
        color: #0d6efd;
    }

    .text-green {
        color: #198754;
    }

    /* Alte Zutaten Badge */
    .old-ingredient-badge {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        color: #495057;
        padding: 10px;
        margin-bottom: 10px;
        border-radius: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9rem;
    }

    /* Buttons */
    .btn-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: all 0.2s;
    }

    /* DataTables Anpassung für Mobile */
    .dataTables_wrapper .row {
        margin-top: 10px;
    }

    /* Eingabefelder auf Mobile */
    @@media (max-width: 768px) {
        .recipe-card, .recipe-card-blue

    {
        padding: 1rem;
    }

    .btn-mobile-full {
        width: 100%;
        margin-top: 5px;
    }

    }
</style>

<div class="container-lg Bg-Cream py-4">
    <form asp-controller="Admin"
          asp-action="EditRecipe"
          method="post"
          enctype="multipart/form-data"
          id="recipeForm"
          onsubmit="updateAllIndices()">
        @Html.AntiForgeryToken()
        <input asp-for="@Model.Recipes.Id" hidden />
        <input asp-for="@Model.Recipes.OwnerEmail" hidden />

        <div class="recipe-card">
            <h3 class="section-title text-red"><i class="fa-solid fa-utensils"></i>Rezept Informationen</h3>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted text-uppercase">Rezept Name</label>
                    <input asp-for="@Model.Recipes.Name" class="form-control form-control-lg" placeholder="z.B. Spaghetti Bolognese" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted text-uppercase">Anzahl Personen</label>
                    <input asp-for="@Model.Recipes.RecipePersonCount" class="form-control form-control-lg" type="number" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted text-uppercase">Kategorie</label>
                    <input asp-for="@Model.Recipes.Category" class="form-control" />
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="dropdown w-100">
                        <button class="btn btn-outline-secondary dropdown-toggle w-100" type="button" data-bs-toggle="dropdown">Schema anzeigen</button>
                        <div class="dropdown-menu p-2 shadow" style="max-width: 100%;">
                            <img src="~/css/Logo/Schema Querys.png" class="img-fluid" alt="Schema" />
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label fw-bold small text-muted text-uppercase">Datenbank Querys (Optional)</label>
                    <textarea asp-for="Querys" class="form-control font-monospace bg-light" rows="3"></textarea>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted text-uppercase">Zubereitung (Text)</label>
                    <textarea asp-for="@Model.Recipes.Preparation" class="form-control" rows="4"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted text-uppercase">Beschreibung</label>
                    <textarea asp-for="@Model.Recipes.Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted text-uppercase">Kalorien</label>
                    <input asp-for="@Model.Recipes.Calories" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted text-uppercase">Zeit (Min)</label>
                    <input asp-for="@Model.Recipes.PreparationTime" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted text-uppercase">Bild</label>
                    <input id="fileInput" type="file" asp-for="Recipes.FormFile" onchange="updateFileName(this)" />
                    <label class="btn text-white w-100 d-flex align-items-center justify-content-center gap-2" for="fileInput" style="background-color: #b02a37;">
                        <i class="fa-solid fa-camera"></i> <span id="fileLabelText">Foto ändern</span>
                    </label>
                </div>
            </div>
        </div>

        @if (Model.IngredientHandler != null && Model.IngredientHandler.Count > 0)
        {
            <div class="recipe-card" style="border-left-color: #6c757d;">
                <h4 class="section-title text-secondary"><i class="fa-solid fa-clock-rotate-left"></i>Alte Zutaten (Referenz)</h4>
                <div class="row">
                    @foreach (var old in Model.IngredientHandler)
                    {
                        <div class="col-md-4 col-sm-6">
                            <div class="old-ingredient-badge">
                                <div>
                                    <strong>@old.Ingredient.Name</strong><br />
                                    <small class="text-muted">@old.Quantity.Quantitys @old.Measure.UnitOfMeasurement</small>
                                </div>
                                <i class="fa-solid fa-ban text-danger opacity-50" title="Wird beim Speichern ersetzt"></i>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="recipe-card">
            <h3 class="section-title text-red"><i class="fa-solid fa-database"></i>Zutaten auswählen</h3>
            <div class="table-responsive">
                <table id="ingredientsDbTable" class="table table-hover w-100 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Zutat</th>
                            <th>Kcal/100g</th>
                            <th>Gruppe</th>
                            <th class="text-end">Wählen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.IngredientsAndNutrients != null)
                        {
                            foreach (var item in Model.IngredientsAndNutrients)
                            {
                                <tr>
                                    <td class="fw-bold">@item.Name_DE</td>
                                    <td>@item.Calories_a_100g</td>
                                    <td><span class="badge bg-light text-dark border">@item.Groupe</span></td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-outline-success btn-sm rounded-pill"
                                                onclick="addNewIngredient('@item.Id', '@item.Name_DE')">
                                            <i class="fa-solid fa-plus"></i> Hinzufügen
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="recipe-card-green">
            <h3 class="section-title text-green"><i class="fa-solid fa-basket-shopping"></i>Neue Zutatenliste</h3>

            <div id="newIngredientsList">
                <div class="text-center text-muted py-4 bg-light rounded border border-dashed" id="emptyIngredientsMsg">
                    <i class="fa-solid fa-carrot fa-2x mb-2 text-muted opacity-50"></i><br />
                    Noch keine Zutaten ausgewählt.
                </div>
            </div>

            <div class="mt-3">
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="addNewIngredient('0', '')">
                    <i class="fa-solid fa-pen me-2"></i>Manuelle Zutat (Leerzeile)
                </button>
            </div>
        </div>

        <div class="recipe-card-blue">
            <h3 class="section-title text-blue"><i class="fa-solid fa-list-check"></i>Arbeitsschritte auswählen</h3>
            <div class="table-responsive">
                <table id="stepsDbTable" class="table table-hover w-100 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Beschreibung</th>
                            <th class="text-end">Wählen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecipePreperationSteps != null)
                        {
                            foreach (var step in Model.RecipePreperationSteps)
                            {
                                // 1. Text bereinigen (Zeilenumbrüche entfernen & Anführungszeichen maskieren)
                                string safeStepText = step.Step_DE?
                                .Replace("'", "\\'")    // Einfache Anführungszeichen escapen für JS
                                .Replace("\"", "&quot;") // Doppelte Anführungszeichen für HTML
                                .Replace("\r", "")      // Zeilenumbrüche entfernen
                                .Replace("\n", " ")     // Zeilenumbrüche durch Leerzeichen ersetzen
                                ?? "";

                                <tr>
                                    <td class="text-muted small">@step.Id</td>
                                    <td class="fw-bold">@step.Step_DE</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill"
                                                onclick="addJoinStep('@step.Id', '@safeStepText')">
                                            <i class="fa-solid fa-arrow-down"></i> Verwenden
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="recipe-card-blue">
            <h3 class="section-title text-blue"><i class="fa-solid fa-sort-numeric-down"></i>Finaler Ablaufplan</h3>

            <div id="newStepsList">
                <div class="text-center text-muted py-4 bg-light rounded border border-dashed" id="emptyStepsMsg">
                    <i class="fa-solid fa-list-ol fa-2x mb-2 text-muted opacity-50"></i><br />
                    Noch keine Schritte ausgewählt.
                </div>
            </div>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end pb-5">
            <button class="btn btn-lg text-white px-5 shadow-sm" type="submit" style="background-color: #b02a37; border: 1px solid #90232c;">
                <i class="fa-solid fa-floppy-disk me-2"></i> Rezept Speichern
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        var availableUnits = @Html.Raw(JsonConvert.SerializeObject(Model.Measure.Select(x => x.UnitOfMeasurement).ToList()));

        $(document).ready(function() {
            $('#ingredientsDbTable').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/de-DE.json' },
                pageLength: 5,
                lengthMenu: [5, 10, 25],
                columnDefs: [ { orderable: false, targets: 3 } ],
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rtip' // Mobile optimiertes Layout
            });

            $('#stepsDbTable').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/de-DE.json' },
                pageLength: 5,
                lengthMenu: [5, 10, 25],
                columnDefs: [ { orderable: false, targets: 2 } ],
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rtip'
            });
        });

        // ----------------------------------------------------
        // HELPER: Datei Name anzeigen
        // ----------------------------------------------------
        function updateFileName(input) {
            if (input.files && input.files[0]) $('#fileLabelText').text(input.files[0].name);
        }

        // ----------------------------------------------------
        // LOGIK ZUTATEN
        // ----------------------------------------------------
        function changeUnitValue(rowId, value) {
            // Wir suchen innerhalb der Zeile, um Konflikte zu vermeiden
            const row = $('#ing_row_' + rowId);
            row.find('.unit-input').val(value);
            row.find('.unit-btn').text(value);
        }

        function removeIngredientRow(btn) {
            $(btn).closest('.row').fadeOut(300, function() {
                $(this).remove();
                if ($('#newIngredientsList').children().length === 0) $('#emptyIngredientsMsg').fadeIn();
                // Indizes werden beim Submit neu berechnet,
                // aber wir könnten es auch hier tun, wenn nötig.
            });
        }

        function addNewIngredient(dbId, name) {
            $('#emptyIngredientsMsg').hide();

            // Generiere eine temporäre ID (Timestamp) für DOM-Manipulation
            // WICHTIG: Die echten Indizes [0], [1] werden erst beim Submit gesetzt/korrigiert.
            const tempId = Date.now();

            let dropdownItems = '';
            availableUnits.forEach(u => {
                dropdownItems += `<li><a class="dropdown-item" href="javascript:void(0)" onclick="changeUnitValue('${tempId}', '${u}')">${u}</a></li>`;
            });

            // Wir verwenden erst mal einen Platzhalter INDEX im namen, der später ersetzt wird
            let html = `
                <div class="row g-2 align-items-center mb-2 p-3 border rounded bg-white shadow-sm ingredient-row" id="ing_row_${tempId}">
                    <input type="hidden" class="field-id" name="IngredientMeasureQuantity[INDEX].IngredientsAndNutrients.Id" value="${dbId}" />

                    <div class="col-md-5 col-12">
                        <label class="small text-muted fw-bold d-md-none">Zutat</label>
                        <input type="text" class="form-control fw-bold"
                               name="IngredientMeasureQuantity[INDEX].IngredientsAndNutrients.Name_DE"
                               value="${name}" ${name !== '' ? 'readonly' : ''} placeholder="Zutat..." />
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="small text-muted fw-bold d-md-none">Menge</label>
                        <input type="number" step="any" class="form-control"
                               name="IngredientMeasureQuantity[INDEX].Quantity.Quantitys" placeholder="0" required />
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="small text-muted fw-bold d-md-none">Einheit</label>
                        <input type="hidden" class="unit-input" name="IngredientMeasureQuantity[INDEX].Measure.UnitOfMeasurement" value="Gramm" />
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle w-100 unit-btn text-truncate" type="button" data-bs-toggle="dropdown">g.</button>
                            <ul class="dropdown-menu shadow" style="max-height: 200px; overflow-y: auto;">${dropdownItems}</ul>
                        </div>
                    </div>

                    <div class="col-12 col-md-2 text-end">
                        <button type="button" class="btn btn-outline-danger btn-icon ms-auto mt-2 mt-md-0" onclick="removeIngredientRow(this)">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </div>`;

            $(html).hide().appendTo('#newIngredientsList').fadeIn(400);
        }

        // ----------------------------------------------------
        // LOGIK ARBEITSSCHRITTE
        // ----------------------------------------------------
        function removeStepRow(btn) {
            $(btn).closest('.row').fadeOut(300, function() {
                $(this).remove();
                if ($('#newStepsList').children().length === 0) $('#emptyStepsMsg').fadeIn();
                recalcStepNumbers(); // Nummern sofort aktualisieren
            });
        }

        function addJoinStep(stepId, stepText) {
            $('#emptyStepsMsg').hide();

            // Automatisch die nächste Nummer ermitteln
            const currentCount = $('#newStepsList .step-row').length + 1;
            const tempId = Date.now();

            let html = `
                <div class="row g-2 align-items-center mb-2 p-3 border rounded bg-white shadow-sm step-row" id="step_row_${tempId}" style="border-left: 5px solid #0d6efd !important;">

                    <input type="hidden" class="field-prepid" name="RecipeJoyinPreperationSteps[INDEX].PreperationStepId" value="${stepId}" />
                    <input type="hidden" class="field-recid" name="RecipeJoyinPreperationSteps[INDEX].RecipeId" value="@Model.Recipes.Id" />

                    <div class="col-3 col-md-2">
                         <label class="small text-muted fw-bold">Nr.</label>
                         <input type="number" class="form-control fw-bold text-center border-primary field-stepindex"
                                name="RecipeJoyinPreperationSteps[INDEX].StepIndex"
                                value="${currentCount}" required />
                    </div>

                    <div class="col-9 col-md-9">
                        <label class="small text-muted fw-bold d-md-none">Beschreibung</label>
                        <input type="text" class="form-control bg-light" value="${stepText}" readonly />
                    </div>

                    <div class="col-12 col-md-1 text-end">
                        <button type="button" class="btn btn-outline-danger btn-icon ms-auto mt-2 mt-md-0" onclick="removeStepRow(this)">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </div>
            `;

            $(html).hide().appendTo('#newStepsList').fadeIn(400);
        }

        // Visuelle Nummern aktualisieren (falls man zwischendrin was löscht)
        function recalcStepNumbers() {
            $('#newStepsList .step-row').each(function(index) {
                $(this).find('.field-stepindex').val(index + 1);
            });
        }

        // ----------------------------------------------------
        // WICHTIG: FORM SUBMIT VORBEREITUNG
        // ----------------------------------------------------
        // Hier reparieren wir die Indizes [0], [1], [3] -> [0], [1], [2]
        // Damit ASP.NET Core keine Daten verliert.
        function updateAllIndices() {
            // 1. Zutaten Indizes korrigieren
            $('#newIngredientsList .ingredient-row').each(function(index) {
                const row = $(this);
                row.find('input, select').each(function() {
                    if (this.name) {
                        this.name = this.name.replace(/\[.*?\]/, '[' + index + ']');
                    }
                });
            });

            // 2. Schritte Indizes korrigieren
            $('#newStepsList .step-row').each(function(index) {
                const row = $(this);
                // Auch gleich den StepIndex Input Value aktualisieren
                row.find('.field-stepindex').val(index + 1);

                row.find('input, select').each(function() {
                    if (this.name) {
                        this.name = this.name.replace(/\[.*?\]/, '[' + index + ']');
                    }
                });
            });

            // true zurückgeben damit der Submit weiterläuft
            return true;
        }
    </script>
}