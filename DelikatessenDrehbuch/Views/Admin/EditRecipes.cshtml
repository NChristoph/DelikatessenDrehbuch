                <h3 class="section-title text-blue mb-0"><i class="fa-solid fa-cubes"></i>Sandbox-Modus (Zutat ➜ Schritt)</h3>
                <button type="button" class="btn btn-outline-primary btn-sm" id="btnSuggestSteps">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> Schritte vorschlagen
                </button>
            </div>
            <div id="recipeTypeScoreBar" class="mb-2 d-none">
                <div class="d-flex flex-wrap align-items-center gap-1">
                    <span class="small text-muted me-1"><i class="fa-solid fa-chart-pie"></i> Rezepttyp:</span>
