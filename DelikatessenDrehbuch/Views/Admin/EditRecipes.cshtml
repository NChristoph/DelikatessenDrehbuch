                </div>
            </div>
            <div id="masterStepPreviewBox" class="mb-2 d-none">
                <div class="small text-muted mb-1"><i class="fa-solid fa-layer-group"></i> Master-Step Vorschau:</div>
                <div id="masterStepPreviewList" class="d-flex flex-column gap-1"></div>
            </div>
            <div class="border rounded p-2 bg-light mb-2">
                <div class="fw-semibold small mb-2">Master Template Builder</div>
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small mb-1">Zutat</label>
                        <select id="adminMasterIngredientSelect" class="form-select form-select-sm"></select>
                    </div>
