                    </div>
                </div>
            </div>
            <div class="mt-3 border rounded p-3 bg-light">
                <h6 class="fw-bold mb-2">Letzter bearbeiteter Schritt</h6>
                <div id="sandboxLastStepInfo" class="small text-muted mb-2">Noch keine Aktion bei den Schritten.</div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnRestoreLastDeletedStep" disabled>
                        <i class="fa-solid fa-rotate-left"></i> Letzten gelöschten Schritt wiederherstellen
                    </button>
                    <button type="button" class="btn btn-outline-danger btn-sm" id="btnRemoveLastAddedStep" disabled>
                        <i class="fa-solid fa-trash"></i> Letzten hinzugefügten Schritt entfernen
                    </button>
                </div>
            </div>
        </div>

        <div class="recipe-card-blue">
            <h3 class="section-title text-blue"><i class="fa-solid fa-sort-numeric-down"></i>Finaler Ablaufplan</h3>

            <div id="newStepsList">
                <div class="text-center text-muted py-4 bg-light rounded border border-dashed" id="emptyStepsMsg">
                    <i class="fa-solid fa-list-ol fa-2x mb-2 text-muted opacity-50"></i><br />
                    Noch keine Schritte ausgewählt.
                </div>
            </div>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end pb-5">
            <button class="btn btn-lg text-white px-5 shadow-sm" type="submit" style="background-color: #b02a37; border: 1px solid #90232c;">
                <i class="fa-solid fa-floppy-disk me-2"></i> Rezept Speichern
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <script src="~/js/recipe-step-suggest.js"></script>
    <script src="~/js/master-step-renderer.js"></script>
    <script>
        var availableUnits = @Html.Raw(JsonConvert.SerializeObject(Model.Measure.Select(x => x.UnitOfMeasurement).ToList()));

        let ingredientsTable;
        let activeSandboxIngredientId = null;
        let activeSandboxIngredientName = '';
        const stepCatalog = @Html.Raw(stepCatalogJson);
        const initialRecipeIngredients = @Html.Raw(initialIngredientsJson);
        const stepCatalogById = new Map();
        stepCatalog.forEach(function(s) { stepCatalogById.set(s.id.toString(), s); });
        let sandboxUnboundSteps = [];
        let lastDeletedStep = null;
        let lastAddedStep = null;
        const acceptedStepByIngredientPhase = new Map();
        let activeEquipmentFilter = 'all';

        function escapeForJsSingleQuote(value) {
            return (value || '')
                .toString()
                .replace(/\\/g, '\\\\')
                .replace(/'/g, "\\'")
                .replace(/"/g, '&quot;')
                .replace(/\r/g, '')
                .replace(/\n/g, ' ');
        }
        function ensureIngredientsTableHeader() {
            const requiredHeaders = ['Zutat', 'Menge + Einheit', 'Wählen'];
            const headerRow = document.querySelector('#ingredientsDbTable thead tr');
            if (!headerRow) return;

            while (headerRow.children.length < requiredHeaders.length) {
                const th = document.createElement('th');
                th.textContent = requiredHeaders[headerRow.children.length];
                headerRow.appendChild(th);
            }

            const lastHeader = headerRow.children[requiredHeaders.length - 1];
            if (lastHeader) {
                lastHeader.classList.add('text-end');
            }
        }

        function normalizeIngredientRows(rawRows) {
            if (!Array.isArray(rawRows)) return [];
            return rawRows
                .filter(row => row != null)
                .map(row => ({
                    ...row,
                    groupe: row.groupe ?? row.group ?? row.Group ?? ''
                }));
        }

        function getSelectedIngredientIdsForStepFilter() {
            return $('#newIngredientsList .ingredient-row .field-id')
                .map(function() { return $(this).val()?.toString(); })
                .get()
                .filter(id => id && id !== '0')
                .join(',');
        }

        function getActiveIngredientIdsForStepFilter() {
            if (activeSandboxIngredientId && activeSandboxIngredientId !== '0') {
                return activeSandboxIngredientId.toString();
            }

            return getSelectedIngredientIdsForStepFilter();
        }

        function getSelectedIngredientsForSandbox() {
            const fromRows = $('#newIngredientsList .ingredient-row').map(function() {
                const row = $(this);
                const id = row.find('.field-id').val()?.toString() || '0';
                const name = row.find('input[name*="IngredientsAndNutrients.Name_DE"]').val()?.toString().trim() || '';
                return { id, name };
            }).get().filter(x => x.id !== '0' || x.name);

            if (fromRows.length) {
                return fromRows.map(x => ({ id: x.id, name: x.name || 'Manuelle Zutat' }));
            }

            return $('#sandboxIngredientList .sandbox-ingredient-btn').map(function() {
                const btn = $(this);
                return {
                    id: btn.data('id')?.toString() || '0',
                    name: btn.data('name')?.toString() || 'Manuelle Zutat'
                };
            }).get();
        }

        const upsertStepUrl = '@Url.Action("UpsertStep", "Home", new { area = "WorldMiniApp" })';

        function refreshAdminMasterBuilder() {
            const ingredientSelect = $('#adminMasterIngredientSelect');
            const ingredients = getSelectedIngredientsForSandbox();
            ingredientSelect.empty();

            if (!ingredients.length) {
                ingredientSelect.append('<option value="">Keine Zutat gewählt</option>');
                $('#adminMasterTemplateSelect').html('<option value="">Keine Templates</option>');
                $('#adminMasterVariables').empty();
                $('#adminMasterPreviewText').text('Noch kein Template gewählt.');
                return;
            }

            ingredients.forEach(function(item) {
                ingredientSelect.append(`<option value="${item.name}">${item.name}</option>`);
            });

            refreshAdminMasterTemplates();
        }

        function refreshAdminMasterTemplates() {
            const ingredientName = $('#adminMasterIngredientSelect').val() || '';
            const templateSelect = $('#adminMasterTemplateSelect');
            templateSelect.empty();

            if (!ingredientName || !window.MasterStepRenderer) {
                templateSelect.append('<option value="">Keine Templates</option>');
                return;
            }

            const suggestions = MasterStepRenderer.suggestForIngredient(ingredientName);
            if (!suggestions.length) {
                templateSelect.append('<option value="">Keine Templates gefunden</option>');
                $('#adminMasterVariables').empty();
                $('#adminMasterPreviewText').text('Keine passenden Master-Templates gefunden.');
                return;
            }

            suggestions.forEach(function(step) {
                templateSelect.append(`<option value="${step.master_id}">${step.description || step.master_id}</option>`);
            });

            renderAdminMasterTemplateEditor();
        }

        function renderAdminMasterTemplateEditor() {
            const templateId = $('#adminMasterTemplateSelect').val();
            const ingredientName = $('#adminMasterIngredientSelect').val() || '';
            const box = $('#adminMasterVariables');
            box.empty();

            if (!templateId || !window.MasterStepRenderer) {
                $('#adminMasterPreviewText').text('Noch kein Template gewählt.');
                return;
            }

            const template = MasterStepRenderer.findTemplate(templateId);
            if (!template) {
                $('#adminMasterPreviewText').text('Template nicht gefunden.');
                return;
            }

            const vars = MasterStepRenderer.getSmartDefaults(templateId, {
                ingredientName: ingredientName
            });

            (template.variables || []).forEach(function(key) {
                box.append(`<div class="col-md-4"><label class="form-label small mb-1">${key}</label><input type="text" class="form-control form-control-sm admin-master-var-input" data-var="${key}" value="${vars[key] || ''}" /></div>`);
            });

            updateAdminMasterPreview();
        }

        function collectAdminMasterVariables() {
            const vars = {};
            $('#adminMasterVariables .admin-master-var-input').each(function() {
                vars[$(this).data('var')] = $(this).val();
            });
            return vars;
        }

        function updateAdminMasterPreview() {
            const templateId = $('#adminMasterTemplateSelect').val();
            if (!templateId || !window.MasterStepRenderer) return;
            const vars = collectAdminMasterVariables();
            $('#adminMasterPreviewText').text(MasterStepRenderer.render(templateId, vars, 'de') || 'Keine Vorschau verfügbar.');
        }

        async function addAdminRenderedMasterStep() {
            const templateId = $('#adminMasterTemplateSelect').val();
            if (!templateId || !window.MasterStepRenderer) return;

            const template = MasterStepRenderer.findTemplate(templateId);
            if (!template) return;

            const vars = collectAdminMasterVariables();
            const rendered = MasterStepRenderer.renderAll(templateId, vars);
            const payload = {
                de: rendered.de,
                en: rendered.en,
                esp: rendered.esp,
                prt: rendered.prt,
                phase: parseInt(template.phase || 0, 10),
                equipment: parseInt(template.equipment || 0, 10)
            };

            try {
                const response = await fetch(upsertStepUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) throw new Error('Upsert fehlgeschlagen');
                const result = await response.json();
                const newId = result?.id;
                if (!newId) throw new Error('Keine Step-ID');

                if (!stepCatalog.some(x => x && x.id?.toString() === newId.toString())) {
                    stepCatalog.push({
                        id: newId,
                        step_DE: rendered.de,
                        phase: payload.phase,
                        equipment: payload.equipment,
                        ingredientIds: []
                    });
                }

                addJoinStep(newId, rendered.de, { enforceIngredientPhaseUniqueness: false });
                recalcStepNumbers();
                loadSandboxStepsForActiveIngredient();
            } catch (e) {
                alert('Master-Step konnte nicht übernommen werden.');
            }
        }

        function renderSandboxIngredientList() {
            const container = $('#sandboxIngredientList');
            const ingredients = getSelectedIngredientsForSandbox();
            container.empty();
            updateSuggestButtonState();

            if (!ingredients.length) {
                activeSandboxIngredientId = null;
                activeSandboxIngredientName = '';
                $('#sandboxActiveIngredientLabel').text('Keine Zutat aktiv');
                container.append('<div class="text-muted small">Noch keine Zutaten ausgewählt.</div>');
                sandboxUnboundSteps = [];
                $('#sandboxUnboundSearch').val('');
                renderSandboxStepCandidates([]);
                renderSandboxUnboundStepCandidates('');
                return;
            }

            const activeStillExists = ingredients.some(x => x.id === activeSandboxIngredientId);
            if (!activeStillExists) {
                const first = ingredients[0];
                activeSandboxIngredientId = first.id;
                activeSandboxIngredientName = first.name;
            }

            ingredients.forEach(item => {
                const isActive = item.id === activeSandboxIngredientId;
                const button = $(`<button type="button" class="btn btn-outline-secondary text-start sandbox-ingredient-btn ${isActive ? 'active' : ''}" data-id="${item.id}" data-name="${item.name}">
                    <i class="fa-solid fa-carrot me-2"></i>${item.name}
                </button>`);
                container.append(button);
            });

            $('#sandboxActiveIngredientLabel').text(activeSandboxIngredientName || 'Keine Zutat aktiv');
            loadSandboxStepsForActiveIngredient();
            updateRecipeTypeDetection();
            refreshAdminMasterBuilder();
        }

        function shouldShowStepInSandboxSelection(step) {
            const ingredientIds = (step?.ingredientIds || []).map(x => x?.toString()).filter(Boolean);
            if (!ingredientIds.length) {
                return true;
            }

            if (ingredientIds.length >= 3) {
                return true;
            }

            const selectedIds = getSelectedIngredientIdsForStepFilter()
                .split(',')
                .map(x => x?.toString().trim())
                .filter(Boolean);

            const matchCount = ingredientIds.filter(id => selectedIds.includes(id)).length;
            return matchCount >= 2;
        }

        function renderStepCardList(container, steps, emptyText) {
            container.empty();

            if (!steps || !steps.length) {
                container.append(`<div class="text-muted small">${emptyText}</div>`);
                return;
            }

            let renderedCount = 0;
            steps.forEach(step => {
                if (!shouldShowStepInSandboxSelection(step)) {
                    return;
                }

                const stepId = step.id?.toString();
                const activeId = activeSandboxIngredientId?.toString();
                const stepPhase = parseInt(step.phase ?? 0, 10);
                const stepIngredientIds = (step.ingredientIds || []).map(x => x.toString());

                if (activeId && stepPhase > 0 && stepIngredientIds.includes(activeId)) {
                    const acceptedId = acceptedStepByIngredientPhase.get(`${activeId}|${stepPhase}`)?.toString();
                    if (acceptedId && acceptedId !== stepId) {
                        return;
                    }
                }

                const isSelected = $('#newStepsList .step-row').filter(function() {
                    return $(this).data('step-id')?.toString() === stepId;
                }).length > 0;

                const card = $(`<div class="border rounded p-2 sandbox-step-card">
                    <button type="button" class="btn btn-outline-primary text-start sandbox-step-candidate w-100" data-id="${step.id}">
                        <span class="badge ${isSelected ? 'bg-success' : 'bg-primary'} me-2">${step.id}</span>
                        ${step.step_DE}
                        ${isSelected ? '<span class="ms-2 badge bg-success sandbox-selected-label">Ausgewählt</span>' : ''}
                    </button>
                    <div class="d-flex justify-content-end mt-2">
                        <button type="button" class="btn btn-success btn-sm sandbox-accept-step-btn" data-id="${step.id}">Akzeptieren</button>
                    </div>
                </div>`);

                card.find('.sandbox-step-candidate').on('click', function() {
                    addJoinStep(step.id, step.step_DE, { enforceIngredientPhaseUniqueness: false });
                });
                card.find('.sandbox-accept-step-btn').on('click', function() {
                    acceptStepForActiveIngredient(step.id, step.step_DE);
                });
                container.append(card);
                renderedCount += 1;
            });

            if (!renderedCount) {
                container.append(`<div class="text-muted small">${emptyText}</div>`);
            }
        }

        function renderSandboxStepCandidates(steps) {
            renderStepCardList($('#sandboxLinkedStepCandidates'), steps, 'Keine verknüpften Schritte gefunden.');
        }

        function getEquipmentLabel(equipment) {
            const map = {
                1: { text: 'Backofen', cls: 'equip-badge-1', icon: 'fa-temperature-high' },
                2: { text: 'Pfanne', cls: 'equip-badge-2', icon: 'fa-fire-burner' },
                3: { text: 'Topf', cls: 'equip-badge-3', icon: 'fa-bowl-food' },
                4: { text: 'Bräter', cls: 'equip-badge-4', icon: 'fa-fire' },
                5: { text: 'Kochfeld', cls: 'equip-badge-5', icon: 'fa-kitchen-set' }
            };
            const info = map[equipment];
            if (!info) return '';
            return `<span class="equipment-badge ${info.cls}"><i class="fa-solid ${info.icon} me-1"></i>${info.text}</span>`;
        }

        function getPhaseLabel(phase) {
            const map = {
                1: { text: 'Vorb.', cls: 'phase-badge-1' },
                2: { text: 'Kochen', cls: 'phase-badge-2' },
                3: { text: 'Würzen', cls: 'phase-badge-3' },
                4: { text: 'Finish', cls: 'phase-badge-4' }
            };
            const info = map[phase];
            if (!info) return '';
            return `<span class="phase-badge ${info.cls}">${info.text}</span>`;
        }

        function renderSandboxUnboundStepCandidates(searchTerm) {
            const normalizedSearch = (searchTerm || '').trim().toLowerCase();
            const filtered = sandboxUnboundSteps.filter(step => {
                if (activeEquipmentFilter !== 'all') {
                    const equipVal = parseInt(step?.equipment ?? 0, 10);
                    if (equipVal.toString() !== activeEquipmentFilter) return false;
                }

                if (!normalizedSearch) return true;

                const text = (step?.step_DE || '').toString().toLowerCase();
                const idText = (step?.id || '').toString();
                return text.includes(normalizedSearch) || idText.includes(normalizedSearch);
            });

            // Sort by phase: Vorbereitung → Kochen → Würzen → Finish → Sonstige
            const phaseOrder = { 1: 0, 2: 1, 3: 2, 4: 3, 0: 4 };
            filtered.sort(function(a, b) {
                const pa = phaseOrder[parseInt(a?.phase ?? 0, 10)] ?? 4;
                const pb = phaseOrder[parseInt(b?.phase ?? 0, 10)] ?? 4;
                if (pa !== pb) return pa - pb;
                return (a.id || 0) - (b.id || 0);
            });

            renderUnboundStepCardListGrouped($('#sandboxUnboundStepCandidates'), filtered, 'Keine ungebundenen Schritte gefunden.');
        }

        function renderUnboundStepCardListGrouped(container, steps, emptyText) {
            container.empty();

            if (!steps || !steps.length) {
                container.append(`<div class="text-muted small">${emptyText}</div>`);
                return;
            }

            const phaseNames = { 1: 'Vorbereitung', 2: 'Kochen', 3: 'Würzen', 4: 'Finish', 0: 'Sonstige' };
            const phaseGroups = { 1: [], 2: [], 3: [], 4: [], 0: [] };

            steps.forEach(step => {
                const phase = parseInt(step?.phase ?? 0, 10);
                (phaseGroups[phase] ?? phaseGroups[0]).push(step);
            });

            let renderedCount = 0;
            [1, 2, 3, 4, 0].forEach(phase => {
                const items = phaseGroups[phase];
                if (!items.length) return;

                const phaseBadge = getPhaseLabel(phase);
                if (phaseBadge) {
                    container.append(`<div class="fw-bold small mt-2 mb-1 border-bottom pb-1">${phaseBadge} ${phaseNames[phase]}</div>`);
                } else {
                    container.append(`<div class="fw-bold small mt-2 mb-1 border-bottom pb-1 text-muted">Sonstige</div>`);
                }

                items.forEach(step => {
                    if (!shouldShowStepInSandboxSelection(step)) return;

                    const stepId = step.id?.toString();
                    const isSelected = $('#newStepsList .step-row').filter(function() {
                        return $(this).data('step-id')?.toString() === stepId;
                    }).length > 0;

                    const equipBadge = getEquipmentLabel(parseInt(step?.equipment ?? 0, 10));

                    const card = $(`<div class="border rounded p-2 sandbox-step-card">
                        <button type="button" class="btn btn-outline-primary text-start sandbox-step-candidate w-100" data-id="${step.id}">
                            <span class="badge ${isSelected ? 'bg-success' : 'bg-primary'} me-2">${step.id}</span>
                            ${equipBadge}
                            ${step.step_DE}
                            ${isSelected ? '<span class="ms-2 badge bg-success sandbox-selected-label">Ausgewählt</span>' : ''}
                        </button>
                        <div class="d-flex justify-content-end mt-2">
                            <button type="button" class="btn btn-success btn-sm sandbox-accept-step-btn" data-id="${step.id}">Akzeptieren</button>
                        </div>
                    </div>`);

                    card.find('.sandbox-step-candidate').on('click', function() {
                        addJoinStep(step.id, step.step_DE, { enforceIngredientPhaseUniqueness: false });
                    });
                    card.find('.sandbox-accept-step-btn').on('click', function() {
                        acceptStepForActiveIngredient(step.id, step.step_DE);
                    });
                    container.append(card);
                    renderedCount += 1;
                });
            });

            if (!renderedCount) {
                container.append(`<div class="text-muted small">${emptyText}</div>`);
            }
        }

        function refreshSandboxStepSelectionHighlight() {
            const selectedStepIds = $('#newStepsList .step-row').map(function() {
                return $(this).data('step-id')?.toString();
            }).get();

            $('.sandbox-step-candidate').each(function() {
                const card = $(this);
                const stepId = card.data('id')?.toString();
                const isSelected = selectedStepIds.includes(stepId);

                const idBadge = card.find('span.badge').first();
                if (idBadge.length) {
                    idBadge.removeClass('bg-primary bg-success').addClass(isSelected ? 'bg-success' : 'bg-primary');
                }

                const label = card.find('.sandbox-selected-label');
                if (isSelected) {
                    if (!label.length) {
                        card.append('<span class="ms-2 badge bg-success sandbox-selected-label">Ausgewählt</span>');
                    }
                } else {
                    label.remove();
                }
            });
        }

        function buildStepMatchCount(step, selectedIngredientIds) {
            const stepIngredientIds = (step?.ingredientIds || []).map(x => x.toString());
            if (!stepIngredientIds.length) {
                return 0;
            }

            const normalizedSelectedIds = (selectedIngredientIds || []).map(x => x.toString());
            return normalizedSelectedIds.filter(id => stepIngredientIds.includes(id)).length;
        }

        function sortSandboxStepRows(rows, selectedIngredientIds) {
            return rows.sort(function(a, b) {
                const matchA = buildStepMatchCount(a, selectedIngredientIds);
                const matchB = buildStepMatchCount(b, selectedIngredientIds);

                if (matchB !== matchA) {
                    return matchB - matchA;
                }

                return (a.id || 0) - (b.id || 0);
            });
        }

        function updateSuggestButtonState() {
            const selected = getSelectedIngredientIdsForStepFilter();
            $('#btnSuggestSteps').prop('disabled', !selected.length);
        }

        /** Live recipe type detection when ingredients change */
        function updateRecipeTypeDetection() {
            if (!RecipeStepSuggest.isLoaded()) {
                RecipeStepSuggest.loadMapping().then(function() { updateRecipeTypeDetection(); });
                return;
            }
            const selectedIdsCsv = getSelectedIngredientIdsForStepFilter();
            const selectedNames = getSelectedIngredientsForSandbox().map(function(x) { return x.name; });
            const scoreBar = $('#recipeTypeScoreBar');
            const badges = $('#recipeTypeBadges');
            const masterBox = $('#masterStepPreviewBox');
            const masterList = $('#masterStepPreviewList');
            if (!selectedIdsCsv || !selectedIdsCsv.length) {
                scoreBar.addClass('d-none');
                masterBox.addClass('d-none');
                return;
            }
            const selectedIds = selectedIdsCsv.split(',').map(function(x) { return parseInt(x, 10); }).filter(function(x) { return !isNaN(x); });
            const hasSuggest = typeof window.RecipeStepSuggest !== 'undefined';
            var types = hasSuggest && typeof RecipeStepSuggest.detectRecipeTypes === 'function'
                ? RecipeStepSuggest.detectRecipeTypes(selectedIds)
                : [];
            if (types.length && typeof RecipeStepSuggest.renderRecipeTypeBadges === 'function') {
                badges.html(RecipeStepSuggest.renderRecipeTypeBadges(types, 3));
                scoreBar.removeClass('d-none');
            } else {
                scoreBar.addClass('d-none');
            }

            const preview = hasSuggest && typeof RecipeStepSuggest.getMasterStepPreview === 'function'
                ? RecipeStepSuggest.getMasterStepPreview(selectedNames, { lang: 'de', maxItems: 5 })
                : [];
            if (preview.length) {
                masterList.empty();
                preview.forEach(function(item) {
                    masterList.append(`<div class="small border rounded px-2 py-1 bg-light"><span class="badge text-bg-secondary me-2">P${item.phase}</span>${item.text}</div>`);
                });
                masterBox.removeClass('d-none');
            } else {
                masterBox.addClass('d-none');
            }
        }

        function removeConflictingStepsForActiveIngredient(newStepId) {
            const activeId = activeSandboxIngredientId?.toString();
            if (!activeId) return;

            const newStep = stepCatalogById.get(newStepId?.toString());
            if (!newStep) return;

            const newStepPhase = parseInt(newStep.phase ?? 0, 10);
            if (!newStepPhase || newStepPhase < 1) return;

            const newStepIngredientIds = (newStep.ingredientIds || []).map(x => x.toString());
            if (!newStepIngredientIds.includes(activeId)) return;

            $('#newStepsList .step-row').each(function() {
                const row = $(this);
                const existingStepId = row.data('step-id')?.toString();
                if (!existingStepId || existingStepId === newStepId.toString()) return;

                const existingStep = stepCatalogById.get(existingStepId);
                if (!existingStep) return;

                const existingPhase = parseInt(existingStep.phase ?? 0, 10);
                if (existingPhase !== newStepPhase) return;

                const existingIngredientIds = (existingStep.ingredientIds || []).map(x => x.toString());
                if (!existingIngredientIds.includes(activeId)) return;

                row.remove();
            });
        }

        function acceptStepForActiveIngredient(stepId, stepText) {
            const activeId = activeSandboxIngredientId?.toString();
            if (!activeId) {
                alert('Bitte zuerst links eine Zutat auswählen.');
                return;
            }

            addJoinStep(stepId, stepText, { enforceIngredientPhaseUniqueness: false });
            removeConflictingStepsForActiveIngredient(stepId);

            const step = stepCatalogById.get(stepId?.toString());
            const phase = parseInt(step?.phase ?? 0, 10);
            const ingredientIds = (step?.ingredientIds || []).map(x => x.toString());
            if (phase > 0 && ingredientIds.includes(activeId)) {
                acceptedStepByIngredientPhase.set(`${activeId}|${phase}`, stepId.toString());
            }

            recalcStepNumbers();
            loadSandboxStepsForActiveIngredient();
        }

        function suggestStepsForSelectedIngredients() {
            const selectedIdsCsv = getSelectedIngredientIdsForStepFilter();
            if (!selectedIdsCsv || !selectedIdsCsv.length) return;

            const selectedIds = selectedIdsCsv.split(',').map(x => parseInt(x, 10)).filter(x => !isNaN(x));
            if (!selectedIds.length) return;

            const existingSteps = $('#newStepsList .step-row').length;
            if (existingSteps > 0 && !confirm('Bestehende Schritte ersetzen?')) return;

            // Collect selected ingredient names for conflict checking
            const selectedNames = getSelectedIngredientsForSandbox().map(x => x.name);

            // Build a plain object lookup from the page's step catalog
            const catalogObj = {};
            stepCatalog.forEach(function(s) { catalogObj[s.id.toString()] = s; });

            function runSuggestion() {
                const result = RecipeStepSuggest.suggestStepsForIngredients(selectedIds, catalogObj, {
                    selectedIngredientNames: selectedNames,
                    maxSteps: 25
                });

                // Show recipe type score
                const scoreBar = $('#recipeTypeScoreBar');
                const badges = $('#recipeTypeBadges');
                if (result.recipeTypes.length) {
                    badges.html(RecipeStepSuggest.renderRecipeTypeBadges(result.recipeTypes, 3));
                    scoreBar.removeClass('d-none');
                } else {
                    scoreBar.addClass('d-none');
                }

                if (result.steps.length) {
                    $('#newStepsList').empty();
                    $('#emptyStepsMsg').hide();
                    result.steps.forEach(function(item) {
                        const catalogStep = catalogObj[item.stepId.toString()];
                        const text = catalogStep ? (catalogStep.step_DE || catalogStep.de || '') : '';
                        addJoinStep(item.stepId, text, { enforceIngredientPhaseUniqueness: false });
                    });
                    recalcStepNumbers();
                    return;
                }

                // Fallback: original DB-binding logic
                suggestStepsFallback(selectedIds);
            }

            if (RecipeStepSuggest.isLoaded()) {
                runSuggestion();
            } else {
                RecipeStepSuggest.loadMapping()
                    .then(function() { runSuggestion(); })
                    .catch(function() { suggestStepsFallback(selectedIds); });
            }
        }

        /** Original suggest logic as fallback */
        function suggestStepsFallback(selectedIds) {
            const matched = stepCatalog
                .map(function(step) {
                    const ingredientIds = (step.ingredientIds || []).map(x => parseInt(x, 10)).filter(x => !isNaN(x));
                    const matchCount = ingredientIds.filter(id => selectedIds.includes(id)).length;
                    return { step, matchCount, phase: parseInt(step.phase ?? 0, 10) || 0 };
                })
                .filter(x => x.matchCount > 0);

            const phaseOrder = { 1: 0, 2: 1, 3: 2, 4: 3, 0: 4 };
            matched.sort(function(a, b) {
                const pa = phaseOrder[a.phase] ?? 4;
                const pb = phaseOrder[b.phase] ?? 4;
                if (pa !== pb) return pa - pb;
                if (b.matchCount !== a.matchCount) return b.matchCount - a.matchCount;
                return (a.step.id || 0) - (b.step.id || 0);
            });

            $('#newStepsList').empty();
            $('#emptyStepsMsg').hide();
            matched.forEach(function(item) {
                addJoinStep(item.step.id, item.step.step_DE, { enforceIngredientPhaseUniqueness: false });
            });
            recalcStepNumbers();
        }

        function loadSandboxStepsForActiveIngredient() {
            const selectedIngredientIdsCsv = getSelectedIngredientIdsForStepFilter();
            const selectedIngredientIds = selectedIngredientIdsCsv
                .split(',')
                .map(x => parseInt(x, 10))
                .filter(x => !isNaN(x));
            const activeIngredientId = activeSandboxIngredientId?.toString() || '';

            if (!selectedIngredientIds.length && !activeIngredientId) {
                sandboxUnboundSteps = [];
                $('#sandboxUnboundSearch').val('');
                renderSandboxStepCandidates([]);
                renderSandboxUnboundStepCandidates('');
                return;
            }

            const boundToActive = sortSandboxStepRows(
                stepCatalog.filter(x => (x.ingredientIds || []).map(id => id.toString()).includes(activeIngredientId)),
                selectedIngredientIds);
            const unbound = stepCatalog
                .filter(x => !(x.ingredientIds || []).length)
                .sort(function(a, b) {
                    const phaseOrder = { 1: 0, 2: 1, 3: 2, 4: 3, 0: 4 };
                    const pa = phaseOrder[parseInt(a.phase ?? 0, 10)] ?? 4;
                    const pb = phaseOrder[parseInt(b.phase ?? 0, 10)] ?? 4;
                    if (pa !== pb) return pa - pb;
                    return (a.id || 0) - (b.id || 0);
                });

            sandboxUnboundSteps = unbound;
            $('#sandboxUnboundSearch').val('');
            renderSandboxStepCandidates(boundToActive);
            renderSandboxUnboundStepCandidates('');
        }

        function refreshLastEditedStepBox() {
            const info = $('#sandboxLastStepInfo');
            const restoreBtn = $('#btnRestoreLastDeletedStep');
            const removeLastBtn = $('#btnRemoveLastAddedStep');

            if (lastDeletedStep) {
                restoreBtn.prop('disabled', false);
            } else {
                restoreBtn.prop('disabled', true);
            }

            if (lastAddedStep) {
                removeLastBtn.prop('disabled', false);
            } else {
                removeLastBtn.prop('disabled', true);
            }

            if (lastDeletedStep) {
                info.html(`<strong>Zuletzt gelöscht:</strong> #${lastDeletedStep.id} ${lastDeletedStep.text}`);
                return;
            }

            if (lastAddedStep) {
                info.html(`<strong>Zuletzt hinzugefügt:</strong> #${lastAddedStep.id} ${lastAddedStep.text}`);
                return;
            }

            info.text('Noch keine Aktion bei den Schritten.');
        }

        function preloadExistingRecipeIngredients() {
            if (!Array.isArray(initialRecipeIngredients) || !initialRecipeIngredients.length) return;

            initialRecipeIngredients.forEach(function(item) {
                const dbId = item?.id && Number(item.id) > 0 ? item.id.toString() : '0';
                const name = (item?.name || '').toString();
                const quantity = item?.quantity != null ? item.quantity.toString() : '';
                const unit = (item?.unit || 'Gramm').toString();
                if (!name && dbId === '0') return;
                addNewIngredient(dbId, name, quantity, unit);
            });
        }

        $(document).ready(function() {
            ingredientsTable = new DataTable('#ingredientsDbTable', {
                ajax: {
                    url: '@Url.Action("GetIngredientTableData", "Admin")',
                    dataSrc: function(json) {
                        return normalizeIngredientRows(json);
                    }
                },
                language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/de-DE.json' },
                pageLength: 15,
                lengthMenu: [5, 10, 25],
                columnDefs: [ { orderable: false, targets: [1, 2] } ],
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rtip',
                columns: [
                    { data: 'name_DE', className: 'fw-bold' },
                    {
                        data: null,
                        orderable: false,
                        render: function(data, type, row) {
                            const unitOptions = availableUnits.map(u => `<option value="${u}">${u}</option>`).join('');
                            return `
                                <div class="ingredient-cell-controls">                                    <input type="number" step="any" min="0" class="form-control form-control-sm ingredient-qty-input" value="0" />                                    <select class="form-select form-select-sm ingredient-unit-input">${unitOptions}</select>                                </div>`;
                        }
                    },
                    {
                        data: null,
                        className: 'text-end align-middle w-auto',
                        render: function(data, type, row) {
                            const safeName = escapeForJsSingleQuote(row.name_DE || '');
                            return `<button type="button" class="btn btn-outline-success btn-sm rounded-pill btn-add-ingredient" onclick="addNewIngredientFromTable(this, '${row.id}', '${safeName}')"><i class="fa-solid fa-plus"></i> Hinzufügen</button>`;
                        }
                    }
                ]
            });

            $('#refreshIngredientsTableBtn').on('click', function() {
                ingredientsTable.ajax.reload(null, false);
            });

            $('#btnSuggestSteps').on('click', function() {
                suggestStepsForSelectedIngredients();
            });

            MasterStepRenderer.load().then(function() { refreshAdminMasterBuilder(); });
            $('#adminMasterIngredientSelect').on('change', refreshAdminMasterTemplates);
            $('#adminMasterTemplateSelect').on('change', renderAdminMasterTemplateEditor);
            $('#adminMasterVariables').on('input', '.admin-master-var-input', updateAdminMasterPreview);
            $('#btnAdminAddMasterStep').on('click', addAdminRenderedMasterStep);

            preloadExistingRecipeIngredients();
            renderSandboxIngredientList();
            updateSuggestButtonState();
        });

        // ----------------------------------------------------
        // HELPER: Datei Name anzeigen
        // ----------------------------------------------------
        function updateFileName(input) {
            if (input.files && input.files[0]) $('#fileLabelText').text(input.files[0].name);
        }

        // ----------------------------------------------------
        // LOGIK ZUTATEN
        // ----------------------------------------------------
        function changeUnitValue(rowId, value) {
            // Wir suchen innerhalb der Zeile, um Konflikte zu vermeiden
            const row = $('#ing_row_' + rowId);
            row.find('.unit-input').val(value);
            row.find('.unit-btn').text(value);
        }

        function removeIngredientRow(btn) {
            $(btn).closest('.row').fadeOut(300, function() {
                $(this).remove();
                if ($('#newIngredientsList').children().length === 0) $('#emptyIngredientsMsg').fadeIn();
                // Indizes werden beim Submit neu berechnet,
                // aber wir könnten es auch hier tun, wenn nötig.
                    renderSandboxIngredientList();
            });
        }

        function addNewIngredientFromTable(btn, dbId, name) {
            const row = $(btn).closest('tr');
            const quantity = row.find('.ingredient-qty-input').val() || '';
            const unit = row.find('.ingredient-unit-input').val() || 'Gramm';
            addNewIngredient(dbId, name, quantity, unit);
        }

        function addNewIngredient(dbId, name, quantity = '', unit = 'Gramm') {
            const existingById = dbId !== '0' && $('#newIngredientsList .ingredient-row').filter(function() {
                return $(this).data('ingredient-id')?.toString() === dbId.toString();
            }).length > 0;
            const existingByName = name && $('#newIngredientsList .ingredient-row input[name*="IngredientsAndNutrients.Name_DE"]').filter(function() {
                return $(this).val()?.toString().trim().toLowerCase() === name.toString().trim().toLowerCase();
            }).length > 0;

            if (existingById || existingByName) {
                return;
            }

            $('#emptyIngredientsMsg').hide();

            // Generiere eine temporäre ID (Timestamp) für DOM-Manipulation
            // WICHTIG: Die echten Indizes [0], [1] werden erst beim Submit gesetzt/korrigiert.
            const tempId = Date.now();

            let dropdownItems = '';
            availableUnits.forEach(u => {
                dropdownItems += `<li><a class="dropdown-item" href="javascript:void(0)" onclick="changeUnitValue('${tempId}', '${u}')">${u}</a></li>`;
            });

            // Wir verwenden erst mal einen Platzhalter INDEX im namen, der später ersetzt wird
            let html = `
                <div class="row g-2 align-items-center mb-2 p-3 border rounded bg-white shadow-sm ingredient-row" id="ing_row_${tempId}" data-ingredient-id="${dbId}">
                    <input type="hidden" class="field-id" name="IngredientMeasureQuantity[INDEX].IngredientsAndNutrients.Id" value="${dbId}" />

                    <div class="col-md-5 col-12">
                        <label class="small text-muted fw-bold d-md-none">Zutat</label>
                        <input type="text" class="form-control fw-bold"
                               name="IngredientMeasureQuantity[INDEX].IngredientsAndNutrients.Name_DE"
                               value="${name}" ${name !== '' ? 'readonly' : ''} placeholder="Zutat..." />
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="small text-muted fw-bold d-md-none">Menge</label>
                        <input type="number" step="any" class="form-control"
                               name="IngredientMeasureQuantity[INDEX].Quantity.Quantitys" placeholder="0" value="${quantity}" required />
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="small text-muted fw-bold d-md-none">Einheit</label>
                        <input type="hidden" class="unit-input" name="IngredientMeasureQuantity[INDEX].Measure.UnitOfMeasurement" value="${unit}" />
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle w-100 unit-btn text-truncate" type="button" data-bs-toggle="dropdown">${unit}</button>
                            <ul class="dropdown-menu shadow" style="max-height: 200px; overflow-y: auto;">${dropdownItems}</ul>
                        </div>
                    </div>

                    <div class="col-12 col-md-2 text-end">
                        <button type="button" class="btn btn-outline-danger btn-icon ms-auto mt-2 mt-md-0" onclick="removeIngredientRow(this)">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </div>`;

            $(html).hide().appendTo('#newIngredientsList').fadeIn(400);
            renderSandboxIngredientList();
        }

        // ----------------------------------------------------
        // LOGIK ARBEITSSCHRITTE
        // ----------------------------------------------------
        function removeStepRow(btn) {
            const row = $(btn).closest('.step-row');
            const deletedStepId = row.data('step-id')?.toString();
            const deletedStepText = row.find('input[type="text"]').val() || '';

            row.fadeOut(300, function() {
                $(this).remove();

                if (deletedStepId) {
                    lastDeletedStep = { id: deletedStepId, text: deletedStepText };
                }

                if (lastAddedStep?.id?.toString() === deletedStepId?.toString()) {
                    lastAddedStep = null;
                }

                for (const [key, value] of acceptedStepByIngredientPhase.entries()) {
                    if (value?.toString() === deletedStepId?.toString()) {
                        acceptedStepByIngredientPhase.delete(key);
                    }
                }

                refreshLastEditedStepBox();
                refreshSandboxStepSelectionHighlight();
                if ($('#newStepsList').children().length === 0) $('#emptyStepsMsg').fadeIn();
                recalcStepNumbers(); // Nummern sofort aktualisieren
            });
        }

        function addJoinStep(stepId, stepText, options = {}) {
            const alreadySelected = $('#newStepsList .step-row').filter(function() {
                return $(this).data('step-id')?.toString() === stepId.toString();
            }).length > 0;

            if (alreadySelected) {
                return;
            }

            const enforceIngredientPhaseUniqueness = options?.enforceIngredientPhaseUniqueness === true;
            if (enforceIngredientPhaseUniqueness) {
                removeConflictingStepsForActiveIngredient(stepId);
            }

            $('#emptyStepsMsg').hide();

            // Automatisch die nächste Nummer ermitteln
            const currentCount = $('#newStepsList .step-row').length + 1;
            const tempId = Date.now();

            let html = `
                <div class="row g-2 align-items-center mb-2 p-3 border rounded bg-white shadow-sm step-row" id="step_row_${tempId}" data-step-id="${stepId}" draggable="true" style="border-left: 5px solid #0d6efd !important;">

                    <input type="hidden" class="field-prepid" name="RecipeJoyinPreperationSteps[INDEX].PreperationStepId" value="${stepId}" />
                    <input type="hidden" class="field-recid" name="RecipeJoyinPreperationSteps[INDEX].RecipeId" value="@Model.Recipes.Id" />

                    <div class="col-12 col-md-1 d-flex flex-md-column gap-1 align-items-center justify-content-center">
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="moveStepRow(this, -1)" title="Schritt nach oben">
                            <i class="fa-solid fa-arrow-up"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="moveStepRow(this, 1)" title="Schritt nach unten">
                            <i class="fa-solid fa-arrow-down"></i>
                        </button>
                    </div>

                    <div class="col-3 col-md-2">
                         <label class="small text-muted fw-bold">Nr.</label>
                         <input type="number" class="form-control fw-bold text-center border-primary field-stepindex"
                                name="RecipeJoyinPreperationSteps[INDEX].StepIndex"
                                value="${currentCount}" required />
                    </div>

                    <div class="col-9 col-md-8">
                        <label class="small text-muted fw-bold d-md-none">Beschreibung</label>
                        <input type="text" class="form-control bg-light" value="${stepText}" readonly />
                    </div>

                    <div class="col-12 col-md-1 text-end">
                        <span class="text-muted d-none d-md-inline-block me-2" title="Ziehen zum Sortieren">
                            <i class="fa-solid fa-grip-lines"></i>
                        </span>
                        <button type="button" class="btn btn-outline-success btn-icon ms-auto mt-2 mt-md-0 me-2" onclick="acceptExistingStepRow(this)" title="Diesen Schritt akzeptieren">
                            <i class="fa-solid fa-check"></i>
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-icon ms-auto mt-2 mt-md-0" onclick="removeStepRow(this)">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </div>
            `;

            $(html).hide().appendTo('#newStepsList').fadeIn(400);
            lastAddedStep = { id: stepId, text: stepText };
            refreshLastEditedStepBox();
            recalcStepNumbers();
            refreshSandboxStepSelectionHighlight();
        }

        // Visuelle Nummern aktualisieren (falls man zwischendrin was löscht)
        function recalcStepNumbers() {
            $('#newStepsList .step-row').each(function(index) {
                $(this).find('.field-stepindex').val(index + 1);
            });
            refreshSandboxStepSelectionHighlight();
        }

        function acceptExistingStepRow(btn) {
            const row = $(btn).closest('.step-row');
            const stepId = row.data('step-id')?.toString();
            const stepText = row.find('input[type="text"]').val() || '';
            if (!stepId) {
                return;
            }

            acceptStepForActiveIngredient(stepId, stepText);
        }

        function moveStepRow(btn, direction) {
            const row = $(btn).closest('.step-row');
            if (direction < 0) {
                const prev = row.prev('.step-row');
                if (prev.length) prev.before(row);
            } else {
                const next = row.next('.step-row');
                if (next.length) next.after(row);
            }
            recalcStepNumbers();
        }

        let draggedStepRow = null;
        $('#newStepsList').on('dragstart', '.step-row', function(e) {
            draggedStepRow = this;
            e.originalEvent.dataTransfer.effectAllowed = 'move';
            $(this).addClass('opacity-50');
        });

        $('#newStepsList').on('dragend', '.step-row', function() {
            $(this).removeClass('opacity-50');
            draggedStepRow = null;
        });

        $('#newStepsList').on('dragover', '.step-row', function(e) {
            e.preventDefault();
            if (!draggedStepRow || draggedStepRow === this) return;
            const rect = this.getBoundingClientRect();
            const offset = e.originalEvent.clientY - rect.top;
            if (offset > rect.height / 2) {
                $(this).after(draggedStepRow);
            } else {
                $(this).before(draggedStepRow);
            }
            recalcStepNumbers();
        });

        $('#sandboxIngredientList').on('click', '.sandbox-ingredient-btn', function() {
            activeSandboxIngredientId = $(this).data('id')?.toString() || null;
            activeSandboxIngredientName = $(this).data('name')?.toString() || '';
            $('#sandboxIngredientList .sandbox-ingredient-btn').removeClass('active');
            $(this).addClass('active');
            $('#sandboxActiveIngredientLabel').text(activeSandboxIngredientName || 'Keine Zutat aktiv');
            loadSandboxStepsForActiveIngredient();
        });

        $('#sandboxUnboundSearch').on('input', function() {
            renderSandboxUnboundStepCandidates($(this).val());
        });

        $('#equipmentFilterBar').on('click', '.equipment-filter-btn', function() {
            $('#equipmentFilterBar .equipment-filter-btn').removeClass('active');
            $(this).addClass('active');
            activeEquipmentFilter = $(this).data('equipment')?.toString() || 'all';
            renderSandboxUnboundStepCandidates($('#sandboxUnboundSearch').val());
        });

        $('#btnRestoreLastDeletedStep').on('click', function() {
            if (!lastDeletedStep?.id) {
                return;
            }

            addJoinStep(lastDeletedStep.id, lastDeletedStep.text, { enforceIngredientPhaseUniqueness: false });
            lastDeletedStep = null;
            refreshLastEditedStepBox();
        });

        $('#btnRemoveLastAddedStep').on('click', function() {
            if (!lastAddedStep?.id) {
                return;
            }

            const targetRow = $('#newStepsList .step-row').filter(function() {
                return $(this).data('step-id')?.toString() === lastAddedStep.id.toString();
            }).last();

            if (!targetRow.length) {
                lastAddedStep = null;
                refreshLastEditedStepBox();
                return;
            }

            removeStepRow(targetRow.find('button[onclick^="removeStepRow"]'));
        });


        refreshLastEditedStepBox();
        // ----------------------------------------------------
        // WICHTIG: FORM SUBMIT VORBEREITUNG
        // ----------------------------------------------------
        // Hier reparieren wir die Indizes [0], [1], [3] -> [0], [1], [2]
        // Damit ASP.NET Core keine Daten verliert.
        function updateAllIndices() {
            // 1. Zutaten Indizes korrigieren
            $('#newIngredientsList .ingredient-row').each(function(index) {
                const row = $(this);
                row.find('input, select').each(function() {
                    if (this.name) {
                        this.name = this.name.replace(/\[.*?\]/, '[' + index + ']');
                    }
                });
            });

            // 2. Schritte Indizes korrigieren
            $('#newStepsList .step-row').each(function(index) {
                const row = $(this);
                // Auch gleich den StepIndex Input Value aktualisieren
                row.find('.field-stepindex').val(index + 1);

                row.find('input, select').each(function() {
                    if (this.name) {
                        this.name = this.name.replace(/\[.*?\]/, '[' + index + ']');
                    }
                });
            });

            // true zurückgeben damit der Submit weiterläuft
            return true;
        }
    </script>
}
