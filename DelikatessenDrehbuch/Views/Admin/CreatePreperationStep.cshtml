<div class="recipe-card minWidth90 mobieleWidth90 mx-auto" style="border-left-color: #0d6efd;">
    <h3 class="section-title" style="color: #0d6efd;">
        <i class="fa-solid fa-list-check me-2"></i>Neuen Arbeitsschritt anlegen
    </h3>

    <p class="text-muted">Fülle die Felder aus und speichere den Schritt in der Datenbank.</p>

    <form asp-controller="Admin" asp-action="SavePreperationStep" method="post">

        <input type="hidden" name="Id" value="0" />

        <div class="card shadow-sm border-0 bg-light">
            <div class="card-body p-4">

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">
                            <span class="badge bg-dark me-2">DE</span> Deutsch
                        </label>
                        <textarea class="form-control shadow-sm" rows="3"
                                  name="Step_DE"
                                  placeholder="Zwiebeln fein würfeln..."
                                  required
                                  style="border-left: 4px solid #333;"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-primary">
                            <span class="badge bg-primary me-2">EN</span> English
                        </label>
                        <textarea class="form-control shadow-sm" rows="3"
                                  name="Step_EN"
                                  placeholder="Finely dice the onions..."
                                  style="border-left: 4px solid #0d6efd;"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-success">
                            <span class="badge bg-success me-2">PT</span> Português
                        </label>
                        <textarea class="form-control shadow-sm" rows="3"
                                  name="Step_PRT"
                                  placeholder="Pique a cebola finamente..."
                                  style="border-left: 4px solid #198754;"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-danger">
                            <span class="badge bg-danger me-2">ES</span> Español
                        </label>
                        <textarea class="form-control shadow-sm" rows="3"
                                  name="Step_ESP"
                                  placeholder="Picar la cebolla finamente..."
                                  style="border-left: 4px solid #dc3545;"></textarea>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-end align-items-center">
                    <button type="submit" class="btn btn-primary btn-lg px-5 shadow">
                        <i class="fa-solid fa-floppy-disk me-2"></i> Schritt Speichern
                    </button>
                </div>

            </div>
        </div>
    </form>
</div>