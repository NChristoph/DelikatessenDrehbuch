@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@model string

@{
    ViewData["Title"] = "Einkaufsliste";
    // Layout je nach Login-Zustand:
    Layout = SignInManager.IsSignedIn(User) ? "_Layout" : "_MinimalLayout";
}

@{
    // Robust parsen: jedes Item "Name;…;…;Kategorie"
    var rawItems = (Model ?? string.Empty)
        .Split('|', StringSplitOptions.RemoveEmptyEntries)
        .Select(s => s.Trim())
        .ToList();

    var parsed = rawItems
        .Select((s, i) =>
        {
            var parts = s.Split(';', StringSplitOptions.RemoveEmptyEntries)
                         .Select(p => p.Trim()).ToArray();

            var name = parts.ElementAtOrDefault(0) ?? "";
            var category = parts.Length >= 2 ? parts[^1] : "Sonstiges";
            var middle = parts.Length > 2
                ? string.Join(" ", parts.Skip(1).Take(parts.Length - 2)) // z.B. "400 g."
                : parts.ElementAtOrDefault(1) ?? "";

            return new {
                Index = i,
                Category = string.IsNullOrWhiteSpace(category) ? "Sonstiges" : category,
                Name = name,
                Details = middle
            };
        })
        .GroupBy(x => x.Category)
        .OrderBy(g => g.Key);
}

<style>
  /* Layout: Liste links, Ads rechts */
  .shop-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
  }
  @@media (min-width: 992px) {
      .shop-grid { grid-template-columns: 2fr 1fr; }
  }

  /* Karten / Gruppen */
  .shop-group {
      background: #fff;
      border: 1px solid rgba(0,0,0,.08);
      border-radius: 12px;
      box-shadow: 0 2px 10px rgba(0,0,0,.04);
      overflow: hidden;
  }
  .shop-group h5 {
      margin: 0;
      padding: 10px 14px;
      background: #FEFFF1;
      border-bottom: 1px solid rgba(0,0,0,.06);
      font-weight: 800;
  }

  /* Einträge */
  .shop-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      border-top: 1px solid rgba(0,0,0,.04);
  }
  .shop-item:first-of-type { border-top: 0; }

  .shop-item label {
      display: flex;
      align-items: baseline;
      gap: 8px;
      width: 100%;
      margin: 0;
      cursor: pointer;
  }

  .shop-name { font-weight: 700; }
  .shop-details { color: #555; }

  /* Abgehakt-Zustand */
  .shop-item.done { opacity: .6; }
  .shop-item.done .shop-name { text-decoration: line-through; }

  /* Ad-Slots */
  .ad-col { display: grid; gap: 16px; }
  .ad-slot {
      min-height: 120px;
      background: #f7f7f7;
      border: 1px dashed #ccc;
      border-radius: 10px;
      display: grid;
      place-items: center;
      color: #777;
      font-size: .95rem;
  }
</style>

<div class="shop-grid">
  <!-- Linke Spalte: gruppierte Einkaufsliste -->
  <div>
    @foreach (var group in parsed)
    {
        var safeKey = Regex.Replace(group.Key ?? "Sonstiges", @"\W+", "_"); // ID-safe
        <div class="shop-group mb-3">
            <h5>@group.Key</h5>
            @foreach (var item in group)
            {
                var checkboxId = $"chk_{safeKey}_{item.Index}";
                <div class="shop-item" data-key="@checkboxId">
                    <input type="checkbox" id="@checkboxId" class="shop-check" />
                    <label for="@checkboxId">
                        <span class="shop-name">@item.Name</span>
                        @if (!string.IsNullOrWhiteSpace(item.Details))
                        {
                            <span class="shop-details">– @item.Details</span>
                        }
                    </label>
                </div>
            }
        </div>
    }
  </div>

  <!-- Rechte Spalte: 1–3 Anzeigen -->
  <aside class="ad-col">
      <div class="ad-slot">
          <!-- Ad 1: hier deinen AdSense/HTML-Code einfügen -->
          Anzeige 1
      </div>
      <div class="ad-slot">Anzeige 2</div>
      <div class="ad-slot">Anzeige 3</div>
  </aside>
</div>

<script>
  // Persistentes Abhaken je Seite (Token steckt in der URL)
  (function(){
    const storageKey = "shopping-checks:" + location.pathname;
    const state = JSON.parse(localStorage.getItem(storageKey) || "{}");

    document.querySelectorAll('.shop-item').forEach(row => {
      const key = row.getAttribute('data-key');
      const chk = row.querySelector('.shop-check');
      if (state[key]) { chk.checked = true; row.classList.add('done'); }
      chk.addEventListener('change', () => {
        state[key] = chk.checked;
        row.classList.toggle('done', chk.checked);
        localStorage.setItem(storageKey, JSON.stringify(state));
      });
    });
  })();
</script>
