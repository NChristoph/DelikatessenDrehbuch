                        Einkaufsliste erstellen!
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content mt-3">
           @*  <div class="tab-pane fade show active"
                 id="zutatenGesamt"
                 role="tabpanel"
                 style="padding:2%;">
                <div id="ingredientPartialView"
                     class="p-2 mobieleWidth80"
                     style="min-width:40%;">
                    @Html.Partial("~/Views/MealPlaner/_createMealPlanIngredientPartialView.cshtml", allIngredients)
                </div>
            </div> *@

            <div class="tab-pane fade"
                 id="einkaufsliste"
                 role="tabpanel"
                 style="padding:2%;">
                <div id="ShoppingList"
                     class="p-2 mobieleWidth80"
                     style="min-width:40%;">
                    <div class="text-center p-3">
                        <div class="spinner-border text-danger" role="status"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Funktion zum Laden des Rezepts via AJAX
        function loadRecipe(id) {
            // Prüfen ob schon Inhalt da ist, um unnötige Requests zu vermeiden
            var container = $("#recipeContainer_" + id);

            // Lade-Animation anzeigen
            container.html('<div class="d-flex justify-content-center p-3"><div class="spinner-border text-danger"></div></div>');

            $.ajax({
                url: "/CreateNewMealPlan/LoadMealPlanRecipesPartialView",
                type: "GET",
                data: {
                    id: id,
                    personCount: @personCount
                },
                success: function (html) {
                    container.html(html);
                    // Falls Zutaten separat geladen werden müssen:
                    loadMealPlanerIngredients(id);
                },
                error: function () {
                    container.html("<div class='text-danger p-3'>Fehler beim Laden des Rezepts.</div>");
                }
            });
        }

        // Optional: Falls Zutaten separat geladen werden
        function loadMealPlanerIngredients(recipeId) {
            var target = $("#Ingredient_" + recipeId);
            if(target.length === 0) return;

            $.ajax({
                url: "/CreateNewMealPlan/LoadMealPlanerIngredients",
                type: "GET",
                data: {
                    id: recipeId,
                    personCount: @personCount
                },
                success: function (html) {
                    target.html(html);
                },
                error: function () {
                    target.html("<div class='text-danger'>Fehler beim Laden.</div>");
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Event Listener für alle Offcanvas mit name="Recipes"
            var offcanvasList = document.querySelectorAll('div[name="Recipes"]');

            offcanvasList.forEach(function (off) {
                off.addEventListener('shown.bs.offcanvas', function () {
                    var id = off.getAttribute('data-id');
                    if (!id) return;

                    var container = document.getElementById('recipeContainer_' + id);

                    // Nur laden, wenn noch kein "echter" Inhalt da ist (z.B. nur Spinner oder leer)
                    // Wir prüfen grob auf Länge oder Inhalt
                    if (container && (!container.innerHTML.includes('recipe-detail-wrapper'))) {
                        // 'recipe-detail-wrapper' ist ein Beispiel, nimm eine Klasse die deine PartialView sicher hat
                        // Oder einfacher:
                        loadRecipe(id);
                    }
                });
            });
        });
    </script>

    <script>
        // Thumbnails Logic (Mobile Carousel)
        document.addEventListener('click', function (e) {
            const t = e.target.closest('.thumb');
            if (!t) return;

            const idx = parseInt(t.getAttribute('data-slide-to'), 10);
            const targetSel = t.getAttribute('data-bs-target');
            const carouselEl = document.querySelector(targetSel);
            if (!carouselEl || Number.isNaN(idx)) return;

            const thumbsWrap = t.parentElement;
            thumbsWrap.querySelectorAll('.thumb').forEach(x => x.classList.remove('active'));
            t.classList.add('active');

            const bsCarousel = bootstrap.Carousel.getOrCreateInstance(carouselEl, {
                interval: false,
                touch: true,
                wrap: true
            });
            bsCarousel.to(idx);
        });

        // Sync Thumbnail beim Sliden
        document.querySelectorAll('.carousel').forEach(c => {
            c.addEventListener('slid.bs.carousel', function (ev) {
                const carouselId = c.id;
                const thumbs = document.querySelector(`.thumbs[data-for="${carouselId}"]`);
                if (!thumbs) return;

                const activeIndex = ev.to;
                thumbs.querySelectorAll('.thumb').forEach((th, i) => {
                    th.classList.toggle('active', i === activeIndex);
                });
            });
        });

        // Einkaufsliste Tab Logic
        var shoppingListLoaded = false;
        var shoppingTab = document.querySelector('button[data-bs-target="#einkaufsliste"]');

        if(shoppingTab){
            shoppingTab.addEventListener('shown.bs.tab', function (event) {
                // Nur einmal laden
                if(!shoppingListLoaded){
                     $('#ShoppingList').load("/CreateNewMealPlan/GetShoppingList", function(response, status, xhr){
                         if(status == "error") {
                             $('#ShoppingList').html("Fehler beim Laden der Einkaufsliste.");
                         } else {
                             shoppingListLoaded = true;
                         }
                     });
                }
            });
        }
    </script>
}