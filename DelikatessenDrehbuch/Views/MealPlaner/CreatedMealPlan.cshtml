@using DelikatessenDrehbuch.Models
@using DelikatessenDrehbuch.StaticScripts
@model Dictionary<int, List<PersonalMealPlanRecipeModel>>
@using DelikatessenDrehbuch.Services.Interfaces
@inject ISessionService _sessionService

@{
    var personCount = (int)ViewData["personCount"];
   
}


<input type="number" id="personCount" value="@personCount" hidden />

<style>
    /* ===== Grid/Karten (Desktop) ===== */
    .meal-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 1rem
    }

    @@media (max-width: 991.98px) {
        .meal-grid {
            display: none
        }
    }

    .meal-card {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: .75rem;
        overflow: hidden;
        background: #fff;
        transition: transform .15s,box-shadow .15s;
        cursor: pointer
    }

        .meal-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(0,0,0,.08)
        }

        .meal-card img {
            width: 100%;
            height: 190px;
            object-fit: cover;
            background: #f6f6f6;
            display: block
        }

        .meal-card .body {
            padding: .75rem .9rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: .75rem
        }

        .meal-card h5 {
            margin: 0;
            font-size: 1rem;
            font-weight: 700;
            color: #2a3440;
            line-height: 1.2
        }

    /* ===== Mobile: Tages-Karussell ===== */
    .day-wrap {
        margin: 1.25rem auto;
        max-width: 1100px
    }

    .day-title {
        display: block;
        text-align: center;
        font-weight: 800;
        margin: .25rem 0 .75rem 0
    }

    .carousel-wrap {
        max-width: 90%;
        min-width: 90%;
        margin: 0 auto
    }

    @@media (min-width: 992px) {
        .carousel-wrap {
            display: none
        }
    }

    .carousel-item .k-hero {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: .75rem;
        overflow: hidden;
        background: #fff
    }

    .carousel-item img {
        width: 100%;
        height: 210px;
        object-fit: cover;
        display: block
    }

    .carousel-item .k-body {
        padding: .65rem .8rem;
        display: flex;
        justify-content: space-between;
        align-items: center
    }

    .carousel-item h6 {
        margin: 0;
        font-weight: 700
    }

    .thumbs {
        display: flex;
        gap: .5rem;
        justify-content: center;
        margin-top: .5rem;
        flex-wrap: wrap
    }

    .thumb {
        width: 80px;
        height: 60px;
        border: 2px solid transparent;
        border-radius: .5rem;
        overflow: hidden;
        cursor: pointer
    }

        .thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block
        }

        .thumb.active {
            border-color: #D4AF37
        }

    /* ===== Offcanvas Breite ===== */
    .offcanvas.meal-offcanvas {
        width: min(720px,90vw)
    }

    @@media (min-width:992px) {
        .offcanvas.meal-offcanvas {
            width: 50vw
        }
    }

    @@media (max-width:992px) {
        .desktopHidden {
            display: none;
        }
    }

    /* ===== Zutaten-Button pro Tag ===== */
    .day-actions {
        display: flex;
        justify-content: center;
        margin-top: .75rem
    }
</style>

<div class="flexColumn w-100 flexAlginItemCenter">

    @foreach (var dayKey in Model.Keys.OrderBy(k => k))
    {
        var list = Model[dayKey];
        var ids = list.Select(r => r.Id).ToList();

        <hr class="w-75" style="height:2px" />
        <span class="day-title">Rezepte für Tag @dayKey</span>

        <!-- Desktop: 3 Spalten Grid -->
        <div class="meal-grid w-100">
            @foreach (var item in list)
            {
                var r = item.Recipes;
                var unifiedOffId = $"MealPlanCanvas_{item.Id}"; // EINHEITLICHE ID
                var img = string.IsNullOrWhiteSpace(r?.ImagePath) ? "/images/placeholder_recipe.webp" : r.ImagePath;

                <div class="meal-card"
                     role="button"
                     data-bs-toggle="offcanvas"
                     data-bs-target="#@unifiedOffId"
                     aria-controls="@unifiedOffId">
                    <img src="@img" alt="@r?.Name" loading="lazy" />
                    <div class="body">
                        <h5 title="@r?.Name">@r?.Name</h5>
                        <button type="button" class="btn btn-sm bgRed Border-Gold" style="color:white">Öffnen</button>
                    </div>
                </div>
            }
        </div>

        <!-- Mobile: Carousel + Thumbnails -->
        <div class="day-wrap carousel-wrap">
            @{
                var carouselId = $"dayCarousel_{dayKey}";
            }
            <div id="@carouselId" class="carousel slide">
                <div class="carousel-inner">
                    @{
                        var first = true;
                        foreach (var item in list)
                        {
                            var r = item.Recipes;
                            var unifiedOffId = $"MealPlanCanvas_{item.Id}"; // GLEICHE ID WIE DESKTOP
                            var img = string.IsNullOrWhiteSpace(r?.ImagePath) ? "/images/placeholder_recipe.webp" : r.ImagePath;

                            <div class="carousel-item @(first ? "active" : "")">
                                <div class="k-hero"
                                     role="button"
                                     data-bs-toggle="offcanvas"
                                     data-bs-target="#@unifiedOffId"
                                     aria-controls="@unifiedOffId">
                                    <img src="@img" alt="@r?.Name" />
                                    <div class="k-body">
                                        <h6>@r?.Name</h6>
                                    </div>
                                </div>
                            </div>

                            first = false;
                        }
                    }
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Zurück</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Weiter</span>
                </button>
            </div>

            <!-- Thumbnails -->
            <div class="thumbs" data-for="@carouselId">
                @{
                    var idx = 0;
                    foreach (var item in list)
                    {
                        var img = string.IsNullOrWhiteSpace(item.Recipes?.ImagePath) ? "/images/placeholder_recipe.webp" : item.Recipes.ImagePath;
                        <div class="thumb @(idx == 0 ? "active" : "")" data-slide-to="@idx" data-bs-target="#@carouselId">
                            <img src="@img" alt="@item.Recipes?.Name" />
                        </div>
                        idx++;
                    }
                }
            </div>
        </div>

        <!-- NUR EINMAL: Offcanvas pro Rezept (wird von Desktop UND Mobile verwendet) -->
        @foreach (var item in list)
        {
            var unifiedOffId = $"MealPlanCanvas_{item.Id}";

            <div class="offcanvas offcanvas-start meal-offcanvas mobieleWidth100 tableteSize75"
                 tabindex="-1"
                 id="@unifiedOffId"
                 aria-labelledby="offcanvasLabel_@unifiedOffId"
                 name="Recipes"
                 data-id="@item.Id">
                <div class="offcanvas-header">
                    <img class="grid-Logo" src="/css/Logo/DelikatessenDrehbuch_Logo_Ohne hintergrund.png" style="max-height:80px;object-fit:contain" />
                    <div class="grid-Name" style="color:#D4AF37;font-size:14px">Delikatessen Drehbuch</div>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body w-100" id="MealPlaner_@item.Id">
                    <script>
                        document.addEventListener("DOMContentLoaded", function () {
                            LoadRecipes('MealPlaner_',@item.Id);
                        });
                    </script>
                </div>
            </div>
        }

       
            var idsCsv = string.Join(";", Model[dayKey].Select(x => x.Id));
            var ingOffId = $"Ingredients_Day_{dayKey}";
       

        <input type="hidden" id="Ingredient_@dayKey" value="@idsCsv" />

        <div class="day-actions">
            <button class="btn bgRed Border-Gold"
                    style="color:white"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#@ingOffId"
                    aria-controls="@ingOffId">
                Zutaten für Tag @dayKey
            </button>
        </div>

        <div class="offcanvas offcanvas-start meal-offcanvas mobieleWidth100 tableteSize75"
             tabindex="-1"
             id="@ingOffId"
             aria-labelledby="offcanvasLabel_@ingOffId"
             data-day="@dayKey">
            <div class="offcanvas-header">
                <img class="grid-Logo" src="/css/Logo/DelikatessenDrehbuch_Logo_Ohne hintergrund.png"
                     style="max-height:80px;object-fit:contain" />
                <div class="grid-Name" style="color:#D4AF37;font-size:14px">Delikatessen Drehbuch</div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body Border-Gold w-100">
                <span class="w-100 mt-2 mb-3 text-center d-block">
                    <strong>Einkaufsliste – Tag @dayKey</strong>
                </span>
                <div id="ingredient_@dayKey"></div>
                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                          ReloadIngredientList('ingredient_@dayKey',null,'@idsCsv');
                    });
                </script>
            </div>
        </div>

    }
    <hr class="w-75" />

    <!-- Gesamtliste (optional beibehalten) -->
    <button class="btn bgRed Border-Gold mb-2 w-50 mobieleWidth90 mobileCenter"
            style="color:white;max-width:90%"
            type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#Gesamte_ZutatenListe"
            aria-controls="Gesamte_ZutatenListe">
        Gesamte Zutatenliste
    </button>
</div>

<!-- Offcanvas: Gesamte Zutatenliste -->
<div class="offcanvas offcanvas-start meal-offcanvas mobieleWidth100 tableteSize75"
     tabindex="-1"
     id="Gesamte_ZutatenListe"
     aria-labelledby="offcanvasExampleLabel">
    <div class="offcanvas-header">
        <img class="grid-Logo" src="/css/Logo/DelikatessenDrehbuch_Logo_Ohne hintergrund.png" style="max-height:80px;object-fit:contain" />
        <div class="grid-Name" style="color:#D4AF37;font-size:14px">Delikatessen Drehbuch</div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body Border-Gold w-100">
        <span class="w-100 mt-2 mb-3 text-center d-block"><strong>Einkaufsliste – gesamt</strong></span>
        <div class="d-flex flex-wrap justify-content-center">
            <div id="ingredientPartialView" class="p-2 mobieleWidth80" style="min-width:40%"></div>
        </div>
    </div>
</div>



@section Scripts {

    <script type="text/javascript">

        function LoadRecipes(spawn,id)
        {
             $.get("/CreateNewMealPlan/GetRecipe", {
            recipeId: id
        })
        .done(function (html) {
            $("#"+spawn+id).append(html);
        });
        }

    </script>

    <script>


               // Thumbnails steuern das zugehörige Carousel
        document.addEventListener('click', function(e){
            const t = e.target.closest('.thumb');
            if(!t) return;

            const idx = parseInt(t.getAttribute('data-slide-to'), 10);
            const targetSel = t.getAttribute('data-bs-target'); // Bootstrap 5: data-bs-target
            const carouselEl = document.querySelector(targetSel);
            if(!carouselEl || Number.isNaN(idx)) return;

            // Aktive Thumbnail aktualisieren
            const thumbsWrap = t.parentElement;
            thumbsWrap.querySelectorAll('.thumb').forEach(x => x.classList.remove('active'));
            t.classList.add('active');

            // Carousel zu gewünschtem Slide bewegen
            const bsCarousel = bootstrap.Carousel.getOrCreateInstance(carouselEl, {
                interval: false,
                touch: true, // Touch-Navigation erlauben
                wrap: true   // Endlos-Navigation
            });
            bsCarousel.to(idx);
        });

        // Beim Slide aktive Thumbnail synchronisieren
        document.querySelectorAll('.carousel').forEach(c => {
            c.addEventListener('slid.bs.carousel', function(ev){
                const carouselId = c.id;
                const thumbs = document.querySelector(`.thumbs[data-for="${carouselId}"]`);
                if(!thumbs) return;

                const activeIndex = ev.to;
                thumbs.querySelectorAll('.thumb').forEach((th, i) => {
                    th.classList.toggle('active', i === activeIndex);
                });
            });
        });





        /* ==== 4) Zutaten-Offcanvas pro Tag laden ==== */
        document.querySelectorAll('[id^="Ingredients_Day_"]').forEach(off => {
          off.addEventListener('shown.bs.offcanvas', function(){
            const day = off.getAttribute('data-day');
            const target = off.querySelector('#ingredientPartialView_Day_' + day);
            if(!target) return;

            const hidden = document.getElementById('Ingredient_' + day);
            const recipesIds = hidden ? hidden.value : '';
            const personCountInput = document.getElementById('personCount');
            const personCount = personCountInput ? personCountInput.value : 1;

            if (!recipesIds) {
              target.innerHTML = '<div class="text-muted">Keine Rezepte für diesen Tag gefunden.</div>';
              return;
            }

            $.get('/CreateNewMealPlan/LoadIngredientPartialView', {
              recipesIds: recipesIds,
              personCount: @personCount
            })
            .done(function(html){ $(target).html(html); })
            .fail(function(){
              if (typeof ReloadIngredientList === 'function') {
                ReloadIngredientList();
                const global = document.getElementById('ingredientPartialView');
                target.innerHTML = global ? global.innerHTML : '<div class="text-muted">Zutaten konnten nicht geladen werden.</div>';
              } else {
                target.innerHTML = '<div class="text-muted">Zutaten konnten nicht geladen werden.</div>';
              }
            });
          });
        });

        /* ==== 5) Gesamtliste beim Öffnen laden ==== */
        document.getElementById('Gesamte_ZutatenListe')
          ?.addEventListener('shown.bs.offcanvas', function(){
            if (typeof ReloadIngredientList === 'function') ReloadIngredientList();
          });
    </script>
}

