@using DelikatessenDrehbuch.Models
@using DelikatessenDrehbuch.StaticScripts

@model List<MealPlanerModel>

@{
    var personCount = (int)ViewData["PersonCount"];
}

<style>
    /* ===========================
                   MealPlan Übersicht – Styles
                   =========================== */

    .meal-slot-row {
        display: flex;
        flex-wrap: wrap;
    }

    .meal-plan-card {
        min-width: 260px;
        background: #fff;
        border: 1px solid rgba(0,0,0,.08);
        border-radius: .75rem;
        overflow: visible;
        box-shadow: 0 1px 6px rgba(0,0,0,.06);
        transition: transform .15s, box-shadow .15s;
        position: relative;
    }

        /* Header */
        .meal-plan-card .card-header {
            background: #FEFFF2;
            border-bottom: 1px solid rgba(0,0,0,.07);
            padding: .75rem 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

    /* Buttons */
    .meal-plan-btn {
        background: #770f0f;
        color: white;
        border: 1px solid #D4AF37;
        padding: .35rem .75rem;
        border-radius: .45rem;
        font-size: .85rem;
        font-weight: 600;
        transition: .2s;
    }

        .meal-plan-btn:hover {
            background: #5e0c0c;
            color: #fff;
        }



    .recipe-card {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: .9rem;
        overflow: hidden;
        background: #fff;
        transition: transform .15s, box-shadow .15s
    }

        .recipe-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(0,0,0,.08)
        }

    /* Bild + Overlay */
    .recipe-media {
        position: relative
    }

        .recipe-media img {
            width: 100%;
            height: 240px;
            object-fit: cover;
            display: block
        }

    .recipe-chip {
        position: absolute;
        left: .6rem;
        bottom: .6rem;
        display: flex;
        gap: .4rem;
        flex-wrap: wrap
    }

    .chip {
        background: rgba(0,0,0,.65);
        color: #fff;
        padding: .25rem .5rem;
        border-radius: .5rem;
        font-size: .8rem
    }

    /* Body */
    .recipe-body {
        padding: .8rem .9rem
    }

    .recipe-title {
        margin: 0 0 .35rem;
        font-weight: 800;
        font-size: 1rem;
        color: #1f2a37;
        line-height: 1.25
    }

    .recipe-meta {
        display: flex;
        gap: .6rem;
        align-items: center;
        color: #556;
        opacity: .9;
        font-size: .9rem
    }

    /* Platzhalterbild */
    .ph {
        background: #f4f4f4;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #888
    }

   
    /* Mobile Anpassung */
    @@media (max-width: 768px) {
        .meal-slot-row {
            flex-direction: column;
            align-items: center;
        }

        .meal-plan-card {
            width: 100% !important;
        }
    }
</style>



<div id="mealStepsCarousel" class="carousel slide mb-4" data-bs-ride="carousel" style="min-height:150px">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <div class="card p-3">
                <h6 class="fw-bold text-danger">Gerichtsauswahl</h6>
                <p>Wähle für jeden Tag deine Vorspeise, Hauptspeise und Dessert aus.</p>
            </div>
        </div>
        <div class="carousel-item">
            <div class="card p-3">
                <h6 class="fw-bold text-danger">Überblick</h6>
                <p>Sortiere deine Tage, ändere die Reihenfolge oder überprüfe dein Menü visuell.</p>
            </div>
        </div>
        <div class="carousel-item">
            <div class="card p-3">
                <h6 class="fw-bold text-danger">Zutaten</h6>
                <p>Sieh alle benötigten Zutaten auf einen Blick – perfekt zur Vorbereitung.</p>
            </div>
        </div>
        @*  <div class="carousel-item">
            <div class="card p-3">
                <h6 class="fw-bold text-danger">Schritt 4: Einkaufsliste</h6>
                <p>Nach dem Erstellen des Plans bekommst du deine Einkaufsliste automatisch.</p>
            </div>
        </div> *@
    </div>
</div>



@{
    <input id="personCount" value="@personCount" hidden/>
    var groupedPerDays = Model.GroupBy(x => x.Index).OrderBy(x => x.Key).ToList();
    foreach (var dayGroupe in groupedPerDays)
    {
        <hr />
        <h4 class="mt-4 mb-2 w-100" style="text-align:center">Tag @dayGroupe.Key</h4>
        <div class="meal-slot-row m-1">
            @foreach (var slot in dayGroupe)
            {
                <div class="card meal-plan-card w-25 m-1">
                    <div class="card-header row">
                        <button class="meal-plan-btn"
                                data-name="apperetizer_"
                                data-index="@slot.Index"
                                data-id="@(slot.Recipes.Category=="Vorspeise"?@slot.Recipes.Id:0)"
                                data-category="Vorspeise"
                                onclick="ChangeOrAddRecipe(this)"
                                style="max-width:max-content;margin-left:auto;">
                            Hinzufügen
                        </button>
                    </div>

                    <div id="apperetizer_@slot.Index">
                        @if (slot.Recipes.Category.Trim() == "Vorspeise")
                        {
                            <input name="RecipeId"
                                   class="meal-plan-input"
                                   value="@slot.Recipes.Id"
                                   data-day-index="@slot.Index"
                                   type="number"
                                   hidden />
                            

                            <div class="recipe-media">
                                @if (!string.IsNullOrEmpty(slot.Recipes.ImagePath))
                                {
                                    <div class="dropdown">
                                        <picture data-bs-toggle="dropdown">
                                            <img class=""
                                                 src="@slot.Recipes.ImagePath" />
                                        </picture>
                                        <ul class="dropdown-menu w-100">
                                            <li>@Html.Raw(slot.Recipes.Description)</li>
                                        </ul>
                                    </div>

                                }
                                else
                                {
                                    <div class="ph" style="aspect-ratio:3/2">Kein Bild</div>
                                }

                                <div class="recipe-chip">
                                    @if (slot.Recipes.PreparationTime != null)
                                    {
                                        <span class="chip">@slot.Recipes.PreparationTime&nbsp;min</span>
                                    }

                                    @if (slot.Recipes.LikeCount > 0)
                                    {
                                        <span class="chip">❤ @slot.Recipes.LikeCount</span>
                                    }
                                    <span class="chip">Beschreibung öffnen</span>
                                </div>
                            </div>

                            <div class="recipe-body">
                                <h3 class="recipe-title">@slot.Recipes.Name</h3>
                            </div>

                        }
                    </div>
                   
                    
                </div>
                <div class="card meal-plan-card w-25 m-1">
                    <div class="card-header row">
                        <button class="meal-plan-btn"
                                data-name="main_"
                                data-index="@slot.Index"
                                data-id="@slot.Recipes.Id"
                                data-category="Hauptspeise"
                                onclick="ChangeOrAddRecipe(this)"
                                style="max-width:max-content;margin-left:auto;">
                            Ändern
                        </button>
                    </div>
                    @if (slot.Recipes.Category.Trim() == "Hauptspeise")
                    {
                        <input name="RecipeId"
                               class="meal-plan-input"
                               value="@slot.Recipes.Id"
                               data-day-index="@slot.Index"
                               type="number"
                               hidden />
                       <div id="main_@slot.Index">
                            <div class="recipe-media">
                                @if (!string.IsNullOrEmpty(slot.Recipes.ImagePath))
                                {
                                    <div class="dropdown">
                                        <picture data-bs-toggle="dropdown">
                                            <img class=""
                                                 src="@slot.Recipes.ImagePath" />
                                        </picture>
                                        <ul class="dropdown-menu w-100">
                                            <li>@Html.Raw(slot.Recipes.Description)</li>
                                        </ul>
                                    </div>

                                }
                                else
                                {
                                    <div class="ph" style="aspect-ratio:3/2">Kein Bild</div>
                                }

                                <div class="recipe-chip">
                                    @if (slot.Recipes.PreparationTime != null)
                                    {
                                        <span class="chip">@slot.Recipes.PreparationTime&nbsp;min</span>
                                    }

                                    @if (slot.Recipes.LikeCount > 0)
                                    {
                                        <span class="chip">❤ @slot.Recipes.LikeCount</span>
                                    }
                                    <span class="chip">Beschreibung öffnen</span>
                                </div>
                            </div>

                            <div class="recipe-body">
                                <h3 class="recipe-title">@slot.Recipes.Name</h3>
                            </div>
                       </div>
                  
                    }
                </div>
                <div class="card meal-plan-card w-25 m-1">
                    <div class="card-header row">
                        <button class="meal-plan-btn"
                                data-name="dessert_"
                                data-index="@slot.Index"
                                data-id="@(slot.Recipes.Category == "Dessert" ? @slot.Recipes.Id : 0)"
                                data-category="Dessert"
                                onclick="ChangeOrAddRecipe(this)"
                                style="max-width:max-content;margin-left:auto;">
                            Hinzufügen
                        </button>
                    </div>
                    <div id="dessert_@slot.Index">
                        @if (slot.Recipes.Category.Trim() == "Dessert")
                        {
                            <input name="RecipeId"
                                   class="meal-plan-input"
                                   value="@slot.Recipes.Id"
                                   data-day-index="@slot.Index"
                                   type="number"
                                   hidden />
                            <div class="recipe-media">
                                @if (!string.IsNullOrEmpty(slot.Recipes.ImagePath))
                                {
                                    <div class="dropdown">
                                        <picture data-bs-toggle="dropdown">
                                            <img class=""
                                                 src="@slot.Recipes.ImagePath" />
                                        </picture>
                                        <ul class="dropdown-menu w-100">
                                            <li>@Html.Raw(slot.Recipes.Description)</li>
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <div class="ph" style="aspect-ratio:3/2">Kein Bild</div>
                                }

                                <div class="recipe-chip">
                                    @if (slot.Recipes.PreparationTime != null)
                                    {
                                        <span class="chip">@slot.Recipes.PreparationTime&nbsp;min</span>
                                    }

                                    @if (slot.Recipes.LikeCount > 0)
                                    {
                                        <span class="chip">❤ @slot.Recipes.LikeCount</span>
                                    }
                                    <span class="chip">Beschreibung öffnen</span>
                                </div>
                            </div>

                            <div class="recipe-body">
                                <h3 class="recipe-title">@slot.Recipes.Name</h3>
                            </div>

                        }
                    </div>
                   
                </div>

            }
        </div>


    }
}

<div class="mt-3">
    <button class="btn bgRed Border-Gold" style="color:white" onclick="createMealPlan()">
        Essensplan Erstellen!
    </button>
</div>



@section Scripts {
    <script src="/js/CreateNewMealPlan.js" asp-append-version="true"></script>
}
