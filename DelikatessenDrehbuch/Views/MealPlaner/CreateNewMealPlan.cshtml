@using DelikatessenDrehbuch.Models
@using DelikatessenDrehbuch.StaticScripts

@model List<MealPlanerModel>

@{
    var personCount = (int)ViewData["PersonCount"];
}

<input id="personCount" value="@personCount" hidden />

<style>
    /* ===========================
           Delikatessen Tab Styles
           =========================== */

    /* Container für einen Tag */
    .day-container {
        background: #fff;
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1rem;
        padding: 1.5rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        margin-bottom: 3rem;
    }

    .day-header {
        text-align: center;
        margin-bottom: 1.5rem;
        border-bottom: 2px solid #FEFFF2;
        padding-bottom: 0.5rem;
    }

    .day-title {
        font-family: 'Playfair Display', serif;
        color: #770f0f; /* Dunkelrot */
        font-weight: 700;
        font-size: 1.5rem;
        margin: 0;
    }

    /* Tabs Styling */
    .nav-pills .nav-link {
        color: #666;
        background: #fff;
        border: 1px solid #eee;
        margin: 0 5px 10px 5px; /* Abstand auch nach unten für Mobile */
        border-radius: 20px;
        padding: 8px 20px;
        font-size: 0.9rem;
        font-weight: 600;
        transition: all 0.2s;
    }

        .nav-pills .nav-link.active {
            background-color: #770f0f; /* Dunkelrot */
            color: #fff;
            border-color: #770f0f;
            box-shadow: 0 4px 10px rgba(119, 15, 15, 0.3);
        }

        .nav-pills .nav-link:hover:not(.active) {
            background-color: #fcfcfc;
            border-color: #D4AF37; /* Gold */
            color: #D4AF37;
        }

    /* Karten Design innerhalb der Tabs */
    .meal-tab-card {
        border: none;
        max-width: 500px; /* Begrenzte Breite für Desktop */
        margin: 0 auto; /* Zentrieren */
        background: #fff;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        transition: transform 0.2s;
    }

        .meal-tab-card:hover {
            transform: translateY(-2px);
        }

    /* Bild */
    .meal-img-wrapper {
        position: relative;
        height: 280px; /* Schön groß */
        overflow: hidden;
        background-color: #f8f9fa;
    }

        .meal-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s;
        }

    .meal-tab-card:hover .meal-img-wrapper img {
        transform: scale(1.03);
    }

    /* Chips (Zeit, Likes) über dem Bild */
    .meal-chips {
        position: absolute;
        bottom: 10px;
        left: 10px;
        display: flex;
        gap: 5px;
    }

    .meal-badge {
        background: rgba(0, 0, 0, 0.7);
        color: #fff;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        backdrop-filter: blur(4px);
    }

    /* Body */
    .meal-body {
        padding: 1.5rem;
        text-align: center;
    }

    .meal-title {
        font-weight: 800;
        color: #2a3440;
        margin-bottom: 0.5rem;
        font-size: 1.2rem;
    }

    .meal-actions {
        margin-top: 1rem;
        border-top: 1px solid #eee;
        padding-top: 1rem;
    }

    .btn-change {
        background-color: #fff;
        color: #770f0f;
        border: 1px solid #770f0f;
        padding: 0.4rem 1.2rem;
        border-radius: 2rem;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.2s;
    }

        .btn-change:hover {
            background-color: #770f0f;
            color: #fff;
        }

    /* Leerer Zustand */
    .empty-state {
        height: 280px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #999;
        background-color: #f9f9f9;
    }
</style>

<div id="mealStepsCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <div class="card p-4 border-0 shadow-sm text-center bg-light">
                <h5 class="fw-bold text-danger mb-2">Schritt 2: Dein Plan</h5>
                <p class="text-muted m-0">Hier kannst du jeden Gang einzeln anpassen. Klicke einfach auf die Tabs.</p>
            </div>
        </div>
    </div>
</div>

@{
    var groupedPerDays = Model.GroupBy(x => x.Index).OrderBy(x => x.Key).ToList();

    foreach (var dayGroupe in groupedPerDays)
    {
        var dayId = dayGroupe.Key;

        // Rezepte für diesen Tag isolieren
        var vorspeise = dayGroupe.FirstOrDefault(x => x.Recipes?.Category?.Trim() == "Vorspeise");
        var hauptspeise = dayGroupe.FirstOrDefault(x => x.Recipes?.Category?.Trim() == "Hauptspeise");
        var dessert = dayGroupe.FirstOrDefault(x => x.Recipes?.Category?.Trim() == "Dessert");

        <div class="container day-container">

            <div class="day-header">
                <h3 class="day-title">Tag @dayId</h3>
            </div>

            <ul class="nav nav-pills justify-content-center mb-4" id="pills-tab-@dayId" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pills-vor-@dayId-tab" data-bs-toggle="pill" data-bs-target="#pills-vor-@dayId" type="button" role="tab" aria-selected="false">
                        <i class="bi bi-egg-fill me-1"></i> Vorspeise
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pills-main-@dayId-tab" data-bs-toggle="pill" data-bs-target="#pills-main-@dayId" type="button" role="tab" aria-selected="true">
                        <i class="bi bi-basket2-fill me-1"></i> Hauptspeise
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pills-dessert-@dayId-tab" data-bs-toggle="pill" data-bs-target="#pills-dessert-@dayId" type="button" role="tab" aria-selected="false">
                        <i class="bi bi-cupcake-fill me-1"></i> Dessert
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="pills-tabContent-@dayId">

                <div class="tab-pane fade" id="pills-vor-@dayId" role="tabpanel">
                    @{
                        RenderRecipeCard(dayId, vorspeise, "Vorspeise", "apperetizer_");
                    }
                </div>

                <div class="tab-pane fade show active" id="pills-main-@dayId" role="tabpanel">
                    @{
                        RenderRecipeCard(dayId, hauptspeise, "Hauptspeise", "main_");
                    }
                </div>

                <div class="tab-pane fade" id="pills-dessert-@dayId" role="tabpanel">
                    @{
                        RenderRecipeCard(dayId, dessert, "Dessert", "dessert_");
                    }
                </div>

            </div>
        </div>
    }
}

<div class="text-center mb-5 mt-4">
    <button class="btn btn-lg bgRed Border-Gold shadow px-5 py-3" style="color:white; border-radius:3rem; font-weight:700;" onclick="createMealPlan()">
        <i class="bi bi-check-circle-fill me-2"></i> Essensplan Fertigstellen!
    </button>
</div>


@* ========================================================== 
   HELPER FUNKTION: Rendert EINE Karte (damit wir keinen Code kopieren müssen)
   ========================================================== *@
@functions {
    // WICHTIG: Das muss 'void' sein, nicht 'async Task', damit es im HTML-Flow gerendert wird.
    public void RenderRecipeCard(int dayIndex, MealPlanerModel slot, string category, string namePrefix)
    {
        var hasRecipe = slot != null;
        var recipeId = hasRecipe ? slot.Recipes.Id : 0;
        var divId = $"{namePrefix}{dayIndex}"; // z.B. main_1

        <div class="meal-tab-card">
            <div id="@divId">

                @if (hasRecipe)
                {
                    <input name="RecipeId" class="meal-plan-input" value="@recipeId" data-day-index="@dayIndex" type="number" hidden />

                    <div class="meal-img-wrapper">
                        @if (!string.IsNullOrEmpty(slot.Recipes.ImagePath))
                        {
                            <img src="@slot.Recipes.ImagePath" alt="@slot.Recipes.Name" loading="lazy" />
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="bi bi-image fs-1 mb-2"></i> Kein Bild
                            </div>
                        }

                        <div class="meal-chips">
                            @if (slot.Recipes.PreparationTime != null)
                            {
                                <span class="meal-badge"><i class="bi bi-clock"></i> @slot.Recipes.PreparationTime min</span>
                            }
                            @if (slot.Recipes.LikeCount > 0)
                            {
                                <span class="meal-badge"><i class="bi bi-heart-fill text-danger"></i> @slot.Recipes.LikeCount</span>
                            }
                        </div>
                    </div>

                    <div class="meal-body">
                        <h5 class="meal-title">@slot.Recipes.Name</h5>

                        @if (!string.IsNullOrEmpty(slot.Recipes.Description))
                        {
                            <p class="text-muted small text-truncate" style="max-width:300px; margin:0 auto;">
                                @Html.Raw(slot.Recipes.Description)
                            </p>
                        }

                        <div class="meal-actions">
                            <button class="btn btn-change"
                                    data-name="@namePrefix"
                                    data-index="@dayIndex"
                                    data-id="@recipeId"
                                    data-category="@category"
                                    onclick="ChangeOrAddRecipe(this)">
                                <i class="bi bi-arrow-repeat me-1"></i> Ändern
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-plus-circle display-1 mb-3 text-secondary opacity-25"></i>
                        <h5 class="text-muted">Kein Gericht ausgewählt</h5>

                        <div class="mt-3">
                            <button class="btn btn-lg btn-primary shadow-sm"
                                    style="border-radius:2rem; background-color:#D4AF37; border:none;"
                                    data-name="@namePrefix"
                                    data-index="@dayIndex"
                                    data-id="0"
                                    data-category="@category"
                                    onclick="ChangeOrAddRecipe(this)">
                                <i class="bi bi-plus-lg me-1"></i> @category hinzufügen
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

@section Scripts {
    <script src="/js/CreateNewMealPlan.js" asp-append-version="true"></script>
}