@using DelikatessenDrehbuch.StaticScripts
@using DelikatessenDrehbuch.Models
@model (int id,int index,string name,string description,string imagePath,int preparationTime)
@{
   

    var subPath = FrontendFunctions.CaseInsensitivePath(Model.imagePath);
    var smallImg = subPath?.Replace(Environment.GetEnvironmentVariable("BigPic"),
                                    Environment.GetEnvironmentVariable("SmalPic")) + "_small.webp";
}

<style>
    /* ===== Mini-Recipe-Card (scoped by class prefix mrc-) ===== */
    .mrc-card {
        --radius: 14px;
        --shadow: 0 4px 14px rgba(0,0,0,.10);
        --border: 1px solid rgba(0,0,0,.06);
        background: #fff;
        border: var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
        width: 100%;
    }

    .mobile {
        display: none !important;
    }


    .mrc-row {
        display: flex;
        gap: 1rem;
        align-items: stretch;
        flex-direction: column !important;
    }

    .mrc-media {
        width: 100%;
        min-width: auto;
        background: #f5f5f5;
        position: relative;
    }

        .mrc-media img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            aspect-ratio: 3/2;
        }

    .mrc-badges {
        position: absolute;
        left: .6rem;
        bottom: .6rem;
        display: flex;
        gap: .4rem;
    }

    .mrc-chip {
        background: rgba(0,0,0,.65);
        color: #fff;
        font-size: .8rem;
        padding: .22rem .5rem;
        border-radius: 999px;
    }

    .mrc-body {
        flex: 1;
        padding: .85rem .9rem .95rem .25rem;
        display: flex;
        flex-direction: column;
    }

    .mrc-title {
        font-weight: 800;
        line-height: 1.25;
        margin: 0 0 .35rem 0;
    }

    .mrc-actions {
        margin-top: auto;
        display: flex;
        gap: .5rem;
    }

    .mrc-btn {
        background: #770f0f;
        color: #fff;
        border: 1px solid #D4AF37;
        border-radius: .6rem;
        padding: .45rem .75rem;
        font-weight: 600;
    }

        .mrc-btn:hover {
            background: #5e0c0c;
            color: #fff;
        }

    .mrc-desc {
        padding-top: .5rem;
        color: #444;
    }

    /* Mobile: Bild oben, Text unten */
    @@media (max-width: 768px) {

        .mrc-title {
            overflow-x: scroll;
        }


        .mrc-media {
            width: 45%;
            
        }

        .mrc-row {
            display: flex;
            gap: 1rem;
            align-items: stretch;
            flex-direction: row !important;
            height: 18vh;
        }

        .hidden {
            display: none !important;
        }

        .mobile {
            display: block !important;
        }
    }
</style>

<div name="Recipes"
     data-index="@Model.index"
     data-id="@Model.id"
     class="mrc-card mt-2">

    <div class="mrc-row">
        <!-- Bild -->
        <div class="mrc-media">
            @if (!string.IsNullOrEmpty(Model.imagePath))
            {
                <img src="@smallImg" alt="@Model.name" title="@Model.name" />
            }
            else
            {
                <img src="https://cdn.pixabay.com/photo/2020/04/22/18/22/excuse-me-5079442_640.jpg" alt="" />
            }

            <div class="mrc-badges">
                <span class="mrc-chip">@Model.preparationTime min</span>
                }
            </div>
        </div>

        <!-- Text/Buttons -->
        <div class="mrc-body">
            <div class="mrc-title">@Model.name</div>

            <!-- Toggle-Beschreibung (eine Instanz für Desktop & Mobile) -->
            @{
                var descId = $"desc_{Model.id}_{@Model.index}";
            }

            <div class="mrc-actions hidden">
                <button class="mrc-btn mt-1"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#@descId"
                        aria-expanded="false"
                        aria-controls="@descId"
                        style="margin-left:auto">
                    Beschreibung
                </button>
            </div>

            <div id="@descId" class="collapse mrc-desc bg-white p-1">
                @Html.Raw(Model.description)
            </div>
        </div>
    </div>
</div>

