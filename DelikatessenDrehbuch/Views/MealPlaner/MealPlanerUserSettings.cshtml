@model ModelForMealPlanSettingView

@{
    var pageTitle = "Essensplaner – Gesunde Wochenpläne & automatische Einkaufsliste | Delikatessen Drehbuch";
    var pageDescription = "Erstelle in Minuten deinen individuellen Essensplan mit Vorspeise, Hauptgericht und Dessert. Alle Rezepte SEO-optimiert, mit Nährwertangaben und Einkaufsliste – entwickelt von Delikatessen Drehbuch.";
    var pageUrl = "https://www.delikatessen-drehbuch.com/CreateNewMealPlan/MealPlanSetting";
}

<title>@pageTitle</title>
<meta name="description" content="@pageDescription" />
<meta name="robots" content="index, follow" />
<meta name="author" content="Delikatessen Drehbuch" />
<link rel="canonical" href="@pageUrl" />

<!-- Open Graph (Facebook, LinkedIn) -->
<meta property="og:type" content="website" />
<meta property="og:title" content="@pageTitle" />
<meta property="og:description" content="@pageDescription" />
<meta property="og:url" content="@pageUrl" />
<meta property="og:site_name" content="Delikatessen Drehbuch" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="@pageTitle" />
<meta name="twitter:description" content="@pageDescription" />
<meta name="twitter:site" content="@@DelikatessenDrehbuch" />

<!-- Schema.org JSON-LD (Google Rich Results) -->
<script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebApplication",
      "name": "Essensplaner – Delikatessen Drehbuch",
      "url": "@pageUrl",
      "description": "@pageDescription",
      "applicationCategory": "Food & Drink",
      "operatingSystem": "All",
      "creator": {
        "@@type": "Organization",
        "name": "Delikatessen Drehbuch",
        "url": "https://www.delikatessen-drehbuch.com"
      },
      "aggregateRating": {
        "@@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "1283"
      }
    }
</script>


<style>
    /* Klasse für Premium-Bereiche, die noch gesperrt sind */
    .premium-disabled {
        opacity: 0.5; /* halbtransparent */
        pointer-events: none; /* blockiert Klicks, Hover etc. */
        user-select: none; /* verhindert Textauswahl */
        filter: grayscale(100%); /* leichtes Grau – optisch "ausgegraut" */
    }
    /* mobile Layout fix: Checkboxen & Flex-Container */
    .filter-card {
        border-radius: .5rem;
    }

    .filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        justify-content: space-around;
        width: 100%;
    }

        .filter-row .form-check {
            min-width: 140px;
            margin-bottom: .25rem;
        }



    #IngredientTable td {
        vertical-align: top;
    }

    .form-check-input {
        transform: scale(1.2);
        margin-right: .35rem;
    }

    /* Mobil: Tabs nicht umbrechen lassen */
    @@media (max-width: 576px) {
        .nav-tabs .nav-link {
            font-size: 13px;
            padding: .4rem .6rem;
        }
    }

    
    .info-box {
        background: #fff8e6;
        border: 1px solid #f0d68a;
        border-radius: 10px;
        margin-top: 14px;
        box-shadow: 0 2px 6px rgba(0,0,0,.05);
        max-width: 800px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .info-box-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        cursor: pointer;
        color: #4b3f00;
        font-weight: 700;
    }

        .info-box-header:hover {
            background: #fff3cc;
        }

        .info-box-header i {
            color: #d4af37;
            font-size: 1.2rem;
            transition: transform 0.25s ease;
        }

    .info-box.open .info-box-header i {
        transform: rotate(180deg);
    }

    .info-box-content {
        padding: 0 18px 14px 18px;
        color: #4b3f00;
        font-size: .94rem;
        line-height: 1.45;
        display: none;
    }

    .info-box.open .info-box-content {
        display: block;
        animation: fadeIn 0.3s ease;
    }

    .info-box-content ul {
        margin: 6px 0 0 18px;
        padding: 0;
    }

    .info-box-content li {
        margin-bottom: 4px;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(-5px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>

<style>
    /* ====== Layout-Rahmen für die Filterseite ====== */
    .planner-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
        width: 100%;
    }

    .planner-card {
        background: #ffffff;
        border: 3px solid rgba(0,0,0,0.06);
        border-radius: .75rem;
        padding: 1rem 1.25rem;
        box-shadow: 0 7px 6px rgba(0,0,0,.04);
    }

        .planner-card h2 {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0 0 .5rem 0;
            color: #2a3440;
        }

        .planner-card h3 {
            font-size: 1.05rem;
            font-weight: 700;
            margin: .25rem 0 .5rem 0;
            color: #2a3440;
        }

    .filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem 1rem;
        justify-content: flex-start;
        width: 100%;
    }

        .filter-row .form-check {
            min-width: 180px; /* etwas breiter für Lesbarkeit */
            margin-bottom: .25rem;
        }

    .form-check-input {
        transform: scale(1.15);
        margin-right: .4rem;
    }

    /* Plan-Details Inputs in eine Zeile, bei schmalem Screen umbrechen */
    .plan-details-row {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem 1rem;
        align-items: center;
    }

        .plan-details-row .form-control {
            width: 90px;
        }

    /* Zutaten-Boxen nebeneinander, mobil untereinander */
    .ingredients-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        width: 100%;
    }

    .ingredients-box {
        border-radius: .5rem;
        padding: .75rem 1rem;
        box-shadow: 0 1px 6px rgba(0,0,0,.05);
    }

    /* Farben wie in deinem Code angedeutet */
    .box-dislike {
        background-color: #FFCACA;
    }

    .box-home {
        background-color: #CCEED5;
    }

    /* Mobile Breakpoint */
    @@media (max-width: 992px) {
        .planner-grid {
            grid-template-columns: 1fr;
        }

        .ingredients-grid {
            grid-template-columns: 1fr;
        }

        .filter-row .form-check {
            min-width: 150px;
        }
    }
</style>

<div id="MenuePlan" style="padding:2% ">
    <form asp-controller="CreateNewMealPlan" asp-action="Index" method="post">
        @Html.AntiForgeryToken()

        <div class="flexColumn bg-white" style="min-width:100%">
            <div class="flexColumn bg-white" style="min-width:100%">
                @if (Model.HaveCatchContent)
                {
                    <div class="flexRowToColumn mb-2 flexJustifyContendSpaceBetween">
                        <div class="flexRowToColumn mobileCenter flexAlginItemCenter flexJustifyContendSpaceBetween">
                            <span>Laden sie ganz einfach den letzten Essensplan</span>
                            <a class="btn bgRed Border-Gold m-3"
                               asp-controller="CreateNewMealPlan"
                               asp-action="LoadLastMealPlan"
                               style="max-width:fit-content;color:white">
                                Letzten Essensplan Laden
                            </a>
                        </div>
                        <hr class="desktop-Hidden w-75"/>
                        <div class="flexRowToColumn mobileCenter flexAlginItemCenter flexJustifyContendSpaceBetween">
                            <span>Bearbeiten sie den letzten Essensplan</span>
                            <a class="btn bgRed Border-Gold m-3 "
                               asp-controller="CreateNewMealPlan"
                               asp-action="EditeLastMealPlan"
                               style="max-width:fit-content;color:white">
                                Letzten Essensplan bearbeiten
                            </a>
                        </div>
                       
                        
                    </div>
                    
                }
                <div class="planner-grid">

                    <!-- Linke Spalte: Ernährungsfilter -->
                    <section class="planner-card">
                        <h2>Ernährungsfilter (optional)</h2>

                        <h3>Ich möchte nur:</h3>
                        <div class="filter-row" aria-label="veg-only">
                            <div class="form-check">
                                <input asp-for="@Model.PersonalMealPlanSettings.Vegan" onchange="UnCheckAllCheckboxes(['checkNoVegan','checkPreferablyMeat','checkPreferablyVegetarian'])" class="form-check-input" type="checkbox" id="checkVegan" name="Vegan" value="true">
                                <input type="hidden" name="Vegan" value="false" />
                                <label class="form-check-label" for="checkVegan">Vegan</label>
                            </div>

                            <div class="form-check">
                                <input <input asp-for="@Model.PersonalMealPlanSettings.Vegetarisch" onchange="UnCheckAllCheckboxes(['checkNoVegetarisch'])" class="form-check-input" type="checkbox" id="checkVegetarisch" name="Vegetarisch" value="true">
                                <input type="hidden" name="Vegetarisch" value="false" />
                                <label class="form-check-label" for="checkVegetarisch">Vegetarisch</label>
                            </div>
                        </div>

                        <hr class="my-3">

                        <h3>Ich schließe aus:</h3>
                        <div class="filter-row" aria-label="veg-excludes">
                            <div class="form-check">
                                <input asp-for="@Model.PersonalMealPlanSettings.NoVegan" onchange="UnCheckAllCheckboxes(['checkVegan'])" class="form-check-input" type="checkbox" id="checkNoVegan" name="NoVegan" value="true">
                                <input type="hidden" name="NoVegan" value="false" />
                                <label class="form-check-label" for="checkNoVegan">Vegan</label>
                            </div>

                            <div class="form-check">
                                <input asp-for="@Model.PersonalMealPlanSettings.NoVegetarisch" onchange="UnCheckAllCheckboxes(['checkVegetarisch','checkPreferablyVegetarian'])" class="form-check-input" type="checkbox" id="checkNoVegetarisch" name="NoVegetarisch" value="true">
                                <input type="hidden" name="NoVegetarisch" value="false" />
                                <label class="form-check-label" for="checkNoVegetarisch">Vegetarisch</label>
                            </div>

                            <div class="form-check">
                                <input asp-for="@Model.PersonalMealPlanSettings.NoSchweinefleisch" class="form-check-input" type="checkbox" id="checkNoPork" name="NoSchweinefleisch" value="true">
                                <input type="hidden" name="NoSchweinefleisch" value="false" />
                                <label class="form-check-label" for="checkNoPork">Schwein</label>
                            </div>

                            <div class="form-check">
                                <input asp-for="@Model.PersonalMealPlanSettings.NoFisch" class="form-check-input" type="checkbox" id="checkNoFish" name="NoFisch" value="true">
                                <input type="hidden" name="NoFisch" value="false" />
                                <label class="form-check-label" for="checkNoFicsh">Fisch</label>
                            </div>
                        </div>
                    </section>

                    <!-- Rechte Spalte: Kochdauer + Spezielle Präferenzen -->
                    <section class="planner-card">
                        <h2>Kochdauer (optional)</h2>
                        <div class="filter-row">
                            <div class="form-check">
                                <input asp-for="@Model.PersonalMealPlanSettings.CookingTimeOne" onchange="UnCheckAllCheckboxes(['checkSecondTime'])" class="form-check-input" type="checkbox" id="checkFirstTime" name="CookingTimeOne" value="true">
                                <input type="hidden" name="CookingTimeOne" value="false" />
                                <label class="form-check-label" for="checkFirstTime">25–45 min</label>
                            </div>
                            <div class="form-check">
                                <input asp-for="@Model.PersonalMealPlanSettings.CookingTimeTwo" onchange="UnCheckAllCheckboxes(['checkFirstTime'])" class="form-check-input" type="checkbox" id="checkSecondTime" name="CookingTimeTwo" value="true">
                                <input type="hidden" name="CookingTimeTwo" value="false" />
                                <label class="form-check-label" for="checkSecondTime">45 min +</label>
                            </div>
                        </div>

                        <hr class="my-3">

                        <h2>Speziellen Präferenzen (optional)</h2>
                        <div class="filter-row">
                            <div class="form-check">
                                <input asp-for="@Model.PersonalMealPlanSettings.BalancedDiet" onchange="UnCheckAllCheckboxes(['checkPreferablyMeat','checkPreferablyVegetarian'])" class="form-check-input" type="checkbox" id="checkBalanced" name="BalancedDiet" value="true">
                                <input type="hidden" name="BalancedDiet" value="false" />
                                <label class="form-check-label" for="checkBalanced">Ausgewogene Ernährung</label>
                            </div>
                            <div class="form-check">
                                <input asp-for="@Model.PersonalMealPlanSettings.PreferablyMeat" onchange="UnCheckAllCheckboxes(['checkBalanced','checkPreferablyVegetarian','checkVegan'])" class="form-check-input" type="checkbox" id="checkPreferablyMeat" name="PreferablyMeat" value="true">
                                <input type="hidden" name="PreferablyMeat" value="false" />
                                <label class="form-check-label" for="checkPreferablyMeat">Bevorzugt Fleisch </label>
                            </div>
                            <div class="form-check">
                                <input asp-for="@Model.PersonalMealPlanSettings.PreferablyVegetarian" onchange="UnCheckAllCheckboxes(['checkPreferablyMeat','checkBalanced','checkVegan','checkNoVegetarisch'])" class="form-check-input" type="checkbox" id="checkPreferablyVegetarian" name="PreferablyVegetarian" value="true">
                                <input type="hidden" name="PreferablyVegetarian" value="false" />
                                <label class="form-check-label" for="checkPreferablyVegetarian">Bevorzugt Vegetarisch</label>
                            </div>
                        </div>


                        <hr class="my-3">

                        <h2>Premium Funktionen (Premium)</h2>
                        <p class="mb-1 mt-1">Premium bald verfügbar</p>
                        <div class="premium-disabled">
                            <div class="filter-row">
                                <!-- Diätplan -->
                                <div class="form-check">
                                    <input @* asp-for="@Model.PersonalMealPlanSettings.DietPlan" *@
                                           class="form-check-input"
                                           type="checkbox"
                                           id="checkDietPlan"
                                           value="true"
                                    <input type="hidden" name="DietPlan" value="false" />
                                    <label class="form-check-label" for="checkDietPlan">Diätplan</label>
                                </div>

                                <!-- Muskelaufbau -->
                                <div class="form-check">
                                    <input @* asp-for="@Model.PersonalMealPlanSettings.MuscleGain" *@
                                           class="form-check-input"
                                           type="checkbox"
                                           id="checkMuscleGain"
                                           value="true"
                                    <input type="hidden" name="MuscleGain" value="false" />
                                    <label class="form-check-label" for="checkMuscleGain">Muskelaufbau (High Protein)</label>
                                </div>

                                <!-- Low Carb -->
                                <div class="form-check">
                                    <input @* asp-for="@Model.PersonalMealPlanSettings.LowCarb" *@
                                           class="form-check-input"
                                           type="checkbox"
                                           id="checkLowCarb"
                                           value="true"
                                           +                                <input type="hidden" name="LowCarb" value="false" />
                                    <label class="form-check-label" for="checkLowCarb">Low Carb</label>
                                </div>
                            </div>
                            </div>
                       

                    </section>

                    <!-- Untere Reihe: Plan-Details (spannt volle Breite) -->
                    <section class="planner-card" style="grid-column: 1 / -1;">
                        <h2>Plan-Details</h2>
                        <div class="flexRowToColumn">
                            <span>Plan für</span>
                            <input asp-for="@Model.PersonalMealPlanSettings.DayCount" class="form-control form-control-sm" type="number" id="dayCount" name="DayCount" style="max-width:70px" value="7" />
                            <span>Tage erstellen.</span>

                            <span style="margin-left:1rem">Plan für</span>
                            <input asp-for="@Model.PersonalMealPlanSettings.PersonCount" class="form-control form-control-sm" type="number" id="personCount" name="PersonCount" style="max-width:70px" value="2" />
                            <span>Personen erstellen.</span>
                        </div>
                    </section>

                </div> <!-- /.planner-grid -->
                <!-- Zutaten-Tabelle wie gehabt -->
                <div class="info-box" id="ingredientInfoBox">
                    <div class="info-box-header" onclick="toggleInfoBox('ingredientInfoBox')">
                        <span>ℹ️&nbsp;So funktioniert die Zutatenverwaltung</span>
                        <i class="bi bi-chevron-down"></i>
                    </div>

                    <div class="info-box-content">
                        <p>
                            Über die <strong>Suchleiste</strong> kannst du nach beliebigen Zutaten suchen
                            (z.&nbsp;B. <em>„Hähnchen“, „Zucchini“, „Kokosmilch“</em>).
                        </p>
                        <p>Die ausgewählten Zutaten kannst du in drei Gruppen einteilen:</p>
                        <ul>
                            <li><strong>Habe ich zuhause:</strong> Zutaten, die du bereits besitzt – sie werden bevorzugt verwendet.</li>
                            <li><strong>Oder, Hab ich zuhause:</strong> Zutaten, aus denen du gezielt Gerichte vorgeschlagen bekommst.</li>
                            <li><strong>Ausschließen:</strong> Zutaten, die du nicht magst oder meiden möchtest – sie werden in keinem Rezept berücksichtigt.</li>
                        </ul>
                        <p>
                            Du kannst alle Angaben jederzeit ändern oder löschen.
                        </p>
                    </div>
                </div>
                <h3><strong>Zutatenverwaltung</strong></h3>
                <table id="IngredientTable" class="display nowrap bg-white table table-sm mt-3" style="width:100%">
                    <thead class="bg-white">
                        <tr class="bg-white">
                            <th data-priority="1">Zutat</th>
                            <th data-priority="2">Optionen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ingredient in Model.Ingredients)
                        {
                            <tr>
                                <td style="max-width:45%;text-wrap:auto">@ingredient.Name</td>
                                <td>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               onchange="CreateIngredientChangeValue(this,'HaveAtHome_','Ingredients','IngredientIds')"
                                               value="@ingredient.Id"
                                               data-name="@ingredient.Name"
                                               id="Ingredient_@ingredient.Id" />
                                        <label class="form-check-label">Zutat ausschließen</label>
                                    </div>

                                    <hr class="my-1" />

                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               onchange="CreateIngredientChangeValue(this,'Ingredient_','HaveAtHome','IngredientsAtHome')"
                                               value="@ingredient.Id"
                                               data-name="@ingredient.Name"
                                               id="HaveAtHome_@ingredient.Id" />
                                        <label class="form-check-label">Habe ich zuhause</label>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Zwei Boxen: "Das mag ich nicht" / "Hab ich Zuhause" -->
                <div class="ingredients-grid mt-2">
                    <div class="ingredients-box box-dislike">
                        <h3>Das mag ich nicht:</h3>
                        <hr>
                        <div class="flexColumn flexAlginItemCenter" id="Ingredients"></div>
                    </div>

                    <div class="ingredients-box box-home">
                        <h3>Hab ich Zuhause:</h3>
                        <hr>
                        <div class="flexColumn flexAlginItemCenter" id="HaveAtHome"></div>
                    </div>
                </div>

                <button class="btn bgRed Border-Gold mt-3"
                        type="submit"
                        style="max-width:fit-content;color:white;margin-left:auto">
                    Essensplan Erstellen
                </button>

            </div>

        </div>
    </form>
</div>

@section Scripts {
    <script>
        function toggleInfoBox(id) {
            const box = document.getElementById(id);
            box.classList.toggle('open');
        }
    </script>
    <script src="/js/MealPlanerFilter.js" defer asp-append-version="true">

    </script>
}

