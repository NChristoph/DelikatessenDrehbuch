@using DelikatessenDrehbuch.Services.Interfaces
@inject IUtilityService UtilityService
@model List<IngredientHandlerModel>
@{
    bool haveShoppingList = (bool)ViewData["HaveShoppingList"];
}

@{
    var test = Model;
    var sum = await UtilityService.SumIngredients(Model);
    var group = sum.GroupBy(x => x.Ingredient.Group.Name).OrderBy(x => x.Key);
    <div class="col">
        @{
            var index = 0;
            foreach (var item in group)
            {
                <hr />
                <span><strong>@item.Key</strong></span>
                <hr />

                foreach (var ing in item)
                {
                    index++;
                    bool bigger = ing.Quantity.Quantitys > 0.99d;
                    var totalQuantity = Math.Round(ing.Quantity.Quantitys);
                    ing.Quantity.Quantitys = bigger ? totalQuantity : ing.Quantity.Quantitys;
                    @await Html.PartialAsync("~/Views/MealPlaner/_addRowPartial.cshtml",ing,
                           new ViewDataDictionary(ViewData) { { "Index", index } }
                    )



                }
            }
        }
    </div>
    <div class="w-100">
        <button class="btn btn-outline-danger"
                 onclick="CreateShoppingList()">Einkaufsliste erstellen!</button>

    </div>

    <button id="shareBtn"
            class="btn btn-primary"
            @(haveShoppingList? "": "hidden")>
        Einkaufsliste teilen
    </button>

}

<script src="/js/ShoppingList.js" defer asp-append-version="true"></script>
