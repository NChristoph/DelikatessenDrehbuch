@model string
@{
    ViewData["Title"] = "Schnelle Rezepte & Kochideen | Delikatessen-Drehbuch";
    ViewData["Description"] = "Was koche ich heute? Hier findest du schnelle und einfache Rezepte mit Zutaten aus dem Alltag. Perfekt für Berufstätige, Familien & Anfänger.";

}




<div class="minWidth100 flex flexJustifyContendCenter mt-1">

    <div id="RecipesPartialView" class="grid-Container maxWidth80 mobieleWidth90 ">
    </div>
</div>



<div id="mainContent" class="minWidth100 mobieleWidth90 flex flexJustifyContendEnd">
    <button class="btn bgRed Border-Gold m-2 " style="color:white" onclick="LoadRecipes()">Weitere Rezepte Laden</button>
</div>




@section Scripts
{
    <script>
       
        $(window).on("load", function () {
           
            var cachedContent = localStorage.getItem("cachedRecipesPartialView");
            var query = sessionStorage.getItem("searchQuery");
        
            if(!query)
            {
                 if (cachedContent) {
                    const parentElement = document.getElementById("RecipesPartialView");

                    if (parentElement) {
                     parentElement.innerHTML = cachedContent;

                    }
                 }
                else
                {
                   LoadRecipes();
                }
                
            }
            else{
                
                sessionStorage.removeItem("searchQuery");
                 $('#RecipesPartialView').load("/Home/SearchRecipes?query=" +  encodeURIComponent(query));
            }

        });



        function LoadRecipes()
        {
                   var RecipesIds = $("[name='RecipesId']").map(function () {
                                       return parseInt($(this).val());
                                      }).get();

                

               var url = RecipesIds
              ? "/Home/GetRecipesPartialView?Ids=" + encodeURIComponent(RecipesIds)
              : "/Home/GetRecipesPartialView";

          // AJAX-Request, um die PartialView zu laden
          $.get(url, function (data) {
              // Die Antwort (`data`) als letztes Kindelement einfügen
              $('#RecipesPartialView').append(data);
          });


        }

        function SaveCache()
        {

             const parentElement = document.getElementById("RecipesPartialView");

             if (parentElement) {
                const childElements = parentElement.innerHTML;
                localStorage.setItem("cachedRecipesPartialView", childElements);
             }
        }


    </script>
}







