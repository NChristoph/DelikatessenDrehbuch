@{
    ViewData["Title"] = "Rezepte";
    ViewData["Description"] = "Entdecken Sie köstliche Rezepte für feine Delikatessen auf Delikatessen-Drehbuch.com. Unsere Sammlung von exquisiten Gerichten bietet Inspiration für jeden Anlass – von raffinierten Vorspeisen bis zu verlockenden Desserts. Perfekt für Feinschmecker und Hobbyköche.";

}




<div class="minWidth100 flex flexJustifyContendCenter">

    <div id="RecipesPartialView" class="grid-Container maxWidth80 mobieleWidth90 ">
    </div>
</div>



<div id="mainContent" class="minWidth100 mobieleWidth90 flex flexJustifyContendEnd">
    <button class="btn bgRed Border-Gold m-2 " style="color:white" onclick="LoadRecipes()">Weitere Rezepte Laden</button>
</div>




@section Scripts
{
    <script>


         $(window).on("load", function () {

            const cachedContent = sessionStorage.getItem("cachedRecipesPartialView");

                      if (cachedContent) {            
                        const parentElement = document.getElementById("RecipesPartialView");

                           if (parentElement) {
                                parentElement.innerHTML = cachedContent;
                
                           } 
                      }
                      else{
                          LoadRecipes();
                      }




         });

       

         function LoadRecipes(){

                  var RecipesIds = $("[name='RecipesId']").map(function () {
                                     return $(this).val();

                  }).get().join(",");

                var url = RecipesIds
               ? "Home/GetRecipesPartialView?Ids=" + encodeURIComponent(RecipesIds)
               : "Home/GetRecipesPartialView";

           // AJAX-Request, um die PartialView zu laden
           $.get(url, function (data) {
               // Die Antwort (`data`) als letztes Kindelement einfügen
               $('#RecipesPartialView').append(data);
           });


         }

         $(window).on("unload", function () {

                 const parentElement = document.getElementById("RecipesPartialView");

              if (parentElement) {


                 const childElements = parentElement.innerHTML;
                 sessionStorage.setItem("cachedRecipesPartialView", childElements);
              }



         });

         function LoadRecipesByQuery()
         {
                 var searchWord=$('#searchQuery').val();

                 $('#RecipesPartialView').load("Home/SearchRecipes?query=" + encodeURIComponent(searchWord));

         }
    </script>
}







