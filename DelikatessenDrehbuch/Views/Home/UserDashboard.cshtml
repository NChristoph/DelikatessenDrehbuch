@model DelikatessenDrehbuch.Models.UserDashboardViewModel
@{
    ViewData["Title"] = "User Dashboard";
}

<div class="container mt-4 mb-5" style="max-width: 1000px;">
    <h2 class="mb-3">User Dashboard</h2>

    @if (!Model.IsLoggedInWithWorldMiniApp)
    {
        <div class="alert alert-warning">
            Bitte zuerst im World Mini App Bereich einloggen, damit wir dein Dashboard laden können.
        </div>
    }
    else
    {
        <p class="text-muted">User Hash: @Model.UserHash</p>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title text-muted">Verkaufte Pläne</h6>
                        <div class="fs-4 fw-bold">@Model.SoldMealPlanCount</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title text-muted">WLD das dir zusteht</h6>
                        <div class="fs-4 fw-bold">@Model.OpenWldAmount.ToString("0.######") WLD</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title text-muted">USDC/USDT das du noch bekommst</h6>
                        <div class="fs-4 fw-bold">@Model.OpenUsdcAmount.ToString("0.######") USDC</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div>
                    <h5 class="mb-1">Bisher erhalten (Creator Revenue)</h5>
                    <div class="fs-4 fw-bold">@Model.TotalCreatorRevenue.ToString("0.######")</div>
                </div>
                <button type="button" class="btn btn-success">Geld anforder</button>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="mb-3">Sales History</h5>
                @if (!Model.SalesHistory.Any())
                {
                    <div class="text-muted">Noch keine Verkäufe vorhanden.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Datum</th>
                                    <th>Listing</th>
                                    <th>Token</th>
                                    <th>Preis</th>
                                    <th>Creator Anteil</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sale in Model.SalesHistory)
                                {
                                    <tr>
                                        <td>@sale.PurchasedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>@(sale.Listing?.Title ?? $"Listing #{sale.ListingId}")</td>
                                        <td>@sale.PaymentToken</td>
                                        <td>@sale.PricePaid.ToString("0.######")</td>
                                        <td>@sale.CreatorAmount.ToString("0.######")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="mb-3">Transactions History (bereits erhalten)</h5>
                @if (!Model.WildCoinHistory.Any())
                {
                    <div class="text-muted">Noch keine Transaktionen vorhanden.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Datum</th>
                                    <th>Typ</th>
                                    <th>Betrag</th>
                                    <th>Saldo danach</th>
                                    <th>Referenz</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tx in Model.WildCoinHistory)
                                {
                                    <tr>
                                        <td>@tx.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>@tx.Type</td>
                                        <td>@tx.Amount.ToString("0.######")</td>
                                        <td>@tx.BalanceAfter.ToString("0.######")</td>
                                        <td>@(tx.ReferenceInfo ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>
