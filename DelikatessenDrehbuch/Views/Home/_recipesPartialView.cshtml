@using Microsoft.AspNetCore.Identity
@using DelikatessenDrehbuch.Models
@using System.Net;
@using DelikatessenDrehbuch.StaticScripts;
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model ShowRecipesModel
@{
    ViewData["Title"] = "Rezepte";
    ViewData["Description"] = "Entdecken Sie köstliche Rezepte für feine Delikatessen auf Delikatessen-Drehbuch.com. Unsere Sammlung von exquisiten Gerichten bietet Inspiration für jeden Anlass – von raffinierten Vorspeisen bis zu verlockenden Desserts. Perfekt für Feinschmecker und Hobbyköche.";

}

<meta name="description" content="Entdecke köstliche und einfache Rezepte für jeden Anlass. Von schnellen Gerichten bis zu raffinierten Menüs – unsere Sammlung bietet Inspiration für Hobbyköche und Genießer. Finde Schritt-für-Schritt-Anleitungen, Kochtricks und leckere Ideen für dein nächstes Lieblingsgericht.">
<link rel="canonical" href="https://www.delikatessen-drehbuch.com" />
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<meta name="robots" content="index,follow" />

<script type="application/ld+json">
    {
    "@@context": "https://schema.org",
    "@@type": "ItemList",
    "itemListElement": [
    @{
        int position = 1;
        foreach (var recipe in Model.RecipesList)
        {
            var encodedRecipeName = HelpfulMethods.CaseInsensitive(recipe.Name);
            var encodedRecipeId = HelpfulMethods.CaseInsensitive(recipe.Id.ToString());
            @:{
            @: "@@type": "ListItem",
            @: "position": @position,
            @:  "url": "https://www.delikatessen-drehbuch.com/SelectedRecipe/Index/@(encodedRecipeId)/(@encodedRecipeName)"
            @:}


            if (position < Model.RecipesList.Count)
            {
                @:,
                position++;
            }


        }


    }

    ]
    }
</script>









@{







    foreach (var recipes in Model.RecipesList)
    {

        var name = HelpfulMethods.CaseInsensitive(recipes.Name);


        <input name="RecipesId" value="@recipes.Id" hidden />
        <div class="grid-Recipes grid-Item">
            <a class=" grid-atag text-black" onclick="SaveCache()" asp-route-id="@recipes.Id" asp-route-name="@name" asp-controller="SelectedRecipe" asp-action="Index" style="text-decoration:none;">

                @if (!string.IsNullOrEmpty(recipes.ImagePath))
                {
                    var subPath = recipes.ImagePath
                    .Replace(".webp", "")
                    .Replace(".jpg", "")
                    .Replace(" ", "%20")
                    .Replace(".png","");



                    var smallPath = subPath.Replace("picdelikatessendrehbuch", "blobsmalldelikatessendrehbuch");
                    var mediumPath = subPath.Replace("picdelikatessendrehbuch", "blobmediumdelikatessendrehbuch");
                    if (recipes.Description != null)
                    {
                        <img class="img-fluid" alt="@recipes.Description" title="@recipes.Name"
                             srcset="@($"{smallPath}_small.webp 313w, {mediumPath}_medium.webp 600w")"
                             sizes="(max-width:600px) 313px,(max-width 1200px) 600px,100vh"
                             src="@recipes.ImagePath"
                             loading="lazy" />


                    }
                    else
                    {
                        <img class="img-fluid" alt="@recipes.Name" title="@recipes.Name"
                             srcset="@($"{smallPath}_small.webp 313w, {mediumPath}_medium.webp 600w")"
                             sizes="(max-width:600px) 313px,(max-width 1200px) 600px,100vh"
                             src="@recipes.ImagePath"
                             loading="lazy" />


                    }
                }
                else
                {
                    <img class="img-fluid" src="https://cdn.pixabay.com/photo/2020/04/22/18/22/excuse-me-5079442_640.jpg" loading="lazy" />

                }


            </a>

            <hr class="grid-hr" style="margin:1px;opacity:1;border:0;" />
            @if (recipes.LikeCount > 1)
            {
                <div class="grid-Category"> Gefällt @recipes.LikeCount Benutzer</div>

            }
            else
            {
                <div class="grid-Category">@recipes.Category</div>

            }

            @if (recipes.PreparationTime != null)
            {
                <div class="grid-LikeCount">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clock-history" viewBox="0 0 16 16">
                        <path d="M8.515 1.019A7 7 0 0 0 8 1V0a8 8 0 0 1 .589.022zm2.004.45a7 7 0 0 0-.985-.299l.219-.976q.576.129 1.126.342zm1.37.71a7 7 0 0 0-.439-.27l.493-.87a8 8 0 0 1 .979.654l-.615.789a7 7 0 0 0-.418-.302zm1.834 1.79a7 7 0 0 0-.653-.796l.724-.69q.406.429.747.91zm.744 1.352a7 7 0 0 0-.214-.468l.893-.45a8 8 0 0 1 .45 1.088l-.95.313a7 7 0 0 0-.179-.483m.53 2.507a7 7 0 0 0-.1-1.025l.985-.17q.1.58.116 1.17zm-.131 1.538q.05-.254.081-.51l.993.123a8 8 0 0 1-.23 1.155l-.964-.267q.069-.247.12-.501m-.952 2.379q.276-.436.486-.908l.914.405q-.24.54-.555 1.038zm-.964 1.205q.183-.183.35-.378l.758.653a8 8 0 0 1-.401.432z" />
                        <path d="M8 1a7 7 0 1 0 4.95 11.95l.707.707A8.001 8.001 0 1 1 8 0z" />
                        <path d="M7.5 3a.5.5 0 0 1 .5.5v5.21l3.248 1.856a.5.5 0 0 1-.496.868l-3.5-2A.5.5 0 0 1 7 9V3.5a.5.5 0 0 1 .5-.5" />
                    </svg>
                    @recipes.PreparationTime min.
                </div>

            }

            <h5 class="grid-Title" style="text-align:center;grid-column:1/span 2;">@recipes.Name</h5>






        </div>

    }
}


