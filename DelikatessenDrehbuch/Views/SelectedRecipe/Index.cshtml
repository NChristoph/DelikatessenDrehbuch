@using Microsoft.AspNetCore.Identity
@using System.Web
@using System.Linq;

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject IJsonHelper Json
@model SelectedRecipesModel

@{
    ViewData["Title"] = $"{Model.FullRecipes.Recipes.Name} – Rezept & Anleitung | Delikatessen-Drehbuch";
    ViewData["Description"] = $"Entdecken Sie das Rezept für {Model.FullRecipes.Recipes.Name} – eine exquisite Delikatesse mit detaillierter Anleitung. Perfekt für besondere Anlässe oder den puren Genuss. Jetzt entdecken & nachkochen!";
}
<head>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Bundle mit Popper.js (JavaScript für interaktive Komponenten) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</head>

<script type="application/ld+json">


    {
    @{
        var keyWords = "";
        var ingredients = "";
        var names = Model.FullRecipes.IngredientHandler.Select(x => x.Ingredient.Name);
        var keys = Model.FullRecipes.QueryHandler;
        foreach (var ingre in names)
        {
            ingre.Replace("ä", "\\u00e4").Replace("ö", "\\u00f6").Replace("ü", "\\u00fc").Replace("ß", "\\u00df");
            ingredients += "," + ingre;
        }

        foreach (var key in keys)
        {
            key.Replace("ä", "\\u00e4").Replace("ö", "\\u00f6").Replace("ü", "\\u00fc").Replace("ß", "\\u00df");
            keyWords += "," + key;
        }


    }
    "@@context": "https://schema.org",
    "@@type": "Recipe",
    "name": "@Model.FullRecipes.Recipes.Name",
    "author": {
    "@@type": "Person",
    "name": "Christoph Nitsch"
    },
    "description": "@Model.FullRecipes.Recipes.Description",
    "prepTime": "@Model.FullRecipes.Recipes.PreparationTime",
    "totalTime": "@Model.FullRecipes.Recipes.PreparationTime",
    "recipeCategory": "@Model.FullRecipes.Recipes.Category",
    "keywords":"@Html.Raw(keyWords)",
    "recipeIngredient":"@Html.Raw(ingredients)",
    "recipeInstructions": [
    {
    "@@type": "HowToStep",
    "text": "@Html.Raw(Model.FullRecipes.Recipes.Preparation.ToString())"
    }
    ],
    "image": "@Model.FullRecipes.Recipes.ImagePath",
    "publisher": {
    "@@type": "Organization",
    "name": "Delikatessen-drehbuch",
    "url": "https://www.delikateessen-drehbuch.com",
    "logo": {
    "@@type": "ImageObject",
    "url": "[Logo-URL]",
    "width": 250,
    "height": 100
    }
    },
    "sameAs": "https://www.facebook.com/profile.php?id=61563421617642"
    }

</script>


<body>

    <div class="minWidth100 flex flexJustifyContendCenter">
        <div class="maxWidth80 minWidth80 mobieleWidth90 mobileCenter ">
            <a class="Border-Gold btn " typeof="button" onclick="GoBack()" style="text-decoration:none;color:white;background:#770f05">Zurück</a>
            <div class="grid-Selected-Recipe minWidth100 ">

                <h1 class="grid-Title" style="font-family:'Lucida Handwriting';margin-bottom:1rem;text-align:center;color:#D4AF37">@Model.FullRecipes.Recipes.Name</h1>

                @{


                    if (Model.FullRecipes.Recipes.Description != null)
                    {
                        <img class="grid-Image" alt="@Model.FullRecipes.Recipes.Description" src="@Model.FullRecipes.Recipes.ImagePath" title="@Model.FullRecipes.Recipes.Name" style="max-width:100%;" />

                    }
                    else
                    {
                        <img class="grid-Image" alt="@Model.FullRecipes.Recipes.Name" src="@Model.FullRecipes.Recipes.ImagePath" title="@Model.FullRecipes.Recipes.Name" style="max-width:100%;" />

                    }
                }
                <div class="grid-KeyWords flex flexRow flexWrap flexJustifyContendCenter  minWidth100 maxWidth100 mobieleWidth90 mt-1">
                    <span>@Model.FullRecipes.Recipes.Name</span>
                </div>


                <p class="grid-LikeCount mt-3 mb-3">Dieses Rezept gefällt @Model.FullRecipes.Recipes.LikeCount Benutzern.</p>


                <div class="col  minWidth50 grid-PreparationTime">
                    @{
                        if (Model.FullRecipes.Recipes.PreparationTime != 0 && Model.FullRecipes.Recipes.PreparationTime != null)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clock-history" viewBox="0 0 16 16">
                                <path d="M8.515 1.019A7 7 0 0 0 8 1V0a8 8 0 0 1 .589.022zm2.004.45a7 7 0 0 0-.985-.299l.219-.976q.576.129 1.126.342zm1.37.71a7 7 0 0 0-.439-.27l.493-.87a8 8 0 0 1 .979.654l-.615.789a7 7 0 0 0-.418-.302zm1.834 1.79a7 7 0 0 0-.653-.796l.724-.69q.406.429.747.91zm.744 1.352a7 7 0 0 0-.214-.468l.893-.45a8 8 0 0 1 .45 1.088l-.95.313a7 7 0 0 0-.179-.483m.53 2.507a7 7 0 0 0-.1-1.025l.985-.17q.1.58.116 1.17zm-.131 1.538q.05-.254.081-.51l.993.123a8 8 0 0 1-.23 1.155l-.964-.267q.069-.247.12-.501m-.952 2.379q.276-.436.486-.908l.914.405q-.24.54-.555 1.038zm-.964 1.205q.183-.183.35-.378l.758.653a8 8 0 0 1-.401.432z" />
                                <path d="M8 1a7 7 0 1 0 4.95 11.95l.707.707A8.001 8.001 0 1 1 8 0z" />
                                <path d="M7.5 3a.5.5 0 0 1 .5.5v5.21l3.248 1.856a.5.5 0 0 1-.496.868l-3.5-2A.5.5 0 0 1 7 9V3.5a.5.5 0 0 1 .5-.5" />
                            </svg>


                        }
                    }
                    @Model.FullRecipes.Recipes.PreparationTime min.
                </div>
                <div class=" grid-Calories col minWidth50" style="margin-left:auto;">
                    @{
                        if (!string.IsNullOrEmpty(Model.FullRecipes.Recipes.Calories))
                        {
                            <p>@Model.FullRecipes.Recipes.Calories Kalorien</p>

                        }
                    }

                </div>

                @{
                    if (!string.IsNullOrEmpty(Model.FullRecipes.Recipes.Description))
                    {
                        <div class="grid-Discription Bg-Cream " style="padding:5%">
                            <h4 class="mb-4">Rezept Beschreibung</h4>
                            <p>@Html.Raw(@Model.FullRecipes.Recipes.Description)</p>
                        </div>

                    }
                }



                @if (SignInManager.IsSignedIn(User))
                {
                    <a asp-controller="SelectedRecipe" asp-action="AddOrRemoveLike" asp-route-id="@Model.FullRecipes.Recipes.Id" class="btn bgRed Border-Gold grid-Likebutton mt-3 mb-3" typeof="Button" title="Like Button" style="width:100px;height:max-content;padding:0.35rem;margin-left:auto;">
                        @{
                            Like like = Model.FullRecipes.Likes.SingleOrDefault(x => x.UserMail == User.Identity.Name && x.Recipe == Model.FullRecipes.Recipes);
                            if (like != null)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-star-fill" viewBox="0 0 16 16" style="color:#FFFDD0">
                                    <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z" />
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-star" viewBox="0 0 16 16" style="color:#FFFDD0">
                                    <path d="M2.866 14.85c-.078.444.36.791.746.593l4.39-2.256 4.389 2.256c.386.198.824-.149.746-.592l-.83-4.73 3.522-3.356c.33-.314.16-.888-.282-.95l-4.898-.696L8.465.792a.513.513 0 0 0-.927 0L5.354 5.12l-4.898.696c-.441.062-.612.636-.283.95l3.523 3.356-.83 4.73zm4.905-2.767-3.686 1.894.694-3.957a.565.565 0 0 0-.163-.505L1.71 6.745l4.052-.576a.525.525 0 0 0 .393-.288L8 2.223l1.847 3.658a.525.525 0 0 0 .393.288l4.052.575-2.906 2.77a.565.565 0 0 0-.163.506l.694 3.957-3.686-1.894a.503.503 0 0 0-.461 0z" />
                                </svg>
                            }
                        }

                    </a>
                }
                <hr class="grid-hr" style="opacity:1" />
                <div class="grid-ingredient minWidth90 mobieleWidth90 flex flexJustifyContendCenter ">
                    <ul class="minWidth100 mobieleWidth90" style="list-style-type:none;padding-left:0;">
                        @{

                            foreach (var ingredient in Model.FullRecipes.IngredientHandler.OrderByDescending(x => x.Quantity.Quantitys))
                            {

                                <li class="Bg-Cream Border-Gold mb-1 flex flexJustifyContendCenter" style="border-radius:0.25rem">

                                    <span style="text-align:end;color:#D4AF37;width:50px">
                                        <span style="margin-right:10px">
                                            @ingredient.Quantity.Quantitys
                                        </span>
                                    </span>
                                    <span style="color:#D4AF37;width:105px ">@ingredient.Measure.UnitOfMeasurement</span>
                                    <span style="color:#D4AF37;width:150px"> @ingredient.Ingredient.Name</span>
                                </li>
                            }
                        }

                    </ul>


                </div>
                <div class="grid-Preparation Bg-Cream" style="padding:2%">
                    <h4 class="mb-3">Zubereitung :</h4>
                    <p style="font-family: var(--bs-body-font-family);white-space:pre-wrap">@Html.Raw(@Model.FullRecipes.Recipes.Preparation)</p>

                </div>

                <!-- #region Närstoffe Anzeige -->
                <div class="grid-Nutrients flexRowToColumn flexWrap flexJustifyContendSpaceAround">
                    
                    @{
                        double Result(double multi, float nutrient) => Math.Round(multi / 100 * nutrient, 2);

                        var sortedList = Model.NutrienHandlers
                        .GroupBy(x => x.Ingredient.Name)
                        .ToList();

                        // Neue Dictionary für Gesamtsumme initialisieren
                        var nutrientTotals = new Dictionary<string, (double sum, string unit)>();
                    }

                    @foreach (var nutrients in sortedList)
                    {
                        var ingredientName = nutrients.Key.ToLower();
                        var handler = Model.FullRecipes.IngredientHandler
                        .SingleOrDefault(x => x.Ingredient.Name.ToLower() == ingredientName);

                        if (handler == null)
                        {
                            continue;
                        }

                        <div style="max-width:210px">
                            <div class="card Border-Gold mobieleWidth90 m-2" style="min-width:210px">
                                <div class="card-header Bg-Cream text-center">
                                    @nutrients.Key
                                </div>
                                <div class="card-body Bg-Cream p-2 flexColumn">

                                    @foreach (var nutrient in nutrients)
                                    {
                                        double grammMenge;

                                        if (nutrient.Metrics.UnitOfMeasurement == "Stk." && nutrient.Ingredient.AverageWeight != null)
                                        {
                                            grammMenge = handler.Quantity.Quantitys * (nutrient.Ingredient.AverageWeight ?? 100);
                                        }
                                        else
                                        {
                                            grammMenge = handler.Quantity.Quantitys;
                                        }

                                        double einzelWert = Result(grammMenge, nutrient.Quantity.Quantitys);

                                        // Sammeln für Gesamtnährwerte
                                        if (nutrientTotals.ContainsKey(nutrient.Nutrients.Nutrient))
                                        {
                                            var current = nutrientTotals[nutrient.Nutrients.Nutrient];
                                            nutrientTotals[nutrient.Nutrients.Nutrient] = (current.sum + einzelWert, current.unit);
                                        }
                                        else
                                        {
                                            nutrientTotals[nutrient.Nutrients.Nutrient] = (einzelWert, nutrient.Metrics.UnitOfMeasurement);
                                        }

                                        <div class="flexRow flexJustifyContendSpaceBetween flexWrap Bg-Cream mt-2 p-1 Border-Gold">
                                            <span name="NutrientPremium">@nutrient.Nutrients.Nutrient</span>
                                            <span name="QyantityPremium">@einzelWert</span>
                                            <span name="UnitOfMeasurementPremium">@nutrient.Metrics.UnitOfMeasurement</span>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>
                    }

                    @if (User.IsInRole("PremiumUser") && nutrientTotals.Any())
                    {
                        <div style="max-width:210px">
                            <div class="card Border-Gold mobieleWidth90 m-2" style="min-width:210px">
                                <div class="card-header Bg-Cream text-center">
                                    Gesamtnährwerte
                                </div>
                                <div class="card-body Bg-Cream p-2 flexColumn">
                                    @foreach (var entry in nutrientTotals)
                                    {
                                        <div class="flexRow flexJustifyContendSpaceBetween flexWrap Bg-Cream mt-2 p-1 Border-Gold">
                                            <span>@entry.Key</span>
                                            <span>@Math.Round(entry.Value.sum, 2)</span>
                                            <span>@entry.Value.unit</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        //TODO:Premium user abbo noch ermoglichen
                        <div style="max-width:210px">
                            <div class="card Border-Gold mobieleWidth90 m-2" style="min-width:210px">
                                <div class="card-header Bg-Cream text-center">
                                    Gesamtnährwerte
                                </div>
                                <div class="card-body Bg-Cream p-2 flexColumn">
                                    <div class="flexRow flexJustifyContendSpaceBetween flexWrap Bg-Cream mt-2 p-1 Border-Gold">
                                        <span>Premium User Werden um  Gesamtnährwerte zu sehen </span>

                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    
                </div>
                <!-- #endregion Närstoffe Anzeige-->



                <div id="RecipeSuggestions" class="carousel slide grid-Carusel" data-bs-ride="carousel">
                    <div class="w100 flex flexJustifyContendCenter m-2">
                        <span style="text-align:center"><strong>Das könnte Ihnen auch schmecken</strong></span>
                    </div>
                    <div class="carousel-inner flexJustifyContendCenter w-100">

                        @{

                            for (int i = 0; i < Model.RecipeSuggestions.Count; i++)
                            {
                                <a class="carousel-item @(i == 0 ? "active" : "") mobieleWidth80" asp-controller="SelectedRecipe" asp-action="Index" asp-route-id="@Model.RecipeSuggestions[i].Id" asp-route-name="@Model.RecipeSuggestions[i].Name" style="text-decoration:none;color:black">
                                    <img src="@Model.RecipeSuggestions[i].ImagePath" class="d-block w-100" alt="@Model.RecipeSuggestions[1].Description">
                                    <span class="w-100" style="text-align:center;display:block">@Model.RecipeSuggestions[i].Name</span>
                                </a>
                            }

                        }


                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#RecipeSuggestions" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#RecipeSuggestions" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>

                @{
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <a class="btn bgRed mb-2 grid-Button" href="#" onclick="MessageModalShowWrite('@Model.FullRecipes.Recipes.GetType().Name',@Model.FullRecipes.Recipes.Id,'@User.Identity.Name')" style="color:#FFFDD0;width:max-content;margin-right:auto">Rezept melden</a>

                        <!-- Button trigger modal -->
                        <button type="button" data-bs-toggle="modal" data-bs-target="#exampleModal" typeof="Button" title="Rating Button" class="btn mb-2 grid-Button" style="width:max-content;margin-left:auto;color:#FFFDD0;background:#770f05">
                            Bewerten

                        </button>
                    }
                    else
                    {
                        <Button type="Button" href="#" title="Rating Button" class="btn  Border-Gold m-4 grid-Button" style="width:max-content;color:#FFFDD0;background:#770f05" disabled>Zum Bewerten Einloggen</Button>

                    }

                }

            </div>


        </div>


    </div>






    <!-- Modal -->
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Bewerten</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="w100 flex acenter jcenter ">
                        <form class=" minWidth100 flex flexColumn acenter" asp-controller="SelectedRecipe" asp-action="SaveRecessionInDB">
                            <input value="@Model.FullRecipes.Recipes.Id" id="id" name="id" hidden />

                            <textarea class="w100 " id="assessment" name="assessment" style="min-height:25vh"></textarea>
                            <button type="submit" title="Rating Button" class="btn bgRed mb-2 grid-Button mt-1" style="width:max-content;margin-left:auto;color:#FFFDD0;">Bewerten</button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>



    @{
        var reverseList = Model.FullRecipes.Recession;
        reverseList.Reverse();
        foreach (var recessionFromDb in reverseList)
        {

            string email = recessionFromDb.UserEmail.Substring(0, 5) + "*******";
            var createTime = DateOnly.FromDateTime(recessionFromDb.CreationDate);
            <div class="minWidth100 flex flexJustifyContendCenter">
                <div class="card Border-Gold maxWidth80 minWidth80 mobieleWidth90 mb-3 ">
                    <div class="card-header flex flexRowToColumn jspaceBetween flexWrap bgRedGardien" style="color:#FFFDD0">
                        <div class="minWidth40">
                            @email
                        </div>
                        <div class="minWidth40 flex flexJustifyContendEnd">
                            @createTime
                        </div>

                    </div>
                    <div class="card-body  Bg-Cream">
                        @recessionFromDb.Assessment
                    </div>
                    @{
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <div class=" card-footer Bg-Cream minWidth100 flex ">
                                <a class="btn bgRed mb-2 " href="#" onclick="MessageModalShowWrite('@recessionFromDb.GetType().Name',@recessionFromDb.Id,'@User.Identity.Name')" style="color:#FFFDD0;width:max-content;margin-left:auto">Bewertung melden</a>

                            </div>
                        }
                    }

                </div>
            </div>

        }
    }
</body>




