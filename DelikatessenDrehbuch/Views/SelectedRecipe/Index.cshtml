@using Microsoft.AspNetCore.Identity
@using System.Linq;
@using DelikatessenDrehbuch.StaticScripts;
@using DelikatessenDrehbuch.Services.Interfaces;

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject IJsonHelper Json
@inject IUtilityService _utilityService
@model SelectedRecipesModel

@{
    ViewData["Title"] = $"{Model.FullRecipeData.Recipes.Name} – Rezept & Anleitung | Delikatessen-Drehbuch";
    ViewData["Description"] = $"Entdecken Sie das Rezept für {Model.FullRecipeData.Recipes.Name} – eine exquisite Delikatesse mit detaillierter Anleitung. Perfekt für besondere Anlässe oder den puren Genuss. Jetzt entdecken & nachkochen!";
}


<script type="application/ld+json">


    {
    "@@context": "https://schema.org",
    "@@type": "Recipe",
    "name": "@Model.FullRecipeData.Recipes.Name",
    "author": {
    "@@type": "Person",
    "name": "Christoph Nitsch"
    },
    "description": "@Model.FullRecipeData.Recipes.Description",
    "prepTime": "PT@Model.FullRecipeData.Recipes.PreparationTimeMins@M",
    "totalTime": "PT@Model.FullRecipeData.Recipes.PreparationTimeMins@M",
    "recipeCategory": "@Model.FullRecipeData.Recipes.Category",
    "keywords": [

    ],
    "recipeIngredient": [
    @Html.Raw(string.Join(",", Model.FullRecipeData.IngredientHandler.Select(i => "\"" + i.Ingredient.Name.Replace("ä", "\\u00e4").Replace("ö", "\\u00f6").Replace("ü", "\\u00fc").Replace("ß", "\\u00df") + "\"")))
    ],
    "recipeInstructions": [
    {
    "@@type": "HowToStep",
    "text": "@Html.Raw(Model.FullRecipeData.Recipes.Preparation.Replace("\"", "\\\"").Replace("\n", "\\n"))"
    }
    ],
    "image": "@Model.FullRecipeData.Recipes.ImagePath",
    "publisher": {
    "@@type": "Organization",
    "name": "Delikatessen-Drehbuch",
    "url": "https://www.delikateessen-drehbuch.com",
    "logo": {
    "@@type": "ImageObject",
    "url": "[Logo-URL]",
    "width": 250,
    "height": 100
    }
    },
    "sameAs": "https://www.facebook.com/profile.php?id=61563421617642"
    }
</script>




<style>
    /* ===== Design-Token (nur für diese Seite) ===== */
    .recipe-modern {
        --clr-bg: #ffffff; /* Seitenhintergrund */
        --clr-card: #FEFFF1; /* Beige für Cards */
        --clr-text: #2a3440; /* Anthrazit */
        --clr-brand: #770f0f; /* dein Rot */
        --clr-gold: #D4AF37; /* dein Gold */
        --bd: 1px solid rgba(0,0,0,.06);
        --radius: .75rem;
        --shadow: 0 1px 6px rgba(0,0,0,.06);
        --gap: 1rem;
    }

    /* Seiten-Rahmen */
    .recipe-modern {
        background: var(--clr-bg);
        color: var(--clr-text);
        padding: 1rem 0;
    }

        .recipe-modern .maxWidth80,
        .recipe-modern .minWidth80,
        .recipe-modern .mobieleWidth90 {
            color: var(--clr-text);
        }

        /* Überschrift */
        .recipe-modern .grid-KeyWords {
            color: var(--clr-text);
            font-weight: 800;
            letter-spacing: .2px;
        }

        /* Bild als Card */
        .recipe-modern .grid-Image picture {
            background: var(--clr-card);
            border: var(--bd);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
            margin-bottom: var(--gap);
            padding: .3rem;
        }

        .recipe-modern .grid-Image img {
            display: block;
            object-fit: cover;
            transition: transform .25s ease;
        }

            .recipe-modern .grid-Image img:hover {
                transform: scale(1.02);
            }

        /* Mini-Cards: Zeit + Kalorien nebeneinander, mit Abstand */
        .recipe-modern .grid-PreparationTime,
        .recipe-modern .grid-Calories {
            align-items: start;
            align-self: start;
            gap: .5rem;
            background: var(--clr-card);
            border: var(--bd);
            border-radius: .6rem;
            box-shadow: var(--shadow);
            padding: .55rem .8rem;
            margin: .5rem .5rem .5rem 0; /* Abstand zwischen den beiden Cards */
        }

            .recipe-modern .grid-Calories p {
                margin: 1rem;
            }

        /* Beschreibung als Card */
        .recipe-modern .grid-Discription {
            background: var(--clr-card) !important;
            border: var(--bd);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 1.25rem !important;
            margin-bottom: var(--gap);
        }

            .recipe-modern .grid-Discription h4 {
                font-weight: 800;
            }

        /* Zutatenliste als kleine Cards */
        .recipe-modern .grid-ingredient ul {
            margin: 0;
            padding-left: 0;
        }

        .recipe-modern .grid-ingredient li {
            background: var(--clr-card) !important;
            border: var(--bd);
            border-radius: .55rem !important;
            box-shadow: var(--shadow);
            padding: .45rem .6rem !important;
            margin-bottom: .5rem;
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .recipe-modern .grid-ingredient li span[name="quantity"] {
                font-variant-numeric: tabular-nums;
                font-weight: 700;
            }

        /* Tabs auf Marke getrimmt, Pane als Card */
        .recipe-modern .nav-tabs {
            border-bottom: 1px solid rgba(0,0,0,.08);
        }

            .recipe-modern .nav-tabs .nav-link {
                color: var(--clr-text);
                font-weight: 600;
                border: none;
            }

                .recipe-modern .nav-tabs .nav-link:hover {
                    color: var(--clr-brand);
                }

                .recipe-modern .nav-tabs .nav-link.active {
                    color: var(--clr-brand);
                    background: transparent;
                    border-bottom: 2px solid var(--clr-gold);
                }

        .recipe-modern #recipeTabsContent .tab-pane {
            background: var(--clr-card) !important;
            border: var(--bd);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 1rem 1.25rem !important;
            margin-bottom: var(--gap);
        }

        /* Dropdowns */
        .recipe-modern .dropdown .btn.bgRedGardien {
            border: 1px solid rgba(255,255,255,.25);
            box-shadow: var(--shadow);
        }

        .recipe-modern .dropdown-menu {
            background: #fff;
            border: var(--bd);
            border-radius: .6rem;
            box-shadow: 0 8px 24px rgba(0,0,0,.1);
        }

        /* Ads als Cards (falls sichtbar) */
        .recipe-modern .grid-Adds1,
        .recipe-modern .grid-Adds2,
        .recipe-modern .grid-Adds3 {
            background: var(--clr-card);
            border: var(--bd);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: .5rem;
            margin-bottom: var(--gap);
        }

        /* Trenner dezent & Abstand */
        .recipe-modern .grid-hr {
            border: 0;
            height: 1px;
            background: #eee;
            margin: 1.2rem 0;
        }

    /* Mobile Feinschliff */
    @@media (max-width:576px) {


        .recipe-modern .grid-Discription {
            padding: 1rem !important;
        }
    }
</style>
<a class="Border-Gold btn "
   typeof="button"
   onclick="GoBack()"
   style="text-decoration:none;color:white;background:#770f05">
    Zurück
</a>
<div class="recipe-modern">
    <div class="grid-Selected-Recipe">

        <h3 class="grid-KeyWords mt-4" style="font-family:Century;margin-bottom:1rem;text-align:center">
            @Model.FullRecipeData.Recipes.Name
        </h3>

        @{
