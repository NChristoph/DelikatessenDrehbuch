@using Microsoft.AspNetCore.Identity
@using System.Web
@using System.Linq;
@using DelikatessenDrehbuch.StaticScripts;

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject IJsonHelper Json
@model SelectedRecipesModel

@{
    ViewData["Title"] = $"{Model.FullRecipes.Recipes.Name} – Rezept & Anleitung | Delikatessen-Drehbuch";
    ViewData["Description"] = $"Entdecken Sie das Rezept für {Model.FullRecipes.Recipes.Name} – eine exquisite Delikatesse mit detaillierter Anleitung. Perfekt für besondere Anlässe oder den puren Genuss. Jetzt entdecken & nachkochen!";
}
<head>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Bundle mit Popper.js (JavaScript für interaktive Komponenten) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


</head>

<script type="application/ld+json">





    {
    "@@context": "https://schema.org",
    "@@type": "Recipe",
    "name": "@Model.FullRecipes.Recipes.Name",
    "author": {
    "@@type": "Person",
    "name": "Christoph Nitsch"
    },
    "description": "@Model.FullRecipes.Recipes.Description",
    "prepTime": "PT@Model.FullRecipes.Recipes.PreparationTimeMins@M",
    "totalTime": "PT@Model.FullRecipes.Recipes.PreparationTimeMins@M",
    "recipeCategory": "@Model.FullRecipes.Recipes.Category",
    "keywords": [
    @Html.Raw(string.Join(",", Model.FullRecipes.QueryHandler.Select(q => "\"" + q.Replace("ä", "\\u00e4").Replace("ö", "\\u00f6").Replace("ü", "\\u00fc").Replace("ß", "\\u00df") + "\"")))
    ],
    "recipeIngredient": [
    @Html.Raw(string.Join(",", Model.FullRecipes.IngredientHandler.Select(i => "\"" + i.Ingredient.Name.Replace("ä", "\\u00e4").Replace("ö", "\\u00f6").Replace("ü", "\\u00fc").Replace("ß", "\\u00df") + "\"")))
    ],
    "recipeInstructions": [
    {
    "@@type": "HowToStep",
    "text": "@Html.Raw(Model.FullRecipes.Recipes.Preparation.Replace("\"", "\\\"").Replace("\n", "\\n"))"
    }
    ],
    "image": "@Model.FullRecipes.Recipes.ImagePath",
    "publisher": {
    "@@type": "Organization",
    "name": "Delikatessen-Drehbuch",
    "url": "https://www.delikateessen-drehbuch.com",
    "logo": {
    "@@type": "ImageObject",
    "url": "[Logo-URL]",
    "width": 250,
    "height": 100
    }
    },
    "sameAs": "https://www.facebook.com/profile.php?id=61563421617642"
    }
</script>


<script>
    function GoBack() {

    if (window.history.length > 1) {
    window.history.back();
    }
    else {
    window.location.href = '../../Home/Index';
    }
    }
</script>


<body>

    <div class="minWidth100 flex flexJustifyContendCenter">
        <div class="maxWidth80 minWidth80 mobieleWidth90 mobileCenter ">
            <a class="Border-Gold btn " typeof="button" onclick="GoBack()" style="text-decoration:none;color:white;background:#770f05">Zurück</a>
            <div class="grid-Selected-Recipe minWidth100 flexJustifyContendSpaceAround ">

                <h3 class="grid-KeyWords m-4" style="font-family:Century;margin-bottom:1rem;text-align:center">@Model.FullRecipes.Recipes.Name</h3>

                @{
                    var name = FrontendFunctions.CaseInsensitiveName(Model.FullRecipes.Recipes.Name);

                    @if (!string.IsNullOrEmpty(Model.FullRecipes.Recipes.ImagePath))
                    {

                        var subPath = FrontendFunctions.CaseInsensitivePath(Model.FullRecipes.Recipes.ImagePath);

                        var smallPath = subPath?.Replace(Environment.GetEnvironmentVariable("BigPic"),
                        Environment.GetEnvironmentVariable("SmalPic"));

                        <div class=" grid-Image w-100 flex flexJustifyContendCenter mt-3">
                            <picture class="mobieleWidth90 " style="max-width:450px;max-height:450px">
                                <source srcset="@($"{smallPath}_small.webp")">

                                <img class="img-fluid"
                                     src="@smallPath"
                                     alt="@(!string.IsNullOrEmpty(Model.FullRecipes.Recipes.Description) ? Model.FullRecipes.Recipes.Description : Model.FullRecipes.Recipes.Name)"
                                     title="@Model.FullRecipes.Recipes.Name"
                                     width="450"
                                     height="450"
                                     decoding="async"
                                     style="aspect-ratio: 3 / 2; object-fit: cover;" />
                            </picture>
                        </div>


                    }
                    else
                    {
                        <img class="img-fluid" src="https://cdn.pixabay.com/photo/2020/04/22/18/22/excuse-me-5079442_640.jpg" />
                    }
                }


                @{
                    <p class="grid-LikeCount mt-3 mb-3">
                        @(Model.FullRecipes.Recipes.LikeCount == 0
                        ? "Sei der Erste, dem das Rezept gefällt."
                        : $"Dieses Rezept gefällt {Model.FullRecipes.Recipes.LikeCount} Benutzern.")
                    </p>

                }


                @if (Model.FullRecipes.Recipes.PreparationTime > 0)
                {
                    <div class="col minWidth50 grid-PreparationTime">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clock-history" viewBox="0 0 16 16">
                            <path d="M8.515 1.019A7 7 0 0 0 8 1V0a8 8 0 0 1 .589.022zm2.004.45a7 7 0 0 0-.985-.299l.219-.976q.576.129 1.126.342zm1.37.71a7 7 0 0 0-.439-.27l.493-.87a8 8 0 0 1 .979.654l-.615.789a7 7 0 0 0-.418-.302zm1.834 1.79a7 7 0 0 0-.653-.796l.724-.69q.406.429.747.91zm.744 1.352a7 7 0 0 0-.214-.468l.893-.45a8 8 0 0 1 .45 1.088l-.95.313a7 7 0 0 0-.179-.483m.53 2.507a7 7 0 0 0-.1-1.025l.985-.17q.1.58.116 1.17zm-.131 1.538q.05-.254.081-.51l.993.123a8 8 0 0 1-.23 1.155l-.964-.267q.069-.247.12-.501m-.952 2.379q.276-.436.486-.908l.914.405q-.24.54-.555 1.038zm-.964 1.205q.183-.183.35-.378l.758.653a8 8 0 0 1-.401.432z" />
                            <path d="M8 1a7 7 0 1 0 4.95 11.95l.707.707A8.001 8.001 0 1 1 8 0z" />
                            <path d="M7.5 3a.5.5 0 0 1 .5.5v5.21l3.248 1.856a.5.5 0 0 1-.496.868l-3.5-2A.5.5 0 0 1 7 9V3.5a.5.5 0 0 1 .5-.5" />
                        </svg>
                        @Model.FullRecipes.Recipes.PreparationTime min.
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.FullRecipes.Recipes.Calories))
                {
                    <div class="grid-Calories col minWidth50" style="margin-left:auto;">
                        <p>@Model.FullRecipes.Recipes.Calories Kalorien</p>
                    </div>
                }


                @if (!string.IsNullOrEmpty(Model.FullRecipes.Recipes.Description))
                {
                    <div class="grid-Discription Bg-Cream" style="padding:5%">
                        <h4 class="mb-4">Rezept Beschreibung</h4>
                        <p>@Html.Raw(Model.FullRecipes.Recipes.Description)</p>
                    </div>
                }






                @if (SignInManager.IsSignedIn(User))
                {
                    <a class="btn bgRed mb-2 grid-Button"
                       href="#"
